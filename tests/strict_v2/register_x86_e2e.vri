# EXPECT_START
# 7
# 255
# 65535
# 7
# 0
# 65535
# EXPECT_END

register PackedReg: u32
    LOW: 0..2
    MID: 8..15
    HIGH: 16..31
end.

func main():
    var reg: PackedReg = 0
    reg.LOW = 7
    reg.MID = 255
    reg.HIGH = 65535

    print(reg.LOW)
    print(reg.MID)
    print(reg.HIGH)

    reg.MID = 0

    print(reg.LOW)
    print(reg.MID)
    print(reg.HIGH)
    out 0
end.
