# EXPECT_START
# 10
# 20
# EXPECT_END

enum First:
    Value(x: int)
end.

enum Second:
    Value(x: int)
end.

func main:
    let v1 = First.Value(10)
    let v2 = Second.Value(20)
    case v1
        First.Value(x): print(x)
    end
    case v2
        Second.Value(y): print(y)
    end
    out 0
end.
