func main() -> int:
    var a2: tensor<i32>[2, 2] = [1, 2, 3, 4]
    var b2: tensor<i32>[2, 2] = [5, 6, 7, 8]
    var c2 = a2 >< b2
    if c2[0, 0] != 19 do out 11 end
    if c2[0, 1] != 22 do out 12 end
    if c2[1, 0] != 43 do out 13 end
    if c2[1, 1] != 50 do out 14 end

    var ar: tensor<i32>[2, 3] = [1, 2, 3, 4, 5, 6]
    var br: tensor<i32>[3, 2] = [7, 8, 9, 10, 11, 12]
    var cr = ar >< br
    if cr[0, 0] != 58 do out 21 end
    if cr[0, 1] != 64 do out 22 end
    if cr[1, 0] != 139 do out 23 end
    if cr[1, 1] != 154 do out 24 end

    print "PASS: fma=19,22,43,50 rect=58,64,139,154"
    out 0
end.
