# EXPECT_START
# 15
# 15
# 16
# 42
# EXPECT_END

entity Early:
    value: int

    method score(delta: int) -> int:
        out this.value + delta
    end.
end.

entity Handler:
    callback: func(int) -> int
    plain: func(int) -> int
    zero: func() -> int
end.

func score(this: Early, delta: int) -> int:
    out 900 + this.value + delta
end.

func callback(this: Handler, value: int) -> int:
    out 999
end.

func add_ten(value: int) -> int:
    out value + 10
end.

func answer() -> int:
    out 42
end.

func main:
    var early = Early(value: 10)
    var handler = Handler(callback: add_ten, plain: add_ten, zero: answer)
    print(early.score(5))
    print(handler.callback(5))
    print(handler.plain(6))
    print(handler.zero())
    out 0
end.
