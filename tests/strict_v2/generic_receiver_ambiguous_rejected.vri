# EXPECT_DIAGNOSTIC: E3052
# EXPECT_DIAGNOSTIC_LINE: 15
# Two exported generic UFCS candidates imported under the same short name are
# ambiguous and must be rejected before receiver dispatch chooses either one.

import inspect from generic_receiver_ambiguous_provider_a
import inspect from generic_receiver_ambiguous_provider_b

entity Box of (T):
    val: T
end.

func main:
    var b = Box of (int)(val: 42)
    b.inspect()
    out 0
end.
