# EXPECT: PASS: percent_combination_e2e
# Vir Specification v2.0 §10.1 & §30 — Postfix Percentage Operator `%`
# Verifies:
#   1. Integer percentage: 10% == 0.1, 100% == 1.0, 0% == 0.0
#   2. Decimal floating-point percentage: 10.5% == 0.105, 2.5% == 0.025, 0.5% == 0.005, 0.05% == 0.0005
#   3. Dynamic runtime variable percentage: var v = 250; v% == 2.5, var vf = 10.5; vf% == 0.105
#   4. Parenthesized expression percentage: (10 + 20)% == 0.3, (10.0 + 2.5)% == 0.125, (500.0 * 20%)% == 1.0
#   5. Precedence and combined arithmetic:
#      - Multiplication/Division with percentage: 100.0 * 10% == 10.0, 50% * 200.0 == 100.0
#      - Percentage times percentage: 50% * 10% == 0.05, 50% * 50% == 0.25
#      - Division of percentages: 100% / 50% == 2.0, 50.0 / 25% == 200.0
#      - Addition/Subtraction: 200% + 1.0 == 3.0, 1.0 + 50% == 1.5, 10.5% + 0.005 == 0.11, 25% + 75% == 1.0, 100% - 25% == 0.75
#      - Mixed precedence chains: 100.0 + 50% * 10.0 == 105.0, (100.0 + 50%) * 10.0 == 1005.0
#      - Multi-factor percentage chains: 1000.0 * 10% * 50% == 50.0, 50% * 50% * 400.0 == 100.0
#      - Realistic business calculations: total = base + base * 15% == 230.0, discount = 50.0 - 50.0 * 10% == 45.0
#   6. Modulo remains independent: 10 mod 4 == 2

func main() -> int:
    # 1. Basic integer percentages
    var p1 = 10%
    if p1 != 0.1 do out 1 end

    var p2 = 100%
    if p2 != 1.0 do out 2 end

    var p3 = 0%
    if p3 != 0.0 do out 3 end

    # 2. Decimal float percentages
    var d1 = 10.5%
    if d1 != 0.105 do out 4 end

    var d2 = 2.5%
    if d2 != 0.025 do out 5 end

    var d3 = 0.5%
    if d3 != 0.005 do out 6 end

    var d4 = 0.05%
    if d4 != 0.0005 do out 7 end

    # 3. Dynamic runtime variables (int and float)
    var vi = 250
    var vp = vi%
    if vp != 2.5 do out 8 end

    var vf = 10.5
    var vfp = vf%
    if vfp != 0.105 do out 9 end

    # 4. Expressions with parentheses
    var g1 = (10 + 20)%
    if g1 != 0.3 do out 10 end

    var g2 = (10.0 + 2.5)%
    if g2 != 0.125 do out 11 end

    var g3 = (500.0 * 20%)%
    if g3 != 1.0 do out 12 end

    # 5. Arithmetic combinations with mixed precedence
    var m1 = 100.0 * 10%
    if m1 != 10.0 do out 13 end

    var m2 = 50% * 200.0
    if m2 != 100.0 do out 14 end

    var m3 = 50% * 10%
    if m3 != 0.05 do out 15 end

    var div1 = 100% / 50%
    if div1 != 2.0 do out 16 end

    var div2 = 50.0 / 25%
    if div2 != 200.0 do out 17 end

    var a1 = 200% + 1.0
    if a1 != 3.0 do out 18 end

    var a2 = 1.0 + 50%
    if a2 != 1.5 do out 19 end

    var a3 = 10.5% + 0.005
    if a3 != 0.11 do out 20 end

    var a4 = 25% + 75%
    if a4 != 1.0 do out 21 end

    var s1 = 100% - 25%
    if s1 != 0.75 do out 22 end

    # Precedence: multiplication before addition
    var chain1 = 100.0 + 50% * 10.0
    if chain1 != 105.0 do out 23 end

    var chain2 = (100.0 + 50%) * 10.0
    if chain2 != 1005.0 do out 24 end

    # Multi-factor chains
    var chain3 = 1000.0 * 10% * 50%
    if chain3 != 50.0 do out 25 end

    var chain4 = 50% * 50% * 400.0
    if chain4 != 100.0 do out 26 end

    # Realistic business calculation patterns
    var base_price = 200.0
    var total_with_tip = base_price + base_price * 15%
    if total_with_tip != 230.0 do out 27 end

    var orig_price = 50.0
    var discounted = orig_price - orig_price * 10%
    if discounted != 45.0 do out 28 end

    # Remainder remains the separate mod operator
    if 10 mod 4 != 2 do out 29 end

    print "PASS: percent_combination_e2e"
    out 0
end.
