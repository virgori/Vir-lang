# EXPECT: 0
# Regression: an allocation result spilled by register pressure must retain
# the allocation base, not the allocator's next-bump scratch value.
func main:
    let a0 = alloc(8)
    let a1 = alloc(8)
    let a2 = alloc(8)
    let a3 = alloc(8)
    let a4 = alloc(8)
    let a5 = alloc(8)
    let a6 = alloc(8)
    let a7 = alloc(8)
    let a8 = alloc(24)
    let a9 = alloc(8)

    var failures = 0
    if a0 >= a1 do failures = failures + 1 end
    if a1 >= a2 do failures = failures + 1 end
    if a2 >= a3 do failures = failures + 1 end
    if a3 >= a4 do failures = failures + 1 end
    if a4 >= a5 do failures = failures + 1 end
    if a5 >= a6 do failures = failures + 1 end
    if a6 >= a7 do failures = failures + 1 end
    if a7 >= a8 do failures = failures + 1 end
    if a8 >= a9 do failures = failures + 1 end
    print failures
end.
