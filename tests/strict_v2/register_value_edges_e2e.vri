register Flags: u16
    LOW: 0..2
    MID: 3..7
    HIGH: 8..15
end.

func main:
    var flags: Flags = 0
    flags.LOW = 7
    flags.MID = 31
    flags.HIGH = 255
    print flags.LOW
    print flags.MID
    print flags.HIGH
    flags.MID = 0
    print flags.LOW
    print flags.MID
    print flags.HIGH
end.
# EXPECT_START
# 7
# 31
# 255
# 7
# 0
# 255
# EXPECT_END
