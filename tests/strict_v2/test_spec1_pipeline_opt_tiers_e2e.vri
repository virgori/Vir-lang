# Spec §1.2: Compiler IR Pipeline (HIR -> MIR -> LIR -> Machine Code)
# Tests constant folding, dead code elimination, and loop optimizations across SSA.
# EXPECT_START
# 100
# 256
# 55
# 1024
# EXPECT_END

func compute_constant_fold:
    # Tier-1 Constant folding & strength reduction
    var a = 10 * 10
    var b = 512 / 2
    var c = 0 + a
    print c
    print b
    out 0
end.

func compute_loop_sum(n: int):
    var s = 0
    var i = 1
    when i <= n loop
        s = s + i
        i = i + 1
    end
    print s
    out s
end.

func compute_power_shift(x: int):
    # Strength reduction x * 32 or power
    var p = x * 32
    print p
    out p
end.

func main:
    compute_constant_fold()
    compute_loop_sum(10)
    compute_power_shift(32)
    out 0
end.
