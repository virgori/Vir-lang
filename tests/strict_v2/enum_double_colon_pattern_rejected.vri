# EXPECT_DIAGNOSTIC_LINE: 12
# EXPECT_DIAGNOSTIC_MEMBER: enum variant qualifier '::' is invalid; use '.'

enum Option<T>:
    Some(value: T)
    None
end.

func main:
    let value = Option.Some(1)
    case value
        Option::Some(inner): print(inner)
        Option.None: print(0)
    end
    out 0
end.
