# EXPECT_DIAGNOSTIC: E1001
# UFCS: An entity cannot define a method and a callable field with the same name (duplicate symbol).

func fallback_handler(value: int) -> int:
    out 12
end.

entity Dispatcher:
    action: func(int) -> int

    method action(value: int) -> int:
        out 88
    end.
end.

func main:
    var d = Dispatcher(action: fallback_handler)
    print(d.action(1))
    out 0
end.
