# VIR-SPC-0023: direct syntax pins the free function despite a same-named method.

entity Score:
    value: int

    method compute(delta: int) -> int:
        out this.value + delta
    end
end.

func compute(this: Score, delta: int) -> int:
    out 900 + this.value + delta
end.

func main:
    let score = Score(value: 10)
    print(score.compute(5))
    print(compute(score, 5))
    out 0
end.
