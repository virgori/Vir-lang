# EXPECT_START
# PASS: quantize f16 source input and formats
# EXPECT_END
extern func native_read_u8(addr: int, offset: int) -> int
extern func native_read_i64(addr: int, offset: int) -> int

func main() -> int:
    # ── Test 1: f16 input -> INT8 ──────────────────────────────────────────
    var w16: tensor[f16; 2, 1] = [1.0, 2.0]
    var q8 = quantize(w16, bits: 8)
    var p8 = q8 as int
    if native_read_i64(p8, 0) != 2 do out 1 end   # numel
    if native_read_i64(p8, 8) != 8 do out 2 end   # bits
    if native_read_i64(p8, 16) != 1 do out 3 end  # scale
    if native_read_i64(p8, 24) != 0 do out 4 end  # zero_point
    if native_read_u8(p8, 32) != 1 do out 10 end  # q[0] must be 1 (not 0!)
    if native_read_u8(p8, 33) != 2 do out 11 end  # q[1] must be 2 (not 0!)

    # ── Test 2: f16 input -> INT4 ──────────────────────────────────────────
    var q4 = quantize(w16, bits: 4)
    var p4 = q4 as int
    if native_read_i64(p4, 0) != 2 do out 20 end   # numel
    if native_read_i64(p4, 8) != 4 do out 21 end   # bits
    if native_read_i64(p4, 16) != 1 do out 22 end  # scale
    # 1.0 (low 0x1) and 2.0 (high 0x2) -> byte 0 = 0x21 = 33
    if native_read_u8(p4, 32) != 33 do out 23 end

    # ── Test 3: f16 input -> bits: 16 (f16 storage) ────────────────────────
    var q16 = quantize(w16, bits: 16)
    var p16 = q16 as int
    if native_read_i64(p16, 0) != 2 do out 30 end
    if native_read_i64(p16, 8) != 16 do out 31 end
    if native_read_i64(p16, 16) != 1 do out 32 end
    # IEEE-754 f16: 1.0 = 0x3C00 (low 0x00, high 0x3C = 60)
    if native_read_u8(p16, 32) != 0 do out 33 end
    if native_read_u8(p16, 33) != 60 do out 34 end
    # IEEE-754 f16: 2.0 = 0x4000 (low 0x00, high 0x40 = 64)
    if native_read_u8(p16, 34) != 0 do out 35 end
    if native_read_u8(p16, 35) != 64 do out 36 end

    # ── Test 4: f16 input -> bits: 32 (f32 storage) ────────────────────────
    var q32 = quantize(w16, bits: 32)
    var p32 = q32 as int
    if native_read_i64(p32, 0) != 2 do out 40 end
    if native_read_i64(p32, 8) != 32 do out 41 end
    if native_read_i64(p32, 16) != 1 do out 42 end
    # IEEE-754 f32: 1.0 = 0x3F800000 (byte 3 = 0x3F = 63, byte 2 = 0x80 = 128)
    if native_read_u8(p32, 32) != 0 do out 43 end
    if native_read_u8(p32, 33) != 0 do out 44 end
    if native_read_u8(p32, 34) != 128 do out 45 end
    if native_read_u8(p32, 35) != 63 do out 46 end

    # ── Test 5: f16 truncation toward zero parity [1.5, -1.5] ──────────────
    var w_frac: tensor[f16; 2, 1] = [1.5, -1.5]
    var q_frac = quantize(w_frac, bits: 8)
    var p_frac = q_frac as int
    # 1.5 truncates to 1 (byte 32 = 1)
    if native_read_u8(p_frac, 32) != 1 do out 50 end
    # -1.5 truncates to -1 (byte 33 = 255 / 0xFF as signed i8)
    if native_read_u8(p_frac, 33) != 255 do out 51 end

    print "PASS: quantize f16 source input and formats"
    out 0
end.
