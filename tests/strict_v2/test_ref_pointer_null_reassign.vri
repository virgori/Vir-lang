# EXPECT_START
# 42
# 0
# 99
# 0
# EXPECT_END
# §27 / §6: Reassigning null literal (0) to pointers and references

entity Node:
    val: int
end.

func main:
    var n = Node(val: 42)
    var p = &n
    print p.val
    p = 0
    print p as i64

    var n2 = Node(val: 99)
    var mp = &mut n2
    print mp.val
    mp = 0
    print mp as i64
end.
