# EXPECT_START
# 0
# 1
# 2
# 20
# EXPECT_END

enum DefaultTag:
    First
    Second
    Third
end.

func tag_code(value: DefaultTag) -> int:
    case value
        DefaultTag.First: out 10
        DefaultTag.Second: out 20
        DefaultTag.Third: out 30
    end
    out -1
end.

func main:
    print(DefaultTag.First)
    print(DefaultTag.Second)
    print(DefaultTag.Third)
    print(tag_code(DefaultTag.Second))
    out 0
end.
