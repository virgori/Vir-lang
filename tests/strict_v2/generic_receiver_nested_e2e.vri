# EXPECT_START
# 42
# hello
# EXPECT_END

entity Inner of (T):
    val: T
end.

entity Outer of (T):
    inner: Inner of (T)
end.

func unwrap_nested of (T)(o: Outer of (T)) -> T:
    out o.inner.val
end.

func main:
    var inn = Inner of (int)(val: 42)
    var outr = Outer of (int)(inner: inn)
    print(outr.unwrap_nested())
    var inn_s = Inner of (string)(val: "hello")
    var outr_s = Outer of (string)(inner: inn_s)
    print(outr_s.unwrap_nested())
    out 0
end.
