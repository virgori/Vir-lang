# EXPECT_START
# alice
# 42
# 10
# 20
# EXPECT_END

entity Point:
    x: int,
    y: int
end.

enum Event:
    Named(name: string, id: int)
    Located(pos: Point)
    Empty
end.

func print_event(e: Event):
    case e
        Event.Named(n, id):
            print(n)
            print(id)
        Event.Located(p):
            print(p.x)
            print(p.y)
        Event.Empty:
            print("empty")
    end
    out 0
end.

func main:
    let e1 = Event.Named("alice", 42)
    print_event(e1)
    let p = Point(10, 20)
    let e2 = Event.Located(p)
    print_event(e2)
    out 0
end.
