# 1
# EXPECT_END

include virgex.virgex
include regex.regex
include pattern.string

func main:
    # -------------------------------------------------------
    # Test 1: Digits Exact repetition (@0!3 vs [0-9]{3})
    # -------------------------------------------------------
    var v_digits = virgex_compile("| @0!3 |")
    var r_digits = regex_compile("^[0-9]{3}$")

    # Positive match: "123"
    var vm1 = v_digits.match("123")
    var rm1 = r_digits.match("123")
    if vm1 & rm1 do print(1) else print(0) end

    # Negative: "12" (too short)
    var vm2 = v_digits.match("12")
    var rm2 = r_digits.match("12")
    if (!vm2) & (!rm2) do print(1) else print(0) end

    # Negative: "1234" (too long)
    var vm3 = v_digits.match("1234")
    var rm3 = r_digits.match("1234")
    if (!vm3) & (!rm3) do print(1) else print(0) end

    # Negative: "abc" (non-digits)
    var vm4 = v_digits.match("abc")
    var rm4 = r_digits.match("abc")
    if (!vm4) & (!rm4) do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 2: License Plate Formatted (@AZ!2 $- @0!5 vs ^[A-Z]{2}-[0-9]{5}$)
    # -------------------------------------------------------
    var v_plate = virgex_compile("| @AZ!2 $- @0!5 |")
    var r_plate = regex_compile("^[A-Z]{2}-[0-9]{5}$")

    var vp1 = v_plate.match("HN-12345")
    var rp1 = r_plate.match("HN-12345")
    if vp1 & rp1 do print(1) else print(0) end

    var vp2 = v_plate.match("SG-99999")
    var rp2 = r_plate.match("SG-99999")
    if vp2 & rp2 do print(1) else print(0) end

    var vp3 = v_plate.match("hn-12345") # lowercase reject
    var rp3 = r_plate.match("hn-12345")
    if (!vp3) & (!rp3) do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 3: Alphanumeric Username Range (@Az0!3~8 vs ^[A-Za-z0-9]{3,8}$)
    # -------------------------------------------------------
    var v_user = virgex_compile("| @Az0!3~8 |")
    var r_user = regex_compile("^[A-Za-z0-9]{3,8}$")

    var vu1 = v_user.match("alice")
    var ru1 = r_user.match("alice")
    if vu1 & ru1 do print(1) else print(0) end

    var vu2 = v_user.match("bob123")
    var ru2 = r_user.match("bob123")
    if vu2 & ru2 do print(1) else print(0) end

    var vu3 = v_user.match("a") # too short
    var ru3 = r_user.match("a")
    if (!vu3) & (!ru3) do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 4: Alternation (:( apple | banana :) vs apple|banana)
    # -------------------------------------------------------
    var v_alt = virgex_compile(":( apple | banana :)")
    var r_alt = regex_compile("apple|banana")

    var vf1 = v_alt.find("I like apple today")
    var rf1 = r_alt.find("I like apple today")
    if str_eq(vf1, "apple") & str_eq(rf1, "apple") do print(1) else print(0) end

    var vf2 = v_alt.find("I like banana today")
    var rf2 = r_alt.find("I like banana today")
    if str_eq(vf2, "banana") & str_eq(rf2, "banana") do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 5: Find All Non-Overlapping Substrings
    # -------------------------------------------------------
    var v_sub = virgex_compile("@0!3")
    var r_sub = regex_compile("[0-9]{3}")
    var text_sub = "abc123def456ghi"

    var v_all = v_sub.find_all(text_sub)
    var r_all = r_sub.find_all(text_sub)

    var v_ok = (len(v_all) == 2) & str_eq(v_all[0], "123") & str_eq(v_all[1], "456")
    var r_ok = (len(r_all) == 2) & str_eq(r_all[0], "123") & str_eq(r_all[1], "456")
    if v_ok & r_ok do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 6: Extraction & Capture Groups (Atom Extract Policy vs Groups)
    # -------------------------------------------------------
    # In VPS: @AZ!2 and @0!5 are atoms, $- is literal -> extract returns ["HN", "12345"]
    # In Regex: capturing groups (^[A-Z]{2})-([0-9]{5})$ -> extract returns ["HN", "12345"]
    var v_ext_pat = virgex_compile("| @AZ!2 $- @0!5 |")
    var r_ext_pat = regex_compile("^([A-Z]{2})-([0-9]{5})$")
    var sample_id = "HN-12345"

    var ve = v_ext_pat.extract(sample_id)
    var re = r_ext_pat.extract(sample_id)

    var ve_ok = (len(ve) == 2) & str_eq(ve[0], "HN") & str_eq(ve[1], "12345")
    var re_ok = (len(re) == 2) & str_eq(re[0], "HN") & str_eq(re[1], "12345")
    if ve_ok & re_ok do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 7: Replace and Replace All
    # -------------------------------------------------------
    var target = "foo123bar456"
    var v_rep1 = v_sub.replace(target, "NUM")
    var r_rep1 = r_sub.replace(target, "NUM")
    if str_eq(v_rep1, "fooNUMbar456") & str_eq(r_rep1, "fooNUMbar456") do print(1) else print(0) end

    var v_rep2 = v_sub.replace_all(target, "NUM")
    var r_rep2 = r_sub.replace_all(target, "NUM")
    if str_eq(v_rep2, "fooNUMbarNUM") & str_eq(r_rep2, "fooNUMbarNUM") do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 8: Split
    # -------------------------------------------------------
    var v_dash = virgex_compile("$-")
    var r_dash = regex_compile("-")
    var csv_row = "alpha-beta-gamma"

    var v_parts = v_dash.split(csv_row)
    var r_parts = r_dash.split(csv_row)

    var vp_ok = (len(v_parts) == 3) & str_eq(v_parts[0], "alpha") & str_eq(v_parts[1], "beta") & str_eq(v_parts[2], "gamma")
    var rp_ok = (len(r_parts) == 3) & str_eq(r_parts[0], "alpha") & str_eq(r_parts[1], "beta") & str_eq(r_parts[2], "gamma")
    if vp_ok & rp_ok do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 9: Tokenize
    # -------------------------------------------------------
    var v_toks = v_dash.tokenize("a-b")
    # Should contain ["a", "-", "b"]
    var vtok_ok = (len(v_toks) == 3) & str_eq(v_toks[0], "a") & str_eq(v_toks[1], "-") & str_eq(v_toks[2], "b")
    if vtok_ok do print(1) else print(0) end

    # -------------------------------------------------------
    # Test 10: Dual UFCS String-First Calling Forms
    # -------------------------------------------------------
    # 1. string.match(pattern)
    var str_sample = "987"
    if str_sample.match(v_digits) & str_sample.match(r_digits) do
        print(1)
    else
        print(0)
    end

    # 2. string.find(pattern)
    var str_text = "order 123 arrived"
    var sf1 = str_text.find(v_sub)
    var sf2 = str_text.find(r_sub)
    if str_eq(sf1, "123") & str_eq(sf2, "123") do
        print(1)
    else
        print(0)
    end

    # 3. string.replace(pattern, rep)
    var s_rep = str_text.replace(v_sub, "###")
    if str_eq(s_rep, "order ### arrived") do
        print(1)
    else
        print(0)
    end

    out 0
end.
