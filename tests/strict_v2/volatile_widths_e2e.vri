# EXPECT_START
# 136
# 30600
# 1432778632
# 1234605616436508552
# 170
# 48042
# 305419896
# 123456789
# 987654321012345678
# 123456789
# 1111222233334444
# 987654321012345678
# 987654321
# EXPECT_END

func main():
    # Allocate three 8-byte words: [target_word, canary1_word, canary2_word]
    var buf = alloc(24)
    var addr = buf
    var canary1_addr = buf + 8
    var canary2_addr = buf + 16

    # Set initial canary patterns
    native_write_i64(canary1_addr, 0, 123456789)
    native_write_i64(canary2_addr, 0, 987654321)

    # Initial pattern: 0x1122334455667788
    native_write_i64(addr, 0, 1234605616436508552)

    # 1. Exact-width reads: 8, 16, 32, 64 bits
    print(volatile_read8(addr))
    print(volatile_read16(addr))
    print(volatile_read32(addr))
    print(volatile_read64(addr))

    # 2. Exact 8-bit write: low byte -> 0xAA (170)
    volatile_write8(addr, 170)
    print(volatile_read8(addr))

    # 3. Exact 16-bit write: low 2 bytes -> 0xBBAA (48042)
    volatile_write16(addr, 48042)
    print(volatile_read16(addr))

    # 4. Exact 32-bit write: low 4 bytes -> 0x12345678 (305419896)
    volatile_write32(addr, 305419896)
    print(volatile_read32(addr))

    # 5. Verify adjacent canary1 word remained untouched across all narrow writes
    print(volatile_read64(canary1_addr))

    # 6. Exact 64-bit write to target word
    volatile_write64(addr, 987654321012345678)
    print(volatile_read64(addr))

    # 7. Verify adjacent canary1 word is preserved after 64-bit write
    print(volatile_read64(canary1_addr))

    # 8. Exact 64-bit write to middle word (canary1)
    volatile_write64(canary1_addr, 1111222233334444)
    print(volatile_read64(canary1_addr))

    # 9. Verify boundary preservation: preceding word (addr) and following word (canary2) untouched
    print(volatile_read64(addr))
    print(volatile_read64(canary2_addr))

    out 0
end.
