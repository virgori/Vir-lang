func main() -> int:
    var ten_percent = 10%
    if ten_percent != 0.1 do out 1 end

    var value = 250
    var dynamic_percent = value%
    if dynamic_percent != 2.5 do out 2 end

    var composed = 200% + 1.0
    if composed != 3.0 do out 3 end

    # Remainder remains the separate `mod` operator.
    if 10 mod 4 != 2 do out 4 end
    out 0
end.
