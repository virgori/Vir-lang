# EXPECT_START
# 3
# 10
# 20
# 30
# 2
# EXPECT_END

entity VecModel of (T):
    len_val: int
    cap_val: int
    first_item: T
    second_item: T
    third_item: T

    method len() -> int:
        out this.len_val
    end

    method get(idx: int) -> T:
        if idx == 0 do out this.first_item end
        if idx == 1 do out this.second_item end
        out this.third_item
    end

    method push(item: T):
        if this.len_val == 0 do this.first_item = item end
        if this.len_val == 1 do this.second_item = item end
        if this.len_val == 2 do this.third_item = item end
        this.len_val = this.len_val + 1
    end

    method pop() -> T:
        let last_idx = this.len_val - 1
        this.len_val = last_idx
        if last_idx == 2 do out this.third_item end
        if last_idx == 1 do out this.second_item end
        out this.first_item
    end
end.

func count_elements of (T)(ref v: VecModel of (T)) -> int:
    out v.len()
end.

func main:
    var v = VecModel of (int)(len_val: 0, cap_val: 3, first_item: 0, second_item: 0, third_item: 0)
    v.push(10)
    v.push(20)
    v.push(30)
    print(v.count_elements())
    print(v.get(0))
    print(v.get(1))
    print(v.get(2))
    let p = v.pop()
    print(v.len())
    out 0
end.
