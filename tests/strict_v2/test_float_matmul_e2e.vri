# EXPECT_START
# 1065353216
# 1073741824
# 1077936128
# 1082130432
# EXPECT_END
extern func native_read_u8(addr: int, offset: int) -> int

func read_u32_le(addr: int, offset: int) -> int:
    let
        b0 = native_read_u8(addr, offset)
        b1 = native_read_u8(addr, offset + 1)
        b2 = native_read_u8(addr, offset + 2)
        b3 = native_read_u8(addr, offset + 3)
    out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
end.

func main() -> int:
    infer:
        var a: tensor[f32; 2, 2] = [1.0, 2.0, 3.0, 4.0]
        var b: tensor[f32; 2, 2] = [1.0, 0.0, 0.0, 1.0]
        var c = a ** b

        let
            c_ptr = c as int
            c00 = read_u32_le(c_ptr, 16)
            c01 = read_u32_le(c_ptr, 20)
            c10 = read_u32_le(c_ptr, 24)
            c11 = read_u32_le(c_ptr, 28)

        print c00
        print c01
        print c10
        print c11
    end
    out 0
end.
