# EXPECT_END

include virgex
include pattern.string

func main:
    # -------------------------------------------------------
    # 1. Compiler Atoms (6 tests)
    # -------------------------------------------------------
    # Test 1: @Az
    var p1 = virgex.compile("| @Az |")
    if p1.fullMatch("a") & p1.fullMatch("Z") & !p1.fullMatch("1") do print(1) else print(0) end

    # Test 2: @AZ
    var p2 = virgex.compile("| @AZ |")
    if p2.fullMatch("A") & p2.fullMatch("Z") & !p2.fullMatch("a") do print(1) else print(0) end

    # Test 3: @az
    var p3 = virgex.compile("| @az |")
    if p3.fullMatch("a") & p3.fullMatch("z") & !p3.fullMatch("A") do print(1) else print(0) end

    # Test 4: @0
    var p4 = virgex.compile("| @0 |")
    if p4.fullMatch("0") & p4.fullMatch("9") & !p4.fullMatch("a") do print(1) else print(0) end

    # Test 5: @06
    var p5 = virgex.compile("| @06 |")
    if p5.fullMatch("0") & p5.fullMatch("6") & !p5.fullMatch("7") & !p5.fullMatch("9") do print(1) else print(0) end

    # Test 6: @Az0
    var p6 = virgex.compile("| @Az0 |")
    if p6.fullMatch("a") & p6.fullMatch("Z") & p6.fullMatch("0") & !p6.fullMatch("_") do print(1) else print(0) end

    # -------------------------------------------------------
    # 2. Compiler Quantifiers (5 tests)
    # -------------------------------------------------------
    # Test 7: @0!3
    var p7 = virgex.compile("| @0!3 |")
    if p7.fullMatch("123") & !p7.fullMatch("12") & !p7.fullMatch("1234") do print(1) else print(0) end

    # Test 8: @Az!1~5
    var p8 = virgex.compile("| @Az!1~5 |")
    if p8.fullMatch("a") & p8.fullMatch("abc") & p8.fullMatch("abcde") & !p8.fullMatch("") & !p8.fullMatch("abcdef") do print(1) else print(0) end

    # Test 9: @0!2~
    var p9 = virgex.compile("| @0!2~ |")
    if p9.fullMatch("12") & p9.fullMatch("12345") & !p9.fullMatch("1") do print(1) else print(0) end

    # Test 10: @0!~
    var p10 = virgex.compile("| @0!~ |")
    if p10.fullMatch("") & p10.fullMatch("1") & p10.fullMatch("1234") & !p10.fullMatch("a") do print(1) else print(0) end

    # Test 11: @0!1
    var p11 = virgex.compile("| @0!1 |")
    if p11.fullMatch("5") & !p11.fullMatch("") & !p11.fullMatch("55") do print(1) else print(0) end

    # -------------------------------------------------------
    # 3. Compiler Anchors (3 tests)
    # -------------------------------------------------------
    # Test 12: both anchors: | @0!3 |
    var p12 = virgex.compile("| @0!3 |")
    if p12.fullMatch("123") & !p12.fullMatch("a123") & !p12.fullMatch("123b") do print(1) else print(0) end

    # Test 13: start only: | @0!3
    var p13 = virgex.compile("| @0!3")
    var f13_1 = p13.find("123abc")
    var f13_2 = p13.find("a123")
    if str_eq(f13_1, "123") & str_byte_len(f13_2) == 0 do print(1) else print(0) end

    # Test 14: end only: @0!3 |
    var p14 = virgex.compile("@0!3 |")
    var f14_1 = p14.find("abc123")
    var f14_2 = p14.find("123a")
    if str_eq(f14_1, "123") & str_byte_len(f14_2) == 0 do print(1) else print(0) end

    # -------------------------------------------------------
    # 4. Compiler Optional (3 tests)
    # -------------------------------------------------------
    # Test 15: optional atom ?@0
    var p15 = virgex.compile("| ?@0 |")
    if p15.fullMatch("") & p15.fullMatch("5") & !p15.fullMatch("a") & !p15.fullMatch("55") do print(1) else print(0) end

    # Test 16: optional quantified ?@AZ!2
    var p16 = virgex.compile("| ?@AZ!2 |")
    if p16.fullMatch("") & p16.fullMatch("HN") & !p16.fullMatch("H") & !p16.fullMatch("HNA") do print(1) else print(0) end

    # Test 17: optional group ?:( $- @0!5 :)
    var p17 = virgex.compile("| ?:( $- @0!5 :) |")
    if p17.fullMatch("") & p17.fullMatch("-12345") & !p17.fullMatch("-") & !p17.fullMatch("-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 5. Compiler Groups & Alternation (4 tests)
    # -------------------------------------------------------
    # Test 18: simple group :( - @0 :)
    var p18 = virgex.compile("| :( - @0 :) |")
    if p18.fullMatch(" 5") & !p18.fullMatch("5") do print(1) else print(0) end

    # Test 19: or :( A | B :)
    var p19 = virgex.compile("| :( A | B :) |")
    if p19.fullMatch("A") & p19.fullMatch("B") & !p19.fullMatch("C") do print(1) else print(0) end

    # Test 20: complex or :( @AZ!2 | @0!3 :)
    var p20 = virgex.compile("| :( @AZ!2 | @0!3 :) |")
    if p20.fullMatch("HN") & p20.fullMatch("123") & !p20.fullMatch("H") & !p20.fullMatch("12") do print(1) else print(0) end

    # Test 21: group quantified :( - @0 :)!3
    var p21 = virgex.compile("| :( - @0 :)!3 |")
    if p21.fullMatch(" 1 2 3") & !p21.fullMatch(" 1 2") do print(1) else print(0) end

    # -------------------------------------------------------
    # 6. Compiler Escape (4 tests)
    # -------------------------------------------------------
    # Test 22: escape dash $-
    var p22 = virgex.compile("| $- |")
    if p22.fullMatch("-") & !p22.fullMatch(" ") do print(1) else print(0) end

    # Test 23: escape pipe $|
    var p23 = virgex.compile("| $| |")
    if p23.fullMatch("|") & !p23.fullMatch("a") do print(1) else print(0) end

    # Test 24: escape question $?
    var p24 = virgex.compile("| $? |")
    if p24.fullMatch("?") & !p24.fullMatch("a") do print(1) else print(0) end

    # Test 25: escape block $. |@!~ .$
    var p25 = virgex.compile("$. |@!~ .$")
    var f25 = p25.find("hello |@!~ world")
    if str_eq(f25, " |@!~ ") do print(1) else print(0) end

    # -------------------------------------------------------
    # 7. Compiler Literals (2 tests)
    # -------------------------------------------------------
    # Test 26: plain literal ABC
    var p26 = virgex.compile("| ABC |")
    if p26.fullMatch("ABC") & !p26.fullMatch("abd") do print(1) else print(0) end

    # Test 27: literal HN
    var p27 = virgex.compile("| HN |")
    if p27.fullMatch("HN") & !p27.fullMatch("hn") do print(1) else print(0) end

    # -------------------------------------------------------
    # 8. Compiler Space Token (1 test)
    # -------------------------------------------------------
    # Test 28: @AZ!2 - @0!5
    var p28 = virgex.compile("| @AZ!2 - @0!5 |")
    if p28.fullMatch("HN 12345") & !p28.fullMatch("HN12345") do print(1) else print(0) end

    # -------------------------------------------------------
    # 9. Compiler Spec Examples (5 tests)
    # -------------------------------------------------------
    # Test 29: exact 3 digits
    var p29 = virgex.compile("| @0!3 |")
    if p29.fullMatch("123") & !p29.fullMatch("12") do print(1) else print(0) end

    # Test 30: id code
    var p30 = virgex.compile("| @AZ!2 $- @0!5 $? |")
    if p30.fullMatch("HN-12345?") & !p30.fullMatch("HN-12345") do print(1) else print(0) end

    # Test 31: optional suffix
    var p31 = virgex.compile("| @AZ!2 ?:( $- @0!5 :) |")
    if p31.fullMatch("HN") & p31.fullMatch("HN-12345") & !p31.fullMatch("HN-123") do print(1) else print(0) end

    # Test 32: a or b
    var p32 = virgex.compile("| :( A | B :) |")
    if p32.fullMatch("A") & p32.fullMatch("B") & !p32.fullMatch("C") do print(1) else print(0) end

    # Test 33: username
    var p33 = virgex.compile("| @Az0!3~12 |")
    if p33.fullMatch("user123") & !p33.fullMatch("ab") & p33.fullMatch("abcdefghijkl") do print(1) else print(0) end

    # -------------------------------------------------------
    # 10. E2E Exact3Digits (4 tests)
    # -------------------------------------------------------
    var p_exact = "| @0!3 |"
    # Test 34: match
    if virgex.fullMatch(virgex.compile(p_exact), "123") do print(1) else print(0) end
    # Test 35: reject short
    if !virgex.fullMatch(virgex.compile(p_exact), "12") do print(1) else print(0) end
    # Test 36: reject long
    if !virgex.fullMatch(virgex.compile(p_exact), "1234") do print(1) else print(0) end
    # Test 37: reject alpha
    if !virgex.fullMatch(virgex.compile(p_exact), "abc") do print(1) else print(0) end

    # -------------------------------------------------------
    # 11. E2E IdCode (3 tests)
    # -------------------------------------------------------
    var p_id = "| @AZ!2 $- @0!5 $? |"
    # Test 38: match
    if virgex.fullMatch(virgex.compile(p_id), "HN-12345?") do print(1) else print(0) end
    # Test 39: reject no question
    if !virgex.fullMatch(virgex.compile(p_id), "HN-12345") do print(1) else print(0) end
    # Test 40: reject lowercase
    if !virgex.fullMatch(virgex.compile(p_id), "hn-12345?") do print(1) else print(0) end

    # -------------------------------------------------------
    # 12. E2E OptionalSuffix (3 tests)
    # -------------------------------------------------------
    var p_opt = "| @AZ!2 ?:( $- @0!5 :) |"
    # Test 41: match with suffix
    if virgex.fullMatch(virgex.compile(p_opt), "HN-12345") do print(1) else print(0) end
    # Test 42: match without suffix
    if virgex.fullMatch(virgex.compile(p_opt), "HN") do print(1) else print(0) end
    # Test 43: reject partial
    if !virgex.fullMatch(virgex.compile(p_opt), "HN-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 13. E2E AorB (3 tests)
    # -------------------------------------------------------
    var p_ab = "| :( A | B :) |"
    # Test 44: match A
    if virgex.fullMatch(virgex.compile(p_ab), "A") do print(1) else print(0) end
    # Test 45: match B
    if virgex.fullMatch(virgex.compile(p_ab), "B") do print(1) else print(0) end
    # Test 46: reject C
    if !virgex.fullMatch(virgex.compile(p_ab), "C") do print(1) else print(0) end

    # -------------------------------------------------------
    # 14. E2E Username (5 tests)
    # -------------------------------------------------------
    var p_user = "| @Az0!3~12 |"
    # Test 47: min
    if virgex.fullMatch(virgex.compile(p_user), "abc") do print(1) else print(0) end
    # Test 48: max
    if virgex.fullMatch(virgex.compile(p_user), "abcdefghijkl") do print(1) else print(0) end
    # Test 49: reject short
    if !virgex.fullMatch(virgex.compile(p_user), "ab") do print(1) else print(0) end
    # Test 50: reject long
    if !virgex.fullMatch(virgex.compile(p_user), "abcdefghijklm") do print(1) else print(0) end
    # Test 51: reject special
    if !virgex.fullMatch(virgex.compile(p_user), "abc@def") do print(1) else print(0) end

    # -------------------------------------------------------
    # 15. E2E SpacePattern (2 tests)
    # -------------------------------------------------------
    var p_sp = "| @AZ!2 - @0!5 |"
    # Test 52: match
    if virgex.fullMatch(virgex.compile(p_sp), "HN 12345") do print(1) else print(0) end
    # Test 53: reject no space
    if !virgex.fullMatch(virgex.compile(p_sp), "HN12345") do print(1) else print(0) end

    # -------------------------------------------------------
    # 16. E2E RepeatedGroup (2 tests)
    # -------------------------------------------------------
    var p_rep = "| :( - @0 :)!3 |"
    # Test 54: match
    if virgex.fullMatch(virgex.compile(p_rep), " 1 2 3") do print(1) else print(0) end
    # Test 55: reject
    if !virgex.fullMatch(virgex.compile(p_rep), " 1 2") do print(1) else print(0) end

    # -------------------------------------------------------
    # 17. E2E Search (2 tests)
    # -------------------------------------------------------
    # Test 56: find digits
    var f56 = virgex.find(virgex.compile("@0!3"), "abc123def")
    if str_eq(f56, "123") do print(1) else print(0) end

    # Test 57: find all
    var list57 = virgex.findAll(virgex.compile("@0!3"), "abc123def456ghi789")
    var c57_len = len(list57) == 3
    var c57_items = str_eq(list57[0], "123") & str_eq(list57[1], "456") & str_eq(list57[2], "789")
    if c57_len & c57_items do print(1) else print(0) end

    # -------------------------------------------------------
    # 18. E2E DigitRange (1 test)
    # -------------------------------------------------------
    # Test 58: 06 range
    var p58 = "| @06 |"
    var m58_0 = virgex.fullMatch(virgex.compile(p58), "0")
    var m58_6 = virgex.fullMatch(virgex.compile(p58), "6")
    var m58_7 = !virgex.fullMatch(virgex.compile(p58), "7")
    var m58_9 = !virgex.fullMatch(virgex.compile(p58), "9")
    if m58_0 & m58_6 & m58_7 & m58_9 do print(1) else print(0) end

    # -------------------------------------------------------
    # 19. E2E EscapeBlock (1 test)
    # -------------------------------------------------------
    # Test 59: escape block
    var f59 = virgex.find(virgex.compile("$.|@!~.$"), "hello |@!~ world")
    if str_eq(f59, "|@!~") do print(1) else print(0) end

    # -------------------------------------------------------
    # 20. E2E NestedGroups (1 test)
    # -------------------------------------------------------
    # Test 60: nested or
    var p60 = "| :( A | :( B | C :) :) |"
    var m60_a = virgex.fullMatch(virgex.compile(p60), "A")
    var m60_b = virgex.fullMatch(virgex.compile(p60), "B")
    var m60_c = virgex.fullMatch(virgex.compile(p60), "C")
    var m60_d = !virgex.fullMatch(virgex.compile(p60), "D")
    if m60_a & m60_b & m60_c & m60_d do print(1) else print(0) end

    # -------------------------------------------------------
    # 21. Retired Python Wrapper Contracts / Native API Smoke (3 tests)
    # Ba contract Python (regex property, repr() string, và prefix-match()) không
    # có tương đương 1:1 trong native Vir vì wrapper Python đã bị loại bỏ (retired).
    # Tại đây kiểm tra các API native độc lập của Pattern: Pattern.source,
    # Pattern.fullMatch (whole input) và Pattern.isMatch (search).
    # -------------------------------------------------------
    var p61 = virgex.compile("| @0!3 |")
    # Test 61: Pattern.source (kiểm tra trường source của Pattern)
    if str_eq(p61.source, "| @0!3 |") do print(1) else print(0) end
    # Test 62: Pattern.fullMatch (native full-match)
    if p61.fullMatch("123") & !p61.fullMatch("12") do print(1) else print(0) end
    # Test 63: Pattern.isMatch (native search/prefix check)
    if p61.isMatch("123") & !p61.isMatch("abc") do print(1) else print(0) end

    # -------------------------------------------------------
    # 22. E2E ZeroOrMoreSpaces (3 tests)
    # -------------------------------------------------------
    var p_spaces = "| @AZ!2 -!~ @0!3 |"
    # Test 64: no spaces
    if virgex.fullMatch(virgex.compile(p_spaces), "HN123") do print(1) else print(0) end
    # Test 65: one space
    if virgex.fullMatch(virgex.compile(p_spaces), "HN 123") do print(1) else print(0) end
    # Test 66: many spaces
    if virgex.fullMatch(virgex.compile(p_spaces), "HN   123") do print(1) else print(0) end
end.
