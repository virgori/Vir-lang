# EXPECT_START
# 1
# 0
# 0
# EXPECT_END

import Vec, vec_new, vec_len, vec_cap, vec_is_empty from collections.vec

func test_queries of (T)(ref v: Vec of (T)):
    if vec_is_empty of (T)(v) do
        print(1)
    else
        print(0)
    end
    print(vec_len of (T)(v))
    print(vec_cap of (T)(v))
end.

func main:
    var v = vec_new of (int)()
    test_queries of (int)(v)
    # Verify v remains valid (not moved by previous ref query calls)
    let l = vec_len of (int)(v)
    if l == 0 do
        out 0
    end
    out 1
end.
