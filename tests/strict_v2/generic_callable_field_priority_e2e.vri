# 200
# EXPECT_END

entity GenericHolder of (T):
    value: T
    op: func(int) -> int
end.

func op of (T)(h: GenericHolder of (T), x: int) -> int:
    out x + 1
end.

func double_it(x: int) -> int:
    out x * 2
end.

func main:
    var h = GenericHolder of (string)(value: "test", op: double_it)
    print(h.op(100))
    out 0
end.
