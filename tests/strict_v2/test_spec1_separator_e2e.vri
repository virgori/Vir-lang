# EXPECT_START
# 1
# 2
# 60
# 300
# 11
# 66
# 120
# 777
# EXPECT_END

func main:
    # 1. Statements separated by newline (§1.0)
    var a = 1
    var b = 2
    print a
    print b

    # 2. Statements separated by semicolon on the same line (§1.0)
    var x = 10; var y = 20; var z = 30
    print x + y + z

    # 3. Statements with redundant trailing semicolons before newline (§1.0)
    var c = 100;
    var d = 200;
    print c + d

    # 4. Multiple consecutive redundant semicolons
    var e = 5;;; var f = 6;

    # 5. Grouped variable declarations on the same line separated by semicolon (§1.0, §5.3)
    var
        m = 11; n = 22; p = 33
    print m

    # 6. Grouped variable declarations over multiple lines with trailing semicolons (§1.0)
    var
        u = 44;
        v = 55;
        w = 66
    print w

    # 7. Redundant semicolon after block and expressions
    if a < b do
        var r = 120;
        print r;
    end;

    # 8. Semicolon before closing end
    var fin = 777;
    print fin;
    out 0;
end.
