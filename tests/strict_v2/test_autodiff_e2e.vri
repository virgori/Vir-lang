# EXPECT_START
# PASS: autodiff E2E test (train block + matmul backward + grad_w + grad_x)
# EXPECT_END
func main() -> int:
    train:
        var w: tensor[f32; 2, 2] = [1.0, 2.0, 3.0, 4.0]
        var x: tensor[f32; 2, 2] = [1.0, 0.0, 0.0, 1.0]
        var out_t = w ** x
        out_t.backward()

        # Check grad_w:
        var gw = w.grad
        if gw[0, 0] != 1.0 do out 10 end
        if gw[0, 1] != 1.0 do out 11 end
        if gw[1, 0] != 1.0 do out 12 end
        if gw[1, 1] != 1.0 do out 13 end

        # Check grad_x:
        var gx = x.grad
        if gx[0, 0] != 4.0 do out 30 end
        if gx[0, 1] != 4.0 do out 31 end
        if gx[1, 0] != 6.0 do out 32 end
        if gx[1, 1] != 6.0 do out 33 end
    end

    print "PASS: autodiff E2E test (train block + matmul backward + grad_w + grad_x)"
    out 0
end.
