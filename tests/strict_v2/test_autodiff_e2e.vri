# EXPECT_START
# PASS: autodiff E2E test (train block + matmul backward + grad_w + grad_x)
# EXPECT_END
extern func native_read_i64(addr: int, offset: int) -> int

func main() -> int:
    train:
        var w: tensor<f32>[2, 2] = [1.0, 2.0, 3.0, 4.0]
        var x: tensor<f32>[2, 2] = [1.0, 0.0, 0.0, 1.0]
        var out_t = w ** x
        out_t.backward()

        # Check grad_w:
        var gw = native_read_i64(w as int, 8)
        if gw == 0 do out 1 end
        if native_read_i64(gw, 0) != 4 do out 2 end   # numel
        if native_read_i64(gw, 8) != 4 do out 3 end   # cap
        # All 4 elements of grad_w are 1.0 (bits 0x3FF0000000000000 = 4607182418800017408)
        if native_read_i64(gw, 16) != 4607182418800017408 do out 10 end
        if native_read_i64(gw, 24) != 4607182418800017408 do out 11 end
        if native_read_i64(gw, 32) != 4607182418800017408 do out 12 end
        if native_read_i64(gw, 40) != 4607182418800017408 do out 13 end

        # Check grad_x:
        var gx = native_read_i64(x as int, 8)
        if gx == 0 do out 20 end
        if native_read_i64(gx, 0) != 4 do out 21 end  # numel
        if native_read_i64(gx, 8) != 4 do out 22 end  # cap
        # gx[0,0] = 4.0 (bits 0x4010000000000000 = 4616189618054758400)
        if native_read_i64(gx, 16) != 4616189618054758400 do out 30 end
        # gx[0,1] = 4.0
        if native_read_i64(gx, 24) != 4616189618054758400 do out 31 end
        # gx[1,0] = 6.0 (bits 0x4018000000000000 = 4618441417868443648)
        if native_read_i64(gx, 32) != 4618441417868443648 do out 32 end
        # gx[1,1] = 6.0
        if native_read_i64(gx, 40) != 4618441417868443648 do out 33 end
    end

    print "PASS: autodiff E2E test (train block + matmul backward + grad_w + grad_x)"
    out 0
end.
