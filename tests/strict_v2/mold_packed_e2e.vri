mold Pixel: u16
    r: 5, g: 6, b: 5
end.

mold Mixed: u16
    low: 4
    mid: 4, high: 8
end.

mold Whole: u8
    value: 8
end.

func main:
    var px: Pixel = 0
    px.r = 31
    px.g = 42
    px.b = 7
    print px.r
    print px.g
    print px.b
    px.g = 1
    print px.r
    print px.g
    print px.b

    var mixed: Mixed = 0
    mixed.low = 3
    mixed.mid = 5
    mixed.high = 200
    print mixed.low + mixed.mid
    print mixed.high

    var whole: Whole = 0
    whole.value = 255
    print whole.value
end.
# EXPECT_START
# 31
# 42
# 7
# 31
# 1
# 7
# 8
# 200
# 255
# EXPECT_END
