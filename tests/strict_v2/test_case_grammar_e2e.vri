# EXPECT_START
# 10
# 11
# 20
# red
# yes
# EXPECT_END

func main:
    var x = 1
    case x
        1:
            print(10)
            print(11)
        2: print(12)
        else print(13)
    end

    var y = 2
    case y
        1: print(19); 2: print(20)
        else print(21)
    end

    case "red"
        "blue": print("blue")
        "red": print("red")
        else print("other")
    end

    case true
        true: print("yes")
        false: print("no")
    end

    out 0
end.
