# EXPECT_END
# §13.2–13.5: normal and thrown exits run cleanup in the mandated order.

func work(fail: int):
    print 10
    if fail == 1 do
        throw 7
    end
    print 20
    out 7
revert
    print 30
    print erx
ensure
    print 40
end.

func main:
    print work(0)
    print work(1)
end.
