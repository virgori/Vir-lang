# 25
# EXPECT_END

entity Resource of (T):
    data: T
end.

func read_val of (T)(ref r: Resource of (T)) -> T:
    out r.data
end.

func mutate_val of (T)(ref r: Resource of (T), add: T):
    r.data = r.data + add
end.

func take_move of (T)(r: Resource of (T)) -> T:
    out r.data
end.

func main:
    var r = Resource of (int)(data: 10)
    print(r.read_val())
    r.mutate_val(15)
    print(r.read_val())
    let moved_val = r.take_move()
    print(moved_val)
    out 0
end.
