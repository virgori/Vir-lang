# EXPECT_START
# 42
# 100
# 15
# 999
# EXPECT_END

register HardwareReg: u32
    val: 4..7
end.

entity DataBox:
    val: int,
    tag: int
end.

func main():
    # 1. Ordinary entity access with field named "val"
    var b = DataBox(val: 42, tag: 7)
    print(b.val)

    # 2. Ordinary entity field mutation
    b.val = 100
    print(b.val)

    # 3. Register field access with identical field name "val"
    var r: HardwareReg = 0
    r.val = 15
    print(r.val)

    # 4. Independent entity unchanged
    var b2 = DataBox(val: 999, tag: 1)
    print(b2.val)
    out 0
end.
