# EXPECT_START
# PASS: quantize edge policy
# EXPECT_END
extern func native_read_u8(addr: int, offset: int) -> int
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

func main() -> int:
    # Integer modes: -0 becomes 0; signed boundaries remain exact.
    var integer_edges: tensor[f32; 1, 3] = [0.0, -127.0, 127.0]
    native_write_i64(integer_edges as int, 16, -4396076184119541760)

    var q8 = quantize(integer_edges, bits: 8)
    var p8 = q8 as int
    if native_read_i64(p8, 16) != 1 do out 1 end
    if native_read_u8(p8, 32) != 0 do out 2 end
    if native_read_u8(p8, 33) != 129 do out 3 end
    if native_read_u8(p8, 34) != 127 do out 4 end

    var integer_edges4: tensor[f32; 1, 3] = [0.0, -7.0, 7.0]
    native_write_i64(integer_edges4 as int, 16, -4548635621496717312)
    var q4 = quantize(integer_edges4, bits: 4)
    var p4 = q4 as int
    if native_read_i64(p4, 16) != 1 do out 5 end
    if native_read_u8(p4, 32) != 144 do out 6 end
    if native_read_u8(p4, 33) != 7 do out 7 end

    # Floating modes preserve IEEE categories and signed zero.
    var ieee: tensor[f32; 1, 4] = [0.0, 0.0, 0.0, 0.0]
    var ieee_ptr = ieee as int
    native_write_i64(ieee_ptr, 16, 9187343241979101184)
    native_write_i64(ieee_ptr, 24, -9223372032568197120)

    var q32 = quantize(ieee, bits: 32)
    var p32 = q32 as int
    if native_read_u8(p32, 32) != 0 or native_read_u8(p32, 33) != 0 or native_read_u8(p32, 34) != 0xC0 or native_read_u8(p32, 35) != 0x7F do out 10 end
    if native_read_u8(p32, 36) != 0 or native_read_u8(p32, 37) != 0 or native_read_u8(p32, 38) != 0x80 or native_read_u8(p32, 39) != 0x7F do out 11 end
    if native_read_u8(p32, 40) != 0 or native_read_u8(p32, 41) != 0 or native_read_u8(p32, 42) != 0x80 or native_read_u8(p32, 43) != 0xFF do out 12 end
    if native_read_u8(p32, 44) != 0 or native_read_u8(p32, 45) != 0 or native_read_u8(p32, 46) != 0 or native_read_u8(p32, 47) != 0x80 do out 13 end

    var q16 = quantize(ieee, bits: 16)
    var p16 = q16 as int
    if native_read_u8(p16, 32) != 0 or native_read_u8(p16, 33) != 0x7E do out 20 end
    if native_read_u8(p16, 34) != 0 or native_read_u8(p16, 35) != 0x7C do out 21 end
    if native_read_u8(p16, 36) != 0 or native_read_u8(p16, 37) != 0xFC do out 22 end
    if native_read_u8(p16, 38) != 0 or native_read_u8(p16, 39) != 0x80 do out 23 end

    print "PASS: quantize edge policy"
    out 0
end.
