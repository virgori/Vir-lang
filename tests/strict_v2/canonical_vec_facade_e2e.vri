# EXPECT_START
# 0
# 0
# 3
# 7
# 7
# 7
# 1
# 3
# 10
# 20
# 30
# 99
# 1
# 1
# 0
# 30
# 10
# 10
# 99
# 30
# 255
# 17
# -1234
# 2222
# EXPECT_END

import Vec from collections.vec

func main:
    var v0 = Vec.new of (int)()
    print(v0.len())
    print(v0.cap())
    v0.free()

    var v1 = Vec.create of (int)(7, 3)
    print(v1.len())
    print(v1.get(0))
    print(v1.get(1))
    print(v1.get(2))
    v1.free()

    var v = Vec.alloc of (int)(4)
    if v.isEmpty() do
        print(1)
    else
        print(0)
    end

    v.push(10)
    v.push(20)
    v.push(30)
    print(v.len())
    print(v.get(0))
    print(v.get(1))
    print(v.get(2))

    v.set(1, 99)
    print(v.get(1))

    if v.contains(99) do
        print(1)
    else
        print(0)
    end
    print(v.count(99))
    print(v.count(100))

    v.swap(0, 2)
    print(v.get(0))
    print(v.get(2))

    v.reverse()
    print(v.get(0))
    print(v.get(1))
    print(v.get(2))

    v.free()

    var bytes = Vec.alloc of (u8)(2)
    bytes.push(255 as u8)
    bytes.push(17 as u8)
    print(bytes.get(0) as i64)
    print(bytes.get(1) as i64)
    bytes.free()

    var words = Vec.alloc of (i16)(2)
    words.push(-1234 as i16)
    words.push(2222 as i16)
    print(words.get(0) as i64)
    print(words.get(1) as i64)
    words.free()

    out 0
end.
