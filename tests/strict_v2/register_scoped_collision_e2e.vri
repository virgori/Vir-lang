# EXPECT_START
# 1
# 16
# 5
# 7
# 2
# 1
# 48
# EXPECT_END

register DeviceA: u32
    ENABLE: 0
    MODE: 1..3
end.

register DeviceB: u32
    ENABLE: 4
    MODE: 5..7
end.

func main():
    var dev_a: DeviceA = 0
    var dev_b: DeviceB = 0

    dev_a.ENABLE = 1
    dev_b.ENABLE = 1

    # Bit 0 is 1 -> raw dev_a is 1
    print(dev_a as int)
    # Bit 4 is 1 -> raw dev_b is 16
    print(dev_b as int)

    dev_a.MODE = 5
    dev_b.MODE = 7

    # Field extractions
    print(dev_a.MODE)
    print(dev_b.MODE)

    # Mutation does not collide across types
    dev_a.MODE = 2
    print(dev_a.MODE)

    # dev_b field remains isolated
    dev_b.ENABLE = 1
    dev_b.MODE = 1
    print(dev_b.ENABLE)
    print(dev_b as int)
    out 0
end.
