# EXPECT: 0
func main() -> int:
    var a: tensor[f32; 2, 2] = [1.0, 2.0, 3.0, 4.0]
    var b: tensor[f16; 2] = [1.0, 2.0]
    var c: tensor[f64; 2] = [1.5, 2.5]
    var d: tensor[i8; 2] = [-1, 42]
    var e: tensor[u8; 2] = [255, 10]
    var f: tensor[i32; 2] = [-100, 200]

    # Verify i8 signed load: -1 must remain -1, not 255
    if d[0] != -1 do out 14 end
    if d[1] != 42 do out 15 end

    # Verify u8 unsigned load: 255 must remain 255
    if e[0] != 255 do out 16 end
    if e[1] != 10 do out 17 end

    # Verify i32 signed load
    if f[0] != -100 do out 18 end
    if f[1] != 200 do out 19 end

    # Verify f32 and f64 loads
    if a[0, 0] != 1.0 do out 20 end
    if c[0] != 1.5 do out 21 end

    # Verify f16 loads
    if b[0] != 1.0 do out 22 end
    if b[1] != 2.0 do out 23 end

    out 0
end.
