# §14.2: semicolon is a canonical separator inside parameter groups.

func update:
    in delta: int; factor: int
    ref value: int
    out scaled: int

    value = value + delta
    scaled = value * factor
end.

func main:
    var value = 5
    var scaled: int
    update(3, 2, value, scaled)
    print(value)
    print(scaled)
    out 0
end.
