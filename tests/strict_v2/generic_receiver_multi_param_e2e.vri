# EXPECT_START
# 100
# world
# EXPECT_END

entity Pair of (T, U):
    first_val: T
    second_val: U

    method get_first() -> T:
        out this.first_val
    end

    method get_second() -> U:
        out this.second_val
    end
end.

func main:
    var p = Pair of (int, string)(first_val: 100, second_val: "world")
    print(p.get_first())
    print(p.get_second())
    out 0
end.
