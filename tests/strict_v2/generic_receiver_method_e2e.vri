# EXPECT_START
# 42
# hello
# 50
# EXPECT_END

entity Box of (T):
    value: T

    method read() -> T:
        out this.value
    end

    method update(new_val: T):
        this.value = new_val
    end
end.

func main:
    var b_int = Box of (int)(value: 42)
    var b_str = Box of (string)(value: "hello")
    print(b_int.read())
    print(b_str.read())
    b_int.update(50)
    print(b_int.read())
    out 0
end.
