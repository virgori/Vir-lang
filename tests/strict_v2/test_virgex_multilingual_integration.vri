# EXPECT_END

include virgex
include regex
include pattern.string

func main:
    # -------------------------------------------------------
    # 1. Core VPS Compilation (12 tests)
    # -------------------------------------------------------
    # Test 1: exact digits
    var p1 = "| @0!3 |"
    var m1_1 = virgex.fullMatch(virgex.compile(p1), "123")
    var m1_2 = !virgex.fullMatch(virgex.compile(p1), "12")
    var m1_3 = !virgex.fullMatch(virgex.compile(p1), "1234")
    var m1_4 = !virgex.fullMatch(virgex.compile(p1), "abc")
    if m1_1 & m1_2 & m1_3 & m1_4 do print(1) else print(0) end

    # Test 2: uppercase dash digits
    var p2 = "| @AZ!2 $- @0!5 |"
    var m2_1 = virgex.fullMatch(virgex.compile(p2), "HN-12345")
    var m2_2 = !virgex.fullMatch(virgex.compile(p2), "hn-12345")
    var m2_3 = !virgex.fullMatch(virgex.compile(p2), "H-12345")
    if m2_1 & m2_2 & m2_3 do print(1) else print(0) end

    # Test 3: optional group
    var p3 = "| @AZ!2 ?:( $- @0!5 :) |"
    var m3_1 = virgex.fullMatch(virgex.compile(p3), "HN")
    var m3_2 = virgex.fullMatch(virgex.compile(p3), "HN-12345")
    var m3_3 = !virgex.fullMatch(virgex.compile(p3), "HN-")
    if m3_1 & m3_2 & m3_3 do print(1) else print(0) end

    # Test 4: alternation
    var p4 = "| :( A | B | C :) |"
    var m4_1 = virgex.fullMatch(virgex.compile(p4), "A")
    var m4_2 = virgex.fullMatch(virgex.compile(p4), "B")
    var m4_3 = virgex.fullMatch(virgex.compile(p4), "C")
    var m4_4 = !virgex.fullMatch(virgex.compile(p4), "D")
    if m4_1 & m4_2 & m4_3 & m4_4 do print(1) else print(0) end

    # Test 5: alphanumeric range
    var p5 = "| @Az0!3~12 |"
    var m5_1 = virgex.fullMatch(virgex.compile(p5), "abc")
    var m5_2 = virgex.fullMatch(virgex.compile(p5), "abc123def456")
    var m5_3 = !virgex.fullMatch(virgex.compile(p5), "ab")
    var m5_4 = !virgex.fullMatch(virgex.compile(p5), "aaaaaaaaaaaaa")
    if m5_1 & m5_2 & m5_3 & m5_4 do print(1) else print(0) end

    # Test 6: space token
    var p6 = "| @AZ!2 - @0!5 |"
    var m6_1 = virgex.fullMatch(virgex.compile(p6), "HN 12345")
    var m6_2 = !virgex.fullMatch(virgex.compile(p6), "HN12345")
    if m6_1 & m6_2 do print(1) else print(0) end

    # Test 7: digit range atom
    var p7 = "| @06 |"
    var m7_0 = virgex.fullMatch(virgex.compile(p7), "0")
    var m7_6 = virgex.fullMatch(virgex.compile(p7), "6")
    var m7_7 = !virgex.fullMatch(virgex.compile(p7), "7")
    var m7_9 = !virgex.fullMatch(virgex.compile(p7), "9")
    if m7_0 & m7_6 & m7_7 & m7_9 do print(1) else print(0) end

    # Test 8: search no anchor
    var f8 = virgex.find(virgex.compile("@0!3"), "abc123def")
    if str_eq(f8, "123") do print(1) else print(0) end

    # Test 9: escape block
    var p9 = "| $.hello world.$ |"
    var m9_1 = virgex.fullMatch(virgex.compile(p9), "hello world")
    var m9_2 = !virgex.fullMatch(virgex.compile(p9), "hello world!")
    if m9_1 & m9_2 do print(1) else print(0) end

    # Test 10: repeated group
    var p10 = "| :( - @0 :)!3 |"
    var m10_1 = virgex.fullMatch(virgex.compile(p10), " 1 2 3")
    var m10_2 = !virgex.fullMatch(virgex.compile(p10), " 1 2")
    if m10_1 & m10_2 do print(1) else print(0) end

    # Test 11: zero or more
    var p11 = "| @Az!~ |"
    var m11_1 = virgex.fullMatch(virgex.compile(p11), "")
    var m11_2 = virgex.fullMatch(virgex.compile(p11), "abc")
    var m11_3 = virgex.fullMatch(virgex.compile(p11), "ABCDEFG")
    if m11_1 & m11_2 & m11_3 do print(1) else print(0) end

    # Test 12: one or more
    var p12 = "| @0!1~ |"
    var m12_1 = !virgex.fullMatch(virgex.compile(p12), "")
    var m12_2 = virgex.fullMatch(virgex.compile(p12), "1")
    var m12_3 = virgex.fullMatch(virgex.compile(p12), "12345")
    if m12_1 & m12_2 & m12_3 do print(1) else print(0) end

    # -------------------------------------------------------
    # 2. Extended Atoms & Findall (2 tests)
    # -------------------------------------------------------
    # Test 13: basic atom equivalence
    var p_az = virgex.compile("| @Az |")
    var p_upper = virgex.compile("| @AZ |")
    var p_lower = virgex.compile("| @az |")
    var p_digit = virgex.compile("| @0 |")
    var p_alnum = virgex.compile("| @Az0 |")
    var c13_1 = p_az.fullMatch("A") & p_az.fullMatch("z") & !p_az.fullMatch("0")
    var c13_2 = p_upper.fullMatch("A") & !p_upper.fullMatch("a")
    var c13_3 = p_lower.fullMatch("a") & !p_lower.fullMatch("A")
    var c13_4 = p_digit.fullMatch("5") & !p_digit.fullMatch("a")
    var c13_5 = p_alnum.fullMatch("A") & p_alnum.fullMatch("5") & !p_alnum.fullMatch("-")
    if c13_1 & c13_2 & c13_3 & c13_4 & c13_5 do print(1) else print(0) end

    # Test 14: findall
    var list14 = virgex.findAll(virgex.compile("@0!2~4"), "abc12def3456ghi78")
    var c14_len = len(list14) == 3
    var c14_items = str_eq(list14[0], "12") & str_eq(list14[1], "3456") & str_eq(list14[2], "78")
    if c14_len & c14_items do print(1) else print(0) end

    # -------------------------------------------------------
    # 3. Vietnamese Phonetics (10 tests)
    # -------------------------------------------------------
    # Test 15: consonant cluster ng/ngh
    var p15 = ":( ng | ngh :) @az!1~"
    var f15_1 = virgex.find(virgex.compile(p15), "nghe")
    var f15_2 = virgex.find(virgex.compile(p15), "ngu")
    if str_byte_len(f15_1) > 0 & str_byte_len(f15_2) > 0 do print(1) else print(0) end

    # Test 16: consonant nh
    var p16 = "nh @az!1~"
    var f16_1 = virgex.find(virgex.compile(p16), "nha")
    var f16_2 = virgex.find(virgex.compile(p16), "nhe")
    if str_byte_len(f16_1) > 0 & str_byte_len(f16_2) > 0 do print(1) else print(0) end

    # Test 17: consonant kh
    var p17 = "kh @az!1~"
    var f17_1 = virgex.find(virgex.compile(p17), "khong")
    var f17_2 = virgex.find(virgex.compile(p17), "khoe")
    if str_byte_len(f17_1) > 0 & str_byte_len(f17_2) > 0 do print(1) else print(0) end

    # Test 18: consonant ph
    var f18 = virgex.find(virgex.compile("ph @az!1~"), "pho")
    if str_byte_len(f18) > 0 do print(1) else print(0) end

    # Test 19: consonant th
    var p19 = "th @az!1~"
    var f19_1 = virgex.find(virgex.compile(p19), "the")
    var f19_2 = virgex.find(virgex.compile(p19), "them")
    if str_byte_len(f19_1) > 0 & str_byte_len(f19_2) > 0 do print(1) else print(0) end

    # Test 20: consonant gi
    var p20 = "gi ?@az"
    var f20_1 = virgex.find(virgex.compile(p20), "gia")
    var f20_2 = virgex.find(virgex.compile(p20), "gi")
    if str_byte_len(f20_1) > 0 & str_byte_len(f20_2) > 0 do print(1) else print(0) end

    # Test 21: consonant tr
    var f21 = virgex.find(virgex.compile("tr @az!1~"), "trong")
    if str_byte_len(f21) > 0 do print(1) else print(0) end

    # Test 22: consonant ch
    var f22 = virgex.find(virgex.compile("ch @az!1~"), "cho")
    if str_byte_len(f22) > 0 do print(1) else print(0) end

    # Test 23: diphthong patterns
    var p23 = ":( uo | ua :)"
    var f23_1 = virgex.find(virgex.compile(p23), "mua")
    var f23_2 = virgex.find(virgex.compile(p23), "muoi")
    if str_byte_len(f23_1) > 0 & str_byte_len(f23_2) > 0 do print(1) else print(0) end

    # Test 24: syllable structure
    var p24 = "| @az!1~3 @az!1~3 |"
    var m24_1 = virgex.fullMatch(virgex.compile(p24), "ba")
    var m24_2 = virgex.fullMatch(virgex.compile(p24), "chi")
    var m24_3 = virgex.fullMatch(virgex.compile(p24), "trong")
    if m24_1 & m24_2 & m24_3 do print(1) else print(0) end

    # -------------------------------------------------------
    # 4. Chinese Phonetics (4 tests)
    # -------------------------------------------------------
    # Test 25: initials zh ch sh
    var p25 = ":( zh | ch | sh :) @az!1~"
    var f25_1 = virgex.find(virgex.compile(p25), "zhang")
    var f25_2 = virgex.find(virgex.compile(p25), "chang")
    var f25_3 = virgex.find(virgex.compile(p25), "shang")
    if str_byte_len(f25_1) > 0 & str_byte_len(f25_2) > 0 & str_byte_len(f25_3) > 0 do print(1) else print(0) end

    # Test 26: initials j q x
    var p26 = ":( j | q | x :) :( i | u :)"
    var f26_1 = virgex.find(virgex.compile(p26), "ji")
    var f26_2 = virgex.find(virgex.compile(p26), "qi")
    var f26_3 = virgex.find(virgex.compile(p26), "xi")
    if str_byte_len(f26_1) > 0 & str_byte_len(f26_2) > 0 & str_byte_len(f26_3) > 0 do print(1) else print(0) end

    # Test 27: finals ang eng ong
    var p27 = "@az!1~ :( ang | eng | ong :)"
    var f27_1 = virgex.find(virgex.compile(p27), "zhang")
    var f27_2 = virgex.find(virgex.compile(p27), "sheng")
    var f27_3 = virgex.find(virgex.compile(p27), "zhong")
    if str_byte_len(f27_1) > 0 & str_byte_len(f27_2) > 0 & str_byte_len(f27_3) > 0 do print(1) else print(0) end

    # Test 28: pinyin syllable
    var p28 = "| @az!1~6 |"
    var m28_1 = virgex.fullMatch(virgex.compile(p28), "ma")
    var m28_2 = virgex.fullMatch(virgex.compile(p28), "zhuan")
    var m28_3 = virgex.fullMatch(virgex.compile(p28), "shuang")
    if m28_1 & m28_2 & m28_3 do print(1) else print(0) end

    # -------------------------------------------------------
    # 5. Japanese Phonetics (3 tests)
    # -------------------------------------------------------
    # Test 29: special syllables
    var p29 = ":( shi | chi | tsu | fu :)"
    var f29_1 = virgex.find(virgex.compile(p29), "sushi")
    var f29_2 = virgex.find(virgex.compile(p29), "matchi")
    var f29_3 = virgex.find(virgex.compile(p29), "fuji")
    var f29_4 = virgex.find(virgex.compile(p29), "tsuki")
    if str_eq(f29_1, "shi") & str_eq(f29_2, "chi") & str_eq(f29_3, "fu") & str_eq(f29_4, "tsu") do print(1) else print(0) end

    # Test 30: long vowels
    var p30 = ":( aa | ii | uu | ee | oo :)"
    var f30_1 = virgex.find(virgex.compile(p30), "obaasan")
    var f30_2 = virgex.find(virgex.compile(p30), "suugaku")
    var f30_3 = virgex.find(virgex.compile(p30), "oniisan")
    if str_eq(f30_1, "aa") & str_eq(f30_2, "uu") & str_eq(f30_3, "ii") do print(1) else print(0) end

    # Test 31: romaji syllable
    var p31 = "| :( @az!1~2 @az :)!1~ |"
    var m31_1 = virgex.fullMatch(virgex.compile(p31), "ka")
    var m31_2 = virgex.fullMatch(virgex.compile(p31), "shi")
    var m31_3 = virgex.fullMatch(virgex.compile(p31), "tsu")
    if m31_1 & m31_2 & m31_3 do print(1) else print(0) end

    # -------------------------------------------------------
    # 6. Korean Phonetics (2 tests)
    # -------------------------------------------------------
    # Test 32: aspirated consonants
    var p32 = ":( kh | th | ph | ch :) @az!1~"
    var f32_1 = virgex.find(virgex.compile(p32), "khada")
    var f32_2 = virgex.find(virgex.compile(p32), "thada")
    if str_byte_len(f32_1) > 0 & str_byte_len(f32_2) > 0 do print(1) else print(0) end

    # Test 33: double consonants
    var p33 = ":( kk | tt | pp | ss | jj :)"
    var f33_1 = virgex.find(virgex.compile(p33), "kka")
    var f33_2 = virgex.find(virgex.compile(p33), "tta")
    var f33_3 = virgex.find(virgex.compile(p33), "ssa")
    if str_eq(f33_1, "kk") & str_eq(f33_2, "tt") & str_eq(f33_3, "ss") do print(1) else print(0) end

    # -------------------------------------------------------
    # 7. English Phonetics (6 tests)
    # -------------------------------------------------------
    # Test 34: digraphs
    var p34 = ":( th | sh | ch | ph | wh :)"
    var f34_1 = virgex.find(virgex.compile(p34), "the")
    var f34_2 = virgex.find(virgex.compile(p34), "ship")
    var f34_3 = virgex.find(virgex.compile(p34), "church")
    var f34_4 = virgex.find(virgex.compile(p34), "phone")
    var f34_5 = virgex.find(virgex.compile(p34), "what")
    if str_byte_len(f34_1) > 0 & str_byte_len(f34_2) > 0 & str_byte_len(f34_3) > 0 & str_byte_len(f34_4) > 0 & str_byte_len(f34_5) > 0 do print(1) else print(0) end

    # Test 35: silent initial k
    var p35 = "| kn @az!1~ |"
    var m35_1 = virgex.fullMatch(virgex.compile(p35), "know")
    var m35_2 = virgex.fullMatch(virgex.compile(p35), "knife")
    var m35_3 = virgex.fullMatch(virgex.compile(p35), "knight")
    if m35_1 & m35_2 & m35_3 do print(1) else print(0) end

    # Test 36: silent initial w
    var p36 = "| wr @az!1~ |"
    var m36_1 = virgex.fullMatch(virgex.compile(p36), "write")
    var m36_2 = virgex.fullMatch(virgex.compile(p36), "wrong")
    var m36_3 = virgex.fullMatch(virgex.compile(p36), "wrap")
    if m36_1 & m36_2 & m36_3 do print(1) else print(0) end

    # Test 37: vowel digraphs
    var p37 = ":( ee | oo | ea | ai | oa :)"
    var f37_1 = virgex.find(virgex.compile(p37), "see")
    var f37_2 = virgex.find(virgex.compile(p37), "moon")
    var f37_3 = virgex.find(virgex.compile(p37), "rain")
    if str_byte_len(f37_1) > 0 & str_byte_len(f37_2) > 0 & str_byte_len(f37_3) > 0 do print(1) else print(0) end

    # Test 38: diphthongs
    var p38 = ":( ou | ow | oi | oy :)"
    var f38_1 = virgex.find(virgex.compile(p38), "house")
    var f38_2 = virgex.find(virgex.compile(p38), "cow")
    var f38_3 = virgex.find(virgex.compile(p38), "oil")
    var f38_4 = virgex.find(virgex.compile(p38), "boy")
    if str_byte_len(f38_1) > 0 & str_byte_len(f38_2) > 0 & str_byte_len(f38_3) > 0 & str_byte_len(f38_4) > 0 do print(1) else print(0) end

    # Test 39: ng final
    var p39 = "@az!1~ ng"
    var f39_1 = virgex.find(virgex.compile(p39), "sing")
    var f39_2 = virgex.find(virgex.compile(p39), "ring")
    var f39_3 = virgex.find(virgex.compile(p39), "long")
    if str_byte_len(f39_1) > 0 & str_byte_len(f39_2) > 0 & str_byte_len(f39_3) > 0 do print(1) else print(0) end

    # -------------------------------------------------------
    # 8. Cross Language Patterns (5 tests)
    # -------------------------------------------------------
    # Test 40: id code format
    var p40 = "| @AZ!2 $- @0!5 |"
    var m40_1 = virgex.fullMatch(virgex.compile(p40), "HN-12345")
    var m40_2 = virgex.fullMatch(virgex.compile(p40), "BJ-67890")
    var m40_3 = virgex.fullMatch(virgex.compile(p40), "TK-00001")
    var m40_4 = !virgex.fullMatch(virgex.compile(p40), "hn-12345")
    if m40_1 & m40_2 & m40_3 & m40_4 do print(1) else print(0) end

    # Test 41: phone pattern
    var p41 = "| ?:( $+ @0!1~3 :) @0!3 $- @0!4 |"
    var m41_1 = virgex.fullMatch(virgex.compile(p41), "123-4567")
    var m41_2 = virgex.fullMatch(virgex.compile(p41), "+84123-4567")
    var m41_3 = virgex.fullMatch(virgex.compile(p41), "+1123-4567")
    if m41_1 & m41_2 & m41_3 do print(1) else print(0) end

    # Test 42: email username
    var p42 = "| @Az0!3~20 |"
    var m42_1 = virgex.fullMatch(virgex.compile(p42), "user123")
    var m42_2 = virgex.fullMatch(virgex.compile(p42), "JohnDoe42")
    var m42_3 = !virgex.fullMatch(virgex.compile(p42), "ab")
    if m42_1 & m42_2 & m42_3 do print(1) else print(0) end

    # Test 43: hex color
    var p43 = "| $# @Az0!6 |"
    var m43_1 = virgex.fullMatch(virgex.compile(p43), "#FF00AA")
    var m43_2 = virgex.fullMatch(virgex.compile(p43), "#abc123")
    if m43_1 & m43_2 do print(1) else print(0) end

    # Test 44: date format
    var p44 = "| @0!2 $/ @0!2 $/ @0!4 |"
    var m44_1 = virgex.fullMatch(virgex.compile(p44), "25/12/2024")
    var m44_2 = virgex.fullMatch(virgex.compile(p44), "01/01/2000")
    var m44_3 = !virgex.fullMatch(virgex.compile(p44), "1/1/2000")
    if m44_1 & m44_2 & m44_3 do print(1) else print(0) end

    # -------------------------------------------------------
    # 9. VPS Error Handling (3 tests)
    # -------------------------------------------------------
    # Test 45: unterminated group
    var r45 = vps_tokenize(":( abc")
    if is_err(r45) do print(1) else print(0) end

    # Test 46: invalid quantifier range
    var r46 = vps_tokenize("@0!5~3")
    if is_err(r46) do print(1) else print(0) end

    # Test 47: unterminated escape block
    var r47 = vps_tokenize("$.abc")
    if is_err(r47) do print(1) else print(0) end

    # -------------------------------------------------------
    # 10. Equivalence Verification (3 tests)
    # -------------------------------------------------------
    # Test 48: simple pattern equivalence
    var vp48 = virgex.compile("| @0!3 |")
    var rp48 = regex.compile("^[0-9]{3}$")
    var eq48_1 = vp48.fullMatch("123") == rp48.fullMatch("123")
    var eq48_2 = vp48.fullMatch("12") == rp48.fullMatch("12")
    if eq48_1 & eq48_2 do print(1) else print(0) end

    # Test 49: group alternation
    var vp49 = virgex.compile(":( cat | dog :)")
    var eq49_1 = vp49.fullMatch("cat") & vp49.fullMatch("dog") & !vp49.fullMatch("bird")
    if eq49_1 do print(1) else print(0) end

    # Test 50: optional
    var vp50 = virgex.compile("| ?@0 |")
    var eq50_1 = vp50.fullMatch("") & vp50.fullMatch("9") & !vp50.fullMatch("a")
    if eq50_1 do print(1) else print(0) end
end.
