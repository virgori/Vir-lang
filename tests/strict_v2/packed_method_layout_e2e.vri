# EXPECT_START
# 17
# 8755
# 8772
# 17
# 51
# 34
# EXPECT_END
extern func native_read_u8(addr: int, offset: int) -> int

packed entity WithMethod:
    first: u8

    method total:
        out this.first + this.second
    end.

    second: u16
end.

func main:
    var value: WithMethod = WithMethod(first: 17, second: 8755)
    print(value.first)
    print(value.second)
    print(value.total())
    print(native_read_u8(value as int, 0))
    print(native_read_u8(value as int, 1))
    print(native_read_u8(value as int, 2))
    out 0
end.
