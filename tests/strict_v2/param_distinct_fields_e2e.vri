# EXPECT_END
# §14.4: distinct fields of one entity are disjoint writable locations.

entity Pair:
    left: int
    right: int
end.

func swap(ref first: int, ref second: int):
    var temporary = first
    first = second
    second = temporary
end.

func main:
    var pair = Pair(left: 1, right: 2)
    swap(pair.left, pair.right)
    print pair.left
    print pair.right
    out 0
end.
