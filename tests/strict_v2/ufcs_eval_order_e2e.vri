# EXPECT_START
# 6
# 123
# EXPECT_END

var trace: int = 0

func receiver_value() -> int:
    trace = trace * 10 + 1
    out 1
end.

func argument_value(value: int) -> int:
    trace = trace * 10 + value
    out value
end.

func combine(this: int, left: int, right: int) -> int:
    out this + left + right
end.

func main:
    print(receiver_value().combine(argument_value(2), argument_value(3)))
    print(trace)
    out 0
end.
