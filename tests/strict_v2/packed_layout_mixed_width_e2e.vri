extern func native_read_u8(addr: int, offset: int) -> int

packed entity Wire:
    a: u8
    b: u16
    c: u32
end.

func main:
    var wire: Wire = Wire(a: 17, b: 8755, c: 1146447479)
    print(wire.a)
    print(wire.b)
    print(wire.c)
    print(native_read_u8(wire as int, 0))
    print(native_read_u8(wire as int, 1))
    print(native_read_u8(wire as int, 2))
    print(native_read_u8(wire as int, 3))
    print(native_read_u8(wire as int, 4))
    print(native_read_u8(wire as int, 5))
    print(native_read_u8(wire as int, 6))
    out 0
end.
