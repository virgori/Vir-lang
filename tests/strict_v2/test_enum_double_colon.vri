# EXPECT_START
# 88
# 0
# 99
# 404
# EXPECT_END

enum Option<T>:
    Some(value: T)
    None
end.

enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end.

func main:
    let opt1 = Option::Some(88)
    case opt1
        Option::Some(v): print(v)
        Option::None: print(0)
    end

    let opt2: Option<int> = Option::None
    case opt2
        Option::Some(v): print(v)
        Option::None: print(0)
    end

    let res1 = Result::Ok(99)
    case res1
        Result::Ok(msg): print(msg)
        Result::Err(e): print(e)
    end

    let res2: Result<int, int> = Result::Err(404)
    case res2
        Result::Ok(msg): print(msg)
        Result::Err(e): print(e)
    end

    out 0
end.
