# test_adv_035: QuickSort partition using array swaps
# Expected: 1, 2, 3, 4, 5, 6, 7, 8

func swap:
    in(arr, i, j)
    var tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
end.
func partition:
    in(arr, lo, hi)
    var pivot = arr[hi]
    var i = lo
    var j = lo
    when j < hi loop
        if arr[j] < pivot do
            swap(arr, i, j)
            i = i + 1
        end
        j = j + 1
    end.
    swap(arr, i, hi)
    out i
end.
func qsort:
    in(arr, lo, hi)
    if lo < hi do
        var p = partition(arr, lo, hi)
        qsort(arr, lo, p - 1)
        qsort(arr, p + 1, hi)
    end
end.
func main:
    var arr = arr_new(16)
    push(arr, 4)
    push(arr, 8)
    push(arr, 2)
    push(arr, 6)
    push(arr, 1)
    push(arr, 7)
    push(arr, 3)
    push(arr, 5)

    qsort(arr, 0, 7)

    var i = 0
    when i < 8 loop
        print arr[i]
        i = i + 1
    end.
end.