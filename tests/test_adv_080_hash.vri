# test_adv_080: Hash function (simple djb2-like)
# Expected: 210714636441 (64-bit arithmetic, no wrapping)

func hash_str_manual:
    in(s)
    var h = 5381
    var i = 0
    var slen = str_len(s)
    when i < slen loop
        var c = str_get(s, i)
        h = h * 33 + c
        i = i + 1
    end.
    out h
end.
func main:
    var h = hash_str_manual("hello")
    print h
end.
