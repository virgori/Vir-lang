func main() -> int:
    var a: tensor<f32>[2, 3]
    a[0, 0] = 1
    a[0, 1] = 2
    a[0, 2] = 3
    a[1, 0] = 4
    a[1, 1] = 5
    a[1, 2] = 6

    var b: tensor<f32>[3, 2]
    b[0, 0] = 7
    b[0, 1] = 8
    b[1, 0] = 9
    b[1, 1] = 10
    b[2, 0] = 11
    b[2, 1] = 12

    var c = a ** b

    v00 = c[0, 0]
    v01 = c[0, 1]
    v10 = c[1, 0]
    v11 = c[1, 1]

    print v00
    print v01
    print v10
    print v11
    out 0
end.
