func main() -> int:
    var a: tensor<f32>[2, 2]
    a[0, 0] = 1
    a[0, 1] = 2
    a[1, 0] = 3
    a[1, 1] = 4

    var b: tensor<f32>[2, 2]
    b[0, 0] = 2
    b[0, 1] = 0
    b[1, 0] = 0
    b[1, 1] = 2

    var c = a ** b

    v00 = c[0, 0]
    v01 = c[0, 1]
    v10 = c[1, 0]
    v11 = c[1, 1]

    print v00
    print v01
    print v10
    print v11
    out 0
end.
