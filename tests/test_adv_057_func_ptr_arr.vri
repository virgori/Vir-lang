# test_adv_057: Function pointer array (VTable simulation)
# Expected: 10, 30, 50

func op_add:
    in(a, b)
    out a + b
end.
func op_sub:
    in(a, b)
    out a - b
end.
func op_mul:
    in(a, b)
    out a * b
end.
func main:
    var arr = arr_new(8)
    push(arr, op_add)
    push(arr, op_sub)
    push(arr, op_mul)

    # Indirect call through array
    var f0 = arr[0]
    var r0 = f0(3, 7)
    print r0

    var f1 = arr[1]
    var r1 = f1(50, 20)
    print r1

    var f2 = arr[2]
    var r2 = f2(5, 10)
    print r2
end.