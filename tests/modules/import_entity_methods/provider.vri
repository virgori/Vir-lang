entity ImportedCounter:
    value: int

    method read() -> int:
        out this.value
    end

    method add(delta: int) -> int:
        # A textual `end.` decoy must not terminate the imported entity.
        #*#
        end.
        #*#
        let marker = "end."
        if delta > 0 do
            this.value = this.value + delta
        end
        out this.value
    end
end.

entity ImportedBox of (T):
    value: T

    method read() -> T:
        out this.value
    end
end.

packed entity ImportedHeader:
    first: u8
    second: u16

    method total() -> int:
        out this.first + this.second
    end
end.

entity HiddenEntity:
    value: int

    method read() -> int:
        out this.value
    end
end.

export ImportedCounter, ImportedBox, ImportedHeader
