const EXPORTED_CONST: int = 7
const HIDDEN_CONST: int = 99

entity ExportedEntity:
    value: int
end.

entity HiddenEntity:
    value: int
end.

enum ExportedEnum:
    First
    Second
end.

enum HiddenEnum:
    First
    Second
end.

func exported_kind_func() -> int:
    out EXPORTED_CONST
end.

func hidden_kind_func() -> int:
    out 99
end.

export EXPORTED_CONST, ExportedEntity, ExportedEnum, exported_kind_func
