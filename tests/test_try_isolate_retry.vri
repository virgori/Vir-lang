# §13.7 try(isolate:) + resume retry — result rolled back per attempt
func main:
    atomic var attempts = 0
    var result = 10
    try(isolate: [result]):
        attempts = attempts + 1
        result = result + 1
        if attempts < 3 do
            throw 1
        end
    revert
        if attempts < 3 do
            resume retry
        end
    end
    print attempts
    print result
end.
