# test_adv_077: Collatz conjecture sequence length
# Expected: 111

func collatz_len:
    in(n)
    var steps = 0
    when n != 1 loop
        if n % 2 == 0 do
            n = n / 2
        else
            n = n * 3 + 1
        end
        steps = steps + 1
    end.
    out steps
end.
func main:
    # Collatz(27) = 111 steps
    var r = collatz_len(27)
    print r
end.