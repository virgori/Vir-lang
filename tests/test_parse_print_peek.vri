record Parser:
    pos: i64
end.

record Tok:
    line: i64
end.

func peek:
    in(p: Parser)
    out (Tok(), 0)
end.

func parse_print_stmt:
    in(p: Parser)
    line = peek(p).line
    n = 0
    var (p2, val) = parse_expr(p)
    out (p2, n)
end.

func parse_expr:
    in(x: Parser)
    out (x, 0)
end.

func main:
    var (a, b) = parse_print_stmt(Parser())
    print 1
end.
