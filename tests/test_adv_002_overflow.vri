# test_adv_002: Integer overflow behavior
# Test that overflow wraps (2's complement)
# Expected: -9223372036854775808

func main:
    var max_half = 4611686018427387903
    var maxval = max_half + max_half + 1
    # maxval = 2^63 - 1 = 9223372036854775807
    var overflow = maxval + 1
    # Should wrap to -2^63 = -9223372036854775808
    print overflow
end.