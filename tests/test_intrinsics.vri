# test_intrinsics.vri — Test Phase 7 new intrinsic opcodes
# Expected output:
# 59
# 2
# 3
# -43
# 42

func main:
    # __clz(16) = 59 on 64-bit (16 = 0b10000, 59 leading zeros)
    # Actually: 16 = 2^4, so CLZ = 64-5 = 59... wait
    # 16 in 64-bit = 0x0000000000000010
    # Leading zeros = 59
    var a = __clz(16)
    print a

    # __ctz(4) = 2 (4 = 0b100, 2 trailing zeros)
    var b = __ctz(4)
    print b

    # __popcnt(7) = 3 (7 = 0b111, 3 set bits)
    var c = __popcnt(7)
    print c

    # __neg(43) = -43
    var d = __neg(43)
    print d

    # __not(__not(42)) = 42 (double not is identity)
    var e = __not(__not(42))
    print e
end.