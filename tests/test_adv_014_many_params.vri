# test_adv_014: Stack frame integrity - many parameters
# Expected: 136

func add8:
    in(a, b, c, d, e, f, g, h)
    out a + b + c + d + e + f + g + h
end.
func add_all:
    in(a, b, c, d, e, f, g, h)
    # Call another function with params
    var s1 = add8(a, b, c, d, e, f, g, h)
    out s1
end.
func main:
    var result = add_all(1, 2, 4, 8, 16, 32, 64, 9)
    print result
end.
