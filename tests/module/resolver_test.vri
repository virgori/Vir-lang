end.

# Test 6: Diamond dependency deduplication in graph
func test_6_diamond_deduplication(root: int):
    let tname = "Test 6: repeated and diamond dependency deduplication" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let g = graph_new(r as int) as DependencyGraph

    let b_err = graph_build(g, "virc.main" as int)
    if b_err != 0 do
        record_fail(tname, s_concat2("graph build failed: " as int, s_itoa(b_err)))
        out
    end

    let order_buf = vir_alloc(MAX_GRAPH_NODES * 8)
    let count = graph_topological_sort(g, order_buf)
    if count != 4 do
        record_fail(tname, s_concat2("expected 4 modules in order, got " as int, s_itoa(count)))
        out
    end

    var idx_types = -1
    var idx_baz = -1
    var idx_bar = -1
    var idx_main = -1

    var i = 0
    when i < count loop
        let u = native_read_i64(order_buf, i * 8)
        let nid = native_read_i64(g.node_ids, u * 8)
        if s_streq(nid, "mod::core.types" as int) == 1 do idx_types = i end
        if s_streq(nid, "mod::virc.foo.baz" as int) == 1 do idx_baz = i end
        if s_streq(nid, "mod::virc.foo.bar" as int) == 1 do idx_bar = i end
        if s_streq(nid, "mod::virc.main" as int) == 1 do idx_main = i end
        i = i + 1
    end

    if idx_types < 0 or idx_baz < 0 or idx_bar < 0 or idx_main < 0 do
        record_fail(tname, "not all expected modules found in order" as int)
        out
    end

    if idx_types >= idx_baz or idx_baz >= idx_bar or idx_bar >= idx_main do
        record_fail(tname, "topological order violated (core.types < baz < bar < main required)" as int)
        out
    end

    record_pass(tname)
end.

# Test 7: Include cycle detection with explicit chain reporting (code 2126)
func test_7_cycle_reporting(root: int):
    let tname = "Test 7: include cycle detection with explicit chain reporting (E2126)" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)

    let ca = path_join(root, "project/src/foo/cycle_a.vri" as int)
    let cb = path_join(root, "project/src/foo/cycle_b.vri" as int)
    file_write_all(ca, "include virc.foo.cycle_b\n" as int)
    file_write_all(cb, "include virc.foo.cycle_a\n" as int)

    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let g = graph_new(r as int) as DependencyGraph
    let b_err = graph_build(g, "virc.foo.cycle_a" as int)
    if b_err != 0 do
        record_fail(tname, "cycle fixture build failed" as int)
        out
    end

    let order_buf = vir_alloc(MAX_GRAPH_NODES * 8)
    let res = graph_topological_sort(g, order_buf)
    if res == 2126 do
        if g.last_error_msg != 0 do
            if s_find(g.last_error_msg, "cycle_a -> mod::virc.foo.cycle_b -> mod::virc.foo.cycle_a" as int) >= 0 do
                record_pass(tname)
            else
                record_fail(tname, s_concat2("cycle chain mismatch: " as int, g.last_error_msg))
            end
        else
            record_fail(tname, "missing cycle error message" as int)
        end
    else
        record_fail(tname, s_concat2("expected cycle error 2126, got " as int, s_itoa(res)))
    end
end.

# Test 8: Same basename distinct identities
func test_8_distinct_identities(root: int):
    let tname = "Test 8: distinct same-basename files remain distinct" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver

    let res_std = resolver_resolve(r, "core.types" as int) as ResolveResult
    let res_proj = resolver_resolve(r, "virc.dup.types" as int) as ResolveResult

    if res_std.error_code != 0 or res_proj.error_code != 0 do
        record_fail(tname, "resolve error" as int)
        out
    end

    if s_streq(res_std.canonical_id, res_proj.canonical_id) == 1 do
        record_fail(tname, "canonical IDs must not be identical for distinct units" as int)
        out
    end

    if s_streq(res_std.phys_path, res_proj.phys_path) == 1 do
        record_fail(tname, "physical paths must not be identical for distinct units" as int)
        out
    end

    record_pass(tname)
end.

# Test 9: Same realpath convergence
func test_9_realpath_convergence(root: int):
    let tname = "Test 9: same physical unit through compatible spellings converges" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver

    let res_reg = resolver_resolve(r, "virc.foo.baz" as int) as ResolveResult
    let res_file = resolver_resolve(r, "src/foo/baz.vri" as int) as ResolveResult

    if res_reg.error_code != 0 or res_file.error_code != 0 do
        record_fail(tname, "resolve error" as int)
        out
    end

    if s_streq(res_reg.phys_path, res_file.phys_path) == 0 do
        record_fail(tname, "physical paths did not match" as int)
        out
    end

    if s_streq(res_reg.canonical_id, res_file.canonical_id) == 0 do
        record_fail(tname, "canonical IDs did not converge" as int)
        out
    end

    record_pass(tname)
end.

# Test 10: CWD independence
func test_10_cwd_independence(root: int):
    let tname = "Test 10: CWD independence across root, subdir, and unrelated directory" as int
    var orig_cwd = canonical_path("." as int)
    if orig_cwd == 0 do
        orig_cwd = vir_alloc(1024)
        sys_getcwd(orig_cwd, 1024)
    end

    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let sub_dir = path_join(root, "project/src/foo" as int)
    let unrelated = path_join(root, "unrelated_cwd" as int)
    sys_mkdir(unrelated, 493)

    # 1. From root
    sys_chdir(root)
    let r1 = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let res1 = resolver_resolve(r1, "virc.foo.bar" as int) as ResolveResult

    # 2. From subdir
    sys_chdir(sub_dir)
    let r2 = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let res2 = resolver_resolve(r2, "virc.foo.bar" as int) as ResolveResult

    # 3. From unrelated CWD
    sys_chdir(unrelated)
    let r3 = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let res3 = resolver_resolve(r3, "virc.foo.bar" as int) as ResolveResult

    sys_chdir(orig_cwd)
    sys_rmdir(unrelated)

    if res1.error_code != 0 or res2.error_code != 0 or res3.error_code != 0 do
        record_fail(tname, "resolve error during CWD transitions" as int)
        out
    end

    if s_streq(res1.canonical_id, res2.canonical_id) == 0 or s_streq(res2.canonical_id, res3.canonical_id) == 0 do
        record_fail(tname, "canonical IDs diverged across working directories" as int)
        out
    end

    if s_streq(res1.phys_path, res2.phys_path) == 0 or s_streq(res2.phys_path, res3.phys_path) == 0 do
        record_fail(tname, "physical paths diverged across working directories" as int)
        out
    end

    record_pass(tname)
end.

# Test 11: Real compiler driver entry dependency closure
func test_11_compiler_driver_closure(repo_root: int):
    let tname = "Test 11: compiler driver dependency DAG closure" as int
    let comp_proj = path_join(repo_root, "compiler" as int)
    let std_dir = path_join(repo_root, "stdlib" as int)

    let r = resolver_new(repo_root, comp_proj, std_dir) as ModuleResolver
    let g = graph_new(r as int) as DependencyGraph

    let b_err = graph_build(g, "driver" as int)
    if b_err != 0 do
        record_fail(tname, s_concat2("failed to build graph for 'driver': " as int, g.last_error_msg))
        out
    end

    let order_buf = vir_alloc(MAX_GRAPH_NODES * 8)
    let count = graph_topological_sort(g, order_buf)
    if count < 170 do
        record_fail(tname, s_concat2("driver module count too low: " as int, s_itoa(count)))
        out
    end

    record_pass(s_concat3(tname, " (" as int, s_concat2(s_itoa(count), " modules)" as int)))
end.

# Test 12: Real compiler bundle_entry dependency closure
func test_12_compiler_bundle_entry_closure(repo_root: int):
    let tname = "Test 12: compiler bundle_entry dependency DAG closure" as int
    let comp_proj = path_join(repo_root, "compiler" as int)
    let std_dir = path_join(repo_root, "stdlib" as int)

    let r = resolver_new(repo_root, comp_proj, std_dir) as ModuleResolver
    let g = graph_new(r as int) as DependencyGraph

    let b_err = graph_build(g, "bundle_entry" as int)
    if b_err != 0 do
        record_fail(tname, s_concat2("failed to build graph for 'bundle_entry': " as int, g.last_error_msg))
        out
    end

    let order_buf = vir_alloc(MAX_GRAPH_NODES * 8)
    let count = graph_topological_sort(g, order_buf)
    if count < 300 do
        record_fail(tname, s_concat2("bundle_entry module count too low: " as int, s_itoa(count)))
        out
    end

    record_pass(s_concat3(tname, " (" as int, s_concat2(s_itoa(count), " modules)" as int)))
end.

# Test 13: mod = . self-reference and exact entry canonical ID convergence
func test_13_self_reference_convergence(root: int):
    let tname = "Test 13: mod = . self-reference and exact entry canonical ID convergence" as int
    let t13_dir = path_join(root, "t13_proj" as int)
    sys_mkdir(t13_dir, 493)
    let ml = path_join(t13_dir, "module.list" as int)
    file_write_all(ml, "root = .\nmod = .\nflat_shared = dep_shared.vri\n" as int)
    let ds = path_join(t13_dir, "dep_shared.vri" as int)
    file_write_all(ds, "export func shared_calc(v: int) -> int: out v + 42 end.\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t13_dir, std_dir) as ModuleResolver

    let res_flat = resolver_resolve(r, "flat_shared" as int) as ResolveResult
    let res_mod = resolver_resolve(r, "mod.dep_shared" as int) as ResolveResult

    if res_flat.error_code != 0 or res_mod.error_code != 0 do
        record_fail(tname, "resolve error" as int)
        out
    end

    if s_streq(res_flat.canonical_id, "mod::flat_shared" as int) == 0 do
        record_fail(tname, "flat_shared canonical ID mismatch" as int)
        out
    end

    if s_streq(res_mod.canonical_id, "mod::flat_shared" as int) == 0 do
        record_fail(tname, "mod.dep_shared did not converge to mod::flat_shared" as int)
        out
    end

    if s_streq(res_flat.phys_path, res_mod.phys_path) == 0 do
        record_fail(tname, "physical path mismatch between flat and mod lookup" as int)
        out
    end

    record_pass(tname)
end.

# Test 14: Distinct child registry with namespace prefixing
func test_14_child_registry_prefixing(root: int):
    let tname = "Test 14: distinct child registry with namespace prefixing" as int
    let t14_dir = path_join(root, "t14_proj" as int)
    sys_mkdir(t14_dir, 493)
    let sub_dir = path_join(t14_dir, "sub" as int)
    sys_mkdir(sub_dir, 493)

    let ml_root = path_join(t14_dir, "module.list" as int)
    file_write_all(ml_root, "root = .\nsub = sub\n" as int)

    let ml_sub = path_join(sub_dir, "module.list" as int)
    file_write_all(ml_sub, "root = .\nchild_item = child_code.vri\n" as int)

    let cc = path_join(sub_dir, "child_code.vri" as int)
    file_write_all(cc, "export func child_fn: out 123 end.\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t14_dir, std_dir) as ModuleResolver

    # Sub item must resolve under sub.child_item
    let res_child = resolver_resolve(r, "sub.child_item" as int) as ResolveResult
    if res_child.error_code != 0 do
        record_fail(tname, "sub.child_item failed to resolve" as int)
        out
    end
    if s_streq(res_child.canonical_id, "mod::sub.child_item" as int) == 0 do
        record_fail(tname, "canonical ID mismatch for sub.child_item" as int)
        out
    end

    # Bare child_item must NOT be resolved at root level
    let bare_e = resolver_find_entry(r, "child_item" as int) as ModuleEntry
    if bare_e != 0 do
        record_fail(tname, "bare child_item should not pollute parent registry" as int)
        out
    end

    record_pass(tname)
end.

# Test 15: Multi-level nested registry recursion
func test_15_multilevel_recursion(root: int):
    let tname = "Test 15: multi-level nested registry recursion" as int
    let t15_dir = path_join(root, "t15_proj" as int)
    sys_mkdir(t15_dir, 493)
    let mid_dir = path_join(t15_dir, "mid" as int)
    sys_mkdir(mid_dir, 493)
    let leaf_dir = path_join(mid_dir, "leaf" as int)
    sys_mkdir(leaf_dir, 493)

    let ml1 = path_join(t15_dir, "module.list" as int)
    file_write_all(ml1, "root = .\nmid = mid\n" as int)

    let ml2 = path_join(mid_dir, "module.list" as int)
    file_write_all(ml2, "root = .\nleaf = leaf\n" as int)

    let ml3 = path_join(leaf_dir, "module.list" as int)
    file_write_all(ml3, "root = .\nitem = item.vri\n" as int)

    let item_vri = path_join(leaf_dir, "item.vri" as int)
    file_write_all(item_vri, "export func deep_fn: out 777 end.\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t15_dir, std_dir) as ModuleResolver

    let res = resolver_resolve(r, "mid.leaf.item" as int) as ResolveResult
    if res.error_code != 0 do
        record_fail(tname, "mid.leaf.item failed to resolve" as int)
        out
    end
    if s_streq(res.canonical_id, "mod::mid.leaf.item" as int) == 0 do
        record_fail(tname, "canonical ID mismatch for mid.leaf.item" as int)
        out
    end

    record_pass(tname)
end.

# Test 16: Cross-file duplicate key rejection (E2121)
func test_16_cross_file_duplicate(root: int):
    let tname = "Test 16: cross-file duplicate key rejection with provenance (E2121)" as int
    let t16_dir = path_join(root, "t16_proj" as int)
    sys_mkdir(t16_dir, 493)
    let sub_dir = path_join(t16_dir, "sub" as int)
    sys_mkdir(sub_dir, 493)

    let ml_root = path_join(t16_dir, "module.list" as int)
    file_write_all(ml_root, "root = .\nsub.item = item1.vri\nsub = sub\n" as int)

    let ml_sub = path_join(sub_dir, "module.list" as int)
    file_write_all(ml_sub, "root = .\nitem = item2.vri\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t16_dir, std_dir) as ModuleResolver

    if r.last_error_code == 2121 do
        record_pass(tname)
    else
        record_fail(tname, s_concat2("expected error code 2121, got " as int, s_itoa(r.last_error_code)))
    end
end.

# Test 17: Cyclic registry guard
func test_17_cyclic_registry_guard(root: int):
    let tname = "Test 17: cyclic registry reference termination guard" as int
    let t17_dir = path_join(root, "t17_proj" as int)
    sys_mkdir(t17_dir, 493)
    let a_dir = path_join(t17_dir, "a" as int)
    sys_mkdir(a_dir, 493)
    let b_dir = path_join(t17_dir, "b" as int)
    sys_mkdir(b_dir, 493)

    let ml_root = path_join(t17_dir, "module.list" as int)
    file_write_all(ml_root, "root = .\na = a\n" as int)

    let ml_a = path_join(a_dir, "module.list" as int)
    file_write_all(ml_a, "root = .\nb = ../b\n" as int)

    let ml_b = path_join(b_dir, "module.list" as int)
    file_write_all(ml_b, "root = .\na = ../a\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t17_dir, std_dir) as ModuleResolver
    if r.last_error_code == 0 do
        record_pass(tname)
    else
        record_fail(tname, s_concat2("unexpected error in cyclic guard: " as int, s_itoa(r.last_error_code)))
    end
end.

# Test 18: Exact cross-registry collision rejection (E2123) with provenance reporting
func test_18_cross_registry_collision(root: int):
    let tname = "Test 18: exact cross-registry collision rejection (E2123)" as int
    let t18_dir = path_join(root, "t18_proj" as int)
    sys_mkdir(t18_dir, 493)
    let local_file = path_join(t18_dir, "local_json.vri" as int)
    file_write_all(local_file, "export func local_json: out 0 end.\n" as int)

    let ml_t18 = path_join(t18_dir, "module.list" as int)
    file_write_all(ml_t18, "root = .\njson = local_json.vri\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t18_dir, std_dir) as ModuleResolver
    let exact_ok = r.last_error_code == 2123 and
        s_find(r.last_error_msg, "json" as int) >= 0 and
        s_find(r.last_error_msg, "project mapping: local_json.vri" as int) >= 0 and
        s_find(r.last_error_msg, "standard library mapping: json.vri" as int) >= 0

    let alias_dir = path_join(root, "t18_alias_proj" as int)
    sys_mkdir(alias_dir, 493)
    let json_dir = path_join(alias_dir, "json_dir" as int)
    sys_mkdir(json_dir, 493)
    let alias_ml = path_join(alias_dir, "module.list" as int)
    file_write_all(alias_ml, "root = .\njson = json_dir\n" as int)
    let alias_resolver = resolver_new(root, alias_dir, std_dir) as ModuleResolver
    let alias_ok = alias_resolver.last_error_code == 2123 and
        s_find(alias_resolver.last_error_msg, "project mapping: json_dir" as int) >= 0 and
        s_find(alias_resolver.last_error_msg, "standard library mapping: json.vri" as int) >= 0

    if exact_ok and alias_ok do
        record_pass(tname)
    else
        record_fail(tname, s_concat4("expected E2123 with full mappings, got " as int, s_itoa(r.last_error_code), " msg: " as int, r.last_error_msg))
    end
end.

# Test 19: Prefix-only allowance matrix (E2123 must NOT fire on prefix relationships)
func test_19_prefix_allowance_matrix(root: int):
    let tname = "Test 19: prefix-only allowance alongside standard library" as int
    let t19_dir = path_join(root, "t19_proj" as int)
    sys_mkdir(t19_dir, 493)
    let http_file = path_join(t19_dir, "http_app.vri" as int)
    file_write_all(http_file, "export func http_app: out 1 end.\n" as int)
    let json_file = path_join(t19_dir, "json_app.vri" as int)
    file_write_all(json_file, "export func json_app: out 2 end.\n" as int)
    let sqlite_file = path_join(t19_dir, "sqlite3.vri" as int)
    file_write_all(sqlite_file, "export func sqlite3: out 3 end.\n" as int)

    let ml_t19 = path_join(t19_dir, "module.list" as int)
    file_write_all(ml_t19, "root = .\nhttp.app = http_app.vri\njson.app = json_app.vri\ndb.sqlite3 = sqlite3.vri\n" as int)

    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, t19_dir, std_dir) as ModuleResolver
    if r.last_error_code == 0 and
        resolver_find_entry(r, "http" as int) != 0 and
        resolver_find_entry(r, "http.app" as int) != 0 and
        resolver_find_entry(r, "json" as int) != 0 and
        resolver_find_entry(r, "json.app" as int) != 0 and
        resolver_find_entry(r, "db.sqlite" as int) != 0 and
        resolver_find_entry(r, "db.sqlite3" as int) != 0 do
        record_pass(tname)
    else
        record_fail(tname, s_concat2("expected prefix-only registration success, got error " as int, s_itoa(r.last_error_code)))
    end
end.

# Test 20: Diagnostic code classification separation (E2121 vs E2123 vs E2126)
func test_20_diagnostic_classification(root: int):
    let tname = "Test 20: distinct separation of E2121, E2123, and E2126" as int
    let t20_dir = path_join(root, "t20_proj" as int)
    sys_mkdir(t20_dir, 493)
    let f1 = path_join(t20_dir, "f1.vri" as int)
    file_write_all(f1, "export func f1: out 1 end.\n" as int)
    let f2 = path_join(t20_dir, "f2.vri" as int)
    file_write_all(f2, "export func f2: out 2 end.\n" as int)

    let std_dir = path_join(root, "stdlib" as int)

    # 1. Project duplicate entry must yield E2121
    let ml_dup = path_join(t20_dir, "dup.list" as int)
    file_write_all(ml_dup, "root = .\napp = f1.vri\napp = f2.vri\n" as int)
    let r_dup = resolver_new(root, t20_dir, std_dir) as ModuleResolver
    let err_dup = resolver_parse_registry_file(r_dup, ml_dup, t20_dir, "dup.list" as int, 0)

    # 2. Cross-registry stdlib collision must yield E2123
    let ml_col = path_join(t20_dir, "col.list" as int)
    file_write_all(ml_col, "root = .\ncore.types = f1.vri\n" as int)
    let r_col = resolver_new(root, t20_dir, std_dir) as ModuleResolver
    let err_col = resolver_parse_registry_file(r_col, ml_col, t20_dir, "col.list" as int, 0)

    # 3. Directory alias prefix collision must yield E2126
    let ml_pre = path_join(t20_dir, "pre.list" as int)
    let alias_sub = path_join(t20_dir, "alias_sub" as int)
    sys_mkdir(alias_sub, 493)
    file_write_all(ml_pre, "root = .\nalias_sub = alias_sub\nalias_sub.item = f1.vri\n" as int)
    let r_pre = resolver_new(root, t20_dir, std_dir) as ModuleResolver
    let err_pre = resolver_parse_registry_file(r_pre, ml_pre, t20_dir, "pre.list" as int, 0)

    if err_dup == 2121 and err_col == 2123 and err_pre == 2126 do
        record_pass(tname)
    else
        record_fail(tname, s_concat4("classification mismatch: dup=" as int, s_itoa(err_dup), " col=" as int, s_itoa(err_col)))
    end
end.

# ── Main Entrypoint ──────────────────────────────────────────────────

func main:
    print_msg("==========================================================================" as int)
    print_msg("  VIR MODULE RESOLVER & DEPENDENCY GRAPH VERIFICATION SUITE" as int)
    print_msg("  Governed by VIR-SPC-0014 / VIRC-PLN-0003 / VIRC-PLN-0029" as int)
    print_msg("==========================================================================" as int)

    var cur_cwd = canonical_path("." as int)
    if cur_cwd == 0 do
        cur_cwd = vir_alloc(1024)
        sys_getcwd(cur_cwd, 1024)
    end

    print_msg("checkpoint 1: tmp_root" as int)
    let pid = sys_getpid()
    let tmp_root = path_join(cur_cwd, s_concat2(".tmp_vir_mod_test_" as int, s_itoa(pid)))
    sys_mkdir(tmp_root, 493)

    print_msg("checkpoint 2: setup dirs" as int)
    setup_fixture_dirs(tmp_root)

    print_msg("checkpoint 3: setup files" as int)
    setup_fixture_files(tmp_root)

    print_msg("checkpoint 4: test 1" as int)
    test_1_automatic_registry(tmp_root)
    print_msg("checkpoint 5: test 1 done" as int)
    test_2_duplicate_rejection(tmp_root)
    test_3_malformed_rejection(tmp_root)
    test_4_prefix_collision(tmp_root)
    test_5_missing_target(tmp_root)
    test_6_diamond_deduplication(tmp_root)
    test_7_cycle_reporting(tmp_root)
    test_8_distinct_identities(tmp_root)
    test_9_realpath_convergence(tmp_root)
    test_10_cwd_independence(tmp_root)

    # Tests 13-17: Nested registry, self-reference, prefixing, convergence & cycle guard
    test_13_self_reference_convergence(tmp_root)
    test_14_child_registry_prefixing(tmp_root)
    test_15_multilevel_recursion(tmp_root)
    test_16_cross_file_duplicate(tmp_root)
    test_17_cyclic_registry_guard(tmp_root)

    # Tests 18-20: Cross-registry collision, prefix allowance, and diagnostic separation
    test_18_cross_registry_collision(tmp_root)
    test_19_prefix_allowance_matrix(tmp_root)
    test_20_diagnostic_classification(tmp_root)

    # Cleanup temp fixture
    cleanup_fixture(tmp_root)

    # Run Real Compiler Dependency Closure Tests 11 & 12
    test_11_compiler_driver_closure(cur_cwd)
    test_12_compiler_bundle_entry_closure(cur_cwd)

    print_msg("──────────────────────────────────────────────────────────────────────────" as int)
    print_raw("  Result: " as int)
    print_raw(s_itoa(g_passed_tests))
    print_raw("/" as int)
    print_raw(s_itoa(g_total_tests))
    print_msg(" tests passed." as int)

    if g_passed_tests == g_total_tests and g_total_tests > 0 do
        print_msg("  All module resolver and dependency DAG contracts PASSED." as int)
        sys_exit(0)
    else
        print_msg("  Module resolver verification FAILED." as int)
        sys_exit(1)
    end
end.
