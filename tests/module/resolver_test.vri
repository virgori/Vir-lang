# ── Test Cases ───────────────────────────────────────────────────────

var g_total_tests: int = 0
var g_passed_tests: int = 0

func record_pass(test_name: int):
    g_total_tests = g_total_tests + 1
    g_passed_tests = g_passed_tests + 1
    print_raw("  [PASS] " as int)
    print_msg(test_name)
end.

func record_fail(test_name: int, reason: int):
    g_total_tests = g_total_tests + 1
    print_raw("  [FAIL] " as int)
    print_raw(test_name)
    print_raw(": " as int)
    print_msg(reason)
end.

# Test 1: Automatic stdlib and project registry loading and directory alias resolution
func test_1_automatic_registry(root: int):
    let tname = "Test 1: automatic stdlib and project registry loading and directory alias resolution" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver

    let res_std = resolver_resolve(r, "core.types" as int) as ResolveResult
    print_msg("  core.types resolved" as int)
    if res_std.error_code != 0 do
        record_fail(tname, "core.types failed to resolve" as int)
        out
    end
    if s_streq(res_std.canonical_id, "mod::core.types" as int) == 0 do
        record_fail(tname, "core.types canonical ID mismatch" as int)
        out
    end
    let expected_std = path_join(root, "stdlib/vir/core/types.vri" as int)
    if s_streq(res_std.phys_path, expected_std) == 0 do
        record_fail(tname, "core.types phys path mismatch" as int)
        out
    end

    let res_proj = resolver_resolve(r, "virc.foo.bar" as int) as ResolveResult
    if res_proj.error_code != 0 do
        record_fail(tname, "virc.foo.bar failed to resolve" as int)
        out
    end
    if s_streq(res_proj.canonical_id, "mod::virc.foo.bar" as int) == 0 do
        record_fail(tname, "virc.foo.bar canonical ID mismatch" as int)
        out
    end
    let expected_bar = path_join(root, "project/src/foo/bar.vri" as int)
    if s_streq(res_proj.phys_path, expected_bar) == 0 do
        record_fail(tname, "virc.foo.bar phys path mismatch" as int)
        out
    end

    record_pass(tname)
end.

# Test 2: Duplicate registry entry rejection (code 2121)
func test_2_duplicate_rejection(root: int):
    let tname = "Test 2: duplicate registry entry rejection (E2121)" as int
    let proj_dir = path_join(root, "project" as int)
    let std_dir = path_join(root, "stdlib" as int)
    let bad_list = path_join(proj_dir, "bad_dup.list" as int)
    file_write_all(bad_list, "virc = src\nvirc = other\n" as int)

    let r = resolver_new(root, proj_dir, std_dir) as ModuleResolver
    let err = resolver_parse_registry_file(r, bad_list, proj_dir, "bad_dup.list" as int, 0)
    if err == 2121 do
        record_pass(tname)
    else
        record_fail(tname, s_concat2("expected error code 2121, got " as int, s_itoa(err)))
    end
end.

