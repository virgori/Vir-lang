# ═════════════════════════════════════════════════════════════════════
# tests/module/resolver_test.vri — Native Module Resolver & Graph Verification
# Governed by VIR-SPC-0014 / VIRC-PLN-0003 / VIRC-PLN-0029 / VIRC-ISS-0050
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
extern func vir_get_platform() -> int
extern func exit_prog(code: int)

# ── Platform Detection & Syscalls ────────────────────────────────────

func sys_plat() -> int:
    out vir_get_platform()
end.

func sys_exit(code: int):
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        syscall1(93, code)
    eif plat == 3 do
        syscall1(60, code)
    else
        syscall1(0x2000001, code)
    end
end.

func sys_open_read(path: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        out syscall4(257, -100, path, 0, 0)
    else
        out syscall3(0x2000005, path, 0, 0)
    end
end.

func sys_open_write(path: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall4(56, -100, path, 0x0001 bit_or 0x0040 bit_or 0x0200, 420)
    eif plat == 3 do
        out syscall4(257, -100, path, 0x0001 bit_or 0x0040 bit_or 0x0200, 420)
    else
        out syscall3(0x2000005, path, 0x0001 bit_or 0x0200 bit_or 0x0400, 420)
    end
end.

func sys_close(fd: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall1(57, fd)
    eif plat == 3 do
        out syscall1(3, fd)
    else
        out syscall1(0x2000006, fd)
    end
end.

func sys_read(fd: int, buf: int, count: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(63, fd, buf, count)
    eif plat == 3 do
        out syscall3(0, fd, buf, count)
    else
        out syscall3(0x2000003, fd, buf, count)
    end
end.

func sys_write(fd: int, buf: int, count: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(64, fd, buf, count)
    eif plat == 3 do
        out syscall3(1, fd, buf, count)
    else
        out syscall3(0x2000004, fd, buf, count)
    end
end.

func sys_lseek(fd: int, offset: int, whence: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(62, fd, offset, whence)
    eif plat == 3 do
        out syscall3(8, fd, offset, whence)
    else
        out syscall3(0x20000C7, fd, offset, whence)
    end
end.

func sys_unlink(path: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(35, -100, path, 0)
    eif plat == 3 do
        out syscall1(87, path)
    else
        out syscall1(0x200000A, path)
    end
end.

func sys_mkdir(path: int, mode: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(34, -100, path, mode)
    eif plat == 3 do
        out syscall2(83, path, mode)
    else
        out syscall2(0x2000088, path, mode)
    end
end.

func sys_rmdir(path: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall3(35, -100, path, 0x200)
    eif plat == 3 do
        out syscall1(84, path)
    else
        out syscall1(0x2000089, path)
    end
end.

func sys_chdir(path: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall1(49, path)
    eif plat == 3 do
        out syscall1(80, path)
    else
        out syscall1(0x200000C, path)
    end
end.

func sys_getcwd(buf: int, size: int) -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall2(17, buf, size)
    eif plat == 3 do
        out syscall2(79, buf, size)
    else
        out syscall2(0x2000128, buf, size)
    end
end.

func sys_getpid() -> int:
    let plat = sys_plat()
    if plat == 2 or plat == 4 do
        out syscall0(172)
    eif plat == 3 do
        out syscall0(39)
    else
        out syscall0(0x2000014)
    end
end.

# ── Dynamic Memory Allocator (Bump / Arena) ──────────────────────────

var g_heap_base: int = 0
var g_heap_top: int = 0
var g_heap_limit: int = 0

func mem_init:
    if g_heap_base != 0 do out end
    let total_sz = 64 * 1024 * 1024
    let plat = sys_plat()
    var map_anon = 0x1000
    if plat == 2 or plat == 3 or plat == 4 do
        map_anon = 0x0020
    end
    var base = 0
    if plat == 2 or plat == 4 do
        base = syscall6(222, 0, total_sz, 3, 2 bit_or map_anon, -1, 0)
    eif plat == 3 do
        base = syscall6(9, 0, total_sz, 3, 2 bit_or map_anon, -1, 0)
    else
        base = syscall6(0x20000C5, 0, total_sz, 3, 2 bit_or map_anon, -1, 0)
    end
    if base <= 0 do
        base = 0x180000000
    end
    g_heap_base = base
    g_heap_top = base
    g_heap_limit = base + total_sz
end.

func vir_alloc(size: int) -> int:
    if g_heap_base == 0 do mem_init() end
    let aligned = (size + 15) bit_and (0 - 16)
    if g_heap_top + aligned > g_heap_limit do
        out 0
    end
    let res = g_heap_top
    g_heap_top = g_heap_top + aligned
    out res
end.

func vir_free(ptr: int):
    out
end.

# ── String & Path Utilities ──────────────────────────────────────────

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if native_read_u8(a, i) != native_read_u8(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_clone(s: int) -> int:
    if s == 0 do out 0 end
    let l = s_strlen(s)
    let buf = vir_alloc(l + 1)
    var i = 0
    when i < l loop
        native_write_u8(buf, i, native_read_u8(s, i))
        i = i + 1
    end
    native_write_u8(buf, l, 0)
    out buf
end.

func s_starts_with(s: int, prefix: int) -> int:
    if s == 0 or prefix == 0 do out 0 end
    let ls = s_strlen(s)
    let lp = s_strlen(prefix)
    if ls < lp do out 0 end
    var i = 0
    when i < lp loop
        if native_read_u8(s, i) != native_read_u8(prefix, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_ends_with(s: int, suffix: int) -> int:
    if s == 0 or suffix == 0 do out 0 end
    let ls = s_strlen(s)
    let lp = s_strlen(suffix)
    if ls < lp do out 0 end
    let offset = ls - lp
    var i = 0
    when i < lp loop
        if native_read_u8(s, offset + i) != native_read_u8(suffix, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_find(s: int, needle: int) -> int:
    if s == 0 or needle == 0 do out -1 end
    let ls = s_strlen(s)
    let ln = s_strlen(needle)
    if ln == 0 do out 0 end
    if ls < ln do out -1 end
    var i = 0
    when i <= ls - ln loop
        var m = 1
        var j = 0
        when j < ln loop
            if native_read_u8(s, i + j) != native_read_u8(needle, j) do
                m = 0
                break
            end
            j = j + 1
        end
        if m == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_find_char(s: int, ch: int) -> int:
    if s == 0 do out -1 end
    let ls = s_strlen(s)
    var i = 0
    when i < ls loop
        if native_read_u8(s, i) == ch do out i end
        i = i + 1
    end
    out -1
end.

func s_rfind_char(s: int, ch: int) -> int:
    if s == 0 do out -1 end
    let ls = s_strlen(s)
    var i = ls - 1
    when i >= 0 loop
        if native_read_u8(s, i) == ch do out i end
        i = i - 1
    end
    out -1
end.

func s_slice(s: int, start: int, len: int) -> int:
    if s == 0 or len <= 0 do
        let empty = vir_alloc(1)
        native_write_u8(empty, 0, 0)
        out empty
    end
    let res = vir_alloc(len + 1)
    var i = 0
    when i < len loop
        native_write_u8(res, i, native_read_u8(s, start + i))
        i = i + 1
    end
    native_write_u8(res, len, 0)
    out res
end.

func s_trim(s: int) -> int:
    if s == 0 do out 0 end
    let ls = s_strlen(s)
    var start = 0
    when start < ls loop
        let c = native_read_u8(s, start)
        if c != 32 and c != 9 and c != 10 and c != 13 do break end
        start = start + 1
    end
    var end_idx = ls
    when end_idx > start loop
        let c = native_read_u8(s, end_idx - 1)
        if c != 32 and c != 9 and c != 10 and c != 13 do break end
        end_idx = end_idx - 1
    end
    out s_slice(s, start, end_idx - start)
end.

func s_strip_quotes(s: int) -> int:
    if s == 0 do out 0 end
    let trimmed = s_trim(s)
    let ls = s_strlen(trimmed)
    if ls >= 2 do
        let c0 = native_read_u8(trimmed, 0)
        let c1 = native_read_u8(trimmed, ls - 1)
        if (c0 == 34 and c1 == 34) or (c0 == 39 and c1 == 39) do
            out s_trim(s_slice(trimmed, 1, ls - 2))
        end
    end
    out trimmed
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let buf = vir_alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        native_write_u8(buf, idx, native_read_u8(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        native_write_u8(buf, idx, native_read_u8(b, i))
        idx = idx + 1
        i = i + 1
    end
    native_write_u8(buf, idx, 0)
    out buf
end.

func s_concat3(a: int, b: int, c: int) -> int:
    out s_concat2(s_concat2(a, b), c)
end.

func s_concat4(a: int, b: int, c: int, d: int) -> int:
    out s_concat2(s_concat3(a, b, c), d)
end.

func s_replace_char(s: int, from_c: int, to_c: int) -> int:
    if s == 0 do out 0 end
    let l = s_strlen(s)
    let buf = vir_alloc(l + 1)
    var i = 0
    when i < l loop
        let c = native_read_u8(s, i)
        if c == from_c do
            native_write_u8(buf, i, to_c)
        else
            native_write_u8(buf, i, c)
        end
        i = i + 1
    end
    native_write_u8(buf, l, 0)
    out buf
end.

func s_itoa(val: int) -> int:
    if val == 0 do
        let z = vir_alloc(2)
        native_write_u8(z, 0, 48)
        native_write_u8(z, 1, 0)
        out z
    end
    var is_neg = 0
    var v = val
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let tmp = vir_alloc(32)
    var pos = 0
    when v > 0 loop
        let rem = v mod 10
        native_write_u8(tmp, pos, 48 + rem)
        pos = pos + 1
        v = v / 10
    end
    if is_neg == 1 do
        native_write_u8(tmp, pos, 45)
        pos = pos + 1
    end
    let res = vir_alloc(pos + 1)
    var i = 0
    when i < pos loop
        native_write_u8(res, i, native_read_u8(tmp, pos - 1 - i))
        i = i + 1
    end
    native_write_u8(res, pos, 0)
    out res
end.

func print_raw(s: int):
    if s == 0 do out end
    sys_write(1, s, s_strlen(s))
end.

func print_msg(s: int):
    print_raw(s)
    let nl = vir_alloc(2)
    native_write_u8(nl, 0, 10)
    native_write_u8(nl, 1, 0)
    print_raw(nl)
end.

# ── Path Normalization & Canonicalization ────────────────────────────

func path_norm(path: int) -> int:
    if path == 0 do out 0 end
    let n = s_strlen(path)
    if n == 0 do out "." as int end
    let out_buf = vir_alloc(n + 4)
    let seg_starts = vir_alloc((n + 4) * 8)
    let seg_lens = vir_alloc((n + 4) * 8)
    var seg_count = 0
    var out_len = 0
    var is_abs = 0
    if native_read_u8(path, 0) == 47 do
        is_abs = 1
        native_write_u8(out_buf, 0, 47)
        out_len = 1
    end
    var i = 0
    when i < n loop
        when i < n and native_read_u8(path, i) == 47 loop
            i = i + 1
        end
        let seg_start = i
        when i < n and native_read_u8(path, i) != 47 loop
            i = i + 1
        end
        let seg_len = i - seg_start
        if seg_len == 0 do
            # skip
        eif seg_len == 1 and native_read_u8(path, seg_start) == 46 do
            # "." component, skip
        eif seg_len == 2 and native_read_u8(path, seg_start) == 46 and native_read_u8(path, seg_start + 1) == 46 do
            # ".." component
            if seg_count > 0 do
                seg_count = seg_count - 1
                out_len = native_read_i64(seg_starts, seg_count * 8)
                if out_len > 1 and native_read_u8(out_buf, out_len - 1) == 47 do
                    out_len = out_len - 1
                end
            else
                if is_abs == 0 do
                    if out_len > 0 and native_read_u8(out_buf, out_len - 1) != 47 do
                        native_write_u8(out_buf, out_len, 47)
                        out_len = out_len + 1
                    end
                    native_write_i64(seg_starts, seg_count * 8, out_len)
                    native_write_i64(seg_lens, seg_count * 8, 2)
                    native_write_u8(out_buf, out_len, 46)
                    native_write_u8(out_buf, out_len + 1, 46)
                    out_len = out_len + 2
                    seg_count = seg_count + 1
                end
            end
        else
            if out_len > 0 and native_read_u8(out_buf, out_len - 1) != 47 do
                native_write_u8(out_buf, out_len, 47)
                out_len = out_len + 1
            end
            native_write_i64(seg_starts, seg_count * 8, out_len)
            native_write_i64(seg_lens, seg_count * 8, seg_len)
            var k = 0
            when k < seg_len loop
                native_write_u8(out_buf, out_len + k, native_read_u8(path, seg_start + k))
                k = k + 1
            end
            out_len = out_len + seg_len
            seg_count = seg_count + 1
        end
    end
    if out_len == 0 do
        if is_abs == 1 do
            native_write_u8(out_buf, 0, 47)
            native_write_u8(out_buf, 1, 0)
            out out_buf
        else
            out "." as int
        end
    end
    native_write_u8(out_buf, out_len, 0)
    out out_buf
end.

func path_join(dir: int, file: int) -> int:
    if dir == 0 or s_strlen(dir) == 0 do out file end
    if file == 0 or s_strlen(file) == 0 do out dir end
    if native_read_u8(file, 0) == 47 do
        out path_norm(file)
    end
    let dlen = s_strlen(dir)
    var need_slash = 1
    if native_read_u8(dir, dlen - 1) == 47 do
        need_slash = 0
    end
    let res = vir_alloc(dlen + need_slash + s_strlen(file) + 1)
    var idx = 0
    var i = 0
    when i < dlen loop
        native_write_u8(res, idx, native_read_u8(dir, i))
        idx = idx + 1
        i = i + 1
    end
    if need_slash == 1 do
        native_write_u8(res, idx, 47)
        idx = idx + 1
    end
    i = 0
    let flen = s_strlen(file)
    when i < flen loop
        native_write_u8(res, idx, native_read_u8(file, i))
        idx = idx + 1
        i = i + 1
    end
    native_write_u8(res, idx, 0)
    out path_norm(res)
end.

func path_parent(path: int) -> int:
    if path == 0 do out "." as int end
    let idx = s_rfind_char(path, 47)
    if idx < 0 do out "." as int end
    if idx == 0 do out "/" as int end
    out s_slice(path, 0, idx)
end.

func path_resolve(base: int, rel: int) -> int:
    if rel == 0 or s_strlen(rel) == 0 do out base end
    if native_read_u8(rel, 0) == 47 do
        out path_norm(rel)
    end
    out path_join(base, rel)
end.

# ── File I/O Helpers ─────────────────────────────────────────────────

func file_exists(path: int) -> int:
    let fd = sys_open_read(path)
    if fd >= 0 do
        sys_close(fd)
        out 1
    end
    out 0
end.

func is_regular_file(path: int) -> int:
    let fd = sys_open_read(path)
    if fd < 0 do out 0 end
    let tmp = vir_alloc(1)
    let n = sys_read(fd, tmp, 1)
    vir_free(tmp)
    sys_close(fd)
    if n >= 0 do out 1 end
    out 0
end.

func canonical_path(path: int) -> int:
    if path == 0 do out 0 end
    let fd = sys_open_read(path)
    if fd < 0 do out 0 end
    let plat = sys_plat()
    if plat == 0 or plat == 1 do
        let res = vir_alloc(4096)
        let st = syscall3(0x200005C, fd, 50, res)
        sys_close(fd)
        if st == 0 do
            out res
        end
    end
    sys_close(fd)
    out 0
end.

func file_read_all(path: int) -> int:
    let fd = sys_open_read(path)
    if fd < 0 do out 0 end
    let size = sys_lseek(fd, 0, 2)
    sys_lseek(fd, 0, 0)
    if size < 0 do
        sys_close(fd)
        out 0
    end
    let buf = vir_alloc(size + 1)
    var total = 0
    when total < size loop
        let n = sys_read(fd, buf + total, size - total)
        if n <= 0 do break end
        total = total + n
    end
    native_write_u8(buf, total, 0)
    sys_close(fd)
    out buf
end.

func file_write_all(path: int, content: int) -> int:
    let fd = sys_open_write(path)
    if fd < 0 do out -1 end
    let len = s_strlen(content)
    var total = 0
    when total < len loop
        let n = sys_write(fd, content + total, len - total)
        if n <= 0 do break end
        total = total + n
    end
    sys_close(fd)
    out 0
end.

# ── Module Resolver Structure & Engine ───────────────────────────────

const MAX_REG_ENTRIES = 1024
const MAX_REALPATH_CACHE = 1024

entity ModuleEntry:
    name: int
    rel_path: int
    phys_path: int
    is_dir: int
    source_registry: int
    line_no: int
end.

entity ModuleResolver:
    repo_root: int
    project_root: int
    stdlib_root: int
    # Entries
    entry_count: int
    entries: int # Array of pointers to ModuleEntry
    # Dir aliases
    dir_alias_count: int
    dir_aliases: int # Array of pointers to ModuleEntry
    # Realpath to ID cache
    cache_count: int
    cache_phys: int
    cache_id: int
    # Active load stack & visited set
    stack_count: int
    stack_paths: int
    visited_count: int
    visited_paths: int
    # Last error
    last_error_code: int
    last_error_msg: int
end.

func resolver_new(repo_root: int, project_root: int, stdlib_root: int) -> int:
    let r = vir_alloc(128) as ModuleResolver
    let cur_cwd = vir_alloc(1024)
    sys_getcwd(cur_cwd, 1024)

    var abs_repo = repo_root
    if abs_repo == 0 or s_strlen(abs_repo) == 0 do
        abs_repo = cur_cwd
    eif native_read_u8(abs_repo, 0) != 47 do
        abs_repo = path_resolve(cur_cwd, abs_repo)
    end
    r.repo_root = path_norm(abs_repo)

    var abs_proj = project_root
    if abs_proj == 0 or s_strlen(abs_proj) == 0 do
        abs_proj = r.repo_root
    eif native_read_u8(abs_proj, 0) != 47 do
        abs_proj = path_resolve(cur_cwd, abs_proj)
    end
    r.project_root = path_norm(abs_proj)

    var abs_std = stdlib_root
    if abs_std == 0 or s_strlen(abs_std) == 0 do
        abs_std = path_join(r.repo_root, "stdlib" as int)
    eif native_read_u8(abs_std, 0) != 47 do
        abs_std = path_resolve(cur_cwd, abs_std)
    end
    r.stdlib_root = path_norm(abs_std)

    r.entry_count = 0
    r.entries = vir_alloc(MAX_REG_ENTRIES * 8)
    r.dir_alias_count = 0
    r.dir_aliases = vir_alloc(MAX_REG_ENTRIES * 8)
    r.cache_count = 0
    r.cache_phys = vir_alloc(MAX_REALPATH_CACHE * 8)
    r.cache_id = vir_alloc(MAX_REALPATH_CACHE * 8)
    r.stack_count = 0
    r.stack_paths = vir_alloc(64 * 8)
    r.visited_count = 0
    r.visited_paths = vir_alloc(MAX_REG_ENTRIES * 8)
    r.last_error_code = 0
    r.last_error_msg = 0

    resolver_load_registries(r)
    out r as int
end.

func resolver_cache_put(r: &ModuleResolver, phys: int, mod_id: int):
    if r.cache_count >= MAX_REALPATH_CACHE do out end
    var i = 0
    when i < r.cache_count loop
        if s_streq(native_read_i64(r.cache_phys, i * 8), phys) == 1 do
            out
        end
        i = i + 1
    end
    native_write_i64(r.cache_phys, r.cache_count * 8, phys)
    native_write_i64(r.cache_id, r.cache_count * 8, mod_id)
    r.cache_count = r.cache_count + 1
end.

func resolver_cache_get(r: &ModuleResolver, phys: int) -> int:
    var i = 0
    when i < r.cache_count loop
        if s_streq(native_read_i64(r.cache_phys, i * 8), phys) == 1 do
            out native_read_i64(r.cache_id, i * 8)
        end
        i = i + 1
    end
    out 0
end.

func resolver_find_entry(r: &ModuleResolver, name: int) -> int:
    var i = 0
    when i < r.entry_count loop
        let e = native_read_i64(r.entries, i * 8) as ModuleEntry
        if s_streq(e.name, name) == 1 do
            out e as int
        end
        i = i + 1
    end
    out 0
end.

func resolver_find_dir_alias(r: &ModuleResolver, name: int) -> int:
    var i = 0
    when i < r.dir_alias_count loop
        let e = native_read_i64(r.dir_aliases, i * 8) as ModuleEntry
        if s_streq(e.name, name) == 1 do
            out e as int
        end
        i = i + 1
    end
    out 0
end.

func s_join_dotted(prefix: int, key: int) -> int:
    if prefix == 0 do out key end
    if s_strlen(prefix) == 0 do out key end
    if key == 0 do out prefix end
    if s_strlen(key) == 0 do out prefix end
    out s_concat3(prefix, "." as int, key)
end.

func resolver_parse_registry_file(r: &ModuleResolver, reg_path: int, base_dir: int, reg_name: int, prefix: int) -> int:
    if file_exists(reg_path) == 0 do
        out 0
    end
    let norm_path = path_norm(reg_path)
    var s_i = 0
    when s_i < r.stack_count loop
        if s_streq(native_read_i64(r.stack_paths, s_i * 8), norm_path) == 1 do
            out 0
        end
        s_i = s_i + 1
    end
    var v_i = 0
    when v_i < r.visited_count loop
        if s_streq(native_read_i64(r.visited_paths, v_i * 8), norm_path) == 1 do
            out 0
        end
        v_i = v_i + 1
    end
    if r.visited_count < MAX_REG_ENTRIES do
        native_write_i64(r.visited_paths, r.visited_count * 8, norm_path)
        r.visited_count = r.visited_count + 1
    end
    if r.stack_count < 64 do
        native_write_i64(r.stack_paths, r.stack_count * 8, norm_path)
        r.stack_count = r.stack_count + 1
    end

    let content = file_read_all(reg_path)
    if content == 0 do
        r.stack_count = r.stack_count - 1
        out 0
    end
    var root_dir = base_dir

    let total = s_strlen(content)
    var pos = 0
    var line_no = 1
    when pos < total loop
        let l_start = pos
        when pos < total and native_read_u8(content, pos) != 10 loop
            pos = pos + 1
        end
        let l_end = pos
        if pos < total and native_read_u8(content, pos) == 10 do
            pos = pos + 1
        end

        let raw_line = s_slice(content, l_start, l_end - l_start)
        let line = s_trim(raw_line)
        let llen = s_strlen(line)
        if llen > 0 and native_read_u8(line, 0) != 35 do
            let eq_pos = s_find_char(line, 61)
            if eq_pos < 0 do
                r.last_error_code = 2120
                r.last_error_msg = s_concat2("Malformed registry entry: " as int, raw_line)
                r.stack_count = r.stack_count - 1
                out 2120
            end

            let raw_key = s_slice(line, 0, eq_pos)
            let raw_val = s_slice(line, eq_pos + 1, llen - (eq_pos + 1))
            let key = s_trim(raw_key)
            let val = s_strip_quotes(raw_val)

            if s_streq(key, "root" as int) == 1 do
                root_dir = path_resolve(path_parent(reg_path), val)
            else
                let full_key = s_join_dotted(prefix, key)
                # Reject duplicate entries
                let existing = resolver_find_entry(r, full_key) as ModuleEntry
                if existing != 0 do
                    if s_ends_with(existing.source_registry, "stdlib.vri" as int) == 1 and s_streq(reg_name, "stdlib.vri" as int) == 0 do
                        r.last_error_code = 2123
                        var collision_msg = s_concat4(
                            "Project module '" as int,
                            full_key,
                            "' collides with standard library module declared at " as int,
                            existing.source_registry
                        )
                        collision_msg = s_concat4(collision_msg, ":" as int, s_itoa(existing.line_no), "; project mapping: " as int)
                        collision_msg = s_concat4(collision_msg, val, "; standard library mapping: " as int, existing.rel_path)
                        r.last_error_msg = collision_msg
                        r.stack_count = r.stack_count - 1
                        out 2123
                    end
                    r.last_error_code = 2121
                    r.last_error_msg = s_concat3("Duplicate module registration for '" as int, full_key, "'" as int)
                    r.stack_count = r.stack_count - 1
                    out 2121
                end

                # Check for prefix collision against existing directory aliases
                var d_i = 0
                when d_i < r.dir_alias_count loop
                    let dir_e = native_read_i64(r.dir_aliases, d_i * 8) as ModuleEntry
                    let dir_dot = s_concat2(dir_e.name, "." as int)
                    var is_child = 0
                    if prefix != 0 do
                        if s_streq(prefix, dir_e.name) == 1 or s_starts_with(prefix, dir_dot) == 1 do
                            is_child = 1
                        end
                    end
                    if is_child == 0 and s_starts_with(full_key, dir_dot) == 1 do
                        r.last_error_code = 2126
                        r.last_error_msg = s_concat4("Prefix collision: module key '" as int, full_key, "' shadows directory alias '" as int, dir_e.name)
                        r.stack_count = r.stack_count - 1
                        out 2126
                    end
                    d_i = d_i + 1
                end

                let target_phys = path_resolve(root_dir, val)
                var is_dir = 0
                if file_exists(target_phys) == 1 do
                    if is_regular_file(target_phys) == 0 do
                        is_dir = 1
                    end
                else
                    if s_ends_with(val, ".vri" as int) == 0 do
                        is_dir = 1
                    end
                end

                let entry = vir_alloc(48) as ModuleEntry
                entry.name = full_key
                entry.rel_path = val
                entry.phys_path = target_phys
                entry.is_dir = is_dir
                entry.source_registry = reg_path
                entry.line_no = line_no

                if is_dir == 1 do
                    native_write_i64(r.dir_aliases, r.dir_alias_count * 8, entry as int)
                    r.dir_alias_count = r.dir_alias_count + 1
                end

                native_write_i64(r.entries, r.entry_count * 8, entry as int)
                r.entry_count = r.entry_count + 1

                if is_dir == 0 and is_regular_file(target_phys) == 1 do
                    let mod_id = s_concat2("mod::" as int, full_key)
                    resolver_cache_put(r, target_phys, mod_id)
                end

                if is_dir == 1 do
                    let sub_ml = path_join(target_phys, "module.list" as int)
                    if file_exists(sub_ml) == 1 do
                        let sub_err = resolver_parse_registry_file(r, sub_ml, target_phys, reg_name, full_key)
                        if sub_err != 0 do
                            r.stack_count = r.stack_count - 1
                            out sub_err
                        end
                    end
                end
            end
        end
        line_no = line_no + 1
    end
    r.stack_count = r.stack_count - 1
    out 0
end.

func resolver_load_registries(r: &ModuleResolver):
    # 1. Load stdlib.vri if present
    let std_vri = path_join(r.stdlib_root, "stdlib.vri" as int)
    if file_exists(std_vri) == 1 do
        let std_vir_dir = path_join(r.stdlib_root, "vir" as int)
        let err = resolver_parse_registry_file(r, std_vri, std_vir_dir, "stdlib.vri" as int, 0)
        if err != 0 do out end
    end

    # 2. Search nearest module.list upwards from project_root
    var cur = r.project_root
    var mod_list = 0
    when 1 == 1 loop
        let cand = path_join(cur, "module.list" as int)
        if file_exists(cand) == 1 do
            mod_list = cand
            break
        end
        if s_streq(cur, r.repo_root) == 1 do break end
        let parent = path_parent(cur)
        if s_streq(parent, cur) == 1 do break end
        cur = parent
    end

    if mod_list == 0 do
        let comp_list = path_join(r.repo_root, "compiler/module.list" as int)
        if file_exists(comp_list) == 1 do
            mod_list = comp_list
        end
    end

    if mod_list != 0 and file_exists(mod_list) == 1 do
        resolver_parse_registry_file(r, mod_list, path_parent(mod_list), "module.list" as int, 0)
    end
end.

entity ResolveResult:
    canonical_id: int
    phys_path: int
    error_code: int
    error_msg: int
end.

func resolver_resolve(r: &ModuleResolver, spec: int) -> int:
    let res = vir_alloc(32) as ResolveResult
    res.canonical_id = 0
    res.phys_path = 0
    res.error_code = 0
    res.error_msg = 0

    let s = s_trim(spec)
    # Direct registered exact match
    let exact_entry = resolver_find_entry(r, s) as ModuleEntry
    if exact_entry != 0 do
        if exact_entry.is_dir == 0 do
            if is_regular_file(exact_entry.phys_path) == 0 do
                res.error_code = 2125
                res.error_msg = s_concat3("Registered target for '" as int, s, "' does not exist" as int)
                out res as int
            end
            let cid = s_concat2("mod::" as int, s)
            resolver_cache_put(r, exact_entry.phys_path, cid)
            res.canonical_id = cid
            res.phys_path = exact_entry.phys_path
            out res as int
        end
    end

    # Dotted prefix matching registered module (e.g. compiler.xyz -> xyz or virc.xyz -> xyz)
    let dot1 = s_find_char(s, 46)
    if dot1 > 0 do
        let prefix = s_slice(s, 0, dot1)
        let tail = s_slice(s, dot1 + 1, s_strlen(s) - (dot1 + 1))
        if s_streq(prefix, "compiler" as int) == 1 or s_streq(prefix, "virc" as int) == 1 do
            let tail_entry = resolver_find_entry(r, tail) as ModuleEntry
            if tail_entry != 0 do
                if tail_entry.is_dir == 0 do
                    if is_regular_file(tail_entry.phys_path) == 0 do
                        res.error_code = 2125
                        res.error_msg = s_concat3("Registered target for '" as int, tail, "' does not exist" as int)
                        out res as int
                    end
                    let cid = s_concat2("mod::" as int, tail)
                    resolver_cache_put(r, tail_entry.phys_path, cid)
                    res.canonical_id = cid
                    res.phys_path = tail_entry.phys_path
                    out res as int
                end
            end
        end
    end

    # Dotted tail lookup under directory alias (e.g. virc.foo.bar -> src/foo/bar.vri)
    if dot1 > 0 do
        let prefix = s_slice(s, 0, dot1)
        let dir_entry = resolver_find_dir_alias(r, prefix) as ModuleEntry
        if dir_entry != 0 do
            let tail_dots = s_slice(s, dot1 + 1, s_strlen(s) - (dot1 + 1))
            let tail_path = s_replace_char(tail_dots, 46, 47)
            let tail_vri = s_concat2(tail_path, ".vri" as int)
            let target = path_join(dir_entry.phys_path, tail_vri)
            if is_regular_file(target) == 0 do
                res.error_code = 2125
                res.error_msg = s_concat4("Module '" as int, s, "' resolves to missing target: " as int, target)
                out res as int
            end
            var matched_canon = 0
            var mi = 0
            when mi < r.entry_count loop
                let me = native_read_i64(r.entries, mi * 8) as ModuleEntry
                if me.is_dir == 0 do
                    if s_streq(me.phys_path, target) == 1 do
                        matched_canon = me.name
                        break
                    end
                end
                mi = mi + 1
            end
            var cid = s_concat2("mod::" as int, s)
            if matched_canon != 0 do
                cid = s_concat2("mod::" as int, matched_canon)
            end
            resolver_cache_put(r, target, cid)
            res.canonical_id = cid
            res.phys_path = target
            out res as int
        end
    end

    # Direct file path relative to project or repo root
    var file_cand = path_resolve(r.project_root, s)
    if is_regular_file(file_cand) == 0 and s_ends_with(s, ".vri" as int) == 0 do
        file_cand = path_resolve(r.project_root, s_concat2(s, ".vri" as int))
    end
    if is_regular_file(file_cand) == 1 do
        let cached_id = resolver_cache_get(r, file_cand)
        if cached_id != 0 do
            res.canonical_id = cached_id
            res.phys_path = file_cand
            out res as int
        end
        var matched_canon = 0
        var mi = 0
        when mi < r.entry_count loop
            let me = native_read_i64(r.entries, mi * 8) as ModuleEntry
            if me.is_dir == 0 do
                if s_streq(me.phys_path, file_cand) == 1 do
                    matched_canon = me.name
                    break
                end
            end
            mi = mi + 1
        end
        var cid = s_concat2("file::" as int, s)
        if matched_canon != 0 do
            cid = s_concat2("mod::" as int, matched_canon)
        end
        resolver_cache_put(r, file_cand, cid)
        res.canonical_id = cid
        res.phys_path = file_cand
        out res as int
    end

    # Stdlib fallback: dotted namespace under stdlib/vir
    if dot1 > 0 do
        var std_spec = s
        if s_starts_with(std_spec, "vir." as int) == 1 do
            std_spec = s_slice(std_spec, 4, s_strlen(std_spec) - 4)
        end
        let std_slash = s_replace_char(std_spec, 46, 47)
        let std_cand = path_join(path_join(r.stdlib_root, "vir" as int), s_concat2(std_slash, ".vri" as int))
        if is_regular_file(std_cand) == 1 do
            let cached_id = resolver_cache_get(r, std_cand)
            if cached_id != 0 do
                res.canonical_id = cached_id
                res.phys_path = std_cand
                out res as int
            end
            let cid = s_concat2("mod::" as int, s)
            resolver_cache_put(r, std_cand, cid)
            res.canonical_id = cid
            res.phys_path = std_cand
            out res as int
        end
    end

    res.error_code = 2120
    res.error_msg = s_concat3("Module '" as int, s, "' could not be resolved in registry or filesystem" as int)
    out res as int
end.

# ── Dependency Graph & Topological Sort ──────────────────────────────

const MAX_GRAPH_NODES = 1024
const MAX_NODE_DEPS = 512

entity DependencyGraph:
    resolver: int
    node_count: int
    node_ids: int      # Array of string pointers
    node_paths: int    # Array of string pointers
    adj_counts: int    # Array of ints
    adj_neighbors: int # Array of pointers to neighbor int arrays
    last_error_code: int
    last_error_msg: int
end.

func graph_new(resolver_ptr: int) -> int:
    let g = vir_alloc(64) as DependencyGraph
    g.resolver = resolver_ptr
    g.node_count = 0
    g.node_ids = vir_alloc(MAX_GRAPH_NODES * 8)
    g.node_paths = vir_alloc(MAX_GRAPH_NODES * 8)
    g.adj_counts = vir_alloc(MAX_GRAPH_NODES * 8)
    g.adj_neighbors = vir_alloc(MAX_GRAPH_NODES * 8)
    g.last_error_code = 0
    g.last_error_msg = 0
    out g as int
end.

func graph_find_or_add_node(g: &DependencyGraph, canon_id: int, phys_path: int) -> int:
    var i = 0
    when i < g.node_count loop
        if s_streq(native_read_i64(g.node_ids, i * 8), canon_id) == 1 do
            out i
        end
        i = i + 1
    end
    if g.node_count >= MAX_GRAPH_NODES do out -1 end
    let idx = g.node_count
    native_write_i64(g.node_ids, idx * 8, canon_id)
    native_write_i64(g.node_paths, idx * 8, phys_path)
    native_write_i64(g.adj_counts, idx * 8, 0)
    let n_buf = vir_alloc(MAX_NODE_DEPS * 8)
    native_write_i64(g.adj_neighbors, idx * 8, n_buf)
    g.node_count = g.node_count + 1
    out idx
end.

func graph_add_edge(g: &DependencyGraph, u: int, v: int):
    let cnt = native_read_i64(g.adj_counts, u * 8)
    let n_buf = native_read_i64(g.adj_neighbors, u * 8)
    var i = 0
    when i < cnt loop
        if native_read_i64(n_buf, i * 8) == v do out end
        i = i + 1
    end
    if cnt < MAX_NODE_DEPS do
        native_write_i64(n_buf, cnt * 8, v)
        native_write_i64(g.adj_counts, u * 8, cnt + 1)
    end
end.

# Extract includes and imports from a file
func graph_extract_dependencies(file_path: int, out_deps: int) -> int:
    let content = file_read_all(file_path)
    if content == 0 do out 0 end
    let total = s_strlen(content)
    var pos = 0
    var count = 0
    when pos < total loop
        let l_start = pos
        when pos < total and native_read_u8(content, pos) != 10 loop
            pos = pos + 1
        end
        let l_end = pos
        if pos < total and native_read_u8(content, pos) == 10 do
            pos = pos + 1
        end

        let line = s_trim(s_slice(content, l_start, l_end - l_start))
        let llen = s_strlen(line)
        if llen > 0 and native_read_u8(line, 0) != 35 do
            var spec = 0
            if s_starts_with(line, "include " as int) == 1 or s_starts_with(line, "include\t" as int) == 1 do
                var p = 7
                when p < llen and (native_read_u8(line, p) == 32 or native_read_u8(line, p) == 9) loop
                    p = p + 1
                end
                var q = p
                when q < llen and native_read_u8(line, q) != 32 and native_read_u8(line, q) != 9 and native_read_u8(line, q) != 35 loop
                    q = q + 1
                end
                spec = s_strip_quotes(s_slice(line, p, q - p))
            eif s_starts_with(line, "import " as int) == 1 or s_starts_with(line, "import\t" as int) == 1 do
                let from_idx = s_find(line, " from " as int)
                if from_idx > 0 do
                    var p = from_idx + 6
                    when p < llen and (native_read_u8(line, p) == 32 or native_read_u8(line, p) == 9) loop
                        p = p + 1
                    end
                    var q = p
                    when q < llen and native_read_u8(line, q) != 32 and native_read_u8(line, q) != 9 and native_read_u8(line, q) != 35 loop
                        q = q + 1
                    end
                    spec = s_strip_quotes(s_slice(line, p, q - p))
                end
            end
            if spec != 0 do
                if s_strlen(spec) > 0 do
                    if count < MAX_NODE_DEPS do
                        native_write_i64(out_deps, count * 8, spec)
                        count = count + 1
                    end
                end
            end
        end
    end
    out count
end.

func graph_build(g: &DependencyGraph, root_spec: int) -> int:
    let r = g.resolver as ModuleResolver
    let res = resolver_resolve(r, root_spec) as ResolveResult
    if res.error_code != 0 do
        g.last_error_code = res.error_code
        g.last_error_msg = res.error_msg
        out res.error_code
    end

    let queue = vir_alloc(MAX_GRAPH_NODES * 8)
    var q_head = 0
    var q_tail = 0
    let root_node = graph_find_or_add_node(g, res.canonical_id, res.phys_path)
    native_write_i64(queue, q_tail * 8, root_node)
    q_tail = q_tail + 1

    let visited_build = vir_alloc(MAX_GRAPH_NODES * 8)
    var i = 0
    when i < MAX_GRAPH_NODES loop
        native_write_i64(visited_build, i * 8, 0)
        i = i + 1
    end

    let deps_buf = vir_alloc(MAX_NODE_DEPS * 8)

    when q_head < q_tail loop
        let cur_u = native_read_i64(queue, q_head * 8)
        q_head = q_head + 1
        if native_read_i64(visited_build, cur_u * 8) == 1 do
            skip
        end
        native_write_i64(visited_build, cur_u * 8, 1)

        let phys = native_read_i64(g.node_paths, cur_u * 8)
        let dep_count = graph_extract_dependencies(phys, deps_buf)
        var d_i = 0
        when d_i < dep_count loop
            let dep_spec = native_read_i64(deps_buf, d_i * 8)
            let dep_res = resolver_resolve(r, dep_spec) as ResolveResult
            if dep_res.error_code != 0 do
                g.last_error_code = dep_res.error_code
                g.last_error_msg = dep_res.error_msg
                out dep_res.error_code
            end
            let v = graph_find_or_add_node(g, dep_res.canonical_id, dep_res.phys_path)
            graph_add_edge(g, cur_u, v)
            if native_read_i64(visited_build, v * 8) == 0 do
                native_write_i64(queue, q_tail * 8, v)
                q_tail = q_tail + 1
            end
            d_i = d_i + 1
        end
    end
    out 0
end.

# Topological sort with cycle detection
# State: 0 = unvisited, 1 = visiting, 2 = visited
entity TopoSortState:
    visited: int # Array of ints
    order: int   # Array of ints
    order_count: int
    path: int    # Array of ints
    path_count: int
    cycle_detected: int
    cycle_chain: int
end.

func s_cmp(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 0 end
    if a == 0 do out -1 end
    if b == 0 do out 1 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    var i = 0
    when i < la and i < lb loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca < cb do out -1 end
        if ca > cb do out 1 end
        i = i + 1
    end
    if la < lb do out -1 end
    if la > lb do out 1 end
    out 0
end.

func topo_dfs(g: &DependencyGraph, st: &TopoSortState, u: int) -> int:
    native_write_i64(st.visited, u * 8, 1)
    native_write_i64(st.path, st.path_count * 8, u)
    st.path_count = st.path_count + 1

    let cnt = native_read_i64(g.adj_counts, u * 8)
    let n_buf = native_read_i64(g.adj_neighbors, u * 8)
    # Sort neighbors alphabetically by canon_id
    let sorted_neighbors = vir_alloc(cnt * 8)
    var k = 0
    when k < cnt loop
        native_write_i64(sorted_neighbors, k * 8, native_read_i64(n_buf, k * 8))
        k = k + 1
    end
    var si = 0
    when si < cnt loop
        var sj = si + 1
        when sj < cnt loop
            let v1 = native_read_i64(sorted_neighbors, si * 8)
            let v2 = native_read_i64(sorted_neighbors, sj * 8)
            let id1 = native_read_i64(g.node_ids, v1 * 8)
            let id2 = native_read_i64(g.node_ids, v2 * 8)
            if s_cmp(id1, id2) > 0 do
                native_write_i64(sorted_neighbors, si * 8, v2)
                native_write_i64(sorted_neighbors, sj * 8, v1)
            end
            sj = sj + 1
        end
        si = si + 1
    end

    var i = 0
    when i < cnt loop
        let v = native_read_i64(sorted_neighbors, i * 8)
        let v_state = native_read_i64(st.visited, v * 8)
        if v_state == 1 do
            # Cycle detected!
            st.cycle_detected = 1
            # Find v in path
            var cycle_start = 0
            var pi = 0
            when pi < st.path_count loop
                if native_read_i64(st.path, pi * 8) == v do
                    cycle_start = pi
                    break
                end
                pi = pi + 1
            end
            var chain = "" as int
            var c_idx = cycle_start
            when c_idx < st.path_count loop
                let node_id = native_read_i64(g.node_ids, native_read_i64(st.path, c_idx * 8) * 8)
                if c_idx == cycle_start do
                    chain = node_id
                else
                    chain = s_concat3(chain, " -> " as int, node_id)
                end
                c_idx = c_idx + 1
            end
            let v_id = native_read_i64(g.node_ids, v * 8)
            chain = s_concat3(chain, " -> " as int, v_id)
            st.cycle_chain = chain
            out -1
        eif v_state == 0 do
            let err = topo_dfs(g, st, v)
            if err != 0 do out err end
        end
        i = i + 1
    end

    st.path_count = st.path_count - 1
    native_write_i64(st.visited, u * 8, 2)
    native_write_i64(st.order, st.order_count * 8, u)
    st.order_count = st.order_count + 1
    out 0
end.

func graph_topological_sort(g: &DependencyGraph, out_order: int) -> int:
    let st = vir_alloc(64) as TopoSortState
    st.visited = vir_alloc(g.node_count * 8)
    st.order = out_order
    st.order_count = 0
    st.path = vir_alloc(g.node_count * 8)
    st.path_count = 0
    st.cycle_detected = 0
    st.cycle_chain = 0

    var i = 0
    when i < g.node_count loop
        native_write_i64(st.visited, i * 8, 0)
        i = i + 1
    end

    # Sort all nodes alphabetically by canon_id
    let sorted_all = vir_alloc(g.node_count * 8)
    var k = 0
    when k < g.node_count loop
        native_write_i64(sorted_all, k * 8, k)
        k = k + 1
    end
    var si = 0
    when si < g.node_count loop
        var sj = si + 1
        when sj < g.node_count loop
            let u1 = native_read_i64(sorted_all, si * 8)
            let u2 = native_read_i64(sorted_all, sj * 8)
            let id1 = native_read_i64(g.node_ids, u1 * 8)
            let id2 = native_read_i64(g.node_ids, u2 * 8)
            if s_cmp(id1, id2) > 0 do
                native_write_i64(sorted_all, si * 8, u2)
                native_write_i64(sorted_all, sj * 8, u1)
            end
            sj = sj + 1
        end
        si = si + 1
    end

    var node_i = 0
    when node_i < g.node_count loop
        let u = native_read_i64(sorted_all, node_i * 8)
        if native_read_i64(st.visited, u * 8) == 0 do
            let err = topo_dfs(g, st, u)
            if err != 0 do
                g.last_error_code = 2126
                g.last_error_msg = s_concat2("Include cycle detected: " as int, st.cycle_chain)
                out 2126
            end
        end
        node_i = node_i + 1
    end
    out st.order_count
end.

