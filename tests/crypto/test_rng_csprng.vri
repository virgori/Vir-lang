include crypto.rng
include result
import is_ok, is_err, unwrap from result

func main():
    r = bytes(16)
    if is_ok(r) == false do print(1); out 1 end
    buf = unwrap(r)
    s = 0
    i = 0
    when i < 16 loop
        s = s + (buf[i] bit_and 255)
        i = i + 1
    end
    if s == 0 do print(2); out 2 end

    r0 = bytes(0)
    if is_err(r0) == false do print(3); out 3 end

    print(0)
    out 0
end.
