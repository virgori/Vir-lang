include crypto.hash

func eq32(got: [int], want: [int]):
    i = 0
    when i < 32 loop
        if (got[i] bit_and 255) != (want[i] bit_and 255) do out 0 end
        i = i + 1
    end
    out 1
end.

func main():
    # empty
    d0 = sha256([0], 0)
    w0 = [0xe3,0xb0,0xc4,0x42,0x98,0xfc,0x1c,0x14,0x9a,0xfb,0xf4,0xc8,0x99,0x6f,0xb9,0x24,
          0x27,0xae,0x41,0xe4,0x64,0x9b,0x93,0x4c,0xa4,0x95,0x99,0x1b,0x78,0x52,0xb8,0x55]
    if eq32(d0, w0) == 0 do print(1); out 1 end

    # abc
    d1 = sha256([97, 98, 99], 3)
    w1 = [0xba,0x78,0x16,0xbf,0x8f,0x01,0xcf,0xea,0x41,0x41,0x40,0xde,0x5d,0xae,0x22,0x23,
          0xb0,0x03,0x61,0xa3,0x96,0x17,0x7a,0x9c,0xb4,0x10,0xff,0x61,0xf2,0x00,0x15,0xad]
    if eq32(d1, w1) == 0 do print(2); out 2 end

    # 56-byte multi-block NIST
    d2 = sha256([97,98,99,100,98,99,100,101,99,100,101,102,100,101,102,103,
                 101,102,103,104,102,103,104,105,103,104,105,106,104,105,106,107,
                 105,106,107,108,106,107,108,109,107,108,109,110,108,109,110,111,
                 109,110,111,112,110,111,112,113], 56)
    w2 = [0x24,0x8d,0x6a,0x61,0xd2,0x06,0x38,0xb8,0xe5,0xc0,0x26,0x93,0x0c,0x3e,0x60,0x39,
          0xa3,0x3c,0xe4,0x59,0x64,0xff,0x21,0x67,0xf6,0xec,0xed,0xd4,0x19,0xdb,0x06,0xc1]
    if eq32(d2, w2) == 0 do print(3); out 3 end

    # double-finish → zero digest ptr
    var ctx = sha256_new()
    sha256_update(ctx, [97, 98, 99], 3)
    dig_a = sha256_finish(ctx)
    dig_b = sha256_finish(ctx)
    z = 0
    i = 0
    when i < 32 loop
        z = z bit_or read_byte(dig_b, i)
        i = i + 1
    end
    if z != 0 do print(4); out 4 end
    # first finish must be non-zero (abc digest)
    if read_byte(dig_a, 0) != 0xba do print(5); out 5 end

    print(0)
    out 0
end.
