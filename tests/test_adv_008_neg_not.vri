# test_adv_008: Double negation and NOT identity
# Expected: 42, 42, 0, -1

func main:
    # neg(neg(x)) = x
    var x = 42
    var r1 = __neg(__neg(x))
    print r1

    # not(not(x)) = x
    var r2 = __not(__not(x))
    print r2

    # neg(0) = 0
    var r3 = __neg(0)
    print r3

    # not(0) = -1 (all 1s in 2's complement)
    var r4 = __not(0)
    print r4
end.
