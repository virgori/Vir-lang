extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int
extern func syscall6(n: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int

const STDOUT_FD: 1
const SYS_WRITE: 0x2000004
const SYS_MMAP: 0x20000C5
const PROT_READ: 1
const PROT_WRITE: 2
const MAP_PRIVATE: 2
const MAP_ANONYMOUS: 4096
const MIN_ARENA_SIZE: 1048576
const BLOCK_HEADER: 16
const BLOCK_USED: 1
const ALIGNMENT: 8

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count)
end.

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset)
end.

func page_alloc:
    in(size: int)
    out sys_mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
end.

entity Heap:
    base: int
    capacity: int
    free_head: int
    used: int
end.

var g_heap = Heap ( base: 0, capacity: 0, free_head: 0, used: 0 )
var g_initialized = false

func heap_init:
    in(size: int)
    let actual = size
    if actual < MIN_ARENA_SIZE do
        actual = MIN_ARENA_SIZE
    end
    let base = page_alloc(actual)
    if base == 0 do
        out 0
    end
    native_write_i64(base, 0, actual)
    native_write_i64(base, 8, 0)
    g_heap = Heap ( base: base, capacity: actual, free_head: base, used: 0 )
    out 1
end.

func heap_alloc:
    in(size: int)
    let needed = size + BLOCK_HEADER
    needed = (needed + ALIGNMENT - 1) bit_and ~(ALIGNMENT - 1)
    let cur = g_heap.free_head
    if cur == 0 do
        out 0
    end
    let block_size = native_read_i64(cur, 0)
    if block_size >= needed do
        native_write_i64(cur, 0, needed)
        native_write_i64(cur, 8, BLOCK_USED)
        out cur + BLOCK_HEADER
    end
    out 0
end.

func vir_alloc:
    in(size: int)
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4)
        g_initialized = true
    end
    out heap_alloc(size)
end.

func print_int:
    in(n: int)
    if n == 0 do
        sys_write(STDOUT_FD, "0", 1)
    eif n == 1 do
        sys_write(STDOUT_FD, "1", 1)
    else
        sys_write(STDOUT_FD, "?", 1)
    end
    out 0
end.

func main:
    let p = vir_alloc(256)
    print p
    print g_heap.free_head
    out 0
end.
