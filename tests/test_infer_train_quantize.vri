# §26.3/§26.4 infer/train; §26.5 quantize
func main:
    var data = [100, 200, 300, 400]

    infer:
        print 1
        var sum = 0
        for i in 0..4 do
            sum = sum + data[i]
        end
        print sum
    end.
    train:
        print 2
        var sum2 = 0
        for i in 0..4 do
            sum2 = sum2 + data[i] * 2
        end
        print sum2
    end.

    # §26.5 quantize — clip each element to int_8 range [-128, 127]
    var raw = [50, 200, -300, 90]
    var q = quantize(raw, 8)
    print q[0]
    print q[1]
    print q[2]
    print q[3]
end.
