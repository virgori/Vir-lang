# Repro: form-2 `in` param list must stop before a body statement that is a call.
# Expect 42. Bug symptom: `write_word(...)` is parsed as a 4th parameter, so the
# body is empty and setv becomes a no-op → prints 0.
func setv:
    in
        buf
        i
        v
    write_word(buf, i * 8, v)
end.

func main:
    let m = alloc(64)
    setv(m, 0, 42)
    print read_word(m, 0)
end.
