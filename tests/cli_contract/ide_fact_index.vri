include compiler.ide_facts
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
import native_read_i64, native_write_i64 from string_rt

func main:
    ideFactsReset()
    g_ideFactsEnabled = 1
    var
        nodes = vec_new_rt()
        index = 0
    when index < 5000 loop
        let node = vir_alloc(80)
        var offset = 0
        when offset < 80 loop
            native_write_i64(node, offset, 0)
            offset = offset + 8
        end
        nodes = vec_push_rt(nodes, node)
        ideFactResolve(node, index, 1, 1)
        index = index + 1
    end
    index = 4999
    when index >= 0 loop
        ideFactResolve(vec_get_rt(nodes, index), index + 10000, 2, 2)
        index = index - 1
    end
    print(vec_len_rt(g_ideFacts))
    print(native_read_i64(vec_get_rt(g_ideFacts, 0), 8))
    print(native_read_i64(vec_get_rt(g_ideFacts, 4999), 8))
    index = 0
    when index < 5000 loop
        let key = fat_str_concat(fat_str_new("binding#"), str_from_cstr(rt_itoa(index)))
        let node = vec_get_rt(nodes, index)
        ideFactBinding(node, key)
        ideFactState(node, 2)
        index = index + 1
    end
    index = 0
    var proven = 0
    when index < 5000 loop
        let key = fat_str_concat(fat_str_new("binding#"), str_from_cstr(rt_itoa(index)))
        ideFactBorrowEnd(key, vec_get_rt(nodes, index))
        let fact = ideFactFind(vec_get_rt(nodes, index))
        if native_read_i64(fact, 64) == 1 and native_read_i64(fact, 72) == vec_get_rt(nodes, index) do proven = proven + 1 end
        index = index + 1
    end
    print(proven)
    let reused = vec_get_rt(nodes, 0)
    let oldKey = fat_str_new("binding#0")
    let newKey = fat_str_new("rebound#0")
    let reusedFact = ideFactFind(reused)
    native_write_i64(reusedFact, 64, 0)
    native_write_i64(reusedFact, 72, 0)
    ideFactBinding(reused, newKey)
    ideFactState(reused, 2)
    ideFactBorrowEnd(oldKey, reused)
    print(native_read_i64(reusedFact, 64))
    ideFactBorrowEnd(newKey, reused)
    print(native_read_i64(reusedFact, 64))
    ideFactsReset()
    ideFactResolve(vec_get_rt(nodes, 42), 7, 3, 1)
    print(vec_len_rt(g_ideFacts))
    print(native_read_i64(vec_get_rt(g_ideFacts, 0), 8))
end.
