include virc.tool.tool_json
import toolJsonParse, toolJsonFree, toolJsonField, toolJsonString, toolJsonInteger from virc.tool.tool_json
include virc.cli.cli_ui
import cliUiLine from virc.cli.cli_ui
func main:
    let data = get_arg(1)
    let document = toolJsonParse(data, rt_strlen(data))
    if document == 0 do print("invalid"); out end
    print("valid")
    print(native_read_i64(document, 32) - 1)
    if arg_count() > 2 do
        let field = toolJsonField(document, 1, get_arg(2))
        print(field)
        let text = toolJsonString(document, field)
        if text != 0 do cliUiLine(text) end
        let number = toolJsonInteger(document, field, 123)
        if number == 0 - 9223372036854775807 - 1 do
            print("minimum")
        else
            print(number)
        end
    end
    toolJsonFree(document)
end.
