include compiler.cli_ui
import cliUiReset, cliUiPhaseBegin, cliUiPhaseUpdate, cliUiPhaseEnd,
       cliClockNowNs from compiler.cli_ui
func main:
    cliUiReset(1, 0)
    let start = cliClockNowNs()
    if start < 0 do
        print("unavailable")
        out
    end
    cliUiPhaseBegin(7)
    var count = 0
    when cliClockNowNs() - start < 250000000 loop
        cliUiPhaseUpdate(count, 1000000000, "actualEvent" as int)
        count = count + 1
    end
    cliUiPhaseEnd(7, count, "events" as int)
end.
