var g_mir_full_opt: int = 0
var g_mir_opt_level: int = 1
var actualLevel: int = 1

func set_mir_opt_level(level: int):
    actualLevel = level
end.

func set_pipeline_mir_full(mode: int):
    if mode == 1 do
        set_pipeline_opt_level(3)
    else
        set_pipeline_opt_level(1)
    end
end.

func set_pipeline_opt_level(level: int):
    if level < 0 do
        g_mir_opt_level = 0
    eif level > 3 do
        g_mir_opt_level = 3
    else
        g_mir_opt_level = level
    end
    set_mir_opt_level(g_mir_opt_level)
    g_mir_full_opt = 0
    if g_mir_opt_level >= 2 do g_mir_full_opt = 1 end
end.

func get_pipeline_opt_level:
    out g_mir_opt_level
end.

func main:
    set_pipeline_mir_full(1)
    print(get_pipeline_opt_level())
    set_pipeline_opt_level(0)
    print(get_pipeline_opt_level())
    print(g_mir_full_opt)
    print(actualLevel)
    set_pipeline_opt_level(1)
    print(get_pipeline_opt_level())
    print(g_mir_full_opt)
    set_pipeline_opt_level(3)
    set_pipeline_mir_full(0)
    print(get_pipeline_opt_level())
end.
