include virc.cli.cli_ui
import cliClockReset, cliClockNowNs from virc.cli.cli_ui
func main:
    cliClockReset()
    let first = cliClockNowNs()
    let second = cliClockNowNs()
    if first < 0 do
        print("unavailable")
        out
    end
    if second >= first do print("monotonic") else print("backwards") end
    print(first)
    print(second)
end.
