# Repeated large documents keep node tables alive until toolJsonFree.
include compiler.tool_json
import toolJsonParse, toolJsonFree, toolJsonField, toolJsonString, toolJsonInteger from compiler.tool_json
func main:
    let data = get_arg(1)
    var iteration = 0
    when iteration < 100 loop
        let document = toolJsonParse(data, rt_strlen(data))
        if document == 0 do print "parse failed"; out 1 end
        let result = toolJsonField(document, 1, "result" as int)
        if result == 0 do print "result missing"; out 2 end
        let version = toolJsonField(document, result, "documentVersion" as int)
        if toolJsonInteger(document, version, -1) != 7 do print "version corrupt"; out 3 end
        let occurrences = toolJsonField(document, result, "occurrences" as int)
        if occurrences == 0 do print "occurrences missing"; out 4 end
        var child = native_read_i64(toolJsonNode(document, occurrences), 24)
        var count = 0
        when child > 0 loop
            let identity = toolJsonString(document, toolJsonField(document, child, "symbolId" as int))
            if identity == 0 do print "identity missing"; out 5 end
            if rt_streq(identity, "same-id" as int) != 1 do print "identity corrupt"; out 6 end
            count = count + 1
            child = native_read_i64(toolJsonNode(document, child), 32)
        end
        if count != 1000 do print "occurrences lost"; out 7 end
        toolJsonFree(document)
        iteration = iteration + 1
    end
    print "100 documents retained all 1000 occurrences"
    out 0
end.
