include alloc

var g_time_buf_start: int = 0
var g_compile_timer_printed: int = 0
var g_phase_read_us: int = 0
var g_phase_preprocess_us: int = 0
var g_phase_lex_us: int = 0
var g_phase_parse_us: int = 0
var g_phase_semantic_us: int = 0
var g_phase_semantic_start_us: int = 0
var g_phase_lower_us: int = 0
var g_phase_codegen_us: int = 0
var g_phase_link_us: int = 0
var g_diag_json: int = 1
var g_color_mode: int = 0
var resolved: int = 1
var observed: int = 1
var resets: int = 0

entity CompilerConfig:
    unused: int
end.

func set_pipeline_opt_level(level: int):
    resolved = level
end.

func optTraceReset(selector: int, level: int, enabled: int):
    observed = level
    resets = resets + 1
end.

func virc_timer_init():
    g_time_buf_start = vir_alloc(144)
end.

func cfg_get_verbose(cfg: &CompilerConfig):
    out 1
end.

func cliUiReset(mode: int, quiet: int):
    out
end.

func cliUiConfigure(color: int):
    out
end.

func pass10SessionReset():
    out
end.

func cfgOptimizationLevel(cfg: &CompilerConfig) -> int:
    out native_read_i64(cfg as int, 56)
end.

func vircResetCompileSession(cfg: &CompilerConfig):
    g_compile_timer_printed = 0
    g_phase_read_us = 0
    g_phase_preprocess_us = 0
    g_phase_lex_us = 0
    g_phase_parse_us = 0
    g_phase_semantic_us = 0
    g_phase_semantic_start_us = 0
    g_phase_lower_us = 0
    g_phase_codegen_us = 0
    g_phase_link_us = 0
    virc_timer_init()
    let opt_level = cfgOptimizationLevel(cfg)
    set_pipeline_opt_level(opt_level)
    optTraceReset(opt_level, opt_level, 0)
    cliUiReset(1, 1)
    pass10SessionReset()
end.

func main:
    let cfg = vir_alloc(80) as CompilerConfig
    native_write_i64(cfg as int, 72, 0)
    native_write_i64(cfg as int, 64, 0)
    native_write_i64(cfg as int, 56, 3)
    vircResetCompileSession(cfg)
    print(resolved)
    g_compile_timer_printed = 1
    g_phase_codegen_us = 999
    native_write_i64(cfg as int, 56, 0)
    vircResetCompileSession(cfg)
    print(resolved)
    print(observed)
    print(g_compile_timer_printed)
    print(g_phase_codegen_us)
    native_write_i64(cfg as int, 56, 1)
    vircResetCompileSession(cfg)
    vircResetCompileSession(cfg)
    print(resolved)
    print(resets)
end.
