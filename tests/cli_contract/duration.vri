include compiler.cli_ui
import formatDurationNs, cliTicksToNs, cliUiLine from compiler.cli_ui
func main:
    cliUiLine(formatDurationNs(0))
    cliUiLine(formatDurationNs(24580000))
    cliUiLine(formatDurationNs(999994999))
    cliUiLine(formatDurationNs(999995000))
    cliUiLine(formatDurationNs(12450000000))
    cliUiLine(formatDurationNs(59994999999))
    cliUiLine(formatDurationNs(59995000000))
    cliUiLine(formatDurationNs(87270000000))
    cliUiLine(formatDurationNs(3599994999999))
    cliUiLine(formatDurationNs(3599995000000))
    cliUiLine(formatDurationNs(3734500000000))
    cliUiLine(formatDurationNs(9223372036854775807))
    cliUiLine(formatDurationNs(0 - 1))
    print(cliTicksToNs(24, 24000000))
    print(cliTicksToNs(24000001, 24000000))
    print(cliTicksToNs(0 - 1, 24000000))
    print(cliTicksToNs(9223372036854775807, 1))
end.
