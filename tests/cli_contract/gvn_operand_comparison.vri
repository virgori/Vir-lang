# GVN compares operands without constructing temporary canonicalization tuples.

func main:
    let first = mir_opnd_vreg(1)
    let second = mir_opnd_vreg(2)
    let add = mir_instr_new(MirOp.Add, mir_opnd_vreg(3), first, second)
    let subtract = mir_instr_new(MirOp.Sub, mir_opnd_vreg(4), first, second)
    let literal = mir_opnd_imm(7)
    let mixed = mir_instr_new(MirOp.Add, mir_opnd_vreg(5), first, literal)
    var index = 0
    var matches = 0
    when index < 100000 loop
        if mir_gvn_expr_same(add, MirOp.Add, second, first) do matches = matches + 1 end
        if mir_gvn_expr_same(subtract, MirOp.Sub, first, second) do matches = matches + 1 end
        if mir_gvn_expr_same(subtract, MirOp.Sub, second, first) do matches = matches + 1000000 end
        if mir_gvn_expr_same(mixed, MirOp.Add, literal, first) do matches = matches + 1 end
        index = index + 1
    end
    print(matches)
end.
