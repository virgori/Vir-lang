# Structural regression: a value crosses a call and an empty block on its
# way to a return block that appears earlier in layout. The final unreachable
# block (or conditional fallthrough) must not extend its lifetime. Vreg 65 checks a second bitset word.
import lir_compute_liveness from virc.ir.lir.lir_liveness
import LirOp, LirType, lir_func_new, lir_block_new, lir_instr_new, lir_opnd_none, lir_opnd_imm, lir_opnd_label, lir_opnd_vreg_int from virc.ir.lir.lir
import vec_new_rt, vec_push_rt, vec_get_rt from vec_rt
import native_read_i64 from string_rt

func inspectIntervals(valueId: int, conditional: bool):
    var
        blocks = vec_new_rt()
        entry = vec_new_rt()
    entry = vec_push_rt(entry, lir_instr_new(LirOp.Mov, LirType.Int64, lir_opnd_vreg_int(valueId), lir_opnd_imm(123), lir_opnd_none(), 0))
    entry = vec_push_rt(entry, lir_instr_new(LirOp.Jmp, LirType.Int64, lir_opnd_none(), lir_opnd_imm(2), lir_opnd_none(), 0))
    blocks = vec_push_rt(blocks, lir_block_new(0, entry))
    var join = vec_new_rt()
    join = vec_push_rt(join, lir_instr_new(LirOp.Ret, LirType.Int64, lir_opnd_none(), lir_opnd_vreg_int(valueId), lir_opnd_none(), 0))
    blocks = vec_push_rt(blocks, lir_block_new(1, join))
    blocks = vec_push_rt(blocks, lir_block_new(2, vec_new_rt()))
    var bridge = vec_new_rt()
    bridge = vec_push_rt(bridge, lir_instr_new(LirOp.Call, LirType.Int64, lir_opnd_none(), lir_opnd_imm(0), lir_opnd_none(), 0))
    if conditional do
        bridge = vec_push_rt(bridge, lir_instr_new(LirOp.JmpCond, LirType.Int64, lir_opnd_none(), lir_opnd_imm(1), lir_opnd_label(1), 0))
    else
        bridge = vec_push_rt(bridge, lir_instr_new(LirOp.Jmp, LirType.Int64, lir_opnd_none(), lir_opnd_imm(1), lir_opnd_none(), 0))
    end
    blocks = vec_push_rt(blocks, lir_block_new(3, bridge))
    var dead = vec_new_rt()
    dead = vec_push_rt(dead, lir_instr_new(LirOp.Ret, LirType.Int64, lir_opnd_none(), lir_opnd_imm(0), lir_opnd_none(), 0))
    blocks = vec_push_rt(blocks, lir_block_new(4, dead))
    let
        function = lir_func_new(0, "intervals", blocks, 0, vec_new_rt())
        intervals = lir_compute_liveness(function)
        interval = vec_get_rt(intervals, valueId)
    print(native_read_i64(interval, 8))
    print(native_read_i64(interval, 16))
    print(native_read_i64(interval, 24))
end.

func main:
    inspectIntervals(0, false)
    inspectIntervals(65, false)
    inspectIntervals(0, true)
    inspectIntervals(65, true)
end.
