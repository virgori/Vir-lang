    # ──────────────────────────────────────────────────────────────────
    let invalid_sysroots = alloc(72)
    native_write_i64(invalid_sysroots, 0, "tests/sysroot_contract/fixtures/malformed_line" as int)
    native_write_i64(invalid_sysroots, 8, "tests/sysroot_contract/fixtures/version_mismatch" as int)
    native_write_i64(invalid_sysroots, 16, "tests/sysroot_contract/fixtures/compiler_min_too_high" as int)
    native_write_i64(invalid_sysroots, 24, "tests/sysroot_contract/fixtures/abi_prefix" as int)
    native_write_i64(invalid_sysroots, 32, "tests/sysroot_contract/fixtures/duplicate_metadata" as int)
    native_write_i64(invalid_sysroots, 40, "tests/sysroot_contract/fixtures/mapping_escape" as int)
    native_write_i64(invalid_sysroots, 48, "tests/sysroot_contract/fixtures/semver_overflow" as int)
    native_write_i64(invalid_sysroots, 56, "tests/sysroot_contract/fixtures/duplicate_module" as int)
    native_write_i64(invalid_sysroots, 64, "tests/sysroot_contract/fixtures/directory_target" as int)
    let invalid_count = 9
    i = 0
    when i < invalid_count loop
        sys_unlink(tmp_out)
        sys_unlink(tmp_err)
        let invalid_path = native_read_i64(invalid_sysroots, i * 8)
        let argv_invalid = alloc(40)
        native_write_i64(argv_invalid, 0, virc_bin)
        native_write_i64(argv_invalid, 8, "--sysroot" as int)
        native_write_i64(argv_invalid, 16, invalid_path)
        native_write_i64(argv_invalid, 24, "--print-sysroot" as int)
        native_write_i64(argv_invalid, 32, 0)
        let rc_invalid = run_cmd_io(argv_invalid, tmp_out, tmp_err)
        let invalid_diag = s_concat2(sys_read_file(tmp_out), sys_read_file(tmp_err))
        var invalid_ok = 0
        if rc_invalid != 0 and s_find_str(invalid_diag, "E2120" as int) >= 0 do
            invalid_ok = 1
        end
        record_test(s_concat2("invalid sysroot fails closed: " as int, invalid_path), invalid_ok)
        i = i + 1
    end

