# ═════════════════════════════════════════════════════════════════════
# tests/cli_contract/cli_contract_test.vri
# Native CLI Contract Verification Suite
# Governed by VIRC-ISS-0043, VIRC-ISS-0050, VIRC-PLN-0028 and VIRC-PLN-0029
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_concat3(a: int, b: int, c: int) -> int:
    let ab = s_concat2(a, b)
    out s_concat2(ab, c)
end.

func s_concat4(a: int, b: int, c: int, d: int) -> int:
    let ab = s_concat2(a, b)
    let cd = s_concat2(c, d)
    out s_concat2(ab, cd)
end.

func s_find_str(haystack: int, needle: int) -> int:
    if haystack == 0 or needle == 0 do out -1 end
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_starts_with(haystack: int, prefix: int) -> int:
    if haystack == 0 or prefix == 0 do out 0 end
    let plen = s_strlen(prefix)
    let hlen = s_strlen(haystack)
    if hlen < plen do out 0 end
    var i = 0
    when i < plen loop
        if read_byte(haystack, i) != read_byte(prefix, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_write_fd(fd: int, data: int) -> int:
    let
        plat = vir_get_platform()
        len = s_strlen(data)
    if plat == 2 or plat == 3 or plat == 4 do out syscall3(1, fd, data, len) end
    out syscall3(0x2000004, fd, data, len)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_chdir(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall1(49, path) end
    if plat == 3 do out syscall1(80, path) end
    out syscall1(0x200000C, path)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_mkdir(path: int, mode: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(34, -100, path, mode) end
    if plat == 3 do out syscall2(83, path, mode) end
    out syscall2(0x2000088, path, mode)
end.

func sys_rmdir(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0x200) end
    if plat == 3 do out syscall1(84, path) end
    out syscall1(0x2000089, path)
end.

func sys_file_exists(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd >= 0 do
        sys_close(fd)
        out 1
    end
    out 0
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 524288 # 512KB
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func sys_trim(s: int) -> int:
    let len = s_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    let tlen = end_pos - start
    if tlen <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(tlen + 1)
    var i = 0
    when i < tlen loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, tlen, 0)
    out res
end.

func run_cmd_io_context:
    in
        cmd_argv: int
        out_file: int
        err_file: int
        extra_env: int
        cwd: int

    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if s_strlen(out_file) > 0 do
            let out_fd = sys_open_write(out_file)
            if out_fd >= 0 do
                sys_dup2(out_fd, 1)
                sys_close(out_fd)
            end
        end
        if s_strlen(err_file) > 0 do
            let err_fd = sys_open_write(err_file)
            if err_fd >= 0 do
                sys_dup2(err_fd, 2)
                sys_close(err_fd)
            end
        end

        if cwd != 0 do
            if sys_chdir(cwd) != 0 do exit_prog(126) end
        end

        let bin_prog = native_read_i64(cmd_argv, 0)
        let envp = alloc(40)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        if extra_env != 0 do
            native_write_i64(envp, 16, extra_env)
            native_write_i64(envp, 24, 0)
        else
            native_write_i64(envp, 16, 0)
        end

        sys_execve(bin_prog, cmd_argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 4000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let code = read_byte(st, 1)
            out code
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func run_cmd_io(cmd_argv: int, out_file: int, err_file: int) -> int:
    out run_cmd_io_context(cmd_argv, out_file, err_file, 0, 0)
end.

func run_cmd_io_env:
    in
        cmd_argv: int
        out_file: int
        err_file: int
        extra_env: int

    out run_cmd_io_context(cmd_argv, out_file, err_file, extra_env, 0)
end.

func run_cmd_io_cwd:
    in
        cmd_argv: int
        out_file: int
        err_file: int
        cwd: int

    out run_cmd_io_context(cmd_argv, out_file, err_file, 0, cwd)
end.

# Global test state
var g_pass_count: int = 0
var g_fail_count: int = 0

func record_test(name: int, ok: int):
    if ok == 1 do
        s_print("  [PASS] " as int)
        s_println(name)
        g_pass_count = g_pass_count + 1
    else
        s_print("  [FAIL] " as int)
        s_println(name)
        g_fail_count = g_fail_count + 1
    end
end.

func compile_and_run(virc_bin: int, src_file: int, opt_flag: int, out_bin: int, out_log: int) -> int:
    sys_unlink(out_bin)
    sys_unlink(out_log)

    let argv_c = alloc(64)
    native_write_i64(argv_c, 0, virc_bin)
    native_write_i64(argv_c, 8, src_file)
    native_write_i64(argv_c, 16, opt_flag)
    native_write_i64(argv_c, 24, "-o" as int)
    native_write_i64(argv_c, 32, out_bin)
    native_write_i64(argv_c, 40, "-q" as int)
    native_write_i64(argv_c, 48, 0)

    let rc_c = run_cmd_io(argv_c, 0, 0)
    if rc_c != 0 do out 0 end

    let argv_r = alloc(16)
    native_write_i64(argv_r, 0, out_bin)
    native_write_i64(argv_r, 8, 0)

    let rc_r = run_cmd_io(argv_r, out_log, 0)
    if rc_r != 0 do out 0 end

    let content = sys_read_file(out_log)
    out sys_trim(content)
end.

func run_bin_with_arg(bin_path: int, arg: int, out_log: int) -> int:
    sys_unlink(out_log)
    let argv = alloc(24)
    native_write_i64(argv, 0, bin_path)
    native_write_i64(argv, 8, arg)
    native_write_i64(argv, 16, 0)

    let rc = run_cmd_io(argv, out_log, 0)
    if rc != 0 do out 0 end

    let content = sys_read_file(out_log)
    out sys_trim(content)
end.

func main:
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var arg_idx = 1
    when arg_idx < argc loop
        let a = get_arg(arg_idx)
        if s_streq(a, "--virc" as int) do
            if arg_idx + 1 < argc do
                virc_bin = get_arg(arg_idx + 1)
                arg_idx = arg_idx + 1
            end
        end
        arg_idx = arg_idx + 1
    end

    s_println("==========================================================================" as int)
    s_println("  NATIVE CLI CONTRACT VERIFICATION SUITE" as int)
    s_println("==========================================================================" as int)
    s_print("Compiler under test: " as int)
    s_println(virc_bin)

    let pid_str = s_int_to_str(sys_getpid())
    let tmp_dir = s_concat2(".vir_cli_tmp_" as int, pid_str)
    sys_mkdir(tmp_dir, 493) # 0755

    let tmp_bin = s_concat3(tmp_dir, "/" as int, "prog" as int)
    let tmp_out = s_concat3(tmp_dir, "/" as int, "out.log" as int)
    let tmp_err = s_concat3(tmp_dir, "/" as int, "err.log" as int)

    # ──────────────────────────────────────────────────────────────────
    # Test 1: Empty string decoded payload (CLI contract strings.vri)
    # ──────────────────────────────────────────────────────────────────
    let t1_out = compile_and_run(virc_bin, "tests/cli_contract/strings.vri" as int, "-O1" as int, tmp_bin, tmp_out)
    var t1_ok = 0
    if t1_out != 0 do
        if s_streq(t1_out, "11\n\nhello\n22" as int) do t1_ok = 1 end
    end
    record_test("string spans preserve decoded empty payload" as int, t1_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 2: CFG join liveness across optimization levels (-O0..-O3)
    # ──────────────────────────────────────────────────────────────────
    var t2_ok = 1
    let opt_levels = alloc(32)
    native_write_i64(opt_levels, 0, "-O0" as int)
    native_write_i64(opt_levels, 8, "-O1" as int)
    native_write_i64(opt_levels, 16, "-O2" as int)
    native_write_i64(opt_levels, 24, "-O3" as int)

    var i = 0
    when i < 4 loop
        let flag = native_read_i64(opt_levels, i * 8)
        let out_data = compile_and_run(virc_bin, "tests/cli_contract/cfg_join_liveness.vri" as int, flag, tmp_bin, tmp_out)
        if out_data == 0 do
            t2_ok = 0
        else
            if s_streq(out_data, "13\n17\n100\n109" as int) == 0 do t2_ok = 0 end
        end
        i = i + 1
    end
    record_test("cfg join liveness across all optimization levels (-O0..-O3)" as int, t2_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 3: CFG liveness intervals across optimization levels (-O0..-O3)
    # ──────────────────────────────────────────────────────────────────
    var t3_ok = 1
    i = 0
    when i < 4 loop
        let flag = native_read_i64(opt_levels, i * 8)
        let out_data = compile_and_run(virc_bin, "tests/cli_contract/cfg_liveness_intervals.vri" as int, flag, tmp_bin, tmp_out)
        if out_data == 0 do
            t3_ok = 0
        else
            let exp = "0\n5\n1\n0\n5\n1\n0\n5\n1\n0\n5\n1" as int
            if s_streq(out_data, exp) == 0 do t3_ok = 0 end
        end
        i = i + 1
    end
    record_test("cfg liveness intervals across all optimization levels (-O0..-O3)" as int, t3_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 4: Compiler fact index growth and reset at -O1
    # ──────────────────────────────────────────────────────────────────
    let t4_out = compile_and_run(virc_bin, "tests/cli_contract/ide_fact_index.vri" as int, "-O1" as int, tmp_bin, tmp_out)
    var t4_ok = 0
    if t4_out != 0 do
        let exp4 = "5000\n10000\n14999\n5000\n0\n1\n1\n7" as int
        if s_streq(t4_out, exp4) do t4_ok = 1 end
    end
    record_test("compiler fact index growth update and reset" as int, t4_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 5: Success fixture execution at -O1 (result: 23)
    # ──────────────────────────────────────────────────────────────────
    let t5_out = compile_and_run(virc_bin, "tests/cli_contract/success.vri" as int, "-O1" as int, tmp_bin, tmp_out)
    var t5_ok = 0
    if t5_out != 0 do
        if s_streq(t5_out, "23" as int) do t5_ok = 1 end
    end
    record_test("success fixture compilation and execution" as int, t5_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 6: Machine output --json preserves runnable artifact
    # ──────────────────────────────────────────────────────────────────
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)
    let argv_json = alloc(48)
    native_write_i64(argv_json, 0, virc_bin)
    native_write_i64(argv_json, 8, "tests/cli_contract/success.vri" as int)
    native_write_i64(argv_json, 16, "--json" as int)
    native_write_i64(argv_json, 24, "-o" as int)
    native_write_i64(argv_json, 32, tmp_bin)
    native_write_i64(argv_json, 40, 0)

    let rc_json = run_cmd_io(argv_json, tmp_out, 0)
    var t6_ok = 0
    if rc_json == 0 do
        let json_text = sys_read_file(tmp_out)
        if s_find_str(json_text, "\"success\": true" as int) >= 0 or s_find_str(json_text, "\"success\":true" as int) >= 0 do
            let argv_r = alloc(16)
            native_write_i64(argv_r, 0, tmp_bin)
            native_write_i64(argv_r, 8, 0)
            sys_unlink(tmp_out)
            let rc_r = run_cmd_io(argv_r, tmp_out, 0)
            if rc_r == 0 do
                let out_val = sys_trim(sys_read_file(tmp_out))
                if s_streq(out_val, "23" as int) do t6_ok = 1 end
            end
        end
    end
    record_test("machine output --json does not change artifact behavior" as int, t6_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 7: CLI flags before input
    # ──────────────────────────────────────────────────────────────────
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)
    let argv_pre = alloc(56)
    native_write_i64(argv_pre, 0, virc_bin)
    native_write_i64(argv_pre, 8, "-O1" as int)
    native_write_i64(argv_pre, 16, "-q" as int)
    native_write_i64(argv_pre, 24, "tests/cli_contract/success.vri" as int)
    native_write_i64(argv_pre, 32, "-o" as int)
    native_write_i64(argv_pre, 40, tmp_bin)
    native_write_i64(argv_pre, 48, 0)

    let rc_pre = run_cmd_io(argv_pre, 0, 0)
    var t7_ok = 0
    if rc_pre == 0 do
        let argv_r = alloc(16)
        native_write_i64(argv_r, 0, tmp_bin)
        native_write_i64(argv_r, 8, 0)
        let rc_r = run_cmd_io(argv_r, tmp_out, 0)
        if rc_r == 0 do
            let out_val = sys_trim(sys_read_file(tmp_out))
            if s_streq(out_val, "23" as int) do t7_ok = 1 end
        end
    end
    record_test("flags before input file position" as int, t7_ok)

    # ──────────────────────────────────────────────────────────────────
    # Test 8: Last optimization selector wins (-O3 -O0 vs -O0 -O3)
    # ──────────────────────────────────────────────────────────────────
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)
    let argv_last1 = alloc(64)
    native_write_i64(argv_last1, 0, virc_bin)
    native_write_i64(argv_last1, 8, "tests/cli_contract/success.vri" as int)
    native_write_i64(argv_last1, 16, "-O3" as int)
    native_write_i64(argv_last1, 24, "-O0" as int)
    native_write_i64(argv_last1, 32, "-o" as int)
    native_write_i64(argv_last1, 40, tmp_bin)
    native_write_i64(argv_last1, 48, "-q" as int)
    native_write_i64(argv_last1, 56, 0)

    let rc_l1 = run_cmd_io(argv_last1, 0, 0)
    var t8_ok = 0
    if rc_l1 == 0 do
        let argv_r = alloc(16)
        native_write_i64(argv_r, 0, tmp_bin)
        native_write_i64(argv_r, 8, 0)
        let rc_r = run_cmd_io(argv_r, tmp_out, 0)
        if rc_r == 0 do
            let out_val = sys_trim(sys_read_file(tmp_out))
            if s_streq(out_val, "23" as int) do t8_ok = 1 end
        end
    end
    record_test("last optimization selector precedence (-O3 -O0)" as int, t8_ok)

    # ──────────────────────────────────────────────────────────────────
