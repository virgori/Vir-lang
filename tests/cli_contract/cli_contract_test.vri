    let argv_symlink = alloc(24)
    native_write_i64(argv_symlink, 0, symlink_virc)
    native_write_i64(argv_symlink, 8, "--print-sysroot" as int)
    native_write_i64(argv_symlink, 16, 0)
    let rc_symlink = run_cmd_io(argv_symlink, tmp_out, tmp_err)
    let symlink_out = sys_trim(sys_read_file(tmp_out))
    var t39_ok = 0
    if rc_ln == 0 and rc_symlink == 0 and s_streq(symlink_out, sysroot_text) == 1 do
        t39_ok = 1
    end
    record_test("symlink invocation resolves the canonical executable" as int, t39_ok)
    sys_unlink(symlink_virc)

    # ──────────────────────────────────────────────────────────────────
    # Test 40: Duplicate detection grows beyond the initial 4096 keys
    # ──────────────────────────────────────────────────────────────────
    let
        large_root = s_concat3(tmp_dir, "/" as int, "large-sysroot" as int)
        large_stdlib = s_concat3(large_root, "/" as int, "stdlib" as int)
        large_registry = s_concat3(large_stdlib, "/" as int, "stdlib.vri" as int)
    sys_mkdir(large_root, 493)
    sys_mkdir(large_stdlib, 493)
    let large_fd = sys_open_write(large_registry)
    var large_write_ok = 1
    if large_fd < 0 do
        large_write_ok = 0
    else
        if sys_write_fd(large_fd, "schema = 1\nversion = 2.0.0\nabi_version = 2\ncompiler_min = 0.0.0\nroot = vir\n" as int) < 0 do
            large_write_ok = 0
        end
        i = 0
        when i < 4100 loop
            let
                key_suffix = s_int_to_str(i)
                mapping_line = s_concat4("m" as int, key_suffix, " = x" as int, ".vri\n" as int)
            if sys_write_fd(large_fd, mapping_line) < 0 do large_write_ok = 0 end
            i = i + 1
        end
        if sys_write_fd(large_fd, "m4099 = x.vri\n" as int) < 0 do large_write_ok = 0 end
        sys_close(large_fd)
    end

    sys_unlink(tmp_out)
    sys_unlink(tmp_err)
    let argv_large = alloc(40)
    native_write_i64(argv_large, 0, virc_bin)
    native_write_i64(argv_large, 8, "--sysroot" as int)
    native_write_i64(argv_large, 16, large_root)
    native_write_i64(argv_large, 24, "--print-sysroot" as int)
    native_write_i64(argv_large, 32, 0)
    let rc_large = run_cmd_io(argv_large, tmp_out, tmp_err)
    let large_diag = s_concat2(sys_read_file(tmp_out), sys_read_file(tmp_err))
    var t40_ok = 0
    if large_write_ok == 1 and rc_large != 0 and s_find_str(large_diag, "E2120" as int) >= 0 do
        t40_ok = 1
    end
    record_test("duplicate registry key beyond 4096 entries fails closed" as int, t40_ok)
    sys_unlink(large_registry)
    sys_rmdir(large_stdlib)
    sys_rmdir(large_root)

    # ──────────────────────────────────────────────────────────────────
    # Cleanup temporary workspace directory
    # ──────────────────────────────────────────────────────────────────
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)
    sys_unlink(tmp_err)
    sys_rmdir(tmp_dir)

    # ──────────────────────────────────────────────────────────────────
    # Summary
    # ──────────────────────────────────────────────────────────────────
    s_println("==========================================================================" as int)
    s_print("Summary: " as int)
    s_print(s_int_to_str(g_pass_count))
    s_print(" PASS / " as int)
    s_print(s_int_to_str(g_fail_count))
    s_println(" FAIL" as int)
    s_println("==========================================================================" as int)

    if g_fail_count > 0 do
        exit_prog(1)
    end
    exit_prog(0)
end.
