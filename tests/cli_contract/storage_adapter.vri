include compiler.cli_storage
include compiler.cli_ui
import cliStoreOpenCache, cliStoreBuildId, cliStorePublish, cliStoreReadLatest from compiler.cli_storage
import cliUiLine from compiler.cli_ui
func main:
    let directory = cliStoreOpenCache(get_arg(1), 1)
    if directory < 0 do print("unavailable"); out 1 end
    var build = get_arg(3)
    if rt_streq(build, "random" as int) do build = cliStoreBuildId() end
    let status = cliStorePublish(directory, build, get_arg(2), get_arg(4))
    print(status)
    if status == 0 do cliUiLine(build) end
    let data = cliStoreReadLatest(directory, get_arg(2))
    if data != 0 do cliUiLine(data); vir_free(data) end
    sys_close(directory)
end.
