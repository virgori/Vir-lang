# Regression: a phi value is live at a join laid out before its incoming blocks.
# Keep the saved record fields live to exercise register pressure across the join.
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func alloc(size: int) -> int
var bumpEnabled: int = 0

func newChildren() -> int:
    out alloc(16)
end.

func appendValue(children: int, value: int) -> int:
    native_write_i64(children, 0, value)
    out children
end.

func appendChild(parent: int, child: int):
    let parentAddress = parent as i64
    let savedName = native_read_i64(parentAddress, 0)
    let savedName2 = native_read_i64(parentAddress, 8)
    let savedType = native_read_i64(parentAddress, 16)
    let savedOperation = native_read_i64(parentAddress, 24)
    let savedLine = native_read_i64(parentAddress, 32)
    let savedInteger = native_read_i64(parentAddress, 40)
    let savedFloat = native_read_i64(parentAddress, 48)
    let savedBinding = native_read_i64(parentAddress, 56)
    var kids = native_read_i64(parentAddress, 64)
    let savedSpan = native_read_i64(parentAddress, 72)
    if kids == 0 do
        if bumpEnabled == 0 do
            kids = newChildren()
        else
            kids = newChildren()
        end
    end
    if bumpEnabled == 0 do
        kids = appendValue(kids, child)
    else
        kids = appendValue(kids, child)
    end
    native_write_i64(parentAddress, 0, savedName)
    native_write_i64(parentAddress, 8, savedName2)
    native_write_i64(parentAddress, 16, savedType)
    native_write_i64(parentAddress, 24, savedOperation)
    native_write_i64(parentAddress, 32, savedLine)
    native_write_i64(parentAddress, 40, savedInteger)
    native_write_i64(parentAddress, 48, savedFloat)
    native_write_i64(parentAddress, 56, savedBinding)
    native_write_i64(parentAddress, 64, kids)
    native_write_i64(parentAddress, 72, savedSpan)
    out parent
end.
func main:
    let parent = alloc(80)
    var i = 0
    when i < 10 loop
        native_write_i64(parent, i * 8, 100 + i)
        i = i + 1
    end
    native_write_i64(parent, 64, 0)
    appendChild(parent, 13)
    print native_read_i64(native_read_i64(parent, 64), 0)
    bumpEnabled = 1
    appendChild(parent, 17)
    print native_read_i64(native_read_i64(parent, 64), 0)
    print native_read_i64(parent, 0)
    print native_read_i64(parent, 72)
end.
