# test_adv_093: Map function over array
# Expected: 1, 4, 9, 16, 25

func square:
    in(x)
    out x * x
end.
func map_arr:
    in(arr, n, f)
    var result = arr_new(16)
    var i = 0
    when i < n loop
        var val = arr[i]
        var mapped = f(val)
        push(result, mapped)
        i = i + 1
    end.
    out result
end.
func main:
    var arr = arr_new(8)
    push(arr, 1)
    push(arr, 2)
    push(arr, 3)
    push(arr, 4)
    push(arr, 5)

    var result = map_arr(arr, 5, square)
    var i = 0
    when i < 5 loop
        print result[i]
        i = i + 1
    end.
end.
