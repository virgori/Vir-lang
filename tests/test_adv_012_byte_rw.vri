# test_adv_012: Pointer arithmetic - byte read/write
# Expected: 65, 66, 67, 68

func main:
    var ptr = alloc(16)
    # Write ASCII: A=65, B=66, C=67, D=68
    write_byte(ptr, 0, 65)
    write_byte(ptr, 1, 66)
    write_byte(ptr, 2, 67)
    write_byte(ptr, 3, 68)

    # Read back individual bytes via word and masking
    var word = read_word(ptr, 0)
    var b0 = word & 255
    var b1 = (word shr 8) & 255
    var b2 = (word shr 16) & 255
    var b3 = (word shr 24) & 255
    print b0
    print b1
    print b2
    print b3
end.
