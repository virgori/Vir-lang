func is_prime(n: int) -> int
  if n < 2 do
    out 0
  end
  var i = 2
  when i * i <= n loop
    if n - (n / i) * i == 0 do
      out 0
    end
    i = i + 1
  end.
  out 1
end.
func main:
  var n = 2
  var count = 0
  when n < 30 loop
    if is_prime(n) == 1 do
      print n
      count = count + 1
    end
    n = n + 1
  end.
  print count
end.