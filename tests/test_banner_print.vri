extern func native_read_u8(addr: int, offset: int) -> int;
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;

const STDOUT_FD: 1;
const SYS_WRITE: 0x2000004;

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func rt_strlen:
    in(s: int)
    if s == 0:
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDOUT_FD, s, len);
end.

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end.

func main:
    print_ln("====================================");
    print_ln("  virc — Vir Self-Hosting Compiler");
    out 0
end.
