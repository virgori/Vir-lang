include csv

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    let r1 = csv.parse("name,age,city\nAlice,30,NYC\nBob,25,LA")
    case r1
        Ok(doc):
            if csv.count(doc) == 3 do
                let r0 = csv.at(doc, 0)
                let r1_row = csv.at(doc, 1)
                let row_2 = csv.at(doc, 2)
                if csv.rowCount(r0) == 3 and csv.rowCount(r1_row) == 3 and csv.rowCount(row_2) == 3 do
                    if test_str_eq(csv.rowAt(r1_row, 0), "Alice") and
                       test_str_eq(csv.rowAt(r1_row, 1), "30") and
                       test_str_eq(csv.rowAt(r1_row, 2), "NYC") do
                        print 1
                    end
                end
            end
        Err(_): print 0
    end

    let r2 = csv.parse("\"Alice, Jr.\",30,\"New York, NY\"")
    case r2
        Ok(doc):
            if csv.count(doc) == 1 do
                let row = csv.at(doc, 0)
                if csv.rowCount(row) == 3 do
                    if test_str_eq(csv.rowAt(row, 0), "Alice, Jr.") and
                       test_str_eq(csv.rowAt(row, 1), "30") and
                       test_str_eq(csv.rowAt(row, 2), "New York, NY") do
                        print 2
                    end
                end
            end
        Err(_): print 0
    end

    let r3 = csv.parse("\"He said \"\"Hello!\"\"\",42")
    case r3
        Ok(doc):
            if csv.count(doc) == 1 do
                let row = csv.at(doc, 0)
                if csv.rowCount(row) == 2 do
                    if test_str_eq(csv.rowAt(row, 0), "He said \"Hello!\"") and
                       test_str_eq(csv.rowAt(row, 1), "42") do
                        print 3
                    end
                end
            end
        Err(_): print 0
    end

    let r4 = csv.parse("\"Line 1\nLine 2\",single")
    case r4
        Ok(doc):
            if csv.count(doc) == 1 do
                let row = csv.at(doc, 0)
                if csv.rowCount(row) == 2 do
                    if test_str_eq(csv.rowAt(row, 0), "Line 1\nLine 2") and
                       test_str_eq(csv.rowAt(row, 1), "single") do
                        print 4
                    end
                end
            end
        Err(_): print 0
    end

    let r5 = csv.parse("a,,b,,,c")
    case r5
        Ok(doc):
            if csv.count(doc) == 1 do
                let row = csv.at(doc, 0)
                if csv.rowCount(row) == 6 do
                    if test_str_eq(csv.rowAt(row, 0), "a") and
                       test_str_eq(csv.rowAt(row, 1), "") and
                       test_str_eq(csv.rowAt(row, 2), "b") and
                       test_str_eq(csv.rowAt(row, 3), "") and
                       test_str_eq(csv.rowAt(row, 4), "") and
                       test_str_eq(csv.rowAt(row, 5), "c") do
                        print 5
                    end
                end
            end
        Err(_): print 0
    end

    let r6 = csv.parse("one,two\r\nthree,four\r\n")
    case r6
        Ok(doc):
            if csv.count(doc) == 2 do
                let row1 = csv.at(doc, 0)
                let row2 = csv.at(doc, 1)
                if test_str_eq(csv.rowAt(row1, 0), "one") and test_str_eq(csv.rowAt(row2, 1), "four") do
                    print 6
                end
            end
        Err(_): print 0
    end

    let r7 = csv.parseDelim("name;salary;dept\nJohn;5000;Eng", 59)
    case r7
        Ok(doc):
            if csv.count(doc) == 2 do
                let r = csv.at(doc, 1)
                if test_str_eq(csv.rowAt(r, 0), "John") and
                   test_str_eq(csv.rowAt(r, 1), "5000") and
                   test_str_eq(csv.rowAt(r, 2), "Eng") do
                    print 7
                end
            end
        Err(_): print 0
    end

    let r8 = csv.parse("alice,\"unclosed_field")
    case r8
        Ok(_): print 0
        Err(_): print 8
    end

    let r9 = csv.parse("\"alice\"extra,bob")
    case r9
        Ok(_): print 0
        Err(_): print 9
    end

    let r10 = csv.parse("ali\"ce,bob")
    case r10
        Ok(_): print 0
        Err(_): print 10
    end

    var out_doc = csv.doc()
    var out_row1 = csv.row()
    csv.rowAdd(out_row1, "Name")
    csv.rowAdd(out_row1, "Quote")
    csv.add(out_doc, out_row1)

    var out_row2 = csv.row()
    csv.rowAdd(out_row2, "Vir, Lang")
    csv.rowAdd(out_row2, "Says \"Hi\"")
    csv.add(out_doc, out_row2)

    let serialized = csv.stringify(out_doc)
    let r11 = csv.parse(serialized)
    case r11
        Ok(parsed):
            if csv.count(parsed) == 2 do
                let row = csv.at(parsed, 1)
                if test_str_eq(csv.rowAt(row, 0), "Vir, Lang") and
                   test_str_eq(csv.rowAt(row, 1), "Says \"Hi\"") do
                    print 11
                end
            end
        Err(_): print 0
    end

    print 888
    out 0
end.
