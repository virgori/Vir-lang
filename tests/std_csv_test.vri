include vir.data.csv

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Simple unquoted CSV
    let r1 = csv.read("name,age,city\nAlice,30,NYC\nBob,25,LA")
    case r1
        Ok(doc):
            if doc.count() == 3 do
                let r0 = doc.at(0)
                let r1_row = doc.at(1)
                let row_2 = doc.at(2)
                if r0.count() == 3 and r1_row.count() == 3 and row_2.count() == 3 do
                    if test_str_eq(r1_row.at(0), "Alice") and
                       test_str_eq(r1_row.at(1), "30") and
                       test_str_eq(r1_row.at(2), "NYC") do
                        print 1
                    end
                end
            end
        Err(_): print 0
    end

    # 2. Quoted fields with commas
    let r2 = csv.read("\"Alice, Jr.\",30,\"New York, NY\"")
    case r2
        Ok(doc):
            if doc.count() == 1 do
                let row = doc.at(0)
                if row.count() == 3 do
                    if test_str_eq(row.at(0), "Alice, Jr.") and
                       test_str_eq(row.at(1), "30") and
                       test_str_eq(row.at(2), "New York, NY") do
                        print 2
                    end
                end
            end
        Err(_): print 0
    end

    # 3. Escaped quotes ("")
    let r3 = csv.read("\"He said \"\"Hello!\"\"\",42")
    case r3
        Ok(doc):
            if doc.count() == 1 do
                let row = doc.at(0)
                if row.count() == 2 do
                    if test_str_eq(row.at(0), "He said \"Hello!\"") and
                       test_str_eq(row.at(1), "42") do
                        print 3
                    end
                end
            end
        Err(_): print 0
    end

    # 4. Embedded newline in quoted field
    let r4 = csv.read("\"Line 1\nLine 2\",single")
    case r4
        Ok(doc):
            if doc.count() == 1 do
                let row = doc.at(0)
                if row.count() == 2 do
                    if test_str_eq(row.at(0), "Line 1\nLine 2") and
                       test_str_eq(row.at(1), "single") do
                        print 4
                    end
                end
            end
        Err(_): print 0
    end

    # 5. Empty fields
    let r5 = csv.read("a,,b,,,c")
    case r5
        Ok(doc):
            if doc.count() == 1 do
                let row = doc.at(0)
                if row.count() == 6 do
                    if test_str_eq(row.at(0), "a") and
                       test_str_eq(row.at(1), "") and
                       test_str_eq(row.at(2), "b") and
                       test_str_eq(row.at(3), "") and
                       test_str_eq(row.at(4), "") and
                       test_str_eq(row.at(5), "c") do
                        print 5
                    end
                end
            end
        Err(_): print 0
    end

    # 6. CRLF record separator
    let r6 = csv.read("one,two\r\nthree,four\r\n")
    case r6
        Ok(doc):
            if doc.count() == 2 do
                let row1 = doc.at(0)
                let row2 = doc.at(1)
                if test_str_eq(row1.at(0), "one") and test_str_eq(row2.at(1), "four") do
                    print 6
                end
            end
        Err(_): print 0
    end

    # 7. Custom delimiter (Semicolon ";" = 59)
    let r7 = csv.read_delim("name;salary;dept\nJohn;5000;Eng", 59)
    case r7
        Ok(doc):
            if doc.count() == 2 do
                let r = doc.at(1)
                if test_str_eq(r.at(0), "John") and
                   test_str_eq(r.at(1), "5000") and
                   test_str_eq(r.at(2), "Eng") do
                    print 7
                end
            end
        Err(_): print 0
    end

    # 8. Strict RFC 4180: Unterminated quote error
    let r8 = csv.read("alice,\"unclosed_field")
    case r8
        Ok(_): print 0
        Err(_): print 8
    end

    # 9. Strict RFC 4180: Stray chars after quote
    let r9 = csv.read("\"alice\"extra,bob")
    case r9
        Ok(_): print 0
        Err(_): print 9
    end

    # 10. Strict RFC 4180: Unescaped quote inside unquoted field
    let r10 = csv.read("ali\"ce,bob")
    case r10
        Ok(_): print 0
        Err(_): print 10
    end

    # 11. Serialization & Round-trip
    let out_doc = csv.doc()
    let out_row1 = csv.row()
    csv.row_add(out_row1, "Name")
    csv.row_add(out_row1, "Quote")
    csv.add(out_doc, out_row1)

    let out_row2 = csv.row()
    csv.row_add(out_row2, "Vir, Lang")
    csv.row_add(out_row2, "Says \"Hi\"")
    csv.add(out_doc, out_row2)

    let serialized = csv.write(out_doc)
    let r11 = csv.read(serialized)
    case r11
        Ok(parsed):
            if csv.count(parsed) == 2 do
                let row = csv.at(parsed, 1)
                if test_str_eq(csv.row_at(row, 0), "Vir, Lang") and
                   test_str_eq(csv.row_at(row, 1), "Says \"Hi\"") do
                    print 11
                end
            end
        Err(_): print 0
    end

    print 888
    out 0
end.
