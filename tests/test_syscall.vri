# test_syscall.vri — Test __syscall intrinsic for raw SVC
# Uses macOS BSD write syscall to write "OK\n" to stdout
# Syscall number: 0x2000004 (write) on macOS ARM64
# Expected output: OK

func main:
    # Allocate a small buffer for "OK\n"
    var buf = alloc(8)
    write_byte(buf, 0, 79)    # 'O' = 79
    write_byte(buf, 1, 75)    # 'K' = 75
    write_byte(buf, 2, 10)    # '\n' = 10
    # __syscall(syscall_num, fd, buf, len)
    # macOS write = 0x2000004
    var ret = __syscall(0x2000004, 1, buf, 3)
end.