entity CompilerConfig:
    input_path: int;
    output_path: int;
    target: int;
    format: int;
    verbose: int;
end.

func default_config:
    out CompilerConfig (
        input_path: 0,
        output_path: 0,
        target: 0,
        format: 0,
        verbose: 1
    );
end.

func main:
    let cfg = default_config();
    cfg.output_path = "a.out";
    print cfg.output_path;
    out 0
end.
