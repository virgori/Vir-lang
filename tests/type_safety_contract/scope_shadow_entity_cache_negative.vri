# CONTRACT: TYPE-SCOPE-SHADOW-002
# EXPECT_COMPILE_FAIL: E3007
entity FirstEntity:
    x: int
end.

entity SecondEntity:
    y: int
end.

func test:
    var item: FirstEntity = FirstEntity(x: 1)
    if true do
        var item: SecondEntity = SecondEntity(y: 2)
    end
    item = SecondEntity(y: 3)
end.

func main:
    test()
    out 0
end.
