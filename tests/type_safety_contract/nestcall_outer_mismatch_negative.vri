# TYPE-NESTCALL-CRASH-004: inner returns string but outer expects int
# EXPECT: compile-fail E3007
entity Item:
    num: int
end.

func to_str(x: int) -> string:
    out "hello"
end.

func add_one(x: int) -> int:
    out x + 1
end.

func main:
    var item = Item(num: 42)
    print(add_one(to_str(item.num)))
    out 0
end.
