# TYPE-AUTODEREF-POS-006: string interpolation $ref.field and $(ref.field + N)
# EXPECT: 50
# EXPECT: 88
# EXPECT: 98
entity Color:
    id: int
end.

entity Container:
    inner: Color
end.

func main:
    var col = Color(id: 50)
    var c = Container(inner: col)
    var r = &c
    print("$r.inner.id")
    var c2 = Color(id: 88)
    var r2 = &c2
    print("$r2.id")
    print("$(r2.id + 10)")
    out 0
end.
