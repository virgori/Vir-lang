# TYPE-AUTODEREF-POS-004: method call via &T and &mut T
# EXPECT: 10
# EXPECT: 15
entity Counter:
    val: int

    method get_val -> int:
        out this.val
    end.

    method bump(delta: int):
        this.val = this.val + delta
    end.
end.

func read_it(c: &Counter) -> int:
    out c.get_val()
end.

func inc_it(c: &mut Counter, delta: int):
    c.bump(delta)
end.

func main:
    var c = Counter(val: 10)
    print(read_it(&c))
    inc_it(&mut c, 5)
    print(c.val)
    out 0
end.
