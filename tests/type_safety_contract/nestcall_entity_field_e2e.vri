# TYPE-NESTCALL-CRASH-001: positive nested call outer(inner(entity.scalarField))
# EXPECT: 123
entity Item:
    num: int
end.

func double(x: int) -> int:
    out x * 2
end.

func add_one(x: int) -> int:
    out x + 1
end.

func main:
    var item = Item(num: 61)
    print(add_one(double(item.num)))
    out 0
end.
