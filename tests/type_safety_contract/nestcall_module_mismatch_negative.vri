# TYPE-NESTCALL-CRASH-005: nested call with type propagation mismatch
# EXPECT: compile-fail E3007
entity Item:
    val: int
end.

func to_str(x: int) -> string:
    out "hello"
end.

func take_int(x: int) -> int:
    out x
end.

func main:
    var item = Item(val: 10)
    print(take_int(to_str(item.val)))
    out 0
end.
