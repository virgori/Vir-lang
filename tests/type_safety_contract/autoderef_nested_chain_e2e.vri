# TYPE-AUTODEREF-POS-003: nested field chain via &Outer
# EXPECT: 77
entity Inner:
    val: int
end.

entity Outer:
    inner: Inner
end.

func readNested(r: &Outer) -> int:
    out r.inner.val
end.

func main:
    var i = Inner(val: 77)
    var o = Outer(inner: i)
    print(readNested(&o))
    out 0
end.
