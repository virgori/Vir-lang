# TYPE-AUTODEREF-POS-007: field as ref/out actual argument
# EXPECT: 100
entity Container:
    val: int
end.

func bump(ref x: int):
    x = x + 10
end.

func fill:
    out y: int
    y = 90
end.

func main:
    var c = Container(val: 0)
    fill(c.val)
    bump(c.val)
    print(c.val)
    out 0
end.
