# 22
# EXPECT_END
entity Header:
    value: int
end.

entity Response:
    padding: int
    value: int
end.

func main:
    let
        header = Header(value: 11)
        response = Response(padding: 99, value: 22)
    print(header.value)
    print(response.value)
    out 0
end.
