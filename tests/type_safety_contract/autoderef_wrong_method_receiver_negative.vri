# TYPE-AUTODEREF-NEG-012: method receiver with wrong pointee identity
# EXPECT: compile-fail E3001
entity Alpha:
    val: int
end.

entity Beta:
    val: int
end.

func do_thing(this: &Alpha) -> int:
    out this.val
end.

func main:
    var b = Beta(val: 10)
    print((&b).do_thing())
    out 0
end.
