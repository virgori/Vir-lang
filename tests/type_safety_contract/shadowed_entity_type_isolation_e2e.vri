# EXPECT_START
# 31
# 47
# EXPECT_END
entity First:
    value: int
end.

entity Second:
    padding: int
    value: int
end.

func readFirst() -> int:
    let item = First(value: 31)
    out item.value
end.

func readSecond() -> int:
    let item = Second(padding: 99, value: 47)
    out item.value
end.

func main:
    print(readFirst())
    print(readSecond())
    out 0
end.
