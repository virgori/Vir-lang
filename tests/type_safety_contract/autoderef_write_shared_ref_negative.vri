# TYPE-AUTODEREF-NEG-003: write field through local shared &T binding — must be rejected with E3003
# A local var = &entity binding must not allow field write (shared borrow).
# EXPECT: compile-fail E3003
entity Token:
    id: int
end.

func main:
    var t = Token(id: 42)
    var r = &t
    r.id = 99
    print(t.id)
    out 0
end.
