# TYPE-AUTODEREF-NEG-003: write field through shared &T — must be rejected with E3003
# EXPECT: compile-fail E3003
entity Token:
    id: int
end.

func writeToken(tokenRef: &Token) -> int:
    tokenRef.id = 99
    out 0
end.

func main:
    var t = Token(id: 42)
    writeToken(&t)
    print(t.id)
    out 0
end.
