# TYPE-NESTCALL-CRASH-003: nested call with inner param type mismatch
# EXPECT: compile-fail E3007
entity Item:
    tag: string
end.

func double_num(x: int) -> int:
    out x * 2
end.

func add_one(x: int) -> int:
    out x + 1
end.

func main:
    var item = Item(tag: "hello")
    print(add_one(double_num(item.tag)))
    out 0
end.
