# TYPE-NESTCALL-CRASH-003: nested call no-crash positive control
# inner returns int, outer takes int — nested call runs correctly
# EXPECT: 8
entity Item:
    num: int
end.

func triple(x: int) -> int:
    out x * 3
end.

func add_two(x: int) -> int:
    out x + 2
end.

func main:
    var item = Item(num: 2)
    print(add_two(triple(item.num)))
    out 0
end.
