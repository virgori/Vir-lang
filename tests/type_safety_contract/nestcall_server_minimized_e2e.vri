# TYPE-NESTCALL-CRASH-006: nested call on entity projection
# EXPECT: 42
entity HexData:
    number: int,
    upper_id: int
end.

func hex_name_vi(num: int) -> int:
    out num * 42
end.

func format_result(val: int) -> int:
    out val
end.

func main:
    var primary = HexData(number: 1, upper_id: 1)
    var res = format_result(hex_name_vi(primary.number))
    print(res)
    out 0
end.
