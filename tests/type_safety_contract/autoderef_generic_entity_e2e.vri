# TYPE-AUTODEREF-POS-009: generic entity specialization field access
# EXPECT: 42
entity Pair of (T):
    first: T
    second: int
end.

func read_first(p: &Pair of (int)) -> int:
    out p.first
end.

func main:
    var p = Pair of (int)(first: 42, second: 10)
    print(read_first(&p))
    out 0
end.
