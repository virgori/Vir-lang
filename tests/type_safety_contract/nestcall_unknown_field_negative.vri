# TYPE-NESTCALL-CRASH-002: nested call with unknown field — semantic diagnostic, no crash
# EXPECT: compile-fail E3008
entity Item:
    num: int
end.

func double(x: int) -> int:
    out x * 2
end.

func add_one(x: int) -> int:
    out x + 1
end.

func main:
    var item = Item(num: 61)
    print(add_one(double(item.missing)))
    out 0
end.
