# TYPE-AUTODEREF-NEG-002: field exists only on different entity — must be rejected
# EXPECT: compile-fail E3008
entity Token:
    id: int
end.

entity Session:
    key: int
end.

func readWrong(t: &Token) -> int:
    out t.key
end.

func main:
    var tok = Token(id: 1)
    print(readWrong(&tok))
    out 0
end.
