include vec
import Vec, vec_new, vec_push, vec_len from vec

func main:
    var options: Vec of (string) = vec_new()
    vec_push(options, "Red" as int)
    vec_push(options, "Green" as int)
    vec_push(options, "Blue" as int)
    print(vec_len(options))
    out 0
end.
