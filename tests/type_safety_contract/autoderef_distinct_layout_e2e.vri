# TYPE-AUTODEREF-POS-011: same field name on two distinct layout entities
# EXPECT: 10\n20
entity Alpha:
    padding: int,
    id: int
end.

entity Beta:
    id: int,
    extra1: int,
    extra2: int
end.

func read_alpha(a: &Alpha) -> int:
    out a.id
end.

func read_beta(b: &Beta) -> int:
    out b.id
end.

func main:
    var a = Alpha(padding: 99, id: 10)
    var b = Beta(id: 20, extra1: 30, extra2: 40)
    print(read_alpha(&a))
    print(read_beta(&b))
    out 0
end.
