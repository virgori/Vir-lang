# EXPECT_START
# 42
# EXPECT_END
include vec
import Vec, vec_new, vec_push, vec_len from vec

func countOptions(options: Vec of (string)) -> int:
    out vec_len(options)
end.

func main:
    var options: Vec of (string) = vec_new()
    vec_push(options, "answer" as int)
    if countOptions(options) == 1 do
        print(42)
    end
    out 0
end.
