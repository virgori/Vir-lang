entity CompilerConfig:
    input_path: int;
    output_path: int;
    target: int;
    format: int;
    verbose: int;
end.

extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;

const STDOUT_FD: 1;
const SYS_WRITE: 0x2000004;

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

extern func native_read_u8(addr: int, offset: int) -> int;

func rt_strlen:
    in(s: int)
    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    sys_write(STDOUT_FD, s, rt_strlen(s));
end.

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end.

func default_config:
    out CompilerConfig (
        input_path: 0,
        output_path: 0,
        target: 0,
        format: 0,
        verbose: 1
    );
end.

func compile_like:
    in(cfg: CompilerConfig)
    let verbose = cfg.verbose;
    if verbose == 1 do
        print_ln("virc: reading...");
    end
    if verbose == 1 do
        print_ln("virc: tokenizing...");
    end
    out 0
end.

func main:
    let cfg = default_config();
    compile_like(cfg);
    out 0
end.
