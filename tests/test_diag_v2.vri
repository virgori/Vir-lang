# Test module path keyword collision
include vir.collections.map;

# Test trailing module path dot
include vir.collections.;

# Test missing 'end'
func a:
  var x = 1

# Test missing ':'
func b()
  if x == 1:
    print 1
  end
end.
# Test undefined function Err
func d:
  var e = Err(1);
end.
# Test parser recovery after malformed case
func e:
  case x
    1 -> print 1
    2 -> print 2
  end.
end.
# Test typo 'edn'
func c:
  var y = 2
edn
