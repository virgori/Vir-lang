include vir.env
include vec_rt
import vec_len_rt from vec_rt

func rt_str_len(p: int) -> int:
    extern func native_read_u8(addr: int, offset: int) -> int
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

func main:
    # 1. Test existing var via env.get
    let u = env.get("USER")
    case u
        Some(_): print 1
        None: print 0
    end

    # 2. Test missing var via env.get
    let miss = env.get("VIR_NON_EXISTENT_VAR_12345")
    case miss
        Some(_): print 0
        None: print 2
    end

    # 3. Test env.has()
    if env.has("USER") do
        print 3
    end
    if env.has("VIR_NON_EXISTENT_VAR_12345") == false do
        print 4
    end

    # 4. Test env.get_or()
    let fb1 = env.get_or("VIR_NON_EXISTENT_VAR_12345", "default_val")
    print fb1

    # 5. Test env.set() and env.get()
    let s1 = env.set("VIR_VAR_ALPHA", "alpha_value")
    case s1
        Ok(_): print 5
        Err(_): print 0
    end
    if env.has("VIR_VAR_ALPHA") do
        print 6
    end
    let val_alpha = env.get_or("VIR_VAR_ALPHA", "missing")
    print val_alpha

    # 6. Test env.set() overwrite
    env.set("VIR_VAR_ALPHA", "alpha_overwritten")
    let val_alpha2 = env.get_or("VIR_VAR_ALPHA", "missing")
    print val_alpha2

    # 7. Test empty value
    env.set("VIR_VAR_EMPTY", "")
    if env.has("VIR_VAR_EMPTY") do
        print 7
    end
    let empty_opt = env.get("VIR_VAR_EMPTY")
    case empty_opt
        Some(_): print 8
        None: print 0
    end
    let empty_got = env.get_or("VIR_VAR_EMPTY", "FALLBACK_SHOULD_NOT_APPEAR")
    if rt_str_len(empty_got as int) == 0 do
        print 9
    end

    # 8. Test env.remove()
    let u1 = env.remove("VIR_VAR_ALPHA")
    case u1
        Ok(_): print 10
        Err(_): print 0
    end
    if env.has("VIR_VAR_ALPHA") == false do
        print 11
    end
    let u_check = env.get("VIR_VAR_ALPHA")
    case u_check
        Some(_): print 0
        None: print 12
    end

    # 9. Test idempotent env.remove()
    let u_nonexist = env.remove("VIR_VAR_ALPHA")
    case u_nonexist
        Ok(_): print 13
        Err(_): print 0
    end

    # 10. Key validation: reject empty key and key with '='
    let err1 = env.set("", "value")
    case err1
        Ok(_): print 0
        Err(_): print 14
    end
    let err2 = env.set("INVALID=KEY", "value")
    case err2
        Ok(_): print 0
        Err(_): print 15
    end

    # 11. Test env.keys() and env.vars()
    let ks = env.keys()
    if vec_len_rt(ks) > 0 do
        print 16
    end
    let vs = env.vars()
    if vec_len_rt(vs) > 0 do
        print 17
    end

    # Clean up test env vars
    env.remove("VIR_VAR_EMPTY")

    print 999
    out 0
end.
