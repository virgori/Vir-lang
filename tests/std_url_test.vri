include vir.net.url
include vir.net.form

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Percent encoding
    let s_raw = "hello world! 100% #1"
    let enc = url_encode(s_raw)
    if test_str_eq(enc, "hello%20world%21%20100%25%20%231") do
        print 1
    end

    # 2. Percent decoding
    let r_dec = url_decode("hello%20world%21%20100%25%20%231")
    case r_dec
        Ok(dec):
            if test_str_eq(dec, s_raw) do
                let r_form_dec = url_decode_form("hello+world")
                case r_form_dec
                    Ok(fd):
                        if test_str_eq(fd, "hello world") do print 2 end
                    Err(_): print 0
                end
            end
        Err(_): print 0
    end

    # 3. URL parsing full components
    let full_url = "https://vir-lang.org:8080/docs/api?v=2&lang=vir#section1"
    let r_url = url_parse(full_url)
    case r_url
        Ok(u):
            if test_str_eq(url_get_scheme(u), "https") and
               test_str_eq(url_get_host(u), "vir-lang.org") and
               url_get_port(u) == 8080 and
               test_str_eq(url_get_path(u), "/docs/api") and
               test_str_eq(url_get_query(u), "v=2&lang=vir") and
               test_str_eq(url_get_fragment(u), "section1") do
                print 3
            end
        Err(_): print 0
    end

    # 4. Default ports for http and https
    let r_http = url_parse("http://example.com/test")
    case r_http
        Ok(u_http):
            if url_get_port(u_http) == 80 do
                let r_https = url_parse("https://example.com/test")
                case r_https
                    Ok(u_https):
                        if url_get_port(u_https) == 443 do print 4 end
                    Err(_): print 0
                end
            end
        Err(_): print 0
    end

    # 5. Query parameter extraction
    let q_str = "v=2&lang=vir&mode=fast+safe"
    let opt_lang = url_query_get(q_str, "lang")
    case opt_lang
        Some(l):
            if test_str_eq(l, "vir") do
                let opt_mode = url_query_get(q_str, "mode")
                case opt_mode
                    Some(m):
                        if test_str_eq(m, "fast safe") do
                            let opt_none = url_query_get(q_str, "nonexistent")
                            case opt_none
                                Some(_): print 0
                                None: print 5
                            end
                        end
                    None: print 0
                end
            end
        None: print 0
    end

    # 6. URL stringification
    let u_orig = url_new("https", "vir-lang.org", 8080, "/path", "a=1", "frag")
    let serialized_url = url_stringify(u_orig)
    if test_str_eq(serialized_url, "https://vir-lang.org:8080/path?a=1#frag") do
        # Default port suppression
        let u_def = url_new("https", "vir-lang.org", 443, "/index", "", "")
        let ser_def = url_stringify(u_def)
        if test_str_eq(ser_def, "https://vir-lang.org/index") do
            print 6
        end
    end

    # 7. Form urlencoded parsing & stringification
    let form_src = "user=alice+wonder&role=admin&score=100"
    let fdoc = form_parse(form_src)
    let opt_user = form_get(fdoc, "user")
    case opt_user
        Some(u):
            if test_str_eq(u, "alice wonder") do
                let opt_role = form_get(fdoc, "role")
                case opt_role
                    Some(r):
                        if test_str_eq(r, "admin") do
                            let opt_score = form_get(fdoc, "score")
                            case opt_score
                                Some(sc):
                                    if test_str_eq(sc, "100") do print 7 end
                                None: print 0
                            end
                        end
                    None: print 0
                end
            end
        None: print 0
    end

    # 8. Strict error handling: invalid hex in percent decoding
    let r_err1 = url_decode("%2G")
    case r_err1
        Ok(_): print 0
        Err(_):
            let r_err2 = url_decode("%2")
            case r_err2
                Ok(_): print 0
                Err(_): print 8
            end
    end

    print 555
    out 0
end.
