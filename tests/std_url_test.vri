include url
include option
import Option, Some, None from option

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    enc = url.encode("hello world! 100% #1")
    if test_str_eq(enc, "hello%20world%21%20100%25%20%231") == false do out 1 end

    case url.decode("hello%20world%21%20100%25%20%231")
    Ok(dec):
        if test_str_eq(dec, "hello world! 100% #1") == false do out 2 end
    Err(_): out 3
    end

    case url.decodeForm("hello+world")
    Ok(fd):
        if test_str_eq(fd, "hello world") == false do out 4 end
    Err(_): out 5
    end

    case url.parse("https://vir-lang.org:8080/docs/api?v=2&lang=vir#section1")
    Ok(u):
        us = u.scheme
        uh = u.host
        up = u.port_num
        upath = u.path
        uq = u.query
        uf = u.fragment
        if test_str_eq(us, "https") == false do out 6 end
        if test_str_eq(uh, "vir-lang.org") == false do out 7 end
        if up != 8080 do out 8 end
        if test_str_eq(upath, "/docs/api") == false do out 9 end
        if test_str_eq(uq, "v=2&lang=vir") == false do out 10 end
        if test_str_eq(uf, "section1") == false do out 11 end
    Err(_): out 12
    end

    case url.parse("http://example.com/test")
    Ok(u_http):
        if u_http.port_num != 80 do out 13 end
    Err(_): out 14
    end

    case url.parse("https://example.com/test")
    Ok(u_https):
        if u_https.port_num != 443 do out 15 end
    Err(_): out 16
    end

    case url.parse("http://example.com/?v=2&lang=vir&mode=fast+safe")
    Ok(uq):
        case url.queryGet(uq, "lang")
        Some(l):
            if test_str_eq(l, "vir") == false do out 17 end
        None: out 18
        end
    Err(_): out 19
    end

    out 0
end.
