var total_errors = 0

entity Config:
    verbose: int
    target:  int
end.

func default_cfg() -> Config:
    out Config( verbose: 1, target: 0 )
end.

func process(cfg: Config, input: int) -> int:
    var result = 0
    if cfg.verbose == 1: do
        print input
    end
    if input > 100: do
        result = input - 100
    eif input > 50: do
        result = input - 50
    eif input > 0: do
        result = input
    else
        result = 0
        total_errors = total_errors + 1
    end
    out result
end.

func run_batch(cfg: Config):
    var arr = [200, 75, 30, 0]
    var i = 0
    var sum = 0
    when i < len(arr) loop
        var val = arr[i]
        var r = process(cfg, val)
        sum = sum + r
        i = i + 1
    end
    print sum
    print total_errors
end.

func main():
    var cfg = default_cfg()
    run_batch(cfg)
end.
