entity Test:
    name: string,
    val: int
end.

func update_test(t: Test, new_val: int):
    t.val = new_val
    out t
end.

func push_entity(v: int, t: Test):
    v = vec_push_rt(v, t as int)
    out v
end.

func main:
    var v = vec_new_rt()
    var t = Test(name: "hello", val: 1)
    
    v = push_entity(v, t)
    
    # Let's see if the vector holds a pointer to t?
    var ptr = vec_get_rt(v, 0)
    print "Vector contains:"
    print ptr
    
    # Overwrite stack with something else
    var t2 = Test(name: "world", val: 999)
    
    print "Vector after stack overwrite:"
    print vec_get_rt(v, 0)
    out 0
end.
