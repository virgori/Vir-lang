# EXPECT:
# 16384
# 65536
# 4096
# 65536
# 65536
##
 * test_target_paging.vri — Verification for Target-Specific Memory Paging & Alignment
 ##

include types
include compiler.mc
import TargetArch, TargetOS, ObjectFormat from compiler.mc
include compiler.target_paging
import PAGE_SIZE_ARM64_DARWIN, PAGE_SIZE_ARM64_LINUX, PAGE_SIZE_X86, PAGE_SIZE_RISCV64, PAGE_SIZE_WASM, target_get_page_size from compiler.target_paging
include rt.elf
import ElfBuilder, elf_new from rt.elf
include rt.macho
import MachOBuilder, macho_new from rt.macho
include rt.alloc
import rt_page_size from rt.alloc

func main():
    # 1. Target Paging Constants
    if PAGE_SIZE_ARM64_DARWIN != 0x4000 do
        panic("PAGE_SIZE_ARM64_DARWIN mismatch")
    end
    if PAGE_SIZE_ARM64_LINUX != 0x10000 do
        panic("PAGE_SIZE_ARM64_LINUX mismatch")
    end
    if PAGE_SIZE_X86 != 0x1000 do
        panic("PAGE_SIZE_X86 mismatch")
    end
    if PAGE_SIZE_RISCV64 != 0x10000 do
        panic("PAGE_SIZE_RISCV64 mismatch")
    end
    if PAGE_SIZE_WASM != 65536 do
        panic("PAGE_SIZE_WASM mismatch")
    end

    # 2. Dynamic target query helper
    let p_arm64_macho = target_get_page_size(TargetArch.ARM64, TargetOS.Darwin, ObjectFormat.MachO)
    if p_arm64_macho != 0x4000 do
        panic("target_get_page_size arm64-darwin should be 16KB")
    end

    let p_arm64_elf = target_get_page_size(TargetArch.ARM64, TargetOS.Linux, ObjectFormat.ELF)
    if p_arm64_elf != 0x10000 do
        panic("target_get_page_size arm64-linux should be 64KB")
    end

    let p_x86_linux = target_get_page_size(TargetArch.X86_64, TargetOS.Linux, ObjectFormat.ELF)
    if p_x86_linux != 0x1000 do
        panic("target_get_page_size x86_64-linux should be 4KB")
    end

    let p_x86_darwin = target_get_page_size(TargetArch.X86_64, TargetOS.Darwin, ObjectFormat.MachO)
    if p_x86_darwin != 0x1000 do
        panic("target_get_page_size x86_64-darwin should be 4KB")
    end

    let p_riscv = target_get_page_size(TargetArch.RISCV64, TargetOS.Linux, ObjectFormat.ELF)
    if p_riscv != 0x10000 do
        panic("target_get_page_size riscv64 should be 64KB")
    end

    let p_wasm = target_get_page_size(TargetArch.Wasm32, TargetOS.WASI_P1, ObjectFormat.Wasm)
    if p_wasm != 65536 do
        panic("target_get_page_size wasm should be 64KB")
    end

    # 3. ELF Builder page_size per arch
    let elf_arm = elf_new(0)
    if elf_arm.page_size != 0x10000 do
        panic("ELF ARM64 builder must have page_size 0x10000 (64KB)")
    end

    let elf_x86 = elf_new(1)
    if elf_x86.page_size != 0x1000 do
        panic("ELF x86_64 builder must have page_size 0x1000 (4KB)")
    end

    let elf_riscv = elf_new(3)
    if elf_riscv.page_size != 0x10000 do
        panic("ELF RISCV64 builder must have page_size 0x10000 (64KB)")
    end

    # 4. Mach-O Builder page_size per arch
    let macho_arm = macho_new(0)
    if macho_arm.page_size != 0x4000 do
        panic("Mach-O ARM64 builder must have page_size 0x4000 (16KB)")
    end

    let macho_x86 = macho_new(1)
    if macho_x86.page_size != 0x1000 do
        panic("Mach-O x86_64 builder must have page_size 0x1000 (4KB)")
    end

    # 5. Runtime adaptive page size
    let rt_ps = rt_page_size()
    if rt_ps < 4096 do
        panic("rt_page_size must be >= 4096")
    end

    print p_arm64_macho
    print p_arm64_elf
    print p_x86_linux
    print p_riscv
    print p_wasm
    out 0
end.

