# Test: Spec 2.0 Compiler Stage Features
# Features: bundle, reactive var, expose func, infer block, train block, and hardware intrinsics

bundle my_asset: string = embed "Hello Embedded Asset!"

reactive var global_counter = 100

expose func add_five(x: int) -> int:
    out x + 5
end.

func test_ai_blocks:
    infer:
        var forward_result = 42 * 2
        print forward_result
    end
    train:
        var loss_val = 10
        print loss_val
    end
end.

func main:
    print my_asset
    print global_counter
    var res = add_five(20)
    print res
    test_ai_blocks()
end.
