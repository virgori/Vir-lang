# test_adv_079: Stack-based calculator simulation
# Expected: 42

func main:
    # Simulate stack: push 30, push 12, add => 42
    var stack = arr_new(32)
    var sp = 0

    # Push 30
    push(stack, 30)
    sp = sp + 1

    # Push 12
    push(stack, 12)
    sp = sp + 1

    # Pop two, add, push result
    var b = stack[sp - 1]
    var a = stack[sp - 2]
    sp = sp - 2
    var result = a + b
    stack[sp] = result
    sp = sp + 1

    # Top of stack
    print stack[sp - 1]
end.
