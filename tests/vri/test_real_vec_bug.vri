include "stdlib/vir/core.vri"
include "stdlib/vir/rt/vec_rt.vri"

enum AstType:
    VarDecl = 3
    LiteralInt = 24
end.

enum OpType:
    Add = 0
end.

entity AstNode:
    name:           string
    name2:          string
    node_type:      AstType
    op:             OpType
    line:           int
    int_val:        int
    float_val:      float
    builtin_id:     int
    children:       int
end.

func parse_var_decl_single():
    var decl = AstNode (
        name:       "var_n",
        name2:      "",
        node_type:  AstType.VarDecl,
        op:         OpType.Add,
        line:       42,
        int_val:    0,
        float_val:  0.0,
        builtin_id: 0,
        children:   vec_new_rt()
    )
    
    var init = AstNode (
        name:       "child_val",
        name2:      "",
        node_type:  AstType.LiteralInt,
        op:         OpType.Add,
        line:       42,
        int_val:    99,
        float_val:  0.0,
        builtin_id: 0,
        children:   vec_new_rt()
    )

    decl.children = vec_push_rt(decl.children, init as int)
    out decl
end.

func main:
    var p = parse_var_decl_single()
    
    print "After:"
    print p.node_type as int
    print p.children
    
    # Overwrite stack
    var p2 = parse_var_decl_single()
    var dummy = 12345
    var dummy2 = 67890
    
    var ptr = vec_get_rt(p.children, 0)
    print "Pointer is:"
    print ptr
    out 0
end.
