# Regression Test: Multi-level member access chain (a.b.c)
# Protection: Hạn Chế 7 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Parser and codegen correctly evaluate nested member access
#   and assignments across multiple levels of entity nesting (e.g. cv.box.origin.x).

entity Point:
    x: int
    y: int
end.

entity Rect:
    origin: Point
    scale: int
end.

entity Canvas:
    box: Rect
    id: int
end.

func main:
    let pt = Point(x: 100, y: 200)
    let r = Rect(origin: pt, scale: 5)
    let cv = Canvas(box: r, id: 999)

    # Initial nested read
    print cv.box.origin.x
    print cv.box.origin.y
    print cv.box.scale
    print cv.id

    # Nested member write
    cv.box.origin.x = 888
    cv.box.origin.y = 999
    cv.box.scale = 42

    # Verification of updated values
    print cv.box.origin.x
    print cv.box.origin.y
    print cv.box.scale
    out 0
end.

