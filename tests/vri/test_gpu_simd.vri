# §24 GPU/SIMD/Atomic — end-to-end smoke test
var counter = 0       # global slot 0 for atomic ops

deck screen: int[8]   # §24.3 shared buffer → zero-filled array of 8

func main:
    # §24.1 flux constructor
    var pos = flux(1, 2, 3, 4)
    var vel = flux(10, 20, 30, 40)

    # §24.1 flux.dot
    print flux_dot(pos, vel)           # 1*10+2*20+3*30+4*40 = 300

    # §24.1 flux.norm (magnitude)
    var u = flux(3, 4)
    print flux_norm(u)                 # sqrt(25) = 5

    # §24.1 flux.splat
    var ones = flux_splat(7, 4)
    print flux_dot(ones, ones)         # 4*49 = 196

    # §24.2 swizzle read
    var r = pos~zyx
    print r[0]                         # 3
    print r[1]                         # 2
    print r[2]                         # 1

    # §24.2 swizzle write-mask
    var v = [1, 2, 3, 4]
    var s = [99, 88]
    v~xy = s
    print v[0]                         # 99
    print v[1]                         # 88
    print v[2]                         # 3
    print v[3]                         # 4

    # §24.3 deck initialised to zeros
    print screen[0]                    # 0
    print screen[3]                    # 0

    # §24.4 atomic RMW on global counter (slot 0)
    counter!! = 100
    print counter                      # 100 (ordinary read)
    counter!! += 5
    print counter                      # 105
    var old = atomic_cas(0, 105, 777)  # succeeds
    print old                          # 105
    print counter                      # 777
    atomic_fence()
end.
