# Regression Test: Value-copy semantics on array/slice indexing
# Protection: Hạn Chế 1 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Reading an element into a local variable performs a value copy;
#   mutating the local variable does not alter the source element in the array.

func main:
    var items = [100, 200, 300]
    var elem = items[1]

    # Verify initial value
    print elem
    print items[1]

    # Mutate local copy
    elem = 999
    print elem
    print items[1]

    # Mutate array directly to verify independence
    items[1] = 555
    print elem
    print items[1]
    out 0
end.

