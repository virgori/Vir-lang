##
 * test_lir_target_isolation.vri — Verification for Target Architecture Isolation & Target Triple Routing
 ##

include types
include compiler.mc
import TargetArch, TargetOS, TargetABI, ObjectFormat, AsmDialect, TargetTriple, triple_arch, triple_os, triple_abi, triple_format, triple_dialect from compiler.mc
include compiler.target
import set_codegen_target, get_codegen_target from compiler.target
include compiler.target_triple
import parse_target_triple from compiler.target_triple
include compiler.target_paging
import target_get_page_size, PAGE_SIZE_ARM64_DARWIN, PAGE_SIZE_ARM64_LINUX, PAGE_SIZE_X86, PAGE_SIZE_RISCV64, PAGE_SIZE_WASM from compiler.target_paging
include compiler.opt_backend
import opt_backend_run_lir_pre, opt_backend_run_lir_post from compiler.opt_backend

func main():
    # 1. Target Arch Dimensions Verification
    if TargetArch.X86_64 != 1 do panic("TargetArch.X86_64 must be 1") end
    if TargetArch.ARM64 != 2 do panic("TargetArch.ARM64 must be 2") end
    if TargetArch.RISCV64 != 3 do panic("TargetArch.RISCV64 must be 3") end
    if TargetArch.Wasm32 != 4 do panic("TargetArch.Wasm32 must be 4") end

    # 2. Target OS Dimensions Verification
    if TargetOS.Darwin != 1 do panic("TargetOS.Darwin must be 1") end
    if TargetOS.Linux != 2 do panic("TargetOS.Linux must be 2") end
    if TargetOS.WASI_P1 != 3 do panic("TargetOS.WASI_P1 must be 3") end
    if TargetOS.Windows != 5 do panic("TargetOS.Windows must be 5") end

    # 3. Object Format Dimensions Verification
    if ObjectFormat.MachO != 1 do panic("ObjectFormat.MachO must be 1") end
    if ObjectFormat.ELF != 2 do panic("ObjectFormat.ELF must be 2") end
    if ObjectFormat.Wasm != 3 do panic("ObjectFormat.Wasm must be 3") end
    if ObjectFormat.PE_COFF != 4 do panic("ObjectFormat.PE_COFF must be 4") end

    # 7. Target State Switching Isolation
    set_codegen_target(TargetArch.ARM64 as int)
    if get_codegen_target() != 2 do panic("Target state switch to ARM64 failed") end

    set_codegen_target(TargetArch.X86_64 as int)
    if get_codegen_target() != 1 do panic("Target state switch to X86_64 failed") end

    set_codegen_target(TargetArch.RISCV64 as int)
    if get_codegen_target() != 3 do panic("Target state switch to RISCV64 failed") end

    set_codegen_target(TargetArch.Wasm32 as int)
    if get_codegen_target() != 4 do panic("Target state switch to Wasm32 failed") end

    # Restore ARM64 default
    set_codegen_target(TargetArch.ARM64 as int)

    # 8. Target Paging Isolation Verification
    let ps_arm_darwin = target_get_page_size(TargetArch.ARM64, TargetOS.Darwin, ObjectFormat.MachO)
    if ps_arm_darwin != 0x4000 do
        panic("ARM64 Darwin page size must be 16KB")
    end

    let ps_arm_linux = target_get_page_size(TargetArch.ARM64, TargetOS.Linux, ObjectFormat.ELF)
    if ps_arm_linux != 0x10000 do
        panic("ARM64 Linux page size must be 64KB")
    end

    let ps_x86_linux = target_get_page_size(TargetArch.X86_64, TargetOS.Linux, ObjectFormat.ELF)
    if ps_x86_linux != 0x1000 do
        panic("x86_64 Linux page size must be 4KB")
    end

    let ps_x86_darwin = target_get_page_size(TargetArch.X86_64, TargetOS.Darwin, ObjectFormat.MachO)
    if ps_x86_darwin != 0x1000 do
        panic("x86_64 Darwin page size must be 4KB")
    end

    let ps_x86_win = target_get_page_size(TargetArch.X86_64, TargetOS.Windows, ObjectFormat.PE_COFF)
    if ps_x86_win != 0x1000 do
        panic("x86_64 Windows page size must be 4KB")
    end

    let ps_riscv = target_get_page_size(TargetArch.RISCV64, TargetOS.Linux, ObjectFormat.ELF)
    if ps_riscv != 0x10000 do
        panic("RISCV64 Linux page size must be 64KB")
    end

    let ps_wasm = target_get_page_size(TargetArch.Wasm32, TargetOS.WASI_P1, ObjectFormat.Wasm)
    if ps_wasm != 65536 do
        panic("WASM page size must be 64KB")
    end

    # 9. LIR Pre-RA and Post-RA Target Isolation Hook Verification
    let dummy_lf: i64 = 0
    let pre_arm = opt_backend_run_lir_pre(dummy_lf, TargetArch.ARM64 as int)
    let pre_x86 = opt_backend_run_lir_pre(dummy_lf, TargetArch.X86_64 as int)
    let pre_riscv = opt_backend_run_lir_pre(dummy_lf, TargetArch.RISCV64 as int)
    let pre_wasm = opt_backend_run_lir_pre(dummy_lf, TargetArch.Wasm32 as int)

    let post_arm = opt_backend_run_lir_post(dummy_lf, TargetArch.ARM64 as int)
    let post_x86 = opt_backend_run_lir_post(dummy_lf, TargetArch.X86_64 as int)
    let post_riscv = opt_backend_run_lir_post(dummy_lf, TargetArch.RISCV64 as int)
    let post_wasm = opt_backend_run_lir_post(dummy_lf, TargetArch.Wasm32 as int)

    print "PASS: target architecture isolation and triple routing verified"
    out 0
end.
