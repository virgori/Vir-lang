enum AstType:
    Program = 0
    Block = 1
    VarDecl = 3
end.

enum OpType:
    Add = 0
end.

entity AstNode:
    name:           string,
    name2:          string,
    node_type:      AstType,
    op:             OpType,
    line:           int,
    int_val:        int,
    float_val:      float,
    builtin_id:     int,
    children:       int
end.

func ast_add_child(parent: AstNode, child_val: int):
    parent.children = child_val
    out parent
end.

func main:
    var p = AstNode (
        name:       "parent_node",
        name2:      "name2",
        node_type:  AstType.VarDecl,
        op:         OpType.Add,
        line:       42,
        int_val:    0,
        float_val:  0.0,
        builtin_id: 0,
        children:   0
    )
    
    print "Before:"
    print p.name
    print p.node_type as int
    print p.children
    
    p = ast_add_child(p, 999)
    
    print "After:"
    print p.name
    print p.node_type as int
    print p.children
    out 0
end.
