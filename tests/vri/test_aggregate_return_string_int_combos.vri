# Regression Test: Aggregate return with combinations of string and int fields
# Protection: Bug 2 & 3 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Multiple string and int fields in returned entity preserve values correctly.

entity MetricEvent:
    name: string
    count: int
    tag: string
    status: int
end.

func build_event(n: string, c: int, t: string, s: int) -> MetricEvent:
    out MetricEvent(name: n, count: c, tag: t, status: s)
end.

func main:
    let ev = build_event("http_requests", 42, "prod", 200)
    print_str(ev.name)
    print ev.count
    print_str(ev.tag)
    print ev.status
    out 0
end.

