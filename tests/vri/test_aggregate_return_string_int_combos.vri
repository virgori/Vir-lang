# EXPECT_START
# http_requests
# 42
# prod
# 200
# EXPECT_END
entity MetricEvent:
    name: string
    count: int
    tag: string
    status: int
end.

func build_event(n: string, c: int, t: string, s: int) -> MetricEvent:
    out MetricEvent(name: n, count: c, tag: t, status: s)
end.

func main:
    let ev = build_event("http_requests", 42, "prod", 200)
    print_str(ev.name)
    print ev.count
    print_str(ev.tag)
    print ev.status
    out 0
end.

