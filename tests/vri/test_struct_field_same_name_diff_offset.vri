# EXPECT:
# 200
# 7
# 404
# 503
# 1024
# 201
# 9
# 200
# 500
# 2048
# Regression Test: Same field name at different offsets across entities
# Protection: Bug 1 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Field 'status' at offset 0 in Header must not collide
#   with field 'status' at offset 8 in Response.

entity Header:
    status: int
    flags: int
end.

entity Response:
    code: int
    status: int
    bytes: int
end.

func main:
    let h = Header(status: 200, flags: 7)
    let r = Response(code: 404, status: 503, bytes: 1024)

    print h.status
    print h.flags
    print r.code
    print r.status
    print r.bytes

    let h2 = Header(status: 201, flags: 9)
    let r2 = Response(code: 200, status: 500, bytes: 2048)
    print h2.status
    print h2.flags
    print r2.code
    print r2.status
    print r2.bytes
    out 0
end.

