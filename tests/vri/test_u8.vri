module test_u8
include alloc; import vir_alloc from alloc
include io; import print_ln from io

func main:
    let ptr = vir_alloc(10)
    extern func native_write_u8(addr: int, offset: int, val: int)
    extern func native_read_u8(addr: int, offset: int) -> int
    
    native_write_u8(ptr, 0, 65);  # 'A'
    native_write_u8(ptr, 1, 66);  # 'B'
    native_write_u8(ptr, 2, 67);  # 'C'
    native_write_u8(ptr, 3, 0)
    
    print_ln(ptr)
    out 0
end
