# Regression Test: Integer literal boundary (INT64_MAX and large literals)
# Protection: Hạn Chế 8 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Literal values at the 64-bit signed boundary (9223372036854775807)
#   are tokenized and evaluated correctly without truncation.

func main:
    # Exact INT64_MAX literal
    var max_lit = 9223372036854775807
    print max_lit

    # INT64_MAX - 1 literal
    var max_minus_one = 9223372036854775806
    print max_minus_one

    # Small literals around zero
    var zero_lit = 0
    var one_lit = 1
    print zero_lit
    print one_lit

    # Negative boundary via subtraction from zero
    var min_lit = 0 - 9223372036854775807
    print min_lit
    out 0
end.

