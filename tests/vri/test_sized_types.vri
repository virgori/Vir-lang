# Test sized types — truncation behavior
# §4.1: i8, i16, i32, u8, u16, u32

# i8 truncation: 300 & 0xFF = 44
var x: i8 = 300
print x

# u8 truncation: 256 & 0xFF = 0
var y: u8 = 256
print y

# i16 truncation: 70000 & 0xFFFF = 4464
var z: i16 = 70000
print z

# i32 truncation: 0x1_0000_0001 & 0xFFFFFFFF = 1
var w: i32 = 4294967297
print w

# bool truncation: 42 & 1 = 0
var b: bool = 42
print b

# Assignment truncation
var v: u8 = 0
v = 500
print v

# 64-bit types should NOT truncate
var big: i64 = 9223372036854775807
print big

# ptr is native word size (no truncation)
var p: ptr = 12345
print p

# Expected output:
# 44
# 0
# 4464
# 1
# 0
# 244
# 9223372036854775807
# 12345
