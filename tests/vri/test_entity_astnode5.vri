enum AstType:
    Program = 0
    Block = 1
    VarDecl = 3
    LiteralInt = 24
end.

enum OpType:
    Add = 0
end.

entity AstNode:
    name:           string,
    name2:          string,
    node_type:      AstType,
    op:             OpType,
    line:           int,
    int_val:        int,
    float_val:      float,
    builtin_id:     int,
    children:       int
end.

func main:
    var p = AstNode (
        name:       "parent_node",
        name2:      "name2",
        node_type:  AstType.VarDecl,
        op:         OpType.Add,
        line:       42,
        int_val:    99,
        float_val:  1.0,
        builtin_id: 88,
        children:   77
    )
    
    print p.node_type as int
    print p.line
    print p.int_val
    print p.builtin_id
    print p.children
    out 0
end.
