##
 * Test §26 AI/ML - tensor matmul
 * Expected: 2x2 matrix multiplication result
 ##

func main:
    # Create 2x2 matrices
    var a: tensor<int>[2, 2] = [1, 2, 3, 4]
    var b: tensor<int>[2, 2] = [5, 6, 7, 8]
    
    # Matmul: [1,2; 3,4] * [5,6; 7,8]
    # Result: [1*5+2*7, 1*6+2*8; 3*5+4*7, 3*6+4*8]
    #       = [19, 22; 43, 50]
    var c = a ** b
    
    # Print results
    print c[0];  # 19
    print c[1];  # 22
    print c[2];  # 43
    print c[3];  # 50
end
