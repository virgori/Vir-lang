# Regression Test: Signed 64-bit integer overflow wrapping behavior
# Protection: Hạn Chế 2 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Signed 64-bit integer arithmetic wraps according to two's complement:
#   INT64_MAX + 1 wraps to negative (INT64_MIN)
#   INT64_MAX * 2 (e.g. exponential backoff overflow) wraps to -2
#   (INT64_MAX + 1) + 1 wraps to -9223372036854775807

func main:
    var max_half = 4611686018427387903
    var int64_max = max_half + max_half + 1
    print int64_max

    # 1. Addition overflow wraps to negative (two's complement)
    var int64_min = int64_max + 1
    if int64_min < 0 do
        print 1
    else
        print 0
    end

    # 2. INT64_MIN + 1 equals -9223372036854775807
    var min_plus_one = int64_min + 1
    print min_plus_one

    # 3. Multiplication (exponential backoff) overflow wraps to -2
    var backoff_overflow = int64_max * 2
    print backoff_overflow

    # 4. Underflow wraps back to positive
    var wrapped_back = int64_min - 2
    if wrapped_back > 0 do
        print 1
    else
        print 0
    end
    out 0
end.

