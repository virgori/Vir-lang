enum AstType:
    VarDecl = 3
    LiteralInt = 24
end.

entity AstNode:
    name:           string
    node_type:      AstType
    children:       int
end.

func vec_push_rt(v: int, val: int):
    out 12345
end.

func ast_add_child(parent: AstNode, child: AstNode):
    parent.children = vec_push_rt(parent.children, child)
    out parent
end.

func parse_var_decl(p: int):
    var decl = AstNode(name: "var_n", node_type: AstType.VarDecl, children: 0)
    var init = AstNode(name: "child", node_type: AstType.LiteralInt, children: 0)
    
    decl = ast_add_child(decl, init)
    
    out (p + 1, decl)
end.

func main:
    var (p, decl) = parse_var_decl(10)
    print p
    print decl.name
    print decl.node_type as int
    print decl.children
    out 0
end.
