# EXPECT:
# 10
# 20
# 30
# 40
# 50
# 10
# 20
# 333
# 40
# 50
# 111
# 20
# 333
# 40
# 555
# Regression Test: Field read/write boundaries (start, middle, end)
# Protection: Bug 1 & 3 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Distinct offsets for start (offset 0), middle (offset 16),
#   and end (offset 32) fields evaluate accurately without adjacent corruption.

entity Record:
    first: int
    second: int
    third: int
    fourth: int
    fifth: int
end.

func main:
    let r = Record(first: 10, second: 20, third: 30, fourth: 40, fifth: 50)

    # Verify initial values across all boundaries
    print r.first
    print r.second
    print r.third
    print r.fourth
    print r.fifth

    # Verify mutation of middle field
    let r2 = Record(first: 10, second: 20, third: 333, fourth: 40, fifth: 50)
    print r2.first
    print r2.second
    print r2.third
    print r2.fourth
    print r2.fifth

    # Verify mutation of boundary fields (start and end)
    let r3 = Record(first: 111, second: 20, third: 333, fourth: 40, fifth: 555)
    print r3.first
    print r3.second
    print r3.third
    print r3.fourth
    print r3.fifth
    out 0
end.

