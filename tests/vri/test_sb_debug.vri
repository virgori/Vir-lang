module test_sb
include string_rt
import sb_new, sb_append, sb_append_int, sb_to_string, sb_free, StringBuilder from string_rt
include io
import print_ln, print_int from io

func main:
    let sb = sb_new()
    print_int(sb.len); print_ln(" <- initial len")
    sb = sb_append(sb, "Hello ")
    print_int(sb.len); print_ln(" <- after Hello")
    sb = sb_append_int(sb, 123)
    print_int(sb.len); print_ln(" <- after 123")
    sb = sb_append(sb, " World")
    print_int(sb.len); print_ln(" <- after World")
    print_ln(sb_to_string(sb))
    sb_free(sb)
    out 0
end
