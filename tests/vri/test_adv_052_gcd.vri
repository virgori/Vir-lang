# test_adv_052: GCD (Euclidean algorithm)
# Expected: 6, 1, 12

func gcd(a, b):
    when b != 0 loop
        var t = b
        b = a mod b
        a = t
    end
    out a
end.

func main:
    print gcd(54, 24)
    print gcd(17, 13)
    print gcd(36, 60)
end.
