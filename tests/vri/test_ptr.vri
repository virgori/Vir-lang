module test_ptr
include rt.syscall
include rt.alloc
include rt.string_rt
include mem.slice
include str.string
include collections.vec
include core.result
include rt.io
import read_file_str, print_int, print_ln, print_str from rt.io

func main:
    let ptr = read_file_str("hello.vri")
    print_str("ptr string is: \n")
    print_str(ptr)
    print_ln("")
end.
export main
