# EXPECT_START
# 19
# 22
# 43
# 50
# 99
# 88
# 58
# 64
# 139
# 154
# 20
# 40
# 60
# 80
# 187
# 11
# 9
# 35
# 32
# EXPECT_END
##
 * test_tensor_ml_ops.vri — First-Class Tensor & ML Operator Test Suite
 *
 * Validates Spec v2.0 first-class tensor constructs:
 *   1. First-class tensor type declaration: tensor<int>[M, K]
 *   2. First-class 2D Square MatMul operator: a ** b
 *   3. First-class 2D Rectangular MatMul operator: a_rect ** b_rect
 *   4. First-class Multi-Index reading: c[i, j]
 *   5. First-class Multi-Index writing (mutation): c[i, j] = val
 *   6. First-class Arena block scoping: arena: ... end
 *   7. First-class arithmetic operators: +, -, *, mod
 *   8. First-class bitwise operators: and, shr
 ##

func main():
    # 1. 2D Square MatMul (2x2) using first-class operator **
    var a: tensor<int>[2, 2] = [1, 2, 3, 4]
    var b: tensor<int>[2, 2] = [5, 6, 7, 8]
    var c = a ** b

    # Print computed elements of c:
    # c[0, 0] = 1*5 + 2*7 = 19
    # c[0, 1] = 1*6 + 2*8 = 22
    # c[1, 0] = 3*5 + 4*7 = 43
    # c[1, 1] = 3*6 + 4*8 = 50
    print c[0, 0]
    print c[0, 1]
    print c[1, 0]
    print c[1, 1]

    # 2. Multi-index mutation
    c[0, 0] = 99
    c[1, 1] = 88
    print c[0, 0]
    print c[1, 1]

    # 3. 2D Rectangular MatMul (2x3) ** (3x2) using first-class operator **
    var ar: tensor<int>[2, 3] = [1, 2, 3, 4, 5, 6]
    var br: tensor<int>[3, 2] = [7, 8, 9, 10, 11, 12]
    var cr = ar ** br

    # cr[0, 0] = 1*7 + 2*9 + 3*11 = 58
    # cr[0, 1] = 1*8 + 2*10 + 3*12 = 64
    # cr[1, 0] = 4*7 + 5*9 + 6*11 = 139
    # cr[1, 1] = 4*8 + 5*10 + 6*12 = 154
    print cr[0, 0]
    print cr[0, 1]
    print cr[1, 0]
    print cr[1, 1]

    # 4. Scoped Arena block with first-class tensor operations
    arena:
        var sa: tensor<int>[2, 2] = [2, 0, 0, 2]
        var sb: tensor<int>[2, 2] = [10, 20, 30, 40]
        var sc = sa ** sb
        print sc[0, 0]
        print sc[0, 1]
        print sc[1, 0]
        print sc[1, 1]
    end

    # 5. First-class arithmetic & bitwise operators on tensor elements
    var trace = c[0, 0] + c[1, 1] # 99 + 88 = 187
    var diff = c[0, 0] - c[1, 1]  # 99 - 88 = 11
    var rem = cr[1, 0] mod 10     # 139 mod 10 = 9 (Testing mod, NOT %)
    var masked = c[0, 0] and 63   # 99 and 63 = 35 (Testing and, NOT &)
    var v_cr = cr[0, 1]
    var shifted = v_cr shr 1      # 64 shr 1 = 32
    print trace
    print diff
    print rem
    print masked
    print shifted
end.
