##
 * test_tensor_ml_ops.vri — Comprehensive Test Suite for Vir ML Engine
 *
 * Validates:
 *   1. 64-byte SIMD/NPU cacheline alignment
 *   2. TensorArena bump allocator & sub-arena scratchpads
 *   3. Zero-copy broadcasting (stride-0 view creation)
 *   4. Fused Multiply-Accumulate (tensor_fma)
 *   5. Cache-friendly 2D Tiled MatMul & 3D Batched BMM
 *   6. Numerical reductions (Kahan sum, mean, max, min, argmax, variance)
 *   7. Activations (ReLU, Sigmoid, GELU, Softmax row-stochastic)
 *   8. Neural network layers (Linear, LayerNorm, RMSNorm)
 ##

include types
include alloc
import alloc, free from alloc
include math/tensor
import Tensor, TensorArena, tensor_zeros, tensor_zeros_arena, tensor_ones, tensor_get_flat, tensor_set_flat,
    tensor_arena_new, tensor_arena_alloc, tensor_sub_arena_new, tensor_arena_reset, tensor_arena_free,
    tensor_arena_base, tensor_arena_offset, tensor_arena_cap,
    tensor_broadcast_to, tensor_add, tensor_sub, tensor_mul, tensor_scale, tensor_clamp,
    tensor_fma, tensor_matmul, tensor_matmul_naive, tensor_bmm,
    tensor_sum, tensor_mean, tensor_max, tensor_min, tensor_argmax, tensor_argmin, tensor_variance,
    tensor_relu, tensor_sigmoid, tensor_gelu, tensor_softmax,
    tensor_linear, tensor_layer_norm, tensor_rms_norm, _store_i64, _load_i64 from tensor
include vir.rt.io
import print_str, print_ln, int_to_str from vir.rt.io

func check_close(a: float, b: float, tol: float):
    if a == b do out true end
    var diff = a - b
    if diff < 0 do diff = 0 - diff end
    out diff <= tol
end.

func test_64_byte_alignment() -> bool:
    var s = alloc(1 * 8)
    _store_i64(s, 0, 16)
    var t = tensor_zeros(s, 1)
    free(s)
    
    var addr = t.data as int
    if (addr & 63) != 0 do
        print_ln("FAIL: tensor buffer not 64-byte aligned")
        out false
    end
    out true
end.

func test_sub_arena() -> bool:
    # 1. Create main arena (64 KB)
    var main_arena = tensor_arena_new(65536)
    if tensor_arena_base(main_arena) == null do
        print_ln("FAIL: main arena allocation failed")
        out false
    end
    
    # 2. Create sub-arena scratchpad (16 KB) carved from main arena
    var sub_arena = tensor_sub_arena_new(main_arena, 16384)
    if tensor_arena_base(sub_arena) == null do
        print_ln("FAIL: sub arena carving failed")
        out false
    end
    
    # 3. Allocate tensor in sub-arena
    var s = alloc(2 * 8)
    _store_i64(s, 0, 4)
    _store_i64(s, 1, 4)
    var t_sub = tensor_zeros_arena(s, 2, sub_arena)
    free(s)
    
    var addr = t_sub.data as int
    if (addr & 63) != 0 do
        print_ln("FAIL: sub-arena tensor not 64-byte aligned")
        out false
    end
    
    if tensor_arena_offset(sub_arena) == 0 do
        print_ln("FAIL: sub-arena bump pointer did not advance")
        out false
    end
    
    # 4. Reset sub-arena (zero-cost scratchpad reuse)
    tensor_arena_reset(sub_arena)
    if tensor_arena_offset(sub_arena) != 0 do
        print_ln("FAIL: sub-arena reset failed")
        out false
    end
    
    tensor_arena_free(sub_arena)
    tensor_arena_free(main_arena)
    out true
end.

func test_broadcasting_and_fma() -> bool:
    # A: [2, 1] filled with 2 and 3
    var sa = alloc(2 * 8)
    _store_i64(sa, 0, 2)
    _store_i64(sa, 1, 1)
    var a = tensor_zeros(sa, 2)
    free(sa)
    tensor_set_flat(a, 0, 2)
    tensor_set_flat(a, 1, 3)
    
    # B: [2, 3] filled with 4
    var sb = alloc(2 * 8)
    _store_i64(sb, 0, 2)
    _store_i64(sb, 1, 3)
    var b = tensor_zeros(sb, 2)
    free(sb)
    var i = 0
    when i < 6 loop
        tensor_set_flat(b, i, 4)
        i = i + 1
    end
    
    # C: [2, 3] filled with 1
    var sc = alloc(2 * 8)
    _store_i64(sc, 0, 2)
    _store_i64(sc, 1, 3)
    var c = tensor_zeros(sc, 2)
    free(sc)
    i = 0
    when i < 6 loop
        tensor_set_flat(c, i, 1)
        i = i + 1
    end
    
    # Broadcast add: A [2, 1] + B [2, 3]
    # Row 0: 2 + 4 = 6
    # Row 1: 3 + 4 = 7
    var res_add = tensor_add(a, b)
    var v_add0 = tensor_get_flat(res_add, 0)
    var v_add3 = tensor_get_flat(res_add, 3)
    if not check_close(v_add0, 6, 0) do
        print_str("FAIL add0: got ")
        print_ln(int_to_str(v_add0 as int))
        out false
    end
    if not check_close(v_add3, 7, 0) do
        print_str("FAIL add3: got ")
        print_ln(int_to_str(v_add3 as int))
        out false
    end
    
    # FMA: A [2, 1] * B [2, 3] + C [2, 3]
    # Row 0: 2 * 4 + 1 = 9
    # Row 1: 3 * 4 + 1 = 13
    var res_fma = tensor_fma(a, b, c)
    var v_fma0 = tensor_get_flat(res_fma, 0)
    var v_fma5 = tensor_get_flat(res_fma, 5)
    if not check_close(v_fma0, 9, 0) do
        print_str("FAIL fma0: got ")
        print_ln(int_to_str(v_fma0 as int))
        out false
    end
    if not check_close(v_fma5, 13, 0) do
        print_str("FAIL fma5: got ")
        print_ln(int_to_str(v_fma5 as int))
        out false
    end
    
    out true
end.

func test_reductions() -> bool:
    # Tensor [4] = [1, 2, 3, 4]
    var s = alloc(1 * 8)
    _store_i64(s, 0, 4)
    var t = tensor_zeros(s, 1)
    free(s)
    tensor_set_flat(t, 0, 1)
    tensor_set_flat(t, 1, 2)
    tensor_set_flat(t, 2, 3)
    tensor_set_flat(t, 3, 4)
    
    var s_val = tensor_sum(t) # 10
    if not check_close(s_val, 10, 0) do
        print_ln("FAIL: tensor_sum")
        out false
    end
    
    var m_val = tensor_mean(t) # 2
    if not check_close(m_val, 2, 0) do
        print_ln("FAIL: tensor_mean")
        out false
    end
    
    var mx_val = tensor_max(t) # 4
    if not check_close(mx_val, 4, 0) do
        print_ln("FAIL: tensor_max")
        out false
    end
    
    var mn_val = tensor_min(t) # 1
    if not check_close(mn_val, 1, 0) do
        print_ln("FAIL: tensor_min")
        out false
    end
    
    var amx = tensor_argmax(t) # 3
    if amx != 3 do
        print_str("FAIL: tensor_argmax: ")
        print_ln(int_to_str(amx))
        out false
    end
    
    var amn = tensor_argmin(t) # 0
    if amn != 0 do
        print_str("FAIL: tensor_argmin: ")
        print_ln(int_to_str(amn))
        out false
    end
    
    # Variance of [1, 2, 3, 4] with mean 2:
    # ((1-2)^2 + (2-2)^2 + (3-2)^2 + (4-2)^2) / 4 = 1
    var v_val = tensor_variance(t)
    if not check_close(v_val, 1, 0) do
        print_ln("FAIL: tensor_variance")
        out false
    end
    
    out true
end.

func test_activations() -> bool:
    # Input [-2, 0, 2]
    var s = alloc(1 * 8)
    _store_i64(s, 0, 3)
    var t = tensor_zeros(s, 1)
    free(s)
    tensor_set_flat(t, 0, 0 - 2)
    tensor_set_flat(t, 1, 0)
    tensor_set_flat(t, 2, 2)
    
    # ReLU: [0, 0, 2]
    var r = tensor_relu(t)
    if not check_close(tensor_get_flat(r, 0), 0, 0) do out false end
    if not check_close(tensor_get_flat(r, 1), 0, 0) do out false end
    if not check_close(tensor_get_flat(r, 2), 2, 0) do out false end
    
    # GELU(0) = 0
    var g = tensor_gelu(t)
    if not check_close(tensor_get_flat(g, 1), 0, 0) do out false end
    
    # Softmax row stochastic property: sum of probs must equal 1
    var s2 = alloc(2 * 8)
    _store_i64(s2, 0, 1)
    _store_i64(s2, 1, 3)
    var t2 = tensor_zeros(s2, 2)
    free(s2)
    tensor_set_flat(t2, 0, 1)
    tensor_set_flat(t2, 1, 2)
    tensor_set_flat(t2, 2, 3)
    
    var sm = tensor_softmax(t2, 1)
    var sm_sum = tensor_get_flat(sm, 0) + tensor_get_flat(sm, 1) + tensor_get_flat(sm, 2)
    if not check_close(sm_sum, 1, 0) do out false end
    
    out true
end.

func test_batched_matmul() -> bool:
    # BMM: [2, 2, 2] x [2, 2, 2] => [2, 2, 2]
    # Batch 0: Identity [[1, 0], [0, 1]] x [[3, 4], [5, 6]] = [[3, 4], [5, 6]]
    # Batch 1: Scale 2*Identity [[2, 0], [0, 2]] x [[1, 1], [1, 1]] = [[2, 2], [2, 2]]
    var s = alloc(3 * 8)
    _store_i64(s, 0, 2)
    _store_i64(s, 1, 2)
    _store_i64(s, 2, 2)
    
    var a = tensor_zeros(s, 3)
    var b = tensor_zeros(s, 3)
    free(s)
    
    # Batch 0
    tensor_set_flat(a, 0, 1)
    tensor_set_flat(a, 1, 0)
    tensor_set_flat(a, 2, 0)
    tensor_set_flat(a, 3, 1)
    
    tensor_set_flat(b, 0, 3)
    tensor_set_flat(b, 1, 4)
    tensor_set_flat(b, 2, 5)
    tensor_set_flat(b, 3, 6)
    
    # Batch 1
    tensor_set_flat(a, 4, 2)
    tensor_set_flat(a, 5, 0)
    tensor_set_flat(a, 6, 0)
    tensor_set_flat(a, 7, 2)
    
    tensor_set_flat(b, 4, 1)
    tensor_set_flat(b, 5, 1)
    tensor_set_flat(b, 6, 1)
    tensor_set_flat(b, 7, 1)
    
    var c = tensor_bmm(a, b)
    
    # Verify Batch 0: [3, 4, 5, 6]
    if not check_close(tensor_get_flat(c, 0), 3, 0) do out false end
    if not check_close(tensor_get_flat(c, 1), 4, 0) do out false end
    if not check_close(tensor_get_flat(c, 2), 5, 0) do out false end
    if not check_close(tensor_get_flat(c, 3), 6, 0) do out false end
    
    # Verify Batch 1: [2, 2, 2, 2]
    if not check_close(tensor_get_flat(c, 4), 2, 0) do out false end
    if not check_close(tensor_get_flat(c, 5), 2, 0) do out false end
    if not check_close(tensor_get_flat(c, 6), 2, 0) do out false end
    if not check_close(tensor_get_flat(c, 7), 2, 0) do out false end
    
    out true
end.

func test_nn_layers() -> bool:
    # 1. Linear layer: X [1, 2] @ W^T [2, 2]^T + b [1, 2]
    # X = [[1, 2]]
    # W = [[1, 0], [0, 1]] (Identity) -> X @ W^T = [[1, 2]]
    # b = [[10, 20]]
    # Out = [[11, 22]]
    var sx = alloc(2 * 8)
    _store_i64(sx, 0, 1)
    _store_i64(sx, 1, 2)
    var x = tensor_zeros(sx, 2)
    free(sx)
    tensor_set_flat(x, 0, 1)
    tensor_set_flat(x, 1, 2)
    
    var sw = alloc(2 * 8)
    _store_i64(sw, 0, 2)
    _store_i64(sw, 1, 2)
    var w = tensor_zeros(sw, 2)
    free(sw)
    tensor_set_flat(w, 0, 1)
    tensor_set_flat(w, 1, 0)
    tensor_set_flat(w, 2, 0)
    tensor_set_flat(w, 3, 1)
    
    var sb = alloc(2 * 8)
    _store_i64(sb, 0, 1)
    _store_i64(sb, 1, 2)
    var b = tensor_zeros(sb, 2)
    free(sb)
    tensor_set_flat(b, 0, 10)
    tensor_set_flat(b, 1, 20)
    
    var lin_out = tensor_linear(x, w, b.data)
    if not check_close(tensor_get_flat(lin_out, 0), 11, 0) do out false end
    if not check_close(tensor_get_flat(lin_out, 1), 22, 0) do out false end
    
    # 2. RMSNorm: X = [[2, 2]]
    # RMS = sqrt(mean(2^2, 2^2)) = sqrt(4) = 2
    # Normalized = [[1, 1]]
    var gamma_shape = alloc(1 * 8)
    _store_i64(gamma_shape, 0, 2)
    var gamma = tensor_ones(gamma_shape, 1)
    free(gamma_shape)
    
    var sx2 = alloc(2 * 8)
    _store_i64(sx2, 0, 1)
    _store_i64(sx2, 1, 2)
    var x2 = tensor_zeros(sx2, 2)
    free(sx2)
    tensor_set_flat(x2, 0, 2)
    tensor_set_flat(x2, 1, 2)
    
    var rms = tensor_rms_norm(x2, gamma.data, 0)
    if not check_close(tensor_get_flat(rms, 0), 1, 0) do out false end
    if not check_close(tensor_get_flat(rms, 1), 1, 0) do out false end
    
    out true
end.

func test_native_tensor_ops() -> bool:
    var a: tensor<int>[2, 2] = [1, 2, 3, 4]
    var b: tensor<int>[2, 2] = [5, 6, 7, 8]
    var c = a ** b
    if c[0, 0] != 19 or c[0, 1] != 22 or c[1, 0] != 43 or c[1, 1] != 50 do
        print_ln("FAIL: native tensor matmul ** or multi-index read c[i, j]")
        out false
    end
    # Test multi-index mutation
    c[0, 0] = 99
    c[1, 1] = 88
    if c[0, 0] != 99 or c[1, 1] != 88 do
        print_ln("FAIL: native tensor multi-index write c[i, j] = val")
        out false
    end
    out true
end.

func main() -> int:
    if not test_native_tensor_ops() do
        print_ln("FAIL: test_native_tensor_ops")
        out 1
    end

    if not test_64_byte_alignment() do
        print_ln("FAIL: test_64_byte_alignment")
        out 1
    end
    
    if not test_sub_arena() do
        print_ln("FAIL: test_sub_arena")
        out 1
    end
    
    if not test_broadcasting_and_fma() do
        print_ln("FAIL: test_broadcasting_and_fma")
        out 1
    end
    
    if not test_reductions() do
        print_ln("FAIL: test_reductions")
        out 1
    end
    
    if not test_activations() do
        print_ln("FAIL: test_activations")
        out 1
    end
    
    if not test_batched_matmul() do
        print_ln("FAIL: test_batched_matmul")
        out 1
    end
    
    if not test_nn_layers() do
        print_ln("FAIL: test_nn_layers")
        out 1
    end
    
    print_ln("PASS: all tensor & ML operator verification suites passed")
    out 0
end.
