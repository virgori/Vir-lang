var total_errors = 0

func process(input: int) -> int:
    var result = 0
    if input > 100: do
        result = input - 100
    eif input > 50: do
        result = input - 50
    eif input > 0: do
        result = input
    else
        result = 0
        total_errors = total_errors + 1
    end
    out result
end.

func main():
    var r1 = process(200)
    print r1
    var r2 = process(75)
    print r2
    var r3 = process(30)
    print r3
    var r4 = process(0)
    print r4
    print total_errors
end.
