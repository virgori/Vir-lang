enum AstType:
    Program = 0
    Block = 1
    VarDecl = 3
    LiteralInt = 24
end.

enum OpType:
    Add = 0
end.

entity AstNode:
    name:           string,
    name2:          string,
    node_type:      AstType,
    op:             OpType,
    line:           int,
    int_val:        int,
    float_val:      float,
    builtin_id:     int,
    children:       int
end.


func parse_var_decl_single():
    var decl = AstNode (
        name:       "parent_node",
        name2:      "name2",
        node_type:  AstType.VarDecl,
        op:         OpType.Add,
        line:       42,
        int_val:    0,
        float_val:  0.0,
        builtin_id: 0,
        children:   0
    )
    
    decl.name = "var_n"
    
    var init = AstNode (
        name:       "child_node",
        name2:      "name2",
        node_type:  AstType.LiteralInt,
        op:         OpType.Add,
        line:       42,
        int_val:    99,
        float_val:  0.0,
        builtin_id: 0,
        children:   0
    )

    decl.children = vec_push_rt(decl.children, init as int)
    out decl
end.

func main:
    var p = parse_var_decl_single()
    
    print "After:"
    print p.name
    print p.node_type as int
    print p.children
    out 0
end.
