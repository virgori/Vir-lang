# test_adv_048: Linked list via manual heap allocation
# Expected: 30, 20, 10

func main:
    # Each node: [value:8][next_ptr:8] = 16 bytes
    # Build list: 10 -> 20 -> 30

    var n1 = alloc(16)
    write_word(n1, 0, 10)
    write_word(n1, 8, 0)

    var n2 = alloc(16)
    write_word(n2, 0, 20)
    write_word(n2, 8, n1)

    var n3 = alloc(16)
    write_word(n3, 0, 30)
    write_word(n3, 8, n2)

    # Traverse from n3
    var cur = n3
    when cur != 0 loop
        var val = read_word(cur, 0)
        print val
        cur = read_word(cur, 8)
    end
end.
