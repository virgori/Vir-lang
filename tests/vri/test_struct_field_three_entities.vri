# Regression Test: Three entities sharing identical field name at distinct offsets
# Protection: Bug 1 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Field 'id' at offset 0 (Alpha), offset 8 (Beta), and offset 16 (Gamma)
#   must each resolve strictly according to their TypeID.

entity Alpha:
    id: int
    val_a: int
end.

entity Beta:
    tag: int
    id: int
    val_b: int
end.

entity Gamma:
    pad1: int
    pad2: int
    id: int
    val_c: int
end.

func main:
    let a = Alpha(id: 100, val_a: 10)
    let b = Beta(tag: 20, id: 200, val_b: 22)
    let g = Gamma(pad1: 30, pad2: 31, id: 300, val_c: 33)

    print a.id
    print a.val_a
    print b.tag
    print b.id
    print b.val_b
    print g.pad1
    print g.pad2
    print g.id
    print g.val_c

    let a2 = Alpha(id: 111, val_a: 11)
    let b2 = Beta(tag: 21, id: 222, val_b: 23)
    let g2 = Gamma(pad1: 32, pad2: 33, id: 333, val_c: 34)

    print a2.id
    print a2.val_a
    print b2.tag
    print b2.id
    print b2.val_b
    print g2.pad1
    print g2.pad2
    print g2.id
    print g2.val_c
    out 0
end.

