# Test semicolon-separated var blocks
# Spec §5.3: var x; y; z syntax

var
    a: int = 10
    b: int = 20
    c: int = 30

print a
print b
print c

# Test single-line semicolon block
var x = 100; y = 200; z = 300

print x
print y
print z

# Test const block
const
    PI = 314
    MAX = 999

print PI
print MAX

# Test let block
let
    p = 42
    q = 84

print p
print q

# Expected output:
# 10
# 20
# 30
# 100
# 200
# 300
# 314
# 999
# 42
# 84
