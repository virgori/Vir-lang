# §4.8 Ownership / Borrow — valid program (should succeed)

func main:
    # Copy types — no move
    var x = 10
    var y = x
    print x
    print y

    # Move type (array) + shared borrow keeps source alive
    var a = [1, 2, 3]
    var b = &a           # shared borrow, 'a' remains valid
    print a[0]
    print a[1]

    # Move after no-longer-borrowed
    var c = a            # move: 'a' is consumed
    print c[0]
    print c[1]
    print c[2]

    # Reassign resurrects move-type var
    var d = [7, 8]
    var e = d            # d moved
    d = [9]              # d resurrected
    print d[0]
    print e[0]
    print e[1]
end.
