# Regression Test: Aggregate / struct return ABI containing string
# Protection: Bug 2 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Factory function returning an entity with a string field
#   must preserve string pointer and contents without corruption after return.

entity UpstreamTarget:
    host: string
    port_num: int
    is_tls: int
end.

func create_target(h: string, p: int) -> UpstreamTarget:
    out UpstreamTarget(host: h, port_num: p, is_tls: 1)
end.

func main:
    let t = create_target("api.internal.local", 8080)
    print_str(t.host)
    print t.port_num
    print t.is_tls
    out 0
end.

