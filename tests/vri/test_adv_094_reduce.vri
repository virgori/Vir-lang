# test_adv_094: Reduce/fold over array
# Expected: 120

func mul(a, b):
    out a * b
end.

func reduce(arr, n, f, init):
    var acc = init
    var i = 0
    when i < n loop
        acc = f(acc, arr[i])
        i = i + 1
    end
    out acc
end.

func main:
    var arr = arr_new(8)
    push(arr, 1)
    push(arr, 2)
    push(arr, 3)
    push(arr, 4)
    push(arr, 5)

    # 1*2*3*4*5 = 120
    var r = reduce(arr, 5, mul, 1)
    print r
end.
