# EXPECT:
# 1
# 2
# 333
# 444
# 555
# Regression Test: Struct field offset scoped by type
# Protection: Bug 1 in COMPILER_BUGS_AND_LIMITATIONS.md (Global struct field collision)
# Expected behavior: Field offset resolution must be scoped by TypeID.
#   ev.trace_id_hi must resolve to byte offset 16 in LogEvent (value 333),
#   not byte offset 0 from TraceContext (value 1).

entity TraceContext:
    trace_id_hi: int
    trace_id_lo: int
    span_id: int
end.

entity LogEvent:
    level: int
    timestamp_ms: int
    trace_id_hi: int
    trace_id_lo: int
    span_id: int
end.

func main:
    let ev = LogEvent(level: 1, timestamp_ms: 2, trace_id_hi: 333, trace_id_lo: 444, span_id: 555)
    print ev.level
    print ev.timestamp_ms
    print ev.trace_id_hi
    print ev.trace_id_lo
    print ev.span_id
    out 0
end.

