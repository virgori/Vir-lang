module test_hang

include vir.rt.syscall
import sys_exit, sys_write, SYS_EXIT, SYS_WRITE from syscall
include vir.rt.alloc
import vir_alloc, vir_free, vir_realloc, heap_init from alloc
include vir.rt.string_rt
import rt_strlen, rt_strcmp, rt_streq, rt_strcat, rt_strdup,
       rt_itoa, rt_atoi, StringBuilder, sb_new, sb_append,
       sb_append_char, sb_append_int, sb_to_string, sb_free from string_rt
include vir.rt.io
import print_str, print_int, print_ln, print_newline, eprint_ln,
       read_stdin_line from io
include vir.rt.vec_rt
import vec_new_rt, vec_len_rt, vec_cap_rt, vec_push_rt, vec_get_rt, vec_set_rt from vec_rt
include vir.rt.vec
import vec_new, vec_push from vec

func main:
    print_ln("Testing hang...")
    let v = vec_new_rt()
    print_ln("vec_new_rt done.")
    
    let len = vec_len_rt(v)
    print_ln("vec_len_rt done.")
    
    let sb = sb_new()
    print_ln("sb_new done.")
    
    sb = sb_append_int(sb, len)
    print_ln("sb_append_int done.")
    
    print_ln(sb_to_string(sb))
    print_ln("Success!")
end
