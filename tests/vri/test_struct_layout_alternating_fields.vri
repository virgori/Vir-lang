# Regression Test: Struct layout alternating int and string fields
# Protection: Bug 3 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Alternating int and string fields maintain consistent
#   8-byte natural alignment and offsets without adjacent memory clobbering.

entity MixedPacket:
    seq: int
    header: string
    code: int
    payload: string
    checksum: int
end.

func main:
    var p: MixedPacket = MixedPacket(seq: 1, header: "SYN", code: 200, payload: "DATA_BODY", checksum: 9999)
    print p.seq
    print_str(p.header)
    print p.code
    print_str(p.payload)
    print p.checksum
    out 0
end.

