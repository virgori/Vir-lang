include compiler.mir
import MirBuilder, mir_create_func, mir_intern_string from compiler.mir
import print_i64 from compiler.context
func main:
    let f = mir_create_func(0)
    let f1, id1 = mir_intern_string(f, "main")
    let f2, id2 = mir_intern_string(f1, "alloc")
    print_i64(id1)
    print_i64(id2)
end.
