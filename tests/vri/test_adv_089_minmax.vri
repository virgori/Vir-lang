# test_adv_089: Array min/max finding
# Expected: 1, 99

func main:
    var arr = arr_new(16)
    push(arr, 42)
    push(arr, 17)
    push(arr, 99)
    push(arr, 3)
    push(arr, 1)
    push(arr, 55)

    var n = len(arr)
    var mn = arr[0]
    var mx = arr[0]
    var i = 1
    when i < n loop
        if arr[i] < mn do
            mn = arr[i]
        end
        if arr[i] > mx do
            mx = arr[i]
        end
        i = i + 1
    end
    print mn
    print mx
end.
