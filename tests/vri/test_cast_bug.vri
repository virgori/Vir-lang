# EXPECT_START
# Ret is:
# 12884934672
# t1 is:
# 4333391644
# 111
# t2 is:
# 4333391652
# 222
# EXPECT_END
entity Test:
    name: string
    val: int
end.

func fake_push(v: int, val: int):
    out val
end.

func main:
    var t1 = Test(name: "t1_name", val: 111)
    var t2 = Test(name: "t2_name", val: 222)
    
    # Pass t2 to fake_push, which expects an int!
    var ret = fake_push(0, t2)
    
    print "Ret is:"
    print ret
    
    print "t1 is:"
    print t1.name
    print t1.val
    
    print "t2 is:"
    print t2.name
    print t2.val
    out 0
end.
