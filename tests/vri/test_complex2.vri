entity Token:
    kind: int
    value: int
end.

func classify(t: Token) -> int:
    var result = 0
    if t.kind == 1: do
        result = t.value + 100
    eif t.kind == 2: do
        result = t.value + 200
    else
        result = t.value
    end
    out result
end.

func main():
    var t1 = Token( kind: 1, value: 10 )
    var t2 = Token( kind: 2, value: 20 )
    var t3 = Token( kind: 3, value: 30 )
    print classify(t1)
    print classify(t2)
    print classify(t3)
end.
