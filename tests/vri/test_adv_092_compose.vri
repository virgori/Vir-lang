# test_adv_092: Higher-order function composition
# Expected: 25

func square(x):
    out x * x
end.

func inc(x):
    out x + 1
end.

func compose(f, g, x):
    var mid = g(x)
    out f(mid)
end.

func main:
    # compose(square, inc, 4) = square(inc(4)) = square(5) = 25
    var r = compose(square, inc, 4)
    print r
end.
