module test_alloc
include alloc; import vir_alloc from alloc
include io; import print_ln from io

func main:
    let buf = vir_alloc(24)
    let tmp = vir_alloc(24)
    
    # We can't print pointers as integers easily using print_int because it's broken!
    # Wait, print_int uses rt_itoa which is broken.
    # Let's do it manually!
    
    extern func native_write_u8(addr: int, offset: int, val: int)
    
    native_write_u8(buf, 0, 65); # A
    native_write_u8(tmp, 0, 66); # B
    native_write_u8(buf, 1, 0)
    native_write_u8(tmp, 1, 0)
    
    print_ln(buf)
    print_ln(tmp)
    print_ln(buf)
    out 0
end
