# §17 Precomp / Comptime — prefix modifier, lowest precedence
var a = precomp 2 + 3 * 5            # → precomp(2 + 3*5) = 17
var b = comptime 10 * 4              # → 40
var c = precomp 1 shl 8              # → 256
var d = precomp (100 - 4) / 8        # grouped via parens = 12

@entry
func main:
    print a
    print b
    print c
    print d
end.
