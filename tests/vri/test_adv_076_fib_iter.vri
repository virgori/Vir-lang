# test_adv_076: Fibonacci iterative (big numbers)
# Expected: 832040

func fib_iter(n):
    if n <= 0 do
        out 0
    end
    if n == 1 do
        out 1
    end
    var a = 0
    var b = 1
    var i = 2
    when i <= n loop
        var c = a + b
        a = b
        b = c
        i = i + 1
    end
    out b
end.

func main:
    var r = fib_iter(30)
    print r
end.
