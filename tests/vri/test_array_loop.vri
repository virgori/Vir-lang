func sum_arr(a, n):
    var total = 0
    var i = 0
    when i < n loop
        total = total + a[i]
        i = i + 1
    end
    out total
end.

func main:
    var arr = arr_new(16)
    var i = 0
    when i < 10 loop
        push(arr, i * i)
        i = i + 1
    end
    print len(arr)
    print arr[0]
    print arr[3]
    print arr[9]
    var s = sum_arr(arr, 10)
    print s
end.
