entity Test:
    a: int
    b: int
    c: int
    d: int
    e: int
    f: int
    g: int
    h: int
    i: int
    j: int
    k: int
end.

func main:
    var t1 = Test(
        a: 1,
        b: 2,
        c: 3,
        d: 4,
        e: 5,
        f: 6,
        g: 7,
        h: 8,
        i: 9,
        j: 10,
        k: 11
    )
    print t1.a
    print t1.b
    print t1.j
    print t1.k
    out 0
end.
