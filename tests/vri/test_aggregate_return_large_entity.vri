# Regression Test: Aggregate return with large entity (> 4 fields, strings + ints)
# Protection: Bug 2 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Large struct return across calling convention buffer preserves all 6 fields.

entity ServiceEndpoint:
    id: int
    name: string
    ip: string
    port_num: int
    protocol: string
    is_active: int
end.

func make_endpoint(i: int, n: string, ip: string, p: int, proto: string, a: int) -> ServiceEndpoint:
    out ServiceEndpoint(id: i, name: n, ip: ip, port_num: p, protocol: proto, is_active: a)
end.

func main:
    var ep: ServiceEndpoint = make_endpoint(101, "gateway", "192.168.1.1", 443, "https", 1)
    print ep.id
    print_str(ep.name)
    print_str(ep.ip)
    print ep.port_num
    print_str(ep.protocol)
    print ep.is_active
    out 0
end.
