# Test advanced operators end-to-end
var g = 10

func main:
    # atomic_cas success: g==10, swap to 42, returns old (10)
    var old1 = atomic_cas(0, 10, 42)
    print old1
    print g

    # atomic_cas failure: expected 99, no swap, returns 42
    var old2 = atomic_cas(0, 99, 7)
    print old2
    print g

    atomic_fence()

    # flux_dot
    var a = [1, 2, 3, 4]
    var b = [10, 20, 30, 40]
    print flux_dot(a, b)

    # flux_norm sqrt(9+16) = 5
    var c = [3, 4]
    print flux_norm(c)

    # flux_norm sqrt(1+4+4) = 3
    var d = [1, 2, 2]
    print flux_norm(d)

    # tensor_sum
    var e = [5, 10, 15, 20]
    print tensor_sum(e)

    # swizzle write-mask
    var z = [1, 2, 3, 4]
    var src = [99, 88]
    z~xy = src
    print z[0]
    print z[1]
    print z[2]
    print z[3]

    # swizzle-read
    var r = [10, 20, 30, 40]
    var rev = r~zyx
    print rev[0]
    print rev[1]
    print rev[2]
end.
