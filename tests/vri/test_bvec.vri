include stdlib.vir.rt.io
include stdlib.vir.rt.vec_rt
include stdlib.vir.rt.string_rt

import write_file_bytes from stdlib.vir.rt.io
import bvec_new, bvec_push_u32_le, bvec_len, bvec_data_ptr from stdlib.vir.rt.vec_rt
import print_ln from stdlib.vir.rt.string_rt

func main:
    let v = bvec_new()
    v = bvec_push_u32_le(v, 0xFEEDFACF)
    let len = bvec_len(v)
    let data = bvec_data_ptr(v)
    write_file_bytes("test.bin", data, len, 0o755)
    print_ln("Done!")
end
