# test_adv_096: Sum of digits (digit extraction via modulo)
# Expected: 15

func sum_digits(n):
    var sum = 0
    when n > 0 loop
        sum = sum + n % 10
        n = n / 10
    end
    out sum
end.

func main:
    # sum_digits(12345) = 1+2+3+4+5 = 15
    var r = sum_digits(12345)
    print r
end.
