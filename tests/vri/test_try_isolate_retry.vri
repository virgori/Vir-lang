# §13.7 try(isolate:) + resume retry — result rolled back per attempt
func main:
    var attempts = 0
    var result = 0
    try(isolate: [result]):
        attempts = attempts + 1
        result = 999
        if attempts < 3:
            throw 1
        end
        result = 777
    revert
        if attempts < 3:
            resume retry
        end
    end
    print attempts
    print result
end.
