module test_modulo_op
include alloc; import vir_alloc from alloc
include io; import print_ln from io

func main:
    let buf = vir_alloc(10)
    extern func native_write_u8(addr: int, offset: int, val: int)

    let a1 = 51
    let b1 = 10
    let c1 = a1 % b1
    native_write_u8(buf, 0, c1)

    let a2 = 51
    let b2 = 20
    let c2 = a2 % b2
    native_write_u8(buf, 1, c2)

    let a3 = 3
    let b3 = 10
    let c3 = a3 % b3
    native_write_u8(buf, 2, c3)

    native_write_u8(buf, 3, 0)
    print_ln(buf)
    out 0
end
