# EXPECT_START
# 1
# 99
# 99
# EXPECT_END
# 1
# 99
# 99
# test_adv_046: Entity field mutation and reread
# Expected: 1, 99, 99

entity Box:
    val
end.

func main:
    var b = Box(val: 1)
    print b.val
    b.val = 99
    print b.val
    # Read again to ensure stable
    var v = b.val
    print v
end.
