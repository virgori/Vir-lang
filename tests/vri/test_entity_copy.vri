entity Test:
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int
end.

func update_test(t: Test, new_f: int):
    t.f = new_f
    out t
end.

func main:
    var t = Test (
        a: 111,
        b: 222,
        c: 333,
        d: 444,
        e: 555,
        f: 666
    )
    print t.a
    print t.f

    t = update_test(t, 999)

    print t.a
    print t.f

    t.f = 1000
    print t.a
    print t.f

    out 0
end.
