include "stdlib/vir/core/vir_core.vri"
include "stdlib/vir/rt/vec_rt.vri"

enum TokType:
    Ident = 1
end.

entity Token:
    tok_type:   TokType,
    line:       int,
    col:        int,
    str_val:    string,
    int_val:    int,
    float_val:  float
end.

func main:
    var tokens = vec_new_rt()
    var t1 = Token(tok_type: TokType.Ident, line: 1, col: 2, str_val: "hello_vec1", int_val: 0, float_val: 0.0)
    var t2 = Token(tok_type: TokType.Ident, line: 3, col: 4, str_val: "hello_vec2", int_val: 0, float_val: 0.0)
    
    # Push pointers to t1 and t2
    tokens = vec_push_rt(tokens, t1 as int)
    tokens = vec_push_rt(tokens, t2 as int)
    
    # Overwrite the stack frame where t1 and t2 might be?
    # Actually they are local variables in main, so their stack frame is still alive!
    # Wait, if they are alive, they should be correct!
    
    var out_tok = vec_get_rt(tokens, 0) as Token
    
    print "First token str_val:"
    print out_tok.str_val
    out 0
end.
