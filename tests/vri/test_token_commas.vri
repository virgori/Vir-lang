enum TokType:
    Ident = 1
end.

entity Token:
    tok_type:   TokType,
    line:       int,
    col:        int,
    str_val:    string,
    int_val:    int,
    float_val:  float
end.

func main:
    var t = Token(tok_type: TokType.Ident, line: 1, col: 2, str_val: "hello_comma", int_val: 0, float_val: 0.0)
    print t.str_val
    out 0
end.
