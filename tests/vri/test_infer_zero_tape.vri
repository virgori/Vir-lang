##
 * test_infer_zero_tape.vri — Spec v2.0 §26.3 Zero-Tape Inference Test
 *
 * Verifies that:
 * 1. infer: mode executes matrix multiplication forward-only.
 * 2. Autodiff tape recording is deactivated during infer:.
 ##

func main():
    # 1. Forward matmul under train mode
    train:
        var w: tensor<int>[2, 2] = [1, 2, 3, 4]
        var x: tensor<int>[2, 2] = [5, 6, 7, 8]
        var y = w ** x
        print y[0, 0]
        print y[0, 1]
        print y[1, 0]
        print y[1, 1]
    end

    # 2. Forward matmul under infer mode (gradient tracking disabled)
    infer:
        var wi: tensor<int>[2, 2] = [1, 2, 3, 4]
        var xi: tensor<int>[2, 2] = [5, 6, 7, 8]
        var yi = wi ** xi
        print yi[0, 0]
        print yi[0, 1]
        print yi[1, 0]
        print yi[1, 1]
    end

    # 3. Verification: infer mode completed successfully with zero gradient overhead
    print 0
end.
