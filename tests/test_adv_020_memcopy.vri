# test_adv_020: Memory copy manual implementation
# Expected: 10, 20, 30, 40

func main:
    # Source buffer
    var src = alloc(32)
    write_word(src, 0, 10)
    write_word(src, 8, 20)
    write_word(src, 16, 30)
    write_word(src, 24, 40)

    # Dest buffer - manual word-by-word copy
    var dst = alloc(32)
    var v0 = read_word(src, 0)
    var v1 = read_word(src, 8)
    var v2 = read_word(src, 16)
    var v3 = read_word(src, 24)
    write_word(dst, 0, v0)
    write_word(dst, 8, v1)
    write_word(dst, 16, v2)
    write_word(dst, 24, v3)

    print read_word(dst, 0)
    print read_word(dst, 8)
    print read_word(dst, 16)
    print read_word(dst, 24)
end.