# test_adv_091: Heap-allocated tree traversal (binary tree)
# Each node: [value:8][left:8][right:8] = 24 bytes
# Expected: 1, 2, 3, 4, 5, 6, 7

func make_node:
    in(val, left, right)
    var n = alloc(24)
    write_word(n, 0, val)
    write_word(n, 8, left)
    write_word(n, 16, right)
    out n
end.
func inorder:
    in(node)
    if node == 0 do
        out 0
    end
    var left = read_word(node, 8)
    inorder(left)
    var val = read_word(node, 0)
    print val
    var right = read_word(node, 16)
    inorder(right)
end.
func main:
    # Build tree:       4
    #                 /   \
    #                2     6
    #               / \   / \
    #              1   3 5   7
    var n1 = make_node(1, 0, 0)
    var n3 = make_node(3, 0, 0)
    var n5 = make_node(5, 0, 0)
    var n7 = make_node(7, 0, 0)
    var n2 = make_node(2, n1, n3)
    var n6 = make_node(6, n5, n7)
    var root = make_node(4, n2, n6)
    # In-order traversal should print: 1 2 3 4 5 6 7
    # Wait, in-order visits left first, so: left->root->right
    # For root=4: inorder(2), print 4, inorder(6)
    # inorder(2): inorder(1), print 2, inorder(3) → 1,2,3
    # inorder(6): inorder(5), print 6, inorder(7) → 5,6,7
    # Full: 1,2,3,4,5,6,7
    inorder(root)
end.
