# Test: Type annotations on variables and functions (Phase 9)
# Expected output: 42,100,3,hello

func add(a: i32, b: i32) -> i32:
    out a + b
end.
func main:
    var x: i64 = 42
    print x

    var y: u32 = 100
    print y

    var z: int = add(1, 2)
    print z

    var s: string = "hello"
    print s
end.