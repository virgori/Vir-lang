# §13.7 try(timeout:) — deadline fires → erx=2, revert runs
func main:
    var ticks = 0
    var outcome = 0
    try(timeout: 1):
        loop:
            ticks = ticks + 1
            if ticks > 100000000:
                break
            end
        end
    revert
        outcome = erx
    end
    print outcome
end.