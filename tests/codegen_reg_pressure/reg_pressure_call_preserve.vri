# Register pressure preserved across external call
func mutate(n):
    out n * 3 + 7
end.

func main:
    var x01 = 10
    var x02 = 20
    var x03 = 30
    var x04 = 40
    var x05 = 50
    var x06 = 60
    var x07 = 70
    var x08 = 80
    var x09 = 90
    var x10 = 100
    var x11 = 110
    var x12 = 120
    var res = mutate(5)
    var total = x01 + x02 + x03 + x04 + x05 + x06 + x07 + x08 + x09 + x10 + x11 + x12 + res
    print total
    out 0
end.
