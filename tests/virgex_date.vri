# virgex_date.vri — VPS date pattern test (self-contained)
# Tests: YYYY-MM-DD format
# Pattern: | @0!4 $- @0!2 $- @0!2 |

extern func native_read_u8(addr: int, offset: int) -> int;

func rt_strlen:
    in(s: int)
    if s == 0 do out 0; end
    let i = 0;
    when native_read_u8(s, i) != 0 loop
        i = i + 1;
    end.
    out i;
end.
func is_digit:
    in(b: int)
    out b >= 48 and b <= 57;
end.
# Match date format: YYYY-MM-DD (exactly 10 chars)
func match_date:
    in(s: int)
    let slen = rt_strlen(s);
    if slen != 10 do out false; end

    # YYYY: positions 0-3 must be digits
    let i = 0;
    when i < 4 loop
        if not is_digit(native_read_u8(s, i)) do out false; end
        i = i + 1;
    end.

    # position 4 must be '-'
    if native_read_u8(s, 4) != 0x2D do out false; end

    # MM: positions 5-6 must be digits
    if not is_digit(native_read_u8(s, 5)) do out false; end
    if not is_digit(native_read_u8(s, 6)) do out false; end

    # position 7 must be '-'
    if native_read_u8(s, 7) != 0x2D do out false; end

    # DD: positions 8-9 must be digits
    if not is_digit(native_read_u8(s, 8)) do out false; end
    if not is_digit(native_read_u8(s, 9)) do out false; end

    out true;
end.
func main:
    let pattern_desc = "| @0!4 $- @0!2 $- @0!2 |"
    print "Pattern: $pattern_desc"

    var dates = [
        "2026-05-16",
        "1990-01-01",
        "26-05-16",
        "2026/05/16",
        "2026-5-16"
    ]

    var i = 0
    let count = len(dates)
    when i < count loop
        let d = dates[i]
        case match_date(d)
            true: print "✅ $d";
            false: print "❌ $d"
        end.
        i = i + 1
    end.
end.