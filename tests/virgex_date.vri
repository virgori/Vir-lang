# EXPECT_START
# Pattern: | @0!4 $- @0!2 $- @0!2 |
#     2026-05-16
#     1990-01-01
#     26-05-16
#     2026/05/16
#     2026-5-16
# EXPECT_END
# virgex_date.vri -- VPS date pattern test (self-contained)
# Tests: YYYY-MM-DD format
# Pattern: | @0!4 $- @0!2 $- @0!2 |

func is_digit(b: int):
    if b >= 48 do
        if b <= 57 do
            out true
        end
    end
    out false
end.

# Match date format: YYYY-MM-DD (exactly 10 chars)
func match_date(s: string):
    let slen = str_len(s)
    if slen != 10 do out false; end

    # YYYY: positions 0-3 must be digits
    var i = 0
    when i < 4 loop
        if !is_digit(str_get(s, i)) do out false; end
        i = i + 1
    end

    # position 4 must be '-'
    if str_get(s, 4) != 45 do out false; end

    # MM: positions 5-6 must be digits
    if !is_digit(str_get(s, 5)) do out false; end
    if !is_digit(str_get(s, 6)) do out false; end

    # position 7 must be '-'
    if str_get(s, 7) != 45 do out false; end

    # DD: positions 8-9 must be digits
    if !is_digit(str_get(s, 8)) do out false; end
    if !is_digit(str_get(s, 9)) do out false; end

    out true
end.
func main:
    print "Pattern: | @0!4 $- @0!2 $- @0!2 |"

    var dates = [
        "2026-05-16",
        "1990-01-01",
        "26-05-16",
        "2026/05/16",
        "2026-5-16"
    ]

    var i = 0
    let count = len(dates)
    when i < count loop
        var d = dates[i]
        if match_date(d) do
            print "    $d"
        else
            print "    $d"
        end
        i = i + 1
    end
end.
