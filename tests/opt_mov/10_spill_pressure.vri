func heavy_pressure(a: int) -> int:
    let v1 = a + 1
    let v2 = a + 2
    let v3 = a + 3
    let v4 = a + 4
    let v5 = a + 5
    let v6 = a + 6
    let v7 = a + 7
    let v8 = a + 8
    let v9 = a + 9
    let v10 = a + 10
    out v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10
end.
func main:
    print heavy_pressure(0)
end.
