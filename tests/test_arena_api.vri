func main:
    var a: ptr = arena_new(64)
    var p1: ptr = arena_alloc(a, 8)
    write_word(p1, 0, 123)
    print read_word(p1, 0)

    print arena_used(a)
    arena_reset(a)
    print arena_used(a)

    var p2: ptr = arena_alloc(a, 8)
    write_word(p2, 0, 456)
    print read_word(p2, 0)

    arena_free(a)
end.
