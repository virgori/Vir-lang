# Test §14 ref pass-by-reference + §16 register/mold/volatile/bit_get/bit_set

# --- globals (lowered in __vir_init__) ---
var g_counter = 0
var g_pair_a = 10
var g_pair_b = 20

# --- §16 register/mold declarations ---
register StatusReg: u32
    enable: 1,
    mode: 3,
    priority: 4,
    reserved: 24
end.
mold ColorPixel: u16
    r: 5,
    g: 6,
    b: 5
end.
# --- functions using ref ---
func inc: ref(x: int)
    x = x + 1
end.
func add_to(delta: int): ref(x: int)
    x = x + delta
end.
func swap: ref(a: int; b: int)
    var tmp = a
    a = b
    b = tmp
end.
func main:
    # --- ref param increments a global in place ---
    inc(g_counter)
    inc(g_counter)
    inc(g_counter)
    print g_counter        # 3

    add_to(10, g_counter)
    print g_counter        # 13

    # --- ref param swap ---
    swap(g_pair_a, g_pair_b)
    print g_pair_a         # 20
    print g_pair_b         # 10

    # --- §16 bit_get / bit_set as pure intrinsics ---
    # word = 0xDEADBEEF; get bits [3:0]
    var w = 3735928559
    var nib = bit_get(w, 0, 4)
    print nib              # 15

    # bit_set: clear lower nibble, write 0x5
    var w2 = bit_set(w, 0, 4, 5)
    print bit_get(w2, 0, 4)   # 5
    print bit_get(w2, 4, 4)   # 14 (0xE retained)

    # --- §16.5 volatile_read / volatile_write via alloc cell ---
    var cell = alloc(8)
    volatile_write(cell, 12345)
    print volatile_read(cell)  # 12345
    volatile_write(cell, 67890)
    print volatile_read(cell)  # 67890
    dealloc(cell)

    # --- §16 register/mold field access ---
    var reg: StatusReg = 0
    reg.enable = 1
    reg.mode = 5
    reg.priority = 9
    print reg.enable       # 1
    print reg.mode         # 5
    print reg.priority     # 9

    var px: ColorPixel = 0
    px.r = 31
    px.g = 63
    px.b = 17
    print px.r             # 31
    print px.g             # 63
    print px.b             # 17
end.