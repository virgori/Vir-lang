func double:
    in(val)
    out val * 2
end.
func add_n:
    in(val, n)
    out val + n
end.
func mul_then_add:
    in(val, m, n)
    out val * m + n
end.
func main:
    var x = 10
    var a = x.double()
    var b = x.add_n(5)
    var c = x.mul_then_add(3, 7)
    print a
    print b
    print c
end.