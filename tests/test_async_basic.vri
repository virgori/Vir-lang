# Test: Async function definitions, task, wait (Phase 9)
# Expected output: 10,20,30
# Note: async is lowered as regular sync for now (stub runtime)

async func compute(n: int) -> int:
    out n * 10
end.
func main:
    var t1 = task compute(1)
    var t2 = task compute(2)
    var t3 = task compute(3)

    var r1 = wait t1
    var r2 = wait t2
    var r3 = wait t3

    print r1
    print r2
    print r3
end.