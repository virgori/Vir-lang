# §4.8 NLL — borrow lives ACROSS statements (was broken in per-stmt model)
func take2:
    in(p, q)
    out p + q
end.
func main:
    var a = [1, 2, 3]
    var b = &a              # persistent shared borrow of 'a'
    var r = take2(&a, &mut a)   # ERROR: &mut a while b still holds shared
    print r
end.
