# CONTRACT: MEM-BOR-EDGE-011
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.
func inspect(b: &Box): print b.val end.
func run(which: int):
    var fallback = Box(val: 11)
    var holder = &fallback
    case which
        1:
            var inner = Box(val: 110)
            holder = &inner
        else holder = &fallback
    end
    inspect(holder)
end.
func main: run(1) end.
