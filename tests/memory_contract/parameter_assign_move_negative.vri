# Negative test: Assigning an owned parameter to a local variable moves it,
# invalidating the parameter binding and causing E5001 on subsequent use.
# EXPECT_DIAGNOSTIC: E5001

entity Item:
    val: int
end.

func process(it: Item):
    let local_it = it
    print it.val
end.

func main():
    let it = Item(val: 42)
    process(it)
end.
