# CONTRACT: MEM-BOR-CFG-010
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func main:
    var a = Box(val: 10)
    var b = Box(val: 20)
    var holder = &b
    var i = 0
    when i < 2 loop
        if i == 0 do holder = &a else holder = &b end
        i = i + 1
    end
    consume(a)
    inspect(holder)
end.
