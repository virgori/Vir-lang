# CONTRACT: MEM-BOR-INIT-003
# EXPECT_COMPILE_FAIL: E5013
# EXPECT_DIAGNOSTIC: E5013
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func run(cond: int):
    var b = Box(val: 10)
    var refHolder: &Box
    if cond == 1 do
        refHolder = &b
    end
    inspect(refHolder)
end.

func main:
    run(1)
end.
