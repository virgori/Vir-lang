# CONTRACT: MEM-BOR-LOOP-010
# EXPECT_COMPILE_FAIL: E5001
# EXPECT_DIAGNOSTIC: E5001
entity Box:
    val: int
end.

func consume(b: Box):
    print b.val
end.

func main:
    var a = Box(val: 10)
    var i = 0
    when i < 2 loop
        if i == 0 do
            consume(a)
        end
        i = i + 1
    end
end.
