# CONTRACT: MEM-BOR-IDX-001
# EXPECT_COMPILE_FAIL: E5008
# EXPECT_DIAGNOSTIC: E5008
entity Box:
    val: int
end.

func consume(v: [Box]):
    print v[0].val
end.

func inspect(r: &Box):
    print r.val
end.

func main:
    var values = [Box(val: 10), Box(val: 20)]
    var elementRef = &values[0]
    consume(values)
    inspect(elementRef)
end.
