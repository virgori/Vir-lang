# CONTRACT: MEM-BOR-CFG-009
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.
func inspect(b: &Box): print b.val end.
func run(flag: int):
    var fallback = Box(val: 9)
    var holder = &fallback
    if flag == 1 do
        var inner = Box(val: 90)
        holder = &inner
    end
    inspect(holder)
end.
func main: run(1) end.
