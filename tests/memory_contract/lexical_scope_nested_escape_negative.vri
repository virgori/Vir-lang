# CONTRACT: MEM-BOR-SCOPE-002
# EXPECT_COMPILE_FAIL: E5012
# EXPECT_DIAGNOSTIC: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var outer = Box(val: 10)
    var refHolder = &outer
    if 1 == 1 do
        if 2 == 2 do
            var deep = Box(val: 77)
            refHolder = &deep
        end
    end
    inspect(refHolder)
end.
