# CONTRACT: MEM-BOR-LOOP-011
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.

func consume(b: Box):
    print b.val
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var a = Box(val: 11)
    var holder = &a
    loop 2:
        inspect(holder)
        consume(a)
    end
end.
