include types
include alloc
include mem.copy
import mem_copy, mem_set from mem.copy

func main:
    let src = alloc(128)
    let dst = alloc(128)
    mem_set(dst, 42, 128)
    mem_set(src, 255, 73)
    native_write_u8(src as int, 72, 99)
    mem_copy(dst, src, 73)

    let d = dst as int
    let ok_head = native_read_u8(d, 0) == 255 and native_read_u8(d, 15) == 255 and native_read_u8(d, 63) == 255
    if ok_head do
        print 1
    else
        print 0
    end
    print native_read_u8(d, 64)
    print native_read_u8(d, 72)
    print native_read_u8(d, 73)
    free(src)
    free(dst)
    out 0
end.
