# CONTRACT: MEM-PROMOTE-DEEP-001
# EXPECT: 42

entity ChildNode:
    id: int
    tag: int
end.

entity ComplexGraph:
    tag: int
    values: [int]
    child: ChildNode
    code: int
    payload: int
end.

func main:
    var escaped = ComplexGraph(
        tag: 0,
        values: [0, 0, 0, 0, 0, 0, 0, 0],
        child: ChildNode(id: 0, tag: 0),
        code: 0,
        payload: 0
    )
    var escaped_str = "init"
    var escaped_dict = ["init": 0]

    arena:
        let arr = [101, 102, 103, 104, 105, 106, 107, 108]
        let child = ChildNode(id: 777, tag: 888)
        let local_graph = ComplexGraph(
            tag: 12345,
            values: arr,
            child: child,
            code: 42,
            payload: 99
        )
        let local_str = "simd_promotion_payload_exceeding_thirty_two_bytes_string_ok"
        let local_dict = ["alpha": 100, "beta": 200]

        escaped = local_graph
        escaped_str = local_str
        escaped_dict = local_dict
    end

    # Clobber arena with distinct sentinel values so a dangling read surfaces any bug
    arena:
        var clobber1 = [999, 999, 999, 999, 999, 999, 999, 999]
        var clobber2 = "overwritten_overwritten_overwritten_overwritten_watermark!"
        var clobber3 = ["alpha": 0, "beta": 0]
        # Force clobber writes visible to optimizer
        if clobber1[0] == 0 do print 0 end
        if clobber2.len == 0 do print 0 end
        if clobber3["alpha"] == 1 do print 0 end
    end

    if escaped.tag != 12345 do
        print 101
        out 1
    end

    if escaped.values[0] != 101 or escaped.values[7] != 108 do
        print 102
        out 1
    end

    if escaped.child.id != 777 or escaped.child.tag != 888 do
        print 103
        out 1
    end

    if escaped_dict["alpha"] != 100 or escaped_dict["beta"] != 200 do
        print 104
        out 1
    end

    # Check string length (> 32 means payload was promoted, not truncated to "init".len=4)
    if escaped_str.len <= 32 do
        print 105
        out 1
    end

    # Check struct field after child pointer (exercises full struct layout promotion)
    if escaped.payload != 99 do
        print 106
        out 1
    end

    print escaped.code
    out 0
end.
