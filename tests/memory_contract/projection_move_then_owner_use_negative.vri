# CONTRACT: MEM-BOR-027
# EXPECT_COMPILE_FAIL: E5001
# EXPECT_DIAGNOSTIC: E5001

entity Box:
    val: int
end.

entity Holder:
    child: Box
end.

func consume_box(value: Box):
    print value.val
end.

func consume_holder(value: Holder):
    print value.child.val
end.

func main:
    var owner = Holder(child: Box(val: 27))
    consume_box(owner.child)
    consume_holder(owner)
end.
