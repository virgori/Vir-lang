# CONTRACT: MEM-BOR-CFG-POS-002
# EXPECT_START
# 3
# 1
# 2
# EXPECT_END
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(flag: int):
    var a = Box(val: 1)
    var b = Box(val: 2)
    var c = Box(val: 3)
    var holder = &c
    if flag == 1 do holder = &a else holder = &b end
    holder = &c
    inspect(holder)
    consume(a)
    consume(b)
end.
func main: run(1) end.
