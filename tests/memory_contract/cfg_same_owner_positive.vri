entity Box:
    val: int
end.
func inspect(b: &Box): print b.val end.
func run(flag: int):
    var a = Box(val: 4)
    var holder = &a
    if flag == 1 do holder = &a else holder = &a end
    inspect(holder)
end.
func main: run(1) end.
