# CONTRACT: MEM-BOR-EDGE-009
# EXPECT_START
# 9
# EXPECT_END
entity Box:
    val: int
end.
func choose(left: &Box, right: &Box, flag: int) -> &Box:
    if flag == 1 do out left else out right end
end.
func main:
    var left = Box(val: 9)
    var right = Box(val: 90)
    let chosen = choose(&left, &right, 1)
    print chosen.val
end.
