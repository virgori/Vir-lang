# CONTRACT: MEM-BOR-CFG-007
# EXPECT_START
# 10
# 30
# EXPECT_END
entity Box:
    val: int
end.

func consume(box: Box):
    print box.val
end.

func inspect(boxRef: &Box):
    print boxRef.val
end.

func run(cond: int):
    var a = Box(val: 10)
    var b = Box(val: 20)
    var c = Box(val: 30)
    var holder = &a

    if cond == 1 do
        holder = &a
    else
        holder = &b
    end

    holder = &c
    consume(a)
    inspect(holder)
end.

func main:
    run(1)
end.
