# Exceed the former 2048-segment limit without allocating multi-gigabyte heaps.
import heap_init, heap_destroy, tlsf_seg_add, tlsf_seg_count, tlsf_seg_find, page_alloc, rt_page_size from alloc

func main:
    heap_init(1048576)
    let initial = tlsf_seg_count()
    let pageSize = rt_page_size()
    var first = 0
    var last = 0
    var index = 0
    when index < 4100 loop
        let segment = page_alloc(pageSize)
        if segment == 0 do print(-1) out end
        tlsf_seg_add(segment, pageSize)
        if index == 0 do first = segment end
        last = segment
        index = index + 1
    end
    print(tlsf_seg_count() - initial)
    print(tlsf_seg_find(first) >= 0)
    print(tlsf_seg_find(last) >= 0)
    print(tlsf_seg_find(1))
    heap_destroy()
    heap_init(1048576)
    print(tlsf_seg_count())
end.
