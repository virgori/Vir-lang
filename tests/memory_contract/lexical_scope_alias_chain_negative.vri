# CONTRACT: MEM-BOR-SCOPE-003
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var fallback = Box(val: 1)
    var outer = &fallback
    if 1 == 1 do
        var inner = Box(val: 3)
        var innerRef = &inner
        outer = innerRef
    end
    inspect(outer)
end.
