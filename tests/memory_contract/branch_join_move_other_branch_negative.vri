# CONTRACT: MEM-BOR-CFG-002
# EXPECT_COMPILE_FAIL: E5008
# EXPECT_DIAGNOSTIC: E5008
entity Box:
    val: int
end.

func consume(box: Box):
    print box.val
end.

func inspect(boxRef: &Box):
    print boxRef.val
end.

func run(cond: int):
    var a = Box(val: 10)
    var b = Box(val: 20)
    var holder = &a

    if cond == 1 do
        holder = &a
    else
        holder = &b
    end

    consume(b)
    inspect(holder)
end.

func main:
    run(1)
end.
