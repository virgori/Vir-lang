# CONTRACT: MEM-BOR-SCOPE-006
# EXPECT_START
# 10
# 20
# EXPECT_END
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    if 1 == 1 do
        var a = Box(val: 10)
        let r = &a
        inspect(r)
    end
    if 1 == 1 do
        var b = Box(val: 20)
        let r2 = &b
        inspect(r2)
    end
end.
