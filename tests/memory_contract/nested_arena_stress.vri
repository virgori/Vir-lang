# CONTRACT: MEM-STRESS-001
# EXPECT: 2000
func main:
    var iteration = 0
    var verified = 0
    when iteration < 2000 loop
        arena:
            var outer = alloc(4096)
            arena:
                var middle = alloc(4096)
                arena:
                    var inner = alloc(4096)
                    write_word(outer, 0, iteration)
                    write_word(middle, 0, iteration + 1)
                    write_word(inner, 0, iteration + 2)
                    if read_word(outer, 0) + 2 == read_word(inner, 0) do
                        verified = verified + 1
                    end
                end
            end
        end
        iteration = iteration + 1
    end
    print verified
end.
