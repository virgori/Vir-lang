# CONTRACT: MEM-BOR-SCOPE-005
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func run(flag: int):
    var fallback = Box(val: 5)
    var holder = &fallback
    if 1 == 1 do
        var inner = Box(val: 50)
        if flag == 1 do
            holder = &inner
        end
    end
    inspect(holder)
end.

func main:
    run(1)
end.
