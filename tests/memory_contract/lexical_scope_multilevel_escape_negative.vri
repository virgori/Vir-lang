# CONTRACT: MEM-BOR-SCOPE-007
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var fallback = Box(val: 7)
    var holder = &fallback
    if 1 == 1 do
        if 2 == 2 do
            var inner = Box(val: 70)
            holder = &inner
        end
    end
    inspect(holder)
end.
