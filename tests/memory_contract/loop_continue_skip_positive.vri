# CONTRACT: MEM-BOR-LOOP-POS-007
# EXPECT_START
# 10
# 20
# EXPECT_END
entity Box:
    val: int
end.

func consume(b: Box):
    print b.val
end.

func main:
    var a = Box(val: 10)
    var i = 0
    when i < 2 loop
        if i == 0 do
            consume(a)
            a = Box(val: 20)
            i = i + 1
            skip
        end
        consume(a)
        a = Box(val: 30)
        i = i + 1
    end
end.
