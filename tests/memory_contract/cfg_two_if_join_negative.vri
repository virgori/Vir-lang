# CONTRACT: MEM-BOR-CFG-003
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(first: int, second: int):
    var a = Box(val: 1)
    var b = Box(val: 2)
    var c = Box(val: 3)
    var holder = &c
    if first == 1 do holder = &a end
    if second == 1 do holder = &b end
    consume(a)
    inspect(holder)
end.
func main: run(1, 0) end.
