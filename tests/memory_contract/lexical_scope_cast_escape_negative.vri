# CONTRACT: MEM-BOR-SCOPE-008
# EXPECT_COMPILE_FAIL: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var fallback = Box(val: 8)
    var holder: &Box = &fallback
    if 1 == 1 do
        var inner = Box(val: 80)
        var rebound: &Box = &inner
        holder = rebound
    end
    inspect(holder)
end.
