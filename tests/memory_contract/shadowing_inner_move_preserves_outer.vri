# CONTRACT: MEM-BOR-021
# Positive test: Moving an inner shadowed variable does not invalidate
# the outer variable with the same name after block exit.
# EXPECT_START
# inner
# outer
# EXPECT_END

func consume(s: string):
    print s
end.

func main:
    var x = "outer"
    if 1 == 1 do
        var x = "inner"
        consume(x)
    end
    print x
end.
