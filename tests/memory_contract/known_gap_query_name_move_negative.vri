# Known gap: a callee name must not change by-value ownership semantics.
# The same call named `consume` is rejected, but `get_consume` currently
# bypasses the move checker. This fixture is intentionally outside the green
# manifest until the parameter ownership model is repaired.
# EXPECT_DIAGNOSTIC: E5001

func get_consume(s: string):
    print s
end.

func main():
    let s = "probe"
    get_consume(s)
    print s
end.
