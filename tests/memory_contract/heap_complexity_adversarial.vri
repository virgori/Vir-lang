# CONTRACT: MEM-HEAP-003
# EXPECT: 1
include rt.alloc
include rt.syscall
import vir_alloc, vir_free, heap_verify, heap_alloc, heap_free, heap_init, heap_get_inspect_count, heap_reset_inspect_count from rt.alloc
import sys_mmap from rt.syscall

func main:
    heap_init(16777216)
    let ptrs = sys_mmap(0, 1048576, 3, 0x1002, -1, 0)
    extern func native_write_i64(addr: int, offset: int, val: int)
    extern func native_read_i64(addr: int, offset: int) -> int

    var all_bounded = 1

    # Scale 1: 10 blocks (5 free)
    var i = 0
    when i < 10 loop
        let p = heap_alloc(32)
        native_write_i64(ptrs, i * 8, p)
        i = i + 1
    end
    i = 0
    when i < 10 loop
        heap_free(native_read_i64(ptrs, i * 8))
        i = i + 2
    end
    heap_reset_inspect_count()
    let b1 = heap_get_inspect_count()
    let p1 = heap_alloc(32)
    let step1 = heap_get_inspect_count() - b1
    if step1 > 8 do
        all_bounded = 0
    end
    heap_free(p1)

    # Scale 2: 1,000 blocks (500 free)
    i = 0
    when i < 1000 loop
        let p = heap_alloc(32 + (i mod 4) * 16)
        native_write_i64(ptrs, i * 8, p)
        i = i + 1
    end
    i = 0
    when i < 1000 loop
        heap_free(native_read_i64(ptrs, i * 8))
        i = i + 2
    end
    heap_reset_inspect_count()
    let b2 = heap_get_inspect_count()
    let p2 = heap_alloc(48)
    let step2 = heap_get_inspect_count() - b2
    if step2 > 8 do
        all_bounded = 0
    end
    heap_free(p2)

    # Scale 3: 100,000 blocks (50,000 free). This is deliberately large
    # enough to expose free-list or segment-registry scans hidden by smoke tests.
    i = 0
    when i < 100000 loop
        let p = heap_alloc(32)
        native_write_i64(ptrs, i * 8, p)
        i = i + 1
    end
    i = 0
    when i < 100000 loop
        heap_free(native_read_i64(ptrs, i * 8))
        i = i + 2
    end
    heap_reset_inspect_count()
    var max_step3 = 0
    i = 0
    when i < 50 loop
        let b = heap_get_inspect_count()
        let p = heap_alloc(32)
        let s = heap_get_inspect_count() - b
        if s > max_step3 do
            max_step3 = s
        end
        i = i + 1
    end
    if max_step3 > 8 do
        all_bounded = 0
    end

    if all_bounded == 1 and heap_verify() == 1 do
        print 1
    else
        print 0
    end
end.
