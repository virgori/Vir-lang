# CONTRACT: MEM-HEAP-003
# EXPECT: 1
include rt.alloc
include rt.syscall
import vir_alloc, vir_free, heap_verify, heap_alloc, heap_free, heap_init, heap_get_inspect_count, heap_reset_inspect_count from rt.alloc
import sys_mmap from rt.syscall

func main:
    heap_init(4194304)
    let ptrs = sys_mmap(0, 16384, 3, 0x1002, -1, 0)
    extern func native_write_i64(addr: int, offset: int, val: int)
    extern func native_read_i64(addr: int, offset: int) -> int

    # 1. Allocate 500 blocks of various sizes
    var i = 0
    when i < 500 loop
        let sz = 32 + (i mod 8) * 16
        let p = heap_alloc(sz)
        native_write_i64(ptrs, i * 8, p)
        i = i + 1
    end

    # 2. Free alternating blocks to heavily fragment the heap into 250 isolated free blocks
    i = 0
    when i < 500 loop
        let p = native_read_i64(ptrs, i * 8)
        heap_free(p)
        i = i + 2
    end

    # 3. Perform 50 allocations and measure worst-case inspection steps
    heap_reset_inspect_count()
    i = 0
    var max_inspect = 0
    when i < 50 loop
        let before = heap_get_inspect_count()
        let p = heap_alloc(48)
        let delta = heap_get_inspect_count() - before
        if delta > max_inspect do
            max_inspect = delta
        end
        i = i + 1
    end

    # Worst-case bitmap/bin inspection count must be bounded by constant (<= 4), independent of 250 fragmented blocks
    if max_inspect <= 4 and heap_verify() == 1 do
        print 1
    else
        print 0
    end
end.
