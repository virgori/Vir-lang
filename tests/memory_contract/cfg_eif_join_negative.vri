# CONTRACT: MEM-BOR-CFG-004
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(which: int):
    var a = Box(val: 1)
    var b = Box(val: 2)
    var c = Box(val: 3)
    var holder = &c
    if which == 1 do
        holder = &a
    eif which == 2 do
        holder = &b
    else
        holder = &c
    end
    consume(b)
    inspect(holder)
end.
func main: run(2) end.
