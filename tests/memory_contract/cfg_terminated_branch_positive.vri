# CONTRACT: MEM-BOR-CFG-POS-003
# EXPECT_START
# 3
# EXPECT_END
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func run(flag: int):
    var a = Box(val: 3)
    if flag == 1 do
        let holder = &a
        print holder.val
        out 0
    else
        print 0
    end
    consume(a)
    out 0
end.
func main: run(1) end.
