# CONTRACT: MEM-BOR-EDGE-014
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(flag: int):
    var a = Box(val: 1)
    var b = Box(val: 2)
    var c = Box(val: 3)
    var holder = &c
    if flag == 1 do holder = &a else holder = &b end
    holder = &c
    consume(c)
    inspect(holder)
end.
func main: run(1) end.
