# CONTRACT: MEM-OVERFLOW-001
# EXPECT: 42
include types
include alloc
include mem.arena
import Arena, arena_alloc, arena_reserve from mem.arena

func main:
    var a = Arena (
        base: alloc(4096),
        capacity: 4096,
        offset: 9223372036854775806
    )

    # 1. Test INT64_MAX - 1 (9223372036854775806)
    let p1 = a.arena_alloc(8)
    if p1 != null do
        print 101
        out 1
    end

    let p2 = a.arena_reserve(8, 8)
    if p2 != null do
        print 102
        out 1
    end

    let p3 = a.arena_reserve(8, 16)
    if p3 != null do
        print 103
        out 1
    end

    let p4 = a.arena_reserve(0, 8)
    if p4 != null do
        print 104
        out 1
    end

    # 2. Test near INT64_MAX (9223372036854775800)
    a.offset = 9223372036854775800
    let p5 = a.arena_alloc(8)
    if p5 != null do
        print 105
        out 1
    end

    # 3. Test INT64_MAX (9223372036854775807)
    a.offset = 9223372036854775807
    let p6 = a.arena_alloc(8)
    if p6 != null do
        print 106
        out 1
    end

    # 4. Test negative offset
    a.offset = 0 - 1
    let p7 = a.arena_alloc(8)
    if p7 != null do
        print 107
        out 1
    end

    # 5. Restore valid offset and allocate successfully
    a.offset = 0
    let p_valid = a.arena_alloc(64)
    if p_valid == null do
        print 108
        out 1
    end

    free(a.base)
    print 42
    out 0
end.
