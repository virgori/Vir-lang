# CONTRACT: MEM-OVERFLOW-001
# EXPECT: 42
include types
import alloc, free from alloc
import Arena from mem.arena
import arena_alloc from mem.arena as mem_arena_alloc
import arena_reserve from mem.arena as mem_arena_reserve

func main:
    let base = alloc(4096)

    # 1. Test INT64_MAX - 1 (9223372036854775806)
    let p1 = mem_arena_alloc(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775806
    ), 8)
    if p1 != null do
        print 101
        out 1
    end

    let p2 = mem_arena_reserve(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775806
    ), 8, 8)
    if p2 != null do
        print 102
        out 1
    end

    let p3 = mem_arena_reserve(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775806
    ), 8, 16)
    if p3 != null do
        print 103
        out 1
    end

    let p4 = mem_arena_reserve(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775806
    ), 0, 8)
    if p4 != null do
        print 104
        out 1
    end

    # 2. Test near INT64_MAX (9223372036854775800)
    let p5 = mem_arena_alloc(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775800
    ), 8)
    if p5 != null do
        print 105
        out 1
    end

    # 3. Test INT64_MAX (9223372036854775807)
    let p6 = mem_arena_alloc(Arena (
        base: base,
        capacity: 4096,
        offset: 9223372036854775807
    ), 8)
    if p6 != null do
        print 106
        out 1
    end

    # 4. Test negative offset
    let p7 = mem_arena_alloc(Arena (
        base: base,
        capacity: 4096,
        offset: 0 - 1
    ), 8)
    if p7 != null do
        print 107
        out 1
    end

    # 5. Restore valid offset and allocate successfully
    let p_valid = mem_arena_alloc(Arena (
        base: base,
        capacity: 4096,
        offset: 0
    ), 64)
    if p_valid == null do
        print 108
        out 1
    end

    free(base)
    print 42
    out 0
end.
