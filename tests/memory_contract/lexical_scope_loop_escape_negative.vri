# CONTRACT: MEM-BOR-SCOPE-004
# EXPECT_COMPILE_FAIL: E5012
# EXPECT_DIAGNOSTIC: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var outer = Box(val: 10)
    var refHolder = &outer
    loop 1:
        var inner = Box(val: 55)
        refHolder = &inner
    end
    inspect(refHolder)
end.
