# CONTRACT: MEM-ARENA-BULK-001
# EXPECT: 42
include types
include alloc
include mem.arena
import Arena, arena_new, arena_alloc, arena_alloc_aligned, arena_alloc_zeroed, arena_reserve, arena_bulk_zero, arena_bulk_fill, arena_bulk_copy, arena_reset, arena_free, arena_used from mem.arena
include mem.copy
import mem_copy, mem_set, mem_zero, mem_move, mem_cmp, mem_copy_scalar, mem_set_scalar, mem_move_scalar from mem.copy

func verify_slice_byte(p: ptr, len: int, expected: int):
    var i = 0
    when i < len loop
        let b = native_read_u8(p as int, i)
        if b != (expected and 255) do
            print 991
            out 0
        end
        i = i + 1
    end
    out 1
end.

func main:
    let a = arena_new(4096)

    # 1. Edge-case and boundary sizes: 0, 1, 7, 8, 15, 16, 17, 31, 32, 33, 64, 128
    let sizes = [0, 1, 7, 8, 15, 16, 17, 31, 32, 33, 64, 128]
    var si = 0
    when si < 12 loop
        let sz = sizes[si]
        if sz > 0 do
            # Allocate zeroed
            let pz = arena_alloc_zeroed(a, sz)
            if verify_slice_byte(pz, sz, 0) == 0 do
                print 101
                out 1
            end

            # Fill with 0x5A
            arena_bulk_fill(a, pz, 0x5A, sz)
            if verify_slice_byte(pz, sz, 0x5A) == 0 do
                print 102
                out 1
            end

            # Copy to another buffer
            let p_dst = arena_alloc(a, sz)
            mem_copy(p_dst, pz, sz)
            if mem_cmp(p_dst, pz, sz) != 0 do
                print 103
                out 1
            end

            # Verify equivalence with scalar reference
            let p_scalar = arena_alloc(a, sz)
            mem_copy_scalar(p_scalar, pz, sz)
            if mem_cmp(p_dst, p_scalar, sz) != 0 do
                print 104
                out 1
            end
        end
        si = si + 1
    end

    # 2. Overlapping copy: forward and backward
    let buf = arena_alloc(a, 64)
    # Initialize with 0, 1, 2, ..., 63
    var bi = 0
    when bi < 64 loop
        native_write_u8(buf as int, bi, bi)
        bi = bi + 1
    end

    # Forward overlap: copy buf[0..32] to buf[8..40]
    mem_move(buf + 8, buf, 32)
    var fi = 0
    when fi < 32 loop
        if native_read_u8(buf as int, 8 + fi) != fi do
            print 105
            out 1
        end
        fi = fi + 1
    end

    # 3. Alignment check: overaligned allocation
    let p_unaligned = arena_reserve(a, 1, 1)
    let p_aligned16 = arena_alloc_aligned(a, 32, 16)
    if (p_aligned16 as int and 15) != 0 do
        print 106
        out 1
    end

    # 4. Negative and overflow rejection
    let prev_offset = arena_used(a)
    let p_neg = arena_reserve(a, 0 - 5, 8)
    if p_neg != null or arena_used(a) != prev_offset do
        print 107
        out 1
    end

    # 5. Reset restores allocation offset
    arena_reset(a)
    if arena_used(a) != 0 do
        print 108
        out 1
    end

    arena_free(a)

    print 42
    out 0
end.
