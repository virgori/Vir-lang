entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func main:
    var a = Box(val: 1)
    var b = Box(val: 2)
    var holder = &a
    holder = &b
    consume(a)
    inspect(holder)
end.
