# CONTRACT: MEM-BOR-LOOP-POS-005
# EXPECT_START
# 5
# EXPECT_END
entity Box:
    val: int
end.

func consume(b: Box):
    print b.val
end.

func run(flag: int):
    var a = Box(val: 5)
    loop 2:
        if flag == 1 do
            consume(a)
            out 0
        end
        break
    end
    print a.val
    out 0
end.

func main:
    run(0)
end.
