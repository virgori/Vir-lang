# CONTRACT: MEM-BOR-SCOPE-001
# EXPECT_COMPILE_FAIL: E5012
# EXPECT_DIAGNOSTIC: E5012
entity Box:
    val: int
end.

func inspect(b: &Box):
    print b.val
end.

func main:
    var outer = Box(val: 10)
    var refHolder = &outer
    if 1 == 1 do
        var inner = Box(val: 99)
        refHolder = &inner
    end
    inspect(refHolder)
end.
