# CONTRACT: MEM-BOR-CFG-005
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(which: int):
    var a = Box(val: 1)
    var b = Box(val: 2)
    var holder = &a
    case which
        1: holder = &a
        2: holder = &b
        else holder = &a
    end
    consume(b)
    inspect(holder)
end.
func main: run(2) end.
