# CONTRACT: MEM-BOR-EDGE-010
# EXPECT_START
# 10
# 10
# 10
# EXPECT_END
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func run:
    var owner = Box(val: 10)
    try:
        let holder = &owner
        print holder.val
        throw 1
    revert
        consume(owner)
    end
ensure
    print 10
end.
func main: run() end.
