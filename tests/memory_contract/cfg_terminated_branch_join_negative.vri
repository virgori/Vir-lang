# CONTRACT: MEM-BOR-CFG-008
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
func consume(b: Box): print b.val end.
func inspect(b: &Box): print b.val end.
func run(flag: int):
    var a = Box(val: 8)
    var b = Box(val: 80)
    var holder = &b
    if flag == 1 do
        out 0
    else
        holder = &a
    end
    consume(a)
    inspect(holder)
    out 0
end.
func main: run(0) end.
