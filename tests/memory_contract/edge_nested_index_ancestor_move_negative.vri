# CONTRACT: MEM-BOR-EDGE-004
# EXPECT_COMPILE_FAIL: E5008
entity Box:
    val: int
end.
entity Holder:
    items: [Box]
end.
func consume(h: Holder): print h.items[0].val end.
func inspect(b: &Box): print b.val end.
func main:
    var owner = Holder(items: [Box(val: 4)])
    var i = 0
    let fieldRef = &owner.items[i]
    consume(owner)
    inspect(fieldRef)
end.
