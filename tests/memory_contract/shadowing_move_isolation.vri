# CONTRACT: MEM-BOR-020
# Negative test: Shadowing a moved variable in an inner block is valid,
# but using the outer moved variable after block exit is an error (E5001).
# EXPECT_COMPILE_FAIL: E5001
# EXPECT_DIAGNOSTIC: E5001

func consume(s: string):
    print s
end.

func main:
    var x = "outer"
    consume(x)
    if 1 == 1 do
        var x = "inner"
        print x
    end
    print x
end.
