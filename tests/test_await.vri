# Test: Await expression (Phase 9)
# Expected output: 42,0
# Note: await is synchronous pass-through in stub runtime

async func get_value:
    out 42
end.
async func yielder:
    var x = 0
    out x
end.
func main:
    var v = await get_value()
    print v

    var w = await yielder()
    print w
end.