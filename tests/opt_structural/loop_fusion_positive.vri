# EXPECT:
# 255

func test_fusion(n: int) -> int:
    var sum1 = 0
    var sum2 = 0

    var i = 0
    when i < n loop
        let va = i * 2 + 1
        sum1 = sum1 + va
        i = i + 1
    end

    var j = 0
    when j < n loop
        let vb = j * 3 + 2
        sum2 = sum2 + vb
        j = j + 1
    end

    out sum1 + sum2
end.

func main:
    let s = test_fusion(10)
    print s
    out 0
end.
