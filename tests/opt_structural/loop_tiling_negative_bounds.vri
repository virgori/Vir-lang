func test_tiling_bounds(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < 15 loop
        var j = 0
        when j < 15 loop
            sum = sum + i + j
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    let s = test_tiling_bounds(15, 15)
    print s
    out 0
end.
