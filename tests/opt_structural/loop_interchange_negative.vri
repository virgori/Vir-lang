func test_interchange_negative(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < m loop
        var j = 1
        when j < n loop
            # Access pattern with (<, >) dependence: (i + 1, j - 1)
            let prev = j - 1
            sum = sum + i + prev
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    let s = test_interchange_negative(4, 4)
    print s
    out 0
end.
