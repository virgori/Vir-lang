# EXPECT:
# 95
# 57

func compute_pre(x: int, y: int, cond: int) -> int:
    var res = 0
    if cond == 1 do
        let a = (x * y) + 1
        res = a
    else
        res = 5
    end
    # Redundant evaluation of (x * y) at join point
    let join_val = (x * y) + 10
    out res + join_val
end.

func main:
    let r1 = compute_pre(6, 7, 1)
    print r1
    let r2 = compute_pre(6, 7, 0)
    print r2
    out 0
end.
