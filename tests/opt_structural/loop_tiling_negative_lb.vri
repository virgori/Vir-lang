func test_tiling_lb(m: int, n: int) -> int:
    var sum = 0
    var i = 1
    when i < 32 loop
        var j = 0
        when j < 32 loop
            sum = sum + i + j
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    print test_tiling_lb(32, 32)
    out 0
end.
