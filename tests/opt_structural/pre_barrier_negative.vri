func barrier_fn(val: int) -> int:
    out val + 1
end.

func test_pre_barrier(c: int, x: int, y: int) -> int:
    var res = 0
    if c > 0 do
        res = x * y
    else
        res = barrier_fn(x)
    end
    let redundant = x * y
    out res + redundant
end.

func main:
    print test_pre_barrier(1, 10, 5)
    print test_pre_barrier(0, 10, 5)
    out 0
end.
