func compute_pre_redef(x: int, y: int, cond: int) -> int:
    var local_x = x
    var res = 0
    if cond == 1 do
        let a = (local_x * y) + 1
        res = a
    else
        # Redefinition: local_x is modified here
        local_x = local_x + 5
        res = 5
    end
    # (local_x * y) at join point must NOT be hoisted because local_x was modified in else branch
    let join_val = (local_x * y) + 10
    out res + join_val
end.

func main:
    let r1 = compute_pre_redef(6, 7, 1)
    print r1
    let r2 = compute_pre_redef(6, 7, 0)
    print r2
    out 0
end.
