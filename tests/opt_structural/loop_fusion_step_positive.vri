# EXPECT:
# 90
func test_fuse_step(n: int) -> int:
    var sum1 = 0
    var sum2 = 0
    var i = 0
    when i < n loop
        sum1 = sum1 + i
        i = i + 1
    end
    var j = 0
    when j < n loop
        sum2 = sum2 + j
        j = j + 1
    end
    out sum1 + sum2
end.

func main:
    print test_fuse_step(10)
    out 0
end.
