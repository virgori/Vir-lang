# EXPECT:
# 90

func test_fusion_dep(n: int) -> int:
    var sum1 = 0
    var i = 0
    when i < n loop
        sum1 = sum1 + i
        i = i + 1
    end

    var sum2 = sum1
    var j = 0
    when j < n loop
        sum2 = sum2 + j
        j = j + 1
    end

    out sum2
end.

func main:
    let s = test_fusion_dep(10)
    print s
    out 0
end.
