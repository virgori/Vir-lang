entity Pair:
    a: int
    b: int
end.

func test_fusion_barrier(n: int) -> int:
    var sum1 = 0
    var sum2 = 0

    var i = 0
    when i < n loop
        let p = Pair(a: i, b: i * 2)
        sum1 = sum1 + p.a + p.b
        i = i + 1
    end

    var j = 0
    when j < n loop
        sum2 = sum2 + j * 3 + 2
        j = j + 1
    end

    out sum1 + sum2
end.

func main:
    let s = test_fusion_barrier(10)
    print s
    out 0
end.
