# EXPECT:
# 90

func test_interchange_init(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < m loop
        var j = 1
        when j < n loop
            let val = i * n + j
            sum = sum + val
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    let s = test_interchange_init(3, 5)
    print s
    out 0
end.
