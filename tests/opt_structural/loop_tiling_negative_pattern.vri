# EXPECT:
# 23040

func test_tiling_pattern -> int:
    var sum = 0
    var i = 0
    when i < 32 loop
        var j = 0
        when j < 32 loop
            sum = sum + i + 7
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func test_tiling_overwrite -> int:
    let base = 5
    var result = 0
    var i = 0
    when i < 32 loop
        var j = 0
        when j < 32 loop
            result = base + i + j
            j = j + 1
        end
        i = i + 1
    end
    out result
end.

func main:
    print test_tiling_pattern()
    print test_tiling_overwrite()
    out 0
end.
