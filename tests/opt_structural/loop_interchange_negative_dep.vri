# EXPECT:
# 1176
func test_interchange_dep(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < m loop
        var j = 0
        when j < i loop
            let val = i * n + j
            sum = sum + val
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    print test_interchange_dep(8, 8)
    out 0
end.
