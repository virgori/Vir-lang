func test_fusion_bounds(n: int, m: int) -> int:
    var sum1 = 0
    var sum2 = 0

    var i = 0
    when i < n loop
        sum1 = sum1 + i * 2 + 1
        i = i + 1
    end

    var j = 0
    when j < m loop
        sum2 = sum2 + j * 3 + 2
        j = j + 1
    end

    out sum1 + sum2
end.

func main:
    let s = test_fusion_bounds(10, 20)
    print s
    out 0
end.
