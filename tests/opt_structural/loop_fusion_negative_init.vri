# 215
func test_fuse_init(n: int) -> int:
    var sum1 = 0
    var sum2 = 0
    var i = 0
    when i < n loop
        let va = i * 2 + 1
        sum1 = sum1 + va
        i = i + 1
    end
    var j = 5
    when j < n loop
        let vb = j * 3 + 2
        sum2 = sum2 + vb
        j = j + 1
    end
    out sum1 + sum2
end.

func main:
    print test_fuse_init(10)
    out 0
end.
