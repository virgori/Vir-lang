func test_tiling(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < 32 loop
        var j = 0
        when j < 32 loop
            sum = sum + i + j
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    let s = test_tiling(32, 32)
    print s
    out 0
end.
