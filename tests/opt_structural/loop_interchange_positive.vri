# EXPECT:
# 2016

func test_interchange(m: int, n: int) -> int:
    var sum = 0
    var i = 0
    when i < m loop
        var j = 0
        when j < n loop
            let val = i * n + j
            sum = sum + val
            j = j + 1
        end
        i = i + 1
    end
    out sum
end.

func main:
    let total = test_interchange(8, 8)
    print total
    out 0
end.
