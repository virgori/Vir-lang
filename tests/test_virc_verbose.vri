extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int) -> int;
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;
extern func syscall6(n: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int;

const STDOUT_FD: 1;
const SYS_WRITE: 0x2000004;
const SYS_MMAP: 0x20000C5;
const PROT_READ: 1;
const PROT_WRITE: 2;
const MAP_PRIVATE: 2;
const MAP_ANONYMOUS: 4096;

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset);
end.

func rt_strlen:
    in(s: int)
    if s == 0:
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    sys_write(STDOUT_FD, s, rt_strlen(s));
end.

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end.

func vir_alloc:
    in(size: int)
    out sys_mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
end.

func vir_realloc:
    in(ptr: int, new_size: int)
    out vir_alloc(new_size);
end.

func vir_free:
    in(ptr: int)
    out 0
end.

entity StringBuilder:
    buf: int;
    len: int;
    cap: int;
end.

entity CompilerConfig:
    input_path: int;
    output_path: int;
    target: int;
    format: int;
    verbose: int;
end.

func default_config:
    out CompilerConfig (
        input_path: 0,
        output_path: 0,
        target: 0,
        format: 0,
        verbose: 1
    );
end.

func sb_new:
    let cap = 256;
    let buf = vir_alloc(cap);
    out StringBuilder ( buf: buf, len: 0, cap: cap );
end.

func sb_grow:
    in(sb: StringBuilder, needed: int)
    if sb.len + needed <= sb.cap:
        out sb;
    end
    let new_cap = sb.cap * 2;
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2;
    end
    sb.buf = vir_realloc(sb.buf, new_cap);
    sb.cap = new_cap;
    out sb;
end.

func native_mem_copy:
    in(dst: int, src: int, len: int)
    let i = 0;
    when i < len loop
        native_write_u8(dst, i, native_read_u8(src, i));
        i = i + 1;
    end
end.

func sb_append:
    in(sb: StringBuilder, s: int)
    let slen = rt_strlen(s);
    sb = sb_grow(sb, slen);
    native_mem_copy(sb.buf + sb.len, s, slen);
    sb.len = sb.len + slen;
    out sb;
end.

func sb_to_string:
    in(sb: StringBuilder)
    native_write_u8(sb.buf, sb.len, 0);
    out sb.buf;
end.

func sb_free:
    in(sb: StringBuilder)
    vir_free(sb.buf);
end.

func virc_compile_verbose_banner:
    in(cfg: CompilerConfig)
    let verbose = cfg.verbose;
    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: reading ");
        sb = sb_append(sb, "hello.vri");
        sb = sb_append(sb, "...");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end
    out 0
end.

func main:
    let cfg = default_config();
    virc_compile_verbose_banner(cfg);
    out 0
end.
