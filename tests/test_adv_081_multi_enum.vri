# test_adv_081: Multiple enums in same program
# Expected: 1, 3, 10, 20

enum Direction:
    Up = 1
    Down = 2
    Left = 3
    Right = 4
end.
enum Priority:
    Low = 10
    High = 20
end.
func main:
    print Direction.Up
    print Direction.Left
    print Priority.Low
    print Priority.High
end.