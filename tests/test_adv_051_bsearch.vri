# test_adv_051: Stack binary search
# Expected: 4, -1

func binary_search:
    in(arr, n, target)
    var lo = 0
    var hi = n - 1
    when lo <= hi loop
        var mid = (lo + hi) / 2
        var val = arr[mid]
        if val == target do
            out mid
        eif val < target do
            lo = mid + 1
        else
            hi = mid - 1
        end
    end
    out __neg(1)
end.
func main:
    var arr = arr_new(16)
    push(arr, 2)
    push(arr, 5)
    push(arr, 8)
    push(arr, 13)
    push(arr, 21)
    push(arr, 34)
    push(arr, 55)

    var idx = binary_search(arr, 7, 21)
    print idx

    var idx2 = binary_search(arr, 7, 99)
    print idx2
end.
