# test_adv_050: Two pointers aliasing same memory
# Expected: 42, 42, 99, 99

func main:
    var buf = alloc(16)
    write_word(buf, 0, 42)

    # Read from same "pointer" (variable holding address)
    var val1 = read_word(buf, 0)
    print val1

    # Copy the pointer value
    var alias = buf
    var val2 = read_word(alias, 0)
    print val2

    # Write through alias
    write_word(alias, 0, 99)
    var val3 = read_word(buf, 0)
    print val3

    var val4 = read_word(alias, 0)
    print val4
end.
