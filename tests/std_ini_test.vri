include vir.data.ini

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Global / root section properties
    let ini_src1 = "app_name = VirLang\nversion = 2.9\n"
    let r1 = ini_parse(ini_src1)
    case r1
        Ok(doc1):
            let opt_name = ini_get(doc1, "", "app_name")
            case opt_name
                Some(name):
                    if test_str_eq(name, "VirLang") do
                        let opt_ver = ini_get(doc1, "", "version")
                        case opt_ver
                            Some(ver):
                                if test_str_eq(ver, "2.9") do print 1 end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 2. Sections and both delimiters (= and :)
    let ini_src2 = "[server]\nhost = 127.0.0.1\nport: 8080\n\n[database]\nname = main_db\n"
    let r2 = ini_parse(ini_src2)
    case r2
        Ok(doc2):
            let opt_host = ini_get(doc2, "server", "host")
            case opt_host
                Some(h):
                    if test_str_eq(h, "127.0.0.1") do
                        let opt_port = ini_get(doc2, "server", "port")
                        case opt_port
                            Some(p):
                                if test_str_eq(p, "8080") do
                                    let opt_db = ini_get(doc2, "database", "name")
                                    case opt_db
                                        Some(db):
                                            if test_str_eq(db, "main_db") do print 2 end
                                        None: print 0
                                    end
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 3. Comments (full-line # and ;, inline # and ;)
    let ini_src3 = "# Full line hash comment\n; Full line semicolon comment\n[app]\nname = TestApp # inline comment\nenv = prod ; another inline comment\n"
    let r3 = ini_parse(ini_src3)
    case r3
        Ok(doc3):
            let opt_name = ini_get(doc3, "app", "name")
            case opt_name
                Some(n):
                    if test_str_eq(n, "TestApp") do
                        let opt_env = ini_get(doc3, "app", "env")
                        case opt_env
                            Some(e):
                                if test_str_eq(e, "prod") do print 3 end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 4. Quoted values preserving spaces and special characters
    let ini_src4 = "[strings]\ns1 = \"hello world\"\ns2 = 'single quoted string'\ns3 = \"value with # not comment\"\n"
    let r4 = ini_parse(ini_src4)
    case r4
        Ok(doc4):
            let opt_s1 = ini_get(doc4, "strings", "s1")
            case opt_s1
                Some(s1):
                    if test_str_eq(s1, "hello world") do
                        let opt_s2 = ini_get(doc4, "strings", "s2")
                        case opt_s2
                            Some(s2):
                                if test_str_eq(s2, "single quoted string") do
                                    let opt_s3 = ini_get(doc4, "strings", "s3")
                                    case opt_s3
                                        Some(s3):
                                            if test_str_eq(s3, "value with # not comment") do print 4 end
                                        None: print 0
                                    end
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 5. ini_get_or with fallback
    let doc5 = ini_doc_new()
    ini_set(doc5, "settings", "timeout", "30")
    let v_found = ini_get_or(doc5, "settings", "timeout", "10")
    let v_missing = ini_get_or(doc5, "settings", "retries", "3")
    if test_str_eq(v_found, "30") and test_str_eq(v_missing, "3") do
        print 5
    end

    # 6. Key updating with ini_set
    ini_set(doc5, "settings", "timeout", "60")
    let v_updated = ini_get_or(doc5, "settings", "timeout", "10")
    if test_str_eq(v_updated, "60") do
        print 6
    end

    # 7. Introspection: ini_has_section, ini_sections_len, ini_keys_len
    if ini_has_section(doc5, "settings") and !ini_has_section(doc5, "nonexistent") do
        if ini_sections_len(doc5) == 1 and ini_keys_len(doc5, "settings") == 1 do
            if test_str_eq(ini_key_at(doc5, "settings", 0), "timeout") do
                print 7
            end
        end
    end

    # 8. Strict error: unclosed section header
    let r8 = ini_parse("[unclosed_sec\nkey = val\n")
    case r8
        Ok(_): print 0
        Err(_): print 8
    end

    # 9. Strict error: empty section header
    let r9 = ini_parse("[]\nkey = val\n")
    case r9
        Ok(_): print 0
        Err(_): print 9
    end

    # 10. Strict error: missing delimiter
    let r10 = ini_parse("[sec]\ninvalid_line_without_delimiter\n")
    case r10
        Ok(_): print 0
        Err(_): print 10
    end

    # 11. Strict error: empty key
    let r11 = ini_parse("[sec]\n= missing_key\n")
    case r11
        Ok(_): print 0
        Err(_): print 11
    end

    # 12. Round-trip stringify & parse
    let doc12 = ini_doc_new()
    ini_set(doc12, "", "global_key", "global_val")
    ini_set(doc12, "web", "port", "443")
    ini_set(doc12, "web", "ssl", "true")
    let serialized = ini_stringify(doc12)
    let r12 = ini_parse(serialized)
    case r12
        Ok(parsed12):
            let opt_gk = ini_get(parsed12, "", "global_key")
            case opt_gk
                Some(gk):
                    if test_str_eq(gk, "global_val") do
                        let opt_wp = ini_get(parsed12, "web", "port")
                        case opt_wp
                            Some(wp):
                                if test_str_eq(wp, "443") do
                                    let opt_ws = ini_get(parsed12, "web", "ssl")
                                    case opt_ws
                                        Some(ws):
                                            if test_str_eq(ws, "true") do print 12 end
                                        None: print 0
                                    end
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    print 888
    out 0
end.
