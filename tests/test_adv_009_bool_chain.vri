# test_adv_009: Complex boolean logic chains
# Expected: 1, 0, 1, 1

func main:
    var a = 5
    var b = 10
    var c = 15

    # (a < b) AND (b < c) => 1
    var r1 = 0
    if a < b do
        if b < c do
            r1 = 1
        end
    end
    print r1

    # (a > b) OR (c < b) => 0 (both false)
    var r2 = 0
    if a > b do
        r2 = 1
    end
    if c < b do
        r2 = 1
    end
    print r2

    # NOT(a == b) => 1
    var r3 = 1
    if a == b do
        r3 = 0
    end
    print r3

    # Chained: a < b < c (transitive)
    var r4 = 0
    if a < c do
        if a < b do
            r4 = 1
        end
    end
    print r4
end.