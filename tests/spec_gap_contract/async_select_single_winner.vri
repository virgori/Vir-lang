# CONTRACT: ASYNC-007
# EXPECT: 11
async func fast() -> int:
    await pass
    out 11
end.

async func slow() -> int:
    await pass
    await pass
    out 22
end.

async func race:
    var first = task fast()
    var second = task slow()
    select:
        on first as value:
            print value
        end
        on second as value:
            print value
        end
    end
end.

func main:
    var pending = task race()
    wait pending
end.

