# CONTRACT: FFI-008
# EXPECT_START
# 7
# 11
# 2.5
# 6.0
# true
# !
# EXPECT_END

@bind(c)
func abs(value: i32) -> i32
end.

@bind(c)
func write(fd: i32, buffer: ptr, count: i64)
end.

@bind(c)
func syscall(number: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64) -> i64
end.

@bind(c)
func fabs(value: f64) -> f64
end.

@bind(c)
func ldexp(value: f64, exponent: i32) -> f64
end.

func main:
    print(abs(0 - 7))
    print(abs(0 - 11))
    let magnitude: f64 = fabs(0.0 - 2.5)
    print(magnitude)
    let scaled: f64 = ldexp(0.75, 3)
    print(scaled)
    print(syscall(20, 0, 0, 0, 0, 0, 0, 0, 0) > 0)
    write(1, "!\n" as ptr, 2)
end.
