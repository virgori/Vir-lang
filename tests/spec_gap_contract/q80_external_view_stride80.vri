# CONTRACT: Q80-META-STRIDE-001
# Block size and row stride are independent descriptor fields.

include math.tensor_q8_0
import Q80_OWNERSHIP_BORROWED, q80CreateView, q80ValidateView from math.tensor_q8_0

func main() -> int:
    let view = q80CreateView(
        4096 as ptr,
        160,
        0,
        160,
        2,
        64,
        80,
        8,
        true,
        Q80_OWNERSHIP_BORROWED,
        8192 as ptr,
        1
    )
    out q80ValidateView(&view)
end.
