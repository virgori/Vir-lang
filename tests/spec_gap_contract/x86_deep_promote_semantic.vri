# CONTRACT: SIMD-PROMOTE-X86-001
# EXPECT: 42
#
# Semantic deep-graph promotion test for linux-x86_64 target with nested arenas.
# Compiled with --target linux-x86_64 and executed under real QEMU Linux x86_64.
# Verifies that nested child arena promotion recursively relocates owned child
# pointers (array and nested entity) so that post-reset clobbering does not
# corrupt reachable data.

entity ChildNode:
    id: int
    tag: int
end.

entity ComplexGraph:
    code: int
    values: [i32]
    child: ChildNode
    payload: int
end.

func main:
    var escaped = ComplexGraph(
        code: 0,
        values: [0, 0, 0, 0, 0, 0, 0, 0],
        child: ChildNode(id: 0, tag: 0),
        payload: 0
    )

    arena:
        # Keep more values live across the child-arena escape than the x86-64
        # allocator has colors, forcing the promoted source through StackMem.
        var
            pressure01 = 1
            pressure02 = 2
            pressure03 = 3
            pressure04 = 4
            pressure05 = 5
            pressure06 = 6
            pressure07 = 7
            pressure08 = 8
            pressure09 = 9
            pressure10 = 10
            pressure11 = 11
            pressure12 = 12

        var mid_graph = ComplexGraph(
            code: 0,
            values: [0, 0, 0, 0, 0, 0, 0, 0],
            child: ChildNode(id: 0, tag: 0),
            payload: 0
        )
        arena:
            let arr = [10, 20, 30, 40, 50, 60, 70, 80]
            let child = ChildNode(id: 777, tag: 888)
            let inner = ComplexGraph(
                code: 42,
                values: arr,
                child: child,
                payload: 99
            )
            mid_graph = inner
        end

        let
            pressureLow = pressure01 + pressure02 + pressure03 + pressure04 + pressure05 + pressure06
            pressureHigh = pressure07 + pressure08 + pressure09 + pressure10 + pressure11 + pressure12
            pressureSum = pressureLow + pressureHigh
        if pressureSum != 78 do
            print 106
            out 1
        end

        # Child arena has ended and reset; clobber its region
        arena:
            var clobber1 = [999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999, 999]
        end

        escaped = mid_graph
    end

    # Outer arena has ended and reset; clobber its region as well
    arena:
        var clobber2 = [888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888, 888]
    end

    # First element of promoted array
    if escaped.values[0] != 10 do
        print 101
        out 1
    end

    # Last element of promoted array
    if escaped.values[7] != 80 do
        print 102
        out 1
    end

    # Promoted child entity fields
    if escaped.child.id != 777 do
        print 103
        out 1
    end

    if escaped.child.tag != 888 do
        print 104
        out 1
    end

    # Struct field after child pointer
    if escaped.payload != 99 do
        print 105
        out 1
    end

    print escaped.code
    out 0
end.
