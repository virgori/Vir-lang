# CONTRACT: Q80-005
# EXPECT_START
# 16
# EXPECT_END

include alloc
import alloc_zeroed, free from alloc

include math.tensor_q8_0
import Q80_OWNERSHIP_BORROWED, q80CreateView, q80Gemv from math.tensor_q8_0

func main() -> int:
    let
        weights = alloc_zeroed(80)
        generationCell = alloc_zeroed(8)
        activations = alloc_zeroed(32 * 8)
        output = alloc_zeroed(2 * 8)

    native_write_i64(generationCell as int, 0, 1)

    let view = q80CreateView(
        weights as ptr,
        80,
        0,
        80,
        2,
        32,
        40,
        8,
        true,
        Q80_OWNERSHIP_BORROWED,
        generationCell as ptr,
        1
    )

    # Validates that outputLength (1) < view.rows (2) is rejected with Q80_ERROR_OUTPUT_LENGTH (16) via q80Gemv dispatch
    var outputLength = 1
    try:
        q80Gemv(
            &view,
            activations as ptr,
            32,
            output as ptr,
            outputLength
        )
    revert
        print erx
    end

    free(output)
    free(activations)
    free(generationCell)
    free(weights)
    out 0
end.
