# CONTRACT: Q80-META-DYNAMIC-001
# Dynamic descriptor values must remain structured Q8_0 metadata, not degrade
# to the opaque Q80TensorView entity name.

include math.tensor_q8_0
import Q80_OWNERSHIP_BORROWED, q80CreateView from math.tensor_q8_0

func main() -> int:
    let rows = 2
    let columns = 32
    let stride = 40
    let alignment = 8
    let view = q80CreateView(
        4096 as ptr,
        80,
        0,
        80,
        rows,
        columns,
        stride,
        alignment,
        true,
        Q80_OWNERSHIP_BORROWED,
        8192 as ptr,
        1
    )
    out 0
end.
