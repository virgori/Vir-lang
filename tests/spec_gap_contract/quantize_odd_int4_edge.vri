func main:
    var weights: tensor[f32; 1, 3] = [1.0, 2.0, 3.0]
    var input_a: tensor[f32; 3, 1] = [1.0, 1.0, 1.0]
    var input_b: tensor[f32; 3, 1] = [2.0, 2.0, 3.0]
    var compact = quantize(weights, bits: 4)
    infer:
        var first = compact ** input_a
        var second = compact ** input_b
        print first[0, 0]
        print second[0, 0]
    end
end.

