# CONTRACT: Q80-SEM-001
# Semantic contract for the borrowed 40-byte Q8_0 view API.

include math.tensor_q8_0
import Q80_OWNERSHIP_BORROWED, Q80TensorView,
    q80CreateView, q80ValidateView from math.tensor_q8_0

func main() -> int:
    let view = q80CreateView(
        4096 as ptr,
        80,
        0,
        80,
        2,
        32,
        40,
        8,
        true,
        Q80_OWNERSHIP_BORROWED,
        8192 as ptr,
        1
    )
    out q80ValidateView(&view)
end.
