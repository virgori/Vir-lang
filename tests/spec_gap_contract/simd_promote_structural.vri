# CONTRACT: SIMD-PROMOTE-001
# EXPECT: 42

entity ChildNode:
    id: int
    tag: int
end.

entity ComplexGraph:
    tag: int
    values: [i32]
    child: ChildNode
    code: int
end.

func main:
    var escaped = ComplexGraph(
        tag: 0,
        values: [0, 0, 0, 0, 0, 0, 0, 0],
        child: ChildNode(id: 0, tag: 0),
        code: 0
    )

    arena:
        let arr = [101, 102, 103, 104, 105, 106, 107, 108]
        let child = ChildNode(id: 777, tag: 888)
        let local_graph = ComplexGraph(
            tag: 12345,
            values: arr,
            child: child,
            code: 42
        )
        escaped = local_graph
    end

    print escaped.code
    out 0
end.
