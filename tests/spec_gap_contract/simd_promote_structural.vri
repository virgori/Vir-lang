# CONTRACT: SIMD-PROMOTE-001
# EXPECT: 42

entity ChildNode:
    id: int
    tag: int
end.

entity ComplexGraph:
    tag: int
    values: [i32]
    child: ChildNode
    code: int
end.

func main:
    var escaped = ComplexGraph(
        tag: 0,
        values: [0, 0, 0, 0, 0, 0, 0, 0],
        child: ChildNode(id: 0, tag: 0),
        code: 0
    )

    arena:
        let arr = [101, 102, 103, 104, 105, 106, 107, 108]
        let child = ChildNode(id: 777, tag: 888)
        let local_graph = ComplexGraph(
            tag: 12345,
            values: arr,
            child: child,
            code: 42
        )
        escaped = local_graph
    end

    # Wasm backend does not support array-index LIR ops in cross-target mode,
    # so child/array validation is done via ARM64/x86 oracle execution only.
    # This fixture's purpose is to verify SIMD promotion opcodes exist in the binary
    # and that the ARM64 and x86 targets produce the correct result (42).
    # Deep-graph correctness is validated separately in MEM-PROMOTE-DEEP-001.
    print escaped.code
    out 0
end.
