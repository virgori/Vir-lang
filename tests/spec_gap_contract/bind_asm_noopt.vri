# CONTRACT: FFI-003
# EXPECT: 41
# STRUCTURAL ORACLE: the body must bypass optimizer rewriting.
@bind(asm)
func exact_sequence(value: int) -> int:
    var doubled = value * 2
    out doubled + 1
end.

func optimized_control(value: int) -> int:
    var doubled = value * 2
    out doubled + 1
end.

func main:
    print exact_sequence(20)
    let control = optimized_control(20)
    if control != 41 do
        print 0
    end
end.
