# CONTRACT: Q80-001
# EXPECT_START
# 32.0
# -64.0
# 32.0
# -64.0
# 32.0
# -64.0
# 32.0
# -64.0
# 64.0
# -128.0
# 3
# 3.0
# 7.0
# EXPECT_END

include alloc
import alloc, alloc_zeroed, free from alloc

include math.tensor_q8_0
import Q80_OWNERSHIP_BORROWED, q80CreateView, q80ValidateView,
    q80GemvScalar, q80GemvSimd, q80Gemv, q80Gemm from math.tensor_q8_0

func printOutput(output: ptr, count: int):
    var index = 0
    when index < count loop
        let value = native_read_f64(output as int, index * 8) + 0.0
        print value
        index = index + 1
    end
end.

func main() -> int:
    let
        weights = alloc_zeroed(80)
        generationCell = alloc_zeroed(8)
        activations = alloc_zeroed(64 * 8)
        output = alloc_zeroed(4 * 8)

    native_write_i64(generationCell as int, 0, 1)
    native_write_f64(weights as int, 0, 1.0)
    native_write_f64(weights as int, 40, 2.0)

    var index = 0
    when index < 32 loop
        native_write_u8(weights as int, 8 + index, 1)
        native_write_u8(weights as int, 48 + index, 255)
        native_write_f64(activations as int, index * 8, 1.0)
        native_write_f64(activations as int, (32 + index) * 8, 2.0)
        index = index + 1
    end

    let view = q80CreateView(
        weights as ptr,
        80,
        0,
        80,
        2,
        32,
        40,
        8,
        true,
        Q80_OWNERSHIP_BORROWED,
        generationCell as ptr,
        1
    )

    q80GemvScalar(&view, activations as ptr, 32, output as ptr, 2)
    printOutput(output as ptr, 2)

    q80GemvSimd(&view, activations as ptr, 32, output as ptr, 2)
    printOutput(output as ptr, 2)

    infer:
        q80Gemv(&view, activations as ptr, 32, output as ptr, 2)
    end
    printOutput(output as ptr, 2)

    q80Gemm(&view, activations as ptr, 2, 32, output as ptr, 2)
    printOutput(output as ptr, 4)

    native_write_i64(generationCell as int, 0, 2)
    print q80ValidateView(&view)

    var w_disp: tensor[f32; 2, 2] = [1.0, 2.0, 3.0, 4.0]
    var in_disp: tensor[f32; 2, 1] = [1.0, 1.0]
    var compact_disp = quantize(w_disp, bits: 8)
    infer:
        var out_disp = compact_disp ** in_disp
        print out_disp[0, 0]
        print out_disp[1, 0]
    end

    free(output)
    free(activations)
    free(generationCell)
    free(weights)
    out 0
end.
