# CONTRACT: PORT-001
# The harness must link the official deterministic serial executor provider.
# EXPECT_START
# 10
# 20
# 30
# EXPECT_END
port(cap: 2) messages: int

async func consumer:
    print recv messages
    print recv messages
    print recv messages
end.

async func producer:
    send messages <- 10
    send messages <- 20
    send messages <- 30
end.

func main:
    var c = task consumer()
    var p = task producer()
    wait p
    wait c
end.

