# CONTRACT: GENERIC-004
# EXPECT_START
# 11
# false
# 23
# EXPECT_END
func choose<T>(first: T, second: T, take_first: bool) -> T:
    if take_first do out first end
    out second
end.

func main:
    print choose<int>(11, 22, true)
    print choose<bool>(true, false, false)
    print choose<int>(17, 23, false)
end.

