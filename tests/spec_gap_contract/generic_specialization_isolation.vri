# CONTRACT: GENERIC-004
# EXPECT_START
# 11
# false
# 23
# EXPECT_END
func choose of (T)(first: T, second: T, take_first: bool) -> T:
    if take_first do out first end
    out second
end.

func main:
    print choose of (int)(11, 22, true)
    print choose of (bool)(true, false, false)
    print choose of (int)(17, 23, false)
end.

