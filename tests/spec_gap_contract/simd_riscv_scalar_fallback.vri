# VIRC_FLAGS: --target linux-riscv64
func main:
    var a: flux<int, 4> = flux(10, 20, 30, 40)
    var b: flux<int, 4> = flux(1, 2, 3, 4)
    var c = a + b
    var fa: flux<float, 2> = flux(1.5, 3.0)
    var fb: flux<float, 2> = flux(2.0, 4.0)
    var fc = fa + fb
    let _ = fc[0]
    out c[0] + c[3]
end.
