# ═════════════════════════════════════════════════════════════════════
# tests/codegen/f32_f64_test.vri — Native Float Verification Suite
# Governed by VIRC-ISS-0022 / VIRC-ISS-0050 / VIRC-PLN-0029 Phase 3 (Gate Nhóm 4)
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_find_str(haystack: int, needle: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 524288 # 512KB
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func sys_trim(s: int) -> int:
    let len = s_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    let tlen = end_pos - start
    if tlen <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(tlen + 1)
    var i = 0
    when i < tlen loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, tlen, 0)
    out res
end.

func run_cmd_captured(cmd_argv: int, out_file: int) -> int:
    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if s_strlen(out_file) > 0 do
            let out_fd = sys_open_write(out_file)
            if out_fd >= 0 do
                sys_dup2(out_fd, 1)
                sys_close(out_fd)
            end
        end

        let bin_prog = native_read_i64(cmd_argv, 0)
        let envp = alloc(32)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        native_write_i64(envp, 16, 0)

        sys_execve(bin_prog, cmd_argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 3000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let code = read_byte(st, 1)
            out code
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func run_vir_fixture(virc_bin: int, fixture_path: int, opt_flag: int, tmp_bin: int, tmp_out: int) -> int:
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    let argv_comp = alloc(64)
    native_write_i64(argv_comp, 0, virc_bin)
    native_write_i64(argv_comp, 8, fixture_path)
    native_write_i64(argv_comp, 16, opt_flag)
    native_write_i64(argv_comp, 24, "-o" as int)
    native_write_i64(argv_comp, 32, tmp_bin)
    native_write_i64(argv_comp, 40, "-q" as int)
    native_write_i64(argv_comp, 48, 0)

    let rc_comp = run_cmd_captured(argv_comp, 0)
    if rc_comp != 0 do
        s_print("  (comp fail: " as int)
        s_print(s_int_to_str(rc_comp))
        s_println(")" as int)
        out 0
    end

    let argv_run = alloc(16)
    native_write_i64(argv_run, 0, tmp_bin)
    native_write_i64(argv_run, 8, 0)
    let rc_run = run_cmd_captured(argv_run, tmp_out)
    if rc_run != 0 do out 0 end

    let out_data = sys_read_file(tmp_out)
    out sys_trim(out_data)
end.

func main:
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if s_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc_bin = get_arg(i + 1) as int
            i = i + 1
        end
        i = i + 1
    end

    s_println("=== Running Native Float & Cast Verification (VIRC-ISS-0022) ===" as int)

    let pid = sys_getpid()
    let tmp_bin = s_concat2("scratch/.tmp_f32_f64_bin_" as int, s_int_to_str(pid))
    let tmp_out = s_concat2("scratch/.tmp_f32_f64_out_" as int, s_int_to_str(pid))

    var all_ok = 1

    # ── Test 1: Reproduction f64 and f32 literal and return formatting ──
    let out1 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_reproduction.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let exp1 = "212.0\n212.0\n212.0\n212.0\n212.0\n212.0\n212.0" as int
    if s_streq(out1, exp1) == 1 do
        s_println("  [PASS] test_reproduction_f64_and_f32" as int)
    else
        s_println("  [FAIL] test_reproduction_f64_and_f32" as int)
        all_ok = 0
    end

    # ── Test 2: Float-to-int and int-to-float casts ──
    let out2 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_casts.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let exp2 = "212\n212\n42\n42\n123\n123.0\n123.0\n123.0" as int
    if s_streq(out2, exp2) == 1 do
        s_println("  [PASS] test_float_to_int_casts" as int)
    else
        s_println("  [FAIL] test_float_to_int_casts" as int)
        all_ok = 0
    end

    # ── Test 3: Variable mutations ──
    let out3 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_mutations.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let exp3 = "1.0\n212.0\n2.0\n55.25" as int
    if s_streq(out3, exp3) == 1 do
        s_println("  [PASS] test_variable_mutations" as int)
    else
        s_println("  [FAIL] test_variable_mutations" as int)
        all_ok = 0
    end

    # ── Test 4: Tensor float indexing and inferred variable propagation ──
    let out4 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_tensor.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let exp4 = "212.0\n42.5\n212.0\n42.5\n42.0\n42.0" as int
    if s_streq(out4, exp4) == 1 do
        s_println("  [PASS] test_tensor_indexing" as int)
    else
        s_println("  [FAIL] test_tensor_indexing" as int)
        all_ok = 0
    end

    # ── Test 5: Register spills across -O0..-O3 ──
    var spill_ok = 1
    var opt_i = 0
    let exp_spill = "78.0\n78.0" as int
    when opt_i < 4 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_spill = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_spill.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_spill, exp_spill) == 0 do
            spill_ok = 0
        end
        opt_i = opt_i + 1
    end
    if spill_ok == 1 do
        s_println("  [PASS] test_register_spills_all_opt_levels" as int)
    else
        s_println("  [FAIL] test_register_spills_all_opt_levels" as int)
        all_ok = 0
    end

    # ── Test 6: IEEE-754 edge cases, inf and nan ──
    let out6 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_ieee754.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    var ieee_ok = 1
    if s_find_str(out6, "0.0" as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "-0.0" as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "0.125" as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "-3.5" as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "9223372036854775807." as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "-9223372036854775807." as int) < 0 do ieee_ok = 0 end
    if s_find_str(out6, "0.000000000" as int) < 0 do ieee_ok = 0 end
    if ieee_ok == 1 do
        s_println("  [PASS] test_ieee_754_edge_cases" as int)
    else
        s_println("  [FAIL] test_ieee_754_edge_cases" as int)
        all_ok = 0
    end

    # ── Test 7: Integer preservation ──
    let out7 = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_integers.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let exp7 = "0\n-42\n1000000\n23" as int
    if s_streq(out7, exp7) == 1 do
        s_println("  [PASS] test_integer_preservation" as int)
    else
        s_println("  [FAIL] test_integer_preservation" as int)
        all_ok = 0
    end

    # ── Test 8: Reference-wrapped float bindings across -O0..-O3 ──
    var ref_ok = 1
    opt_i = 0
    let exp_ref = "1.5\n2.5\n3.5\n4.5\n5.5\n6.5" as int
    when opt_i < 4 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_ref = run_vir_fixture(virc_bin, "tests/codegen/fixtures/f32_f64_refs.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_ref, exp_ref) == 0 do
            ref_ok = 0
        end
        opt_i = opt_i + 1
    end
    if ref_ok == 1 do
        s_println("  [PASS] test_reference_wrapped_float_bindings" as int)
    else
        s_println("  [FAIL] test_reference_wrapped_float_bindings" as int)
        all_ok = 0
    end

    # Cleanup temporary files
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    if all_ok == 1 do
        s_println("ALL 8 TESTS PASSED SUCCESSFULLY!" as int)
        exit_prog(0)
    else
        s_println("SOME TESTS FAILED!" as int)
        exit_prog(1)
    end
end.
