func return_f64() -> f64:
    out 212.0
end.

func return_f32() -> f32:
    out 212.0
end.

func return_float() -> float:
    out 212.0
end.

func main:
    print 212.0
    print return_f64()
    let v_f64: f64 = return_f64()
    print v_f64
    print return_f32()
    let v_f32: f32 = return_f32()
    print v_f32
    print return_float()
    let v_flt: float = return_float()
    print v_flt
end.
