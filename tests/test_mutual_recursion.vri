func is_even(n: int) -> int:
    if n == 0 do
        out 1
    end
    var m = n - 1
    out is_odd(m)
end.
func is_odd(n: int) -> int:
    if n == 0 do
        out 0
    end
    var m = n - 1
    out is_even(m)
end.
func main:
    print is_even(4)
    print is_odd(5)
    print is_even(7)
    print is_odd(6)
end.
