# test_adv_022: Large switch-like eif chain stress test
# NOTE: this is not the real Vir `case` syntax test
# Expected: 50

func classify_low:
    in(x)
    if x == 0 do
        out 0
    eif x == 1 do
        out 1
    eif x == 2 do
        out 2
    eif x == 3 do
        out 3
    eif x == 4 do
        out 4
    eif x == 5 do
        out 5
    else
        out -1
    end
end
func classify_high:
    in(x)
    if x == 10 do
        out 10
    eif x == 20 do
        out 20
    eif x == 30 do
        out 30
    eif x == 40 do
        out 40
    eif x == 50 do
        out 50
    eif x == 60 do
        out 60
    eif x == 100 do
        out 100
    else
        out -1
    end
end
func classify:
    in(x)
    if x <= 5 do
        out classify_low(x)
    else
        out classify_high(x)
    end
end
func main:
    var r = classify(50)
    print r
end
