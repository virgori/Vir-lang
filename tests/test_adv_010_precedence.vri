# test_adv_010: Chained arithmetic with operator precedence
# Expected: 14, 3, 23

func main:
    # 2 + 3 * 4 = 14 (mul before add)
    var r1 = 2 + 3 * 4
    print r1

    # (2 + 3) * 4 / ... use parens
    # Parenthesized: (10 - 1) / 3 = 3
    var r2 = (10 - 1) / 3
    print r2

    # Mixed: 1 + 2 * 3 + 4 * (5 - 1) = 1 + 6 + 16 = 23
    var r3 = 1 + 2 * 3 + 4 * (5 - 1)
    print r3
end.