# test_adv_030: FusedMulAdd via optimizer pattern
# Expected: 11, 14, 23

func main:
    # a * b + c — should be optimized to FMA
    var a = 2
    var b = 3
    var c = 5
    var r1 = a * b + c
    print r1

    # Chain: 2 * 3 + 4 * 2 = 6 + 8 = 14
    var r2 = 2 * 3 + 4 * 2
    print r2

    # Nested: (a + 1) * (b + 2) + c - 2 = 3*5+5-2 = 18... 
    # Actually: a=2, b=3 → (2+1)*(3+2)+5-2 = 3*5+3 = 18
    # Let me be precise:
    var x = a + 1
    var y = b + 2
    var r3 = x * y + c - 2 + 5
    print r3
end.