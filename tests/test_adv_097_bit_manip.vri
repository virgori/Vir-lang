# test_adv_097: Bit manipulation - set/clear/toggle specific bits
# Expected: 5, 4, 1, 7

func main:
    # Set bit 0 and 2 of 0 → 0b101 = 5
    var x = 0
    x = x | (1 shl 0)
    x = x | (1 shl 2)
    print x

    # Clear bit 0 → 0b100 = 4
    var mask = __not(1 shl 0)
    x = x & mask
    print x

    # Toggle bit 0 (set it back) → 0b101 = 5, then toggle bit 2 → 0b001 = 1
    x = x xor (1 shl 0)
    x = x xor (1 shl 2)
    print x

    # Set bits 0, 1, 2 → 0b111 = 7
    x = x | (1 shl 1)
    x = x | (1 shl 2)
    print x
end.