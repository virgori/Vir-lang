extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int
extern func syscall6(n: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int

const STDOUT_FD: 1
const SYS_WRITE: 0x2000004
const SYS_MMAP: 0x20000C5
const PROT_READ: 1
const PROT_WRITE: 2
const MAP_PRIVATE: 2
const MAP_ANONYMOUS: 4096

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count)
end.

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset)
end.

func rt_strlen:
    in(s: int)
    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    sys_write(STDOUT_FD, s, rt_strlen(s))
end.

func print_ln:
    in(s: int)
    print_str(s)
    print_str("\n")
end.

func vir_alloc:
    in(size: int)
    out sys_mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
end.

entity StringBuilder:
    buf: int
    len: int
    cap: int
end.

func sb_new:
    let cap = 256
    let buf = vir_alloc(cap)
    out StringBuilder ( buf: buf, len: 0, cap: cap )
end.

func native_mem_copy:
    in(dst: int, src: int, len: int)
    let i = 0
    when i < len loop
        native_write_u8(dst, i, native_read_u8(src, i))
        i = i + 1
    end
end.

func sb_append:
    in(sb: StringBuilder, s: int)
    let slen = rt_strlen(s)
    native_mem_copy(sb.buf + sb.len, s, slen)
    sb.len = sb.len + slen
    out sb
end.

func sb_to_string:
    in(sb: StringBuilder)
    native_write_u8(sb.buf, sb.len, 0)
    out sb.buf
end.

func main:
    let sb = sb_new()
    sb = sb_append(sb, "virc: reading ")
    sb = sb_append(sb, "test.vri")
    print_ln(sb_to_string(sb))
    out 0
end.
