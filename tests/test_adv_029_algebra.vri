# test_adv_029: Algebraic identity simplification
# Expected: 42, 42, 0, 42

func main:
    var x = 42

    # x + 0 = x
    var r1 = x + 0
    print r1

    # x * 1 = x
    var r2 = x * 1
    print r2

    # x - x = 0
    var r3 = x - x
    print r3

    # x / 1 = x
    var r4 = x / 1
    print r4
end.