# EXPECT_START
# Pattern: | :( 09 | 03 | 08 | 07 | 05 :) @0!8 |
# MATCH: 0912345678
# MATCH: 0355667788
# NO: 0243123456
# NO: 091234567
# NO: 19001234
# EXPECT_END
##
# virgex_phone.vri — VPS phone pattern (include virgex per stdlib.vri)
 ##

include virgex

func main:
    let pattern = "| :( 09 | 03 | 08 | 07 | 05 :) @0!8 |"
    let pat = virgex.compile(pattern)
    print "Pattern: $pattern"

    var phones = [
        "0912345678",
        "0355667788",
        "0243123456",
        "091234567",
        "19001234"
    ]

    var i = 0
    let count = len(phones)
    when i < count loop
        let p = phones[i]
        if virgex.fullMatch(pat, p) do
            print "MATCH: $p"
        else
            print "NO: $p"
        end
        i = i + 1
    end
end.
