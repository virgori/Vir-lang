include vir.pattern.virgex as v;

func main:
    let pattern = "| :( 09 | 03 | 08 | 07 | 05 :) @0!8 |"
    print "Pattern: $pattern"
    
    var phones = [
        "0912345678",
        "0355667788",
        "0243123456",
        "091234567",
        "19001234"
    ]
    
    var i = 0
    let count = len(phones)
    when i < count loop
        let p = phones[i]
        case v.virgex_fullmatch(pattern, p)
            true: print "✅ $p";
            false: print "❌ $p"
        end.
        i = i + 1
    end.
end.
