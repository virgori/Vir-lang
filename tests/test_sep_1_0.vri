# §1.0 Separator — NEWLINE as separator (parity with ';' forms in
# test_var_group.vri / test_named.vri). Same-line multi-items still need ';'.

# Multiline paren params: NEWLINE between params
func add_nl(
    a: int
    b: int
):
    out a + b
end.

# Multiline in(...) params
func mul_in:
    in(
        a: int
        b: int
    )
    out a * b
end.

func main:
    # Compact var group: first decl on `var` line, continuation via NEWLINE
    var x = 10
    y = 20
    z = 30
    print x
    print y
    print z

    let a = 1
    b = 2
    print a
    print b

    # Multiline named-args (NEWLINE between args)
    let r = add_nl(
        a = 10
        b = 20
    )
    print r

    let m = mul_in(
        a = 3
        b = 7
    )
    print m
end.
