# test_adv_072: Mmap-style page allocation via syscall
# macOS mmap: syscall 0x20000C5 (197)
# Expected: 1

func main:
    # Allocate a page via mmap syscall
    # mmap(addr=0, len=4096, prot=3(RW), flags=0x1002(ANON|PRIVATE), fd=-1, offset=0)
    var page = __syscall(0x20000C5, 0, 4096, 3, 4098, -1, 0)
    # Write a value into the page
    write_word(page, 0, 12345)
    var val = read_word(page, 0)
    if val == 12345 do
        print 1
    else
        print 0
    end
end.