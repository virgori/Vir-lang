trait Greeter:
    greet
end.
entity Person:
    name: string
end.
impl Greeter for Person do
    func greet:
        in(p: Person)
        print "Hello, " + p.name
    end.
end.
func main:
    var p = Person(name: "Vir")
    p.greet()  # Should call Person__greet via Trait resolution

    var s = "123"
    match s:
        case "abc": print "It is abc"
        case "| @0!3 |": print "Match 3 digits via Virgex!"
        else print "No match"
    end.
end.
