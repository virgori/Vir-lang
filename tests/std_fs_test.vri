include vir.fs.fs

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    let path1 = "/tmp/vir_test_fs1.txt"
    let path2 = "/tmp/vir_test_fs2.txt"
    let path3 = "/tmp/vir_test_fs3.txt"

    # Clean up before testing
    fs.remove(path1)
    fs.remove(path2)
    fs.remove(path3)

    # 1. Check non-existent file
    if fs.exists(path1) == false do
        print 1
    end

    # 2. Write file
    let wr = fs.write(path1, "Hello Vir FS!")
    case wr
        Ok(_): print 2
        Err(_): print 0
    end

    # 3. Exists after write
    if fs.exists(path1) == true do
        print 3
    end

    # 4. Read file content
    let rd = fs.read(path1)
    case rd
        Ok(content):
            if test_str_eq(content, "Hello Vir FS!") do
                print 4
            end
        Err(_): print 0
    end

    # 5. Append to file
    let ap = fs.append(path1, " Appended.")
    case ap
        Ok(_): print 5
        Err(_): print 0
    end

    # 6. Read appended content
    let rd2 = fs.read(path1)
    case rd2
        Ok(content):
            if test_str_eq(content, "Hello Vir FS! Appended.") do
                print 6
            end
        Err(_): print 0
    end

    # 7. Atomic write
    let aw = fs.write_atomic(path1, "Atomic Content")
    case aw
        Ok(_): print 7
        Err(_): print 0
    end

    let rd3 = fs.read(path1)
    case rd3
        Ok(content):
            if test_str_eq(content, "Atomic Content") do
                print 8
            end
        Err(_): print 0
    end

    # 8. Copy file
    let cp = fs.copy(path1, path2)
    case cp
        Ok(_): print 9
        Err(_): print 0
    end

    if fs.exists(path2) == true do
        print 10
    end

    let rd_cp = fs.read(path2)
    case rd_cp
        Ok(content):
            if test_str_eq(content, "Atomic Content") do
                print 11
            end
        Err(_): print 0
    end

    # 9. Rename file
    let rn = fs.rename(path2, path3)
    case rn
        Ok(_): print 12
        Err(_): print 0
    end

    if fs.exists(path2) == false and fs.exists(path3) == true do
        print 13
    end

    # 10. File size
    let sz_r = fs.size(path3)
    case sz_r
        Ok(sz):
            if sz > 0 do
                print 14
            end
        Err(_): print 0
    end

    # 11. Remove file
    let rm = fs.remove(path1)
    case rm
        Ok(_): print 15
        Err(_): print 0
    end

    if fs.exists(path1) == false do
        print 16
    end

    fs.remove(path3)
    if fs.exists(path3) == false do
        print 17
    end

    # 12. Read non-existent file returns Err
    let rd_none = fs.read(path1)
    case rd_none
        Ok(_): print 0
        Err(_): print 18
    end

    print 999
    out 0
end.
