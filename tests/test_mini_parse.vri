entity CompilerConfig:
    input_path: int;
    output_path: int;
    target: int;
    format: int;
    verbose: int;
end.

func default_config:
    out CompilerConfig (
        input_path: 0,
        output_path: 0,
        target: 0,
        format: 0,
        verbose: 1
    );
end.

func mini_parse:
    let cfg = default_config();
    if arg_count() < 1 do
        out cfg;
    end
    cfg.input_path = get_arg(0);
    cfg.output_path = "a.out";
    out cfg;
end.

func main:
    let cfg = mini_parse();
    print cfg.output_path;
    out 0
end.
