# ABI test: callee heavily uses registers then caller verifies its own values
func heavy_callee(v):
    var x1 = v * 2
    var x2 = v * 3
    var x3 = v * 4
    var x4 = v * 5
    var x5 = v * 6
    var x6 = v * 7
    var x7 = v * 8
    var x8 = v * 9
    out x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8
end.

func main:
    var k1 = 100
    var k2 = 200
    var k3 = 300
    var k4 = 400
    var h = heavy_callee(5)
    let sum = k1 + k2 + k3 + k4 + h
    print sum
    out 0
end.
