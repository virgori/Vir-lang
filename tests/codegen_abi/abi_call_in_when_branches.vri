# ABI test: calls in conditional branches
func branch_a(x):
    out x + 100
end.

func branch_b(x):
    out x * 10
end.

func dispatch(mode, val):
    if mode == 1 do
        out branch_a(val)
    eif mode == 2 do
        out branch_b(val)
    else
        out val
    end
end.

func main:
    let r1 = dispatch(1, 5)
    let r2 = dispatch(2, 5)
    let r3 = dispatch(3, 5)
    print r1
    print r2
    print r3
    out 0
end.
