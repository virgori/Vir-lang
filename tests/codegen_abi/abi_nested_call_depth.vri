# ABI test: deep call chain 20 levels
func f0(x): out x + 1 end.
func f1(x): out f0(x) + 1 end.
func f2(x): out f1(x) + 1 end.
func f3(x): out f2(x) + 1 end.
func f4(x): out f3(x) + 1 end.
func f5(x): out f4(x) + 1 end.
func f6(x): out f5(x) + 1 end.
func f7(x): out f6(x) + 1 end.
func f8(x): out f7(x) + 1 end.
func f9(x): out f8(x) + 1 end.
func f10(x): out f9(x) + 1 end.
func f11(x): out f10(x) + 1 end.
func f12(x): out f11(x) + 1 end.
func f13(x): out f12(x) + 1 end.
func f14(x): out f13(x) + 1 end.
func f15(x): out f14(x) + 1 end.
func f16(x): out f15(x) + 1 end.
func f17(x): out f16(x) + 1 end.
func f18(x): out f17(x) + 1 end.
