# ABI test: caller-saved registers live across multiple calls
func add_one(x):
    out x + 1
end.

func main:
    var a = 10
    var b = 20
    var c = 30
    var d = 40
    var e = 50
    var r1 = add_one(a)
    var r2 = add_one(b)
    var r3 = add_one(c)
    var r4 = add_one(d)
    var r5 = add_one(e)
    let total = a + b + c + d + e + r1 + r2 + r3 + r4 + r5
    print total
    out 0
end.
