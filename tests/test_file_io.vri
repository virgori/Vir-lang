# Test file I/O, string ops, and args

func main:
    # Test IToStr
    s = i_to_str(42)
    print_ln(s)

    # Test StrEq
    a = "hello"
    b = "hello"
    c = "world"
    if str_eq(a, b): do
        print 1
    end
    if str_eq(a, c): do
        print 999
    end

    # Test ArgCount
    n = arg_count()
    print n

    # Test StrGet
    s2 = "ABC"
    ch = str_get(s2, 0)
    print ch

    # Write and read a file
    fd = file_open("/tmp/vir_test_io.txt", 0x0601)
    file_write(fd, "test data 123")
    file_close(fd)

    fd2 = file_open("/tmp/vir_test_io.txt", 0)
    content = file_read(fd2, 1024)
    file_close(fd2)
    print_ln(content)
end.