func main:
    var color = "red"
    case color
        "red": print 1
        "green": print 2
        "blue": print 3
        else print 0
    end.
    var n = 2
    case n
        1: print 10
        2: print 20
        3: print 30
        else print 99
    end.

    var m = "unknown"
    case m
        "a": print 1
        else print 42
    end.
end.
