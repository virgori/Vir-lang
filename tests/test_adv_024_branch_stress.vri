# test_adv_024: Loop with unpredictable branching
# Expected: 500

func main:
    var count = 0
    var i = 0
    when i < 1000 loop
        # Alternate true/false each iteration
        var r = i % 2
        if r == 0 do
            count = count + 1
        end
        i = i + 1
    end.
    print count
end.