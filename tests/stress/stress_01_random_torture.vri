# Suite 1: Randomized Allocator Torture - High Volume 50,000 Ops with Magic Canaries
func prng_next(state):
    # LCG: next = (state * 1103515245 + 12345) bit_and 0x7FFFFFFF
    out (state * 1103515245 + 12345) bit_and 0x7FFFFFFF
end.

func main:
    # 256 active live pool slots
    var pool_ptrs = alloc(2048)   # 256 * 8 bytes
    var pool_sizes = alloc(2048)  # 256 * 8 bytes
    
    var i = 0
    when i < 256 loop
        write_word(pool_ptrs, i * 8, 0)
        write_word(pool_sizes, i * 8, 0)
        i = i + 1
    end
    
    var seed = 123456789
    var op = 0
    var passes = 0
    var slot = 0
    var cur_ptr = 0
    var cur_sz = 0
    var action = 0
    var can1 = 0
    var can2 = 0
    var req_sz = 0
    var new_ptr = 0
    var bi = 0
    var bval = 0
    var exp = 0
    var limit = 0
    var si = 0
    var sp = 0
    var ss = 0
    
    # Run 50,000 operations
    when op < 50000 loop
        seed = prng_next(seed)
        slot = (seed shr 16) bit_and 255
        cur_ptr = read_word(pool_ptrs, slot * 8)
        cur_sz = read_word(pool_sizes, slot * 8)
        
        seed = prng_next(seed)
        action = (seed shr 8) bit_and 1
        
        if cur_ptr == 0 do
            action = 0
        end
        
        if action == 0 do
            # Allocate new block (16B .. 4096B)
            seed = prng_next(seed)
            req_sz = 16 + ((seed shr 4) bit_and 255) * 16
            new_ptr = alloc(req_sz)
            if new_ptr == 0 do
                print "ALLOC FAILED"
                out 1
            end
            
            # Write Header & Footer Canaries
            write_word(new_ptr, 0, 0x12345678)
            write_word(new_ptr, req_sz - 8, 0x87654321)
            
            # Fill payload up to limit
            bi = 8
            limit = req_sz - 8
            when bi < limit loop
                write_byte(new_ptr, bi, (bi + slot) bit_and 255)
                bi = bi + 1
            end
            
            write_word(pool_ptrs, slot * 8, new_ptr)
            write_word(pool_sizes, slot * 8, req_sz)
            passes = passes + 1
        else
            # Verify existing block payload & canaries
            can1 = read_word(cur_ptr, 0)
            can2 = read_word(cur_ptr, cur_sz - 8)
            if can1 != 0x12345678 do
                print "CANARY HEAD CORRUPTION"
                out 1
            end
            if can2 != 0x87654321 do
                print "CANARY FOOT CORRUPTION"
                out 1
            end
            
            bi = 8
            limit = cur_sz - 8
            when bi < limit loop
                bval = read_byte(cur_ptr, bi)
                exp = (bi + slot) bit_and 255
                if bval != exp do
                    print "PAYLOAD CORRUPTION ON READ"
                    out 1
                end
                bi = bi + 1
            end
        end
        
        # Periodic full heap sweep every 5,000 ops
        if (op bit_and 4095) == 0 do
            si = 0
            when si < 256 loop
                sp = read_word(pool_ptrs, si * 8)
                if sp != 0 do
                    ss = read_word(pool_sizes, si * 8)
                    can1 = read_word(sp, 0)
                    can2 = read_word(sp, ss - 8)
                    if can1 != 0x12345678 do
                        print "SWEEP CANARY HEAD CORRUPTED"
                        out 1
                    end
                    if can2 != 0x87654321 do
                        print "SWEEP CANARY FOOT CORRUPTED"
                        out 1
                    end
                end
                si = si + 1
            end
        end
        
        op = op + 1
    end
    
    print "PASS: stress_01_random_torture (50,000 ops)"
    out 0
end.
