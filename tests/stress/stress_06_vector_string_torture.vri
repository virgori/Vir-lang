# Suite 6: Vector & String Data Structures Torture (100,000 Elements Vector Growth)
func main:
    # 1. Vector Growth Simulation: 100,000 elements with continuous doubling
    var cap = 16
    var count = 0
    var buf = alloc(cap * 8)
    
    var i = 0
    when i < 100000 loop
        if count >= cap do
            let new_cap = cap * 2
            var new_buf = alloc(new_cap * 8)
            
            # Copy old elements
            var ci = 0
            when ci < count loop
                write_word(new_buf, ci * 8, read_word(buf, ci * 8))
                ci = ci + 1
            end
            
            buf = new_buf
            cap = new_cap
        end
        
        write_word(buf, count * 8, i * 7 + 13)
        count = count + 1
        i = i + 1
    end
    
    # 2. Verify all 100,000 elements
    i = 0
    var errors = 0
    when i < 100000 loop
        let val = read_word(buf, i * 8)
        let exp = i * 7 + 13
        if val != exp do
            errors = errors + 1
        end
        i = i + 1
    end
    
    if errors > 0 do
        print "VECTOR INTEGRITY CORRUPTION"
        out 1
    end
    
    # 3. String literal & print churn
    print "STRING CHURN OK"
    print "PASS: stress_06_vector_string_torture (100,000 elements)"
    out 0
end.
