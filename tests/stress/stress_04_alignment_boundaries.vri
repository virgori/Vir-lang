# Suite 4: 16-Byte Alignment & Extreme Boundary Sizes
func check_size(sz):
    var p = alloc(sz)
    if sz > 0 do
        if p == 0 do
            print "ALLOC FAILED ON EDGE SIZE"
            out 1
        end
    end
    
    # Assert alignment (minimum 8-byte, 16-byte aligned)
    if (p bit_and 7) != 0 do
        print "ALIGNMENT FAILED"
        out 1
    end
    
    if sz == 1 do
        write_byte(p, 0, 0xAA)
        let b0 = read_byte(p, 0)
        if b0 != 0xAA do
            print "BOUNDARY BYTE CORRUPTION"
            out 1
        end
    end
    if sz > 1 do
        write_byte(p, 0, 0xAA)
        write_byte(p, sz - 1, 0x55)
        
        let b0 = read_byte(p, 0)
        let bN = read_byte(p, sz - 1)
        
        if b0 != 0xAA do
            print "BOUNDARY BYTE CORRUPTION"
            out 1
        end
        if bN != 0x55 do
            print "BOUNDARY BYTE CORRUPTION"
            out 1
        end
    end
    out 0
end.

func main:
    if check_size(1) != 0 do out 1 end
    if check_size(2) != 0 do out 1 end
    if check_size(3) != 0 do out 1 end
    if check_size(7) != 0 do out 1 end
    if check_size(8) != 0 do out 1 end
    if check_size(9) != 0 do out 1 end
    if check_size(15) != 0 do out 1 end
    if check_size(16) != 0 do out 1 end
    if check_size(17) != 0 do out 1 end
    if check_size(31) != 0 do out 1 end
    if check_size(32) != 0 do out 1 end
    if check_size(33) != 0 do out 1 end
    if check_size(63) != 0 do out 1 end
    if check_size(64) != 0 do out 1 end
    if check_size(65) != 0 do out 1 end
    if check_size(4095) != 0 do out 1 end
    if check_size(4096) != 0 do out 1 end
    if check_size(4097) != 0 do out 1 end
    
    print "PASS: stress_04_alignment_boundaries"
    out 0
end.
