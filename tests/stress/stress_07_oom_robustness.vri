# Suite 7: Out-Of-Memory & Extreme Size Robustness
func main:
    # 1. Normal allocation
    var p_valid = alloc(128)
    write_word(p_valid, 0, 0x12345678)
    
    # 2. Extreme size allocation request (e.g. 500MB)
    var p_huge = alloc(524288000)
    
    # 3. Verify original valid block is still uncorrupted
    let check = read_word(p_valid, 0)
    if check != 0x12345678 do
        print "HEAP METADATA CORRUPTION AFTER HUGE ALLOC"
        out 1
    end
    
    print "PASS: stress_07_oom_robustness"
    out 0
end.
