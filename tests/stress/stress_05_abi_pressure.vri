# Suite 5: AAPCS64 Callee-Saved Register Pressure & Deep Recursion (1,000 Frames)
func sum8(a, b, c, d, e, f, g, h):
    # Saturates all 8 AAPCS64 argument registers X0..X7
    out a + b + c + d + e + f + g + h
end.

func recurse_pressure(depth, acc):
    if depth <= 0 do
        out acc
    end
    # Local variable pressure to exercise stack frame preservation
    var v1 = depth * 1
    var v2 = depth * 2
    var v3 = depth * 3
    var v4 = depth * 4
    var v5 = depth * 5
    var v6 = depth * 6
    var v7 = depth * 7
    var v8 = depth * 8
    
    let sub_sum = sum8(v1, v2, v3, v4, v5, v6, v7, v8)
    out recurse_pressure(depth - 1, acc + sub_sum)
end.

func main:
    # 1. Direct 8-argument register saturation call (1..8 = 36)
    let direct_sum = sum8(1, 2, 3, 4, 5, 6, 7, 8)
    if direct_sum != 36 do
        print "8-ARG REGISTER SATURATION FAILED"
        out 1
    end
    
    # 2. Deep recursion with register pressure (1,000 frames)
    let rec_res = recurse_pressure(1000, 0)
    if rec_res <= 0 do
        print "RECURSION PRESSURE FAILED"
        out 1
    end
    
    print "PASS: stress_05_abi_pressure (1,000 frames)"
    out 0
end.
