# Test: Adaptive Tiered JIT Promotion & PGO Feedback Loop (Pure Vir)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Tier Levels: 0=Interpreter, 1=BaselineJIT, 2=OptimizedJIT

func simulate_tiered_call(exec_count, current_tier, t1_thresh, t2_thresh):
    let new_count = exec_count + 1
    var next_tier = current_tier

    if current_tier == 0 and new_count >= t1_thresh do
        next_tier = 1 # Promote to Baseline JIT
    end
    if current_tier == 1 and new_count >= t2_thresh do
        next_tier = 2 # Promote to Optimized JIT (PGO)
    end
    out next_tier
end.

func simulate_deopt(current_tier):
    if current_tier == 2 do
        out 1 # Demote to Baseline
    end
    out 0
end.

func main:
    let t1_thresh = 5
    let t2_thresh = 15

    var count = 0
    var tier = 0

    # Phase 1: Tier 0 (Interpreter)
    when count < t1_thresh - 1 loop
        tier = simulate_tiered_call(count, tier, t1_thresh, t2_thresh)
        assert(tier == 0)
        count = count + 1
    end

    # Phase 2: Promote to Tier 1 (Baseline JIT) at count = 5
    tier = simulate_tiered_call(count, tier, t1_thresh, t2_thresh)
    count = count + 1
    assert(tier == 1)

    # Phase 3: Run Baseline JIT until Tier 2 Threshold
    when count < t2_thresh - 1 loop
        tier = simulate_tiered_call(count, tier, t1_thresh, t2_thresh)
        assert(tier == 1)
        count = count + 1
    end

    # Phase 4: Promote to Tier 2 (Optimized JIT + PGO) at count = 15
    tier = simulate_tiered_call(count, tier, t1_thresh, t2_thresh)
    count = count + 1
    assert(tier == 2)

    # Phase 5: Deoptimization / Rollback
    let deopt_tier = simulate_deopt(tier)
    assert(deopt_tier == 1)

    out 0
end.
