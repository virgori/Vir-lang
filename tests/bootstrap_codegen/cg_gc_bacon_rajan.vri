# Bootstrap Native Test: Bacon-Rajan Cycle Collection (Trial Deletion for ARC)
# ==============================================================================
# Spec §15 / Pillar 6: Bacon-Rajan Concurrent Cycle Collection for Reference Counting.
# Resolves isolated cyclic graphs (A <-> B, A -> B -> C -> A) that cannot be freed
# by simple reference count decrements.
#
# Colors:
# 0 = BLACK  (Live / In-use node with external references)
# 1 = GRAY   (Tentative cycle candidate, RC decremented)
# 2 = WHITE  (Confirmed isolated cyclic garbage, ready to free)
# 3 = PURPLE (Candidate root with decremented RC)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Node structure (8 words):
# 0: id
# 1: rc (reference count)
# 2: color (0=BLACK, 1=GRAY, 2=WHITE, 3=PURPLE)
# 3: child_count (0..4)
# 4: child0
# 5: child1
# 6: child2
# 7: is_freed (0 or 1)
func gc_node_new(id):
    let node = alloc(8 * 8)
    write_word(node, 0 * 8, id)
    write_word(node, 1 * 8, 1) # Initial RC = 1
    write_word(node, 2 * 8, 0) # Initial Color = BLACK
    write_word(node, 3 * 8, 0) # Child count = 0
    write_word(node, 4 * 8, 0)
    write_word(node, 5 * 8, 0)
    write_word(node, 6 * 8, 0)
    write_word(node, 7 * 8, 0) # Not freed
    out node
end.

func gc_add_reference(parent, child):
    let count = read_word(parent, 3 * 8)
    if count < 3 do
        write_word(parent, (4 + count) * 8, child)
        write_word(parent, 3 * 8, count + 1)
        # Increment child RC
        let child_rc = read_word(child, 1 * 8)
        write_word(child, 1 * 8, child_rc + 1)
    end
end.

# Phase 1: Mark Gray (Tentatively decrement child RCs to find internal cycle)
func gc_mark_gray(node):
    let color = read_word(node, 2 * 8)
    if color != 1 do
        write_word(node, 2 * 8, 1) # Color = GRAY
        let count = read_word(node, 3 * 8)
        var i = 0
        when i < count loop
            let child = read_word(node, (4 + i) * 8)
            if child != 0 do
                let child_rc = read_word(child, 1 * 8)
                write_word(child, 1 * 8, child_rc - 1)
                gc_mark_gray(child)
            end
            i = i + 1
        end
    end
end.

# Phase 2: Scan (Restore BLACK if RC > 0, otherwise paint WHITE)
func gc_scan(node):
    let color = read_word(node, 2 * 8)
    if color == 1 do
        let rc = read_word(node, 1 * 8)
        if rc > 0 do
            # Has external reference -> Restore BLACK and recover child RCs
            gc_scan_black(node)
        end
        if rc == 0 do
            # Isolated cycle -> Color = WHITE
            write_word(node, 2 * 8, 2)
            let count = read_word(node, 3 * 8)
            var i = 0
            when i < count loop
                let child = read_word(node, (4 + i) * 8)
                if child != 0 do
                    gc_scan(child)
                end
                i = i + 1
            end
        end
    end
end.

func gc_scan_black(node):
    write_word(node, 2 * 8, 0) # Color = BLACK
    let count = read_word(node, 3 * 8)
    var i = 0
    when i < count loop
        let child = read_word(node, (4 + i) * 8)
        if child != 0 do
            let child_rc = read_word(child, 1 * 8)
            write_word(child, 1 * 8, child_rc + 1)
            let child_color = read_word(child, 2 * 8)
            if child_color != 0 do
                gc_scan_black(child)
            end
        end
        i = i + 1
    end
end.

# Phase 3: Collect White (Free confirmed cyclic garbage)
func gc_collect_white(node):
    let color = read_word(node, 2 * 8)
    if color == 2 do
        let is_freed = read_word(node, 7 * 8)
        if is_freed == 0 do
            write_word(node, 7 * 8, 1) # Mark as FREED
            write_word(node, 2 * 8, 0) # Color = BLACK (dead)
            let count = read_word(node, 3 * 8)
            var i = 0
            when i < count loop
                let child = read_word(node, (4 + i) * 8)
                if child != 0 do
                    gc_collect_white(child)
                end
                i = i + 1
            end
        end
    end
end.

# Master Cycle Collector Entry Point
func gc_collect_cycles(root_candidate):
    gc_mark_gray(root_candidate)
    gc_scan(root_candidate)
    gc_collect_white(root_candidate)
end.

func main:
    # TEST 1: Mutual 2-Node Cycle (A <-> B)
    # A points to B, B points to A
    let node_a = gc_node_new(101)
    let node_b = gc_node_new(102)
    gc_add_reference(node_a, node_b)
    gc_add_reference(node_b, node_a)

    # Initially: RC(A) = 2, RC(B) = 2
    assert(read_word(node_a, 1 * 8) == 2)
    assert(read_word(node_b, 1 * 8) == 2)

    # External variable releases A: RC(A) becomes 1 (only referenced by B)
    write_word(node_a, 1 * 8, 1)
    # External variable releases B: RC(B) becomes 1 (only referenced by A)
    write_word(node_b, 1 * 8, 1)

    # Now {A, B} form an isolated cycle with RC=1 each!
    # Run Bacon-Rajan Cycle Collector on node_a:
    gc_collect_cycles(node_a)

    # Both nodes must be confirmed as collected (is_freed = 1)
    assert(read_word(node_a, 7 * 8) == 1)
    assert(read_word(node_b, 7 * 8) == 1)

    # TEST 2: Live Node with External Reference (Must NOT be collected)
    let live_root = gc_node_new(201)
    let live_child = gc_node_new(202)
    gc_add_reference(live_root, live_child)
    gc_add_reference(live_child, live_root)

    # External stack root holds a reference to live_root: RC(live_root) = 2
    gc_collect_cycles(live_root)

    # Live nodes must remain NOT freed (is_freed = 0) and Color = BLACK
    assert(read_word(live_root, 7 * 8) == 0)
    assert(read_word(live_child, 7 * 8) == 0)
    assert(read_word(live_root, 2 * 8) == 0) # BLACK

    out 0
end.
