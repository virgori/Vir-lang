extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_u8(addr: int, offset: int) -> int
extern func vir_alloc(size: int) -> int

entity Cursor:
    source: int,
    source_len: int,
    pos: int,
    flags: int
end.

func scan_ident(cur: Cursor):
    start = cur.pos
    scanning = true
    when scanning and cur.pos < cur.source_len loop
        c = native_read_u8(cur.source, cur.pos)
        flags = native_read_u8(cur.flags, c)
        if c >= 128 or (flags & 8) != 0 do
            cur.pos = cur.pos + 1
        else
            scanning = false
        end
    end
    out cur.pos - start
end.

func main:
    data = vir_alloc(4)
    flags = vir_alloc(256)
    native_write_u8(data, 0, 97)
    native_write_u8(data, 1, 98)
    native_write_u8(data, 2, 99)
    native_write_u8(data, 3, 32)
    native_write_u8(flags, 97, 8)
    native_write_u8(flags, 98, 8)
    native_write_u8(flags, 99, 8)
    native_write_u8(flags, 32, 0)
    cur = Cursor ( source: data, source_len: 4, pos: 0, flags: flags )
    scanned = scan_ident(cur)
    print scanned
    print cur.pos
    out 0
end.
