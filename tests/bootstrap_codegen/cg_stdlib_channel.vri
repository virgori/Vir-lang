# Phase E4: Test std/sync/channel — Bounded Ring Buffer Message Channel (Spec §9, stdlib/vir/sync)

# Channel layout at ptr:
# word 0: capacity
# word 8: head (read index)
# word 16: tail (write index)
# word 24: count (current elements)
# word 32: is_closed (0 = open, 1 = closed)
# word 40: data array ptr (i64)

func channel_create(cap):
    let ch = alloc(48)
    write_word(ch, 0, cap)
    write_word(ch, 8, 0)
    write_word(ch, 16, 0)
    write_word(ch, 24, 0)
    write_word(ch, 32, 0)
    let data = alloc(cap * 8)
    write_word(ch, 40, data)
    out ch
end.

func channel_count(ch):
    out read_word(ch, 24)
end.

func channel_is_empty(ch):
    if read_word(ch, 24) == 0 do out 1 end
    out 0
end.

func channel_is_full(ch):
    let cnt = read_word(ch, 24)
    let cap = read_word(ch, 0)
    if cnt >= cap do out 1 end
    out 0
end.

func channel_send(ch, val):
    let closed = read_word(ch, 32)
    if closed != 0 do out 0 end # Closed channel
    let cnt = read_word(ch, 24)
    let cap = read_word(ch, 0)
    if cnt >= cap do out 0 end # Full channel

    let data = read_word(ch, 40)
    let tail = read_word(ch, 16)
    write_word(data, tail * 8, val)
    write_word(ch, 16, (tail + 1) % cap)
    write_word(ch, 24, cnt + 1)
    out 1
end.

func channel_recv(ch):
    let cnt = read_word(ch, 24)
    if cnt == 0 do out 0 - 1 end # Empty

    let cap = read_word(ch, 0)
    let data = read_word(ch, 40)
    let head = read_word(ch, 8)
    let val = read_word(data, head * 8)
    write_word(ch, 8, (head + 1) % cap)
    write_word(ch, 24, cnt - 1)
    out val
end.

func channel_close(ch):
    write_word(ch, 32, 1)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let ch = channel_create(4)
    assert(channel_is_empty(ch) == 1)
    assert(channel_is_full(ch) == 0)
    assert(channel_count(ch) == 0)
    assert(channel_recv(ch) == (0 - 1))

    # 1. Fill channel
    assert(channel_send(ch, 100) == 1)
    assert(channel_send(ch, 200) == 1)
    assert(channel_send(ch, 300) == 1)
    assert(channel_send(ch, 400) == 1)
    assert(channel_count(ch) == 4)
    assert(channel_is_full(ch) == 1)

    # 2. Sending to full channel fails
    assert(channel_send(ch, 500) == 0)

    # 3. Receive 2 messages
    assert(channel_recv(ch) == 100)
    assert(channel_recv(ch) == 200)
    assert(channel_count(ch) == 2)
    assert(channel_is_full(ch) == 0)

    # 4. Send 2 more messages (wraparound)
    assert(channel_send(ch, 500) == 1)
    assert(channel_send(ch, 600) == 1)
    assert(channel_is_full(ch) == 1)

    # 5. Receive all remaining messages
    assert(channel_recv(ch) == 300)
    assert(channel_recv(ch) == 400)
    assert(channel_recv(ch) == 500)
    assert(channel_recv(ch) == 600)
    assert(channel_is_empty(ch) == 1)
    assert(channel_recv(ch) == (0 - 1))

    # 6. Close channel
    channel_close(ch)
    assert(channel_send(ch, 999) == 0) # Cannot send to closed channel

    out 0
end.
