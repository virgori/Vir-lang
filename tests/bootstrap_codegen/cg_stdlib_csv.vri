# Phase F5: Test std/csv — CSV Reader with Quoted Fields & Escaped Quotes (Spec §9, stdlib/vir/csv)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# Parses a single CSV row from src at pos_box.
# Writes cell string pointers to cells_arr, returns number of cells parsed (or 0 at EOF).
func csv_read_row(src, pos_box, cells_arr, max_cells):
    let slen = cstr_len(src)
    var p = read_word(pos_box, 0)
    if p >= slen do out 0 end

    var cell_count = 0
    var done_row = 0

    when (p < slen) and (done_row == 0) and (cell_count < max_cells) loop
        let cell_buf = alloc(256)
        var dst_idx = 0

        # Check if quoted field
        if read_byte(src, p) == 34 do # '"'
            p = p + 1
            var in_quote = 1
            when (p < slen) and (in_quote == 1) loop
                let b = read_byte(src, p)
                if b == 34 do # '"'
                    if (p + 1 < slen) and (read_byte(src, p + 1) == 34) do
                        # Escaped quote '""' -> '"'
                        write_byte(cell_buf, dst_idx, 34)
                        dst_idx = dst_idx + 1
                        p = p + 2
                    else
                        # Closing quote
                        p = p + 1
                        in_quote = 0
                    end
                else
                    write_byte(cell_buf, dst_idx, b)
                    dst_idx = dst_idx + 1
                    p = p + 1
                end
            end
        else
            # Unquoted field (until ',' or '\n' or '\r' or EOF)
            var in_field = 1
            when (p < slen) and (in_field == 1) loop
                let b = read_byte(src, p)
                if (b == 44) or (b == 10) or (b == 13) do # ',', '\n', '\r'
                    in_field = 0
                else
                    write_byte(cell_buf, dst_idx, b)
                    dst_idx = dst_idx + 1
                    p = p + 1
                end
            end
        end

        write_byte(cell_buf, dst_idx, 0)
        write_word(cells_arr, cell_count * 8, cell_buf)
        cell_count = cell_count + 1

        # Check separator or row terminator
        if p < slen do
            let b = read_byte(src, p)
            if b == 44 do # ','
                p = p + 1
            else
                if (b == 10) or (b == 13) do # '\n' or '\r'
                    if (b == 13) and (p + 1 < slen) and (read_byte(src, p + 1) == 10) do
                        p = p + 2
                    else
                        p = p + 1
                    end
                    done_row = 1
                end
            end
        else
            done_row = 1
        end
    end

    write_word(pos_box, 0, p)
    out cell_count
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let csv_text = "id,name,role\n1,Alice,Engineer\n2,\"Bob, Jr.\",Manager\n3,Charlie,\"VP, \"\"Tech\"\"\""
    let pos_box = alloc(8)
    write_word(pos_box, 0, 0)
    let cells = alloc(8 * 8)

    # 1. Header row
    let n0 = csv_read_row(csv_text, pos_box, cells, 8)
    assert(n0 == 3)
    assert(cstr_eq(read_word(cells, 0 * 8), "id") == 1)
    assert(cstr_eq(read_word(cells, 1 * 8), "name") == 1)
    assert(cstr_eq(read_word(cells, 2 * 8), "role") == 1)

    # 2. Row 1: Alice
    let n1 = csv_read_row(csv_text, pos_box, cells, 8)
    assert(n1 == 3)
    assert(cstr_eq(read_word(cells, 0 * 8), "1") == 1)
    assert(cstr_eq(read_word(cells, 1 * 8), "Alice") == 1)
    assert(cstr_eq(read_word(cells, 2 * 8), "Engineer") == 1)

    # 3. Row 2: Bob, Jr. (quoted comma)
    let n2 = csv_read_row(csv_text, pos_box, cells, 8)
    assert(n2 == 3)
    assert(cstr_eq(read_word(cells, 0 * 8), "2") == 1)
    assert(cstr_eq(read_word(cells, 1 * 8), "Bob, Jr.") == 1)
    assert(cstr_eq(read_word(cells, 2 * 8), "Manager") == 1)

    # 4. Row 3: Charlie with escaped quotes
    let n3 = csv_read_row(csv_text, pos_box, cells, 8)
    assert(n3 == 3)
    assert(cstr_eq(read_word(cells, 0 * 8), "3") == 1)
    assert(cstr_eq(read_word(cells, 1 * 8), "Charlie") == 1)
    assert(cstr_eq(read_word(cells, 2 * 8), "VP, \"Tech\"") == 1)

    # 5. EOF
    assert(csv_read_row(csv_text, pos_box, cells, 8) == 0)

    out 0
end.
