# Bootstrap Native Test: Global Value Numbering (GVN over Dominator Tree)
# ==============================================================================
# Spec §16.4 / Pillar 6 / Tier-4: GVN assigns canonical value numbers to all
# symbolic expressions across the SSA Dominator Tree. Unlike block-local CSE,
# GVN eliminates redundancies globally across branches, loops, and merge points,
# leveraging commutative canonicalization (VN(a + b) == VN(b + a)).

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# GVN Value Table Structure:
# Up to 32 entries: [Op, VN_Left, VN_Right, Result_VN]
func gvn_table_new:
    let tbl = alloc(32 * 4 * 8)
    # Set size at header (offset 0) = 0
    write_word(tbl, 0, 0)
    out tbl
end.

func gvn_canonical_hash(op, v1, v2):
    # Commutative canonicalization: ensure v1 <= v2 for Add (1) and Mul (3)
    var left = v1
    var right = v2
    if op == 1 or op == 3 do
        if v1 > v2 do
            left = v2
            right = v1
        end
    end
    out (op * 1000003) + (left * 1009) + right
end.

# Lookup or Insert Expression in GVN Table
# Returns existing Result_VN if redundant, or allocates new Result_VN
func gvn_lookup_or_insert(tbl, op, v1, v2, next_vn_ptr):
    var left = v1
    var right = v2
    # Canonicalize commutative operators (Add=1, Mul=3)
    if op == 1 or op == 3 do
        if v1 > v2 do
            left = v2
            right = v1
        end
    end

    let count = read_word(tbl, 0)
    var i = 0
    when i < count loop
        let entry_op = read_word(tbl, (1 + i * 4 + 0) * 8)
        let entry_l  = read_word(tbl, (1 + i * 4 + 1) * 8)
        let entry_r  = read_word(tbl, (1 + i * 4 + 2) * 8)
        if entry_op == op and entry_l == left and entry_r == right do
            # Value Number Match found! Return existing VN
            out read_word(tbl, (1 + i * 4 + 3) * 8)
        end
        i = i + 1
    end

    # New expression: assign next available VN and store
    let new_vn = read_word(next_vn_ptr, 0)
    write_word(next_vn_ptr, 0, new_vn + 1)

    let idx = count
    write_word(tbl, (1 + idx * 4 + 0) * 8, op)
    write_word(tbl, (1 + idx * 4 + 1) * 8, left)
    write_word(tbl, (1 + idx * 4 + 2) * 8, right)
    write_word(tbl, (1 + idx * 4 + 3) * 8, new_vn)
    write_word(tbl, 0, count + 1)

    out new_vn
end.

# Global calculation with redundant sub-expressions across branches
func gvn_compute_diamond(x, y, cond):
    # Dominator Entry: t1 = x + y
    let t1 = x + y
    var res = 0
    if cond == 1 do
        # Branch A: computes y + x (commutative match to t1!)
        let t2 = y + x
        res = t2 * 2
    else
        # Branch B: computes x + y (exact match to t1!)
        let t3 = x + y
        res = t3 * 3
    end
    out res + t1
end.

func main:
    # TEST 1: Commutative Global Value Numbering Table Simulation
    let tbl = gvn_table_new()
    let next_vn_buf = alloc(8)
    write_word(next_vn_buf, 0, 100) # Starting VN ID = 100

    # Expr 1: VN(v1 + v2) -> gets VN 100
    let vn1 = gvn_lookup_or_insert(tbl, 1, 10, 20, next_vn_buf)
    assert(vn1 == 100)

    # Expr 2: Commutative VN(v2 + v1) -> MUST reuse VN 100!
    let vn2 = gvn_lookup_or_insert(tbl, 1, 20, 10, next_vn_buf)
    assert(vn2 == 100)

    # Expr 3: Different operands VN(v1 + v3) -> gets VN 101
    let vn3 = gvn_lookup_or_insert(tbl, 1, 10, 30, next_vn_buf)
    assert(vn3 == 101)

    # Expr 4: Multiplication VN(v1 * v2) -> gets VN 102
    let vn4 = gvn_lookup_or_insert(tbl, 3, 10, 20, next_vn_buf)
    assert(vn4 == 102)

    # Expr 5: Commutative Multiplication VN(v2 * v1) -> MUST reuse VN 102!
    let vn5 = gvn_lookup_or_insert(tbl, 3, 20, 10, next_vn_buf)
    assert(vn5 == 102)

    # TEST 2: Native Execution of Diamond CFG with Dominator Reuse
    # (10 + 20) = 30.
    # cond=1: (30 * 2) + 30 = 60 + 30 = 90
    let d1 = gvn_compute_diamond(10, 20, 1)
    assert(d1 == 90)

    # cond=0: (30 * 3) + 30 = 90 + 30 = 120
    let d2 = gvn_compute_diamond(10, 20, 0)
    assert(d2 == 120)

    out 0
end.
