# Phase E2: Test std/sync/spinlock — Spinlock & Mutual Exclusion (Spec §9, stdlib/vir/sync)

func spinlock_create:
    let l = alloc(8)
    write_word(l, 0, 0) # 0 = UNLOCKED, 1 = LOCKED
    out l
end.

func spinlock_try_lock(l):
    # Try CAS from 0 to 1
    out atomic_cas(l, 0, 1)
end.

func spinlock_lock(l):
    var acquired = 0
    when acquired == 0 loop
        if atomic_cas(l, 0, 1) == 1 do
            acquired = 1
        end
    end
end.

func spinlock_unlock(l):
    atomic_store(l, 0)
end.

func spinlock_is_locked(l):
    out atomic_load(l)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let lock = spinlock_create()
    assert(spinlock_is_locked(lock) == 0)

    # 1. First acquisition succeeds
    assert(spinlock_try_lock(lock) == 1)
    assert(spinlock_is_locked(lock) == 1)

    # 2. Re-acquisition fails while held
    assert(spinlock_try_lock(lock) == 0)
    assert(spinlock_is_locked(lock) == 1)

    # 3. Release lock
    spinlock_unlock(lock)
    assert(spinlock_is_locked(lock) == 0)

    # 4. Acquire via blocking lock
    spinlock_lock(lock)
    assert(spinlock_is_locked(lock) == 1)
    assert(spinlock_try_lock(lock) == 0)
    spinlock_unlock(lock)
    assert(spinlock_is_locked(lock) == 0)

    # 5. Critical section protecting shared state
    let shared_counter = alloc(8)
    write_word(shared_counter, 0, 0)

    var i = 0
    when i < 50 loop
        spinlock_lock(lock)
        # In critical section:
        let cur = read_word(shared_counter, 0)
        write_word(shared_counter, 0, cur + 1)
        spinlock_unlock(lock)
        i = i + 1
    end

    assert(read_word(shared_counter, 0) == 50)

    out 0
end.
