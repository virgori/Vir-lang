# Test std/math functions (Spec §4.1, stdlib/vir/math)

func abs_val(x):
    if x < 0 do out 0 - x end
    out x
end.

func min_val(a, b):
    if a < b do out a end
    out b
end.

func max_val(a, b):
    if a > b do out a end
    out b
end.

func clamp_val(x, lo, hi):
    if x < lo do out lo end
    if x > hi do out hi end
    out x
end.

func gcd(a, b):
    var x = a
    if x < 0 do x = 0 - x end
    var y = b
    if y < 0 do y = 0 - y end
    when y != 0 loop
        let t = y
        y = x mod y
        x = t
    end
    out x
end.

func lcm(a, b):
    if a == 0 do out 0 end
    if b == 0 do out 0 end
    let g = gcd(a, b)
    out (abs_val(a) / g) * abs_val(b)
end.

func ipow(base, exp):
    var res = 1
    var b = base
    var e = exp
    when e > 0 loop
        if (e bit_and 1) != 0 do
            res = res * b
        end
        b = b * b
        e = e shr 1
    end
    out res
end.

func isqrt(n):
    if n <= 0 do out 0 end
    if n < 4 do out 1 end
    var x0 = n shr 1
    var x1 = (x0 + n / x0) shr 1
    when x1 < x0 loop
        x0 = x1
        x1 = (x0 + n / x0) shr 1
    end
    out x0
end.

func main:
    # 1. abs
    if abs_val(0 - 42) != 42 do out 1 end
    if abs_val(100) != 100 do out 2 end

    # 2. min / max / clamp
    if min_val(10, 20) != 10 do out 3 end
    if max_val(10, 20) != 20 do out 4 end
    if clamp_val(5, 10, 30) != 10 do out 5 end
    if clamp_val(50, 10, 30) != 30 do out 6 end
    if clamp_val(25, 10, 30) != 25 do out 7 end

    # 3. gcd / lcm
    if gcd(48, 18) != 6 do out 8 end
    if gcd(101, 10) != 1 do out 9 end
    if lcm(12, 18) != 36 do out 10 end

    # 4. ipow
    if ipow(2, 10) != 1024 do out 11 end
    if ipow(3, 4) != 81 do out 12 end
    if ipow(5, 0) != 1 do out 13 end

    # 5. isqrt
    if isqrt(0) != 0 do out 14 end
    if isqrt(1) != 1 do out 15 end
    if isqrt(4) != 2 do out 16 end
    if isqrt(100) != 10 do out 17 end
    if isqrt(144) != 12 do out 18 end
    if isqrt(200) != 14 do out 19 end

    out 0
end.
