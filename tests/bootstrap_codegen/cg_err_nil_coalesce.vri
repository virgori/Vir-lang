# Test ?. safe navigation and ?? nil coalescing (§13.6, §17.4)
entity Node:
    val: i64
    next: Node
end.

func get_val(n):
    let v = n?.val
    out v
end.

func main:
    let fallback = 0 ?? 42
    if fallback != 42 do
        out 1
    end
    let direct = 100 ?? 42
    if direct != 100 do
        out 2
    end

    let n = Node(99, 0)
    let v1 = get_val(n)
    if v1 != 99 do
        out 3
    end
    let v2 = get_val(0)
    if v2 != 0 do
        out 4
    end

    out 0
end.
