func vector_sum_test(n):
    let buf = alloc(n * 8)
    var i = 0
    when i < n loop
        write_word(buf, i * 8, i + 1)
        i = i + 1
    end

    var total = 0
    var j = 0
    when j < n loop
        total = total + read_word(buf, j * 8)
        j = j + 1
    end
    out total
end.

func main:
    let s = vector_sum_test(1000)
    # Sum of 1..1000 = 1000 * 1001 / 2 = 500500
    if s != 500500 do
        exit_prog(1)
    end
    out 0
end.
