# Bootstrap Native Test: Polyhedral Loop Tiling & Cache Blocking
# ==============================================================================
# Spec §18 / Pillar 6: Polyhedral Loop Tiling partitions multi-dimensional
# iteration spaces into small cache-friendly blocks (L1/L2 Cache Locality),
# eliminating cache line evictions on matrix and buffer transformations.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func min_val(a, b):
    if a < b do out a end
    out b
end.

# Matrix Transpose: Naïve 2D Loop
# B[j, i] = A[i, j]
func mat_transpose_naive(src, dst, rows, cols):
    var i = 0
    when i < rows loop
        var j = 0
        when j < cols loop
            let val = read_word(src, (i * cols + j) * 8)
            write_word(dst, (j * rows + i) * 8, val)
            j = j + 1
        end
        i = i + 1
    end
end.

# Matrix Transpose: Polyhedral Tiled Loop (Block size = B)
func mat_transpose_tiled(src, dst, rows, cols, block_sz):
    var i0 = 0
    when i0 < rows loop
        let i_max = min_val(i0 + block_sz, rows)
        var j0 = 0
        when j0 < cols loop
            let j_max = min_val(j0 + block_sz, cols)

            # Intra-tile inner loops (fit entirely inside CPU L1 Cache)
            var i = i0
            when i < i_max loop
                var j = j0
                when j < j_max loop
                    let val = read_word(src, (i * cols + j) * 8)
                    write_word(dst, (j * rows + i) * 8, val)
                    j = j + 1
                end
                i = i + 1
            end

            j0 = j0 + block_sz
        end
        i0 = i0 + block_sz
    end
end.

# Matrix Multiplication: Polyhedral Tiled Kernel
# C[i, j] = sum(A[i, k] * B[k, j]) for N x N matrix
func mat_mul_tiled(a, b, c, n, block_sz):
    var i0 = 0
    when i0 < n loop
        let i_max = min_val(i0 + block_sz, n)
        var j0 = 0
        when j0 < n loop
            let j_max = min_val(j0 + block_sz, n)
            var k0 = 0
            when k0 < n loop
                let k_max = min_val(k0 + block_sz, n)

                # Intra-tile matrix multiply
                var i = i0
                when i < i_max loop
                    var j = j0
                    when j < j_max loop
                        var sum = read_word(c, (i * n + j) * 8)
                        var k = k0
                        when k < k_max loop
                            let a_ik = read_word(a, (i * n + k) * 8)
                            let b_kj = read_word(b, (k * n + j) * 8)
                            sum = sum + (a_ik * b_kj)
                            k = k + 1
                        end
                        write_word(c, (i * n + j) * 8, sum)
                        j = j + 1
                    end
                    i = i + 1
                end

                k0 = k0 + block_sz
            end
            j0 = j0 + block_sz
        end
        i0 = i0 + block_sz
    end
end.

func main:
    # TEST 1: Matrix Transpose Parity (16 x 16 Matrix)
    let rows = 16
    let cols = 16
    let total_elems = rows * cols
    let mat_src = alloc(total_elems * 8)
    let mat_dst_naive = alloc(total_elems * 8)
    let mat_dst_tiled = alloc(total_elems * 8)

    var i = 0
    when i < total_elems loop
        write_word(mat_src, i * 8, (i * 17 + 3) bit_and 0xFFFF)
        i = i + 1
    end

    mat_transpose_naive(mat_src, mat_dst_naive, rows, cols)
    mat_transpose_tiled(mat_src, mat_dst_tiled, rows, cols, 4) # Tile size = 4

    # Verify 100% mathematical parity across all elements
    i = 0
    when i < total_elems loop
        assert(read_word(mat_dst_naive, i * 8) == read_word(mat_dst_tiled, i * 8))
        i = i + 1
    end

    # TEST 2: Matrix Multiplication Tiling (4 x 4 Matrix)
    let n = 4
    let mat_a = alloc(n * n * 8)
    let mat_b = alloc(n * n * 8)
    let mat_c = alloc(n * n * 8)

    # Initialize A as Identity Matrix, B as Test Matrix
    var r = 0
    when r < n loop
        var c = 0
        when c < n loop
            var is_diag = 0
            if r == c do
                is_diag = 1
            end
            write_word(mat_a, (r * n + c) * 8, is_diag)
            write_word(mat_b, (r * n + c) * 8, (r * n + c + 1))
            write_word(mat_c, (r * n + c) * 8, 0)
            c = c + 1
        end
        r = r + 1
    end

    # C = A * B = Identity * B = B
    mat_mul_tiled(mat_a, mat_b, mat_c, n, 2)

    r = 0
    when r < n loop
        var c = 0
        when c < n loop
            let expected = read_word(mat_b, (r * n + c) * 8)
            let actual = read_word(mat_c, (r * n + c) * 8)
            assert(actual == expected)
            c = c + 1
        end
        r = r + 1
    end

    out 0
end.
