# Phase E1: Test std/sync/atomic — Atomic Primitives & Memory Operations (Spec §9, stdlib/vir/sync)

# In Vir compiler, atomic builtins are mapped:
# atomic_load(ptr) -> LDAR X0, [X0]
# atomic_store(ptr, val) -> STLR X1, [X0]
# atomic_add(ptr, val) -> LDXR/ADD/STXR loop, returns old value
# atomic_cas(ptr, expected, desired) -> LDXR/CMP/STXR loop, returns 1 on success, 0 on failure
# atomic_fence() -> DMB ISH

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let cell = alloc(8)
    write_word(cell, 0, 0)

    # 1. atomic_store and atomic_load
    atomic_store(cell, 42)
    assert(atomic_load(cell) == 42)

    atomic_store(cell, 1000)
    assert(atomic_load(cell) == 1000)

    # 2. atomic_add
    let old1 = atomic_add(cell, 250)
    assert(old1 == 1000)
    assert(atomic_load(cell) == 1250)

    let old2 = atomic_add(cell, 0 - 50) # Subtract 50
    assert(old2 == 1250)
    assert(atomic_load(cell) == 1200)

    # 3. atomic_cas (Compare-And-Swap)
    # Failed CAS: expected 999 != actual 1200 -> memory remains 1200
    let cas_fail = atomic_cas(cell, 999, 5000)
    assert(cas_fail == 0)
    assert(atomic_load(cell) == 1200)

    # Successful CAS: expected 1200 == actual 1200 -> memory becomes 5000
    let cas_ok = atomic_cas(cell, 1200, 5000)
    assert(cas_ok == 1)
    assert(atomic_load(cell) == 5000)

    # Subsequent CAS with old value 1200 will fail
    assert(atomic_cas(cell, 1200, 9999) == 0)
    assert(atomic_load(cell) == 5000)

    # 4. atomic_fence
    atomic_fence()
    assert(atomic_load(cell) == 5000)

    out 0
end.
