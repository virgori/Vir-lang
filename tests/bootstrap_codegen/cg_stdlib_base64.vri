# Phase G2: Test std/encode/base64 — RFC 4648 Base64 Encoding & Decoding (Spec §9, stdlib/vir/encode)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func b64_char(val):
    if val < 26 do out 65 + val end # 'A'..'Z'
    if val < 52 do out 97 + (val - 26) end # 'a'..'z'
    if val < 62 do out 48 + (val - 52) end # '0'..'9'
    if val == 62 do out 43 end # '+'
    if val == 63 do out 47 end # '/'
    out 61 # '='
end.

func b64_val(c):
    if (c >= 65) and (c <= 90) do out c - 65 end
    if (c >= 97) and (c <= 122) do out c - 97 + 26 end
    if (c >= 48) and (c <= 57) do out c - 48 + 52 end
    if c == 43 do out 62 end
    if c == 47 do out 63 end
    out 0 - 1
end.

func base64_encode(src, len, out_str):
    var dst_idx = 0
    var i = 0
    when (i + 2) < len loop
        let b0 = read_byte(src, i)
        let b1 = read_byte(src, i + 1)
        let b2 = read_byte(src, i + 2)

        write_byte(out_str, dst_idx, b64_char((b0 shr 2) bit_and 63))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, b64_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, b64_char(((b1 shl 2) bit_or (b2 shr 6)) bit_and 63))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, b64_char(b2 bit_and 63))
        dst_idx = dst_idx + 1

        i = i + 3
    end

    let rem = len - i
    if rem == 1 do
        let b0 = read_byte(src, i)
        write_byte(out_str, dst_idx, b64_char((b0 shr 2) bit_and 63))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, b64_char((b0 shl 4) bit_and 63))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, 61) # '='
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, 61) # '='
        dst_idx = dst_idx + 1
    else
        if rem == 2 do
            let b0 = read_byte(src, i)
            let b1 = read_byte(src, i + 1)
            write_byte(out_str, dst_idx, b64_char((b0 shr 2) bit_and 63))
            dst_idx = dst_idx + 1
            write_byte(out_str, dst_idx, b64_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63))
            dst_idx = dst_idx + 1
            write_byte(out_str, dst_idx, b64_char((b1 shl 2) bit_and 63))
            dst_idx = dst_idx + 1
            write_byte(out_str, dst_idx, 61) # '='
            dst_idx = dst_idx + 1
        end
    end

    write_byte(out_str, dst_idx, 0)
    out dst_idx
end.

func base64_decode(src, out_bytes):
    let slen = cstr_len(src)
    if (slen % 4) != 0 do out 0 - 1 end

    var dst_idx = 0
    var i = 0
    when i < slen loop
        let c0 = read_byte(src, i)
        let c1 = read_byte(src, i + 1)
        let c2 = read_byte(src, i + 2)
        let c3 = read_byte(src, i + 3)

        let v0 = b64_val(c0)
        let v1 = b64_val(c1)
        if (v0 == (0 - 1)) or (v1 == (0 - 1)) do out 0 - 1 end

        let b0 = ((v0 shl 2) bit_or (v1 shr 4)) bit_and 255
        write_byte(out_bytes, dst_idx, b0)
        dst_idx = dst_idx + 1

        if c2 != 61 do # not '='
            let v2 = b64_val(c2)
            if v2 == (0 - 1) do out 0 - 1 end
            let b1 = ((v1 shl 4) bit_or (v2 shr 2)) bit_and 255
            write_byte(out_bytes, dst_idx, b1)
            dst_idx = dst_idx + 1

            if c3 != 61 do
                let v3 = b64_val(c3)
                if v3 == (0 - 1) do out 0 - 1 end
                let b2 = ((v2 shl 6) bit_or v3) bit_and 255
                write_byte(out_bytes, dst_idx, b2)
                dst_idx = dst_idx + 1
            end
        end

        i = i + 4
    end

    out dst_idx
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let enc_buf = alloc(128)
    let dec_buf = alloc(128)

    # 1. RFC 4648 Standard Vectors
    # "f" -> "Zg=="
    base64_encode("f", 1, enc_buf)
    assert(cstr_eq(enc_buf, "Zg==") == 1)
    let d1 = base64_decode(enc_buf, dec_buf)
    assert(d1 == 1)
    write_byte(dec_buf, d1, 0)
    assert(cstr_eq(dec_buf, "f") == 1)

    # "fo" -> "Zm8="
    base64_encode("fo", 2, enc_buf)
    assert(cstr_eq(enc_buf, "Zm8=") == 1)
    let d2 = base64_decode(enc_buf, dec_buf)
    assert(d2 == 2)
    write_byte(dec_buf, d2, 0)
    assert(cstr_eq(dec_buf, "fo") == 1)

    # "foo" -> "Zm9v"
    base64_encode("foo", 3, enc_buf)
    assert(cstr_eq(enc_buf, "Zm9v") == 1)
    let d3 = base64_decode(enc_buf, dec_buf)
    assert(d3 == 3)
    write_byte(dec_buf, d3, 0)
    assert(cstr_eq(dec_buf, "foo") == 1)

    # "foobar" -> "Zm9vYmFy"
    base64_encode("foobar", 6, enc_buf)
    assert(cstr_eq(enc_buf, "Zm9vYmFy") == 1)
    let d6 = base64_decode(enc_buf, dec_buf)
    assert(d6 == 6)
    write_byte(dec_buf, d6, 0)
    assert(cstr_eq(dec_buf, "foobar") == 1)

    # 2. Vir phrase test
    let phrase = "Vir 2.0 Native"
    let plen = cstr_len(phrase)
    base64_encode(phrase, plen, enc_buf)
    assert(cstr_eq(enc_buf, "VmlyIDIuMCBOYXRpdmU=") == 1)

    let dp = base64_decode(enc_buf, dec_buf)
    assert(dp == plen)
    write_byte(dec_buf, dp, 0)
    assert(cstr_eq(dec_buf, phrase) == 1)

    out 0
end.
