# EXPECT_START
# 100
# 200
# 999
# 2
# 1
# EXPECT_END
# §20: Dict key equality and mutations using str_concat and string builtins

func main:
    var d = ["alpha": 100, "beta": 200]
    var k1: string = str_concat("al", "pha")
    var k2: string = str_concat("be", "ta")
    print d[k1]
    print d[k2]

    d[k1] = 999
    print d["alpha"]
    print len(d)

    var has_alpha: bool = str_eq(k1, "alpha")
    if has_alpha do
        print 1
    else
        print 0
    end
end.
