# Phase E3: Test std/sync/rwlock — Reader-Writer Lock (Spec §9, stdlib/vir/sync)

# RwLock state (stored in 64-bit atomic word):
#  >= 0 : number of concurrent readers (0 = free)
#  -1   : exclusive writer held

func rwlock_create:
    let l = alloc(8)
    write_word(l, 0, 0)
    out l
end.

func rwlock_try_read_lock(l):
    let cur = atomic_load(l)
    if cur < 0 do
        out 0 # Writer present
    end
    out atomic_cas(l, cur, cur + 1)
end.

func rwlock_read_lock(l):
    var acquired = 0
    when acquired == 0 loop
        let cur = atomic_load(l)
        if cur >= 0 do
            if atomic_cas(l, cur, cur + 1) == 1 do
                acquired = 1
            end
        end
    end
end.

func rwlock_read_unlock(l):
    atomic_add(l, 0 - 1)
end.

func rwlock_try_write_lock(l):
    # Only succeeds if currently completely free (0)
    out atomic_cas(l, 0, 0 - 1)
end.

func rwlock_write_lock(l):
    var acquired = 0
    when acquired == 0 loop
        if atomic_cas(l, 0, 0 - 1) == 1 do
            acquired = 1
        end
    end
end.

func rwlock_write_unlock(l):
    atomic_store(l, 0)
end.

func rwlock_state(l):
    out atomic_load(l)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let rw = rwlock_create()
    assert(rwlock_state(rw) == 0)

    # 1. Multiple readers can acquire concurrently
    assert(rwlock_try_read_lock(rw) == 1)
    assert(rwlock_state(rw) == 1)

    assert(rwlock_try_read_lock(rw) == 1)
    assert(rwlock_state(rw) == 2)

    assert(rwlock_try_read_lock(rw) == 1)
    assert(rwlock_state(rw) == 3)

    # 2. Writer cannot acquire while readers are active
    assert(rwlock_try_write_lock(rw) == 0)
    assert(rwlock_state(rw) == 3)

    # 3. Release readers one by one
    rwlock_read_unlock(rw)
    assert(rwlock_state(rw) == 2)

    rwlock_read_unlock(rw)
    assert(rwlock_state(rw) == 1)

    rwlock_read_unlock(rw)
    assert(rwlock_state(rw) == 0)

    # 4. Writer can acquire when no readers are active
    assert(rwlock_try_write_lock(rw) == 1)
    assert(rwlock_state(rw) == (0 - 1))

    # 5. Readers cannot acquire while writer is active
    assert(rwlock_try_read_lock(rw) == 0)
    assert(rwlock_try_write_lock(rw) == 0)

    # 6. Release writer
    rwlock_write_unlock(rw)
    assert(rwlock_state(rw) == 0)

    # 7. Reader can acquire again
    rwlock_read_lock(rw)
    assert(rwlock_state(rw) == 1)
    rwlock_read_unlock(rw)
    assert(rwlock_state(rw) == 0)

    out 0
end.
