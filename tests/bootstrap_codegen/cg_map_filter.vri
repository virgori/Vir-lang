func main:
    var nums = [1, 2, 3, 4]
    var evens = map x in nums:
        if x mod 2 == 0 do
            out x
        end
    end.
    print len(evens)
    print evens[0]
    print evens[1]

    var scaled = map x in nums:
        out x * 4
    end.
    print scaled[0]
    print scaled[1]
    print scaled[2]
    print scaled[3]
end.
