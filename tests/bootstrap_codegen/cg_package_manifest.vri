# Test: Third-Party Package Manifest & Dependency DAG Resolver (Spec §9, stdlib/vir/package)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# Package Node layout (32 bytes):
# word 0: name (cstr)
# word 8: dep_count
# word 16: deps array (indices of dependencies)
# word 24: visited status (0=unvisited, 1=visiting/cycle, 2=resolved)

func pkg_create(name, deps_array, dep_count):
    let p = alloc(32)
    write_word(p, 0, name)
    write_word(p, 8, dep_count)
    write_word(p, 16, deps_array)
    write_word(p, 24, 0)
    out p
end.

# Depth-First Search Topological Sort for Dependency Graph Resolution
func topo_sort_visit(pkgs, node_idx, out_order, order_idx):
    let node = read_word(pkgs, node_idx * 8)
    let status = read_word(node, 24)
    if status == 2 do
        # Already resolved
        out order_idx
    end
    if status == 1 do
        # Cycle detected!
        out 0 - 1
    end

    # Mark visiting
    write_word(node, 24, 1)

    let dep_cnt = read_word(node, 8)
    let deps = read_word(node, 16)
    var i = 0
    when i < dep_cnt loop
        let dep_idx = read_word(deps, i * 8)
        order_idx = topo_sort_visit(pkgs, dep_idx, out_order, order_idx)
        if order_idx < 0 do
            out 0 - 1
        end
        i = i + 1
    end

    # Mark resolved
    write_word(node, 24, 2)
    write_word(out_order, order_idx * 8, node_idx)
    out order_idx + 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Construct Package Dependency Graph:
    # Index 0: "core_mem"    (0 deps)
    # Index 1: "http_parser" (depends on core_mem: [0])
    # Index 2: "sqlite_ffi"  (depends on core_mem: [0])
    # Index 3: "web_server"  (depends on http_parser: [1])
    # Index 4: "db_driver"   (depends on sqlite_ffi: [2])
    # Index 5: "my_app"      (depends on web_server and db_driver: [3, 4])

    let pkgs = alloc(6 * 8)

    # 0: core_mem
    write_word(pkgs, 0 * 8, pkg_create("core_mem", 0, 0))

    # 1: http_parser -> [0]
    let deps_1 = alloc(1 * 8)
    write_word(deps_1, 0, 0)
    write_word(pkgs, 1 * 8, pkg_create("http_parser", deps_1, 1))

    # 2: sqlite_ffi -> [0]
    let deps_2 = alloc(1 * 8)
    write_word(deps_2, 0, 0)
    write_word(pkgs, 2 * 8, pkg_create("sqlite_ffi", deps_2, 1))

    # 3: web_server -> [1]
    let deps_3 = alloc(1 * 8)
    write_word(deps_3, 0, 1)
    write_word(pkgs, 3 * 8, pkg_create("web_server", deps_3, 1))

    # 4: db_driver -> [2]
    let deps_4 = alloc(1 * 8)
    write_word(deps_4, 0, 2)
    write_word(pkgs, 4 * 8, pkg_create("db_driver", deps_4, 1))

    # 5: my_app -> [3, 4]
    let deps_5 = alloc(2 * 8)
    write_word(deps_5, 0, 3)
    write_word(deps_5, 8, 4)
    write_word(pkgs, 5 * 8, pkg_create("my_app", deps_5, 2))

    # 2. Resolve Topological Build Order
    let build_order = alloc(6 * 8)
    let total_resolved = topo_sort_visit(pkgs, 5, build_order, 0)

    assert(total_resolved == 6)

    # First resolved package MUST be core_mem (index 0)
    assert(read_word(build_order, 0 * 8) == 0)

    # Last resolved package MUST be my_app (index 5)
    assert(read_word(build_order, 5 * 8) == 5)

    # Verify dependency invariant: for every dependency, it must appear BEFORE the dependent in build_order
    # Helper index positions:
    var pos_core = 0
    var pos_http = 0
    var pos_sql = 0
    var pos_web = 0
    var pos_db = 0
    var pos_app = 0

    var i = 0
    when i < 6 loop
        let p_idx = read_word(build_order, i * 8)
        if p_idx == 0 do pos_core = i end
        if p_idx == 1 do pos_http = i end
        if p_idx == 2 do pos_sql = i end
        if p_idx == 3 do pos_web = i end
        if p_idx == 4 do pos_db = i end
        if p_idx == 5 do pos_app = i end
        i = i + 1
    end

    assert(pos_core < pos_http)
    assert(pos_core < pos_sql)
    assert(pos_http < pos_web)
    assert(pos_sql < pos_db)
    assert(pos_web < pos_app)
    assert(pos_db < pos_app)

    out 0
end.
