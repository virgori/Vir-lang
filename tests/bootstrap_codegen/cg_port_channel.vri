# Test port message queues / channels (Spec §16.2)
func main:
    let p = port(16)
    p.send(10)
    p.send(20)
    p.send(30)

    let m1 = p.recv()
    let m2 = p.recv()
    let m3 = p.recv()

    if m1 != 10 do
        out 1
    end
    if m2 != 20 do
        out 2
    end
    if m3 != 30 do
        out 3
    end

    # Reading from empty queue returns 0
    let m4 = p.recv()
    if m4 != 0 do
        out 4
    end

    out 0
end.
