# Phase F2: Test std/net/ip — IPv4 Parsing, Formatting & Classification (Spec §9, stdlib/vir/net)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# Parses "a.b.c.d" into 32-bit integer (a << 24 | b << 16 | c << 8 | d)
func ipv4_parse(s):
    let l = cstr_len(s)
    var octet = 0
    var octet_count = 0
    var res = 0
    var i = 0
    when i < l loop
        let b = read_byte(s, i)
        if b == 46 do # '.'
            if (octet > 255) or (octet_count >= 4) do out 0 - 1 end
            res = (res shl 8) bit_or (octet bit_and 255)
            octet = 0
            octet_count = octet_count + 1
        else
            if (b >= 48) and (b <= 57) do
                octet = octet * 10 + (b - 48)
            else
                out 0 - 1 # Invalid char
            end
        end
        i = i + 1
    end
    if (octet > 255) or (octet_count != 3) do out 0 - 1 end
    res = (res shl 8) bit_or (octet bit_and 255)
    out res
end.

# Writes 1 to 3 digits of number into out_buf at dst_idx_ref, updates *dst_idx_ref
func append_u8_str(num, out_buf, dst_idx):
    if num >= 100 do
        write_byte(out_buf, dst_idx, 48 + (num / 100))
        dst_idx = dst_idx + 1
        let rem = num % 100
        write_byte(out_buf, dst_idx, 48 + (rem / 10))
        dst_idx = dst_idx + 1
        write_byte(out_buf, dst_idx, 48 + (rem % 10))
        out dst_idx + 1
    end
    if num >= 10 do
        write_byte(out_buf, dst_idx, 48 + (num / 10))
        dst_idx = dst_idx + 1
        write_byte(out_buf, dst_idx, 48 + (num % 10))
        out dst_idx + 1
    end
    write_byte(out_buf, dst_idx, 48 + num)
    out dst_idx + 1
end.

func ipv4_format(ip, out_buf):
    let o1 = (ip shr 24) bit_and 255
    let o2 = (ip shr 16) bit_and 255
    let o3 = (ip shr 8) bit_and 255
    let o4 = ip bit_and 255

    var idx = 0
    idx = append_u8_str(o1, out_buf, idx)
    write_byte(out_buf, idx, 46) # '.'
    idx = idx + 1

    idx = append_u8_str(o2, out_buf, idx)
    write_byte(out_buf, idx, 46)
    idx = idx + 1

    idx = append_u8_str(o3, out_buf, idx)
    write_byte(out_buf, idx, 46)
    idx = idx + 1

    idx = append_u8_str(o4, out_buf, idx)
    write_byte(out_buf, idx, 0)
    out out_buf
end.

func ipv4_is_loopback(ip):
    let o1 = (ip shr 24) bit_and 255
    if o1 == 127 do out 1 end
    out 0
end.

func ipv4_is_private(ip):
    let o1 = (ip shr 24) bit_and 255
    let o2 = (ip shr 16) bit_and 255

    # 10.0.0.0/8
    if o1 == 10 do out 1 end

    # 172.16.0.0/12 (172.16 - 172.31)
    if (o1 == 172) and (o2 >= 16) and (o2 <= 31) do out 1 end

    # 192.168.0.0/16
    if (o1 == 192) and (o2 == 168) do out 1 end

    out 0
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let out_buf = alloc(64)

    # 1. Parse & Format 192.168.1.1
    let ip1 = ipv4_parse("192.168.1.1")
    assert(ip1 == 3232235777) # 0xC0A80101
    ipv4_format(ip1, out_buf)
    assert(cstr_eq(out_buf, "192.168.1.1") == 1)
    assert(ipv4_is_private(ip1) == 1)
    assert(ipv4_is_loopback(ip1) == 0)

    # 2. Localhost 127.0.0.1
    let ip_lh = ipv4_parse("127.0.0.1")
    assert(ip_lh == 2130706433) # 0x7F000001
    ipv4_format(ip_lh, out_buf)
    assert(cstr_eq(out_buf, "127.0.0.1") == 1)
    assert(ipv4_is_loopback(ip_lh) == 1)

    # 3. 10.0.0.1 Private Network
    let ip_10 = ipv4_parse("10.0.0.1")
    assert(ipv4_is_private(ip_10) == 1)
    assert(ipv4_is_loopback(ip_10) == 0)

    # 4. 172.20.10.5 Private Network
    let ip_172 = ipv4_parse("172.20.10.5")
    assert(ipv4_is_private(ip_172) == 1)

    # 5. Public IP 8.8.8.8 (Google DNS)
    let ip_pub = ipv4_parse("8.8.8.8")
    assert(ip_pub == 134744072) # 0x08080808
    assert(ipv4_is_private(ip_pub) == 0)
    assert(ipv4_is_loopback(ip_pub) == 0)

    # 6. Invalid IP strings
    assert(ipv4_parse("256.0.0.1") == (0 - 1))
    assert(ipv4_parse("192.168.1") == (0 - 1))
    assert(ipv4_parse("192.168.1.1.5") == (0 - 1))

    out 0
end.
