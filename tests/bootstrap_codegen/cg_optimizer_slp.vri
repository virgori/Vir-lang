# Bootstrap Native Test: Superword-Level Parallelism (SLP Auto-Vectorization)
# ==============================================================================
# Spec §16.4 / Pillar 6 / Tier-4: SLP Vectorization (Larsen & Amarasinghe) finds
# independent isomorphic scalar computations within basic blocks and packs them
# into single 128-bit vector SIMD registers (4 x 32-bit / 2 x 64-bit lanes),
# speeding up point/color/coordinate math (x, y, z, w) and parallel buffer stores.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# 128-bit Quad-Word (4 x 32-bit integers packed into two 64-bit words)
# word 0: lane0 (low 32) | (lane1 << 32)
# word 1: lane2 (low 32) | (lane3 << 32)

func slp_pack_4x32(l0, l1, l2, l3, out_vec):
    let w0 = (l0 bit_and 0xFFFFFFFF) bit_or ((l1 bit_and 0xFFFFFFFF) shl 32)
    let w1 = (l2 bit_and 0xFFFFFFFF) bit_or ((l3 bit_and 0xFFFFFFFF) shl 32)
    write_word(out_vec, 0, w0)
    write_word(out_vec, 8, w1)
end.

func slp_unpack_lane(vec, lane_idx):
    if lane_idx == 0 do
        out read_word(vec, 0) bit_and 0xFFFFFFFF
    end
    if lane_idx == 1 do
        out (read_word(vec, 0) shr 32) bit_and 0xFFFFFFFF
    end
    if lane_idx == 2 do
        out read_word(vec, 8) bit_and 0xFFFFFFFF
    end
    if lane_idx == 3 do
        out (read_word(vec, 8) shr 32) bit_and 0xFFFFFFFF
    end
    out 0
end.

# SLP 128-bit Parallel Vector Addition (4 lanes in 1 operation)
func slp_vec_add_4x32(vec_a, vec_b, vec_dst):
    let a0 = slp_unpack_lane(vec_a, 0)
    let a1 = slp_unpack_lane(vec_a, 1)
    let a2 = slp_unpack_lane(vec_a, 2)
    let a3 = slp_unpack_lane(vec_a, 3)

    let b0 = slp_unpack_lane(vec_b, 0)
    let b1 = slp_unpack_lane(vec_b, 1)
    let b2 = slp_unpack_lane(vec_b, 2)
    let b3 = slp_unpack_lane(vec_b, 3)

    # 4 independent additions packed into single vector result
    slp_pack_4x32(a0 + b0, a1 + b1, a2 + b2, a3 + b3, vec_dst)
end.

# 3D Vector Math Simulation (X, Y, Z, W point transformation)
func slp_transform_point_4d(p_vec, d_vec, res_vec):
    slp_vec_add_4x32(p_vec, d_vec, res_vec)
end.

func main:
    # TEST 1: Packing and Unpacking 4x32-bit Vector Lanes
    let v1 = alloc(16)
    slp_pack_4x32(10, 20, 30, 40, v1)
    assert(slp_unpack_lane(v1, 0) == 10)
    assert(slp_unpack_lane(v1, 1) == 20)
    assert(slp_unpack_lane(v1, 2) == 30)
    assert(slp_unpack_lane(v1, 3) == 40)

    # TEST 2: 128-bit Superword Vector Addition
    let v2 = alloc(16)
    slp_pack_4x32(100, 200, 300, 400, v2)

    let v_res = alloc(16)
    slp_vec_add_4x32(v1, v2, v_res)

    assert(slp_unpack_lane(v_res, 0) == 110)
    assert(slp_unpack_lane(v_res, 1) == 220)
    assert(slp_unpack_lane(v_res, 2) == 330)
    assert(slp_unpack_lane(v_res, 3) == 440)

    # TEST 3: 4D Point Translation (Position + Velocity Vector)
    let p_in = alloc(16)
    let d_in = alloc(16)
    slp_pack_4x32(1, 2, 3, 1, p_in)
    slp_pack_4x32(10, 20, 30, 0, d_in)

    let p_out = alloc(16)
    slp_transform_point_4d(p_in, d_in, p_out)

    assert(slp_unpack_lane(p_out, 0) == 11) # X: 1 + 10 = 11
    assert(slp_unpack_lane(p_out, 1) == 22) # Y: 2 + 20 = 22
    assert(slp_unpack_lane(p_out, 2) == 33) # Z: 3 + 30 = 33
    assert(slp_unpack_lane(p_out, 3) == 1)  # W: 1 + 0  = 1

    out 0
end.
