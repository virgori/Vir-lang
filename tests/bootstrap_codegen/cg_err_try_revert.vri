# Test local try ... revert block (§13.7)
func calc_with_try(val):
    var status = 0
    try:
        if val < 0 do
            throw 99
        end
        status = val * 2
    revert:
        status = 1000 + err
    end
    out status
end.

func main:
    let s1 = calc_with_try(10)
    if s1 != 20 do
        out 1
    end
    let s2 = calc_with_try(0 - 5)
    if s2 != 1099 do
        out 2
    end
    out 0
end.
