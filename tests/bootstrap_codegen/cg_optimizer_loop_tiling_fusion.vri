# Bootstrap Native Test: Polyhedral Loop Tiling, Fusion, and Interchange
# ==============================================================================
# Spec Section 4.8.7 / Pillar 6: Restructures loop nests to fit L1 Cache (32KB),
# fuses adjacent loops traversing identical memory, and converts stride-N to stride-1.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# 1. LOOP FUSION: Merges two separate loops into 1 single pass over array
func loop_fusion_compute(arr_a, arr_b, n):
    var sum = 0
    var i = 0
    # Fused loop: Computes both f(x) and g(x) in a single cache-friendly pass
    when i < n loop
        let va = i * 3 + 1
        let vb = i * 5 + 2
        write_word(arr_a, i * 8, va)
        write_word(arr_b, i * 8, vb)
        sum = sum + (va ^ vb)
        i = i + 1
    end
    out sum
end.

# 2. LOOP TILING: Computes matrix tile bounds to fit into L1 Data Cache
func loop_tiling_compute_tiles(matrix_dim, tile_size):
    # Total tiles = (matrix_dim + tile_size - 1) / tile_size
    let total_tiles = (matrix_dim + tile_size - 1) / tile_size
    out total_tiles * total_tiles
end.

# 3. LOOP INTERCHANGE: Determines if loop order should be swapped for Stride-1
func loop_should_interchange(is_row_major, current_outer_is_row):
    # If row-major matrix and outer loop iterates over columns, swap to row-outer!
    if is_row_major == 1 do
        if current_outer_is_row == 0 do
            out 1 # Swap to outer-row, inner-col for Stride-1 sequential access!
        end
    end
    out 0
end.

func main:
    # 1. VERIFY LOOP FUSION:
    let buf_a = alloc(100 * 8)
    let buf_b = alloc(100 * 8)
    let fused_sum = loop_fusion_compute(buf_a, buf_b, 100)
    assert(fused_sum > 0)

    # Check that element 5 was correctly written by fused pass:
    let elem_a5 = read_word(buf_a, 5 * 8)
    let elem_b5 = read_word(buf_b, 5 * 8)
    assert(elem_a5 == 16) # 5*3 + 1 = 16
    assert(elem_b5 == 27) # 5*5 + 2 = 27

    # 2. VERIFY LOOP TILING:
    # 1024x1024 matrix with 64x64 tiles -> 16x16 = 256 tiles
    let tiles = loop_tiling_compute_tiles(1024, 64)
    assert(tiles == 256)

    # 3. VERIFY LOOP INTERCHANGE:
    # Row-major matrix with column-outer iteration (0) -> should interchange (1)
    let swap1 = loop_should_interchange(1, 0)
    assert(swap1 == 1)

    # Row-major matrix with row-outer iteration (1) -> already optimal (0)
    let swap2 = loop_should_interchange(1, 1)
    assert(swap2 == 0)

    out 0
end.
