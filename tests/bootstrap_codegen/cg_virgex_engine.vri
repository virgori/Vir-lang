# Test: Virgex — Vir Pattern Syntax (VPS) Engine & Thompson NFA in Pure Vir (Spec §9, virgex)

# Character predicates:
func is_digit_char(c):
    out (c >= 48) and (c <= 57) # '0'..'9'
end.

func is_upper_char(c):
    out (c >= 65) and (c <= 90) # 'A'..'Z'
end.

func is_lower_char(c):
    out (c >= 97) and (c <= 122) # 'a'..'z'
end.

func is_alpha_char(c):
    out is_upper_char(c) or is_lower_char(c)
end.

func is_alnum_char(c):
    out is_alpha_char(c) or is_digit_char(c)
end.

# Predicate match helper:
# pred_type:
# 1 = literal byte (val = expected_char)
# 2 = @0 (digit)
# 3 = @AZ (upper)
# 4 = @az (lower)
# 5 = @Az (alpha)
# 6 = @Az0 (alnum)
# 7 = any char (.)
func match_pred(pred_type, pred_val, c):
    if pred_type == 1 do out c == pred_val end
    if pred_type == 2 do out is_digit_char(c) end
    if pred_type == 3 do out is_upper_char(c) end
    if pred_type == 4 do out is_lower_char(c) end
    if pred_type == 5 do out is_alpha_char(c) end
    if pred_type == 6 do out is_alnum_char(c) end
    if pred_type == 7 do out c != 0 end
    out 0
end.

# NFA State representation:
# Each state occupies 32 bytes:
# word 0: pred_type (0 = epsilon transition)
# word 8: pred_val (literal character code if pred_type == 1)
# word 16: out1 (next state pointer 1)
# word 24: out2 (next state pointer 2 for branching epsilon transitions, or 0)
# (State marked with pred_type == -1 is Accept state)

func nfa_new_state(pred_type, pred_val, out1, out2):
    let s = alloc(32)
    write_word(s, 0, pred_type)
    write_word(s, 8, pred_val)
    write_word(s, 16, out1)
    write_word(s, 24, out2)
    out s
end.

func nfa_accept_state:
    out nfa_new_state(0 - 1, 0, 0, 0)
end.

# Thompson NFA Multi-State Simulation Set
# Set buffer: word 0 = count, words 8.. = state pointers
func state_set_new:
    let s = alloc(1024)
    write_word(s, 0, 0)
    out s
end.

func state_set_clear(s):
    write_word(s, 0, 0)
end.

func state_set_add_state(s, st):
    if st == 0 do out 0 end
    let count = read_word(s, 0)
    # Check if already present
    var i = 0
    when i < count loop
        if read_word(s, (i + 1) * 8) == st do
            out 0
        end
        i = i + 1
    end

    # If epsilon transition (pred_type == 0), follow branches recursively
    let p_type = read_word(st, 0)
    if p_type == 0 do
        let o1 = read_word(st, 16)
        let o2 = read_word(st, 24)
        state_set_add_state(s, o1)
        if o2 != 0 do
            state_set_add_state(s, o2)
        end
        out 0
    end

    # Add state
    write_word(s, (count + 1) * 8, st)
    write_word(s, 0, count + 1)
    out 1
end.

# Simulates NFA matching on an ASCII input string
func nfa_match(start_state, input_str):
    let current_set = state_set_new()
    let next_set = state_set_new()

    # Initialize with start state epsilon closure
    state_set_add_state(current_set, start_state)

    var input_pos = 0
    var c = read_byte(input_str, input_pos)

    when c != 0 loop
        state_set_clear(next_set)
        let cur_cnt = read_word(current_set, 0)
        var i = 0
        when i < cur_cnt loop
            let st = read_word(current_set, (i + 1) * 8)
            let p_type = read_word(st, 0)
            let p_val = read_word(st, 8)
            if match_pred(p_type, p_val, c) == 1 do
                let target = read_word(st, 16)
                state_set_add_state(next_set, target)
            end
            i = i + 1
        end

        # Swap sets
        let cnt_next = read_word(next_set, 0)
        write_word(current_set, 0, cnt_next)
        i = 0
        when i < cnt_next loop
            write_word(current_set, (i + 1) * 8, read_word(next_set, (i + 1) * 8))
            i = i + 1
        end

        input_pos = input_pos + 1
        c = read_byte(input_str, input_pos)
    end

    # Check if accept state (pred_type == -1) is reached
    let final_cnt = read_word(current_set, 0)
    var i = 0
    when i < final_cnt loop
        let st = read_word(current_set, (i + 1) * 8)
        if read_word(st, 0) == (0 - 1) do
            out 1 # Matched!
        end
        i = i + 1
    end

    out 0 # No match
end.

# Helper: build chained predicate NFA
# e.g. exact N repetitions of predicate
func build_repeated_pred(pred_type, count, accept_st):
    var cur = accept_st
    var i = 0
    when i < count loop
        cur = nfa_new_state(pred_type, 0, cur, 0)
        i = i + 1
    end
    out cur
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # ═══════════════════════════════════════════════════════
    # Test 1: | @0!3 | (Exactly 3 digits)
    # ═══════════════════════════════════════════════════════
    let acc = nfa_accept_state()
    let nfa_3digits = build_repeated_pred(2, 3, acc) # pred 2 = @0 (digit)

    assert(nfa_match(nfa_3digits, "123") == 1)
    assert(nfa_match(nfa_3digits, "456") == 1)
    assert(nfa_match(nfa_3digits, "000") == 1)
    assert(nfa_match(nfa_3digits, "12") == 0)   # too short
    assert(nfa_match(nfa_3digits, "1234") == 0) # too long
    assert(nfa_match(nfa_3digits, "abc") == 0)  # letters

    # ═══════════════════════════════════════════════════════
    # Test 2: | @AZ!2 $- @0!5 | (License plate: e.g. "HN-12345")
    # ═══════════════════════════════════════════════════════
    # Sequence: 2 Upper -> 1 Dash '-' (45) -> 5 Digits -> Accept
    let acc2 = nfa_accept_state()
    let s_5digits = build_repeated_pred(2, 5, acc2)
    let s_dash = nfa_new_state(1, 45, s_5digits, 0) # 45 = '-'
    let s_plate = build_repeated_pred(3, 2, s_dash)  # pred 3 = @AZ (upper)

    assert(nfa_match(s_plate, "HN-12345") == 1)
    assert(nfa_match(s_plate, "SG-99999") == 1)
    assert(nfa_match(s_plate, "H-12345") == 0)   # 1 letter
    assert(nfa_match(s_plate, "HNA-12345") == 0) # 3 letters
    assert(nfa_match(s_plate, "hn-12345") == 0)  # lowercase
    assert(nfa_match(s_plate, "HN-1234") == 0)   # 4 digits

    # ═══════════════════════════════════════════════════════
    # Test 3: | :( A | B :) | Alternation ("red" or "blue")
    # ═══════════════════════════════════════════════════════
    let acc3 = nfa_accept_state()
    # Branch 1: 'r' -> 'e' -> 'd' -> acc
    let d = nfa_new_state(1, 100, acc3, 0) # 'd'
    let e = nfa_new_state(1, 101, d, 0)    # 'e'
    let r = nfa_new_state(1, 114, e, 0)    # 'r'

    # Branch 2: 'b' -> 'l' -> 'u' -> 'e' -> acc
    let e2 = nfa_new_state(1, 101, acc3, 0) # 'e'
    let u = nfa_new_state(1, 117, e2, 0)   # 'u'
    let l = nfa_new_state(1, 108, u, 0)    # 'l'
    let b = nfa_new_state(1, 98, l, 0)     # 'b'

    # Epsilon split: branch to 'r' or 'b'
    let alt_start = nfa_new_state(0, 0, r, b)

    assert(nfa_match(alt_start, "red") == 1)
    assert(nfa_match(alt_start, "blue") == 1)
    assert(nfa_match(alt_start, "green") == 0)
    assert(nfa_match(alt_start, "re") == 0)

    # ═══════════════════════════════════════════════════════
    # Test 4: | @Az0!3~5 | (Alphanumeric range 3 to 5 chars)
    # ═══════════════════════════════════════════════════════
    let acc4 = nfa_accept_state()
    # 5th char -> acc
    let c5 = nfa_new_state(6, 0, acc4, 0)
    # 4th char -> acc OR c5
    let c4 = nfa_new_state(6, 0, acc4, 0) # branching via epsilon
    let eps4 = nfa_new_state(0, 0, acc4, c5)
    let c4_step = nfa_new_state(6, 0, eps4, 0)
    let eps3 = nfa_new_state(0, 0, acc4, c4_step)
    let c3 = nfa_new_state(6, 0, eps3, 0)
    let c2 = nfa_new_state(6, 0, c3, 0)
    let c1 = nfa_new_state(6, 0, c2, 0)

    assert(nfa_match(c1, "abc") == 1)   # len 3
    assert(nfa_match(c1, "abc1") == 1)  # len 4
    assert(nfa_match(c1, "abc12") == 1) # len 5
    assert(nfa_match(c1, "ab") == 0)    # len 2 (too short)
    assert(nfa_match(c1, "abc123") == 0)# len 6 (too long)
    assert(nfa_match(c1, "ab-") == 0)   # invalid char '-'

    out 0
end.
