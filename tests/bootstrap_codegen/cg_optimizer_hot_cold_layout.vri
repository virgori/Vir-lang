# Bootstrap Native Test: Hot/Cold Field Splitting and Spatial Co-location
# ==============================================================================
# Spec Section 4.8.8 / Pillar 6: Splits structs into Hot (L1 cache-friendly) and
# Cold partitions, co-locates equal-lifetime objects into 64B cache lines,
# and converts Array-of-Structures (AoS) to Structure-of-Arrays (SoA) for SIMD.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# 1. HOT/COLD FIELD PARTITIONING:
# Hot buffer contains only active computational fields (id, balance, score = 24 bytes)
# Cold buffer contains payload metadata (strings, extra payload) placed in secondary memory
func hot_partition_process_batch(hot_buf, n):
    var total_score = 0
    var i = 0
    # Iterates exclusively over tightly-packed Hot fields (3 users per 64B cache line!)
    when i < n loop
        let balance = read_word(hot_buf, i * 24 + 8)
        let score = read_word(hot_buf, i * 24 + 16)
        total_score = total_score + (balance * score)
        i = i + 1
    end
    out total_score
end.

# 2. SPATIAL CO-LOCATION: Checks if two related objects fit into one 64-byte Cache Line
func spatial_colocation_can_fit_cacheline(sz1, sz2):
    let total_sz = sz1 + sz2
    if total_sz <= 64 do
        out 1 # Co-located in same 64B cache line -> 0 second-access cache miss!
    end
    out 0
end.

# 3. AOS TO SOA TRANSFORMATION: Computes contiguous offset for vector lane loading
func aos_to_soa_lane_offset(field_index, element_index, total_elements):
    # In SoA, each field is stored contiguously: base + field_index * total_elements + elem_idx
    out (field_index * total_elements) + element_index
end.

func main:
    # 1. VERIFY HOT/COLD FIELD PROCESSING:
    # Allocate hot buffer for 10 records: 10 * 24 bytes = 240 bytes
    let hot_buf = alloc(10 * 24)
    var j = 0
    when j < 10 loop
        write_word(hot_buf, j * 24 + 0, j + 100) # ID
        write_word(hot_buf, j * 24 + 8, j * 10)  # Balance
        write_word(hot_buf, j * 24 + 16, 2)      # Score multiplier
        j = j + 1
    end

    # Process hot batch: sum of (balance * 2) = (0 + 10 + 20 + ... + 90) * 2 = 450 * 2 = 900
    let total = hot_partition_process_batch(hot_buf, 10)
    assert(total == 900)

    # 2. VERIFY SPATIAL CO-LOCATION:
    # OrderHeader (24B) + OrderSummary (32B) = 56B <= 64B -> Fits in 1 Cache Line!
    let fit1 = spatial_colocation_can_fit_cacheline(24, 32)
    assert(fit1 == 1)

    # LargeHeader (48B) + LargePayload (32B) = 80B > 64B -> Exceeds single cache line
    let fit2 = spatial_colocation_can_fit_cacheline(48, 32)
    assert(fit2 == 0)

    # 3. VERIFY AOS TO SOA OFFSET COMPUTATION:
    # 1000 particles, field 0 (X coords), element 5 -> offset 5
    let off_x5 = aos_to_soa_lane_offset(0, 5, 1000)
    assert(off_x5 == 5)

    # 1000 particles, field 1 (Y coords), element 5 -> offset 1005
    let off_y5 = aos_to_soa_lane_offset(1, 5, 1000)
    assert(off_y5 == 1005)

    out 0
end.
