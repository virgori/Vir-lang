# Phase C1: Test std/collections/hashmap — Linear Probing Open Addressing HashMap (Spec §9, stdlib/vir/collections)

func hm_hash(key, cap):
    # Knuth multiplicative hash for integers
    let h = (key * 2654435761) bit_and 0x7FFFFFFF
    out h % cap
end.

# Map layout at ptr:
# word 0: capacity
# word 1: count
# word 2: keys array ptr (i64)
# word 3: vals array ptr (i64)
# word 4: state array ptr (i64: 0=empty, 1=occupied, 2=tombstone)
func map_create(cap):
    let m = alloc(40)
    write_word(m, 0, cap)
    write_word(m, 8, 0) # count = 0
    let keys = alloc(cap * 8)
    let vals = alloc(cap * 8)
    let state = alloc(cap * 8)
    var i = 0
    when i < cap loop
        write_word(keys, i * 8, 0)
        write_word(vals, i * 8, 0)
        write_word(state, i * 8, 0)
        i = i + 1
    end
    write_word(m, 16, keys)
    write_word(m, 24, vals)
    write_word(m, 32, state)
    out m
end.

func map_put(m, key, val):
    let cap = read_word(m, 0)
    let keys = read_word(m, 16)
    let vals = read_word(m, 24)
    let state = read_word(m, 32)
    var idx = hm_hash(key, cap)
    var first_tombstone = 0 - 1
    var probe = 0
    var inserted = 0
    when (probe < cap) and (inserted == 0) loop
        let s = read_word(state, idx * 8)
        if s == 0 do
            # Empty slot found
            if first_tombstone != (0 - 1) do
                idx = first_tombstone
            end
            write_word(keys, idx * 8, key)
            write_word(vals, idx * 8, val)
            write_word(state, idx * 8, 1)
            let cnt = read_word(m, 8)
            write_word(m, 8, cnt + 1)
            inserted = 1
        else
            if s == 1 do
                if read_word(keys, idx * 8) == key do
                    # Key exists, update value
                    write_word(vals, idx * 8, val)
                    inserted = 2 # updated
                end
            else
                # Tombstone (s == 2)
                if first_tombstone == (0 - 1) do
                    first_tombstone = idx
                end
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out inserted
end.

func map_get(m, key):
    let cap = read_word(m, 0)
    let keys = read_word(m, 16)
    let vals = read_word(m, 24)
    let state = read_word(m, 32)
    var idx = hm_hash(key, cap)
    var probe = 0
    when probe < cap loop
        let s = read_word(state, idx * 8)
        if s == 0 do
            out 0 - 1 # Not found
        end
        if s == 1 do
            if read_word(keys, idx * 8) == key do
                out read_word(vals, idx * 8)
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out 0 - 1
end.

func map_contains(m, key):
    let res = map_get(m, key)
    if res == (0 - 1) do
        out 0
    end
    out 1
end.

func map_remove(m, key):
    let cap = read_word(m, 0)
    let keys = read_word(m, 16)
    let state = read_word(m, 32)
    var idx = hm_hash(key, cap)
    var probe = 0
    when probe < cap loop
        let s = read_word(state, idx * 8)
        if s == 0 do
            out 0 # Not found
        end
        if s == 1 do
            if read_word(keys, idx * 8) == key do
                write_word(state, idx * 8, 2) # Mark tombstone
                let cnt = read_word(m, 8)
                write_word(m, 8, cnt - 1)
                out 1 # Removed
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out 0
end.

func map_count(m):
    out read_word(m, 8)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let m = map_create(32)
    assert(map_count(m) == 0)
    assert(map_contains(m, 100) == 0)
    assert(map_get(m, 100) == (0 - 1))

    # 1. Insert 10 key-value pairs
    var i = 1
    when i <= 10 loop
        let key = i * 7
        let val = i * 100
        let status = map_put(m, key, val)
        assert(status == 1)
        i = i + 1
    end
    assert(map_count(m) == 10)

    # 2. Verify all 10 keys
    i = 1
    when i <= 10 loop
        let key = i * 7
        let expected = i * 100
        assert(map_contains(m, key) == 1)
        assert(map_get(m, key) == expected)
        i = i + 1
    end

    # 3. Non-existent keys
    assert(map_contains(m, 999) == 0)
    assert(map_get(m, 999) == (0 - 1))

    # 4. Update existing key
    assert(map_put(m, 21, 5555) == 2) # key 21 (3 * 7) updated
    assert(map_get(m, 21) == 5555)
    assert(map_count(m) == 10) # Count stays 10

    # 5. Remove key
    assert(map_remove(m, 21) == 1)
    assert(map_contains(m, 21) == 0)
    assert(map_get(m, 21) == (0 - 1))
    assert(map_count(m) == 9)

    # 6. Removing non-existent key returns 0
    assert(map_remove(m, 21) == 0)
    assert(map_remove(m, 999) == 0)

    # 7. Re-insert removed key (tests tombstone reuse)
    assert(map_put(m, 21, 7777) == 1)
    assert(map_contains(m, 21) == 1)
    assert(map_get(m, 21) == 7777)
    assert(map_count(m) == 10)

    # 8. Test collision-heavy sequence
    let m2 = map_create(8) # small capacity to force collisions
    map_put(m2, 1, 10)
    map_put(m2, 9, 90)  # 9 % 8 == 1 (collision)
    map_put(m2, 17, 170) # 17 % 8 == 1 (collision)
    assert(map_count(m2) == 3)
    assert(map_get(m2, 1) == 10)
    assert(map_get(m2, 9) == 90)
    assert(map_get(m2, 17) == 170)

    # Remove middle collision element
    assert(map_remove(m2, 9) == 1)
    assert(map_get(m2, 1) == 10)
    assert(map_get(m2, 9) == (0 - 1))
    assert(map_get(m2, 17) == 170) # linear probe still traverses tombstone

    out 0
end.
