# Phase G3: Test std/crypto/sha256 — SHA-256 Cryptographic Hash (Spec §9, stdlib/vir/crypto)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func rotr32(x, n):
    let x32 = x bit_and 0xFFFFFFFF
    let r = (x32 shr n) bit_or (x32 shl (32 - n))
    out r bit_and 0xFFFFFFFF
end.

func sha_ch(x, y, z):
    let not_x = (0xFFFFFFFF - x) bit_and 0xFFFFFFFF
    out ((x bit_and y) bit_xor (not_x bit_and z)) bit_and 0xFFFFFFFF
end.

func sha_maj(x, y, z):
    out ((x bit_and y) bit_xor (x bit_and z) bit_xor (y bit_and z)) bit_and 0xFFFFFFFF
end.

func sha_big_sig0(x):
    out (rotr32(x, 2) bit_xor rotr32(x, 13) bit_xor rotr32(x, 22)) bit_and 0xFFFFFFFF
end.

func sha_big_sig1(x):
    out (rotr32(x, 6) bit_xor rotr32(x, 11) bit_xor rotr32(x, 25)) bit_and 0xFFFFFFFF
end.

func sha_small_sig0(x):
    let s = (x bit_and 0xFFFFFFFF) shr 3
    out (rotr32(x, 7) bit_xor rotr32(x, 18) bit_xor s) bit_and 0xFFFFFFFF
end.

func sha_small_sig1(x):
    let s = (x bit_and 0xFFFFFFFF) shr 10
    out (rotr32(x, 17) bit_xor rotr32(x, 19) bit_xor s) bit_and 0xFFFFFFFF
end.

func get_k_const(i):
    if i == 0 do out 0x428a2f98 end
    if i == 1 do out 0x71374491 end
    if i == 2 do out 0xb5c0fbcf end
    if i == 3 do out 0xe9b5dba5 end
    if i == 4 do out 0x3956c25b end
    if i == 5 do out 0x59f111f1 end
    if i == 6 do out 0x923f82a4 end
    if i == 7 do out 0xab1c5ed5 end
    if i == 8 do out 0xd807aa98 end
    if i == 9 do out 0x12835b01 end
    if i == 10 do out 0x243185be end
    if i == 11 do out 0x550c7dc3 end
    if i == 12 do out 0x72be5d74 end
    if i == 13 do out 0x80deb1fe end
    if i == 14 do out 0x9bdc06a7 end
    if i == 15 do out 0xc19bf174 end
    if i == 16 do out 0xe49b69c1 end
    if i == 17 do out 0xefbe4786 end
    if i == 18 do out 0x0fc19dc6 end
    if i == 19 do out 0x240ca1cc end
    if i == 20 do out 0x2de92c6f end
    if i == 21 do out 0x4a7484aa end
    if i == 22 do out 0x5cb0a9dc end
    if i == 23 do out 0x76f988da end
    if i == 24 do out 0x983e5152 end
    if i == 25 do out 0xa831c66d end
    if i == 26 do out 0xb00327c8 end
    if i == 27 do out 0xbf597fc7 end
    if i == 28 do out 0xc6e00bf3 end
    if i == 29 do out 0xd5a79147 end
    if i == 30 do out 0x06ca6351 end
    if i == 31 do out 0x14292967 end
    if i == 32 do out 0x27b70a85 end
    if i == 33 do out 0x2e1b2138 end
    if i == 34 do out 0x4d2c6dfc end
    if i == 35 do out 0x53380d13 end
    if i == 36 do out 0x650a7354 end
    if i == 37 do out 0x766a0abb end
    if i == 38 do out 0x81c2c92e end
    if i == 39 do out 0x92722c85 end
    if i == 40 do out 0xa2bfe8a1 end
    if i == 41 do out 0xa81a664b end
    if i == 42 do out 0xc24b8b70 end
    if i == 43 do out 0xc76c51a3 end
    if i == 44 do out 0xd192e819 end
    if i == 45 do out 0xd6990624 end
    if i == 46 do out 0xf40e3585 end
    if i == 47 do out 0x106aa070 end
    if i == 48 do out 0x19a4c116 end
    if i == 49 do out 0x1e376c08 end
    if i == 50 do out 0x2748774c end
    if i == 51 do out 0x34b0bcb5 end
    if i == 52 do out 0x391c0cb3 end
    if i == 53 do out 0x4ed8aa4a end
    if i == 54 do out 0x5b9cca4f end
    if i == 55 do out 0x682e6ff3 end
    if i == 56 do out 0x748f82ee end
    if i == 57 do out 0x78a5636f end
    if i == 58 do out 0x84c87814 end
    if i == 59 do out 0x8cc70208 end
    if i == 60 do out 0x90befffa end
    if i == 61 do out 0xa4506ceb end
    if i == 62 do out 0xbef9a3f7 end
    if i == 63 do out 0xc67178f2 end
    out 0
end.

# Hashes a single 512-bit (64 bytes) padded block into H[8]
func sha256_process_block(block, H):
    let W = alloc(64 * 8)
    # W[0..15]
    var t = 0
    when t < 16 loop
        let b0 = read_byte(block, t * 4 + 0)
        let b1 = read_byte(block, t * 4 + 1)
        let b2 = read_byte(block, t * 4 + 2)
        let b3 = read_byte(block, t * 4 + 3)
        let wval = (b0 shl 24) bit_or (b1 shl 16) bit_or (b2 shl 8) bit_or b3
        write_word(W, t * 8, wval bit_and 0xFFFFFFFF)
        t = t + 1
    end

    # W[16..63]
    t = 16
    when t < 64 loop
        let s0 = sha_small_sig0(read_word(W, (t - 15) * 8))
        let s1 = sha_small_sig1(read_word(W, (t - 2) * 8))
        let w_16 = read_word(W, (t - 16) * 8)
        let w_7 = read_word(W, (t - 7) * 8)
        let wval = (w_16 + s0 + w_7 + s1) bit_and 0xFFFFFFFF
        write_word(W, t * 8, wval)
        t = t + 1
    end

    var a = read_word(H, 0 * 8)
    var b = read_word(H, 1 * 8)
    var c = read_word(H, 2 * 8)
    var d = read_word(H, 3 * 8)
    var e = read_word(H, 4 * 8)
    var f = read_word(H, 5 * 8)
    var g = read_word(H, 6 * 8)
    var h = read_word(H, 7 * 8)

    # 64 compression rounds
    t = 0
    when t < 64 loop
        let T1 = (h + sha_big_sig1(e) + sha_ch(e, f, g) + get_k_const(t) + read_word(W, t * 8)) bit_and 0xFFFFFFFF
        let T2 = (sha_big_sig0(a) + sha_maj(a, b, c)) bit_and 0xFFFFFFFF
        h = g
        g = f
        f = e
        e = (d + T1) bit_and 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (T1 + T2) bit_and 0xFFFFFFFF
        t = t + 1
    end

    write_word(H, 0 * 8, (read_word(H, 0 * 8) + a) bit_and 0xFFFFFFFF)
    write_word(H, 1 * 8, (read_word(H, 1 * 8) + b) bit_and 0xFFFFFFFF)
    write_word(H, 2 * 8, (read_word(H, 2 * 8) + c) bit_and 0xFFFFFFFF)
    write_word(H, 3 * 8, (read_word(H, 3 * 8) + d) bit_and 0xFFFFFFFF)
    write_word(H, 4 * 8, (read_word(H, 4 * 8) + e) bit_and 0xFFFFFFFF)
    write_word(H, 5 * 8, (read_word(H, 5 * 8) + f) bit_and 0xFFFFFFFF)
    write_word(H, 6 * 8, (read_word(H, 6 * 8) + g) bit_and 0xFFFFFFFF)
    write_word(H, 7 * 8, (read_word(H, 7 * 8) + h) bit_and 0xFFFFFFFF)
end.

func hex_digit(v):
    if v < 10 do out 48 + v end
    out 97 + (v - 10)
end.

# Computes SHA-256 of single block (len <= 55 bytes)
func sha256_short(msg, len, out_hex):
    let H = alloc(8 * 8)
    write_word(H, 0 * 8, 0x6a09e667)
    write_word(H, 1 * 8, 0xbb67ae85)
    write_word(H, 2 * 8, 0x3c6ef372)
    write_word(H, 3 * 8, 0xa54ff53a)
    write_word(H, 4 * 8, 0x510e527f)
    write_word(H, 5 * 8, 0x9b05688c)
    write_word(H, 6 * 8, 0x1f83d9ab)
    write_word(H, 7 * 8, 0x5be0cd19)

    let block = alloc(64)
    var i = 0
    when i < len loop
        write_byte(block, i, read_byte(msg, i))
        i = i + 1
    end

    # Padding 0x80
    write_byte(block, i, 0x80)
    i = i + 1

    when i < 56 loop
        write_byte(block, i, 0)
        i = i + 1
    end

    # Length in bits (64-bit big endian at block[56..63])
    let bit_len = len * 8
    write_byte(block, 56, 0)
    write_byte(block, 57, 0)
    write_byte(block, 58, 0)
    write_byte(block, 59, 0)
    write_byte(block, 60, (bit_len shr 24) bit_and 255)
    write_byte(block, 61, (bit_len shr 16) bit_and 255)
    write_byte(block, 62, (bit_len shr 8) bit_and 255)
    write_byte(block, 63, bit_len bit_and 255)

    sha256_process_block(block, H)

    # Format 32 bytes into 64-char hex string
    var dst_idx = 0
    var h_idx = 0
    when h_idx < 8 loop
        let w = read_word(H, h_idx * 8)
        var byte_shift = 24
        when byte_shift >= 0 loop
            let b = (w shr byte_shift) bit_and 255
            write_byte(out_hex, dst_idx, hex_digit((b shr 4) bit_and 15))
            dst_idx = dst_idx + 1
            write_byte(out_hex, dst_idx, hex_digit(b bit_and 15))
            dst_idx = dst_idx + 1
            byte_shift = byte_shift - 8
        end
        h_idx = h_idx + 1
    end
    write_byte(out_hex, dst_idx, 0)
    out out_hex
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let hex_res = alloc(128)

    # 1. NIST Standard Vector: "" (empty string)
    # Expected: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    sha256_short("", 0, hex_res)
    assert(cstr_eq(hex_res, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") == 1)

    # 2. NIST Standard Vector: "abc"
    # Expected: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    sha256_short("abc", 3, hex_res)
    assert(cstr_eq(hex_res, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") == 1)

    out 0
end.
