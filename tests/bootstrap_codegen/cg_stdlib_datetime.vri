# Phase D5: Test std/datetime — DateTime Decomposition & Calendar Algorithms (Spec §9, stdlib/vir/datetime)

func is_leap_year(y):
    if (y % 400) == 0 do out 1 end
    if (y % 100) == 0 do out 0 end
    if (y % 4) == 0 do out 1 end
    out 0
end.

func days_in_month(y, m):
    if m == 1 do out 31 end # Jan
    if m == 2 do           # Feb
        if is_leap_year(y) != 0 do out 29 end
        out 28
    end
    if m == 3 do out 31 end # Mar
    if m == 4 do out 30 end # Apr
    if m == 5 do out 31 end # May
    if m == 6 do out 30 end # Jun
    if m == 7 do out 31 end # Jul
    if m == 8 do out 31 end # Aug
    if m == 9 do out 30 end # Sep
    if m == 10 do out 31 end # Oct
    if m == 11 do out 30 end # Nov
    if m == 12 do out 31 end # Dec
    out 0
end.

# Day of week using Sakamoto algorithm: 0 = Sunday, 1 = Monday, ..., 6 = Saturday
func day_of_week(y, m, d):
    var t_y = y
    if m < 3 do
        t_y = t_y - 1
    end
    # Sakamoto offset table for months:
    # Jan=0, Feb=3, Mar=2, Apr=5, May=0, Jun=3, Jul=5, Aug=1, Sep=4, Oct=6, Nov=2, Dec=4
    var t_m = 0
    if m == 1 do t_m = 0 end
    if m == 2 do t_m = 3 end
    if m == 3 do t_m = 2 end
    if m == 4 do t_m = 5 end
    if m == 5 do t_m = 0 end
    if m == 6 do t_m = 3 end
    if m == 7 do t_m = 5 end
    if m == 8 do t_m = 1 end
    if m == 9 do t_m = 4 end
    if m == 10 do t_m = 6 end
    if m == 11 do t_m = 2 end
    if m == 12 do t_m = 4 end

    let dow = (t_y + t_y / 4 - t_y / 100 + t_y / 400 + t_m + d) % 7
    out dow
end.

# Decomposes Unix timestamp (seconds) into 6 words: [year, month, day, hour, min, sec]
func unix_to_datetime(ts, out_dt):
    let sec = ts % 60
    var rem_min = ts / 60
    let min = rem_min % 60
    var rem_hours = rem_min / 60
    let hour = rem_hours % 24
    var days = rem_hours / 24

    # Calculate year
    var y = 1970
    var done = 0
    when done == 0 loop
        var days_in_cur_year = 365
        if is_leap_year(y) != 0 do
            days_in_cur_year = 366
        end
        if days >= days_in_cur_year do
            days = days - days_in_cur_year
            y = y + 1
        else
            done = 1
        end
    end

    # Calculate month
    var m = 1
    done = 0
    when (m <= 12) and (done == 0) loop
        let dim = days_in_month(y, m)
        if days >= dim do
            days = days - dim
            m = m + 1
        else
            done = 1
        end
    end

    let day = days + 1

    write_word(out_dt, 0 * 8, y)
    write_word(out_dt, 1 * 8, m)
    write_word(out_dt, 2 * 8, day)
    write_word(out_dt, 3 * 8, hour)
    write_word(out_dt, 4 * 8, min)
    write_word(out_dt, 5 * 8, sec)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Leap year assertions
    assert(is_leap_year(2000) == 1) # Divisible by 400
    assert(is_leap_year(2024) == 1) # Divisible by 4, not 100
    assert(is_leap_year(2026) == 0) # Not divisible by 4
    assert(is_leap_year(1900) == 0) # Divisible by 100, not 400
    assert(is_leap_year(2400) == 1)

    # 2. Days in month
    assert(days_in_month(2024, 2) == 29)
    assert(days_in_month(2026, 2) == 28)
    assert(days_in_month(2026, 8) == 31)
    assert(days_in_month(2026, 4) == 30)

    # 3. Day of week (0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday)
    assert(day_of_week(1970, 1, 1) == 4)  # Thursday
    assert(day_of_week(2000, 1, 1) == 6)  # Saturday
    assert(day_of_week(2026, 8, 28) == 5) # Friday (Today!)
    assert(day_of_week(2026, 8, 29) == 6) # Saturday (Tomorrow)
    assert(day_of_week(2026, 8, 30) == 0) # Sunday

    # 4. Unix timestamp decomposition
    let dt = alloc(6 * 8)

    # Epoch 0 -> 1970-01-01 00:00:00
    unix_to_datetime(0, dt)
    assert(read_word(dt, 0 * 8) == 1970)
    assert(read_word(dt, 1 * 8) == 1)
    assert(read_word(dt, 2 * 8) == 1)
    assert(read_word(dt, 3 * 8) == 0)
    assert(read_word(dt, 4 * 8) == 0)
    assert(read_word(dt, 5 * 8) == 0)

    # 2026-08-28 14:30:45 UTC
    # Days from 1970-01-01 to 2026-08-28 = 20693 days
    # 20693 * 86400 = 1787875200 + 14*3600 + 30*60 + 45 = 1787875200 + 50400 + 1800 + 45 = 1787927445
    unix_to_datetime(1787927445, dt)
    assert(read_word(dt, 0 * 8) == 2026)
    assert(read_word(dt, 1 * 8) == 8)
    assert(read_word(dt, 2 * 8) == 28)
    assert(read_word(dt, 3 * 8) == 14)
    assert(read_word(dt, 4 * 8) == 30)
    assert(read_word(dt, 5 * 8) == 45)

    out 0
end.
