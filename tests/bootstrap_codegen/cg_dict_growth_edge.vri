# EXPECT_END
# Insertion past the literal's initial spare slots must preserve every key.
func main:
    var m = [1: 10]
    m[2] = 20
    m[3] = 30
    m[4] = 40
    m[5] = 50
    m[6] = 60
    m[7] = 70
    m[8] = 80
    m[9] = 90
    m[10] = 100
    m[11] = 110
    print len(m)
    print m[2]
    print m[11]
end.
