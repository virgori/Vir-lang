# Phase D1: Test std/path — Path Manipulation & Decomposition (Spec §9, stdlib/vir/path)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func path_is_abs(p):
    if cstr_len(p) == 0 do out 0 end
    if read_byte(p, 0) == 47 do # '/'
        out 1
    end
    out 0
end.

func path_dirname(p, out_buf):
    let l = cstr_len(p)
    if l == 0 do
        write_byte(out_buf, 0, 46) # "."
        write_byte(out_buf, 1, 0)
        out out_buf
    end
    # Find last '/'
    var last_slash = 0 - 1
    var i = l - 1
    when (i >= 0) and (last_slash == (0 - 1)) loop
        if read_byte(p, i) == 47 do
            last_slash = i
        end
        i = i - 1
    end

    if last_slash == (0 - 1) do
        # No slash -> "."
        write_byte(out_buf, 0, 46)
        write_byte(out_buf, 1, 0)
        out out_buf
    end

    if last_slash == 0 do
        # Root "/"
        write_byte(out_buf, 0, 47)
        write_byte(out_buf, 1, 0)
        out out_buf
    end

    # Copy up to last_slash
    i = 0
    when i < last_slash loop
        write_byte(out_buf, i, read_byte(p, i))
        i = i + 1
    end
    write_byte(out_buf, i, 0)
    out out_buf
end.

func path_basename(p, out_buf):
    let l = cstr_len(p)
    if l == 0 do
        write_byte(out_buf, 0, 0)
        out out_buf
    end
    var last_slash = 0 - 1
    var i = l - 1
    when (i >= 0) and (last_slash == (0 - 1)) loop
        if read_byte(p, i) == 47 do
            last_slash = i
        end
        i = i - 1
    end

    var src_idx = last_slash + 1
    var dst_idx = 0
    when src_idx < l loop
        write_byte(out_buf, dst_idx, read_byte(p, src_idx))
        src_idx = src_idx + 1
        dst_idx = dst_idx + 1
    end
    write_byte(out_buf, dst_idx, 0)
    out out_buf
end.

func path_ext(p, out_buf):
    let l = cstr_len(p)
    var last_dot = 0 - 1
    var last_slash = 0 - 1
    var i = l - 1
    when (i >= 0) and (last_dot == (0 - 1)) loop
        let b = read_byte(p, i)
        if b == 46 do # '.'
            last_dot = i
        end
        if b == 47 do # '/'
            last_slash = i
        end
        i = i - 1
    end

    if (last_dot == (0 - 1)) or (last_dot <= last_slash) do
        write_byte(out_buf, 0, 0)
        out out_buf
    end

    var src_idx = last_dot + 1
    var dst_idx = 0
    when src_idx < l loop
        write_byte(out_buf, dst_idx, read_byte(p, src_idx))
        src_idx = src_idx + 1
        dst_idx = dst_idx + 1
    end
    write_byte(out_buf, dst_idx, 0)
    out out_buf
end.

func path_join(a, b, out_buf):
    if path_is_abs(b) != 0 do
        # b is absolute, returns b
        let lb = cstr_len(b)
        var i = 0
        when i < lb loop
            write_byte(out_buf, i, read_byte(b, i))
            i = i + 1
        end
        write_byte(out_buf, i, 0)
        out out_buf
    end

    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la == 0 do
        var i = 0
        when i < lb loop
            write_byte(out_buf, i, read_byte(b, i))
            i = i + 1
        end
        write_byte(out_buf, i, 0)
        out out_buf
    end

    var dst = 0
    var i = 0
    when i < la loop
        write_byte(out_buf, dst, read_byte(a, i))
        dst = dst + 1
        i = i + 1
    end

    # Check if a ended with '/'
    if read_byte(a, la - 1) != 47 do
        write_byte(out_buf, dst, 47) # Add '/'
        dst = dst + 1
    end

    i = 0
    when i < lb loop
        write_byte(out_buf, dst, read_byte(b, i))
        dst = dst + 1
        i = i + 1
    end
    write_byte(out_buf, dst, 0)
    out out_buf
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let buf1 = alloc(256)
    let buf2 = alloc(256)
    let buf3 = alloc(256)

    # 1. is_abs test
    assert(path_is_abs("/usr/local/bin") == 1)
    assert(path_is_abs("/") == 1)
    assert(path_is_abs("usr/local/bin") == 0)
    assert(path_is_abs("./file.vri") == 0)
    assert(path_is_abs("") == 0)

    # 2. dirname test
    assert(cstr_eq(path_dirname("/usr/local/bin", buf1), "/usr/local") == 1)
    assert(cstr_eq(path_dirname("/usr", buf1), "/") == 1)
    assert(cstr_eq(path_dirname("/", buf1), "/") == 1)
    assert(cstr_eq(path_dirname("file.vri", buf1), ".") == 1)
    assert(cstr_eq(path_dirname("a/b", buf1), "a") == 1)

    # 3. basename test
    assert(cstr_eq(path_basename("/usr/local/bin", buf1), "bin") == 1)
    assert(cstr_eq(path_basename("/usr/local/main.vri", buf1), "main.vri") == 1)
    assert(cstr_eq(path_basename("main.vri", buf1), "main.vri") == 1)
    assert(cstr_eq(path_basename("/", buf1), "") == 1)

    # 4. ext test
    assert(cstr_eq(path_ext("main.vri", buf1), "vri") == 1)
    assert(cstr_eq(path_ext("/path/to/archive.tar.gz", buf1), "gz") == 1)
    assert(cstr_eq(path_ext("Makefile", buf1), "") == 1)
    assert(cstr_eq(path_ext("/dir.name/file", buf1), "") == 1)

    # 5. path_join test
    assert(cstr_eq(path_join("/usr", "local", buf1), "/usr/local") == 1)
    assert(cstr_eq(path_join("/usr/", "local", buf1), "/usr/local") == 1)
    assert(cstr_eq(path_join("", "local", buf1), "local") == 1)
    assert(cstr_eq(path_join("/usr", "/etc/passwd", buf1), "/etc/passwd") == 1)
    assert(cstr_eq(path_join("src", "compiler/virc.vri", buf1), "src/compiler/virc.vri") == 1)

    out 0
end.
