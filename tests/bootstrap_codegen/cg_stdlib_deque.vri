# Phase C3: Test std/collections/deque — Double-Ended Queue with Circular Ring Buffer (Spec §9, stdlib/vir/collections)

# Deque layout at ptr:
# word 0: capacity
# word 1: head index
# word 2: tail index
# word 3: count
# word 4: data array ptr (i64)

func deque_create(cap):
    let d = alloc(40)
    write_word(d, 0, cap)
    write_word(d, 8, 0)  # head = 0
    write_word(d, 16, 0) # tail = 0
    write_word(d, 24, 0) # count = 0
    let data = alloc(cap * 8)
    write_word(d, 32, data)
    out d
end.

func deque_size(d):
    out read_word(d, 24)
end.

func deque_is_empty(d):
    if read_word(d, 24) == 0 do out 1 end
    out 0
end.

func deque_push_back(d, val):
    let cnt = read_word(d, 24)
    let cap = read_word(d, 0)
    if cnt >= cap do out 0 end
    let data = read_word(d, 32)
    let tail = read_word(d, 16)
    write_word(data, tail * 8, val)
    write_word(d, 16, (tail + 1) % cap)
    write_word(d, 24, cnt + 1)
    out 1
end.

func deque_push_front(d, val):
    let cnt = read_word(d, 24)
    let cap = read_word(d, 0)
    if cnt >= cap do out 0 end
    let data = read_word(d, 32)
    var head = read_word(d, 8)
    head = (head - 1 + cap) % cap
    write_word(data, head * 8, val)
    write_word(d, 8, head)
    write_word(d, 24, cnt + 1)
    out 1
end.

func deque_pop_front(d):
    let cnt = read_word(d, 24)
    if cnt == 0 do out 0 - 1 end
    let cap = read_word(d, 0)
    let data = read_word(d, 32)
    let head = read_word(d, 8)
    let val = read_word(data, head * 8)
    write_word(d, 8, (head + 1) % cap)
    write_word(d, 24, cnt - 1)
    out val
end.

func deque_pop_back(d):
    let cnt = read_word(d, 24)
    if cnt == 0 do out 0 - 1 end
    let cap = read_word(d, 0)
    let data = read_word(d, 32)
    var tail = read_word(d, 16)
    tail = (tail - 1 + cap) % cap
    let val = read_word(data, tail * 8)
    write_word(d, 16, tail)
    write_word(d, 24, cnt - 1)
    out val
end.

func deque_peek_front(d):
    let cnt = read_word(d, 24)
    if cnt == 0 do out 0 - 1 end
    let head = read_word(d, 8)
    let data = read_word(d, 32)
    out read_word(data, head * 8)
end.

func deque_peek_back(d):
    let cnt = read_word(d, 24)
    if cnt == 0 do out 0 - 1 end
    let cap = read_word(d, 0)
    let tail = read_word(d, 16)
    let data = read_word(d, 32)
    let last_idx = (tail - 1 + cap) % cap
    out read_word(data, last_idx * 8)
end.

func deque_get_at(d, logical_idx):
    let cnt = read_word(d, 24)
    if (logical_idx < 0) or (logical_idx >= cnt) do
        out 0 - 1
    end
    let cap = read_word(d, 0)
    let head = read_word(d, 8)
    let data = read_word(d, 32)
    let phys_idx = (head + logical_idx) % cap
    out read_word(data, phys_idx * 8)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let d = deque_create(16)
    assert(deque_is_empty(d) == 1)
    assert(deque_size(d) == 0)
    assert(deque_pop_front(d) == (0 - 1))
    assert(deque_pop_back(d) == (0 - 1))
    assert(deque_peek_front(d) == (0 - 1))
    assert(deque_peek_back(d) == (0 - 1))

    # 1. FIFO queue semantics (push_back / pop_front)
    deque_push_back(d, 10)
    deque_push_back(d, 20)
    deque_push_back(d, 30)
    assert(deque_size(d) == 3)
    assert(deque_peek_front(d) == 10)
    assert(deque_peek_back(d) == 30)
    assert(deque_get_at(d, 0) == 10)
    assert(deque_get_at(d, 1) == 20)
    assert(deque_get_at(d, 2) == 30)
    assert(deque_pop_front(d) == 10)
    assert(deque_pop_front(d) == 20)
    assert(deque_pop_front(d) == 30)
    assert(deque_is_empty(d) == 1)

    # 2. LIFO stack semantics (push_back / pop_back)
    deque_push_back(d, 100)
    deque_push_back(d, 200)
    deque_push_back(d, 300)
    assert(deque_pop_back(d) == 300)
    assert(deque_pop_back(d) == 200)
    assert(deque_pop_back(d) == 100)
    assert(deque_is_empty(d) == 1)

    # 3. Double-ended interleaved operations
    deque_push_front(d, 2) # [2]
    deque_push_front(d, 1) # [1, 2]
    deque_push_back(d, 3)  # [1, 2, 3]
    deque_push_back(d, 4)  # [1, 2, 3, 4]
    deque_push_front(d, 0) # [0, 1, 2, 3, 4]
    assert(deque_size(d) == 5)
    assert(deque_get_at(d, 0) == 0)
    assert(deque_get_at(d, 1) == 1)
    assert(deque_get_at(d, 2) == 2)
    assert(deque_get_at(d, 3) == 3)
    assert(deque_get_at(d, 4) == 4)

    assert(deque_pop_front(d) == 0) # [1, 2, 3, 4]
    assert(deque_pop_back(d) == 4)  # [1, 2, 3]
    assert(deque_pop_front(d) == 1) # [2, 3]
    assert(deque_pop_back(d) == 3)  # [2]
    assert(deque_pop_front(d) == 2) # []
    assert(deque_is_empty(d) == 1)

    # 4. Heavy wraparound test
    var i = 0
    when i < 50 loop
        deque_push_back(d, i * 5)
        deque_push_back(d, i * 5 + 1)
        assert(deque_pop_front(d) == i * 5)
        assert(deque_pop_front(d) == i * 5 + 1)
        i = i + 1
    end
    assert(deque_is_empty(d) == 1)

    out 0
end.
