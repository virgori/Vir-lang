# Phase D7: Test std/io/bufio — Buffered Stream I/O & Line Reader (Spec §9, stdlib/vir/io)

# BufferedReader layout at ptr:
# word 0: src_data ptr (bytes)
# word 8: src_len (i64)
# word 16: pos (current read index)
# word 24: buf_size (chunk capacity)

func bufreader_create(src_data, src_len, buf_sz):
    let br = alloc(32)
    write_word(br, 0, src_data)
    write_word(br, 8, src_len)
    write_word(br, 16, 0)
    write_word(br, 24, buf_sz)
    out br
end.

func bufreader_is_eof(br):
    let pos = read_word(br, 16)
    let len = read_word(br, 8)
    if pos >= len do out 1 end
    out 0
end.

func bufreader_read_byte(br):
    let pos = read_word(br, 16)
    let len = read_word(br, 8)
    if pos >= len do out 0 - 1 end
    let data = read_word(br, 0)
    let b = read_byte(data, pos)
    write_word(br, 16, pos + 1)
    out b
end.

# Reads a line up to \n or EOF, strips trailing \r and \n, returns line length (-1 on EOF)
func bufreader_read_line(br, out_buf, max_len):
    if bufreader_is_eof(br) != 0 do
        out 0 - 1
    end
    let data = read_word(br, 0)
    let len = read_word(br, 8)
    var pos = read_word(br, 16)
    var out_idx = 0
    var done = 0
    when (pos < len) and (done == 0) and (out_idx < max_len) loop
        let b = read_byte(data, pos)
        pos = pos + 1
        if b == 10 do # '\n'
            done = 1
        else
            if b != 13 do # skip '\r'
                write_byte(out_buf, out_idx, b)
                out_idx = out_idx + 1
            end
        end
    end
    write_byte(out_buf, out_idx, 0) # null terminate
    write_word(br, 16, pos)
    out out_idx
end.

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let sample = "Line 1: Alpha\nLine 2: Beta Gamma\nLine 3: Delta\nLine 4: Final without newline"
    let slen = cstr_len(sample)
    let br = bufreader_create(sample, slen, 64)
    let line_buf = alloc(256)

    assert(bufreader_is_eof(br) == 0)

    # 1. Read Line 1
    let l1 = bufreader_read_line(br, line_buf, 255)
    assert(l1 == 13)
    assert(cstr_eq(line_buf, "Line 1: Alpha") == 1)

    # 2. Read Line 2
    let l2 = bufreader_read_line(br, line_buf, 255)
    assert(l2 == 18)
    assert(cstr_eq(line_buf, "Line 2: Beta Gamma") == 1)

    # 3. Read Line 3
    let l3 = bufreader_read_line(br, line_buf, 255)
    assert(l3 == 13)
    assert(cstr_eq(line_buf, "Line 3: Delta") == 1)

    # 4. Read Line 4
    let l4 = bufreader_read_line(br, line_buf, 255)
    assert(l4 == 29)
    assert(cstr_eq(line_buf, "Line 4: Final without newline") == 1)

    # 5. EOF
    assert(bufreader_is_eof(br) == 1)
    assert(bufreader_read_line(br, line_buf, 255) == (0 - 1))
    assert(bufreader_read_byte(br) == (0 - 1))

    out 0
end.
