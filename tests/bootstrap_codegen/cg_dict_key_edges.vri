# EXPECT_START
# 100
# 200
# 300
# 3
# 220
# 3
# 400
# 4
# 0
# EXPECT_END
# Lookup is by key, not by position. Updating an existing key does not
# increase len; inserting a new key does. The current missing-key contract
# returns 0, matching cg_dict_semantics.vri.
func main:
    var m = [3: 300, 1: 100, 2: 200]
    print m[1]
    print m[2]
    print m[3]
    print len(m)
    m[2] = 220
    print m[2]
    print len(m)
    m[4] = 400
    print m[4]
    print len(m)
    print m[99]
end.
