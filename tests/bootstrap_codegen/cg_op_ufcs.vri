# Vir Native Regression Test: UFCS method calls and chaining (Spec §11)

func double(val):
    out val * 2
end.

func add_n(val, n):
    out val + n
end.

entity Item:
    price: int
    qty: int
end.

func total_cost(this):
    out this.price * this.qty
end.

func main():
    var x = 10
    var a = x.double()
    print(a) # 20

    var b = x.add_n(5)
    print(b) # 15

    var c = x.double().add_n(7)
    print(c) # 27

    var it = alloc(16)
    it.price = 50
    it.qty = 4
    var cost = it.total_cost()
    print(cost) # 200

    out 0
end.
