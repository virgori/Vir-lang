# Phase H1: Test std/db/kv — Embedded Key-Value Store & Hash Indexing (Spec §9, stdlib/vir/db)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# DJB2 hash for string keys
func hash_str(s):
    var h = 5381
    let l = cstr_len(s)
    var i = 0
    when i < l loop
        let c = read_byte(s, i)
        h = (((h shl 5) + h) + c) bit_and 0x7FFFFFFF
        i = i + 1
    end
    out h
end.

# KV Store layout at ptr:
# word 0: capacity
# word 8: count
# word 16: keys array (ptrs)
# word 24: vals array (ptrs)
# word 32: state array (0 = empty, 1 = used, 2 = tombstone)

func kv_open(cap):
    let db = alloc(40)
    write_word(db, 0, cap)
    write_word(db, 8, 0) # count = 0
    write_word(db, 16, alloc(cap * 8)) # keys
    write_word(db, 24, alloc(cap * 8)) # vals
    let states = alloc(cap * 8)
    write_word(db, 32, states)
    var i = 0
    when i < cap loop
        write_word(states, i * 8, 0)
        i = i + 1
    end
    out db
end.

func kv_count(db):
    out read_word(db, 8)
end.

func kv_put(db, key, val):
    let cap = read_word(db, 0)
    let keys = read_word(db, 16)
    let vals = read_word(db, 24)
    let states = read_word(db, 32)

    let h = hash_str(key)
    var idx = h % cap
    var probe = 0
    var insert_idx = 0 - 1
    var done = 0

    when (probe < cap) and (done == 0) loop
        let st = read_word(states, idx * 8)
        if st == 0 do # Empty slot
            if insert_idx == (0 - 1) do
                insert_idx = idx
            end
            done = 1
        else
            if st == 1 do
                let k = read_word(keys, idx * 8)
                if cstr_eq(k, key) == 1 do # Update existing key
                    write_word(vals, idx * 8, val)
                    out 1
                end
            else
                # st == 2 (Tombstone)
                if insert_idx == (0 - 1) do
                    insert_idx = idx
                end
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end

    if insert_idx != (0 - 1) do
        write_word(keys, insert_idx * 8, key)
        write_word(vals, insert_idx * 8, val)
        write_word(states, insert_idx * 8, 1)
        let cnt = read_word(db, 8)
        write_word(db, 8, cnt + 1)
        out 1
    end
    out 0 # Full
end.

func kv_get(db, key):
    let cap = read_word(db, 0)
    let keys = read_word(db, 16)
    let vals = read_word(db, 24)
    let states = read_word(db, 32)

    let h = hash_str(key)
    var idx = h % cap
    var probe = 0

    when probe < cap loop
        let st = read_word(states, idx * 8)
        if st == 0 do
            out 0 # Not found
        end
        if st == 1 do
            let k = read_word(keys, idx * 8)
            if cstr_eq(k, key) == 1 do
                out read_word(vals, idx * 8)
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out 0 # Not found
end.

func kv_delete(db, key):
    let cap = read_word(db, 0)
    let keys = read_word(db, 16)
    let states = read_word(db, 32)

    let h = hash_str(key)
    var idx = h % cap
    var probe = 0

    when probe < cap loop
        let st = read_word(states, idx * 8)
        if st == 0 do out 0 end
        if st == 1 do
            let k = read_word(keys, idx * 8)
            if cstr_eq(k, key) == 1 do
                write_word(states, idx * 8, 2) # Mark tombstone
                let cnt = read_word(db, 8)
                write_word(db, 8, cnt - 1)
                out 1 # Deleted
            end
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out 0
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let db = kv_open(16)
    assert(kv_count(db) == 0)

    # 1. Insert pairs
    assert(kv_put(db, "user:101", "Geng Yang") == 1)
    assert(kv_put(db, "user:102", "Alice") == 1)
    assert(kv_put(db, "config:port", "8080") == 1)
    assert(kv_count(db) == 3)

    # 2. Get verification
    assert(cstr_eq(kv_get(db, "user:101"), "Geng Yang") == 1)
    assert(cstr_eq(kv_get(db, "user:102"), "Alice") == 1)
    assert(cstr_eq(kv_get(db, "config:port"), "8080") == 1)
    assert(kv_get(db, "missing:key") == 0)

    # 3. Update existing key
    assert(kv_put(db, "config:port", "9090") == 1)
    assert(kv_count(db) == 3) # Count unchanged on update
    assert(cstr_eq(kv_get(db, "config:port"), "9090") == 1)

    # 4. Delete key
    assert(kv_delete(db, "user:102") == 1)
    assert(kv_count(db) == 2)
    assert(kv_get(db, "user:102") == 0) # No longer found

    # 5. Other keys still accessible across tombstone
    assert(cstr_eq(kv_get(db, "user:101"), "Geng Yang") == 1)
    assert(cstr_eq(kv_get(db, "config:port"), "9090") == 1)

    # 6. Re-insert deleted key
    assert(kv_put(db, "user:102", "Bob") == 1)
    assert(kv_count(db) == 3)
    assert(cstr_eq(kv_get(db, "user:102"), "Bob") == 1)

    out 0
end.
