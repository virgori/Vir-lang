# Phase B3: Test std/rand xoshiro256** PRNG (Spec §16, stdlib/vir/rand)

# Self-contained xoshiro256** PRNG (SplitMix64 seeder)
entity Xrand:
    s0: int,
    s1: int,
    s2: int,
    s3: int
end.

func _rotl(x, k):
    out (x shl k) or (x shr (64 - k))
end.

func xrand_new(seed):
    var z = seed
    # SplitMix64 seeding
    z = (z xor (z shr 30)) * 0xBF58476D1CE4E5B9
    z = (z xor (z shr 27)) * 0x94D049BB133111EB
    z = z xor (z shr 31)
    var s0 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z xor (z shr 30)) * 0xBF58476D1CE4E5B9
    z = (z xor (z shr 27)) * 0x94D049BB133111EB
    z = z xor (z shr 31)
    var s1 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z xor (z shr 30)) * 0xBF58476D1CE4E5B9
    z = (z xor (z shr 27)) * 0x94D049BB133111EB
    z = z xor (z shr 31)
    var s2 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z xor (z shr 30)) * 0xBF58476D1CE4E5B9
    z = (z xor (z shr 27)) * 0x94D049BB133111EB
    z = z xor (z shr 31)
    var s3 = z
    out Xrand(s0, s1, s2, s3)
end.

func xrand_next(r):
    let result = _rotl(r.s1 * 5, 7) * 9
    let t = r.s1 shl 17
    r.s2 = r.s2 xor r.s0
    r.s3 = r.s3 xor r.s1
    r.s1 = r.s1 xor r.s2
    r.s0 = r.s0 xor r.s3
    r.s2 = r.s2 xor t
    r.s3 = _rotl(r.s3, 45)
    out result
end.

func xrand_range(r, lo, hi):
    if lo >= hi do out lo end
    let range = hi - lo
    out lo + (xrand_next(r) mod range)
end.

func main:
    var r1 = xrand_new(42)
    var r2 = xrand_new(42)

    # 1. Determinism: same seed -> same sequence
    let a1 = xrand_next(r1)
    let a2 = xrand_next(r2)
    if a1 != a2 do out 1 end

    let b1 = xrand_next(r1)
    let b2 = xrand_next(r2)
    if b1 != b2 do out 2 end

    # 2. Different seeds -> different values
    var r3 = xrand_new(43)
    let c1 = xrand_next(r1)
    let c3 = xrand_next(r3)
    if c1 == c3 do out 3 end  # Extremely unlikely to be equal

    # 3. Range: all values in [lo, hi)
    var r4 = xrand_new(12345)
    var i = 0
    when i < 200 loop
        let v = xrand_range(r4, 10, 20)
        if v < 10 do out 4 end
        if v >= 20 do out 5 end
        i = i + 1
    end

    # 4. Uniformity: all values in [0, 8) must appear in 1000 draws
    let count_buf = alloc(8 * 8)
    var j = 0
    when j < 8 loop
        write_word(count_buf, j * 8, 0)
        j = j + 1
    end
    var r5 = xrand_new(999)
    var k = 0
    when k < 1000 loop
        let bucket = xrand_range(r5, 0, 8)
        let cur = read_word(count_buf, bucket * 8)
        write_word(count_buf, bucket * 8, cur + 1)
        k = k + 1
    end
    var m = 0
    when m < 8 loop
        let cnt = read_word(count_buf, m * 8)
        if cnt == 0 do out 6 end   # Bucket never hit -> very bad PRNG
        m = m + 1
    end

    # 5. Range boundary: rng_range(x, n, n+1) always returns n
    var r6 = xrand_new(7)
    var p = 0
    when p < 10 loop
        let single = xrand_range(r6, 77, 78)
        if single != 77 do out 7 end
        p = p + 1
    end

    out 0
end.
