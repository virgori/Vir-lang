# Regression: `let x = f(st, c)` must resolve Call arg `st` to the parameter,
# not to the fresh local `x` (Stage-0 Identifier + g_boot_var_name bug).
func take:
    in(st, n)
    out read_word(st, n * 8);
end.

func main:
    let st = alloc(64);
    write_word(st, 9 * 8, 42);
    let site = take(st, 9);
    print site;
    out 0;
end.
