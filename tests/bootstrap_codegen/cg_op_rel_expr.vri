# Vir Native Regression Test: Relational value expressions and nil-safe operators (Spec §10.2)

func main():
    var a = 15
    var b = 30
    var c = 15

    var eq_t = (a == c)
    var eq_f = (a == b)
    var ne_t = (a != b)
    var lt_t = (a < b)
    var le_t = (a <= c)
    var gt_t = (b > a)
    var ge_t = (a >= c)

    print(eq_t) # 1
    print(eq_f) # 0
    print(ne_t) # 1
    print(lt_t) # 1
    print(le_t) # 1
    print(gt_t) # 1
    print(ge_t) # 1

    # Nil safe
    var n1 = 0
    var n2 = 0
    var v1 = 50
    var v2 = 50
    print(n1 ?= n2) # 1
    print(v1 ?= v2) # 1
    print(n1 ?= v1) # 0
    print(n1 ?=/= v1) # 1

    out 0
end.
