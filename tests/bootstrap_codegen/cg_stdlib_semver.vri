# Phase H3: Test std/package/semver — Semantic Versioning 2.0.0 Parser & Comparator (Spec §9, stdlib/vir/package)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

# SemVer struct layout at ptr:
# word 0: major
# word 8: minor
# word 16: patch

func semver_create:
    let sv = alloc(24)
    write_word(sv, 0, 0)
    write_word(sv, 8, 0)
    write_word(sv, 16, 0)
    out sv
end.

func semver_parse(src, sv):
    let slen = cstr_len(src)
    var p = 0

    # 1. Major
    var maj = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        maj = maj * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 0, maj)

    if (p >= slen) or (read_byte(src, p) != 46) do out 0 end # Must have '.'
    p = p + 1

    # 2. Minor
    var min = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        min = min * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 8, min)

    if (p >= slen) or (read_byte(src, p) != 46) do out 0 end
    p = p + 1

    # 3. Patch
    var pat = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        pat = pat * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 16, pat)

    out 1
end.

func semver_cmp(a, b):
    let maj_a = read_word(a, 0)
    let maj_b = read_word(b, 0)
    if maj_a > maj_b do out 1 end
    if maj_a < maj_b do out 0 - 1 end

    let min_a = read_word(a, 8)
    let min_b = read_word(b, 8)
    if min_a > min_b do out 1 end
    if min_a < min_b do out 0 - 1 end

    let pat_a = read_word(a, 16)
    let pat_b = read_word(b, 16)
    if pat_a > pat_b do out 1 end
    if pat_a < pat_b do out 0 - 1 end

    out 0 # Equal
end.

# Checks if `ver` satisfies caret constraint `^base` (same major, ver >= base)
func semver_satisfies_caret(ver, base):
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    if maj_v != maj_b do out 0 end # Different major
    if semver_cmp(ver, base) >= 0 do
        out 1
    end
    out 0
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let v_200 = semver_create()
    let v_201 = semver_create()
    let v_210 = semver_create()
    let v_199 = semver_create()
    let v_300 = semver_create()

    assert(semver_parse("2.0.0", v_200) == 1)
    assert(read_word(v_200, 0) == 2)
    assert(read_word(v_200, 8) == 0)
    assert(read_word(v_200, 16) == 0)

    assert(semver_parse("2.0.1", v_201) == 1)
    assert(semver_parse("2.1.0", v_210) == 1)
    assert(semver_parse("1.9.9", v_199) == 1)
    assert(semver_parse("3.0.0", v_300) == 1)

    # 1. Comparison assertions
    assert(semver_cmp(v_200, v_200) == 0)
    assert(semver_cmp(v_201, v_200) == 1)
    assert(semver_cmp(v_200, v_201) == (0 - 1))
    assert(semver_cmp(v_210, v_201) == 1)
    assert(semver_cmp(v_199, v_200) == (0 - 1))
    assert(semver_cmp(v_300, v_210) == 1)

    # 2. Caret constraint ^2.0.0 matches 2.0.0, 2.0.1, 2.1.0 but not 1.9.9 or 3.0.0
    assert(semver_satisfies_caret(v_200, v_200) == 1)
    assert(semver_satisfies_caret(v_201, v_200) == 1)
    assert(semver_satisfies_caret(v_210, v_200) == 1)
    assert(semver_satisfies_caret(v_199, v_200) == 0) # lower
    assert(semver_satisfies_caret(v_300, v_200) == 0) # major bump

    out 0
end.
