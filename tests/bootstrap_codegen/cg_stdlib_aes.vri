# Phase G4: Test std/crypto/aes — AES-128 Block Transformations & GF(2^8) (Spec §9, stdlib/vir/crypto)

# Galois Field GF(2^8) multiplication by 2 (xtime)
func gf_xtime(b):
    let doubled = (b shl 1) bit_and 255
    if (b bit_and 0x80) != 0 do
        out doubled bit_xor 0x1B
    end
    out doubled
end.

# AES S-Box sample lookup
func aes_sbox_sample(b):
    if b == 0x00 do out 0x63 end
    if b == 0x01 do out 0x7c end
    if b == 0x53 do out 0xed end
    if b == 0xff do out 0x16 end
    if b == 0x11 do out 0x82 end
    out b bit_xor 0x63 # default fallthrough
end.

func aes_add_round_key(state, round_key):
    var i = 0
    when i < 16 loop
        let s = read_byte(state, i)
        let k = read_byte(round_key, i)
        write_byte(state, i, s bit_xor k)
        i = i + 1
    end
end.

# AES 4x4 State matrix (column-major standard layout):
#  0  4  8 12
#  1  5  9 13
#  2  6 10 14
#  3  7 11 15

func aes_shift_rows(state):
    # Row 1 (indices 1, 5, 9, 13): left shift 1
    let r1_0 = read_byte(state, 1)
    let r1_1 = read_byte(state, 5)
    let r1_2 = read_byte(state, 9)
    let r1_3 = read_byte(state, 13)
    write_byte(state, 1, r1_1)
    write_byte(state, 5, r1_2)
    write_byte(state, 9, r1_3)
    write_byte(state, 13, r1_0)

    # Row 2 (indices 2, 6, 10, 14): left shift 2
    let r2_0 = read_byte(state, 2)
    let r2_1 = read_byte(state, 6)
    let r2_2 = read_byte(state, 10)
    let r2_3 = read_byte(state, 14)
    write_byte(state, 2, r2_2)
    write_byte(state, 6, r2_3)
    write_byte(state, 10, r2_0)
    write_byte(state, 14, r2_1)

    # Row 3 (indices 3, 7, 11, 15): left shift 3
    let r3_0 = read_byte(state, 3)
    let r3_1 = read_byte(state, 7)
    let r3_2 = read_byte(state, 11)
    let r3_3 = read_byte(state, 15)
    write_byte(state, 3, r3_3)
    write_byte(state, 7, r3_0)
    write_byte(state, 11, r3_1)
    write_byte(state, 15, r3_2)
end.

func aes_inv_shift_rows(state):
    # Row 1 (indices 1, 5, 9, 13): right shift 1
    let r1_0 = read_byte(state, 1)
    let r1_1 = read_byte(state, 5)
    let r1_2 = read_byte(state, 9)
    let r1_3 = read_byte(state, 13)
    write_byte(state, 1, r1_3)
    write_byte(state, 5, r1_0)
    write_byte(state, 9, r1_1)
    write_byte(state, 13, r1_2)

    # Row 2 (indices 2, 6, 10, 14): right shift 2
    let r2_0 = read_byte(state, 2)
    let r2_1 = read_byte(state, 6)
    let r2_2 = read_byte(state, 10)
    let r2_3 = read_byte(state, 14)
    write_byte(state, 2, r2_2)
    write_byte(state, 6, r2_3)
    write_byte(state, 10, r2_0)
    write_byte(state, 14, r2_1)

    # Row 3 (indices 3, 7, 11, 15): right shift 3
    let r3_0 = read_byte(state, 3)
    let r3_1 = read_byte(state, 7)
    let r3_2 = read_byte(state, 11)
    let r3_3 = read_byte(state, 15)
    write_byte(state, 3, r3_1)
    write_byte(state, 7, r3_2)
    write_byte(state, 11, r3_3)
    write_byte(state, 15, r3_0)
end.

# AES MixSingleColumn on 4 bytes:
# d0 = (2*a0) ^ (3*a1) ^ a2 ^ a3
# d1 = a0 ^ (2*a1) ^ (3*a2) ^ a3
# d2 = a0 ^ a1 ^ (2*a2) ^ (3*a3)
# d3 = (3*a0) ^ a1 ^ a2 ^ (2*a3)
func aes_mix_col(a0, a1, a2, a3, out_col):
    let t = a0 bit_xor a1 bit_xor a2 bit_xor a3
    let u0 = a0 bit_xor a1
    let u1 = a1 bit_xor a2
    let u2 = a2 bit_xor a3
    let u3 = a3 bit_xor a0

    let d0 = a0 bit_xor t bit_xor gf_xtime(u0)
    let d1 = a1 bit_xor t bit_xor gf_xtime(u1)
    let d2 = a2 bit_xor t bit_xor gf_xtime(u2)
    let d3 = a3 bit_xor t bit_xor gf_xtime(u3)

    write_byte(out_col, 0, d0 bit_and 255)
    write_byte(out_col, 1, d1 bit_and 255)
    write_byte(out_col, 2, d2 bit_and 255)
    write_byte(out_col, 3, d3 bit_and 255)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. GF(2^8) multiplication by 2 (xtime)
    assert(gf_xtime(0x57) == 0xAE)
    assert(gf_xtime(0xAE) == 0x47) # 0x5C ^ 0x1B = 0x47
    assert(gf_xtime(0x47) == 0x8E)
    assert(gf_xtime(0x8E) == 0x07) # 0x1C ^ 0x1B = 0x07

    # 2. S-Box samples
    assert(aes_sbox_sample(0x00) == 0x63)
    assert(aes_sbox_sample(0x01) == 0x7c)
    assert(aes_sbox_sample(0x53) == 0xed)
    assert(aes_sbox_sample(0xff) == 0x16)

    # 3. AddRoundKey involution (State ^ Key ^ Key == State)
    let state = alloc(16)
    let key = alloc(16)
    var i = 0
    when i < 16 loop
        write_byte(state, i, i * 17 + 5)
        write_byte(key, i, i * 31 + 11)
        i = i + 1
    end

    let orig_byte0 = read_byte(state, 0)
    let orig_byte7 = read_byte(state, 7)
    let orig_byte15 = read_byte(state, 15)

    aes_add_round_key(state, key) # Encrypt
    assert(read_byte(state, 0) != orig_byte0) # Modified

    aes_add_round_key(state, key) # Decrypt
    assert(read_byte(state, 0) == orig_byte0) # Recovered
    assert(read_byte(state, 7) == orig_byte7)
    assert(read_byte(state, 15) == orig_byte15)

    # 4. ShiftRows & InvShiftRows roundtrip
    i = 0
    when i < 16 loop
        write_byte(state, i, i)
        i = i + 1
    end

    aes_shift_rows(state)
    # Check row 1 shifted: state[1] was 5, state[5] was 9, state[9] was 13, state[13] was 1
    assert(read_byte(state, 1) == 5)
    assert(read_byte(state, 5) == 9)
    assert(read_byte(state, 9) == 13)
    assert(read_byte(state, 13) == 1)

    aes_inv_shift_rows(state)
    # Recovered 0..15
    i = 0
    when i < 16 loop
        assert(read_byte(state, i) == i)
        i = i + 1
    end

    # 5. MixColumns test on FIPS 197 standard column: [0xdb, 0x13, 0x53, 0x45] -> [0x8e, 0x4d, 0xd1, 0xbc]
    let col_out = alloc(4)
    aes_mix_col(0xdb, 0x13, 0x53, 0x45, col_out)
    assert(read_byte(col_out, 0) == 0x8e)
    assert(read_byte(col_out, 1) == 0x4d)
    assert(read_byte(col_out, 2) == 0xd1)
    assert(read_byte(col_out, 3) == 0xbc)

    out 0
end.
