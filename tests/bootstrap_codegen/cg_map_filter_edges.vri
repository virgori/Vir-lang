# EXPECT_END
func main:
    var none_src = [1, 3, 5]
    var none = map x in none_src:
        if x mod 2 == 0 do
            out x
        end
    end.
    print len(none)

    var all_src = [2, 4, 6]
    var all = map x in all_src:
        if x mod 2 == 0 do
            out x
        end
    end.
    print len(all)
    print all[0]
    print all[1]
    print all[2]

    var mixed_src = [1, 2, 3, 4]
    var mixed = map x in mixed_src:
        if x mod 2 == 0 do
            out x
        end
    end.
    print len(mixed)
    print mixed[0]
    print mixed[1]

    var scaled = map x in all_src:
        out x * 2
    end.
    print len(scaled)
    print scaled[0]
    print scaled[1]
    print scaled[2]
end.
