# Test: WebAssembly (WASM MVP) Binary Module Generator & Structural Validator (Spec §9, stdlib/vir/wasm)

func u32_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
    write_byte(buf, off + 2, (val shr 16) bit_and 255)
    write_byte(buf, off + 3, (val shr 24) bit_and 255)
end.

# Generates a valid .wasm binary module containing exported function: add(a: i32, b: i32) -> i32
func wasm_module_create(out_buf):
    var p = 0

    # 1. Header (8 bytes)
    # Magic: \0asm (0x00, 0x61, 0x73, 0x6D)
    write_byte(out_buf, 0, 0x00)
    write_byte(out_buf, 1, 0x61)
    write_byte(out_buf, 2, 0x73)
    write_byte(out_buf, 3, 0x6D)
    # Version: 1 (0x01, 0x00, 0x00, 0x00)
    write_byte(out_buf, 4, 0x01)
    write_byte(out_buf, 5, 0x00)
    write_byte(out_buf, 6, 0x00)
    write_byte(out_buf, 7, 0x00)
    p = 8

    # 2. Section 1: Type Section (ID = 1)
    # Type 0: (i32, i32) -> i32: 0x60, 0x02, 0x7F, 0x7F, 0x01, 0x7F (6 bytes payload)
    write_byte(out_buf, p, 1)    # Section ID = 1 (Type)
    write_byte(out_buf, p + 1, 7)# Section size = 7 bytes
    write_byte(out_buf, p + 2, 1)# 1 type entry
    write_byte(out_buf, p + 3, 0x60) # functype
    write_byte(out_buf, p + 4, 2)    # 2 params
    write_byte(out_buf, p + 5, 0x7F) # i32
    write_byte(out_buf, p + 6, 0x7F) # i32
    write_byte(out_buf, p + 7, 1)    # 1 return
    write_byte(out_buf, p + 8, 0x7F) # i32
    p = p + 9

    # 3. Section 3: Function Section (ID = 3)
    # 1 function of type 0
    write_byte(out_buf, p, 3)    # Section ID = 3 (Function)
    write_byte(out_buf, p + 1, 2)# Section size = 2 bytes
    write_byte(out_buf, p + 2, 1)# 1 function entry
    write_byte(out_buf, p + 3, 0)# type index 0
    p = p + 4

    # 4. Section 7: Export Section (ID = 7)
    # Export "add" -> func 0
    write_byte(out_buf, p, 7)    # Section ID = 7 (Export)
    write_byte(out_buf, p + 1, 7)# Section size = 7 bytes
    write_byte(out_buf, p + 2, 1)# 1 export entry
    write_byte(out_buf, p + 3, 3)# name length = 3
    write_byte(out_buf, p + 4, 97) # 'a'
    write_byte(out_buf, p + 5, 100)# 'd'
    write_byte(out_buf, p + 6, 100)# 'd'
    write_byte(out_buf, p + 7, 0)  # Export kind = 0 (Function)
    write_byte(out_buf, p + 8, 0)  # Function index = 0
    p = p + 9

    # 5. Section 10: Code Section (ID = 10 / 0x0A)
    # Body: 0 locals, local.get 0 (20 00), local.get 1 (20 01), i32.add (6A), end (0B)
    # Total body size = 7 bytes (1 byte local count 0 + 6 bytes code)
    write_byte(out_buf, p, 10)   # Section ID = 10 (Code)
    write_byte(out_buf, p + 1, 9)# Section size = 9 bytes
    write_byte(out_buf, p + 2, 1)# 1 function body entry
    write_byte(out_buf, p + 3, 7)# Body size = 7 bytes
    write_byte(out_buf, p + 4, 0)# 0 local declarations
    write_byte(out_buf, p + 5, 0x20) # local.get
    write_byte(out_buf, p + 6, 0x00) # local 0
    write_byte(out_buf, p + 7, 0x20) # local.get
    write_byte(out_buf, p + 8, 0x01) # local 1
    write_byte(out_buf, p + 9, 0x6A) # i32.add
    write_byte(out_buf, p + 10, 0x0B)# end
    p = p + 11

    out p
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let wasm_buf = alloc(128)
    let total_len = wasm_module_create(wasm_buf)

    # 1. Verify total binary size
    assert(total_len == 41) # 8 header + 9 type + 4 func + 9 export + 11 code = 41 bytes

    # 2. Verify WASM Magic & Version
    assert(read_byte(wasm_buf, 0) == 0x00)
    assert(read_byte(wasm_buf, 1) == 0x61) # 'a'
    assert(read_byte(wasm_buf, 2) == 0x73) # 's'
    assert(read_byte(wasm_buf, 3) == 0x6D) # 'm'
    assert(read_byte(wasm_buf, 4) == 0x01) # Version 1
    assert(read_byte(wasm_buf, 5) == 0x00)
    assert(read_byte(wasm_buf, 6) == 0x00)
    assert(read_byte(wasm_buf, 7) == 0x00)

    # 3. Verify Type Section
    assert(read_byte(wasm_buf, 8) == 1)    # Type Section ID
    assert(read_byte(wasm_buf, 11) == 0x60)# functype
    assert(read_byte(wasm_buf, 12) == 2)   # 2 params
    assert(read_byte(wasm_buf, 13) == 0x7F)# i32
    assert(read_byte(wasm_buf, 14) == 0x7F)# i32
    assert(read_byte(wasm_buf, 15) == 1)   # 1 result
    assert(read_byte(wasm_buf, 16) == 0x7F)# i32

    # 4. Verify Function Section
    assert(read_byte(wasm_buf, 17) == 3)   # Function Section ID
    assert(read_byte(wasm_buf, 20) == 0)   # type index 0

    # 5. Verify Export Section
    assert(read_byte(wasm_buf, 21) == 7)   # Export Section ID
    assert(read_byte(wasm_buf, 24) == 3)   # name length 3
    assert(read_byte(wasm_buf, 25) == 97)  # 'a'
    assert(read_byte(wasm_buf, 26) == 100) # 'd'
    assert(read_byte(wasm_buf, 27) == 100) # 'd'
    assert(read_byte(wasm_buf, 28) == 0)   # func export
    assert(read_byte(wasm_buf, 29) == 0)   # func index 0

    # 6. Verify Code Section
    assert(read_byte(wasm_buf, 30) == 10)  # Code Section ID
    assert(read_byte(wasm_buf, 34) == 0)   # 0 locals
    assert(read_byte(wasm_buf, 35) == 0x20)# local.get
    assert(read_byte(wasm_buf, 36) == 0x00)# 0
    assert(read_byte(wasm_buf, 37) == 0x20)# local.get
    assert(read_byte(wasm_buf, 38) == 0x01)# 1
    assert(read_byte(wasm_buf, 39) == 0x6A)# i32.add
    assert(read_byte(wasm_buf, 40) == 0x0B)# end

    out 0
end.
