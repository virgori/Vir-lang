# Test throw, revert, ensure in function scope (§13.1, §13.2, §13.3)
func divide_safe(a, b):
    var res = 0
    if b == 0 do
        throw 404
    end
    res = a / b
    out res
revert:
    # On error: erx is the error code (404)
    out erx
ensure:
    # Ensure block always runs
end.

func main:
    let r1 = divide_safe(10, 2)
    if r1 != 5 do
        out 1
    end
    let r2 = divide_safe(10, 0)
    if r2 != 404 do
        out 2
    end
    out 0
end.
