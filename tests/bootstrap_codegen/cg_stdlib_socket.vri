# Phase F8: Test std/net/socket — Sockaddr Packing & Network Byte Order (Spec §9, stdlib/vir/net)

# Convert 16-bit integer to Network Byte Order (Big Endian)
func net_htons(p):
    let b0 = p bit_and 255
    let b1 = (p shr 8) bit_and 255
    out (b0 shl 8) bit_or b1
end.

func net_ntohs(p):
    out net_htons(p)
end.

# Convert 32-bit integer to Network Byte Order (Big Endian)
func net_htonl(ip):
    let b0 = ip bit_and 255
    let b1 = (ip shr 8) bit_and 255
    let b2 = (ip shr 16) bit_and 255
    let b3 = (ip shr 24) bit_and 255
    out (b0 shl 24) bit_or (b1 shl 16) bit_or (b2 shl 8) bit_or b3
end.

func net_ntohl(ip):
    out net_htonl(ip)
end.

# macOS BSD sockaddr_in layout (16 bytes):
# byte 0: sin_len (16)
# byte 1: sin_family (AF_INET = 2)
# byte 2-3: sin_port (big endian)
# byte 4-7: sin_addr (big endian)
# byte 8-15: sin_zero (0)

func sockaddr_in_init(buf, ip_host_order, port_host_order):
    write_byte(buf, 0, 16) # sin_len
    write_byte(buf, 1, 2)  # AF_INET = 2

    # Store port in network byte order
    let net_port = net_htons(port_host_order)
    write_byte(buf, 2, (net_port shr 8) bit_and 255)
    write_byte(buf, 3, net_port bit_and 255)

    # Store IP in network byte order
    write_byte(buf, 4, (ip_host_order shr 24) bit_and 255)
    write_byte(buf, 5, (ip_host_order shr 16) bit_and 255)
    write_byte(buf, 6, (ip_host_order shr 8) bit_and 255)
    write_byte(buf, 7, ip_host_order bit_and 255)

    # Zero padding
    var i = 8
    when i < 16 loop
        write_byte(buf, i, 0)
        i = i + 1
    end
end.

func sockaddr_in_get_port(buf):
    let b0 = read_byte(buf, 2)
    let b1 = read_byte(buf, 3)
    let raw_port = (b0 shl 8) bit_or b1
    out net_ntohs(raw_port)
end.

func sockaddr_in_get_ip(buf):
    let b0 = read_byte(buf, 4)
    let b1 = read_byte(buf, 5)
    let b2 = read_byte(buf, 6)
    let b3 = read_byte(buf, 7)
    out (b0 shl 24) bit_or (b1 shl 16) bit_or (b2 shl 8) bit_or b3
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Test htons / ntohs
    assert(net_htons(80) == 20480) # 0x0050 -> 0x5000 (20480)
    assert(net_ntohs(20480) == 80)

    assert(net_htons(8080) == 36903) # 0x1F90 -> 0x901F (36903)
    assert(net_ntohs(36903) == 8080)

    # 2. Test htonl / ntohl
    # 192.168.1.1 = 0xC0A80101 -> 0x0101A8C0 (16886208)
    assert(net_htonl(3232235777) == 16886208)
    assert(net_ntohl(16886208) == 3232235777)

    # 3. Test sockaddr_in packing & extraction
    let sin = alloc(16)
    # Pack 127.0.0.1:8080
    sockaddr_in_init(sin, 2130706433, 8080) # 0x7F000001 = 2130706433

    assert(read_byte(sin, 0) == 16) # sin_len
    assert(read_byte(sin, 1) == 2)  # AF_INET
    assert(sockaddr_in_get_port(sin) == 8080)
    assert(sockaddr_in_get_ip(sin) == 2130706433)

    # Pack 192.168.1.50:443
    sockaddr_in_init(sin, 3232235826, 443)
    assert(sockaddr_in_get_port(sin) == 443)
    assert(sockaddr_in_get_ip(sin) == 3232235826)

    out 0
end.
