# Phase H5: Test std/test/doctest — Docstring Test Extractor & Runner (Spec §9, stdlib/vir/test)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func copy_slice(src, start, end_pos, dst):
    var dst_idx = 0
    var i = start
    when i < end_pos loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
end.

# TestCase layout (16 bytes):
# word 0: prompt (cstr, e.g. "add(10, 20)")
# word 8: expected (cstr, e.g. "30")

func doctest_extract(doc, out_tests, max_cases):
    let dlen = cstr_len(doc)
    var p = 0
    var case_cnt = 0

    when (p < dlen) and (case_cnt < max_cases) loop
        # Look for ">>> "
        if (p + 3 < dlen) and (read_byte(doc, p) == 62) and (read_byte(doc, p + 1) == 62) and (read_byte(doc, p + 2) == 62) and (read_byte(doc, p + 3) == 32) do
            p = p + 4
            let prompt_start = p
            when (p < dlen) and (read_byte(doc, p) != 10) and (read_byte(doc, p) != 13) loop
                p = p + 1
            end
            let prompt_buf = alloc(p - prompt_start + 1)
            copy_slice(doc, prompt_start, p, prompt_buf)

            # Skip newline
            when (p < dlen) and ((read_byte(doc, p) == 10) or (read_byte(doc, p) == 13) or (read_byte(doc, p) == 35) or (read_byte(doc, p) == 32)) loop
                p = p + 1
            end

            # Next line is expected output
            let exp_start = p
            when (p < dlen) and (read_byte(doc, p) != 10) and (read_byte(doc, p) != 13) loop
                p = p + 1
            end
            let exp_buf = alloc(p - exp_start + 1)
            copy_slice(doc, exp_start, p, exp_buf)

            let slot = out_tests + case_cnt * 16
            write_word(slot, 0, prompt_buf)
            write_word(slot, 8, exp_buf)
            case_cnt = case_cnt + 1
        else
            p = p + 1
        end
    end
    out case_cnt
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let doc_sample = "## Math helpers\n# >>> square(4)\n# 16\n# >>> add(10, 20)\n# 30\n"
    let tests = alloc(8 * 16)

    let cnt = doctest_extract(doc_sample, tests, 8)
    assert(cnt == 2)

    # Test case 1: square(4) -> 16
    let t0 = tests + 0 * 16
    assert(cstr_eq(read_word(t0, 0), "square(4)") == 1)
    assert(cstr_eq(read_word(t0, 8), "16") == 1)

    # Test case 2: add(10, 20) -> 30
    let t1 = tests + 1 * 16
    assert(cstr_eq(read_word(t1, 0), "add(10, 20)") == 1)
    assert(cstr_eq(read_word(t1, 8), "30") == 1)

    out 0
end.
