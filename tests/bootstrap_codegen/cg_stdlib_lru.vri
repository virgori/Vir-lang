# Phase C5: Test std/collections/lru — LRU Cache with Doubly Linked List & Map (Spec §9, stdlib/vir/collections)

# Node layout at ptr:
# word 0: key (i64)
# word 8: val (i64)
# word 16: prev ptr (i64, 0 if none)
# word 24: next ptr (i64, 0 if none)

# LRU Cache layout at ptr:
# word 0: capacity
# word 8: size
# word 16: head ptr (MRU)
# word 24: tail ptr (LRU)
# word 32: map ptr (simple hash map for node lookup)

func lru_node_new(key, val):
    let n = alloc(32)
    write_word(n, 0, key)
    write_word(n, 8, val)
    write_word(n, 16, 0)
    write_word(n, 24, 0)
    out n
end.

# Simple map for node pointer lookup by key
func node_map_create(cap):
    let m = alloc(32)
    write_word(m, 0, cap)
    write_word(m, 8, alloc(cap * 8)) # keys
    write_word(m, 16, alloc(cap * 8)) # node ptrs
    write_word(m, 24, alloc(cap * 8)) # state: 0=empty, 1=used
    var i = 0
    let keys = read_word(m, 8)
    let state = read_word(m, 24)
    when i < cap loop
        write_word(keys, i * 8, 0)
        write_word(state, i * 8, 0)
        i = i + 1
    end
    out m
end.

func node_map_put(m, key, node_ptr):
    let cap = read_word(m, 0)
    let keys = read_word(m, 8)
    let ptrs = read_word(m, 16)
    let state = read_word(m, 24)
    let h = (key * 2654435761) bit_and 0x7FFFFFFF
    var idx = h % cap
    var probe = 0
    var done = 0
    when (probe < cap) and (done == 0) loop
        let s = read_word(state, idx * 8)
        if (s == 0) or (read_word(keys, idx * 8) == key) do
            write_word(keys, idx * 8, key)
            write_word(ptrs, idx * 8, node_ptr)
            write_word(state, idx * 8, 1)
            done = 1
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
end.

func node_map_get(m, key):
    let cap = read_word(m, 0)
    let keys = read_word(m, 8)
    let ptrs = read_word(m, 16)
    let state = read_word(m, 24)
    let h = (key * 2654435761) bit_and 0x7FFFFFFF
    var idx = h % cap
    var probe = 0
    when probe < cap loop
        let s = read_word(state, idx * 8)
        if s == 0 do out 0 end
        if (s == 1) and (read_word(keys, idx * 8) == key) do
            out read_word(ptrs, idx * 8)
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
    out 0
end.

func node_map_remove(m, key):
    let cap = read_word(m, 0)
    let keys = read_word(m, 8)
    let state = read_word(m, 24)
    let h = (key * 2654435761) bit_and 0x7FFFFFFF
    var idx = h % cap
    var probe = 0
    when probe < cap loop
        let s = read_word(state, idx * 8)
        if s == 0 do out end
        if (s == 1) and (read_word(keys, idx * 8) == key) do
            write_word(state, idx * 8, 0) # Clear slot
            out
        end
        idx = (idx + 1) % cap
        probe = probe + 1
    end
end.

func lru_create(cap):
    let c = alloc(40)
    write_word(c, 0, cap)
    write_word(c, 8, 0) # size = 0
    write_word(c, 16, 0) # head = 0
    write_word(c, 24, 0) # tail = 0
    write_word(c, 32, node_map_create(cap * 4))
    out c
end.

# Detach node from doubly-linked list
func lru_detach(c, node):
    let prev = read_word(node, 16)
    let next = read_word(node, 24)
    if prev != 0 do
        write_word(prev, 24, next)
    else
        write_word(c, 16, next) # update head
    end
    if next != 0 do
        write_word(next, 16, prev)
    else
        write_word(c, 24, prev) # update tail
    end
    write_word(node, 16, 0)
    write_word(node, 24, 0)
end.

# Attach node at head (MRU)
func lru_attach_head(c, node):
    let head = read_word(c, 16)
    write_word(node, 24, head)
    write_word(node, 16, 0)
    if head != 0 do
        write_word(head, 16, node)
    else
        write_word(c, 24, node) # if list was empty, tail = node
    end
    write_word(c, 16, node)
end.

func lru_get(c, key):
    let m = read_word(c, 32)
    let node = node_map_get(m, key)
    if node == 0 do
        out 0 - 1
    end
    # Move to head (MRU)
    lru_detach(c, node)
    lru_attach_head(c, node)
    out read_word(node, 8)
end.

func lru_put(c, key, val):
    let m = read_word(c, 32)
    let node = node_map_get(m, key)
    if node != 0 do
        write_word(node, 8, val)
        lru_detach(c, node)
        lru_attach_head(c, node)
        out
    end

    let sz = read_word(c, 8)
    let cap = read_word(c, 0)
    if sz >= cap do
        # Evict LRU tail
        let tail = read_word(c, 24)
        if tail != 0 do
            let evict_key = read_word(tail, 0)
            node_map_remove(m, evict_key)
            lru_detach(c, tail)
            write_word(c, 8, sz - 1)
        end
    end

    let new_node = lru_node_new(key, val)
    lru_attach_head(c, new_node)
    node_map_put(m, key, new_node)
    let cur_sz = read_word(c, 8)
    write_word(c, 8, cur_sz + 1)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let cache = lru_create(3)
    assert(read_word(cache, 8) == 0)
    assert(lru_get(cache, 1) == (0 - 1))

    # 1. Put 3 items
    lru_put(cache, 1, 10)
    lru_put(cache, 2, 20)
    lru_put(cache, 3, 30)
    assert(read_word(cache, 8) == 3)

    # 2. Access key 1 -> promotes 1 to MRU (order: 1, 3, 2)
    assert(lru_get(cache, 1) == 10)

    # 3. Put key 4 -> should evict LRU (which is key 2)
    lru_put(cache, 4, 40)
    assert(read_word(cache, 8) == 3)
    assert(lru_get(cache, 2) == (0 - 1)) # Key 2 was evicted!
    assert(lru_get(cache, 1) == 10)     # Key 1 still exists
    assert(lru_get(cache, 3) == 30)     # Key 3 still exists
    assert(lru_get(cache, 4) == 40)     # Key 4 still exists

    # Order after get(1), get(3), get(4) is: 4, 3, 1
    # 4. Update key 3 value to 300 -> promotes 3 to MRU (order: 3, 4, 1)
    lru_put(cache, 3, 300)
    assert(lru_get(cache, 3) == 300)

    # 5. Put key 5 -> should evict LRU (which is key 1!)
    lru_put(cache, 5, 50)
    assert(lru_get(cache, 1) == (0 - 1)) # Key 1 was evicted!
    assert(lru_get(cache, 3) == 300)
    assert(lru_get(cache, 4) == 40)
    assert(lru_get(cache, 5) == 50)

    out 0
end.
