# Phase C2: Test std/collections/heap — Binary Min/Max Heap Priority Queue (Spec §9, stdlib/vir/collections)

# Heap layout at ptr:
# word 0: capacity
# word 1: size
# word 2: data array ptr (i64)

func heap_create(cap):
    let h = alloc(24)
    write_word(h, 0, cap)
    write_word(h, 8, 0)
    let data = alloc(cap * 8)
    write_word(h, 16, data)
    out h
end.

func heap_size(h):
    out read_word(h, 8)
end.

func heap_is_empty(h):
    if read_word(h, 8) == 0 do
        out 1
    end
    out 0
end.

func min_heap_push(h, val):
    let sz = read_word(h, 8)
    let cap = read_word(h, 0)
    if sz >= cap do out 0 end
    let data = read_word(h, 16)
    write_word(data, sz * 8, val)
    write_word(h, 8, sz + 1)

    # Sift up
    var idx = sz
    var done = 0
    when (idx > 0) and (done == 0) loop
        let p_idx = (idx - 1) / 2
        let cur_val = read_word(data, idx * 8)
        let parent_val = read_word(data, p_idx * 8)
        if cur_val < parent_val do
            write_word(data, idx * 8, parent_val)
            write_word(data, p_idx * 8, cur_val)
            idx = p_idx
        else
            done = 1
        end
    end
    out 1
end.

func min_heap_peek(h):
    let sz = read_word(h, 8)
    if sz == 0 do out 0 - 1 end
    let data = read_word(h, 16)
    out read_word(data, 0)
end.

func min_heap_pop(h):
    let sz = read_word(h, 8)
    if sz == 0 do out 0 - 1 end
    let data = read_word(h, 16)
    let root = read_word(data, 0)
    let last = read_word(data, (sz - 1) * 8)
    write_word(h, 8, sz - 1)
    if sz == 1 do
        out root
    end

    write_word(data, 0, last)
    let new_sz = sz - 1

    # Sift down
    var idx = 0
    var done = 0
    when done == 0 loop
        let l_idx = 2 * idx + 1
        let r_idx = 2 * idx + 2
        var smallest = idx
        if l_idx < new_sz do
            if read_word(data, l_idx * 8) < read_word(data, smallest * 8) do
                smallest = l_idx
            end
        end
        if r_idx < new_sz do
            if read_word(data, r_idx * 8) < read_word(data, smallest * 8) do
                smallest = r_idx
            end
        end
        if smallest != idx do
            let tmp = read_word(data, idx * 8)
            write_word(data, idx * 8, read_word(data, smallest * 8))
            write_word(data, smallest * 8, tmp)
            idx = smallest
        else
            done = 1
        end
    end
    out root
end.

# Max Heap Push & Pop
func max_heap_push(h, val):
    let sz = read_word(h, 8)
    let cap = read_word(h, 0)
    if sz >= cap do out 0 end
    let data = read_word(h, 16)
    write_word(data, sz * 8, val)
    write_word(h, 8, sz + 1)

    var idx = sz
    var done = 0
    when (idx > 0) and (done == 0) loop
        let p_idx = (idx - 1) / 2
        let cur_val = read_word(data, idx * 8)
        let parent_val = read_word(data, p_idx * 8)
        if cur_val > parent_val do
            write_word(data, idx * 8, parent_val)
            write_word(data, p_idx * 8, cur_val)
            idx = p_idx
        else
            done = 1
        end
    end
    out 1
end.

func max_heap_pop(h):
    let sz = read_word(h, 8)
    if sz == 0 do out 0 - 1 end
    let data = read_word(h, 16)
    let root = read_word(data, 0)
    let last = read_word(data, (sz - 1) * 8)
    write_word(h, 8, sz - 1)
    if sz == 1 do
        out root
    end

    write_word(data, 0, last)
    let new_sz = sz - 1

    var idx = 0
    var done = 0
    when done == 0 loop
        let l_idx = 2 * idx + 1
        let r_idx = 2 * idx + 2
        var largest = idx
        if l_idx < new_sz do
            if read_word(data, l_idx * 8) > read_word(data, largest * 8) do
                largest = l_idx
            end
        end
        if r_idx < new_sz do
            if read_word(data, r_idx * 8) > read_word(data, largest * 8) do
                largest = r_idx
            end
        end
        if largest != idx do
            let tmp = read_word(data, idx * 8)
            write_word(data, idx * 8, read_word(data, largest * 8))
            write_word(data, largest * 8, tmp)
            idx = largest
        else
            done = 1
        end
    end
    out root
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Min-Heap basic operations
    let min_h = heap_create(32)
    assert(heap_is_empty(min_h) == 1)
    assert(heap_size(min_h) == 0)
    assert(min_heap_peek(min_h) == (0 - 1))
    assert(min_heap_pop(min_h) == (0 - 1))

    min_heap_push(min_h, 45)
    min_heap_push(min_h, 12)
    min_heap_push(min_h, 89)
    min_heap_push(min_h, 3)
    min_heap_push(min_h, 50)
    min_heap_push(min_h, 23)
    min_heap_push(min_h, 7)

    assert(heap_size(min_h) == 7)
    assert(heap_is_empty(min_h) == 0)
    assert(min_heap_peek(min_h) == 3)

    # Pop all items in ascending order
    assert(min_heap_pop(min_h) == 3)
    assert(min_heap_pop(min_h) == 7)
    assert(min_heap_pop(min_h) == 12)
    assert(min_heap_pop(min_h) == 23)
    assert(min_heap_pop(min_h) == 45)
    assert(min_heap_pop(min_h) == 50)
    assert(min_heap_pop(min_h) == 89)
    assert(heap_is_empty(min_h) == 1)
    assert(heap_size(min_h) == 0)

    # 2. Max-Heap operations
    let max_h = heap_create(32)
    max_heap_push(max_h, 45)
    max_heap_push(max_h, 12)
    max_heap_push(max_h, 89)
    max_heap_push(max_h, 3)
    max_heap_push(max_h, 50)
    max_heap_push(max_h, 23)
    max_heap_push(max_h, 7)

    assert(heap_size(max_h) == 7)
    # Pop in descending order
    assert(max_heap_pop(max_h) == 89)
    assert(max_heap_pop(max_h) == 50)
    assert(max_heap_pop(max_h) == 45)
    assert(max_heap_pop(max_h) == 23)
    assert(max_heap_pop(max_h) == 12)
    assert(max_heap_pop(max_h) == 7)
    assert(max_heap_pop(max_h) == 3)
    assert(heap_is_empty(max_h) == 1)

    # 3. Heap sort 15 elements test
    let sort_h = heap_create(16)
    let raw = alloc(15 * 8)
    write_word(raw, 0 * 8, 42)
    write_word(raw, 1 * 8, 17)
    write_word(raw, 2 * 8, 93)
    write_word(raw, 3 * 8, 5)
    write_word(raw, 4 * 8, 68)
    write_word(raw, 5 * 8, 1)
    write_word(raw, 6 * 8, 33)
    write_word(raw, 7 * 8, 88)
    write_word(raw, 8 * 8, 19)
    write_word(raw, 9 * 8, 54)
    write_word(raw, 10 * 8, 77)
    write_word(raw, 11 * 8, 26)
    write_word(raw, 12 * 8, 9)
    write_word(raw, 13 * 8, 62)
    write_word(raw, 14 * 8, 48)

    var i = 0
    when i < 15 loop
        min_heap_push(sort_h, read_word(raw, i * 8))
        i = i + 1
    end

    var prev = min_heap_pop(sort_h)
    i = 1
    when i < 15 loop
        let cur = min_heap_pop(sort_h)
        assert(cur >= prev) # Verifies sorted property
        prev = cur
        i = i + 1
    end
    assert(heap_is_empty(sort_h) == 1)

    out 0
end.
