# Test: Linux RISC-V 64-bit (RV64) ELF 64-bit Executable Generator & Validator (Spec §9, stdlib/vir/rt/elf)

func u16_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
end.

func u32_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
    write_byte(buf, off + 2, (val shr 16) bit_and 255)
    write_byte(buf, off + 3, (val shr 24) bit_and 255)
end.

func u64_le(buf, off, lo, hi):
    u32_le(buf, off, lo)
    u32_le(buf, off + 4, hi)
end.

func read_u16_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    out (b1 shl 8) bit_or b0
end.

func read_u32_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    let b2 = read_byte(buf, off + 2)
    let b3 = read_byte(buf, off + 3)
    out (b3 shl 24) bit_or (b2 shl 16) bit_or (b1 shl 8) bit_or b0
end.

func elf_riscv64_create(code_ptr, code_len, entry_offset, out_buf):
    let code_offset = 128
    let total_file_size = code_offset + code_len

    var i = 0
    when i < total_file_size loop
        write_byte(out_buf, i, 0)
        i = i + 1
    end

    # 1. ELF Header (64 bytes)
    write_byte(out_buf, 0, 0x7F)
    write_byte(out_buf, 1, 0x45) # 'E'
    write_byte(out_buf, 2, 0x4C) # 'L'
    write_byte(out_buf, 3, 0x46) # 'F'
    write_byte(out_buf, 4, 2)    # ELFCLASS64
    write_byte(out_buf, 5, 1)    # ELFDATA2LSB
    write_byte(out_buf, 6, 1)    # EV_CURRENT
    write_byte(out_buf, 7, 0)    # ELFOSABI_NONE

    u16_le(out_buf, 16, 2)       # ET_EXEC
    u16_le(out_buf, 18, 243)     # EM_RISCV = 243 (0x00F3)
    u32_le(out_buf, 20, 1)       # EV_CURRENT
    let entry_vaddr_lo = 0x00400000 + code_offset + entry_offset
    u64_le(out_buf, 24, entry_vaddr_lo, 0)
    u64_le(out_buf, 32, 64, 0)   # phoff = 64
    u64_le(out_buf, 40, 0, 0)    # shoff = 0
    u32_le(out_buf, 48, 5)       # flags: EF_RISCV_RVC | EF_RISCV_FLOAT_ABI_DOUBLE
    u16_le(out_buf, 52, 64)      # ehsize = 64
    u16_le(out_buf, 54, 56)      # phentsize = 56
    u16_le(out_buf, 56, 1)       # phnum = 1
    u16_le(out_buf, 58, 64)      # shentsize = 64
    u16_le(out_buf, 60, 0)       # shnum = 0
    u16_le(out_buf, 62, 0)       # shstrndx = 0

    # 2. Program Header PT_LOAD (56 bytes, offset 64..119)
    u32_le(out_buf, 64, 1)       # PT_LOAD
    u32_le(out_buf, 68, 7)       # PF_R | PF_W | PF_X
    u64_le(out_buf, 72, 0, 0)    # p_offset = 0
    u64_le(out_buf, 80, 0x00400000, 0)  # p_vaddr
    u64_le(out_buf, 88, 0x00400000, 0)  # p_paddr
    u64_le(out_buf, 96, total_file_size, 0) # p_filesz
    u64_le(out_buf, 104, total_file_size, 0) # p_memsz
    u64_le(out_buf, 112, 0x00010000, 0) # p_align = 64KB

    # 3. Copy Machine Code at offset 128
    i = 0
    when i < code_len loop
        write_byte(out_buf, code_offset + i, read_byte(code_ptr, i))
        i = i + 1
    end

    out total_file_size
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. RISC-V Machine code:
    #   ADDI a0, zero, 42  -> 0x02A00513 (exit code = 42)
    #   ADDI a7, zero, 93  -> 0x05D00893 (sys_exit = 93)
    #   ECALL              -> 0x00000073
    let code_buf = alloc(12)
    u32_le(code_buf, 0, 0x02A00513)
    u32_le(code_buf, 4, 0x05D00893)
    u32_le(code_buf, 8, 0x00000073)

    let elf_buf = alloc(256)
    let total_sz = elf_riscv64_create(code_buf, 12, 0, elf_buf)
    assert(total_sz == 140) # 128 header + 12 code

    # 2. Structural Validation
    # ELF Magic
    assert(read_byte(elf_buf, 0) == 0x7F)
    assert(read_byte(elf_buf, 1) == 0x45) # 'E'
    assert(read_byte(elf_buf, 2) == 0x4C) # 'L'
    assert(read_byte(elf_buf, 3) == 0x46) # 'F'
    assert(read_byte(elf_buf, 4) == 2)    # 64-bit
    assert(read_byte(elf_buf, 5) == 1)    # Little-endian

    # RISC-V Machine Header
    assert(read_u16_le(elf_buf, 16) == 2)   # ET_EXEC
    assert(read_u16_le(elf_buf, 18) == 243) # EM_RISCV = 243 (0x00F3)
    assert(read_u32_le(elf_buf, 20) == 1)   # EV_CURRENT
    assert(read_u32_le(elf_buf, 24) == 0x00400080) # Entry Point = 0x400080
    assert(read_u32_le(elf_buf, 48) == 5)   # flags

    # Program Header PT_LOAD
    assert(read_u32_le(elf_buf, 64) == 1)          # PT_LOAD
    assert(read_u32_le(elf_buf, 68) == 7)          # PF_R | PF_W | PF_X
    assert(read_u32_le(elf_buf, 80) == 0x00400000) # p_vaddr
    assert(read_u32_le(elf_buf, 96) == 140)        # p_filesz = 140
    assert(read_u32_le(elf_buf, 104) == 140)       # p_memsz = 140

    # Machine Code in .text
    assert(read_u32_le(elf_buf, 128) == 0x02A00513) # ADDI a0, zero, 42
    assert(read_u32_le(elf_buf, 132) == 0x05D00893) # ADDI a7, zero, 93
    assert(read_u32_le(elf_buf, 136) == 0x00000073) # ECALL

    out 0
end.
