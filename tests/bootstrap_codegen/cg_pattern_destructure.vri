# Test: Tuple Destructuring (Spec Section 4.5)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func make_pair(a, b):
    out (a, b)
end.

func make_triple(x, y, z):
    out (x, y, z)
end.

func main:
    # 1. Simple 2-tuple destructure
    var (a, b) = (10, 20)
    assert(a == 10)
    assert(b == 20)

    # 2. 3-tuple destructure from function return
    let (x, y, z) = make_triple(100, 200, 300)
    assert(x == 100)
    assert(y == 200)
    assert(z == 300)

    # 3. 2-tuple from function return
    let (p1, p2) = make_pair(42, 84)
    assert(p1 == 42)
    assert(p2 == 84)

    out 0
end.
