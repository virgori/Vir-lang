# Bootstrap Native Test: Sparse Conditional Constant Propagation (SCCP)
# ==============================================================================
# Spec §1.2.1 / Pillar 6 / Tier-6: SCCP (Wegman & Zadeck algorithm) simultaneously
# propagates lattice constants (Top, Constant, Bottom) and discovers executable
# CFG edges, completely pruning dead conditional branches where condition
# variables evaluate to static constants through SSA chains.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# SCCP Conditional Elimination Test: Branch condition folds statically
func sccp_compute_branch(flag_val, x):
    let c1 = 10
    let c2 = 20
    # Lattice constant: cond = (10 + 20) == 30 -> statically TRUE (1)
    let cond = (c1 + c2) == 30
    var res = 0

    if cond do
        # Active Executable Edge: SCCP keeps only this path!
        res = x * 2 + 5
    else
        # Dead Edge: SCCP completely eliminates this branch!
        res = x * 1000 + 9999
    end
    out res
end.

# SCCP 3-Level Lattice Value State Representation (Top=0, Const=1, Bottom=2)
# Encodes result as: result_type * 10000 + result_val
func sccp_meet_lattice(lat_a_type, lat_a_val, lat_b_type, lat_b_val):
    # Top meet X -> X
    if lat_a_type == 0 do
        out lat_b_type * 10000 + lat_b_val
    end
    if lat_b_type == 0 do
        out lat_a_type * 10000 + lat_a_val
    end

    # Const meet Const -> Const (if equal) else Bottom
    if lat_a_type == 1 and lat_b_type == 1 do
        if lat_a_val == lat_b_val do
            out 1 * 10000 + lat_a_val
        else
            out 2 * 10000 + 0 # Bottom (Dynamic)
        end
    end

    # Bottom meet X -> Bottom
    out 2 * 10000 + 0
end.

func main:
    # TEST 1: SCCP Executable Branch Evaluation
    # x = 7 -> res = 7 * 2 + 5 = 19 (Dead else branch was completely bypassed)
    let r1 = sccp_compute_branch(1, 7)
    assert(r1 == 19)

    let r2 = sccp_compute_branch(0, 12)
    assert(r2 == 29) # 12 * 2 + 5 = 29

    # TEST 2: SCCP Lattice Meet Operator Verification
    # Top (0) meet Const(1, 42) -> Const(1, 42) -> 10042
    let m1 = sccp_meet_lattice(0, 0, 1, 42)
    assert(m1 == 10042)

    # Const(1, 42) meet Const(1, 42) -> Const(1, 42) -> 10042
    let m2 = sccp_meet_lattice(1, 42, 1, 42)
    assert(m2 == 10042)

    # Const(1, 42) meet Const(1, 99) -> Bottom (2) -> 20000
    let m3 = sccp_meet_lattice(1, 42, 1, 99)
    assert(m3 == 20000)

    out 0
end.
