# Vir Native Regression Test: XOR, mod, and compound assignments (Spec §10.1, §10.4, §10.6)

entity Bank:
    funds: int
end.

func main():
    # XOR and Mod
    var x = 15 xor 9 # 1111 ^ 1001 = 0110 (6)
    print(x) # 6

    var y = 15 ^ 9
    print(y) # 6

    var rem = 37 mod 10
    print(rem) # 7

    # Compound assignments
    var val = 100
    val += 50
    print(val) # 150

    val -= 25
    print(val) # 125

    val *= 2
    print(val) # 250

    val /= 5
    print(val) # 50

    var b = alloc(8)
    b.funds = 1000
    b.funds += 500
    print(b.funds) # 1500

    b.funds -= 200
    print(b.funds) # 1300

    out 0
end.
