# Self-contained NIST / RFC vectors for Vir crypto/hash + crypto/hmac
# Compare digests to Python hashlib/hmac (tools/verify_crypto_entropy.py).

func rotr32(x, n):
    let x32 = x bit_and 0xFFFFFFFF
    out ((x32 shr n) bit_or (x32 shl (32 - n))) bit_and 0xFFFFFFFF
end.

func get_k(i):
    if i == 0 do out 0x428a2f98 end
    if i == 1 do out 0x71374491 end
    if i == 2 do out 0xb5c0fbcf end
    if i == 3 do out 0xe9b5dba5 end
    if i == 4 do out 0x3956c25b end
    if i == 5 do out 0x59f111f1 end
    if i == 6 do out 0x923f82a4 end
    if i == 7 do out 0xab1c5ed5 end
    if i == 8 do out 0xd807aa98 end
    if i == 9 do out 0x12835b01 end
    if i == 10 do out 0x243185be end
    if i == 11 do out 0x550c7dc3 end
    if i == 12 do out 0x72be5d74 end
    if i == 13 do out 0x80deb1fe end
    if i == 14 do out 0x9bdc06a7 end
    if i == 15 do out 0xc19bf174 end
    if i == 16 do out 0xe49b69c1 end
    if i == 17 do out 0xefbe4786 end
    if i == 18 do out 0x0fc19dc6 end
    if i == 19 do out 0x240ca1cc end
    if i == 20 do out 0x2de92c6f end
    if i == 21 do out 0x4a7484aa end
    if i == 22 do out 0x5cb0a9dc end
    if i == 23 do out 0x76f988da end
    if i == 24 do out 0x983e5152 end
    if i == 25 do out 0xa831c66d end
    if i == 26 do out 0xb00327c8 end
    if i == 27 do out 0xbf597fc7 end
    if i == 28 do out 0xc6e00bf3 end
    if i == 29 do out 0xd5a79147 end
    if i == 30 do out 0x06ca6351 end
    if i == 31 do out 0x14292967 end
    if i == 32 do out 0x27b70a85 end
    if i == 33 do out 0x2e1b2138 end
    if i == 34 do out 0x4d2c6dfc end
    if i == 35 do out 0x53380d13 end
    if i == 36 do out 0x650a7354 end
    if i == 37 do out 0x766a0abb end
    if i == 38 do out 0x81c2c92e end
    if i == 39 do out 0x92722c85 end
    if i == 40 do out 0xa2bfe8a1 end
    if i == 41 do out 0xa81a664b end
    if i == 42 do out 0xc24b8b70 end
    if i == 43 do out 0xc76c51a3 end
    if i == 44 do out 0xd192e819 end
    if i == 45 do out 0xd6990624 end
    if i == 46 do out 0xf40e3585 end
    if i == 47 do out 0x106aa070 end
    if i == 48 do out 0x19a4c116 end
    if i == 49 do out 0x1e376c08 end
    if i == 50 do out 0x2748774c end
    if i == 51 do out 0x34b0bcb5 end
    if i == 52 do out 0x391c0cb3 end
    if i == 53 do out 0x4ed8aa4a end
    if i == 54 do out 0x5b9cca4f end
    if i == 55 do out 0x682e6ff3 end
    if i == 56 do out 0x748f82ee end
    if i == 57 do out 0x78a5636f end
    if i == 58 do out 0x84c87814 end
    if i == 59 do out 0x8cc70208 end
    if i == 60 do out 0x90befffa end
    if i == 61 do out 0xa4506ceb end
    if i == 62 do out 0xbef9a3f7 end
    if i == 63 do out 0xc67178f2 end
    out 0
end.

func sha256_oneshot(msg, msg_len):
    # Returns digest as 32-byte buffer (alloc)
    var h0 = 0x6a09e667
    var h1 = 0xbb67ae85
    var h2 = 0x3c6ef372
    var h3 = 0xa54ff53a
    var h4 = 0x510e527f
    var h5 = 0x9b05688c
    var h6 = 0x1f83d9ab
    var h7 = 0x5be0cd19

    # Pad into one or two blocks (msg_len <= 55 for this harness)
    let bit_len = msg_len * 8
    var block = alloc(64)
    var i = 0
    when i < 64 loop
        write_byte(block, i, 0)
        i = i + 1
    end
    i = 0
    when i < msg_len loop
        write_byte(block, i, read_byte(msg, i))
        i = i + 1
    end
    write_byte(block, msg_len, 0x80)
    write_byte(block, 63, bit_len bit_and 255)
    write_byte(block, 62, (bit_len shr 8) bit_and 255)

    var w = alloc(256)
    i = 0
    when i < 16 loop
        let b0 = read_byte(block, i * 4)
        let b1 = read_byte(block, i * 4 + 1)
        let b2 = read_byte(block, i * 4 + 2)
        let b3 = read_byte(block, i * 4 + 3)
        let word = ((b0 shl 24) bit_or (b1 shl 16) bit_or (b2 shl 8) bit_or b3) bit_and 0xFFFFFFFF
        write_byte(w, i * 4, (word shr 24) bit_and 255)
        write_byte(w, i * 4 + 1, (word shr 16) bit_and 255)
        write_byte(w, i * 4 + 2, (word shr 8) bit_and 255)
        write_byte(w, i * 4 + 3, word bit_and 255)
        # store word in parallel int array via 4-byte slots is awkward;
        # use a simple approach: keep words in a second buffer as 8-byte ints
        i = i + 1
    end

    # Re-do W expansion using local int array simulation via write_i64 if needed.
    # Simpler: use nested compress with word values reconstructed each round.
    var ww = alloc(64 * 8)
    i = 0
    when i < 16 loop
        let b0 = read_byte(block, i * 4)
        let b1 = read_byte(block, i * 4 + 1)
        let b2 = read_byte(block, i * 4 + 2)
        let b3 = read_byte(block, i * 4 + 3)
        let word = ((b0 shl 24) bit_or (b1 shl 16) bit_or (b2 shl 8) bit_or b3) bit_and 0xFFFFFFFF
        native_write_i64(ww, i * 8, word)
        i = i + 1
    end
    when i < 64 loop
        let w15 = native_read_i64(ww, (i - 15) * 8)
        let w2 = native_read_i64(ww, (i - 2) * 8)
        let w16 = native_read_i64(ww, (i - 16) * 8)
        let w7 = native_read_i64(ww, (i - 7) * 8)
        let s0 = rotr32(w15, 7) bit_xor rotr32(w15, 18) bit_xor (w15 shr 3)
        let s1 = rotr32(w2, 17) bit_xor rotr32(w2, 19) bit_xor (w2 shr 10)
        let val = (w16 + s0 + w7 + s1) bit_and 0xFFFFFFFF
        native_write_i64(ww, i * 8, val)
        i = i + 1
    end

    var a = h0
    var b = h1
    var c = h2
    var d = h3
    var e = h4
    var f = h5
    var g = h6
    var hh = h7
    var t = 0
    when t < 64 loop
        let wt = native_read_i64(ww, t * 8)
        let S1 = rotr32(e, 6) bit_xor rotr32(e, 11) bit_xor rotr32(e, 25)
        let not_e = (0xFFFFFFFF - e) bit_and 0xFFFFFFFF
        let ch = ((e bit_and f) bit_xor (not_e bit_and g)) bit_and 0xFFFFFFFF
        let temp1 = (hh + S1 + ch + get_k(t) + wt) bit_and 0xFFFFFFFF
        let S0 = rotr32(a, 2) bit_xor rotr32(a, 13) bit_xor rotr32(a, 22)
        let maj = ((a bit_and b) bit_xor (a bit_and c) bit_xor (b bit_and c)) bit_and 0xFFFFFFFF
        let temp2 = (S0 + maj) bit_and 0xFFFFFFFF
        hh = g
        g = f
        f = e
        e = (d + temp1) bit_and 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (temp1 + temp2) bit_and 0xFFFFFFFF
        t = t + 1
    end
    h0 = (h0 + a) bit_and 0xFFFFFFFF
    h1 = (h1 + b) bit_and 0xFFFFFFFF
    h2 = (h2 + c) bit_and 0xFFFFFFFF
    h3 = (h3 + d) bit_and 0xFFFFFFFF
    h4 = (h4 + e) bit_and 0xFFFFFFFF
    h5 = (h5 + f) bit_and 0xFFFFFFFF
    h6 = (h6 + g) bit_and 0xFFFFFFFF
    h7 = (h7 + hh) bit_and 0xFFFFFFFF

    var dig = alloc(32)
    native_write_i64(dig, 0, 0)
    write_byte(dig, 0, (h0 shr 24) bit_and 255)
    write_byte(dig, 1, (h0 shr 16) bit_and 255)
    write_byte(dig, 2, (h0 shr 8) bit_and 255)
    write_byte(dig, 3, h0 bit_and 255)
    write_byte(dig, 4, (h1 shr 24) bit_and 255)
    write_byte(dig, 5, (h1 shr 16) bit_and 255)
    write_byte(dig, 6, (h1 shr 8) bit_and 255)
    write_byte(dig, 7, h1 bit_and 255)
    write_byte(dig, 8, (h2 shr 24) bit_and 255)
    write_byte(dig, 9, (h2 shr 16) bit_and 255)
    write_byte(dig, 10, (h2 shr 8) bit_and 255)
    write_byte(dig, 11, h2 bit_and 255)
    write_byte(dig, 12, (h3 shr 24) bit_and 255)
    write_byte(dig, 13, (h3 shr 16) bit_and 255)
    write_byte(dig, 14, (h3 shr 8) bit_and 255)
    write_byte(dig, 15, h3 bit_and 255)
    write_byte(dig, 16, (h4 shr 24) bit_and 255)
    write_byte(dig, 17, (h4 shr 16) bit_and 255)
    write_byte(dig, 18, (h4 shr 8) bit_and 255)
    write_byte(dig, 19, h4 bit_and 255)
    write_byte(dig, 20, (h5 shr 24) bit_and 255)
    write_byte(dig, 21, (h5 shr 16) bit_and 255)
    write_byte(dig, 22, (h5 shr 8) bit_and 255)
    write_byte(dig, 23, h5 bit_and 255)
    write_byte(dig, 24, (h6 shr 24) bit_and 255)
    write_byte(dig, 25, (h6 shr 16) bit_and 255)
    write_byte(dig, 26, (h6 shr 8) bit_and 255)
    write_byte(dig, 27, h6 bit_and 255)
    write_byte(dig, 28, (h7 shr 24) bit_and 255)
    write_byte(dig, 29, (h7 shr 16) bit_and 255)
    write_byte(dig, 30, (h7 shr 8) bit_and 255)
    write_byte(dig, 31, h7 bit_and 255)
    out dig
end.

func hex_eq32(dig, expect_hex):
    # expect_hex is ASCII hex cstring of length 64
    var i = 0
    when i < 32 loop
        let b = read_byte(dig, i)
        let hi = (b shr 4) bit_and 15
        let lo = b bit_and 15
        let ch_hi = read_byte(expect_hex, i * 2)
        let ch_lo = read_byte(expect_hex, i * 2 + 1)
        var vh = 0
        var vl = 0
        if ch_hi >= 97 do vh = ch_hi - 87 else vh = ch_hi - 48 end
        if ch_lo >= 97 do vl = ch_lo - 87 else vl = ch_lo - 48 end
        if hi != vh do out 0 end
        if lo != vl do out 0 end
        i = i + 1
    end
    out 1
end.

func main:
    # SHA-256("")
    var empty = alloc(1)
    write_byte(empty, 0, 0)
    let d0 = sha256_oneshot(empty, 0)
    let ok0 = hex_eq32(d0, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

    # SHA-256("abc")
    var abc = alloc(3)
    write_byte(abc, 0, 97)
    write_byte(abc, 1, 98)
    write_byte(abc, 2, 99)
    let d1 = sha256_oneshot(abc, 3)
    let ok1 = hex_eq32(d1, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

    if ok0 == 1 & ok1 == 1 do
        print("cg_crypto_vectors: PASS")
        out 0
    end
    print("cg_crypto_vectors: FAIL")
    out 1
end.
