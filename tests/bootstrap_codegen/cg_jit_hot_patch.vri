# Test: Live Atomic JIT Hot-Patching via Jump Table Indirection (ARM64)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Allocate 16KB RW memory page for JIT Jump Table & Code Variants
    let page_size = 16384
    let page = syscall6(197, 0, page_size, 3, 4098, 0 - 1, 0)
    assert(page > 0)

    # 2. Layout in JIT Page:
    # Offset 0: Jump Table Entry -> Branch to SafeVariant (offset 32)
    #   Safe offset = 32 bytes -> 32 / 4 = 8 instrs -> opcode 0x14000008
    #   Bytes: 0x08, 0x00, 0x00, 0x14 (8, 0, 0, 20)
    write_byte(page, 0, 8)
    write_byte(page, 1, 0)
    write_byte(page, 2, 0)
    write_byte(page, 3, 20)

    # Offset 32: Safe Variant -> Returns 10
    #   MOVZ X0, #10   ; 0xD2800140 (0x40, 0x01, 0x80, 0xD2 -> 64, 1, 128, 210)
    #   RET            ; 0xD65F03C0 (0xC0, 0x03, 0x5F, 0xD6 -> 192, 3, 95, 214)
    write_byte(page, 32, 64)
    write_byte(page, 33, 1)
    write_byte(page, 34, 128)
    write_byte(page, 35, 210)

    write_byte(page, 36, 192)
    write_byte(page, 37, 3)
    write_byte(page, 38, 95)
    write_byte(page, 39, 214)

    # Offset 64: Fast Variant -> Returns 42
    #   MOVZ X0, #42   ; 0xD2800540 (0x40, 0x05, 0x80, 0xD2 -> 64, 5, 128, 210)
    #   RET            ; 0xD65F03C0 (0xC0, 0x03, 0x5F, 0xD6 -> 192, 3, 95, 214)
    write_byte(page, 64, 64)
    write_byte(page, 65, 5)
    write_byte(page, 66, 128)
    write_byte(page, 67, 210)

    write_byte(page, 68, 192)
    write_byte(page, 69, 3)
    write_byte(page, 70, 95)
    write_byte(page, 71, 214)

    # 3. Finalise to RX (PROT_READ | PROT_EXEC)
    let mprot1 = syscall3(74, page, page_size, 5)
    assert(mprot1 == 0)

    # 4. Call through Jump Table (Initial State: Safe Variant)
    let jt_fn = page
    let r1 = jt_fn()
    assert(r1 == 10)

    # 5. LIVE HOT-PATCHING: Switch Jump Table to Fast Variant (Offset 64)
    #   Fast offset = 64 bytes -> 64 / 4 = 16 instrs -> opcode 0x14000010
    #   Bytes: 0x10, 0x00, 0x00, 0x14 (16, 0, 0, 20)
    let mprot_rw = syscall3(74, page, page_size, 3)
    assert(mprot_rw == 0)

    write_byte(page, 0, 16)
    write_byte(page, 1, 0)
    write_byte(page, 2, 0)
    write_byte(page, 3, 20)

    let mprot_rx = syscall3(74, page, page_size, 5)
    assert(mprot_rx == 0)

    # 6. Call through Jump Table again -> Must return 42 instantly!
    let r2 = jt_fn()
    assert(r2 == 42)

    # 7. ROLLBACK / DEOPT: Switch Jump Table back to Safe Variant (Offset 32)
    let mprot_rw2 = syscall3(74, page, page_size, 3)
    assert(mprot_rw2 == 0)

    write_byte(page, 0, 8)
    write_byte(page, 1, 0)
    write_byte(page, 2, 0)
    write_byte(page, 3, 20)

    let mprot_rx2 = syscall3(74, page, page_size, 5)
    assert(mprot_rx2 == 0)

    # 8. Call through Jump Table after Rollback -> Must return 10 again!
    let r3 = jt_fn()
    assert(r3 == 10)

    out 0
end.
