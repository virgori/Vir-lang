# Test std/io File I/O operations (Spec §4.6, stdlib/vir/io)

func main:
    let path = "/tmp/vir_test_io.txt"
    let test_data = "Hello Vir Native I/O Standard Library!"
    let data_len = str_len(test_data)

    # 1. Write data to file
    let write_ok = write_bytes(path, test_data, data_len)
    if write_ok != 1 do
        out 1
    end

    # 2. Slurp file length
    let flen = slurp_len(path)
    if flen != data_len do
        out 2
    end

    # 3. Slurp file content
    let read_buf = alloc(flen + 1)
    let read_ok = slurp_file(path, read_buf, flen)
    if read_ok != 1 do
        out 3
    end
    write_byte(read_buf, flen, 0)

    # 4. Compare string equality
    if str_eq(read_buf, test_data) == 0 do
        out 4
    end

    # 5. Verify byte by byte
    var i = 0
    when i < flen loop
        let b1 = read_byte(read_buf, i)
        let b2 = read_byte(test_data, i)
        if b1 != b2 do
            out 5
        end
        i = i + 1
    end

    out 0
end.
