# Bootstrap Native Test: Tail-Call Optimization (TCO) & Sibling Call Elimination
# ==============================================================================
# Spec §10 / Pillar 6: TCO transforms recursive calls in tail position into
# in-place register updates and direct unconditional branches (B / JMP),
# guaranteeing O(1) stack space and eliminating stack overflow risk.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# 1. Standard Recursive Tail Function with Accumulator (Lowered by TCO)
# Mathematical definition: sum_tail(n, acc) = if n == 0 then acc else sum_tail(n - 1, acc + n)
# Transformed by TCO into an iterative loop:
func sum_tail_optimized(n_init, acc_init):
    var n = n_init
    var acc = acc_init
    var active = 1
    when active loop
        if n == 0 do
            active = 0
        end
        if active do
            acc = acc + n
            n = n - 1
        end
    end
    out acc
end.

# 2. Greatest Common Divisor (GCD - Euclidean Algorithm via Tail Recursion)
# gcd(a, b) = if b == 0 then a else gcd(b, a % b)
func gcd_tail_optimized(a_init, b_init):
    var a = a_init
    var b = b_init
    var active = 1
    when active loop
        if b == 0 do
            active = 0
        end
        if active do
            let rem = a - ((a / b) * b)
            a = b
            b = rem
        end
    end
    out a
end.

# 3. Mutual Tail-Call State Machine (Ping-Pong / Sibling Call)
# is_even_tail(n) <-> is_odd_tail(n - 1)
func is_even_tail_optimized(n_init):
    var n = n_init
    var state = 0 # 0 = check_even, 1 = check_odd
    var active = 1
    var result = 0
    when active loop
        if n == 0 do
            if state == 0 do
                result = 1
            end
            if state == 1 do
                result = 0
            end
            active = 0
        end
        if active do
            if state == 0 do
                state = 1
                n = n - 1
            end
            if state == 1 and active do
                # Next step transitions back
                if n > 0 do
                    state = 0
                    n = n - 1
                end
            end
        end
    end
    out result
end.

# 4. TCO Transformation Engine on IR
# IR Instruction: [Op, Dst, S1, S2, IsTail]
# Op 10 = CALL, Op 20 = TAIL_JUMP
func tco_pass_transform(instr_buf, count, target_func_id):
    var transformed = 0
    var i = 0
    when i < count loop
        let op = read_word(instr_buf, (i * 4 + 0) * 8)
        let func_called = read_word(instr_buf, (i * 4 + 1) * 8)
        let is_tail = read_word(instr_buf, (i * 4 + 3) * 8)

        # If Call is in tail position to the same function (self-recursion)
        if op == 10 and func_called == target_func_id and is_tail == 1 do
            # Transform CALL to direct TAIL_JUMP (Op 20)
            write_word(instr_buf, (i * 4 + 0) * 8, 20)
            transformed = transformed + 1
        end
        i = i + 1
    end
    out transformed
end.

func main:
    # TEST 1: Deep Tail Recursion (N = 1,000,000 elements)
    # Expected sum = N * (N + 1) / 2 = 1,000,000 * 1,000,001 / 2 = 500,000,500,000
    let n = 1000000
    let res = sum_tail_optimized(n, 0)
    assert(res == 500000500000)

    # TEST 2: GCD Tail Call (Euclidean Algorithm)
    let g1 = gcd_tail_optimized(1071, 462)
    assert(g1 == 21) # 1071 = 21 * 51, 462 = 21 * 22

    let g2 = gcd_tail_optimized(123456, 7890)
    assert(g2 == 6)

    # TEST 3: Mutual Sibling Tail Recursion
    assert(is_even_tail_optimized(1000) == 1)
    assert(is_even_tail_optimized(1001) == 0)

    # TEST 4: IR TCO Transformation Engine
    # Buffer with 2 instructions:
    # Instr 0: Normal CALL (is_tail = 0)
    # Instr 1: Tail CALL (is_tail = 1)
    let ir = alloc(8 * 8)
    write_word(ir, 0 * 8, 10) # Op = CALL
    write_word(ir, 1 * 8, 42) # FuncID = 42
    write_word(ir, 2 * 8, 0)
    write_word(ir, 3 * 8, 0)  # is_tail = 0

    write_word(ir, 4 * 8, 10) # Op = CALL
    write_word(ir, 5 * 8, 42) # FuncID = 42
    write_word(ir, 6 * 8, 0)
    write_word(ir, 7 * 8, 1)  # is_tail = 1

    let tco_count = tco_pass_transform(ir, 2, 42)
    assert(tco_count == 1)
    assert(read_word(ir, 0 * 8) == 10) # Normal Call preserved
    assert(read_word(ir, 4 * 8) == 20) # Tail Call transformed to Jump

    out 0
end.
