# Phase F6: Test std/toml — TOML Configuration Parser (Spec §9, stdlib/vir/toml)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func copy_slice(src, start, end_pos, dst):
    var dst_idx = 0
    var i = start
    when i < end_pos loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
end.

func parse_int_sub(s, start, end_pos):
    var res = 0
    var i = start
    when i < end_pos loop
        let b = read_byte(s, i)
        if (b >= 48) and (b <= 57) do
            res = res * 10 + (b - 48)
        end
        i = i + 1
    end
    out res
end.

# Toml Entry layout (32 bytes):
# word 0: section (cstr)
# word 8: key (cstr)
# word 16: str_val (cstr, 0 if int)
# word 24: int_val (i64)

func toml_doc_create(cap):
    let d = alloc(24)
    write_word(d, 0, cap)
    write_word(d, 8, 0) # count = 0
    let entries = alloc(cap * 32)
    write_word(d, 16, entries)
    out d
end.

func toml_add_entry(d, sec, key, s_val, i_val):
    let cnt = read_word(d, 8)
    let cap = read_word(d, 0)
    if cnt < cap do
        let entries = read_word(d, 16)
        let slot = entries + cnt * 32
        write_word(slot, 0, sec)
        write_word(slot, 8, key)
        write_word(slot, 16, s_val)
        write_word(slot, 24, i_val)
        write_word(d, 8, cnt + 1)
    end
end.

func toml_get_str(d, sec, key):
    let cnt = read_word(d, 8)
    let entries = read_word(d, 16)
    var i = 0
    when i < cnt loop
        let slot = entries + i * 32
        let s = read_word(slot, 0)
        let k = read_word(slot, 8)
        if (cstr_eq(s, sec) == 1) and (cstr_eq(k, key) == 1) do
            out read_word(slot, 16)
        end
        i = i + 1
    end
    out 0 # Not found
end.

func toml_get_int(d, sec, key):
    let cnt = read_word(d, 8)
    let entries = read_word(d, 16)
    var i = 0
    when i < cnt loop
        let slot = entries + i * 32
        let s = read_word(slot, 0)
        let k = read_word(slot, 8)
        if (cstr_eq(s, sec) == 1) and (cstr_eq(k, key) == 1) do
            out read_word(slot, 24)
        end
        i = i + 1
    end
    out 0 - 1
end.

func toml_parse(src, d):
    let slen = cstr_len(src)
    var p = 0
    var cur_sec = alloc(64)
    write_byte(cur_sec, 0, 0) # Root section ""

    when p < slen loop
        # Skip leading spaces
        when (p < slen) and ((read_byte(src, p) == 32) or (read_byte(src, p) == 9)) loop
            p = p + 1
        end

        if p >= slen do out 1 end

        let b = read_byte(src, p)

        # 1. Skip comments and empty lines
        if (b == 35) or (b == 10) or (b == 13) do # '#' or '\n'
            when (p < slen) and (read_byte(src, p) != 10) loop
                p = p + 1
            end
            if p < slen do p = p + 1 end
        else
            # 2. Section header: [section_name]
            if b == 91 do # '['
                p = p + 1
                let sec_start = p
                when (p < slen) and (read_byte(src, p) != 93) and (read_byte(src, p) != 10) loop
                    p = p + 1
                end
                let sec_buf = alloc(p - sec_start + 1)
                copy_slice(src, sec_start, p, sec_buf)
                cur_sec = sec_buf
                when (p < slen) and (read_byte(src, p) != 10) loop
                    p = p + 1
                end
                if p < slen do p = p + 1 end
            else
                # 3. Key-Value pair: key = val
                let key_start = p
                when (p < slen) and (read_byte(src, p) != 61) and (read_byte(src, p) != 32) and (read_byte(src, p) != 10) loop
                    p = p + 1
                end
                let key_buf = alloc(p - key_start + 1)
                copy_slice(src, key_start, p, key_buf)

                # Skip to '='
                when (p < slen) and (read_byte(src, p) != 61) loop
                    p = p + 1
                end
                if p < slen do p = p + 1 end # Skip '='

                # Skip spaces after '='
                when (p < slen) and ((read_byte(src, p) == 32) or (read_byte(src, p) == 9)) loop
                    p = p + 1
                end

                # Check if string or number
                if (p < slen) and (read_byte(src, p) == 34) do # '"'
                    p = p + 1
                    let str_start = p
                    when (p < slen) and (read_byte(src, p) != 34) loop
                        p = p + 1
                    end
                    let str_buf = alloc(p - str_start + 1)
                    copy_slice(src, str_start, p, str_buf)
                    toml_add_entry(d, cur_sec, key_buf, str_buf, 0)
                    if p < slen do p = p + 1 end
                else
                    # Number
                    let num_start = p
                    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
                        p = p + 1
                    end
                    let ival = parse_int_sub(src, num_start, p)
                    toml_add_entry(d, cur_sec, key_buf, 0, ival)
                end

                # Skip to next line
                when (p < slen) and (read_byte(src, p) != 10) loop
                    p = p + 1
                end
                if p < slen do p = p + 1 end
            end
        end
    end
    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let toml_text = "# Vir Config\ntitle = \"Vir Application\"\nversion = 2\n\n[server]\nhost = \"127.0.0.1\"\nport = 8080\n\n[database]\nname = \"vir_db\"\nmax_conn = 100\n"
    let doc = toml_doc_create(16)
    toml_parse(toml_text, doc)

    # 1. Root keys
    assert(cstr_eq(toml_get_str(doc, "", "title"), "Vir Application") == 1)
    assert(toml_get_int(doc, "", "version") == 2)

    # 2. Section [server]
    assert(cstr_eq(toml_get_str(doc, "server", "host"), "127.0.0.1") == 1)
    assert(toml_get_int(doc, "server", "port") == 8080)

    # 3. Section [database]
    assert(cstr_eq(toml_get_str(doc, "database", "name"), "vir_db") == 1)
    assert(toml_get_int(doc, "database", "max_conn") == 100)

    # 4. Missing key returns not found
    assert(toml_get_str(doc, "server", "missing") == 0)
    assert(toml_get_int(doc, "missing_sec", "port") == (0 - 1))

    out 0
end.
