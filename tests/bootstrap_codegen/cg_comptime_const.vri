# Test compile-time evaluation (comptime) & compile-time constants (Spec §15)
func main:
    const KILOBYTE = comptime (1024)
    const BUFFER_SZ = comptime (4 * KILOBYTE)
    const OFFSET_VAL = comptime (BUFFER_SZ + 256)

    if KILOBYTE != 1024 do
        out 1
    end
    if BUFFER_SZ != 4096 do
        out 2
    end
    if OFFSET_VAL != 4352 do
        out 3
    end

    let direct_eval = comptime (10 * 20 + 30)
    if direct_eval != 230 do
        out 4
    end

    out 0
end.
