# Phase D4: Test std/time — Duration Representation & Arithmetic (Spec §9, stdlib/vir/time)

# Duration is stored as 64-bit integer nanoseconds

func dur_from_nanos(n):
    out n
end.

func dur_from_micros(us):
    out us * 1000
end.

func dur_from_millis(ms):
    out ms * 1000000
end.

func dur_from_secs(s):
    out s * 1000000000
end.

func dur_from_mins(m):
    out m * 60000000000
end.

func dur_from_hours(h):
    out h * 3600000000000
end.

func dur_as_secs(d):
    out d / 1000000000
end.

func dur_as_mins(d):
    out d / 60000000000
end.

func dur_as_millis(d):
    out d / 1000000
end.

func dur_as_micros(d):
    out d / 1000
end.

func dur_as_nanos(d):
    out d
end.

func dur_subsec_millis(d):
    let rem = d % 1000000000
    out rem / 1000000
end.

func dur_subsec_micros(d):
    let rem = d % 1000000000
    out rem / 1000
end.

func dur_subsec_nanos(d):
    out d % 1000000000
end.

func dur_add(a, b):
    out a + b
end.

func dur_sub(a, b):
    if a < b do out 0 end
    out a - b
end.

func dur_mul(d, factor):
    out d * factor
end.

func dur_div(d, divisor):
    if divisor == 0 do out 0 end
    out d / divisor
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Base unit conversions
    let d_1s = dur_from_secs(1)
    assert(d_1s == 1000000000)
    assert(dur_as_secs(d_1s) == 1)
    assert(dur_as_millis(d_1s) == 1000)
    assert(dur_as_micros(d_1s) == 1000000)
    assert(dur_as_nanos(d_1s) == 1000000000)
    assert(dur_subsec_millis(d_1s) == 0)

    let d_500ms = dur_from_millis(500)
    assert(dur_as_millis(d_500ms) == 500)
    assert(dur_as_secs(d_500ms) == 0)
    assert(dur_subsec_millis(d_500ms) == 500)

    # 2. Hours and Minutes
    let d_2h = dur_from_hours(2)
    assert(dur_as_secs(d_2h) == 7200)
    assert(dur_as_mins(d_2h) == 120)

    let d_45m = dur_from_mins(45)
    assert(dur_as_secs(d_45m) == 2700)

    # 3. Arithmetic operations
    # 2h + 45m + 30s + 250ms = 7200 + 2700 + 30 = 9930s + 250ms
    let total = dur_add(dur_add(d_2h, d_45m), dur_add(dur_from_secs(30), dur_from_millis(250)))
    assert(dur_as_secs(total) == 9930)
    assert(dur_subsec_millis(total) == 250)
    assert(dur_as_millis(total) == 9930250)

    # Subtraction
    let rem = dur_sub(total, d_2h)
    assert(dur_as_secs(rem) == 2730)
    assert(dur_subsec_millis(rem) == 250)

    # Multiplication and Division
    let d_10s = dur_from_secs(10)
    let d_50s = dur_mul(d_10s, 5)
    assert(dur_as_secs(d_50s) == 50)
    assert(dur_as_secs(dur_div(d_50s, 2)) == 25)

    out 0
end.
