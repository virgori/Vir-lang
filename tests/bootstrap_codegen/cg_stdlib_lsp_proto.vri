# Phase H4: Test std/lsp — Language Server Protocol JSON-RPC Framing (Spec §9, stdlib/vir/lsp)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func append_cstr(dst, dst_idx, src):
    let sl = cstr_len(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func append_int(dst, dst_idx, num):
    if num >= 1000 do
        dst_idx = append_int(dst, dst_idx, num / 10)
        write_byte(dst, dst_idx, 48 + (num % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    if num >= 100 do
        write_byte(dst, dst_idx, 48 + (num / 100))
        dst_idx = dst_idx + 1
        let rem = num % 100
        write_byte(dst, dst_idx, 48 + (rem / 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 48 + (rem % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    if num >= 10 do
        write_byte(dst, dst_idx, 48 + (num / 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 48 + (num % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    write_byte(dst, dst_idx, 48 + num)
    dst_idx = dst_idx + 1
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func lsp_parse_content_length(header):
    let prefix = "Content-Length: "
    let plen = cstr_len(prefix)
    let hlen = cstr_len(header)
    if hlen < plen do out 0 - 1 end

    var p = plen
    var num = 0
    when (p < hlen) and (read_byte(header, p) >= 48) and (read_byte(header, p) <= 57) loop
        num = num * 10 + (read_byte(header, p) - 48)
        p = p + 1
    end
    out num
end.

func lsp_frame_response(id, result_json, out_buf):
    let body_buf = alloc(512)
    var b_idx = 0
    b_idx = append_cstr(body_buf, b_idx, "{\"jsonrpc\":\"2.0\",\"id\":")
    b_idx = append_int(body_buf, b_idx, id)
    b_idx = append_cstr(body_buf, b_idx, ",\"result\":")
    b_idx = append_cstr(body_buf, b_idx, result_json)
    b_idx = append_cstr(body_buf, b_idx, "}")

    let body_len = cstr_len(body_buf)

    var out_idx = 0
    out_idx = append_cstr(out_buf, out_idx, "Content-Length: ")
    out_idx = append_int(out_buf, out_idx, body_len)
    out_idx = append_cstr(out_buf, out_idx, "\r\n\r\n")
    out_idx = append_cstr(out_buf, out_idx, body_buf)

    out out_idx
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Parse header Content-Length
    assert(lsp_parse_content_length("Content-Length: 142\r\n\r\n") == 142)
    assert(lsp_parse_content_length("Content-Length: 0\r\n\r\n") == 0)

    # 2. Frame LSP Initialize Response
    let resp = alloc(1024)
    let init_result = "{\"capabilities\":{\"completionProvider\":true,\"definitionProvider\":true}}"
    lsp_frame_response(1, init_result, resp)

    # Verify header and body presence
    let len = lsp_parse_content_length(resp)
    assert(len == 108) # body length
    assert(cstr_len(resp) == 129) # 21 header chars + 108 body

    out 0
end.
