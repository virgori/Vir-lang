# Phase B5: Test std/core bits.vri — Bit Manipulation (Spec §2, stdlib/vir/core/bits)

func count_ones(x):
    # Hamming weight
    var v = x
    v = v - ((v shr 1) and 0x5555555555555555)
    v = (v and 0x3333333333333333) + ((v shr 2) and 0x3333333333333333)
    v = (v + (v shr 4)) and 0x0F0F0F0F0F0F0F0F
    out (v * 0x0101010101010101) shr 56
end.

func count_zeros(x):
    out 64 - count_ones(x)
end.

func leading_zeros(x):
    if x == 0 do out 64 end
    var n = 0
    var v = x
    if (v and 0xFFFFFFFF00000000) == 0 do n = n + 32; v = v shl 32 end
    if (v and 0xFFFF000000000000) == 0 do n = n + 16; v = v shl 16 end
    if (v and 0xFF00000000000000) == 0 do n = n + 8;  v = v shl 8  end
    if (v and 0xF000000000000000) == 0 do n = n + 4;  v = v shl 4  end
    if (v and 0xC000000000000000) == 0 do n = n + 2;  v = v shl 2  end
    if (v and 0x8000000000000000) == 0 do n = n + 1              end
    out n
end.

func trailing_zeros(x):
    if x == 0 do out 64 end
    var n = 0
    var v = x
    if (v and 0x00000000FFFFFFFF) == 0 do n = n + 32; v = v shr 32 end
    if (v and 0x000000000000FFFF) == 0 do n = n + 16; v = v shr 16 end
    if (v and 0x00000000000000FF) == 0 do n = n + 8;  v = v shr 8  end
    if (v and 0x000000000000000F) == 0 do n = n + 4;  v = v shr 4  end
    if (v and 0x0000000000000003) == 0 do n = n + 2;  v = v shr 2  end
    if (v and 0x0000000000000001) == 0 do n = n + 1              end
    out n
end.

func bit_width(x):
    if x == 0 do out 0 end
    out 64 - leading_zeros(x)
end.

func is_power_of_two(x):
    out (x != 0) and ((x and (x - 1)) == 0)
end.

func next_power_of_two(x):
    if x <= 1 do out 1 end
    var v = x - 1
    v = v or (v shr 1)
    v = v or (v shr 2)
    v = v or (v shr 4)
    v = v or (v shr 8)
    v = v or (v shr 16)
    v = v or (v shr 32)
    out v + 1
end.

func rotate_left(x, n):
    let shift = n mod 64
    if shift == 0 do out x end
    out (x shl shift) or (x shr (64 - shift))
end.

func rotate_right(x, n):
    let shift = n mod 64
    if shift == 0 do out x end
    out (x shr shift) or (x shl (64 - shift))
end.

func byte_swap_64(x):
    var v = x
    v = ((v and 0x00000000000000FF) shl 56) or
        ((v and 0x000000000000FF00) shl 40) or
        ((v and 0x0000000000FF0000) shl 24) or
        ((v and 0x00000000FF000000) shl 8)  or
        ((v and 0x000000FF00000000) shr 8)  or
        ((v and 0x0000FF0000000000) shr 24) or
        ((v and 0x00FF000000000000) shr 40) or
        ((v and 0xFF00000000000000) shr 56)
    out v
end.

func parity(x):
    # Even parity: 0 if even number of bits set, 1 if odd
    var v = x
    v = v xor (v shr 32)
    v = v xor (v shr 16)
    v = v xor (v shr 8)
    v = v xor (v shr 4)
    v = v xor (v shr 2)
    v = v xor (v shr 1)
    out v and 1
end.

func main:
    # 1. count_ones (popcount)
    if count_ones(0) != 0         do out 1 end
    if count_ones(1) != 1         do out 2 end
    if count_ones(0xFF) != 8      do out 3 end
    if count_ones(0xFFFF) != 16   do out 4 end
    if count_ones(0x0F0F0F0F) != 16 do out 5 end
    if count_ones(0xFFFFFFFFFFFFFFFF) != 64 do out 6 end

    # 2. count_zeros
    if count_zeros(0) != 64      do out 7 end
    if count_zeros(0xFFFFFFFFFFFFFFFF) != 0 do out 8 end

    # 3. leading_zeros (CLZ)
    if leading_zeros(0) != 64    do out 9 end
    if leading_zeros(1) != 63    do out 10 end
    if leading_zeros(2) != 62    do out 11 end
    if leading_zeros(0xFF) != 56 do out 12 end
    if leading_zeros(0x8000000000000000) != 0 do out 13 end

    # 4. trailing_zeros (CTZ)
    if trailing_zeros(0) != 64   do out 14 end
    if trailing_zeros(1) != 0    do out 15 end
    if trailing_zeros(2) != 1    do out 16 end
    if trailing_zeros(8) != 3    do out 17 end
    if trailing_zeros(0x80) != 7 do out 18 end
    if trailing_zeros(0x100) != 8 do out 19 end

    # 5. bit_width
    if bit_width(0) != 0         do out 20 end
    if bit_width(1) != 1         do out 21 end
    if bit_width(255) != 8       do out 22 end
    if bit_width(256) != 9       do out 23 end

    # 6. is_power_of_two
    if is_power_of_two(0) != 0   do out 24 end
    if is_power_of_two(1) != 1   do out 25 end
    if is_power_of_two(2) != 1   do out 26 end
    if is_power_of_two(3) != 0   do out 27 end
    if is_power_of_two(16) != 1  do out 28 end
    if is_power_of_two(15) != 0  do out 29 end

    # 7. next_power_of_two
    if next_power_of_two(0) != 1  do out 30 end
    if next_power_of_two(1) != 1  do out 31 end
    if next_power_of_two(2) != 2  do out 32 end
    if next_power_of_two(3) != 4  do out 33 end
    if next_power_of_two(5) != 8  do out 34 end
    if next_power_of_two(8) != 8  do out 35 end
    if next_power_of_two(9) != 16 do out 36 end

    # 8. rotate_left / rotate_right
    if rotate_left(1, 0) != 1                     do out 37 end
    if rotate_left(1, 1) != 2                     do out 38 end
    if rotate_left(0x8000000000000000, 1) != 1    do out 39 end
    if rotate_right(1, 1) != 0x8000000000000000  do out 40 end
    if rotate_right(8, 3) != 1                    do out 41 end

    # 9. byte_swap_64
    if byte_swap_64(0x0102030405060708) != 0x0807060504030201 do out 42 end
    if byte_swap_64(0xFF00000000000000) != 0x00000000000000FF do out 43 end

    # 10. parity
    if parity(0) != 0   do out 44 end
    if parity(1) != 1   do out 45 end
    if parity(3) != 0   do out 46 end
    if parity(7) != 1   do out 47 end
    if parity(0xFF) != 0 do out 48 end

    out 0
end.
