# Phase G1: Test std/encode/hex — Hexadecimal Encoding & Decoding (Spec §9, stdlib/vir/encode)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func hex_char_val(c):
    if (c >= 48) and (c <= 57) do # '0'..'9'
        out c - 48
    end
    if (c >= 97) and (c <= 102) do # 'a'..'f'
        out c - 97 + 10
    end
    if (c >= 65) and (c <= 70) do # 'A'..'F'
        out c - 65 + 10
    end
    out 0 - 1 # Invalid
end.

func hex_digit(v):
    if v < 10 do
        out 48 + v
    end
    out 97 + (v - 10)
end.

func hex_encode(src, len, out_str):
    var dst_idx = 0
    var i = 0
    when i < len loop
        let b = read_byte(src, i)
        let hi = (b shr 4) bit_and 15
        let lo = b bit_and 15
        write_byte(out_str, dst_idx, hex_digit(hi))
        dst_idx = dst_idx + 1
        write_byte(out_str, dst_idx, hex_digit(lo))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(out_str, dst_idx, 0)
    out dst_idx
end.

func hex_decode(hex_s, out_bytes):
    let l = cstr_len(hex_s)
    if (l % 2) != 0 do
        out 0 - 1 # Odd length invalid
    end

    var dst_idx = 0
    var i = 0
    when i < l loop
        let h1 = hex_char_val(read_byte(hex_s, i))
        let h2 = hex_char_val(read_byte(hex_s, i + 1))
        if (h1 == (0 - 1)) or (h2 == (0 - 1)) do
            out 0 - 1 # Invalid hex character
        end
        let b = (h1 shl 4) bit_or h2
        write_byte(out_bytes, dst_idx, b)
        dst_idx = dst_idx + 1
        i = i + 2
    end
    out dst_idx
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let hex_buf = alloc(128)
    let dec_buf = alloc(128)

    # 1. Encode "Hello Vir!" -> "48656c6c6f2056697221"
    let msg = "Hello Vir!"
    let len = cstr_len(msg)
    hex_encode(msg, len, hex_buf)
    assert(cstr_eq(hex_buf, "48656c6c6f2056697221") == 1)

    # 2. Decode back to "Hello Vir!"
    let dec_len = hex_decode(hex_buf, dec_buf)
    assert(dec_len == len)
    write_byte(dec_buf, dec_len, 0)
    assert(cstr_eq(dec_buf, "Hello Vir!") == 1)

    # 3. Binary raw bytes [0x00, 0xFF, 0x5A, 0xA5]
    let raw = alloc(4)
    write_byte(raw, 0, 0)
    write_byte(raw, 1, 255)
    write_byte(raw, 2, 90)
    write_byte(raw, 3, 165)

    hex_encode(raw, 4, hex_buf)
    assert(cstr_eq(hex_buf, "00ff5aa5") == 1)

    # 4. Uppercase hex decoding
    let up_len = hex_decode("00FF5AA5", dec_buf)
    assert(up_len == 4)
    assert(read_byte(dec_buf, 0) == 0)
    assert(read_byte(dec_buf, 1) == 255)
    assert(read_byte(dec_buf, 2) == 90)
    assert(read_byte(dec_buf, 3) == 165)

    # 5. Invalid hex checks
    assert(hex_decode("abc", dec_buf) == (0 - 1))   # Odd length
    assert(hex_decode("123g", dec_buf) == (0 - 1))  # Invalid char 'g'

    out 0
end.
