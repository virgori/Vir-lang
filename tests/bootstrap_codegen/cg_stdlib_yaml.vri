# Phase F7: Test std/yaml — YAML Scanner & Key-Value Tree (Spec §9, stdlib/vir/yaml)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func copy_slice(src, start, end_pos, dst):
    var dst_idx = 0
    var i = start
    when i < end_pos loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
end.

func parse_int_sub(s, start, end_pos):
    var res = 0
    var i = start
    when i < end_pos loop
        let b = read_byte(s, i)
        if (b >= 48) and (b <= 57) do
            res = res * 10 + (b - 48)
        end
        i = i + 1
    end
    out res
end.

# Yaml Node layout (32 bytes):
# word 0: path (e.g. "app.name" or "features.0")
# word 8: str_val (cstr)
# word 16: int_val (i64)
# word 24: is_int (0 = str, 1 = int)

func yaml_doc_create(cap):
    let d = alloc(24)
    write_word(d, 0, cap)
    write_word(d, 8, 0) # count = 0
    let entries = alloc(cap * 32)
    write_word(d, 16, entries)
    out d
end.

func yaml_add_node(d, path, s_val, i_val, is_int):
    let cnt = read_word(d, 8)
    let cap = read_word(d, 0)
    if cnt < cap do
        let entries = read_word(d, 16)
        let slot = entries + cnt * 32
        write_word(slot, 0, path)
        write_word(slot, 8, s_val)
        write_word(slot, 16, i_val)
        write_word(slot, 24, is_int)
        write_word(d, 8, cnt + 1)
    end
end.

func yaml_get_str(d, path):
    let cnt = read_word(d, 8)
    let entries = read_word(d, 16)
    var i = 0
    when i < cnt loop
        let slot = entries + i * 32
        let p = read_word(slot, 0)
        if cstr_eq(p, path) == 1 do
            out read_word(slot, 8)
        end
        i = i + 1
    end
    out 0 # Not found
end.

func yaml_get_int(d, path):
    let cnt = read_word(d, 8)
    let entries = read_word(d, 16)
    var i = 0
    when i < cnt loop
        let slot = entries + i * 32
        let p = read_word(slot, 0)
        if cstr_eq(p, path) == 1 do
            out read_word(slot, 16)
        end
        i = i + 1
    end
    out 0 - 1
end.

func path_concat(p1, p2, out_buf):
    let l1 = cstr_len(p1)
    let l2 = cstr_len(p2)
    var dst = 0
    if l1 > 0 do
        var i = 0
        when i < l1 loop
            write_byte(out_buf, dst, read_byte(p1, i))
            dst = dst + 1
            i = i + 1
        end
        write_byte(out_buf, dst, 46) # '.'
        dst = dst + 1
    end
    var j = 0
    when j < l2 loop
        write_byte(out_buf, dst, read_byte(p2, j))
        dst = dst + 1
        j = j + 1
    end
    write_byte(out_buf, dst, 0)
    out out_buf
end.

func yaml_parse(src, d):
    let slen = cstr_len(src)
    var p = 0
    var cur_parent = alloc(64)
    write_byte(cur_parent, 0, 0)
    var list_idx = 0

    when p < slen loop
        # Count leading spaces (indentation)
        var indent = 0
        when (p < slen) and (read_byte(src, p) == 32) loop
            indent = indent + 1
            p = p + 1
        end

        if indent == 0 do
            write_byte(cur_parent, 0, 0)
            list_idx = 0
        end

        if p >= slen do out 1 end

        let b = read_byte(src, p)

        # 1. Skip comments and empty lines
        if (b == 35) or (b == 10) or (b == 13) do
            when (p < slen) and (read_byte(src, p) != 10) loop
                p = p + 1
            end
            if p < slen do p = p + 1 end
        else
            # 2. List item: "- item"
            if (b == 45) and (p + 1 < slen) and (read_byte(src, p + 1) == 32) do # "- "
                p = p + 2
                let val_start = p
                when (p < slen) and (read_byte(src, p) != 10) and (read_byte(src, p) != 13) loop
                    p = p + 1
                end
                let val_buf = alloc(p - val_start + 1)
                copy_slice(src, val_start, p, val_buf)

                let idx_str = alloc(8)
                write_byte(idx_str, 0, 48 + list_idx)
                write_byte(idx_str, 1, 0)

                let full_p = alloc(128)
                path_concat(cur_parent, idx_str, full_p)
                yaml_add_node(d, full_p, val_buf, 0, 0)
                list_idx = list_idx + 1

                if (p < slen) and (read_byte(src, p) == 10) do p = p + 1 end
            else
                # 3. Key-Value or Parent header: "key: value"
                let key_start = p
                when (p < slen) and (read_byte(src, p) != 58) and (read_byte(src, p) != 10) loop
                    p = p + 1
                end
                let key_buf = alloc(p - key_start + 1)
                copy_slice(src, key_start, p, key_buf)

                if (p < slen) and (read_byte(src, p) == 58) do
                    p = p + 1 # Skip ':'
                end

                # Skip spaces after ':'
                when (p < slen) and (read_byte(src, p) == 32) loop
                    p = p + 1
                end

                if (p >= slen) or (read_byte(src, p) == 10) or (read_byte(src, p) == 13) do
                    # Parent header (no value on same line)
                    cur_parent = key_buf
                    list_idx = 0
                    if p < slen do p = p + 1 end
                else
                    # Value on same line
                    let val_start = p
                    when (p < slen) and (read_byte(src, p) != 10) and (read_byte(src, p) != 13) loop
                        p = p + 1
                    end

                    let val_buf = alloc(p - val_start + 1)
                    copy_slice(src, val_start, p, val_buf)

                    let full_p = alloc(128)
                    path_concat(cur_parent, key_buf, full_p)

                    # Check if integer
                    let first_b = read_byte(val_buf, 0)
                    if (first_b >= 48) and (first_b <= 57) do
                        let ival = parse_int_sub(val_buf, 0, cstr_len(val_buf))
                        yaml_add_node(d, full_p, val_buf, ival, 1)
                    else
                        yaml_add_node(d, full_p, val_buf, 0, 0)
                    end

                    if (p < slen) and (read_byte(src, p) == 10) do p = p + 1 end
                end
            end
        end
    end
    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let yaml_text = "app:\n  name: vir-engine\n  threads: 8\nfeatures:\n  - async\n  - borrow\n  - native\n"
    let doc = yaml_doc_create(16)
    yaml_parse(yaml_text, doc)

    # 1. Nested mappings
    assert(cstr_eq(yaml_get_str(doc, "app.name"), "vir-engine") == 1)
    assert(yaml_get_int(doc, "app.threads") == 8)

    # 2. List items
    assert(cstr_eq(yaml_get_str(doc, "features.0"), "async") == 1)
    assert(cstr_eq(yaml_get_str(doc, "features.1"), "borrow") == 1)
    assert(cstr_eq(yaml_get_str(doc, "features.2"), "native") == 1)

    # 3. Missing paths
    assert(yaml_get_str(doc, "app.missing") == 0)
    assert(yaml_get_int(doc, "missing.key") == (0 - 1))

    out 0
end.
