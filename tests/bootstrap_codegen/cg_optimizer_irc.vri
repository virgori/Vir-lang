# Bootstrap Native Test: George-Appel Iterated Register Coalescing (IRC)
# ==============================================================================
# Architecture: REGISTER_ALLOCATION_ARCHITECTURE.md
# 1. Conservative Coalescing (Briggs & George Criterion for K=8 physical registers)
# 2. Interference Graph & Adjacency Matrix
# 3. Move-Related Register Merging
# 4. Safe Copy Elimination without introducing register spills
func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Interference Graph Structure (Up to 16 virtual nodes)
# ig_adj: 16 x 16 bit/word matrix
# ig_deg: 16 array
func ig_new:
    let g = alloc((16 * 16 + 16 + 16) * 8)
    # g[0..255] = adjacency matrix
    # g[256..271] = degrees
    # g[272..287] = alias map (for coalesced nodes)
    var i = 0
    when i < 16 loop
        write_word(g, (272 + i) * 8, i) # Each node is initially its own alias
        i = i + 1
    end
    out g
end.

func ig_get_alias(g, u):
    var cur = u
    var parent = read_word(g, (272 + cur) * 8)
    when parent != cur loop
        cur = parent
        parent = read_word(g, (272 + cur) * 8)
    end
    out cur
end.

func ig_add_edge(g, u_raw, v_raw):
    let u = ig_get_alias(g, u_raw)
    let v = ig_get_alias(g, v_raw)
    if u != v do
        let edge = read_word(g, (u * 16 + v) * 8)
        if edge == 0 do
            write_word(g, (u * 16 + v) * 8, 1)
            write_word(g, (v * 16 + u) * 8, 1)
            let deg_u = read_word(g, (256 + u) * 8)
            let deg_v = read_word(g, (256 + v) * 8)
            write_word(g, (256 + u) * 8, deg_u + 1)
            write_word(g, (256 + v) * 8, deg_v + 1)
        end
    end
end.

func ig_has_edge(g, u_raw, v_raw):
    let u = ig_get_alias(g, u_raw)
    let v = ig_get_alias(g, v_raw)
    if u == v do out 1 end
    out read_word(g, (u * 16 + v) * 8)
end.

func ig_degree(g, u_raw):
    let u = ig_get_alias(g, u_raw)
    out read_word(g, (256 + u) * 8)
end.

# Briggs Criterion for Conservative Coalescing (K = 8):
# u and v can be merged if the number of significant neighbors (degree >= K)
# in the combined neighborhood (adj(u) union adj(v)) is STRICTLY LESS THAN K.
func irc_can_coalesce_briggs(g, u, v, k):
    var sig_neighbors = 0
    var t = 0
    when t < 16 loop
        if t != u and t != v do
            let edge_u = ig_has_edge(g, u, t)
            let edge_v = ig_has_edge(g, v, t)
            if edge_u == 1 or edge_v == 1 do
                let deg_t = ig_degree(g, t)
                if deg_t >= k do
                    sig_neighbors = sig_neighbors + 1
                end
            end
        end
        t = t + 1
    end
    if sig_neighbors < k do
        out 1
    end
    out 0
end.

# Coalesce Move (u <- Move v)
func irc_coalesce_nodes(g, u_raw, v_raw, k):
    let u = ig_get_alias(g, u_raw)
    let v = ig_get_alias(g, v_raw)
    if u == v do
        out 1 # Already coalesced
    end

    # Check interference
    if ig_has_edge(g, u, v) == 1 do
        out 0 # Cannot coalesce: nodes interfere!
    end

    # Check Briggs safety criterion
    if irc_can_coalesce_briggs(g, u, v, k) == 0 do
        out 0 # Unsafe: would cause register spill
    end

    # Perform Merge: alias u to v, copy edges of u to v
    write_word(g, (272 + u) * 8, v)

    var t = 0
    when t < 16 loop
        if t != u and t != v do
            if read_word(g, (u * 16 + t) * 8) == 1 do
                ig_add_edge(g, v, t)
            end
        end
        t = t + 1
    end

    out 1 # Coalesced successfully!
end.

func main:
    let k = 8 # Target 8 physical registers (X19..X26)
    let g = ig_new()

    # Define interference graph:
    # v0 interferes with v1, v2
    # v1 interferes with v0, v3
    # v4 and v5 are connected by a Move instruction: v4 = Move v5
    ig_add_edge(g, 0, 1)
    ig_add_edge(g, 0, 2)
    ig_add_edge(g, 1, 3)

    assert(ig_has_edge(g, 0, 1) == 1)
    assert(ig_has_edge(g, 0, 2) == 1)
    assert(ig_has_edge(g, 4, 5) == 0) # No interference between v4 and v5

    # TEST 1: Safe Coalescing of Move (v4, v5)
    # v4 has degree 0, v5 has degree 0 -> Combined significant neighbors = 0 < 8 (Briggs PASS)
    let c1 = irc_coalesce_nodes(g, 4, 5, k)
    assert(c1 == 1) # Coalescing succeeded
    assert(ig_get_alias(g, 4) == 5) # v4 is now aliased to v5

    # TEST 2: Invalidation of Coalescing on Interfering Nodes
    # v0 interferes with v1 -> cannot coalesce!
    let c2 = irc_coalesce_nodes(g, 0, 1, k)
    assert(c2 == 0) # Rejected safely

    # TEST 3: Chained Coalescing (v6 = Move v4, where v4 is already aliased to v5)
    let c3 = irc_coalesce_nodes(g, 6, 4, k)
    assert(c3 == 1)
    assert(ig_get_alias(g, 6) == 5)
    assert(ig_get_alias(g, 4) == 5)

    out 0
end.
