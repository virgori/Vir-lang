# EXPECT_START
# 20
# 1
# 30
# 1
# EXPECT_END
# A duplicate literal key should behave like a set/update: the later value
# wins and the entry count remains one. A subsequent assignment also updates.
func main:
    var m = [1: 10, 1: 20]
    print m[1]
    print len(m)
    m[1] = 30
    print m[1]
    print len(m)
end.
