# Test std/mem Arena Allocator (Spec §4.5, stdlib/vir/mem)

entity MemArena:
    buf: ptr,
    used: int,
    cap: int
end.

func arena_init(capacity):
    let b = alloc(capacity)
    out MemArena(b, 0, capacity)
end.

func arena_alloc(ar, size):
    # Align size to 8 bytes
    let aligned_size = ((size + 7) / 8) * 8
    if ar.used + aligned_size > ar.cap do
        out 0
    end
    let res_ptr = ar.buf + ar.used
    ar.used = ar.used + aligned_size
    out res_ptr
end.

func arena_reset(ar):
    ar.used = 0
end.

func main:
    var ar = arena_init(1024)
    if ar.used != 0 do out 1 end
    if ar.cap != 1024 do out 2 end

    # 1. Allocate block 1: 10 bytes -> aligned to 16 bytes
    let p1 = arena_alloc(ar, 10)
    if p1 == 0 do out 3 end
    if ar.used != 16 do out 4 end

    # Write test data to p1
    write_word(p1, 0, 0x12345678)
    if read_word(p1, 0) != 0x12345678 do out 5 end

    # 2. Allocate block 2: 24 bytes -> 16 + 24 = 40 bytes
    let p2 = arena_alloc(ar, 24)
    if p2 == 0 do out 6 end
    if p2 != p1 + 16 do out 7 end
    if ar.used != 40 do out 8 end

    # Write test data to p2
    write_word(p2, 0, 0xABCDEF01)
    if read_word(p2, 0) != 0xABCDEF01 do out 9 end
    if read_word(p1, 0) != 0x12345678 do out 10 end

    # 3. Reset arena
    arena_reset(ar)
    if ar.used != 0 do out 11 end

    # 4. Allocate after reset gets same initial address
    let p3 = arena_alloc(ar, 8)
    if p3 != p1 do out 12 end
    if ar.used != 8 do out 13 end

    out 0
end.
