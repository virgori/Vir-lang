# Test atomic operations and synchronization (Spec §16.1, §27)
func main:
    let mem = alloc(64)
    atomic_store(mem, 100)
    let val1 = atomic_load(mem)
    if val1 != 100 do
        out 1
    end

    let old_val = atomic_add(mem, 25)
    if old_val != 100 do
        out 2
    end
    let val2 = atomic_load(mem)
    if val2 != 125 do
        out 3
    end

    # CAS failure: expected 100, actual 125
    let cas_fail = atomic_cas(mem, 100, 200)
    if cas_fail != 0 do
        out 4
    end
    let val3 = atomic_load(mem)
    if val3 != 125 do
        out 5
    end

    # CAS success: expected 125, actual 125 -> desired 200
    let cas_ok = atomic_cas(mem, 125, 200)
    if cas_ok != 1 do
        out 6
    end
    let val4 = atomic_load(mem)
    if val4 != 200 do
        out 7
    end

    atomic_fence()
    out 0
end.
