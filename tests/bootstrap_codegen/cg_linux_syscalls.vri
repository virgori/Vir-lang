# Test: Linux ARM64 Syscall Instruction Encoding & Dispatch (Spec §9, stdlib/vir/rt/syscall)

# Linux ARM64 instruction encodings:
# MOV X8, #imm16: 0xD2800008 | ((imm16 & 0xFFFF) << 5)
# MOV X0, #imm16: 0xD2800000 | ((imm16 & 0xFFFF) << 5)
# SVC #0        : 0xD4000001

func encode_mov_x8_imm(imm):
    out 0xD2800008 bit_or ((imm bit_and 0xFFFF) shl 5)
end.

func encode_mov_x0_imm(imm):
    out 0xD2800000 bit_or ((imm bit_and 0xFFFF) shl 5)
end.

func encode_svc_0:
    out 0xD4000001
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Linux sys_exit = 93 (0x5D)
    # MOV X8, #93 -> 0xD2800008 | (93 << 5) = 0xD2800008 | 0x0BA0 = 0xD2800BA8
    let mov_exit = encode_mov_x8_imm(93)
    assert(mov_exit == 0xD2800BA8)

    # 2. Linux sys_write = 64 (0x40)
    # MOV X8, #64 -> 0xD2800008 | (64 << 5) = 0xD2800008 | 0x0800 = 0xD2800808
    let mov_write = encode_mov_x8_imm(64)
    assert(mov_write == 0xD2800808)

    # 3. Linux sys_read = 63 (0x3F)
    # MOV X8, #63 -> 0xD2800008 | (63 << 5) = 0xD2800008 | 0x07E0 = 0xD28007E8
    let mov_read = encode_mov_x8_imm(63)
    assert(mov_read == 0xD28007E8)

    # 4. Linux sys_openat = 56 (0x38)
    # MOV X8, #56 -> 0xD2800008 | (56 << 5) = 0xD2800008 | 0x0700 = 0xD2800708
    let mov_openat = encode_mov_x8_imm(56)
    assert(mov_openat == 0xD2800708)

    # 5. Linux sys_close = 57 (0x39)
    # MOV X8, #57 -> 0xD2800008 | (57 << 5) = 0xD2800008 | 0x0720 = 0xD2800728
    let mov_close = encode_mov_x8_imm(57)
    assert(mov_close == 0xD2800728)

    # 6. Linux sys_getpid = 172 (0xAC)
    # MOV X8, #172 -> 0xD2800008 | (172 << 5) = 0xD2800008 | 0x1580 = 0xD2801588
    let mov_getpid = encode_mov_x8_imm(172)
    assert(mov_getpid == 0xD2801588)

    # 7. Linux SVC #0 instruction
    assert(encode_svc_0() == 0xD4000001)

    # 8. Argument MOV X0, #42
    assert(encode_mov_x0_imm(42) == 0xD2800540)

    out 0
end.
