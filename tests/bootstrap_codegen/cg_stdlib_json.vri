# Phase F4: Test std/json — JSON Lexer, Parser & Value Tree (Spec §9, stdlib/vir/json)

# JsonType constants:
# 0 = NULL, 1 = BOOL, 2 = NUMBER, 3 = STRING, 4 = ARRAY, 5 = OBJECT

# JsonValue layout at ptr (32 bytes):
# word 0: type (0..5)
# word 8: num_val / bool_val (i64)
# word 16: str_val ptr (cstr)
# word 24: children / fields ptr

func json_new_null:
    let v = alloc(32)
    write_word(v, 0, 0)
    out v
end.

func json_new_bool(b):
    let v = alloc(32)
    write_word(v, 0, 1)
    write_word(v, 8, b)
    out v
end.

func json_new_num(n):
    let v = alloc(32)
    write_word(v, 0, 2)
    write_word(v, 8, n)
    out v
end.

func json_new_str(s):
    let v = alloc(32)
    write_word(v, 0, 3)
    write_word(v, 16, s)
    out v
end.

func json_new_arr(cap):
    let v = alloc(32)
    write_word(v, 0, 4)
    let arr = alloc(24)
    write_word(arr, 0, cap)
    write_word(arr, 8, 0) # count = 0
    write_word(arr, 16, alloc(cap * 8)) # items ptr
    write_word(v, 24, arr)
    out v
end.

func json_arr_push(arr_val, item):
    let arr = read_word(arr_val, 24)
    let cnt = read_word(arr, 8)
    let cap = read_word(arr, 0)
    if cnt < cap do
        let items = read_word(arr, 16)
        write_word(items, cnt * 8, item)
        write_word(arr, 8, cnt + 1)
    end
end.

func json_arr_get(arr_val, idx):
    let arr = read_word(arr_val, 24)
    let cnt = read_word(arr, 8)
    if (idx < 0) or (idx >= cnt) do out 0 end
    let items = read_word(arr, 16)
    out read_word(items, idx * 8)
end.

func json_arr_len(arr_val):
    let arr = read_word(arr_val, 24)
    out read_word(arr, 8)
end.

func json_new_obj(cap):
    let v = alloc(32)
    write_word(v, 0, 5)
    let obj = alloc(32)
    write_word(obj, 0, cap)
    write_word(obj, 8, 0) # count = 0
    write_word(obj, 16, alloc(cap * 8)) # keys ptr
    write_word(obj, 24, alloc(cap * 8)) # vals ptr
    write_word(v, 24, obj)
    out v
end.

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func json_obj_put(obj_val, key, val):
    let obj = read_word(obj_val, 24)
    let cnt = read_word(obj, 8)
    let cap = read_word(obj, 0)
    if cnt < cap do
        let keys = read_word(obj, 16)
        let vals = read_word(obj, 24)
        write_word(keys, cnt * 8, key)
        write_word(vals, cnt * 8, val)
        write_word(obj, 8, cnt + 1)
    end
end.

func json_obj_get(obj_val, key):
    let obj = read_word(obj_val, 24)
    let cnt = read_word(obj, 8)
    let keys = read_word(obj, 16)
    let vals = read_word(obj, 24)
    var i = 0
    when i < cnt loop
        let k = read_word(keys, i * 8)
        if cstr_eq(k, key) == 1 do
            out read_word(vals, i * 8)
        end
        i = i + 1
    end
    out 0 # Not found
end.

func skip_whitespace(s, pos_box):
    var p = read_word(pos_box, 0)
    var done = 0
    when done == 0 loop
        let b = read_byte(s, p)
        if (b == 32) or (b == 9) or (b == 10) or (b == 13) do
            p = p + 1
        else
            done = 1
        end
    end
    write_word(pos_box, 0, p)
end.

# Parse string literal (without quotes)
func json_parse_str_literal(s, pos_box):
    var p = read_word(pos_box, 0)
    if read_byte(s, p) != 34 do out 0 end # Must start with '"'
    p = p + 1
    let start = p
    var done = 0
    when done == 0 loop
        let b = read_byte(s, p)
        if (b == 34) or (b == 0) do
            done = 1
        else
            p = p + 1
        end
    end
    let len = p - start
    let buf = alloc(len + 1)
    var i = 0
    when i < len loop
        write_byte(buf, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(buf, len, 0)
    if read_byte(s, p) == 34 do
        p = p + 1
    end
    write_word(pos_box, 0, p)
    out buf
end.

func json_parse_num_literal(s, pos_box):
    var p = read_word(pos_box, 0)
    var is_neg = 0
    if read_byte(s, p) == 45 do # '-'
        is_neg = 1
        p = p + 1
    end
    var val = 0
    var done = 0
    when done == 0 loop
        let b = read_byte(s, p)
        if (b >= 48) and (b <= 57) do
            val = val * 10 + (b - 48)
            p = p + 1
        else
            done = 1
        end
    end
    write_word(pos_box, 0, p)
    if is_neg != 0 do
        out 0 - val
    end
    out val
end.

func json_parse_val(s, pos_box):
    skip_whitespace(s, pos_box)
    var p = read_word(pos_box, 0)
    let b = read_byte(s, p)

    # 1. String: "..."
    if b == 34 do
        let str_ptr = json_parse_str_literal(s, pos_box)
        out json_new_str(str_ptr)
    end

    # 2. Object: { ... }
    if b == 123 do
        p = p + 1
        write_word(pos_box, 0, p)
        let obj = json_new_obj(16)
        var done_obj = 0
        when done_obj == 0 loop
            skip_whitespace(s, pos_box)
            p = read_word(pos_box, 0)
            if (read_byte(s, p) == 125) or (read_byte(s, p) == 0) do # '}'
                p = p + 1
                write_word(pos_box, 0, p)
                done_obj = 1
            else
                let key = json_parse_str_literal(s, pos_box)
                skip_whitespace(s, pos_box)
                p = read_word(pos_box, 0)
                if read_byte(s, p) == 58 do # ':'
                    write_word(pos_box, 0, p + 1)
                end
                let val = json_parse_val(s, pos_box)
                json_obj_put(obj, key, val)
                skip_whitespace(s, pos_box)
                p = read_word(pos_box, 0)
                if read_byte(s, p) == 44 do # ','
                    write_word(pos_box, 0, p + 1)
                end
            end
        end
        out obj
    end

    # 3. Array: [ ... ]
    if b == 91 do
        p = p + 1
        write_word(pos_box, 0, p)
        let arr = json_new_arr(16)
        var done_arr = 0
        when done_arr == 0 loop
            skip_whitespace(s, pos_box)
            p = read_word(pos_box, 0)
            if (read_byte(s, p) == 93) or (read_byte(s, p) == 0) do # ']'
                p = p + 1
                write_word(pos_box, 0, p)
                done_arr = 1
            else
                let elem = json_parse_val(s, pos_box)
                json_arr_push(arr, elem)
                skip_whitespace(s, pos_box)
                p = read_word(pos_box, 0)
                if read_byte(s, p) == 44 do # ','
                    write_word(pos_box, 0, p + 1)
                end
            end
        end
        out arr
    end

    # 4. Booleans: true / false
    if b == 116 do # 't' (true)
        write_word(pos_box, 0, p + 4)
        out json_new_bool(1)
    end
    if b == 102 do # 'f' (false)
        write_word(pos_box, 0, p + 5)
        out json_new_bool(0)
    end

    # 5. Null
    if b == 110 do # 'n' (null)
        write_word(pos_box, 0, p + 4)
        out json_new_null()
    end

    # 6. Number
    if ((b >= 48) and (b <= 57)) or (b == 45) do
        let num = json_parse_num_literal(s, pos_box)
        out json_new_num(num)
    end

    out json_new_null()
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let pos_box = alloc(8)
    write_word(pos_box, 0, 0)

    let json_text = "{\"name\": \"Vir\", \"version\": 2, \"active\": true, \"tags\": [10, 20, 30]}"
    let root = json_parse_val(json_text, pos_box)

    assert(read_word(root, 0) == 5) # Root is Object

    # 1. Access field "name" (String)
    let f_name = json_obj_get(root, "name")
    assert(f_name != 0)
    assert(read_word(f_name, 0) == 3) # String type
    assert(cstr_eq(read_word(f_name, 16), "Vir") == 1)

    # 2. Access field "version" (Number)
    let f_ver = json_obj_get(root, "version")
    assert(f_ver != 0)
    assert(read_word(f_ver, 0) == 2) # Number type
    assert(read_word(f_ver, 8) == 2)

    # 3. Access field "active" (Bool)
    let f_act = json_obj_get(root, "active")
    assert(f_act != 0)
    assert(read_word(f_act, 0) == 1) # Bool type
    assert(read_word(f_act, 8) == 1)

    # 4. Access field "tags" (Array)
    let f_tags = json_obj_get(root, "tags")
    assert(f_tags != 0)
    assert(read_word(f_tags, 0) == 4) # Array type
    assert(json_arr_len(f_tags) == 3)

    let t0 = json_arr_get(f_tags, 0)
    let t1 = json_arr_get(f_tags, 1)
    let t2 = json_arr_get(f_tags, 2)
    assert(read_word(t0, 8) == 10)
    assert(read_word(t1, 8) == 20)
    assert(read_word(t2, 8) == 30)

    # 5. Non-existent field returns 0
    assert(json_obj_get(root, "missing") == 0)

    out 0
end.
