# Test retry resumption inside try ... revert (§13.7)
func try_with_retry(max_retries):
    var attempts = 0
    var result = 0
    try:
        attempts = attempts + 1
        if attempts < max_retries do
            throw 1
        end
        result = 42
    revert:
        if attempts < max_retries do
            resume retry
        end
    end
    out result
end.

func main:
    let r = try_with_retry(3)
    if r != 42 do
        out 1
    end
    out 0
end.
