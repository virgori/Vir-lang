# Phase F3: Test std/http — HTTP/1.1 Request/Response Framing & Parsing (Spec §9, stdlib/vir/http)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func copy_slice(src, start, end_pos, dst):
    var dst_idx = 0
    var i = start
    when i < end_pos loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
end.

# Parses "METHOD PATH VERSION" (e.g. "GET /index.html HTTP/1.1")
func http_parse_request_line(line, m_out, p_out, v_out):
    let l = cstr_len(line)
    var sp1 = 0 - 1
    var sp2 = 0 - 1
    var i = 0
    when i < l loop
        if read_byte(line, i) == 32 do # ' '
            if sp1 == (0 - 1) do
                sp1 = i
            else
                if sp2 == (0 - 1) do
                    sp2 = i
                end
            end
        end
        i = i + 1
    end

    if (sp1 == (0 - 1)) or (sp2 == (0 - 1)) do
        out 0 # Malformed request line
    end

    copy_slice(line, 0, sp1, m_out)
    copy_slice(line, sp1 + 1, sp2, p_out)
    copy_slice(line, sp2 + 1, l, v_out)
    out 1
end.

func http_status_reason(code):
    if code == 200 do out "OK" end
    if code == 201 do out "Created" end
    if code == 204 do out "No Content" end
    if code == 400 do out "Bad Request" end
    if code == 401 do out "Unauthorized" end
    if code == 403 do out "Forbidden" end
    if code == 404 do out "Not Found" end
    if code == 500 do out "Internal Server Error" end
    out "Unknown"
end.

func append_cstr(dst, dst_idx, src):
    let sl = cstr_len(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func append_int(dst, dst_idx, num):
    if num >= 1000 do
        dst_idx = append_int(dst, dst_idx, num / 10)
        write_byte(dst, dst_idx, 48 + (num % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    if num >= 100 do
        write_byte(dst, dst_idx, 48 + (num / 100))
        dst_idx = dst_idx + 1
        let rem = num % 100
        write_byte(dst, dst_idx, 48 + (rem / 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 48 + (rem % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    if num >= 10 do
        write_byte(dst, dst_idx, 48 + (num / 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 48 + (num % 10))
        dst_idx = dst_idx + 1
        write_byte(dst, dst_idx, 0)
        out dst_idx
    end
    write_byte(dst, dst_idx, 48 + num)
    dst_idx = dst_idx + 1
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func http_format_response(code, content_type, body, out_buf):
    var idx = 0
    idx = append_cstr(out_buf, idx, "HTTP/1.1 ")
    idx = append_int(out_buf, idx, code)
    idx = append_cstr(out_buf, idx, " ")
    idx = append_cstr(out_buf, idx, http_status_reason(code))
    idx = append_cstr(out_buf, idx, "\r\nContent-Type: ")
    idx = append_cstr(out_buf, idx, content_type)
    idx = append_cstr(out_buf, idx, "\r\nContent-Length: ")
    idx = append_int(out_buf, idx, cstr_len(body))
    idx = append_cstr(out_buf, idx, "\r\n\r\n")
    idx = append_cstr(out_buf, idx, body)
    out idx
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let m = alloc(32)
    let p = alloc(128)
    let v = alloc(32)
    let resp_buf = alloc(512)

    # 1. Parse Request Lines
    assert(http_parse_request_line("GET /api/v1/health HTTP/1.1", m, p, v) == 1)
    assert(cstr_eq(m, "GET") == 1)
    assert(cstr_eq(p, "/api/v1/health") == 1)
    assert(cstr_eq(v, "HTTP/1.1") == 1)

    assert(http_parse_request_line("POST /submit HTTP/1.1", m, p, v) == 1)
    assert(cstr_eq(m, "POST") == 1)
    assert(cstr_eq(p, "/submit") == 1)

    # Malformed request line
    assert(http_parse_request_line("INVALID", m, p, v) == 0)

    # 2. Status reasons
    assert(cstr_eq(http_status_reason(200), "OK") == 1)
    assert(cstr_eq(http_status_reason(404), "Not Found") == 1)
    assert(cstr_eq(http_status_reason(500), "Internal Server Error") == 1)

    # 3. Format HTTP 200 Response
    let body200 = "{\"status\":\"ok\"}"
    http_format_response(200, "application/json", body200, resp_buf)
    assert(cstr_eq(resp_buf, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 15\r\n\r\n{\"status\":\"ok\"}") == 1)

    # 4. Format HTTP 404 Response
    let body404 = "Page Not Found"
    http_format_response(404, "text/plain", body404, resp_buf)
    assert(cstr_eq(resp_buf, "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 14\r\n\r\nPage Not Found") == 1)

    out 0
end.
