# Test: Foreign Function Interface (C-FFI) Type Marshalling & C-ABI Struct Alignment (Spec §29, stdlib/vir/ffi)

# C Type IDs:
# 0=Void, 1=I8, 2=I16, 3=I32, 4=I64, 5=U8, 6=U16, 7=U32, 8=U64, 9=F32, 10=F64, 11=Ptr, 12=Str, 13=Bool

func ctype_size(tag):
    if (tag == 1) or (tag == 5) or (tag == 13) do out 1 end # I8, U8, Bool
    if (tag == 2) or (tag == 6) do out 2 end                # I16, U16
    if (tag == 3) or (tag == 7) or (tag == 9) do out 4 end # I32, U32, F32
    if (tag == 4) or (tag == 8) or (tag == 10) or (tag == 11) or (tag == 12) do out 8 end # I64, U64, F64, Ptr, Str
    out 0
end.

func ctype_align(tag):
    out ctype_size(tag)
end.

# Calculates C struct layout with standard natural alignment padding
# Input: array of field ctype tags, field_count
# Output: writes field offsets to out_offsets, returns total struct size
func cstruct_calc_layout(field_tags, field_count, out_offsets):
    var current_offset = 0
    var max_align = 1
    var i = 0

    when i < field_count loop
        let tag = read_word(field_tags, i * 8)
        let sz = ctype_size(tag)
        let al = ctype_align(tag)
        if al > max_align do
            max_align = al
        end

        # Align current_offset to `al`
        let rem = current_offset - ((current_offset / al) * al)
        if rem != 0 do
            current_offset = current_offset + (al - rem)
        end

        write_word(out_offsets, i * 8, current_offset)
        current_offset = current_offset + sz
        i = i + 1
    end

    # Tail padding to multiple of max_align
    let tail_rem = current_offset - ((current_offset / max_align) * max_align)
    if tail_rem != 0 do
        current_offset = current_offset + (max_align - tail_rem)
    end

    out current_offset
end.

# C String Marshalling Helpers
func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Type Size & Alignment Assertions
    assert(ctype_size(1) == 1)   # I8 -> 1
    assert(ctype_size(3) == 4)   # I32 -> 4
    assert(ctype_size(4) == 8)   # I64 -> 8
    assert(ctype_size(11) == 8)  # Ptr -> 8
    assert(ctype_size(12) == 8)  # Str -> 8

    # 2. C Struct Alignment Simulation
    # struct Example {
    #     char a;     // offset 0 (size 1, align 1)
    #     // 3 bytes padding
    #     int b;      // offset 4 (size 4, align 4)
    #     short c;    // offset 8 (size 2, align 2)
    #     // 6 bytes padding
    #     void_ptr d; // offset 16 (size 8, align 8)
    #     char e;     // offset 24 (size 1, align 1)
    #     // 7 bytes tail padding -> total size 32, max_align 8
    # };
    let fields = alloc(5 * 8)
    write_word(fields, 0 * 8, 1)  # I8 (char)
    write_word(fields, 1 * 8, 3)  # I32 (int)
    write_word(fields, 2 * 8, 2)  # I16 (short)
    write_word(fields, 3 * 8, 11) # Ptr (void_ptr)
    write_word(fields, 4 * 8, 1)  # I8 (char)

    let offsets = alloc(5 * 8)
    let total_sz = cstruct_calc_layout(fields, 5, offsets)

    assert(total_sz == 32) # Total size with padding
    assert(read_word(offsets, 0 * 8) == 0)  # field a offset 0
    assert(read_word(offsets, 1 * 8) == 4)  # field b offset 4
    assert(read_word(offsets, 2 * 8) == 8)  # field c offset 8
    assert(read_word(offsets, 3 * 8) == 16) # field d offset 16
    assert(read_word(offsets, 4 * 8) == 24) # field e offset 24

    # 3. Parameter Marshalling to C ABI Registers
    # Target ARM64: arg0..arg7 in X0..X7
    # Target x86_64: arg0..arg5 in RDI, RSI, RDX, RCX, R8, R9
    # Target Win64: arg0..arg3 in RCX, RDX, R8, R9
    assert(cstr_len("libsqlite3.so") == 13)
    assert(cstr_eq("libsqlite3.so", "libsqlite3.so") == 1)

    out 0
end.
