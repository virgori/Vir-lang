include string_rt
import native_read_i64, native_write_i64 from string_rt
include rt.alloc
import vir_alloc from rt.alloc

func fill(p: int, held: int, tc: int, bi: int):
    native_write_i64(p, 0, held)
    native_write_i64(p, 8, 0)
    native_write_i64(p, 16, tc)
    native_write_i64(p, 24, 1234)
    native_write_i64(p, 32, 0)
    native_write_i64(p, 40, bi)
end.

func main:
    let p = vir_alloc(48)
    fill(p, 111, 13, 999)
    print(native_read_i64(p, 0))
    print(native_read_i64(p, 8))
    print(native_read_i64(p, 16))
    print(native_read_i64(p, 24))
    print(native_read_i64(p, 32))
    print(native_read_i64(p, 40))
end.
