# Test: Linux ARM64 ELF Executable Generator & Structural Validator (Spec §9, stdlib/vir/rt/elf)

func u16_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
end.

func u32_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
    write_byte(buf, off + 2, (val shr 16) bit_and 255)
    write_byte(buf, off + 3, (val shr 24) bit_and 255)
end.

func u64_le(buf, off, lo, hi):
    u32_le(buf, off, lo)
    u32_le(buf, off + 4, hi)
end.

func read_u16_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    out (b1 shl 8) bit_or b0
end.

func read_u32_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    let b2 = read_byte(buf, off + 2)
    let b3 = read_byte(buf, off + 3)
    out (b3 shl 24) bit_or (b2 shl 16) bit_or (b1 shl 8) bit_or b0
end.

func fs_open(path, flags, mode):
    out syscall3(0x2000005, path, flags, mode)
end.

func fs_close(fd):
    out syscall1(0x2000006, fd)
end.

func fs_write(fd, buf, count):
    out syscall3(0x2000004, fd, buf, count)
end.

func fs_read(fd, buf, count):
    out syscall3(0x2000003, fd, buf, count)
end.

func fs_unlink(path):
    out syscall1(0x200000A, path)
end.

# Generates a valid static Linux ARM64 ELF executable
func elf_arm64_create(code_ptr, code_len, entry_offset, out_path):
    # Layout:
    # 0..63:   ELF Header (64 bytes)
    # 64..119: Program Header PT_LOAD (56 bytes)
    # 120..127: Padding (8 bytes) -> code starts at 128 (0x80)
    # 128..128+code_len: ARM64 Machine Code

    let code_offset = 128
    let total_file_size = code_offset + code_len
    let buf = alloc(total_file_size)

    # Zero initialize buffer
    var i = 0
    when i < total_file_size loop
        write_byte(buf, i, 0)
        i = i + 1
    end

    # ── 1. ELF Header (64 bytes) ──
    # e_ident
    write_byte(buf, 0, 0x7F)
    write_byte(buf, 1, 0x45) # 'E'
    write_byte(buf, 2, 0x4C) # 'L'
    write_byte(buf, 3, 0x46) # 'F'
    write_byte(buf, 4, 2)    # ELFCLASS64
    write_byte(buf, 5, 1)    # ELFDATA2LSB (Little Endian)
    write_byte(buf, 6, 1)    # EV_CURRENT
    write_byte(buf, 7, 0)    # ELFOSABI_NONE (System V)

    # e_type = ET_EXEC (2)
    u16_le(buf, 16, 2)

    # e_machine = EM_AARCH64 (183 = 0x00B7)
    u16_le(buf, 18, 183)

    # e_version = 1
    u32_le(buf, 20, 1)

    # e_entry = 0x400000 + code_offset + entry_offset
    let entry_vaddr_lo = 0x00400000 + code_offset + entry_offset
    u64_le(buf, 24, entry_vaddr_lo, 0)

    # e_phoff = 64 (immediately follows ELF Header)
    u64_le(buf, 32, 64, 0)

    # e_shoff = 0 (no section header for stripped minimal static binary)
    u64_le(buf, 40, 0, 0)

    # e_flags = 0
    u32_le(buf, 48, 0)

    # e_ehsize = 64
    u16_le(buf, 52, 64)

    # e_phentsize = 56
    u16_le(buf, 54, 56)

    # e_phnum = 1 (1 PT_LOAD segment)
    u16_le(buf, 56, 1)

    # e_shentsize = 64
    u16_le(buf, 58, 64)

    # e_shnum = 0
    u16_le(buf, 60, 0)

    # e_shstrndx = 0
    u16_le(buf, 62, 0)

    # ── 2. Program Header (56 bytes, offset 64..119) ──
    # p_type = PT_LOAD (1)
    u32_le(buf, 64, 1)

    # p_flags = PF_R(4) | PF_W(2) | PF_X(1) = 7 (Read/Write/Execute)
    u32_le(buf, 68, 7)

    # p_offset = 0 (maps entire file including headers into memory)
    u64_le(buf, 72, 0, 0)

    # p_vaddr = 0x400000
    u64_le(buf, 80, 0x00400000, 0)

    # p_paddr = 0x400000
    u64_le(buf, 88, 0x00400000, 0)

    # p_filesz = total_file_size
    u64_le(buf, 96, total_file_size, 0)

    # p_memsz = total_file_size
    u64_le(buf, 104, total_file_size, 0)

    # p_align = 0x10000 (64KB page alignment for Linux ARM64)
    u64_le(buf, 112, 0x00010000, 0)

    # ── 3. Copy Machine Code at offset 128 ──
    i = 0
    when i < code_len loop
        write_byte(buf, code_offset + i, read_byte(code_ptr, i))
        i = i + 1
    end

    # ── 4. Write ELF binary to file ──
    # O_WRONLY | O_CREAT | O_TRUNC = 0x0601, mode 0755 = 493
    let fd = fs_open(out_path, 0x0601, 493)
    if fd < 0 do out 0 end

    var written = 0
    when written < total_file_size loop
        let n = fs_write(fd, buf + written, total_file_size - written)
        if n <= 0 do
            fs_close(fd)
            out 0
        end
        written = written + n
    end
    fs_close(fd)
    out total_file_size
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let out_file = "/tmp/vir_test_linux_arm64.elf"
    fs_unlink(out_file)

    # 1. Prepare raw ARM64 machine code for Linux:
    # _start:
    #   MOV X0, #42        ; Exit code 42 -> 0xD2800540 (little endian: 0x40, 0x05, 0x80, 0xD2)
    #   MOV X8, #93        ; Linux ARM64 sys_exit = 93 -> 0xD2800BA8 (0xA8, 0x0B, 0x80, 0xD2)
    #   SVC #0             ; Linux syscall supervisor call -> 0xD4000001 (0x01, 0x00, 0x00, 0xD4)
    let code_buf = alloc(12)
    u32_le(code_buf, 0, 0xD2800540)
    u32_le(code_buf, 4, 0xD2800BA8)
    u32_le(code_buf, 8, 0xD4000001)

    # 2. Emit ELF file
    let file_sz = elf_arm64_create(code_buf, 12, 0, out_file)
    assert(file_sz == 140) # 128 header + 12 code

    # 3. Read generated ELF file back and validate binary layout byte-for-byte
    let fd = fs_open(out_file, 0, 0) # O_RDONLY
    assert(fd >= 0)

    let read_buf = alloc(256)
    let nread = fs_read(fd, read_buf, 256)
    assert(nread == 140)
    fs_close(fd)

    # Validate ELF Identification
    assert(read_byte(read_buf, 0) == 0x7F)
    assert(read_byte(read_buf, 1) == 0x45) # 'E'
    assert(read_byte(read_buf, 2) == 0x4C) # 'L'
    assert(read_byte(read_buf, 3) == 0x46) # 'F'
    assert(read_byte(read_buf, 4) == 2)    # 64-bit
    assert(read_byte(read_buf, 5) == 1)    # Little-endian
    assert(read_byte(read_buf, 6) == 1)    # ELF Version 1

    # Validate ELF Header Fields
    assert(read_u16_le(read_buf, 16) == 2)   # ET_EXEC
    assert(read_u16_le(read_buf, 18) == 183) # EM_AARCH64
    assert(read_u32_le(read_buf, 20) == 1)   # EV_CURRENT
    assert(read_u32_le(read_buf, 24) == 0x00400080) # Entry Point = 0x400080
    assert(read_u32_le(read_buf, 32) == 64)  # phoff = 64
    assert(read_u16_le(read_buf, 52) == 64)  # ehsize = 64
    assert(read_u16_le(read_buf, 54) == 56)  # phentsize = 56
    assert(read_u16_le(read_buf, 56) == 1)   # phnum = 1

    # Validate Program Header Fields
    assert(read_u32_le(read_buf, 64) == 1)          # PT_LOAD
    assert(read_u32_le(read_buf, 68) == 7)          # PF_R | PF_W | PF_X
    assert(read_u32_le(read_buf, 72) == 0)          # p_offset = 0
    assert(read_u32_le(read_buf, 80) == 0x00400000) # p_vaddr = 0x400000
    assert(read_u32_le(read_buf, 96) == 140)        # p_filesz = 140
    assert(read_u32_le(read_buf, 104) == 140)       # p_memsz = 140
    assert(read_u32_le(read_buf, 112) == 0x00010000)# p_align = 64KB

    # Validate Machine Code in .text
    assert(read_u32_le(read_buf, 128) == 0xD2800540) # MOV X0, #42
    assert(read_u32_le(read_buf, 132) == 0xD2800BA8) # MOV X8, #93
    assert(read_u32_le(read_buf, 136) == 0xD4000001) # SVC #0

    # Clean up
    fs_unlink(out_file)

    out 0
end.
