# Phase D2: Test std/fs — Direct Syscall Filesystem Operations (Spec §9, stdlib/vir/fs)

func fs_open(path, flags, mode):
    # SYS_OPEN = 0x2000005
    out syscall3(0x2000005, path, flags, mode)
end.

func fs_close(fd):
    # SYS_CLOSE = 0x2000006
    out syscall1(0x2000006, fd)
end.

func fs_read(fd, buf, count):
    # SYS_READ = 0x2000003
    out syscall3(0x2000003, fd, buf, count)
end.

func fs_write(fd, buf, count):
    # SYS_WRITE = 0x2000004
    out syscall3(0x2000004, fd, buf, count)
end.

func fs_lseek(fd, offset, whence):
    # SYS_LSEEK = 0x20000C7 (macOS 199)
    out syscall3(0x20000C7, fd, offset, whence)
end.

func fs_unlink(path):
    # SYS_UNLINK = 0x200000A
    out syscall1(0x200000A, path)
end.

func fs_write_file(path, data, len):
    # O_WRONLY(1) | O_CREAT(0x0200) | O_TRUNC(0x0400) = 0x0601, mode 0644 (420)
    let fd = fs_open(path, 0x0601, 420)
    if fd < 0 do out 0 end
    var written = 0
    when written < len loop
        let n = fs_write(fd, data + written, len - written)
        if n <= 0 do
            fs_close(fd)
            out 0
        end
        written = written + n
    end
    fs_close(fd)
    out 1
end.

func fs_append_file(path, data, len):
    # O_WRONLY(1) | O_CREAT(0x0200) | O_APPEND(0x0008) = 0x0209, mode 0644 (420)
    let fd = fs_open(path, 0x0209, 420)
    if fd < 0 do out 0 end
    var written = 0
    when written < len loop
        let n = fs_write(fd, data + written, len - written)
        if n <= 0 do
            fs_close(fd)
            out 0
        end
        written = written + n
    end
    fs_close(fd)
    out 1
end.

func fs_read_file(path, out_buf, max_len):
    # O_RDONLY = 0
    let fd = fs_open(path, 0, 0)
    if fd < 0 do out 0 - 1 end
    var total = 0
    var done = 0
    when (total < max_len) and (done == 0) loop
        let n = fs_read(fd, out_buf + total, max_len - total)
        if n <= 0 do
            done = 1
        else
            total = total + n
        end
    end
    write_byte(out_buf, total, 0) # null terminate
    fs_close(fd)
    out total
end.

func fs_file_size(path):
    let fd = fs_open(path, 0, 0)
    if fd < 0 do out 0 - 1 end
    let sz = fs_lseek(fd, 0, 2) # SEEK_END = 2
    fs_close(fd)
    out sz
end.

func fs_exists(path):
    let fd = fs_open(path, 0, 0)
    if fd >= 0 do
        fs_close(fd)
        out 1
    end
    out 0
end.

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let test_path = "/tmp/vir_fs_test.tmp"
    let read_buf = alloc(256)

    # 0. Cleanup if existing
    fs_unlink(test_path)
    assert(fs_exists(test_path) == 0)
    assert(fs_file_size(test_path) == (0 - 1))

    # 1. Write file
    let msg1 = "Hello Vir Native FS!"
    let len1 = cstr_len(msg1) # 20 bytes
    assert(fs_write_file(test_path, msg1, len1) == 1)

    # 2. Check existence and size
    assert(fs_exists(test_path) == 1)
    assert(fs_file_size(test_path) == len1)

    # 3. Read and verify content
    let rlen1 = fs_read_file(test_path, read_buf, 255)
    assert(rlen1 == len1)
    assert(cstr_eq(read_buf, msg1) == 1)

    # 4. Append to file
    let msg2 = " Append OK!"
    let len2 = cstr_len(msg2) # 11 bytes
    assert(fs_append_file(test_path, msg2, len2) == 1)
    assert(fs_file_size(test_path) == len1 + len2)

    # 5. Read combined content
    let rlen2 = fs_read_file(test_path, read_buf, 255)
    assert(rlen2 == len1 + len2)
    assert(cstr_eq(read_buf, "Hello Vir Native FS! Append OK!") == 1)

    # 6. Unlink file
    assert(fs_unlink(test_path) == 0) # unlink returns 0 on success
    assert(fs_exists(test_path) == 0)
    assert(fs_file_size(test_path) == (0 - 1))

    out 0
end.
