# Phase B2: Test std/core Result (Ok/Err pattern)
# Test the core logic: error propagation, chain, unwrap_or pattern.
# Avoids str_len (not available on raw string literals in virc stage-1).

func safe_div_checked(a, b):
    # Returns a/b or -1 on div-by-zero
    if b == 0 do out (0 - 1) end
    out a / b
end.

func safe_sqrt(n):
    # Returns isqrt(n), or -1 if n < 0
    if n < 0 do out (0 - 1) end
    if n == 0 do out 0 end
    var x = n shr 1
    if x == 0 do out 1 end
    var xn = (x + n / x) shr 1
    when xn < x loop
        x = xn
        xn = (x + n / x) shr 1
    end
    out x
end.

func is_ok(r):
    out r >= 0
end.

func is_err(r):
    out r < 0
end.

func unwrap_or_val(r, default_val):
    if r < 0 do out default_val end
    out r
end.

func map_double(r):
    if r < 0 do out r end
    out r * 2
end.

func result_chain(n):
    # sqrt -> *2 -> +10, propagating errors
    let r1 = safe_sqrt(n)
    if r1 < 0 do out r1 end
    let r2 = r1 * 2
    out r2 + 10
end.

func result_chain_div(a, b, c):
    # (a / b) + c, propagating div error
    let r1 = safe_div_checked(a, b)
    if r1 < 0 do out r1 end
    out r1 + c
end.

func main:
    # 1. is_ok / is_err basic
    if is_ok(0) != 1      do out 1 end
    if is_ok(42) != 1     do out 2 end
    if is_ok(0 - 1) != 0  do out 3 end
    if is_err(0 - 1) != 1 do out 4 end
    if is_err(0) != 0     do out 5 end

    # 2. unwrap_or
    if unwrap_or_val(42, 99) != 42    do out 6 end
    if unwrap_or_val(0 - 1, 99) != 99 do out 7 end

    # 3. safe_sqrt — Ok path
    if safe_sqrt(0) != 0    do out 8 end
    if safe_sqrt(1) != 1    do out 9 end
    if safe_sqrt(4) != 2    do out 10 end
    if safe_sqrt(9) != 3    do out 11 end
    if safe_sqrt(100) != 10 do out 12 end
    if safe_sqrt(144) != 12 do out 13 end

    # 4. safe_sqrt — Err path
    if safe_sqrt(0 - 1) != (0 - 1) do out 14 end
    if safe_sqrt(0 - 100) != (0 - 1) do out 15 end

    # 5. safe_div — Ok path
    if safe_div_checked(100, 5) != 20 do out 16 end
    if safe_div_checked(0, 10) != 0   do out 17 end

    # 6. safe_div — Err path
    if safe_div_checked(5, 0) != (0 - 1) do out 18 end

    # 7. map (transform if Ok)
    if map_double(5) != 10       do out 19 end
    if map_double(0 - 1) != (0 - 1) do out 20 end

    # 8. result_chain — Ok path
    # sqrt(64)=8, *2=16, +10=26
    if result_chain(64) != 26    do out 21 end
    # sqrt(0)=0, *2=0, +10=10
    if result_chain(0) != 10     do out 22 end

    # 9. result_chain — Err propagation
    if result_chain(0 - 4) != (0 - 1) do out 23 end

    # 10. result_chain_div — Ok path
    if result_chain_div(100, 4, 5) != 30 do out 24 end

    # 11. result_chain_div — Err propagation
    if result_chain_div(100, 0, 5) != (0 - 1) do out 25 end

    # 12. unwrap_or on chain result
    let v = result_chain(0 - 9)   # Err
    let safe = unwrap_or_val(v, 0)
    if safe != 0 do out 26 end

    out 0
end.
