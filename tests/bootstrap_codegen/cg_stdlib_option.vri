# Phase B1: Test std/core Option (tagged union - Spec §5, §6)
# Option is emulated via integer convention: 0 = None, non-zero = Some(value)
# The stdlib uses enum, but for native test we test the logic patterns.

func safe_div(a, b):
    # Returns value on success, 0 on division by zero (None-like)
    if b == 0 do out 0 end
    out a / b
end.

func first_positive(arr, len):
    # Find first positive — returns value or 0
    var i = 0
    when i < len loop
        let v = read_word(arr, i * 8)
        if v > 0 do out v end
        i = i + 1
    end
    out 0
end.

func unwrap_or_val(opt, default_val):
    if opt == 0 do out default_val end
    out opt
end.

func map_double(opt):
    if opt == 0 do out 0 end
    out opt * 2
end.

func and_then_incr(opt):
    if opt == 0 do out 0 end
    let v = opt
    if v < 0 do out 0 end   # filter negatives -> None
    out v + 1
end.

func main:
    # 1. is_some / is_none pattern
    let some_42 = 42
    let none_val = 0
    if some_42 == 0 do out 1 end   # should be Some
    if none_val != 0 do out 2 end  # should be None

    # 2. unwrap_or
    if unwrap_or_val(42, 99) != 42 do out 3 end
    if unwrap_or_val(0, 99) != 99 do out 4 end

    # 3. safe_div (Option-returning function)
    let r1 = safe_div(100, 5)
    if r1 != 20 do out 5 end
    let r2 = safe_div(100, 0)
    if r2 != 0 do out 6 end

    # 4. map (transform value if Some)
    if map_double(7) != 14 do out 7 end
    if map_double(0) != 0 do out 8 end

    # 5. and_then (chain, returns None if negative)
    if and_then_incr(5) != 6 do out 9 end
    if and_then_incr(0) != 0 do out 10 end

    # 6. first_positive (scan returning Option)
    let arr = alloc(5 * 8)
    write_word(arr, 0 * 8, 0 - 3)
    write_word(arr, 1 * 8, 0 - 1)
    write_word(arr, 2 * 8, 7)
    write_word(arr, 3 * 8, 12)
    write_word(arr, 4 * 8, 0 - 2)
    if first_positive(arr, 5) != 7 do out 11 end

    let arr2 = alloc(3 * 8)
    write_word(arr2, 0 * 8, 0 - 1)
    write_word(arr2, 1 * 8, 0 - 2)
    write_word(arr2, 2 * 8, 0 - 3)
    if first_positive(arr2, 3) != 0 do out 12 end

    # 7. Chained: map then and_then
    let v = map_double(4)      # -> 8
    let v2 = and_then_incr(v) # -> 9
    if v2 != 9 do out 13 end

    out 0
end.
