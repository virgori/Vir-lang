# EXPECT_START
# 0
# 8388608
# 1
# EXPECT_END
include "../../stdlib/vir/compiler/vec_rt.vri"
import bvec_new, bvec_push, bvec_len, bvec_get from vec_rt

func main:
    var b = bvec_new()
    var i = 0
    when i < 8388608 loop
        b = bvec_push(b, i & 255)
        i = i + 1
    end
    print bvec_get(b, 0)
    print bvec_len(b)
    print bvec_get(b, 1048577)
end.
