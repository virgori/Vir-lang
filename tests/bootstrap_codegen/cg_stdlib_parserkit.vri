# Phase H2: Test std/parser_kit — Token Stream & Arithmetic Grammar Parser (Spec §9, stdlib/vir/parser_kit)

# Token types:
# 0 = EOF, 1 = NUMBER, 2 = PLUS (+), 3 = MINUS (-), 4 = STAR (*), 5 = SLASH (/), 6 = LPAREN, 7 = RPAREN

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

# Token struct layout at ptr:
# word 0: type (0..7)
# word 8: val (int value for NUMBER)

# TokenStream layout at ptr:
# word 0: tokens array ptr
# word 8: count
# word 16: cursor

func stream_create(cap):
    let ts = alloc(24)
    write_word(ts, 0, alloc(cap * 16))
    write_word(ts, 8, 0)
    write_word(ts, 16, 0)
    out ts
end.

func stream_push(ts, t_type, t_val):
    let tokens = read_word(ts, 0)
    let cnt = read_word(ts, 8)
    let slot = tokens + cnt * 16
    write_word(slot, 0, t_type)
    write_word(slot, 8, t_val)
    write_word(ts, 8, cnt + 1)
end.

func stream_peek_type(ts):
    let cur = read_word(ts, 16)
    let cnt = read_word(ts, 8)
    if cur >= cnt do out 0 end # EOF
    let tokens = read_word(ts, 0)
    out read_word(tokens + cur * 16, 0)
end.

func stream_peek_val(ts):
    let cur = read_word(ts, 16)
    let cnt = read_word(ts, 8)
    if cur >= cnt do out 0 end
    let tokens = read_word(ts, 0)
    out read_word(tokens + cur * 16, 8)
end.

func stream_consume(ts):
    let cur = read_word(ts, 16)
    let cnt = read_word(ts, 8)
    if cur < cnt do
        write_word(ts, 16, cur + 1)
    end
end.

func tokenize_math(src, ts):
    let slen = cstr_len(src)
    var p = 0
    when p < slen loop
        let b = read_byte(src, p)
        # Skip whitespace
        if (b == 32) or (b == 9) or (b == 10) or (b == 13) do
            p = p + 1
        else
            if b == 43 do # '+'
                stream_push(ts, 2, 0)
                p = p + 1
            else
                if b == 45 do # '-'
                    stream_push(ts, 3, 0)
                    p = p + 1
                else
                    if b == 42 do # '*'
                        stream_push(ts, 4, 0)
                        p = p + 1
                    else
                        if b == 47 do # '/'
                            stream_push(ts, 5, 0)
                            p = p + 1
                        else
                            if b == 40 do # '('
                                stream_push(ts, 6, 0)
                                p = p + 1
                            else
                                if b == 41 do # ')'
                                    stream_push(ts, 7, 0)
                                    p = p + 1
                                else
                                    if (b >= 48) and (b <= 57) do
                                        var num = 0
                                        when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
                                            num = num * 10 + (read_byte(src, p) - 48)
                                            p = p + 1
                                        end
                                        stream_push(ts, 1, num)
                                    else
                                        p = p + 1 # ignore
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    stream_push(ts, 0, 0) # EOF
end.

# Recursive descent parser functions forward declarations:
func parse_factor(ts):
    let t = stream_peek_type(ts)
    if t == 1 do # NUMBER
        let val = stream_peek_val(ts)
        stream_consume(ts)
        out val
    end
    if t == 6 do # '('
        stream_consume(ts)
        let val = parse_expr(ts)
        if stream_peek_type(ts) == 7 do # ')'
            stream_consume(ts)
        end
        out val
    end
    out 0
end.

func parse_term(ts):
    var left = parse_factor(ts)
    var done = 0
    when done == 0 loop
        let t = stream_peek_type(ts)
        if t == 4 do # '*'
            stream_consume(ts)
            let right = parse_factor(ts)
            left = left * right
        else
            if t == 5 do # '/'
                stream_consume(ts)
                let right = parse_factor(ts)
                if right != 0 do
                    left = left / right
                end
            else
                done = 1
            end
        end
    end
    out left
end.

func parse_expr(ts):
    var left = parse_term(ts)
    var done = 0
    when done == 0 loop
        let t = stream_peek_type(ts)
        if t == 2 do # '+'
            stream_consume(ts)
            let right = parse_term(ts)
            left = left + right
        else
            if t == 3 do # '-'
                stream_consume(ts)
                let right = parse_term(ts)
                left = left - right
            else
                done = 1
            end
        end
    end
    out left
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Test basic precedence: 2 + 3 * 4 = 14
    let ts1 = stream_create(32)
    tokenize_math("2 + 3 * 4", ts1)
    assert(parse_expr(ts1) == 14)

    # 2. Test parenthesized expressions: (10 + 20) * 3 - 40 / 2 = 70
    let ts2 = stream_create(32)
    tokenize_math("(10 + 20) * 3 - 40 / 2", ts2)
    assert(parse_expr(ts2) == 70)

    # 3. Test nested parens: ((5 + 5) * (2 + 3)) / 10 = 50 / 10 = 5
    let ts3 = stream_create(32)
    tokenize_math("((5 + 5) * (2 + 3)) / 10", ts3)
    assert(parse_expr(ts3) == 5)

    out 0
end.
