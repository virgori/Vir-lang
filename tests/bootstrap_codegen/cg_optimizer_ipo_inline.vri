# Bootstrap Native Test: Interprocedural Optimization (IPO) and Inlining Cascade
# ==============================================================================
# Spec Section 4.8.6 / Pillar 6: Inlining dissolves fine-grained abstractions
# (getters, math helpers, wrappers) into parent caller, triggering multi-pass
# optimization cascade: Inlining -> SCCP -> SROA -> Constant Folding.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Leaf Helper 1: Clamp bounds check (Inlined into caller)
func ipo_clamp_helper(val, min_v, max_v):
    if val < min_v do
        out min_v
    end
    if val > max_v do
        out max_v
    end
    out val
end.

# Abstraction Helper 2: Vector math combination (Inlines Leaf Helper 1)
func ipo_vec2_combine(x1, y1, x2, y2, scale):
    let rx = (x1 + x2) * scale
    let ry = (y1 + y2) * scale
    let combined = rx + ry
    let clamped = ipo_clamp_helper(combined, 0, 100)
    out clamped
end.

# IPO Inlining Heuristic Classifier (Proof of Compiler Inlining Engine):
# Returns 1 if candidate function should be inlined, 0 otherwise.
func ipo_should_inline(inst_count, call_site_count, is_in_loop):
    # Rule 1: Single call-site is always inlined (shrinks binary + 0 overhead)
    if call_site_count == 1 do
        out 1
    end
    # Rule 2: Small leaf function (<= 32 IR instructions)
    if inst_count <= 32 do
        out 1
    end
    # Rule 3: Hot call site in loop with threshold multiplier (3x budget)
    if is_in_loop == 1 do
        if inst_count <= 96 do
            out 1
        end
    end
    out 0
end.

func main:
    # 1. VERIFY INLINING CASCADE COMPUTATION:
    # x1=10, y1=20, x2=5, y2=5, scale=2
    # rx = (10+5)*2 = 30
    # ry = (20+5)*2 = 50
    # combined = 30 + 50 = 80 -> clamped(80, 0, 100) = 80
    let res1 = ipo_vec2_combine(10, 20, 5, 5, 2)
    assert(res1 == 80)

    # Test clamping upper bound: combined = 120 -> clamped(120, 0, 100) = 100
    let res2 = ipo_vec2_combine(20, 40, 0, 0, 2)
    assert(res2 == 100)

    # 2. VERIFY IPO INLINING HEURISTIC ENGINE:
    # Case A: Small leaf function (inst_count=15, sites=5, loop=0) -> Inline
    let h1 = ipo_should_inline(15, 5, 0)
    assert(h1 == 1)

    # Case B: Single call site (inst_count=200, sites=1, loop=0) -> Inline
    let h2 = ipo_should_inline(200, 1, 0)
    assert(h2 == 1)

    # Case C: Loop hot-site (inst_count=64, sites=10, loop=1) -> Inline
    let h3 = ipo_should_inline(64, 10, 1)
    assert(h3 == 1)

    # Case D: Large function outside loop (inst_count=120, sites=4, loop=0) -> Do not inline
    let h4 = ipo_should_inline(120, 4, 0)
    assert(h4 == 0)

    out 0
end.
