# Phase D3: Test std/env — Environment & CLI Argument Processing (Spec §9, stdlib/vir/env)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# Splits KEY=VALUE into key_out and val_out buffers
func env_split_pair(entry, key_out, val_out):
    let l = cstr_len(entry)
    var eq_pos = 0 - 1
    var i = 0
    when (i < l) and (eq_pos == (0 - 1)) loop
        if read_byte(entry, i) == 61 do # '='
            eq_pos = i
        end
        i = i + 1
    end

    if eq_pos == (0 - 1) do
        # No '=', key is entire string, val is empty
        i = 0
        when i < l loop
            write_byte(key_out, i, read_byte(entry, i))
            i = i + 1
        end
        write_byte(key_out, i, 0)
        write_byte(val_out, 0, 0)
        out 1
    end

    # Copy key
    i = 0
    when i < eq_pos loop
        write_byte(key_out, i, read_byte(entry, i))
        i = i + 1
    end
    write_byte(key_out, i, 0)

    # Copy value
    var v_idx = 0
    i = eq_pos + 1
    when i < l loop
        write_byte(val_out, v_idx, read_byte(entry, i))
        v_idx = v_idx + 1
        i = i + 1
    end
    write_byte(val_out, v_idx, 0)
    out 1
end.

# Looks up key in a list of KEY=VALUE strings
func env_lookup(entries, count, target_key, val_out):
    let tmp_k = alloc(128)
    let tmp_v = alloc(256)
    var i = 0
    when i < count loop
        let entry = read_word(entries, i * 8)
        env_split_pair(entry, tmp_k, tmp_v)
        if cstr_eq(tmp_k, target_key) == 1 do
            let vl = cstr_len(tmp_v)
            var j = 0
            when j < vl loop
                write_byte(val_out, j, read_byte(tmp_v, j))
                j = j + 1
            end
            write_byte(val_out, j, 0)
            out 1 # Found
        end
        i = i + 1
    end
    out 0 # Not found
end.

func env_join_paths(paths, count, sep_char, out_buf):
    var dst = 0
    var i = 0
    when i < count loop
        let p = read_word(paths, i * 8)
        let pl = cstr_len(p)
        var j = 0
        when j < pl loop
            write_byte(out_buf, dst, read_byte(p, j))
            dst = dst + 1
            j = j + 1
        end
        if (i + 1) < count do
            write_byte(out_buf, dst, sep_char)
            dst = dst + 1
        end
        i = i + 1
    end
    write_byte(out_buf, dst, 0)
    out out_buf
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let k_buf = alloc(128)
    let v_buf = alloc(256)

    # 1. Test env_split_pair
    env_split_pair("USER=gengyang", k_buf, v_buf)
    assert(cstr_eq(k_buf, "USER") == 1)
    assert(cstr_eq(v_buf, "gengyang") == 1)

    env_split_pair("PATH=/usr/bin:/bin", k_buf, v_buf)
    assert(cstr_eq(k_buf, "PATH") == 1)
    assert(cstr_eq(v_buf, "/usr/bin:/bin") == 1)

    env_split_pair("EMPTY=", k_buf, v_buf)
    assert(cstr_eq(k_buf, "EMPTY") == 1)
    assert(cstr_eq(v_buf, "") == 1)

    env_split_pair("KEY_NO_EQ", k_buf, v_buf)
    assert(cstr_eq(k_buf, "KEY_NO_EQ") == 1)
    assert(cstr_eq(v_buf, "") == 1)

    # 2. Test env_lookup across mock env table
    let env_table = alloc(5 * 8)
    write_word(env_table, 0 * 8, "HOME=/Users/gengyang")
    write_word(env_table, 1 * 8, "LANG=en_US.UTF-8")
    write_word(env_table, 2 * 8, "SHELL=/bin/zsh")
    write_word(env_table, 3 * 8, "VIR_HOME=/opt/vir")
    write_word(env_table, 4 * 8, "ARCH=arm64")

    assert(env_lookup(env_table, 5, "HOME", v_buf) == 1)
    assert(cstr_eq(v_buf, "/Users/gengyang") == 1)

    assert(env_lookup(env_table, 5, "VIR_HOME", v_buf) == 1)
    assert(cstr_eq(v_buf, "/opt/vir") == 1)

    assert(env_lookup(env_table, 5, "ARCH", v_buf) == 1)
    assert(cstr_eq(v_buf, "arm64") == 1)

    assert(env_lookup(env_table, 5, "NOT_FOUND", v_buf) == 0)

    # 3. Test path joining (e.g. constructing PATH)
    let path_list = alloc(3 * 8)
    write_word(path_list, 0 * 8, "/usr/bin")
    write_word(path_list, 1 * 8, "/bin")
    write_word(path_list, 2 * 8, "/usr/local/bin")

    let joined = alloc(256)
    env_join_paths(path_list, 3, 58, joined) # 58 = ':'
    assert(cstr_eq(joined, "/usr/bin:/bin:/usr/local/bin") == 1)

    out 0
end.
