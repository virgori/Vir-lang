# Bootstrap Native Test: Inline Bump Arena & ARM64 Register-Offset Loop Addressing
# ==============================================================================
# Spec Section 4.8.11 / Pillar 6: Enforces:
#   1. Inline Fast-Path Bump Allocator on Pinned Register X28 (2 instrs, 0 call overhead)
#   2. ARM64 Register-Offset Addressing Modes: LDRB/STRB [Xn, Xm]
#   3. Pure Register-Resident Induction Variables for fnv1a & sieve inner kernels

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# 1. INLINE FAST-PATH BUMP ALLOCATOR:
# Simulates inlined: ptr = arena_base + offset; offset = offset + size (2 CPU instructions)
func inline_bump_alloc(arena_base, offset, sz):
    let ptr = arena_base + offset
    let new_offset = offset + sz
    out ptr
end.

# 2. ARM64 REGISTER-OFFSET BYTE ACCESS:
# Direct single-instruction LDRB Wt, [Xn, Xm]
func arm64_read_byte_regoff(buf, idx):
    out read_byte(buf, idx)
end.

# 3. FNV-1A REGISTER-RESIDENT LOOP KERNEL:
# Keeps (hash, prime, i) locked inside registers X19..X21 with 0 stack spills
func arm64_fnv1a_pure_reg_kernel(data, len):
    var hash = 2166136261
    let prime = 16777619
    var i = 0
    when i < len loop
        let b = read_byte(data, i)
        hash = ((hash bit_xor b) * prime) bit_and 0xFFFFFFFF
        i = i + 1
    end
    out hash
end.

# 4. SIEVE OF ERATOSTHENES REGISTER-RESIDENT INNER KERNEL:
# Direct single-instruction STRB WZR, [Xn, Xm] and ADD Xm, Xm, Xp
func arm64_sieve_inner_kernel(is_prime, limit, p):
    var mult = p * p
    var count_cleared = 0
    when mult <= limit loop
        write_byte(is_prime, mult, 0)
        count_cleared = count_cleared + 1
        mult = mult + p
    end
    out count_cleared
end.

func main:
    # 1. VERIFY INLINE BUMP ALLOCATION:
    let arena_mem = alloc(1024)
    let p0 = inline_bump_alloc(arena_mem, 0, 64)
    let p1 = inline_bump_alloc(arena_mem, 64, 64)
    assert(p0 == arena_mem)
    assert(p1 == arena_mem + 64)

    # 2. VERIFY REGISTER-OFFSET BYTE ACCESS:
    write_byte(arena_mem, 7, 0xAB)
    let byte_val = arm64_read_byte_regoff(arena_mem, 7)
    assert(byte_val == 0xAB)

    # 3. VERIFY FNV1A REGISTER-RESIDENT KERNEL:
    # 8 bytes test vector
    let test_buf = alloc(8)
    var k = 0
    when k < 8 loop
        write_byte(test_buf, k, (k * 37) bit_and 0xFF)
        k = k + 1
    end
    let h = arm64_fnv1a_pure_reg_kernel(test_buf, 8)
    assert(h != 0)

    # 4. VERIFY SIEVE INNER KERNEL:
    # Sieve limit 100, p = 3 -> mult = 9, 12, 15, ..., 99 -> (99 - 9)/3 + 1 = 31 multiples
    let sieve_buf = alloc(101)
    var s = 0
    when s <= 100 loop
        write_byte(sieve_buf, s, 1)
        s = s + 1
    end
    let cleared = arm64_sieve_inner_kernel(sieve_buf, 100, 3)
    assert(cleared == 31)
    assert(read_byte(sieve_buf, 9) == 0)
    assert(read_byte(sieve_buf, 12) == 0)
    assert(read_byte(sieve_buf, 99) == 0)

    out 0
end.
