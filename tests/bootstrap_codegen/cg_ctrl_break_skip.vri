# Regression test for Pillar 8: break and skip in when and for loops
func main:
    # 1. Break in when loop
    var w1 = 0
    when 1 loop
        w1 += 10
        break
    end
    print(w1)

    # 2. Skip in when loop
    var w2 = 0
    var c = 0
    when c < 5 loop
        c += 1
        if c == 3 do
            skip
        end
        w2 += c
    end
    print(w2)

    # 3. Break in for range loop
    var s3 = 0
    for i in 1..10 do
        if i == 4 do
            break
        end
        s3 += i
    end
    print(s3)

    # 4. Skip in for range loop
    var s4 = 0
    for r in 1..6 do
        if r == 3 do
            skip
        end
        s4 += r
    end
    print(s4)

    out 0
end.
