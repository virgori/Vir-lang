# Vir Native Regression Test: Logical operators and unary NOT (Spec §10.3)

func main():
    var a = 0
    var b = 1
    var c = 100

    print(!a) # 1
    print(!b) # 0
    print(!c) # 0

    print(1 && 1) # 1
    print(1 && 0) # 0
    print(0 && 1) # 0
    print(0 && 0) # 0

    print(1 || 1) # 1
    print(1 || 0) # 1
    print(0 || 1) # 1
    print(0 || 0) # 0

    out 0
end.
