# EXPECT:
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Allocate 16KB RW page via mmap
    # SYS_mmap = 197
    # prot = PROT_READ(1) | PROT_WRITE(2) = 3
    # flags = MAP_ANON(0x1000) | MAP_PRIVATE(0x0002) = 4098
    let page_size = 16384
    let page = syscall6(197, 0, page_size, 3, 4098, 0 - 1, 0)
    assert(page > 0)

    # 2. Emit ARM64 machine code into RW JIT buffer:
    # Code:
    #   ADD X0, X0, X1   ; 0x8B010000 (0x00, 0x00, 0x01, 0x8B)
    #   RET              ; 0xD65F03C0 (0xC0, 0x03, 0x5F, 0xD6)
    write_byte(page, 0, 0)
    write_byte(page, 1, 0)
    write_byte(page, 2, 1)
    write_byte(page, 3, 139)

    write_byte(page, 4, 192)
    write_byte(page, 5, 3)
    write_byte(page, 6, 95)
    write_byte(page, 7, 214)

    # 3. Flip protection from RW (3) to RX (5 = PROT_READ | PROT_EXEC)
    # SYS_mprotect = 74
    let mprot = syscall3(74, page, page_size, 5)
    assert(mprot == 0)

    # 4. Call JIT function pointer via Indirect Call (BLR)
    let jit_add = page
    let res = jit_add(20, 22)
    assert(res == 42)

    let res2 = jit_add(100, 250)
    assert(res2 == 350)

    out 0
end.
