# Test std/str functions (Spec §4.6, stdlib/vir/str)

entity StringBuilder:
    buf: ptr,
    len: int,
    cap: int
end.

func sb_new(initial_cap):
    let b = alloc(initial_cap + 1)
    write_byte(b, 0, 0)
    out StringBuilder(b, 0, initial_cap)
end.

func sb_append_str(sb, s):
    let slen = str_len(s)
    if sb.len + slen > sb.cap do
        let new_cap = (sb.cap + slen) * 2
        let new_buf = alloc(new_cap + 1)
        # Copy existing
        var i = 0
        when i < sb.len loop
            write_byte(new_buf, i, read_byte(sb.buf, i))
            i = i + 1
        end
        sb.buf = new_buf
        sb.cap = new_cap
    end
    var j = 0
    when j < slen loop
        write_byte(sb.buf, sb.len + j, read_byte(s, j))
        j = j + 1
    end
    sb.len = sb.len + slen
    write_byte(sb.buf, sb.len, 0)
end.

func parse_int(s):
    var res = 0
    var i = 0
    let slen = str_len(s)
    var sign = 1
    if slen > 0 do
        let c0 = read_byte(s, 0)
        if c0 == 45 do # '-'
            sign = 0 - 1
            i = 1
        end
    end
    when i < slen loop
        let c = read_byte(s, i)
        if (c >= 48) and (c <= 57) do
            res = res * 10 + (c - 48)
        end
        i = i + 1
    end
    out res * sign
end.

func str_substr(s, start, sublen):
    let slen = str_len(s)
    if start >= slen do out "" end
    var actual_len = sublen
    if start + actual_len > slen do
        actual_len = slen - start
    end
    let res = alloc(actual_len + 1)
    var i = 0
    when i < actual_len loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, actual_len, 0)
    out res
end.

func main:
    # 1. StringBuilder
    var sb = sb_new(16)
    sb_append_str(sb, "Hello, ")
    sb_append_str(sb, "Vir ")
    sb_append_str(sb, "World!")
    
    if sb.len != 18 do out 1 end
    if str_eq(sb.buf, "Hello, Vir World!") == 0 do out 2 end

    # 2. parse_int
    let v1 = parse_int("123456")
    if v1 != 123456 do out 3 end
    let v2 = parse_int("-789")
    if v2 != (0 - 789) do out 4 end
    let v3 = parse_int("0")
    if v3 != 0 do out 5 end

    # 3. str_substr
    let orig = "Programming in Vir"
    let sub1 = str_substr(orig, 0, 11)
    if str_eq(sub1, "Programming") == 0 do out 6 end
    let sub2 = str_substr(orig, 15, 3)
    if str_eq(sub2, "Vir") == 0 do out 7 end

    out 0
end.
