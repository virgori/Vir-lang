# Test: Indirect Function Pointer Call via Register (BLR)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func add(a, b):
    out a + b
end.

func mul(a, b):
    out a * b
end.

func call_binary_fn(op, a, b):
    out op(a, b)
end.

func main:
    # 1. Indirect call through parameter
    let r1 = call_binary_fn(add, 20, 22)
    assert(r1 == 42)

    let r2 = call_binary_fn(mul, 6, 7)
    assert(r2 == 42)

    # 2. Indirect call through local variable
    let fn_add = add
    let r3 = fn_add(100, 200)
    assert(r3 == 300)

    let fn_mul = mul
    let r4 = fn_mul(10, 25)
    assert(r4 == 250)

    out 0
end.
