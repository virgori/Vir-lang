# Regression test for Pillar 8: pattern matching in case statement
func classify_num(n):
    case n:
        1:
            print(100)
        2:
            print(200)
        3:
            print(300)
        else:
            print(999)
    end
end.

func classify_range(score):
    case score:
        90..101:
            print(1)
        80..90:
            print(2)
        70..80:
            print(3)
        60..70:
            print(4)
        else:
            print(5)
    end
end.

func main:
    classify_num(1)
    classify_num(2)
    classify_num(3)
    classify_num(42)

    classify_range(95)
    classify_range(85)
    classify_range(72)
    classify_range(60)
    classify_range(40)

    out 0
end.
