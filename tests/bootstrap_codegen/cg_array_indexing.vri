# cg_array_indexing.vri — Test array indexing and assignment
func main:
    let arr = [1, 2, 3, 4, 5]
    arr[0] = 100
    arr[1] += 20
    arr[2] -= 1
    arr[3] *= 10
    arr[4] /= 2
    var sum = 0
    var i = 0
    when i < 5 loop
        sum += arr[i]
        i += 1
    end
    print(sum)
    out 0
end.
