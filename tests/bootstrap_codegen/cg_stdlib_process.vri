# Phase D6: Test std/process — Process Primitives & Status Encoding (Spec §9, stdlib/vir/process)

func proc_getpid:
    # SYS_GETPID = 0x2000014 (macOS BSD 20)
    out syscall0(0x2000014)
end.

# POSIX wait status macros:
func proc_wifexited(status):
    if (status bit_and 0x7F) == 0 do
        out 1
    end
    out 0
end.

func proc_wexitstatus(status):
    out (status shr 8) bit_and 0xFF
end.

func proc_wtermsig(status):
    out status bit_and 0x7F
end.

func proc_wifsignaled(status):
    let sig = status bit_and 0x7F
    if (sig != 0) and (sig != 0x7F) do
        out 1
    end
    out 0
end.

# Encode exit status into POSIX waitpid format
func proc_encode_exit(code):
    out (code bit_and 0xFF) shl 8
end.

# Encode signal termination status
func proc_encode_signal(sig):
    out sig bit_and 0x7F
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Test getpid
    let pid = proc_getpid()
    assert(pid > 0)

    # 2. Test exit status encoding and decoding
    let st_0 = proc_encode_exit(0)
    assert(proc_wifexited(st_0) == 1)
    assert(proc_wexitstatus(st_0) == 0)
    assert(proc_wifsignaled(st_0) == 0)

    let st_42 = proc_encode_exit(42)
    assert(proc_wifexited(st_42) == 1)
    assert(proc_wexitstatus(st_42) == 42)
    assert(proc_wifsignaled(st_42) == 0)

    let st_255 = proc_encode_exit(255)
    assert(proc_wifexited(st_255) == 1)
    assert(proc_wexitstatus(st_255) == 255)
    assert(proc_wifsignaled(st_255) == 0)

    # 3. Test signal termination encoding and decoding
    let st_sig9 = proc_encode_signal(9) # SIGKILL
    assert(proc_wifexited(st_sig9) == 0)
    assert(proc_wifsignaled(st_sig9) == 1)
    assert(proc_wtermsig(st_sig9) == 9)

    let st_sig11 = proc_encode_signal(11) # SIGSEGV
    assert(proc_wifexited(st_sig11) == 0)
    assert(proc_wifsignaled(st_sig11) == 1)
    assert(proc_wtermsig(st_sig11) == 11)

    out 0
end.
