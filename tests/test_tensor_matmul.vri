# Test: tensor_matmul tiled vs naive correctness
# A=[2,3], B=[3,2] => C=[2,2]
# A = [[1,2,3],[4,5,6]]
# B = [[7,8],[9,10],[11,12]]
# C = [[1*7+2*9+3*11, 1*8+2*10+3*12],
#       [4*7+5*9+6*11, 4*8+5*10+6*12]]
#    = [[7+18+33, 8+20+36], [28+45+66, 32+50+72]]
#    = [[58, 64], [139, 150]]

include types
include alloc
import alloc, alloc_zeroed, free from alloc
include math/tensor
import Tensor, tensor_zeros, tensor_get_flat, tensor_set_flat,
    tensor_matmul, tensor_matmul_naive from tensor
include vir.rt.io
import print_str, print_ln, int_to_str from vir.rt.io

func check_close(a: float, b: float, tol: float):
    if a == b do out true end
    var diff = a - b
    if diff < 0.0 do diff = 0.0 - diff end
    out diff <= tol
end.

func main() -> int:
    # Build A [2, 3]
    var a_shape = alloc(2 * 8)
    native_store<int>(a_shape, 0, 2)
    native_store<int>(a_shape, 1, 3)
    var a = tensor_zeros(a_shape, 2)
    free(a_shape)
    tensor_set_flat(a, 0, 1.0)
    tensor_set_flat(a, 1, 2.0)
    tensor_set_flat(a, 2, 3.0)
    tensor_set_flat(a, 3, 4.0)
    tensor_set_flat(a, 4, 5.0)
    tensor_set_flat(a, 5, 6.0)

    # Build B [3, 2]
    var b_shape = alloc(2 * 8)
    native_store<int>(b_shape, 0, 3)
    native_store<int>(b_shape, 1, 2)
    var b = tensor_zeros(b_shape, 2)
    free(b_shape)
    tensor_set_flat(b, 0, 7.0)
    tensor_set_flat(b, 1, 8.0)
    tensor_set_flat(b, 2, 9.0)
    tensor_set_flat(b, 3, 10.0)
    tensor_set_flat(b, 4, 11.0)
    tensor_set_flat(b, 5, 12.0)

    # Expected C[2,2] = [[58,64],[139,150]]
    var c_tiled = tensor_matmul(a, b)
    var c_naive = tensor_matmul_naive(a, b)

    var ok = true
    if not check_close(tensor_get_flat(c_tiled, 0), tensor_get_flat(c_naive, 0), 0.0001) do ok = false end
    if not check_close(tensor_get_flat(c_tiled, 1), tensor_get_flat(c_naive, 1), 0.0001) do ok = false end
    if not check_close(tensor_get_flat(c_tiled, 2), tensor_get_flat(c_naive, 2), 0.0001) do ok = false end
    if not check_close(tensor_get_flat(c_tiled, 3), tensor_get_flat(c_naive, 3), 0.0001) do ok = false end

    if ok do
        print_ln("PASS: tensor_matmul tiled == naive, result [58,64,139,150]")
        out 0
    end
    print_ln("FAIL: tensor_matmul mismatch")
    out 1
end.
