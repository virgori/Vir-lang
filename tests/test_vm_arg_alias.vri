func test_sub:
    in(a: int, b: int)
    out a - b;
end.

func main:
    let x = 10;
    let y = 5;
    # If parameter mapping aliases incorrectly, y will overwrite x before x is mapped to b.
    # We expect 5 - 10 = -5. If aliased, it might be 5 - 5 = 0.
    let res = test_sub(y, x);
    print res;
    if res != -5:
        out 1;
    end
    out 0;
end.
