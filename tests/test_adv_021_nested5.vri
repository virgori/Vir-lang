# test_adv_021: Nested loops 5-deep
# Expected: 32

func main:
    var count = 0
    for a in 0..2 do
        for b in 0..2 do
            for c in 0..2 do
                for d in 0..2 do
                    for e in 0..2 do
                        count = count + 1
                    end.
                end.
            end.
        end.
    end.
    print count
end.
