# test_adv_021: Nested loops 5-deep
# Expected: 32

func main:
    var count = 0
    for a in 0..2 loop
        for b in 0..2 loop
            for c in 0..2 loop
                for d in 0..2 loop
                    for e in 0..2 loop
                        count = count + 1
                    end
                end
            end
        end
    end
    print count
end.
