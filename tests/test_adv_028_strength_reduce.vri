# test_adv_028: Strength reduction: multiply by powers of 2
# Expected: 16, 64, 256, 1024

func main:
    var x = 2

    # x * 8 = x shl 3
    var r1 = x * 8
    print r1

    # x * 32
    var r2 = x * 32
    print r2

    # x * 128
    var r3 = x * 128
    print r3

    # x * 512
    var r4 = x * 512
    print r4
end.
