# Nested loops with break
func main:
    var outer = 0
    var total = 0
    when outer < 5 loop
        var inner = 0
        when inner < 10 loop
            if inner == 4 do
                inner = 10 # break
            else
                total = total + inner
                inner = inner + 1
            end
        end
        outer = outer + 1
    end
    print total
    out 0
end.
