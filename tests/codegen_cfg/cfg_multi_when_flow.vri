# Multi-branch decision tree
func classify(n):
    if n < 0 do
        out 0 - 1
    eif n == 0 do
        out 0
    eif n < 10 do
        out 1
    eif n < 100 do
        out 2
    else
        out 3
    end
end.

func main:
    print classify(0 - 50)
    print classify(0)
    print classify(7)
    print classify(42)
    print classify(500)
    out 0
end.
