entity Vec2:
    x
    y
end.
entity Color:
    r
    g
    b
end.
enum Dir:
    North = 0
    East = 1
    South = 2
    West = 3
end.
func add_vec:
    in(a_x, a_y, b_x, b_y)
    out a_x + b_x
end.
func dot:
    in(ax, ay, bx, by)
    out ax * bx + ay * by
end.
func main:
    var p1 = Vec2(x: 3, y: 4)
    var p2 = Vec2(x: 10, y: 20)
    print p1.x
    print p1.y
    print p2.x
    print p2.y

    var sum_x = add_vec(p1.x, p1.y, p2.x, p2.y)
    print sum_x

    var d = dot(p1.x, p1.y, p2.x, p2.y)
    print d

    var c = Color(r: 255, g: 128, b: 0)
    print c.r
    print c.g
    print c.b
    c.b = 64
    print c.b

    var dir = Dir.South
    print dir

    var arr = arr_new()
    var v1 = p1.x
    var v2 = p2.y
    var v3 = d
    push(arr, v1)
    push(arr, v2)
    push(arr, v3)
    print len(arr)
    print arr[0]
    print arr[2]
end.
