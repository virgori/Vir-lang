func vec_new_rt:
    # We'll mock alloc by just returning a fake pointer for now,
    # or we can use native_malloc if it exists in ir_lower.c!
    out native_malloc(100);
end.

func vec_len_rt:
    in(v: int)
    if v == 0 do
        out 0
    end
    out native_load(v - 8, 0)
end.

func main:
    let v = 0;
    
    # 1) Length of null vector should be 0
    let n = vec_len_rt(v);
    
    out n
end.