extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall1(num: int, a0: int) -> int
const SYS_OPEN: int = 0x2000005
const SYS_LSEEK: int = 0x20000C7
const SYS_EXIT: int = 0x2000001
const O_RDONLY: int = 0
func sys_open: in(path: int, flags: int, mode: int) out syscall3(SYS_OPEN, path, flags, mode); end
func sys_lseek: in(fd: int, offset: int, whence: int) out syscall3(SYS_LSEEK, fd, offset, whence); end
func sys_exit: in(code: int) syscall1(SYS_EXIT, code); end
extern func arg_count() -> int
extern func get_arg(idx: int) -> int
func main: let path = get_arg(0); let fd = sys_open(path, O_RDONLY, 0); let size = sys_lseek(fd, 0, 2); sys_exit(size); end
