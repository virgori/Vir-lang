func parse_print_stmt:
    in(p: i64)
    line = 0
    n = ast_new(1)
    n.line = line
    var (p2, val) = parse_expr(p)
    n = ast_add_child(n, val)
    out (p2, n)
end.

func ast_new:
    in(t: i64)
    out (t, t)
end.

func ast_add_child:
    in(node: i64, child: i64)
    out (node, node)
end.

func parse_expr:
    in(x: i64)
    out (x, x)
end.

func main:
    var (a, b) = parse_print_stmt(5)
    print a
end.
