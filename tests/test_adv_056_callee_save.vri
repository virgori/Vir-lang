# test_adv_056: Caller/callee saved register integrity
# Expected: 100, 200, 100, 200

func inner:
    in(x)
    # Use many local vars to pollute registers
    var a = x + 1
    var b = x + 2
    var c = x + 3
    var d = x + 4
    var e = x + 5
    out a + b + c + d + e
end.
func outer:
    var x = 100
    var y = 200
    # Call inner — must NOT clobber x, y
    var r = inner(42)
    print x
    print y
end.
func main:
    outer()
    # Repeat to verify consistency
    var a = 100
    var b = 200
    var r = inner(99)
    print a
    print b
end.
