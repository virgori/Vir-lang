include string_rt
include typecheck_ffi

func main():
    # --- 1. typecheck_resolve_ffi_type ---
    if typecheck_resolve_ffi_type(fat_str_new("int")) != TypeKind.Int do
        print_str("FAIL: int not resolved to TypeKind.Int\n")
        out 1
    end

    if typecheck_resolve_ffi_type(fat_str_new("string")) != TypeKind.String do
        print_str("FAIL: string not resolved to TypeKind.String\n")
        out 1
    end

    if typecheck_resolve_ffi_type(fat_str_new("float")) != TypeKind.Float do
        print_str("FAIL: float not resolved to TypeKind.Float\n")
        out 1
    end

    # --- 2. typecheck_is_valid_ffi_type ---
    if typecheck_is_valid_ffi_type(fat_str_new("ptr")) != true do
        print_str("FAIL: ptr not valid ffi type\n")
        out 1
    end

    if typecheck_is_valid_ffi_type(fat_str_new("void")) != true do
        print_str("FAIL: void not valid ffi type\n")
        out 1
    end

    if typecheck_is_valid_ffi_type(fat_str_new("InvalidFFITypeXYZ")) != false do
        print_str("FAIL: invalid type reported as valid ffi type\n")
        out 1
    end

    print_str("ALL FFI FIXTURES PASS\n")
    out 0
end.
