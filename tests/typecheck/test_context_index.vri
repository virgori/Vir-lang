##
 * tests/typecheck/test_context_index.vri — Context & Index Unit Test
 * =================================================================
 * Positive, negative, and anti-fallback contract verification for
 * Phase 7 context and index service.
 ##

include string_rt
import fat_str_new, fat_str_eq, print_int, print_str from string_rt

include virc.semantic.symbol_table
import SymbolTable, symbol_table_new, SymbolKind, SymbolNode, symbol_alloc from virc.semantic.symbol_table

include virc.semantic.scope_tree
import ScopeTree, scope_tree_new, ScopeKind, scope_push, scope_add_symbol from virc.semantic.scope_tree

include virc.semantic.typecheck.context
import TypecheckContext, typecheck_context_new from virc.semantic.typecheck.context

include virc.semantic.typecheck.index
import typecheck_hash_name, typecheck_get_short_name, typecheck_index_global,
       typecheck_index_scope_symbol, typecheck_lookup_scope_indexed,
       typecheck_rebuild_index from virc.semantic.typecheck.index

func main() -> int:
    var symbols = symbol_table_new()
    var scopes = scope_tree_new()
    var ctx = typecheck_context_new()

    # 1. Positive: register a symbol in scope 1
    let local_name = fat_str_new("target_var")
    let sym1 = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: local_name as i64,
        type_id: 1,
        scope_id: 1,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    let s1_id = symbol_alloc(symbols, sym1)
    typecheck_index_scope_symbol(ctx, 1, local_name, s1_id)

    # Lookup must succeed and return s1_id
    let found = typecheck_lookup_scope_indexed(symbols, ctx, 1, local_name)
    if found != s1_id do
        print_str("FAIL: expected found == s1_id\n")
        out 1
    end

    # 2. Negative: lookup non-existent symbol in scope 1
    let non_existent = fat_str_new("non_existent_var")
    let not_found = typecheck_lookup_scope_indexed(symbols, ctx, 1, non_existent)
    if not_found != -1 do
        print_str("FAIL: expected not_found == -1\n")
        out 2
    end

    # 3. Anti-fallback: lookup target_var in scope 2 (must NOT fall back to scope 1)
    let cross_scope = typecheck_lookup_scope_indexed(symbols, ctx, 2, local_name)
    if cross_scope != -1 do
        print_str("FAIL: scope isolation violated, found in scope 2\n")
        out 3
    end

    # 4. Hash stability check
    let h1 = typecheck_hash_name(local_name)
    let h2 = typecheck_hash_name(local_name)
    if h1 != h2 do
        print_str("FAIL: hash function not deterministic\n")
        out 4
    end

    # 5. Short name extraction check
    let qualified = fat_str_new("virc.semantic.typecheck")
    let short_s = typecheck_get_short_name(qualified)
    if fat_str_eq(short_s, fat_str_new("typecheck")) != 1 do
        print_str("FAIL: short name mismatch\n")
        out 5
    end

    print_str("ALL CONTEXT & INDEX FIXTURES PASS\n")
    out 0
end.
