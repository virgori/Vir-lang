include string_rt
include typecheck_diagnostics

func main():
    let diag = diagnostic_engine_new()
    let ret_stmt = ast_new(AstType.ReturnStmt)
    ret_stmt.line = 10
    ret_stmt.int_val = 5

    let ret_expr = ast_new(AstType.LiteralStr)
    ret_expr.line = 10
    ret_expr.int_val = 12

    # --- 1. typecheck_report_return_type_mismatch ---
    typecheck_report_return_type_mismatch(diag, fat_str_new("foo"), fat_str_new("int"), fat_str_new("string"), ret_stmt, ret_expr)
    if diag.error_count != 1 do
        print_str("FAIL: expected 1 error after return type mismatch\n")
        out 1
    end

    # --- 2. typecheck_report_field_type_mismatch ---
    let assign_stmt = ast_new(AstType.Assign)
    assign_stmt.line = 20
    assign_stmt.int_val = 1
    let rhs_expr = ast_new(AstType.LiteralInt)
    rhs_expr.line = 20
    rhs_expr.int_val = 10
    typecheck_report_field_type_mismatch(diag, fat_str_new("foo"), fat_str_new("string"), fat_str_new("int"), assign_stmt, rhs_expr)
    if diag.error_count != 2 do
        print_str("FAIL: expected 2 errors after field type mismatch\n")
        out 1
    end

    # --- 3. typecheck_report_type_mismatch ---
    typecheck_report_type_mismatch(diag, fat_str_new("foo"), fat_str_new("bool"), fat_str_new("int"), assign_stmt, rhs_expr)
    if diag.error_count != 3 do
        print_str("FAIL: expected 3 errors after general type mismatch\n")
        out 1
    end

    print_str("ALL DIAGNOSTICS FIXTURES PASS\n")
    out 0
end.
