include vec_rt
import vec_new_rt from vec_rt

include string_rt
import fat_str_new, print_str from string_rt

include virc.frontend.parser

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.typecheck.assignment
import typecheck_is_assignable_lhs, typecheck_is_shared_ref_type,
       typecheck_assignment_allows_coercion, typecheck_check_assign_types from virc.semantic.typecheck.assignment

func make_node(nt: AstType) -> AstNode:
    out AstNode (
        name: fat_str_new(""),
        name2: fat_str_new(""),
        node_type: nt,
        op: OpType.Add,
        line: 1,
        int_val: 0,
        float_val: 0.0,
        builtin_id: 0,
        children: vec_new_rt(),
        span_id: 0
    )
end.

func main():
    # --- 1. L-Value Assignability Tests ---
    let n_id = make_node(AstType.Identifier)
    if typecheck_is_assignable_lhs(n_id) != 1 do
        print_str("FAIL: Identifier should be assignable\n")
        out 1
    end

    let n_fld = make_node(AstType.FieldAccess)
    if typecheck_is_assignable_lhs(n_fld) != 1 do
        print_str("FAIL: FieldAccess should be assignable\n")
        out 1
    end

    let n_idx = make_node(AstType.IndexAccess)
    if typecheck_is_assignable_lhs(n_idx) != 1 do
        print_str("FAIL: IndexAccess should be assignable\n")
        out 1
    end

    # Negative: non-L-values
    let n_lit = make_node(AstType.LiteralInt)
    if typecheck_is_assignable_lhs(n_lit) != 0 do
        print_str("FAIL: LiteralInt cannot be assigned to\n")
        out 1
    end

    let n_bin = make_node(AstType.BinOp)
    if typecheck_is_assignable_lhs(n_bin) != 0 do
        print_str("FAIL: BinOp cannot be assigned to\n")
        out 1
    end

    # --- 2. Shared reference detection tests ---
    let t_shared = fat_str_new("&int")
    if not typecheck_is_shared_ref_type(t_shared) do
        print_str("FAIL: &int should be shared ref\n")
        out 1
    end

    let t_mut = fat_str_new("&mut int")
    if typecheck_is_shared_ref_type(t_mut) do
        print_str("FAIL: &mut int should NOT be shared ref\n")
        out 1
    end

    let t_legacy_ref = fat_str_new("ref int")
    if not typecheck_is_shared_ref_type(t_legacy_ref) do
        print_str("FAIL: ref int should be shared ref\n")
        out 1
    end

    let t_val = fat_str_new("int")
    if typecheck_is_shared_ref_type(t_val) do
        print_str("FAIL: int is not a ref\n")
        out 1
    end

    let t_empty = fat_str_new("")
    if typecheck_is_shared_ref_type(t_empty) do
        print_str("FAIL: empty string is not a ref\n")
        out 1
    end

    # --- 3. Assignment Coercion & Anti-Fallback Tests ---
    # Null pointer/entity assignment: 0 literal
    let allow_null_ent = typecheck_assignment_allows_coercion(TypeKind.Entity as i64, TypeKind.Int, AstType.LiteralInt, 0, 1)
    if allow_null_ent != 1 do
        print_str("FAIL: 0 assigned to entity should be allowed\n")
        out 1
    end

    let allow_null_ptr = typecheck_assignment_allows_coercion(TypeKind.Pointer as i64, TypeKind.Int, AstType.LiteralInt, 0, 1)
    if allow_null_ptr != 1 do
        print_str("FAIL: 0 assigned to pointer should be allowed\n")
        out 1
    end

    # Non-zero int assigned to entity -> rejected
    let deny_nonzero = typecheck_assignment_allows_coercion(TypeKind.Entity as i64, TypeKind.Int, AstType.LiteralInt, 42, 1)
    if deny_nonzero != 0 do
        print_str("FAIL: nonzero int to entity must be denied\n")
        out 1
    end

    # User mode: bool <-> int anti-fallback
    let deny_bool_int_user = typecheck_assignment_allows_coercion(TypeKind.Bool as i64, TypeKind.Int, AstType.LiteralInt, 1, 1)
    if deny_bool_int_user != 0 do
        print_str("FAIL: bool <-> int must be denied in user mode\n")
        out 1
    end

    # Compiler mode: bool <-> int allowed
    let allow_bool_int_comp = typecheck_assignment_allows_coercion(TypeKind.Bool as i64, TypeKind.Int, AstType.LiteralInt, 1, 0)
    if allow_bool_int_comp != 1 do
        print_str("FAIL: bool <-> int should be allowed in compiler mode\n")
        out 1
    end

    # --- 4. General assignment compatibility check ---
    let ok_same = typecheck_check_assign_types(TypeKind.Int as i64, TypeKind.Int, AstType.LiteralInt, 5, 1)
    if ok_same != 1 do
        print_str("FAIL: Int to Int must be compatible\n")
        out 1
    end

    let ok_widen = typecheck_check_assign_types(TypeKind.Float as i64, TypeKind.Int, AstType.LiteralInt, 5, 1)
    if ok_widen != 1 do
        print_str("FAIL: Int to Float widening must be compatible\n")
        out 1
    end

    let deny_mismatch = typecheck_check_assign_types(TypeKind.Bool as i64, TypeKind.String, AstType.LiteralStr, 0, 1)
    if deny_mismatch != 0 do
        print_str("FAIL: String to Bool must be rejected\n")
        out 1
    end

    print_str("ALL ASSIGNMENT FIXTURES PASS\n")
    out 0
end.
