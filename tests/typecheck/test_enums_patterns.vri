include string_rt
include typecheck_enums
include typecheck_patterns

func main():
    # --- 1. typecheck_case_is_wildcard ---
    let wild_ast = ast_new(AstType.Identifier)
    wild_ast.name = fat_str_new("_")
    if typecheck_case_is_wildcard(wild_ast) != true do
        print_str("FAIL: _ not recognized as wildcard\n")
        out 1
    end

    let id_ast = ast_new(AstType.Identifier)
    id_ast.name = fat_str_new("SomeVariant")
    if typecheck_case_is_wildcard(id_ast) != false do
        print_str("FAIL: SomeVariant wrongly recognized as wildcard\n")
        out 1
    end

    # --- 2. typecheck_case_pattern_key ---
    let pat_ast = ast_new(AstType.Identifier)
    pat_ast.name = fat_str_new("Red")
    pat_ast.name2 = fat_str_new("Color")
    let key = typecheck_case_pattern_key(pat_ast)
    if fat_str_eq(key, fat_str_new("Color.Red")) != 1 do
        print_str("FAIL: pattern key != Color.Red\n")
        out 1
    end

    # --- 3. typecheck_enum_is_tagged ---
    let enum_ast = ast_new(AstType.EnumDef)
    enum_ast.name = fat_str_new("Color")
    let v1 = ast_new(AstType.Identifier)
    v1.name = fat_str_new("Red")
    ast_add_child(enum_ast, v1)
    if typecheck_enum_is_tagged(enum_ast) != false do
        print_str("FAIL: plain enum wrongly recognized as tagged\n")
        out 1
    end

    let v2 = ast_new(AstType.Identifier)
    v2.name = fat_str_new("Custom")
    v2.builtin_id = 1
    ast_add_child(enum_ast, v2)
    if typecheck_enum_is_tagged(enum_ast) != true do
        print_str("FAIL: tagged enum variant not recognized as tagged\n")
        out 1
    end

    print_str("ALL ENUM/PATTERN FIXTURES PASS\n")
    out 0
end.
