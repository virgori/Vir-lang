include string_rt

include typecheck_entities

func main():
    # --- 1. typecheck_is_valid_packed_primitive ---
    if typecheck_is_valid_packed_primitive(fat_str_new("u8")) != 1 do
        print_str("FAIL: u8 not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("i16")) != 1 do
        print_str("FAIL: i16 not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("u32")) != 1 do
        print_str("FAIL: u32 not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("i64")) != 1 do
        print_str("FAIL: i64 not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("bool")) != 1 do
        print_str("FAIL: bool not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("float")) != 1 do
        print_str("FAIL: float not recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("string")) != 0 do
        print_str("FAIL: string wrongly recognized as packed primitive\n")
        out 1
    end
    if typecheck_is_valid_packed_primitive(fat_str_new("MyStruct")) != 0 do
        print_str("FAIL: MyStruct wrongly recognized as packed primitive\n")
        out 1
    end

    # --- 2. typecheck_register_base_bits ---
    if typecheck_register_base_bits(fat_str_new("u8")) != 8 do
        print_str("FAIL: u8 bits != 8\n")
        out 1
    end
    if typecheck_register_base_bits(fat_str_new("i16")) != 16 do
        print_str("FAIL: i16 bits != 16\n")
        out 1
    end
    if typecheck_register_base_bits(fat_str_new("u32")) != 32 do
        print_str("FAIL: u32 bits != 32\n")
        out 1
    end
    if typecheck_register_base_bits(fat_str_new("int")) != 64 do
        print_str("FAIL: int bits != 64\n")
        out 1
    end
    if typecheck_register_base_bits(fat_str_new("unknown")) != 0 do
        print_str("FAIL: unknown bits != 0\n")
        out 1
    end

    print_str("ALL ENTITY/PACKED FIXTURES PASS\n")
    out 0
end.
