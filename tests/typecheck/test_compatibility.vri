##
 * tests/typecheck/test_compatibility.vri — Compatibility Service Unit Test
 * =========================================================================
 * Positive, negative, and anti-fallback contract verification for
 * Phase 7 compatibility service.
 ##

include string_rt
import fat_str_new, fat_str_eq, print_int, print_str from string_rt

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.symbol_table
import symbol_table_new from virc.semantic.symbol_table

include virc.semantic.scope_tree
import scope_tree_new from virc.semantic.scope_tree

include virc.semantic.typecheck.compatibility
import TypeCompatKind,
       typecheck_unwrap_type_name, typecheck_extract_base_name,
       typecheck_is_array_type_str, typecheck_extract_generic_or_array_elem,
       typecheck_is_integer_like, typecheck_check_compatibility,
       typecheck_types_compatible, typecheck_ufcs_types_compatible,
       typecheck_param_types_compatible, typecheck_type_strings_compatible from virc.semantic.typecheck.compatibility

func main() -> int:
    var symbols = symbol_table_new()
    var scopes = scope_tree_new()

    # 1. Positive: exact match
    let res_exact = typecheck_check_compatibility(TypeKind.Int as i64, TypeKind.Int)
    if res_exact != TypeCompatKind.Exact do
        print_str("FAIL: expected Int and Int to be Exact\n")
        out 1
    end

    # 2. Positive: numeric widening (int to float)
    let res_wide = typecheck_check_compatibility(TypeKind.Float as i64, TypeKind.Int)
    if res_wide != TypeCompatKind.AllowedConversion do
        print_str("FAIL: expected Int into Float to be AllowedConversion\n")
        out 2
    end

    # 3. Negative: bool into float is incompatible
    let res_incompat = typecheck_check_compatibility(TypeKind.Float as i64, TypeKind.Bool)
    if res_incompat != TypeCompatKind.Incompatible do
        print_str("FAIL: expected Bool into Float to be Incompatible\n")
        out 3
    end

    # 4. Anti-fallback: param type compatibility strictly isolates bool and int
    let bool_as_int = typecheck_param_types_compatible(TypeKind.Int as i64, TypeKind.Bool as i64)
    if bool_as_int != 0 do
        print_str("FAIL: anti-fallback violated, Bool accepted as Int param\n")
        out 4
    end

    let int_as_bool = typecheck_param_types_compatible(TypeKind.Bool as i64, TypeKind.Int as i64)
    if int_as_bool != 0 do
        print_str("FAIL: anti-fallback violated, Int accepted as Bool param\n")
        out 5
    end

    # 5. Type string unwrapping
    let ref_ty = fat_str_new("&mut int")
    let un_ty = typecheck_unwrap_type_name(ref_ty)
    if fat_str_eq(un_ty, fat_str_new("int")) != 1 do
        print_str("FAIL: unwrap &mut int failed\n")
        out 6
    end

    # 6. Base name extraction
    let vec_ty = fat_str_new("Vec<int>")
    let base_name = typecheck_extract_base_name(vec_ty)
    if fat_str_eq(base_name, fat_str_new("Vec")) != 1 do
        print_str("FAIL: base name of Vec<int> failed\n")
        out 7
    end

    # 7. Array element extraction
    let arr_ty = fat_str_new("[string]")
    let is_arr = typecheck_is_array_type_str(arr_ty)
    if is_arr == false do
        print_str("FAIL: is_array_type_str on [string] failed\n")
        out 8
    end
    let elem_ty = typecheck_extract_generic_or_array_elem(arr_ty)
    if fat_str_eq(elem_ty, fat_str_new("string")) != 1 do
        print_str("FAIL: extract elem of [string] failed\n")
        out 9
    end

    # 8. Type strings compatibility
    let s1 = fat_str_new("[int]")
    let s2 = fat_str_new("[int]")
    let s3 = fat_str_new("[string]")
    if typecheck_type_strings_compatible(symbols, scopes, s1, s2) != 1 do
        print_str("FAIL: [int] should match [int]\n")
        out 10
    end
    if typecheck_type_strings_compatible(symbols, scopes, s1, s3) != 0 do
        print_str("FAIL: [int] should NOT match [string]\n")
        out 11
    end

    print_str("ALL COMPATIBILITY FIXTURES PASS\n")
    out 0
end.
