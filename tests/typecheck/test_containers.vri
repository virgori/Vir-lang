include string_rt
include typecheck_containers

func main():
    # --- 1. typecheck_format_array_type_str ---
    let s_int = typecheck_format_array_type_str(fat_str_new("int"))
    if fat_str_eq(s_int, fat_str_new("[int]")) != 1 do
        print_str("FAIL: array type != [int]\n")
        out 1
    end

    let s_empty = typecheck_format_array_type_str(fat_str_new(""))
    if fat_str_eq(s_empty, fat_str_new("[]")) != 1 do
        print_str("FAIL: empty array type != []\n")
        out 1
    end

    # --- 2. typecheck_dict_key_expr_type ---
    let id_ast = ast_new(AstType.Identifier)
    id_ast.name = fat_str_new("k")
    let ty_override = typecheck_dict_key_expr_type(id_ast, fat_str_new("string"), TypeKind.Int)
    if ty_override != TypeKind.String do
        print_str("FAIL: dict key string override failed\n")
        out 1
    end

    let ty_norm = typecheck_dict_key_expr_type(id_ast, fat_str_new("int"), TypeKind.Int)
    if ty_norm != TypeKind.Int do
        print_str("FAIL: dict key normal type failed\n")
        out 1
    end

    print_str("ALL CONTAINER FIXTURES PASS\n")
    out 0
end.
