include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

include string_rt
import fat_str_len, fat_str_eq, fat_str_new, fat_cstr_eq, print_str from string_rt

include virc.frontend.parser

include virc.semantic.typecheck.context
import TypecheckContext, typecheck_context_new from virc.semantic.typecheck.context

include virc.semantic.typecheck.calls
import typecheck_count_callable_params, typecheck_callable_param_type,
       typecheck_callable_return_type, typecheck_is_lowlevel_call_or_param from virc.semantic.typecheck.calls

include virc.semantic.typecheck.methods
import typecheck_find_entity_method, typecheck_find_entity_field,
       typecheck_entity_has_field, typecheck_method_param_count,
       typecheck_method_has_this from virc.semantic.typecheck.methods

func make_node(nt: AstType, name_str: &string) -> AstNode:
    out AstNode (
        name: name_str,
        name2: fat_str_new(""),
        node_type: nt,
        op: OpType.Add,
        line: 1,
        int_val: 0,
        float_val: 0.0,
        builtin_id: 0,
        children: vec_new_rt(),
        span_id: 0
    )
end.

func main():
    # --- 1. Callable parameter count tests ---
    let c1 = fat_str_new("func(int, string) -> bool")
    let cnt1 = typecheck_count_callable_params(c1)
    if cnt1 != 2 do
        print_str("FAIL: cnt1 expected 2\n")
        out 1
    end

    let c0 = fat_str_new("func() -> void")
    let cnt0 = typecheck_count_callable_params(c0)
    if cnt0 != 0 do
        print_str("FAIL: cnt0 expected 0\n")
        out 1
    end

    let c3 = fat_str_new("func(a, b, c)int")
    let cnt3 = typecheck_count_callable_params(c3)
    if cnt3 != 3 do
        print_str("FAIL: cnt3 expected 3\n")
        out 1
    end

    # Negative: invalid callable strings
    let c_bad1 = fat_str_new("")
    if typecheck_count_callable_params(c_bad1) != -1 do
        print_str("FAIL: empty string should be -1\n")
        out 1
    end
    let c_bad2 = fat_str_new("int")
    if typecheck_count_callable_params(c_bad2) != -1 do
        print_str("FAIL: 'int' should be -1\n")
        out 1
    end

    # --- 2. Callable parameter type extraction tests ---
    let p0 = typecheck_callable_param_type(c1, 0)
    if fat_cstr_eq(p0, "int") != 1 do
        print_str("FAIL: param 0 should be int\n")
        out 1
    end

    let p1 = typecheck_callable_param_type(c1, 1)
    if fat_cstr_eq(p1, "string") != 1 do
        print_str("FAIL: param 1 should be string\n")
        out 1
    end

    let p2 = typecheck_callable_param_type(c1, 2)
    if fat_str_len(p2) != 0 do
        print_str("FAIL: param 2 out of range should be empty\n")
        out 1
    end

    # --- 3. Callable return type extraction tests ---
    let c_arrow = fat_str_new("func(int) -> Box")
    let ret_arrow = typecheck_callable_return_type(c_arrow)
    if fat_cstr_eq(ret_arrow, "Box") != 1 do
        print_str("FAIL: ret_arrow should be Box\n")
        out 1
    end

    let c_compact = fat_str_new("func(int)Box")
    let ret_compact = typecheck_callable_return_type(c_compact)
    if fat_cstr_eq(ret_compact, "Box") != 1 do
        print_str("FAIL: ret_compact should be Box\n")
        out 1
    end

    let ret0 = typecheck_callable_return_type(c0)
    if fat_cstr_eq(ret0, "void") != 1 do
        print_str("FAIL: ret0 should be void\n")
        out 1
    end

    # --- 4. Low-level call & param detection ---
    let call_rt = fat_str_new("rt_strlen")
    let param_s = fat_str_new("s")
    if typecheck_is_lowlevel_call_or_param(call_rt, param_s) != 1 do
        print_str("FAIL: rt_strlen should be lowlevel\n")
        out 1
    end

    let call_user = fat_str_new("calculate_total")
    let param_user = fat_str_new("order")
    if typecheck_is_lowlevel_call_or_param(call_user, param_user) != 0 do
        print_str("FAIL: user call should not be lowlevel\n")
        out 1
    end

    # --- 5. Entity method & field resolution tests ---
    var ent = make_node(AstType.EntityDef, fat_str_new("MyEntity"))

    # Add field "count"
    var fld1 = make_node(AstType.VarDecl, fat_str_new("count"))
    ent.children = vec_push_rt(ent.children, fld1 as i64)

    # Add method "calc" with "this", "x", and a Block body
    var m_calc = make_node(AstType.FuncDef, fat_str_new("calc"))
    var p_this = make_node(AstType.ParamDef, fat_str_new("this"))
    var p_x = make_node(AstType.ParamDef, fat_str_new("x"))
    var blk = make_node(AstType.Block, fat_str_new("body"))
    m_calc.children = vec_push_rt(m_calc.children, p_this as i64)
    m_calc.children = vec_push_rt(m_calc.children, p_x as i64)
    m_calc.children = vec_push_rt(m_calc.children, blk as i64)
    ent.children = vec_push_rt(ent.children, m_calc as i64)

    # Test method lookup
    let m_found = typecheck_find_entity_method(ent, fat_str_new("calc"))
    if (m_found as i64) == 0 do
        print_str("FAIL: calc method not found\n")
        out 1
    end

    # Test method has this
    if typecheck_method_has_this(m_found) != 1 do
        print_str("FAIL: calc should have this param\n")
        out 1
    end

    # Test method param count (should be 2: this, x before Block)
    if typecheck_method_param_count(m_found) != 2 do
        print_str("FAIL: calc param count should be 2\n")
        out 1
    end

    # Test negative method lookup
    let m_missing = typecheck_find_entity_method(ent, fat_str_new("nonexistent"))
    if (m_missing as i64) != 0 do
        print_str("FAIL: nonexistent method should return 0\n")
        out 1
    end

    # Test field lookup
    if typecheck_entity_has_field(ent, fat_str_new("count")) != 1 do
        print_str("FAIL: entity should have field count\n")
        out 1
    end
    if typecheck_entity_has_field(ent, fat_str_new("missing_field")) != 0 do
        print_str("FAIL: missing_field should not be found\n")
        out 1
    end

    print_str("ALL CALLS AND METHODS FIXTURES PASS\n")
    out 0
end.
