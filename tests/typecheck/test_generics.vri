include string_rt
import fat_str_new, fat_str_eq, print_str from string_rt

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.typecheck.generics
import typecheck_count_list_items, typecheck_get_list_item,
       typecheck_extract_first_generic_arg, typecheck_extract_second_generic_arg,
       typecheck_extract_generic_args_content, typecheck_substitute_generic_type,
       typecheck_is_in_generic_params, typecheck_check_enum_generic_arg_rule from virc.semantic.typecheck.generics

func main():
    # --- 1. count_list_items ---
    let s_empty = fat_str_new("")
    let s_one = fat_str_new("T")
    let s_two = fat_str_new("T, U")
    let s_nested = fat_str_new("Map<K, V>, Vec<T>")

    if typecheck_count_list_items(s_empty) != 0 do
        print_str("FAIL: empty list count != 0\n")
        out 1
    end
    if typecheck_count_list_items(s_one) != 1 do
        print_str("FAIL: single item count != 1\n")
        out 1
    end
    if typecheck_count_list_items(s_two) != 2 do
        print_str("FAIL: two items count != 2\n")
        out 1
    end
    if typecheck_count_list_items(s_nested) != 2 do
        print_str("FAIL: nested items count != 2\n")
        out 1
    end

    # --- 2. get_list_item ---
    let it0 = typecheck_get_list_item(s_two, 0)
    let it1 = typecheck_get_list_item(s_two, 1)
    if fat_str_eq(it0, fat_str_new("T")) != 1 do
        print_str("FAIL: item 0 should be T\n")
        out 1
    end
    if fat_str_eq(it1, fat_str_new("U")) != 1 do
        print_str("FAIL: item 1 should be U\n")
        out 1
    end

    # --- 3. extract first & second generic arg ---
    let opt_t = fat_str_new("Option<int>")
    let res_t = fat_str_new("Result<string, int>")
    let fst_opt = typecheck_extract_first_generic_arg(opt_t)
    let fst_res = typecheck_extract_first_generic_arg(res_t)
    let snd_res = typecheck_extract_second_generic_arg(res_t)

    if fat_str_eq(fst_opt, fat_str_new("int")) != 1 do
        print_str("FAIL: Option<int> first arg != int\n")
        out 1
    end
    if fat_str_eq(fst_res, fat_str_new("string")) != 1 do
        print_str("FAIL: Result<string, int> first arg != string\n")
        out 1
    end
    if fat_str_eq(snd_res, fat_str_new("int")) != 1 do
        print_str("FAIL: Result<string, int> second arg != int\n")
        out 1
    end

    # --- 4. extract generic args content ---
    let map_t = fat_str_new("Map<string, int>")
    let map_args = typecheck_extract_generic_args_content(map_t)
    if fat_str_eq(map_args, fat_str_new("string, int")) != 1 do
        print_str("FAIL: Map args content != string, int\n")
        out 1
    end

    # --- 5. substitute generic type ---
    let p_t = fat_str_new("T")
    let a_int = fat_str_new("int")
    let s_exact = typecheck_substitute_generic_type(p_t, a_int, p_t)
    if fat_str_eq(s_exact, a_int) != 1 do
        print_str("FAIL: exact subst != int\n")
        out 1
    end

    let target_compound = fat_str_new("Vec of (T)")
    let s_compound = typecheck_substitute_generic_type(p_t, a_int, target_compound)
    if fat_str_eq(s_compound, fat_str_new("Vec of (int)")) != 1 do
        print_str("FAIL: compound subst != Vec of (int)\n")
        out 1
    end

    # --- 6. is_in_generic_params ---
    let g_params = fat_str_new("T, U")
    if not typecheck_is_in_generic_params(g_params, fat_str_new("T")) do
        print_str("FAIL: T should be in T, U\n")
        out 1
    end
    if not typecheck_is_in_generic_params(g_params, fat_str_new("U")) do
        print_str("FAIL: U should be in T, U\n")
        out 1
    end
    if typecheck_is_in_generic_params(g_params, fat_str_new("V")) do
        print_str("FAIL: V should not be in T, U\n")
        out 1
    end

    # --- 7. enum generic arg rule ---
    let v_some = fat_str_new("Some")
    let v_ok = fat_str_new("Ok")
    let v_err = fat_str_new("Err")

    # Option<int> Some(int) -> OK (0)
    if typecheck_check_enum_generic_arg_rule(opt_t, v_some, TypeKind.Int) != 0 do
        print_str("FAIL: Option<int> Some(int) should be 0\n")
        out 1
    end
    # Option<int> Some(string) -> Error (3042)
    if typecheck_check_enum_generic_arg_rule(opt_t, v_some, TypeKind.String) != 3042 do
        print_str("FAIL: Option<int> Some(string) should be 3042\n")
        out 1
    end

    # Result<string, int> Ok(string) -> OK (0)
    if typecheck_check_enum_generic_arg_rule(res_t, v_ok, TypeKind.String) != 0 do
        print_str("FAIL: Result Ok(string) should be 0\n")
        out 1
    end
    # Result<string, int> Err(int) -> OK (0)
    if typecheck_check_enum_generic_arg_rule(res_t, v_err, TypeKind.Int) != 0 do
        print_str("FAIL: Result Err(int) should be 0\n")
        out 1
    end
    # Result<string, int> Err(float) -> Error (3042)
    if typecheck_check_enum_generic_arg_rule(res_t, v_err, TypeKind.Float) != 3042 do
        print_str("FAIL: Result Err(float) should be 3042\n")
        out 1
    end

    print_str("ALL GENERIC FIXTURES PASS\n")
    out 0
end.
