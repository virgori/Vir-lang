include string_rt
import fat_str_new, print_str from string_rt

include virc.frontend.parser

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.typecheck.operators
import typecheck_is_logic_bit_operand, typecheck_check_binop_types,
       typecheck_eval_const_binop from virc.semantic.typecheck.operators

func main():
    # --- 1. Logic/Bit Operand Verification ---
    if typecheck_is_logic_bit_operand(TypeKind.Bool) != 1 do
        print_str("FAIL: Bool should be logic_bit operand\n")
        out 1
    end
    if typecheck_is_logic_bit_operand(TypeKind.Int) != 1 do
        print_str("FAIL: Int should be logic_bit operand\n")
        out 1
    end
    if typecheck_is_logic_bit_operand(TypeKind.Float) != 0 do
        print_str("FAIL: Float should NOT be logic_bit operand\n")
        out 1
    end
    if typecheck_is_logic_bit_operand(TypeKind.String) != 0 do
        print_str("FAIL: String should NOT be logic_bit operand\n")
        out 1
    end

    # --- 2. String Concatenation & Non-Add Rules ---
    # String + String -> OK
    if typecheck_check_binop_types(OpType.Add as int, TypeKind.String, TypeKind.String) != 0 do
        print_str("FAIL: String + String should be OK\n")
        out 1
    end
    # String + Int -> OK
    if typecheck_check_binop_types(OpType.Add as int, TypeKind.String, TypeKind.Int) != 0 do
        print_str("FAIL: String + Int should be OK\n")
        out 1
    end
    # String + Float -> E3001
    if typecheck_check_binop_types(OpType.Add as int, TypeKind.String, TypeKind.Float) != 3001 do
        print_str("FAIL: String + Float should be 3001\n")
        out 1
    end
    # String * String -> E3001 (non-Add)
    if typecheck_check_binop_types(OpType.Mul as int, TypeKind.String, TypeKind.String) != 3001 do
        print_str("FAIL: String * String should be 3001\n")
        out 1
    end

    # --- 3. Bool Arithmetic Prohibition & Logical Allowed ---
    # Bool + Int -> OK (runtime bridging)
    if typecheck_check_binop_types(OpType.Add as int, TypeKind.Bool, TypeKind.Int) != 0 do
        print_str("FAIL: Bool + Int should be OK\n")
        out 1
    end
    # Bool + Float -> E3002
    if typecheck_check_binop_types(OpType.Add as int, TypeKind.Bool, TypeKind.Float) != 3002 do
        print_str("FAIL: Bool + Float should be 3002\n")
        out 1
    end
    # Bool == Bool -> OK
    if typecheck_check_binop_types(OpType.Eq as int, TypeKind.Bool, TypeKind.Bool) != 0 do
        print_str("FAIL: Bool == Bool should be OK\n")
        out 1
    end

    # --- 4. Bitwise Shift & Logical Operator Rules ---
    # Shl on Int, Int -> OK
    if typecheck_check_binop_types(OpType.ShlOp as int, TypeKind.Int, TypeKind.Int) != 0 do
        print_str("FAIL: Int << Int should be OK\n")
        out 1
    end
    # Shl on Int, Float -> E3006
    if typecheck_check_binop_types(OpType.ShlOp as int, TypeKind.Int, TypeKind.Float) != 3006 do
        print_str("FAIL: Int << Float should be 3006\n")
        out 1
    end
    # AndOp on Bool, Bool -> OK
    if typecheck_check_binop_types(OpType.AndOp as int, TypeKind.Bool, TypeKind.Bool) != 0 do
        print_str("FAIL: Bool & Bool should be OK\n")
        out 1
    end
    # AndOp on Int, Float -> E3006
    if typecheck_check_binop_types(OpType.AndOp as int, TypeKind.Int, TypeKind.Float) != 3006 do
        print_str("FAIL: Int & Float should be 3006\n")
        out 1
    end

    # --- 5. Constant Binary Operator Evaluation ---
    var (ok_add, v_add) = typecheck_eval_const_binop(OpType.Add as int, 10, 20)
    if ok_add != 1 or v_add != 30 do
        print_str("FAIL: 10 + 20 should be 30\n")
        out 1
    end

    var (ok_sub, v_sub) = typecheck_eval_const_binop(OpType.Sub as int, 10, 4)
    if ok_sub != 1 or v_sub != 6 do
        print_str("FAIL: 10 - 4 should be 6\n")
        out 1
    end

    var (ok_mul, v_mul) = typecheck_eval_const_binop(OpType.Mul as int, 5, 6)
    if ok_mul != 1 or v_mul != 30 do
        print_str("FAIL: 5 * 6 should be 30\n")
        out 1
    end

    var (ok_div, v_div) = typecheck_eval_const_binop(OpType.Div as int, 30, 5)
    if ok_div != 1 or v_div != 6 do
        print_str("FAIL: 30 / 5 should be 6\n")
        out 1
    end

    var (ok_div0, v_div0) = typecheck_eval_const_binop(OpType.Div as int, 30, 0)
    if ok_div0 != 0 do
        print_str("FAIL: division by zero should return 0\n")
        out 1
    end

    var (ok_mod, v_mod) = typecheck_eval_const_binop(OpType.ModOp as int, 10, 3)
    if ok_mod != 1 or v_mod != 1 do
        print_str("FAIL: 10 mod 3 should be 1\n")
        out 1
    end

    print_str("ALL OPERATOR FIXTURES PASS\n")
    out 0
end.
