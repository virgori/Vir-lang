include string_rt
import fat_str_new, print_str from string_rt

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.typecheck.tensor
import typecheck_check_quantize_bits, typecheck_check_quantize_val,
       typecheck_check_matmul_dimensions from virc.semantic.typecheck.tensor

func main():
    # --- 1. Quantize bit validation ---
    if typecheck_check_quantize_bits(4) != 0 do
        print_str("FAIL: bits 4 should be valid\n")
        out 1
    end
    if typecheck_check_quantize_bits(8) != 0 do
        print_str("FAIL: bits 8 should be valid\n")
        out 1
    end
    if typecheck_check_quantize_bits(16) != 0 do
        print_str("FAIL: bits 16 should be valid\n")
        out 1
    end
    if typecheck_check_quantize_bits(32) != 0 do
        print_str("FAIL: bits 32 should be valid\n")
        out 1
    end
    if typecheck_check_quantize_bits(7) != 3019 do
        print_str("FAIL: bits 7 should be invalid (3019)\n")
        out 1
    end
    if typecheck_check_quantize_bits(64) != 3019 do
        print_str("FAIL: bits 64 should be invalid (3019)\n")
        out 1
    end

    # --- 2. Quantize value validation ---
    let valid_t = fat_str_new("tensor [f32; 2, 2]")
    if typecheck_check_quantize_val(TypeKind.Tensor, valid_t) != 0 do
        print_str("FAIL: valid tensor should pass quantize check\n")
        out 1
    end
    if typecheck_check_quantize_val(TypeKind.Int, valid_t) != 3018 do
        print_str("FAIL: non-tensor value should be 3018\n")
        out 1
    end
    let invalid_elem_t = fat_str_new("tensor [int; 2, 2]")
    if typecheck_check_quantize_val(TypeKind.Tensor, invalid_elem_t) != 3018 do
        print_str("FAIL: non-float tensor should be 3018\n")
        out 1
    end

    # --- 3. Matmul dimension validation ---
    let t_a = fat_str_new("tensor [f32; 2, 3]")
    let t_b = fat_str_new("tensor [f32; 3, 4]")
    let t_c = fat_str_new("tensor [f32; 5, 4]")

    # Matching inner dimension: [2, 3] x [3, 4] -> OK (0)
    if typecheck_check_matmul_dimensions(t_a, t_b, TypeKind.Tensor, TypeKind.Tensor, 0) != 0 do
        print_str("FAIL: [2, 3] x [3, 4] should be OK\n")
        out 1
    end

    # Mismatched inner dimension: [2, 3] x [5, 4] -> E3014
    if typecheck_check_matmul_dimensions(t_a, t_c, TypeKind.Tensor, TypeKind.Tensor, 0) != 3014 do
        print_str("FAIL: [2, 3] x [5, 4] should be 3014\n")
        out 1
    end

    # Quantized tensor in non-AI mode -> E3023
    let q_a = fat_str_new("quantized[uniform; f32; bits=8; 2, 3]")
    let q_b = fat_str_new("quantized[uniform; f32; bits=8; 3, 4]")
    if typecheck_check_matmul_dimensions(q_a, q_b, TypeKind.QuantizedTensor, TypeKind.QuantizedTensor, 0) != 3023 do
        print_str("FAIL: Quantized in mode 0 should be 3023\n")
        out 1
    end

    # Quantized tensor in AI mode (mode 1) -> OK (0)
    if typecheck_check_matmul_dimensions(q_a, q_b, TypeKind.QuantizedTensor, TypeKind.QuantizedTensor, 1) != 0 do
        print_str("FAIL: Quantized in mode 1 should be OK\n")
        out 1
    end

    print_str("ALL TENSOR FIXTURES PASS\n")
    out 0
end.
