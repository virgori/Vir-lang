##
 * tests/typecheck/test_inference.vri — Inference Service Unit Test
 * ================================================================
 * Positive, negative, and anti-fallback contract verification for
 * Phase 7 inference service.
 ##

include string_rt
import fat_str_new, fat_str_eq, print_int, print_str from string_rt

include vec_rt
import vec_new_rt from vec_rt

include virc.frontend.parser

include virc.semantic.type_table
import TypeKind from virc.semantic.type_table

include virc.semantic.typecheck.inference
import typecheck_infer_literal, typecheck_infer_binop,
       typecheck_call_returns_first_arg, typecheck_infer_builtin_call_return,
       typecheck_find_return_stmt_uncached, typecheck_find_param_type_name,
       typecheck_find_local_decl_in_node from virc.semantic.typecheck.inference

func make_node(t: AstType) -> AstNode:
    out AstNode (
        name: fat_str_new(""),
        name2: fat_str_new(""),
        node_type: t,
        op: OpType.Add,
        line: 1,
        int_val: 0,
        float_val: 0.0,
        builtin_id: 0,
        children: vec_new_rt(),
        span_id: 0
    )
end.

func main() -> int:
    # 1. Positive: Literal inference
    let int_node = make_node(AstType.LiteralInt)
    if typecheck_infer_literal(int_node) != TypeKind.Int do
        print_str("FAIL: LiteralInt inference\n")
        out 1
    end

    let float_node = make_node(AstType.LiteralFloat)
    if typecheck_infer_literal(float_node) != TypeKind.Float do
        print_str("FAIL: LiteralFloat inference\n")
        out 2
    end

    let str_node = make_node(AstType.LiteralStr)
    if typecheck_infer_literal(str_node) != TypeKind.String do
        print_str("FAIL: LiteralStr inference\n")
        out 3
    end

    let bool_node = make_node(AstType.LiteralBool)
    if typecheck_infer_literal(bool_node) != TypeKind.Bool do
        print_str("FAIL: LiteralBool inference\n")
        out 4
    end

    # 2. Positive: BinOp inference
    # Arithmetic: int + int -> int
    let add_int = typecheck_infer_binop(TypeKind.Int, TypeKind.Int, OpType.Add as int, 0)
    if add_int != TypeKind.Int do
        print_str("FAIL: Int + Int should be Int\n")
        out 5
    end

    # Widening: int + float -> float
    let add_float = typecheck_infer_binop(TypeKind.Int, TypeKind.Float, OpType.Add as int, 0)
    if add_float != TypeKind.Float do
        print_str("FAIL: Int + Float should be Float\n")
        out 6
    end

    # Comparison: int == int -> bool
    let cmp_eq = typecheck_infer_binop(TypeKind.Int, TypeKind.Int, OpType.Eq as int, 0)
    if cmp_eq != TypeKind.Bool do
        print_str("FAIL: Int == Int should be Bool\n")
        out 7
    end

    # MatMul -> Tensor
    let matmul = typecheck_infer_binop(TypeKind.Tensor, TypeKind.Tensor, OpType.MatMulOp as int, 0)
    if matmul != TypeKind.Tensor do
        print_str("FAIL: Tensor @ Tensor should be Tensor\n")
        out 8
    end

    # 3. Positive: Builtin call return inference
    let read_fn = fat_str_new("native_read_i64")
    if typecheck_infer_builtin_call_return(read_fn) != TypeKind.Int do
        print_str("FAIL: native_read_i64 should return Int\n")
        out 9
    end

    let streq_fn = fat_str_new("fat_str_eq")
    if typecheck_infer_builtin_call_return(streq_fn) != TypeKind.Bool do
        print_str("FAIL: fat_str_eq should return Bool\n")
        out 10
    end

    let strnew_fn = fat_str_new("fat_str_new")
    if typecheck_infer_builtin_call_return(strnew_fn) != TypeKind.String do
        print_str("FAIL: fat_str_new should return String\n")
        out 11
    end

    # 4. Negative: Unknown builtin returns Void
    let unknown_fn = fat_str_new("custom_user_function_xyz")
    if typecheck_infer_builtin_call_return(unknown_fn) != TypeKind.Void do
        print_str("FAIL: unknown builtin should return Void\n")
        out 12
    end

    # 5. Anti-fallback: Bitwise logic
    # bool and bool -> bool
    let bit_bool = typecheck_infer_binop(TypeKind.Bool, TypeKind.Bool, OpType.AndOp as int, 0)
    if bit_bool != TypeKind.Bool do
        print_str("FAIL: Bool and Bool should be Bool\n")
        out 13
    end

    # int and bool -> int (not bool!)
    let bit_mixed = typecheck_infer_binop(TypeKind.Int, TypeKind.Bool, OpType.AndOp as int, 0)
    if bit_mixed != TypeKind.Int do
        print_str("FAIL: Int and Bool should be Int\n")
        out 14
    end

    # 6. Returns-first-arg check
    if typecheck_call_returns_first_arg("vec_push_rt" as int as i64) != 1 do
        print_str("FAIL: vec_push_rt should return first arg\n")
        out 15
    end
    if typecheck_call_returns_first_arg("other_func" as int as i64) != 0 do
        print_str("FAIL: other_func should not return first arg\n")
        out 16
    end

    print_str("ALL INFERENCE FIXTURES PASS\n")
    out 0
end.
