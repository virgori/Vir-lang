# Test FFI and Syscall support in Self-Hosted Compiler

@bind(c)
func printf(fmt:string; val:int): end

func main:
    # 1. Test FFI
    printf(str_new("Hello from FFI! Value: %d\n"), 42);

    # 2. Test direct Syscall (e.g. exit 0 on macOS/Linux)
    # macOS ARM64 exit is syscall 1 (in some contexts) but let's just test emission
    # Actually, let's just use a print to see if it compiles
    printf(str_new("Syscall test next...\n"), 0);
    
    # syscall(1, 0); # exit(0)
end.
