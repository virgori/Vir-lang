# Interactive smoke: cli + io (calculator)
# Build:  ./bin/virc tests/test_calc_cli_io.vri -o /tmp/calc
# Run:    printf '7\n3\n+\n' | /tmp/calc

include stdio
include cli
include string_rt
import rt_itoa from string_rt

func calc_is_int(s: string) -> bool:
    let p = stdio_cstr(s)
    let n = stdio_len_p(p)
    if n == 0 do out false end
    var i = 0
    let c0 = stdio_byte_p(p, 0)
    if c0 == 45 || c0 == 43 do
        i = 1
    end
    if i >= n do out false end
    var any = false
    when i < n loop
        let c = stdio_byte_p(p, i)
        if c < 48 || c > 57 do out false end
        any = true
        i = i + 1
    end
    out any
end.

func calc_is_zero_lit(s: string) -> bool:
    let p = stdio_cstr(s)
    let n = stdio_len_p(p)
    if n == 0 do out false end
    var i = 0
    let c0 = stdio_byte_p(p, 0)
    if c0 == 45 || c0 == 43 do
        i = 1
    end
    if i >= n do out false end
    when i < n loop
        if stdio_byte_p(p, i) != 48 do out false end
        i = i + 1
    end
    out true
end.

func calc_abs(x: int) -> int:
    if x < 0 do out 0 - x end
    out x
end.

func calc_mul_ok(a: int, b: int) -> bool:
    if a == 0 || b == 0 do out true end
    let lim = 9223372036854775807
    let aa = calc_abs(a)
    let bb = calc_abs(b)
    if aa > lim / bb do out false end
    out true
end.

func calc_add_ok(a: int, b: int) -> bool:
    let lim = 9223372036854775807
    if b > 0 do
        if a > lim - b do out false end
    end
    if b < 0 do
        let mn = 0 - lim - 1
        if a < mn - b do out false end
    end
    out true
end.

func calc_sub_ok(a: int, b: int) -> bool:
    out calc_add_ok(a, 0 - b)
end.

func calc_op_byte(s: string) -> int:
    let p = stdio_cstr(s)
    let n = stdio_len_p(p)
    var i = 0
    when i < n & (stdio_byte_p(p, i) == 32 || stdio_byte_p(p, i) == 9) loop
        i = i + 1
    end
    if i >= n do out 0 end
    if i + 1 != n do out 0 end
    out stdio_byte_p(p, i)
end.

func main:
    io.println("May tinh (cli + io)")
    io.println("Phep: +  -  *  /")

    let sa = cli.ask("So A: ")
    let sb = cli.ask("So B: ")
    let sop = cli.ask("Phep: ")

    if calc_is_int(sa) == false || calc_is_int(sb) == false do
        io.eprintln("Loi: so khong hop le")
        io.println("Bye.")
        out 0
    end

    let a = parse_int(sa)
    let b = parse_int(sb)
    if a == 0 & calc_is_zero_lit(sa) == false do
        io.eprintln("Loi: so khong hop le")
        io.println("Bye.")
        out 0
    end
    if b == 0 & calc_is_zero_lit(sb) == false do
        io.eprintln("Loi: so khong hop le")
        io.println("Bye.")
        out 0
    end
    let op = calc_op_byte(sop)

    var
        result = 0
        ok = true

    if op == 43 do
        if calc_add_ok(a, b) == false do
            io.eprintln("Loi: tran so")
            ok = false
        else
            result = a + b
        end
    eif op == 45 do
        if calc_sub_ok(a, b) == false do
            io.eprintln("Loi: tran so")
            ok = false
        else
            result = a - b
        end
    eif op == 42 do
        if calc_mul_ok(a, b) == false do
            io.eprintln("Loi: tran so")
            ok = false
        else
            result = a * b
        end
    eif op == 47 do
        if b == 0 do
            io.eprintln("Loi: chia cho 0")
            ok = false
        else
            result = a / b
        end
    else
        io.eprintln("Phep khong hop le")
        ok = false
    end

    if ok do
        io.print("Ket qua: ")
        io.println(cstr_to_str(rt_itoa(result)))
    end

    io.println("Bye.")
    out 0
end.
