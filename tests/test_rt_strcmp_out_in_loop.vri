func rt_strcmp:
    in(a: int, b: int)
    let i = 0
    when true loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do
            out ca - cb
        end
        if ca == 0 do
            out 0
        end
        i = i + 1
    end
    out 0
end.

extern func native_read_u8(addr: int, offset: int) -> int;

func main:
    let r = rt_strcmp("abc", "abc")
    print r
end.
