# test_adv_026: Constant folding verification
# Expected: 7, 42, 100

func main:
    # 1 + 2 * 3 should fold to 7 at compile time
    var a = 1 + 2 * 3
    print a

    # 6 * 7 should fold
    var b = 6 * 7
    print b

    # Nested: (2 + 3) * (4 + 6) * 2
    var c = (2 + 3) * (4 + 6) * 2
    print c
end.