# ═════════════════════════════════════════════════════════════════════
# tests/types/narrow_cast_test.vri — Native Narrow Cast Verification
# Governed by VIRC-ISS-0050 / VIRC-PLN-0029 Phase 3 (Gate Nhóm 16)
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_concat3(a: int, b: int, c: int) -> int:
    out s_concat2(s_concat2(a, b), c)
end.

func s_concat4(a: int, b: int, c: int, d: int) -> int:
    out s_concat2(s_concat3(a, b, c), d)
end.

func s_find_str(haystack: int, needle: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 524288 # 512KB
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func sys_trim(s: int) -> int:
    let len = s_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    let tlen = end_pos - start
    if tlen <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(tlen + 1)
    var i = 0
    when i < tlen loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, tlen, 0)
    out res
end.

func run_cmd_captured(cmd_argv: int, out_file: int) -> int:
    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if s_strlen(out_file) > 0 do
            let out_fd = sys_open_write(out_file)
            if out_fd >= 0 do
                sys_dup2(out_fd, 1)
                sys_close(out_fd)
            end
        end

        let bin_prog = native_read_i64(cmd_argv, 0)
        let envp = alloc(32)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        native_write_i64(envp, 16, 0)

        sys_execve(bin_prog, cmd_argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 3000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let code = read_byte(st, 1)
            out code
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func find_node() -> int:
    let candidates = alloc(48)
    native_write_i64(candidates, 0, "/usr/local/bin/node" as int)
    native_write_i64(candidates, 8, "/opt/homebrew/bin/node" as int)
    native_write_i64(candidates, 16, "/usr/bin/node" as int)
    native_write_i64(candidates, 24, "node" as int)
    native_write_i64(candidates, 32, 0)

    var i = 0
    when i < 4 loop
        let path = native_read_i64(candidates, i * 8)
        let plat = vir_get_platform()
        var fd = -1
        if plat == 2 or plat == 4 do
            fd = syscall4(56, -100, path, 0, 0)
        eif plat == 3 do
            fd = syscall3(2, path, 0, 0)
        else
            fd = syscall3(0x2000005, path, 0, 0)
        end
        if fd >= 0 do
            sys_close(fd)
            out path
        end
        i = i + 1
    end
    out 0
end.

func main():
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if s_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc_bin = get_arg(i + 1) as int
            i = i + 1
        end
        i = i + 1
    end

    s_println("=== Running Native Narrow Cast Contract Verification ===" as int)

    let pid = sys_getpid()
    let tmp_bin = s_concat2("scratch/.tmp_narrow_bin_" as int, s_int_to_str(pid))
    let tmp_out = s_concat2("scratch/.tmp_narrow_out_" as int, s_int_to_str(pid))
    let tmp_asm = s_concat2("scratch/.tmp_narrow_asm_" as int, s_int_to_str(pid))
    let tmp_wasm = s_concat2("scratch/.tmp_narrow_wasm_" as int, s_concat2(s_int_to_str(pid), ".wasm" as int))

    let flow_fixture = "tests/test_narrow_cast_flow.vri" as int
    let width_fixture = "tests/test_narrow_casts.vri" as int
    let expected_flow = "44\n-21682\n1\n43855\n2596069104\n-1698898192" as int
    let expected_widths = "44\n251\n-21682\n43854\n2596069104\n-1698898192\n-16\n240\n43854\n44" as int

    var all_ok = 1

    # ── Test 1: Flow semantics and ARM64 assembly at -O0..-O3 ────────
    s_println("Part 1: Flow semantics across -O0, -O1, -O2, -O3..." as int)
    var opt_i = 0
    when opt_i < 4 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))

        # 1a. Compile binary
        let argv1 = alloc(64)
        native_write_i64(argv1, 0, virc_bin)
        native_write_i64(argv1, 8, flow_fixture)
        native_write_i64(argv1, 16, opt_flag)
        native_write_i64(argv1, 24, "-o" as int)
        native_write_i64(argv1, 32, tmp_bin)
        native_write_i64(argv1, 40, "-q" as int)
        native_write_i64(argv1, 48, 0)

        let rc_comp = run_cmd_captured(argv1, 0)
        if rc_comp != 0 do
            s_print("  [FAIL] Compilation failed for flow fixture at " as int)
            s_println(opt_flag)
            all_ok = 0
        else
            # 1b. Execute binary
            let argv_run = alloc(16)
            native_write_i64(argv_run, 0, tmp_bin)
            native_write_i64(argv_run, 8, 0)
            let rc_run = run_cmd_captured(argv_run, tmp_out)
            let out_data = sys_read_file(tmp_out)
            let clean_out = sys_trim(out_data)
            if rc_run != 0 or s_streq(clean_out, expected_flow) == 0 do
                s_print("  [FAIL] Runtime output mismatch for flow fixture at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                s_print("  [PASS] Flow runtime execution at " as int)
                s_println(opt_flag)
            end
        end

        # 1c. Compile assembly linux-arm64
        let argv_asm = alloc(80)
        native_write_i64(argv_asm, 0, virc_bin)
        native_write_i64(argv_asm, 8, flow_fixture)
        native_write_i64(argv_asm, 16, opt_flag)
        native_write_i64(argv_asm, 24, "--target" as int)
        native_write_i64(argv_asm, 32, "linux-arm64" as int)
        native_write_i64(argv_asm, 40, "-S" as int)
        native_write_i64(argv_asm, 48, "-o" as int)
        native_write_i64(argv_asm, 56, tmp_asm)
        native_write_i64(argv_asm, 64, "-q" as int)
        native_write_i64(argv_asm, 72, 0)

        let rc_asm = run_cmd_captured(argv_asm, 0)
        if rc_asm != 0 do
            s_print("  [FAIL] Assembly emission failed for flow fixture at " as int)
            s_println(opt_flag)
            all_ok = 0
        else
            let asm_data = sys_read_file(tmp_asm)
            if s_find_str(asm_data, "uxth" as int) < 0 or s_find_str(asm_data, "bl narrow_u8" as int) < 0 do
                s_print("  [FAIL] Assembly missing expected instructions at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                s_print("  [PASS] Flow ARM64 assembly instructions at " as int)
                s_println(opt_flag)
            end
        end

        sys_unlink(tmp_bin)
        sys_unlink(tmp_out)
        sys_unlink(tmp_asm)
        opt_i = opt_i + 1
    end

    # ── Test 2: Assembly patterns across targets (linux-arm64, linux-x86_64, linux-riscv64) ──
    s_println("Part 2: Assembly narrowing instructions across targets and -O0..-O3..." as int)
    opt_i = 0
    when opt_i < 4 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))

        # Target 1: linux-arm64 (uxtb, uxth, uxtw, sxtb, sxth, sxtw)
        let argv_t1 = alloc(80)
        native_write_i64(argv_t1, 0, virc_bin)
        native_write_i64(argv_t1, 8, width_fixture)
        native_write_i64(argv_t1, 16, opt_flag)
        native_write_i64(argv_t1, 24, "--target" as int)
        native_write_i64(argv_t1, 32, "linux-arm64" as int)
        native_write_i64(argv_t1, 40, "-S" as int)
        native_write_i64(argv_t1, 48, "-o" as int)
        native_write_i64(argv_t1, 56, tmp_asm)
        native_write_i64(argv_t1, 64, "-q" as int)
        native_write_i64(argv_t1, 72, 0)
        let rc_t1 = run_cmd_captured(argv_t1, 0)
        if rc_t1 != 0 do
            s_print("  [FAIL] linux-arm64 assembly failed at " as int)
            s_println(opt_flag)
            all_ok = 0
        else
            let asm_t1 = sys_read_file(tmp_asm)
            if s_find_str(asm_t1, "uxtb" as int) < 0 or s_find_str(asm_t1, "uxth" as int) < 0 or s_find_str(asm_t1, "sxtb" as int) < 0 do
                s_print("  [FAIL] linux-arm64 assembly missing uxt/sxt patterns at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                s_print("  [PASS] linux-arm64 narrowing assembly at " as int)
                s_println(opt_flag)
            end
        end
        sys_unlink(tmp_asm)

        # Target 2: linux-x86_64 (movzx, movsx)
        let argv_t2 = alloc(80)
        native_write_i64(argv_t2, 0, virc_bin)
        native_write_i64(argv_t2, 8, width_fixture)
        native_write_i64(argv_t2, 16, opt_flag)
        native_write_i64(argv_t2, 24, "--target" as int)
        native_write_i64(argv_t2, 32, "linux-x86_64" as int)
        native_write_i64(argv_t2, 40, "-S" as int)
        native_write_i64(argv_t2, 48, "-o" as int)
        native_write_i64(argv_t2, 56, tmp_asm)
        native_write_i64(argv_t2, 64, "-q" as int)
        native_write_i64(argv_t2, 72, 0)
        let rc_t2 = run_cmd_captured(argv_t2, 0)
        if rc_t2 != 0 do
            s_print("  [FAIL] linux-x86_64 assembly failed at " as int)
            s_println(opt_flag)
            all_ok = 0
        else
            let asm_t2 = sys_read_file(tmp_asm)
            if s_find_str(asm_t2, "movzx" as int) < 0 or s_find_str(asm_t2, "movsx" as int) < 0 do
                s_print("  [FAIL] linux-x86_64 assembly missing movzx/movsx at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                s_print("  [PASS] linux-x86_64 narrowing assembly at " as int)
                s_println(opt_flag)
            end
        end
        sys_unlink(tmp_asm)

        # Target 3: linux-riscv64 (slli, srli, srai)
        let argv_t3 = alloc(80)
        native_write_i64(argv_t3, 0, virc_bin)
        native_write_i64(argv_t3, 8, width_fixture)
        native_write_i64(argv_t3, 16, opt_flag)
        native_write_i64(argv_t3, 24, "--target" as int)
        native_write_i64(argv_t3, 32, "linux-riscv64" as int)
        native_write_i64(argv_t3, 40, "-S" as int)
        native_write_i64(argv_t3, 48, "-o" as int)
        native_write_i64(argv_t3, 56, tmp_asm)
        native_write_i64(argv_t3, 64, "-q" as int)
        native_write_i64(argv_t3, 72, 0)
        let rc_t3 = run_cmd_captured(argv_t3, 0)
        if rc_t3 != 0 do
            s_print("  [FAIL] linux-riscv64 assembly failed at " as int)
            s_println(opt_flag)
            all_ok = 0
        else
            let asm_t3 = sys_read_file(tmp_asm)
            if s_find_str(asm_t3, "slli" as int) < 0 or s_find_str(asm_t3, "srli" as int) < 0 do
                s_print("  [FAIL] linux-riscv64 assembly missing slli/srli at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                s_print("  [PASS] linux-riscv64 narrowing assembly at " as int)
                s_println(opt_flag)
            end
        end
        sys_unlink(tmp_asm)

        opt_i = opt_i + 1
    end

    # ── Test 3: WASM compilation & execution (if Node.js available) ──
    let node_bin = find_node()
    if node_bin != 0 do
        s_println("Part 3: WASI Preview 1 execution via Node.js..." as int)
        let wasi_script = "const fs=require('fs');const {WASI}=require('wasi');const wasi=new WASI({version:'preview1',args:[],env:{}});const module=new WebAssembly.Module(fs.readFileSync(process.argv[1]));const instance=new WebAssembly.Instance(module,{wasi_snapshot_preview1:wasi.wasiImport});wasi.start(instance);" as int
        opt_i = 0
        when opt_i < 4 loop
            let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
            let argv_w = alloc(80)
            native_write_i64(argv_w, 0, virc_bin)
            native_write_i64(argv_w, 8, width_fixture)
            native_write_i64(argv_w, 16, opt_flag)
            native_write_i64(argv_w, 24, "--target" as int)
            native_write_i64(argv_w, 32, "wasm32-wasi" as int)
            native_write_i64(argv_w, 40, "-o" as int)
            native_write_i64(argv_w, 48, tmp_wasm)
            native_write_i64(argv_w, 56, "-q" as int)
            native_write_i64(argv_w, 64, 0)

            let rc_w = run_cmd_captured(argv_w, 0)
            if rc_w != 0 do
                s_print("  [FAIL] Wasm compile failed at " as int)
                s_println(opt_flag)
                all_ok = 0
            else
                let argv_wn = alloc(64)
                native_write_i64(argv_wn, 0, node_bin)
                native_write_i64(argv_wn, 8, "--no-warnings" as int)
                native_write_i64(argv_wn, 16, "-e" as int)
                native_write_i64(argv_wn, 24, wasi_script)
                native_write_i64(argv_wn, 32, tmp_wasm)
                native_write_i64(argv_wn, 40, 0)

                let rc_wn = run_cmd_captured(argv_wn, tmp_out)
                let wout = sys_trim(sys_read_file(tmp_out))
                if rc_wn != 0 or s_streq(wout, expected_widths) == 0 do
                    s_print("  [FAIL] Wasm execution mismatch at " as int)
                    s_println(opt_flag)
                    all_ok = 0
                else
                    s_print("  [PASS] WASI narrowing execution at " as int)
                    s_println(opt_flag)
                end
                sys_unlink(tmp_out)
            end
            sys_unlink(tmp_wasm)
            opt_i = opt_i + 1
        end
    else
        s_println("Part 3: Node.js not found, skipping WASI execution tests (BLOCKED/SKIPPED)." as int)
    end

    if all_ok == 1 do
        s_println("=== All narrow cast contract tests PASSED successfully ===" as int)
        exit_prog(0)
    else
        s_println("=== Narrow cast contract tests FAILED ===" as int)
        exit_prog(1)
    end
end.
