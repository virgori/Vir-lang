module test_ptr;
include vir.rt.syscall;
include vir.rt.alloc;
include vir.rt.string_rt;
include vir.mem.slice;
include vir.str.string;
include vir.collections.vec;
include vir.core.result;
include vir.rt.io;
import read_file_str, print_int, print_ln, print_str from io;

func main:
    let ptr = read_file_str("hello.vri");
    print_str("ptr string is: \n");
    print_str(ptr);
    print_ln("")
end.
export main;
