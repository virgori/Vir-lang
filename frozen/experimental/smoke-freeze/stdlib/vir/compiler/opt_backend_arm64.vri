##
 * vir/compiler/opt_backend_arm64.vri — ARM64-only MIR/LIR optimizer hooks
 * ====================================================================
 * Not part of the architecture-neutral MIR pipeline.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include mir_opt
import mir_opt_arm64_instruction_selection_and_scheduling,
       mir_opt_arm64_addressing_modes_and_register_induction,
       mir_opt_neon_simd_vector_lowering,
       mir_opt_shrink_wrapping,
       mir_opt_hot_cold_layout_partitioning from mir_opt
include lir
import LirOp, LirFunc, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings,
       lir_block_id, lir_block_instrs, lir_instr_op, lir_instr_new, lir_block_new, lir_func_new from lir

const LIR_SHRINK_WRAP_AUX: i64 = 88

# MIR-stage ISA prep (strength patterns that become ARM64 MADD/LSL later)
func opt_arm64_run_mir_passes(blocks: i64):
    # Instruction scheduling is disabled until nested-loop SSA safety is
    # proven; it currently reorders dependent memory operations in tiled code.
    blocks = mir_opt_arm64_addressing_modes_and_register_induction(blocks)
    out blocks
end.

# LIR-stage: shrink-wrap — mark call-free blocks for minimal save/restore
func opt_arm64_run_lir_passes(lf: i64):
    blocks = lir_func_blocks(lf)
    if blocks < 0 do out lf end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        lb = vec_get_rt(blocks, bi)
        instrs = lir_block_instrs(lb)
        if instrs >= 0 do
            var has_call = 0
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                op = lir_instr_op(vec_get_rt(instrs, ii))
                if op == LirOp.Call or op == LirOp.Intrinsic do has_call = 1 end
                ii = ii + 1
            end
            if has_call == 0 do
                marker = lir_instr_new(LirOp.Nop, 0, 0, 0, 0, LIR_SHRINK_WRAP_AUX)
                instrs = vec_push_rt(instrs, marker)
                vec_set_rt(blocks, bi, lir_block_new(lir_block_id(lb), instrs))
            end
        end
        bi = bi + 1
    end
    out lir_func_new(lir_func_id(lf), lir_func_name(lf), blocks, lir_func_stack_size(lf), lir_func_strings(lf))
end.

# Codegen-stage SIMD lowering (NEON)
func opt_arm64_run_simd_mir_passes(blocks: i64):
    blocks = mir_opt_neon_simd_vector_lowering(blocks)
    blocks = mir_opt_hot_cold_layout_partitioning(blocks)
    out blocks
end.

export opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes
