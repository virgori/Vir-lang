include vir.rt.syscall
import sys_exit from vir.rt.syscall
include vir.rt.io
import print_ln from vir.rt.io

func cstr_ends_with_vri(s: int):
    out 0
end.

func get_arg(i: int):
    out 0
end.

func test_parse(argc: int):
    var base_idx = 0
    if argc > 0 and cstr_ends_with_vri(get_arg(0)) == 0 do
        base_idx = 1
    end

    if argc <= base_idx do
        print_ln("ERROR: no input file")
        sys_exit(1)
    end
    print_ln("OK: input file found")
    sys_exit(42)
end.

func main:
    test_parse(4)
end.
