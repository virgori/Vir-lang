include vir.rt.io
import print_str, print_int, print_ln from vir.rt.io
include vir.compiler.opt_pass
import OptPassEscapeArena, opt_pass_min_level from vir.compiler.opt_pass

func mir_opt_should_run(pass_id: int, level: int):
    if level <= 0 do
        out 0
    end
    out level >= opt_pass_min_level(pass_id)
end.

func main():
    print_str("should_run at 1=")
    print_int(mir_opt_should_run(OptPassEscapeArena, 1))
    print_str(" should_run at 2=")
    print_int(mir_opt_should_run(OptPassEscapeArena, 2))
    print_ln("")
end.
