    pass2_register_builtin_one(symbols, scopes, fat_str_new("sev"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("nop"), 0)
    # Atomic primitives
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas32"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add64"), 2)
