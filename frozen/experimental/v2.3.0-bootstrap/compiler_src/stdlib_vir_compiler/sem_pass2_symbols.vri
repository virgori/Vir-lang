    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write16"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dmb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dsb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("isb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("wfi"), 0)
