func pass2_register_builtin_one(symbols: SymbolTable, scopes: ScopeTree, name: string, param_count: int):
    # Builtin list is fixed and unique — skip redef scan (was O(B²)).
    sym = SymbolNode (
        kind: SymbolKind.Builtin,
        name_id: name as i64,
        type_id: 0,
        scope_id: 0,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: param_count,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, 0, sym_id)
    pass2_index_symbol(0, name, sym_id)
    out sym_id
end.
func pass2_walk_node(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    var child = node
    var child_count = 0

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        pc = body_idx
        if pc < 0 do
            pc = 0
        end
        sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
        if sym_id > 0 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sym_id)
            native_write_i64(sym as i64, 56, pc as i64)
        end
        # Only harvest nested `extern func` (do not promote body locals to globals).
        var j = body_idx
        when j < child_count loop
            pass2_collect_nested_extern(symbols, scopes, diag, vec_get_rt(node.children, j))
            j = j + 1
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if child.node_type == AstType.VarDecl do
                pass2_register(symbols, scopes, diag, child.name, SymbolKind.Variable, child.line)
            end
            if child.node_type == AstType.FuncDef do
                m_count = vec_len_rt(child.children)
                m_pc = m_count - 1
                if m_pc < 0 do
                    m_pc = 0
                end
                m_id = pass2_register(symbols, scopes, diag, child.name, SymbolKind.Func, child.line)
                if m_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    m_sym = vec_get_rt(syms_vec2, m_id)
                    native_write_i64(m_sym as i64, 56, m_pc as i64)
                end
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.EnumDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Enum, node.line)
        # Variants are qualified (`Enum.Variant`) and must not occupy the
        # global namespace, where names such as String/Error may be entities.
        out 0
    end

    if node.node_type == AstType.VarDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Variable, var_ident.line)
                    i = i + 1
                end
            end
        else
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ReactiveDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Const, var_ident.line)
                    i = i + 1
                end
            end
        else
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            # Fresh extern stubs have unknown arity (-1).  Existing builtin/Func
            # keeps its recorded param_count via pass2_register merge.
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 56, 0 - 1)
            end
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Recurse into block/program children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_walk_node(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

# Walk a function body solely for nested `extern func` declarations.
func pass2_collect_nested_extern(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 56, 0 - 1)
            end
        end
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_collect_nested_extern(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass2_register(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Check redefinition in current scope (hash bucket — avg O(1))
    found = pass2_lookup_name_in_scope(symbols, scopes, curr_scope, name)
    if found != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        old_sym = vec_get_rt(syms_vec, found)
        old_kind = native_read_i64(old_sym as i64, 0)
        if old_kind == SymbolKind.Builtin do
            # User/extern definition replaces builtin kind; keep arity.
            native_write_i64(old_sym as i64, 0, kind as i64)
            out found
        end
        # Expanded/multi-include: identical redeclare is idempotent (extern+func,
        # duplicate consts across modules). Keep the first symbol.
        if old_kind == kind do
            out found
        end
        if old_kind == SymbolKind.Func and kind == SymbolKind.Func do
            out found
        end
        report_error(diag, 1001, line, 0)
        out found
    end
    # Create and register symbol
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    pass2_index_symbol(curr_scope, name, sym_id)
    out sym_id
end.
func pass2_lookup_name_in_scope(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    pass2_ensure_scope_map(scope_id)
    buckets = vec_get_rt(g_pass2_scope_maps, scope_id)
    bid = pass2_hash_name(name)
    bucket = vec_get_rt(buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

export pass2_register_symbols
