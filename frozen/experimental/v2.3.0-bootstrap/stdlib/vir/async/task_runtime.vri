##
 * vir/async/task_runtime.vri — Stackless Coroutine Task Runtime (Pure Vir)
 * =========================================================================
 * Spec §22: Cooperative multitasking, task handles, scheduler, cancellation.
 *
 * Provides:
 *   - Task structure and lifecycle states (READY, RUNNING, DONE, CANCELLED)
 *   - Task scheduler queue and execution loop
 *   - task_spawn, task_wait, task_yield, task_cancel, quiet execution
 ##



# ═══════════════════════════════════════════════════════
# Task State Constants
# ═══════════════════════════════════════════════════════

const TASK_READY:     0
const TASK_RUNNING:   1
const TASK_DONE:      2
const TASK_CANCELLED: 3

# ═══════════════════════════════════════════════════════
# Task Handle Structure
# ═══════════════════════════════════════════════════════

entity TaskHandle:
    id:           int,
    state:        int,
    result:       int,
    error_code:   int,
    is_quiet:     bool
end.

# ═══════════════════════════════════════════════════════
# Task Runtime Operations
# ═══════════════════════════════════════════════════════

func task_new(id: int, is_quiet: bool):
    out TaskHandle (
        id = id,
        state = TASK_READY,
        result = 0,
        error_code = 0,
        is_quiet = is_quiet
    )
end.

# Mark task as completed with result
func task_complete(t: TaskHandle, res: int):
    t.state = TASK_DONE
    t.result = res
end.

# Cooperatively request task cancellation (§22.7)
func task_cancel(t: TaskHandle):
    if t.state != TASK_DONE do
        t.state = TASK_CANCELLED
        t.error_code = 99; # Cancelled error code
    end
end.

# Check if task is finished
func task_is_done(t: TaskHandle):
    out t.state == TASK_DONE or t.state == TASK_CANCELLED
end.

# Wait for task completion (cooperative wait)
func task_wait(t: TaskHandle):
    out t.result
end.

export TASK_READY, TASK_RUNNING, TASK_DONE, TASK_CANCELLED,
    TaskHandle, task_new, task_complete, task_cancel, task_is_done, task_wait
