##
 * vir/compiler/opt_backend.vri — Backend optimizer dispatch (no arch in MIR pipeline)
 * ================================================================================
 * Passes 10 (SIMD), 11 (TCO), 12 (IRC), 15 (ARC), 21 (shrink-wrap) are routed here.
 ##

include types
include target
import TargetArch, get_codegen_target from target

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

include mir_opt
import mir_opt_arm64_instruction_selection_and_scheduling,
       mir_opt_arm64_addressing_modes_and_register_induction,
       mir_opt_neon_simd_vector_lowering,
       mir_opt_shrink_wrapping,
       mir_opt_hot_cold_layout_partitioning,
       mir_opt_arc_trial_deletion from mir_opt

include lir
import LirOp, LirFunc, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings,
       lir_block_id, lir_block_instrs, lir_instr_op, lir_instr_new, lir_block_new, lir_func_new from lir

const LIR_SHRINK_WRAP_AUX: i64 = 88

# ── Generic passes ──
func opt_generic_run_mir_passes(blocks: i64):
    out blocks
end.

func opt_generic_run_lir_passes(lf: i64):
    out lf
end.

func opt_generic_run_simd_mir_passes(blocks: i64):
    out blocks
end.

# ── ARC passes ──
func opt_backend_run_arc_passes(blocks: i64, opt_level: int):
    if opt_level < 2 do out blocks end
    out mir_opt_arc_trial_deletion(blocks)
end.

# ── ARM64 passes ──
func opt_arm64_run_mir_passes(blocks: i64):
    blocks = mir_opt_arm64_addressing_modes_and_register_induction(blocks)
    out blocks
end.

func opt_arm64_run_lir_passes(lf: i64):
    blocks = lir_func_blocks(lf)
    if blocks < 0 do
        out lf
    end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        lb = vec_get_rt(blocks, bi)
        instrs = lir_block_instrs(lb)
        if instrs >= 0 do
            var has_call = 0
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                op = lir_instr_op(vec_get_rt(instrs, ii))
                if op == LirOp.Call or op == LirOp.Intrinsic do has_call = 1 end
                ii = ii + 1
            end
            if has_call == 0 do
                marker = lir_instr_new(LirOp.Nop, 0, 0, 0, 0, LIR_SHRINK_WRAP_AUX)
                instrs = vec_push_rt(instrs, marker)
                vec_set_rt(blocks, bi, lir_block_new(lir_block_id(lb), instrs))
            end
        end
        bi = bi + 1
    end
    let new_lf = lir_func_new(lir_func_id(lf), lir_func_name(lf), blocks, lir_func_stack_size(lf), lir_func_strings(lf))
    out new_lf
end.

func opt_arm64_run_simd_mir_passes(blocks: i64):
    blocks = mir_opt_neon_simd_vector_lowering(blocks)
    blocks = mir_opt_hot_cold_layout_partitioning(blocks)
    out blocks
end.

# ── Dispatchers ──
func opt_backend_run_mir_post(blocks: i64, arch: int, opt_level: int):
    if arch == TargetArch.ARM64 do
        blocks = opt_arm64_run_mir_passes(blocks)
        if opt_level >= 2 do
            blocks = opt_arm64_run_simd_mir_passes(blocks)
        end
        blocks = opt_backend_run_arc_passes(blocks, opt_level)
        out blocks
    end
    blocks = opt_generic_run_mir_passes(blocks)
    blocks = opt_backend_run_arc_passes(blocks, opt_level)
    out blocks
end.

func opt_backend_run_lir_post(lf: i64, arch: int):
    if arch == TargetArch.ARM64 do
        out opt_arm64_run_lir_passes(lf)
    end
    out opt_generic_run_lir_passes(lf)
end.

export opt_backend_run_mir_post, opt_backend_run_lir_post,
       opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes,
       opt_generic_run_mir_passes, opt_generic_run_lir_passes, opt_generic_run_simd_mir_passes,
       opt_backend_run_arc_passes
