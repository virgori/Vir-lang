##
 * vir/compiler/target_triple.vri — Target Triple Parser & Host Detection
 * ========================================================================
 * Decomposes triples (e.g. "macos-arm64", "linux-arm64", "linux-x86_64")
 * into TargetArch, TargetOS, TargetABI, ObjectFormat, and AsmDialect.
 ##

module vir.compiler.target_triple

include types
include string_rt
import rt_streq, fat_str_eq, fat_cstr_eq, native_read_i64, native_write_i64 from string_rt
include compiler.mc
import TargetArch, TargetOS, TargetABI, ObjectFormat, AsmDialect, TargetTriple, target_triple_new, triple_arch, triple_os, triple_abi, triple_format, triple_dialect from compiler.mc
include rt.syscall
import Platform, sys_platform from rt.syscall

func get_host_triple():
    let p = sys_platform()
    if p == Platform.Linux_ARM64 do
        out target_triple_new(TargetArch.ARM64, TargetOS.Linux, TargetABI.AAPCS64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    eif p == Platform.Linux_x86_64 do
        out target_triple_new(TargetArch.X86_64, TargetOS.Linux, TargetABI.SysV_AMD64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    eif p == Platform.Linux_RISCV64 do
        out target_triple_new(TargetArch.RISCV64, TargetOS.Linux, TargetABI.RV64D, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    else
        # Default host: macOS ARM64
        out target_triple_new(TargetArch.ARM64, TargetOS.Darwin, TargetABI.AAPCS64, ObjectFormat.MachO, AsmDialect.DarwinAsm)
    end
end.

func parse_target_triple(str_val: string):
    if rt_streq(str_val, "macos-arm64") or rt_streq(str_val, "arm64-apple-darwin") or rt_streq(str_val, "darwin-arm64") do
        out target_triple_new(TargetArch.ARM64, TargetOS.Darwin, TargetABI.AAPCS64, ObjectFormat.MachO, AsmDialect.DarwinAsm)
    end
    if rt_streq(str_val, "linux-arm64") or rt_streq(str_val, "aarch64-linux") or rt_streq(str_val, "aarch64-unknown-linux-gnu") do
        out target_triple_new(TargetArch.ARM64, TargetOS.Linux, TargetABI.AAPCS64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    end
    if rt_streq(str_val, "linux-x86_64") or rt_streq(str_val, "x86_64-linux") or rt_streq(str_val, "x86_64-unknown-linux-gnu") do
        out target_triple_new(TargetArch.X86_64, TargetOS.Linux, TargetABI.SysV_AMD64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    end
    if rt_streq(str_val, "linux-riscv64") or rt_streq(str_val, "riscv64-linux") do
        out target_triple_new(TargetArch.RISCV64, TargetOS.Linux, TargetABI.RV64D, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    end
    if rt_streq(str_val, "wasm32-wasi-p1") or rt_streq(str_val, "wasm32-wasi") or rt_streq(str_val, "wasm32") or rt_streq(str_val, "wasm") do
        out target_triple_new(TargetArch.Wasm32, TargetOS.WASI_P1, TargetABI.WasmMVP, ObjectFormat.Wasm, AsmDialect.WasmWAT)
    end

    # Short aliases based on host OS:
    if rt_streq(str_val, "arm64") or rt_streq(str_val, "aarch64") do
        let host = get_host_triple()
        if triple_os(host) == TargetOS.Linux do
            out target_triple_new(TargetArch.ARM64, TargetOS.Linux, TargetABI.AAPCS64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
        else
            out target_triple_new(TargetArch.ARM64, TargetOS.Darwin, TargetABI.AAPCS64, ObjectFormat.MachO, AsmDialect.DarwinAsm)
        end
    end
    if rt_streq(str_val, "x86_64") or rt_streq(str_val, "x86-64") do
        out target_triple_new(TargetArch.X86_64, TargetOS.Linux, TargetABI.SysV_AMD64, ObjectFormat.ELF, AsmDialect.GNU_ELF)
    end

    out 0
end.

