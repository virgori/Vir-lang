##
 * vir/compiler/lir_target_desc.vri — Target Register Descriptors
 * ==============================================================
 * Defines register palettes, reserved registers, call clobbers,
 * callee-saved registers, and scratch roles per architecture.
 *
 * Implements the ABI contract specified in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_target_desc

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include compiler.target
import get_codegen_target, TargetArch from compiler.target

entity TargetDesc:
    arch: i64;
    k_colors_leaf: i64;
    k_colors_nonleaf: i64;
    palette_leaf: i64;
    palette_nonleaf: i64;
    caller_clobbers: i64;
    callee_saved: i64;
    reserved_regs: i64
end.

# ── Target Descriptor Query Helpers ──

func target_desc_get_arch():
    out get_codegen_target()
end.

# Returns K (number of allocatable registers)
func target_desc_k(is_leaf: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        out 4 # RBX, R12, R13, R14
    end
    out 9 # ARM64: X19..X27
end.

# Maps a color index (0..K-1) to the target physical register.
func target_desc_color_to_phys(color: i64, is_leaf: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        if color == 0 do out 3 end    # RBX
        if color == 1 do out 12 end   # R12
        if color == 2 do out 13 end   # R13
        if color == 3 do out 14 end   # R14
        out 3
    end
    if arch == 3 or arch == TargetArch.RISCV64 do
        out 18 + color # s2..s10
    end
    # ARM64: X19..X27
    out 19 + color
end.

# Checks whether a physical register is callee-saved (preserved across calls).
func target_desc_is_callee_saved(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        if phys_reg == 3 or phys_reg == 12 or phys_reg == 13 or phys_reg == 14 do
            out 1
        end
        out 0
    end
    # ARM64: X19..X28 are callee-saved
    if phys_reg >= 19 and phys_reg <= 28 do
        out 1
    end
    out 0
end.

# Checks whether a physical register is caller-saved (clobbered by calls).
func target_desc_is_call_clobbered(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        # RAX(0), RCX(1), RDX(2), RSI(4), RDI(5), R8..R11(8..11)
        if phys_reg == 0 or phys_reg == 1 or phys_reg == 2 or phys_reg == 4 or phys_reg == 5 or (phys_reg >= 8 and phys_reg <= 11) do
            out 1
        end
        out 0
    end
    # ARM64: X0..X15 are caller-saved
    if phys_reg >= 0 and phys_reg <= 15 do
        out 1
    end
    out 0
end.

# Checks whether a physical register is target-reserved and forbidden for virtual allocation.
func target_desc_is_reserved(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        # RSP(4), RBP(5), R15(15)
        if phys_reg == 4 or phys_reg == 5 or phys_reg == 15 do
            out 1
        end
        out 0
    end
    # ARM64: X16, X17 (scratch/stubs), X18 (platform), X28 (arena), X29 (FP), X30 (LR), X31 (SP)
    if phys_reg == 16 or phys_reg == 17 or phys_reg == 18 or phys_reg == 28 or phys_reg == 29 or phys_reg == 30 or phys_reg == 31 do
        out 1
    end
    out 0
end.

export target_desc_get_arch, target_desc_k, target_desc_color_to_phys
export target_desc_is_callee_saved, target_desc_is_call_clobbered, target_desc_is_reserved
