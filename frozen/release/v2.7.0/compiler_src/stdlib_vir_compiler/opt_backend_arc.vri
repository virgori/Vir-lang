##
 * vir/compiler/opt_backend_arc.vri — Pass #15 ARC trial deletion (backend stage)
 * =============================================================================
 * Bacon–Rajan heap refcount: retain/release on GlobalEscape, local pair elimination.
 * Not part of the architecture-neutral MIR pipeline.
 ##

include types
include mir_opt
import mir_opt_arc_trial_deletion from mir_opt

func opt_backend_run_arc_passes(blocks: i64, opt_level: int):
    if opt_level < 2 do out blocks end
    out mir_opt_arc_trial_deletion(blocks)
end.

export opt_backend_run_arc_passes
