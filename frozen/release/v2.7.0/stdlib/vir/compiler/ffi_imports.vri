##
 * vir/compiler/ffi_imports.vri — target-neutral external symbol registry
 *
 * Parser/lowering record extern declarations here.  Object-format writers
 * consume the same registry to make their platform import tables; keeping
 * the registry independent of Mach-O avoids encoding macOS policy in MIR.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import fat_str_eq, fat_str_new from string_rt

var g_ffi_import_names: i64 = 0
var g_ffi_import_sources: i64 = 0
var g_ffi_import_used: i64 = 0
var g_ffi_arm64_stub_offsets: i64 = 0
var g_ffi_arm64_stub_imports: i64 = 0

func ffi_import_reset():
    g_ffi_import_names = vec_new_rt()
    g_ffi_import_sources = vec_new_rt()
    g_ffi_import_used = vec_new_rt()
    g_ffi_arm64_stub_offsets = vec_new_rt()
end.

func ffi_import_register(name: string, source: string):
    if g_ffi_import_names == 0 do ffi_import_reset() end
    var i = 0
    when i < vec_len_rt(g_ffi_import_names) loop
        if fat_str_eq(vec_get_rt(g_ffi_import_names, i) as string, name) == 1 do
            # One symbol has one linker source.  Keep the first declaration;
            # semantic analysis reports duplicate user symbols separately.
            out i
        end
        i = i + 1
    end
    g_ffi_import_names = vec_push_rt(g_ffi_import_names, name)
    g_ffi_import_sources = vec_push_rt(g_ffi_import_sources, source)
    g_ffi_import_used = vec_push_rt(g_ffi_import_used, 0)
    out vec_len_rt(g_ffi_import_names) - 1
end.

func ffi_import_find(name: string):
    if g_ffi_import_names == 0 do out 0 - 1 end
    var i = 0
    when i < vec_len_rt(g_ffi_import_names) loop
        if fat_str_eq(vec_get_rt(g_ffi_import_names, i) as string, name) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func ffi_import_count():
    if g_ffi_import_names == 0 do out 0 end
    out vec_len_rt(g_ffi_import_names)
end.

func ffi_import_mark_used(index: int):
    if index >= 0 and index < ffi_import_count() do vec_set_rt(g_ffi_import_used, index, 1) end
end.

func ffi_import_used_count():
    var count = 0
    var i = 0
    when i < ffi_import_count() loop
        if vec_get_rt(g_ffi_import_used, i) != 0 do count = count + 1 end
        i = i + 1
    end
    out count
end.

func ffi_import_used_at(dense_index: int):
    var seen = 0
    var i = 0
    when i < ffi_import_count() loop
        if vec_get_rt(g_ffi_import_used, i) != 0 do
            if seen == dense_index do out i end
            seen = seen + 1
        end
        i = i + 1
    end
    out 0 - 1
end.

func ffi_import_name(index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("") end
    out vec_get_rt(g_ffi_import_names, index) as string
end.

func ffi_import_source(index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("os") end
    out vec_get_rt(g_ffi_import_sources, index) as string
end.

# Platform policy belongs at the object writer boundary.  The symbolic `os`
# source is intentionally retained until then, so ELF, PE and Wasm can map it
# to their own standard import provider without changing parser/MIR.
func ffi_source_is_os(source: string):
    out fat_str_eq(source, fat_str_new("os"))
end.

func ffi_arm64_stubs_reset():
    g_ffi_arm64_stub_offsets = vec_new_rt()
    g_ffi_arm64_stub_imports = vec_new_rt()
end.

func ffi_arm64_stub_add(import_index: int, offset: int):
    if g_ffi_arm64_stub_offsets == 0 do ffi_arm64_stubs_reset() end
    g_ffi_arm64_stub_offsets = vec_push_rt(g_ffi_arm64_stub_offsets, offset)
    g_ffi_arm64_stub_imports = vec_push_rt(g_ffi_arm64_stub_imports, import_index)
end.

func ffi_arm64_stub_offset(import_index: int):
    if g_ffi_arm64_stub_offsets == 0 do out 0 - 1 end
    var i = 0
    when i < vec_len_rt(g_ffi_arm64_stub_offsets) loop
        if vec_get_rt(g_ffi_arm64_stub_imports, i) == import_index do out vec_get_rt(g_ffi_arm64_stub_offsets, i) end
        i = i + 1
    end
    out 0 - 1
end.

const MACHO_FFI_CODE_OFFSET: i64 = 2048

export ffi_import_reset, ffi_import_register, ffi_import_find, ffi_import_count,
       ffi_import_name, ffi_import_source, ffi_source_is_os, ffi_import_mark_used,
       ffi_import_used_count, ffi_import_used_at,
       ffi_arm64_stubs_reset, ffi_arm64_stub_add, ffi_arm64_stub_offset,
       MACHO_FFI_CODE_OFFSET
