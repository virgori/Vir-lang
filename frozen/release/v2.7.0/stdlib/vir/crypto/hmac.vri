##
 * vir/crypto/hmac.vri — Hash-based Message Authentication Code
 * ============================================================
 * Inspired by Go: crypto/hmac
 * Inspired by Python: hmac
 * RFC 2104 — HMAC: Keyed-Hashing for Message Authentication
 *
 * HMAC-SHA256 primary; key is hashed if longer than block size.
 ##

module vir.crypto.hmac

include types
include crypto/hash
import sha256_new, sha256_update, sha256_finish, sha256_hash, HASH_SHA256_LEN, hash_bytes_to_hex from crypto/hash

const HMAC_SHA256_BLOCK = 64
const HMAC_SHA256_TAG = 32

func _hmac_sha256_key_block(key: [int], key_len: int):
    var kb: [int; 64]
    i = 0
    when i < 64 loop
        kb[i] = 0
        i = i + 1
    end
    if key_len > HMAC_SHA256_BLOCK do
        dig = sha256_hash(key, key_len)
        i = 0
        when i < HASH_SHA256_LEN loop
            kb[i] = dig[i] bit_and 255
            i = i + 1
        end
    else
        i = 0
        when i < key_len loop
            kb[i] = key[i] bit_and 255
            i = i + 1
        end
    end
    out kb
end.

func hmac_sha256(key: [int], key_len: int, msg: [int], msg_len: int):
    kb = _hmac_sha256_key_block(key, key_len)

    var ipad: [int; 64]
    var opad: [int; 64]
    i = 0
    when i < 64 loop
        ipad[i] = kb[i] bit_xor 0x36
        opad[i] = kb[i] bit_xor 0x5c
        i = i + 1
    end

    # inner = SHA256(ipad || msg)
    inner = sha256_new()
    sha256_update(inner, ipad, 64)
    sha256_update(inner, msg, msg_len)
    inner_dig = sha256_finish(inner)

    # outer = SHA256(opad || inner)
    outer = sha256_new()
    sha256_update(outer, opad, 64)
    sha256_update(outer, inner_dig, HASH_SHA256_LEN)
    out sha256_finish(outer)
end.

func hmac_sha256_hex(key: [int], key_len: int, msg: [int], msg_len: int):
    tag = hmac_sha256(key, key_len, msg, msg_len)
    out hash_bytes_to_hex(tag, HMAC_SHA256_TAG)
end.

func hmac_sha256_verify(key: [int], key_len: int, msg: [int], msg_len: int, expect: [int], expect_len: int):
    # Constant-time compare of HMAC tags
    if expect_len != HMAC_SHA256_TAG do
        out 0
    end
    got = hmac_sha256(key, key_len, msg, msg_len)
    diff = 0
    i = 0
    when i < HMAC_SHA256_TAG loop
        diff = diff bit_or ((got[i] bit_xor expect[i]) bit_and 255)
        i = i + 1
    end
    if diff == 0 do out 1 end
    out 0
end.

export hmac_sha256, hmac_sha256_hex, hmac_sha256_verify
export HMAC_SHA256_BLOCK, HMAC_SHA256_TAG
