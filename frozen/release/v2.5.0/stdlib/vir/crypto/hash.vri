    if i == 26 do out 12683024718118986047 end
    if i == 27 do out 13788192230050041572 end
    if i == 28 do out 14330467153632333762 end
    if i == 29 do out 15395433587784984357 end
    if i == 30 do out 489312712824947311 end
    if i == 31 do out 1452737877330783856 end
    if i == 32 do out 2861767655752347644 end
    if i == 33 do out 3322285676063803686 end
    if i == 34 do out 5560940570517711597 end
    if i == 35 do out 5996557281743188959 end
    if i == 36 do out 7280758554555802590 end
    if i == 37 do out 8532644243296465576 end
    if i == 38 do out 9350256976987008742 end
    if i == 39 do out 10552545826968843579 end
    if i == 40 do out 11727347734174303076 end
    if i == 41 do out 12113106623233404929 end
    if i == 42 do out 14000437183269869457 end
    if i == 43 do out 14369950271660146224 end
    if i == 44 do out 15101387698204529176 end
    if i == 45 do out 15463397548674623760 end
    if i == 46 do out 17586052441742319658 end
    if i == 47 do out 1182934255886127544 end
    if i == 48 do out 1847814050463011016 end
    if i == 49 do out 2177327727835720531 end
    if i == 50 do out 2830643537854262169 end
    if i == 51 do out 3796741975233480872 end
    if i == 52 do out 4115178125766777443 end
    if i == 53 do out 5681478168544905931 end
    if i == 54 do out 6601373596472566643 end
    if i == 55 do out 7507060721942968483 end
    if i == 56 do out 8399075790359081724 end
    if i == 57 do out 8693463985226723168 end
    if i == 58 do out 9568029438360202098 end
    if i == 59 do out 10144078919501101548 end
    if i == 60 do out 10430055236837252648 end
