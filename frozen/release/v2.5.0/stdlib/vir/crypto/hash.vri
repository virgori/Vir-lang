func sha512_new:
    out Sha512 (
        h = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b,
             0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
             0x510e527fade682d1, 0x9b05688c2b3e6c1f,
             0x1f83d9abfb41bd6b, 0x5be0cd19137e2179],
        buf = [0; 128],
        buf_len = 0,
        total = 0
    )
end.

func _sha512_compress(ctx: Sha512, block: [int; 128]):
    var w: [int; 80]
    i = 0
    when i < 16 loop
        w[i] = ((block[i * 8] bit_and 255) shl 56) bit_or
               ((block[i * 8 + 1] bit_and 255) shl 48) bit_or
               ((block[i * 8 + 2] bit_and 255) shl 40) bit_or
               ((block[i * 8 + 3] bit_and 255) shl 32) bit_or
               ((block[i * 8 + 4] bit_and 255) shl 24) bit_or
               ((block[i * 8 + 5] bit_and 255) shl 16) bit_or
               ((block[i * 8 + 6] bit_and 255) shl 8) bit_or
               (block[i * 8 + 7] bit_and 255)
        i = i + 1
    end
    when i < 80 loop
        s0 = _rotr64(w[i - 15], 1) bit_xor _rotr64(w[i - 15], 8) bit_xor (w[i - 15] shr 7)
        s1 = _rotr64(w[i - 2], 19) bit_xor _rotr64(w[i - 2], 61) bit_xor (w[i - 2] shr 6)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
        i = i + 1
    end

    a = ctx.h[0]; b = ctx.h[1]; c = ctx.h[2]; d = ctx.h[3]
    e = ctx.h[4]; f = ctx.h[5]; g = ctx.h[6]; h = ctx.h[7]

    t = 0
    when t < 80 loop
        S1 = _rotr64(e, 14) bit_xor _rotr64(e, 18) bit_xor _rotr64(e, 41)
        ch = (e bit_and f) bit_xor (((e bit_xor (-1)) bit_and g))
        temp1 = h + S1 + ch + _sha512_k(t) + w[t]
        S0 = _rotr64(a, 28) bit_xor _rotr64(a, 34) bit_xor _rotr64(a, 39)
        maj = (a bit_and b) bit_xor (a bit_and c) bit_xor (b bit_and c)
        temp2 = S0 + maj
        h = g; g = f; f = e; e = d + temp1
        d = c; c = b; b = a; a = temp1 + temp2
        t = t + 1
    end

    ctx.h[0] = ctx.h[0] + a
    ctx.h[1] = ctx.h[1] + b
    ctx.h[2] = ctx.h[2] + c
    ctx.h[3] = ctx.h[3] + d
    ctx.h[4] = ctx.h[4] + e
    ctx.h[5] = ctx.h[5] + f
    ctx.h[6] = ctx.h[6] + g
    ctx.h[7] = ctx.h[7] + h
end.

func sha512_update(ctx: Sha512, data: [int], len: int):
    i = 0
    when i < len loop
        ctx.buf[ctx.buf_len] = data[i] bit_and 255
        ctx.buf_len = ctx.buf_len + 1
        ctx.total = ctx.total + 1
        if ctx.buf_len == 128 do
            _sha512_compress(ctx, ctx.buf)
            ctx.buf_len = 0
        end
        i = i + 1
    end
end.

func sha512_finish(ctx: Sha512):
    total_bits = ctx.total * 8
    ctx.buf[ctx.buf_len] = 0x80
    ctx.buf_len = ctx.buf_len + 1
    if ctx.buf_len > 112 do
        when ctx.buf_len < 128 loop
            ctx.buf[ctx.buf_len] = 0
            ctx.buf_len = ctx.buf_len + 1
        end
        _sha512_compress(ctx, ctx.buf)
        ctx.buf_len = 0
    end
    when ctx.buf_len < 112 loop
        ctx.buf[ctx.buf_len] = 0
        ctx.buf_len = ctx.buf_len + 1
    end
    i = 112
    when i < 120 loop
        ctx.buf[i] = 0
        i = i + 1
    end
    ctx.buf[120] = (total_bits shr 56) bit_and 255
    ctx.buf[121] = (total_bits shr 48) bit_and 255
    ctx.buf[122] = (total_bits shr 40) bit_and 255
    ctx.buf[123] = (total_bits shr 32) bit_and 255
    ctx.buf[124] = (total_bits shr 24) bit_and 255
    ctx.buf[125] = (total_bits shr 16) bit_and 255
    ctx.buf[126] = (total_bits shr 8) bit_and 255
    ctx.buf[127] = total_bits bit_and 255
    _sha512_compress(ctx, ctx.buf)

    var digest: [int; 64]
    i = 0
    when i < 8 loop
        digest[i * 8] = (ctx.h[i] shr 56) bit_and 255
        digest[i * 8 + 1] = (ctx.h[i] shr 48) bit_and 255
        digest[i * 8 + 2] = (ctx.h[i] shr 40) bit_and 255
        digest[i * 8 + 3] = (ctx.h[i] shr 32) bit_and 255
        digest[i * 8 + 4] = (ctx.h[i] shr 24) bit_and 255
        digest[i * 8 + 5] = (ctx.h[i] shr 16) bit_and 255
        digest[i * 8 + 6] = (ctx.h[i] shr 8) bit_and 255
        digest[i * 8 + 7] = ctx.h[i] bit_and 255
        i = i + 1
    end
    out digest
end.

func sha512_hash(data: [int], len: int):
    ctx = sha512_new()
    sha512_update(ctx, data, len)
    out sha512_finish(ctx)
end.

func sha512_hex(data: [int], len: int):
    dig = sha512_hash(data, len)
    out hash_bytes_to_hex(dig, 64)
end.

export sha256_new, sha256_update, sha256_finish, sha256_hash, sha256_hex
export sha512_new, sha512_update, sha512_finish, sha512_hash, sha512_hex
export hash_bytes_to_hex, HASH_SHA256_LEN, HASH_SHA512_LEN
export Sha256, Sha512
