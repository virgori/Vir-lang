##
 * vir/embedded/ring_buffer.vri — Lock-Free SPSC Circular Ring Buffer
 * =================================================================
 * Single-Producer Single-Consumer lock-free FIFO queue optimized for
 * peripheral ISR streaming (UART, SPI, ADC, DMA) and thread handoff.
 ##

# Allocate a new ring buffer with given capacity
func ring_buffer_new(capacity: int):
    if capacity <= 0 do
        capacity = 16
    end
    var rb = alloc(32)
    var buf = alloc(capacity * 8)
    native_write_i64(rb, 0, 0)          # head = 0
    native_write_i64(rb, 8, 0)          # tail = 0
    native_write_i64(rb, 16, capacity)  # capacity
    native_write_i64(rb, 24, buf)       # buffer_ptr
    out rb
end.

# Get current number of elements in the ring buffer
func ring_buffer_len(rb: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    var cap = native_read_i64(rb, 16)
    if head >= tail do
        out head - tail
    end
    out cap - (tail - head)
end.

# Check if ring buffer is empty
func ring_buffer_is_empty(rb: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    if head == tail do
        out 1
    end
    out 0
end.

# Check if ring buffer is full
func ring_buffer_is_full(rb: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    var cap = native_read_i64(rb, 16)
    var next_head = (head + 1) mod cap
    if next_head == tail do
        out 1
    end
    out 0
end.

# Push an element to ring buffer (Producer). Returns 1 on success, 0 on buffer full.
func ring_buffer_push(rb: int, val: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    var cap = native_read_i64(rb, 16)
    var next_head = (head + 1) mod cap
    if next_head == tail do
        out 0 # Buffer full
    end
    var buf = native_read_i64(rb, 24)
    native_write_i64(buf, head * 8, val)
    dmb() # Memory barrier ensures data is written before head pointer updates
    native_write_i64(rb, 0, next_head)
    out 1
end.

# Pop an element from ring buffer (Consumer). Returns element or -1 if empty.
func ring_buffer_pop(rb: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    if head == tail do
        out 0 - 1 # Buffer empty
    end
    var cap = native_read_i64(rb, 16)
    var buf = native_read_i64(rb, 24)
    var val = native_read_i64(buf, tail * 8)
    dmb() # Memory barrier ensures data is read before tail pointer updates
    var next_tail = (tail + 1) mod cap
    native_write_i64(rb, 8, next_tail)
    out val
end.

# Peek the next element without popping
func ring_buffer_peek(rb: int):
    var head = native_read_i64(rb, 0)
    var tail = native_read_i64(rb, 8)
    if head == tail do
        out 0 - 1
    end
    var buf = native_read_i64(rb, 24)
    out native_read_i64(buf, tail * 8)
end.

export ring_buffer_new, ring_buffer_len, ring_buffer_is_empty, ring_buffer_is_full, ring_buffer_push, ring_buffer_pop, ring_buffer_peek
