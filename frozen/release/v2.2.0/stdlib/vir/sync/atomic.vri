##
 * vir/sync/atomic.vri — Atomic Concurrency Primitives & Operations
 * ================================================================
 * Provides high-performance, sequentially-consistent atomic memory
 * primitives for multi-core thread safety, lock-free queues, and sync.
 ##

# 64-bit atomic load with Load-Acquire memory semantics
func atomic_get(addr: int):
    out atomic_load(addr)
end.

# 64-bit atomic store with Store-Release memory semantics
func atomic_set(addr: int, val: int):
    atomic_store(addr, val)
end.

# 64-bit atomic fetch and add (returns old value)
func atomic_fetch_add(addr: int, delta: int):
    out atomic_add(addr, delta)
end.

# 64-bit atomic fetch and subtract (returns old value)
func atomic_fetch_sub(addr: int, delta: int):
    out atomic_sub(addr, delta)
end.

# 64-bit atomic compare-and-swap (returns 1 if exchanged, 0 otherwise)
func atomic_compare_exchange(addr: int, expected: int, desired: int):
    out atomic_cas(addr, expected, desired)
end.

# 64-bit atomic exchange / swap (returns old value)
func atomic_swap_val(addr: int, new_val: int):
    out atomic_exchange(addr, new_val)
end.

# 32-bit atomic load
func atomic_get32(addr: int):
    out atomic_load32(addr)
end.

# 32-bit atomic store
func atomic_set32(addr: int, val: int):
    atomic_store32(addr, val)
end.

# 32-bit atomic fetch and add
func atomic_fetch_add32(addr: int, delta: int):
    out atomic_add32(addr, delta)
end.

# 32-bit atomic fetch and subtract
func atomic_fetch_sub32(addr: int, delta: int):
    out atomic_sub32(addr, delta)
end.

# 32-bit atomic compare-and-swap
func atomic_compare_exchange32(addr: int, expected: int, desired: int):
    out atomic_cas32(addr, expected, desired)
end.

# 32-bit atomic exchange / swap
func atomic_swap_val32(addr: int, new_val: int):
    out atomic_exchange32(addr, new_val)
end.

export atomic_get, atomic_set, atomic_fetch_add, atomic_fetch_sub, atomic_compare_exchange, atomic_swap_val, atomic_get32, atomic_set32, atomic_fetch_add32, atomic_fetch_sub32, atomic_compare_exchange32, atomic_swap_val32
