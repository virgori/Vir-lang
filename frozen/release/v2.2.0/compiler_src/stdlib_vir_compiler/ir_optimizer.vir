/*
 * vir/compiler/ir_optimizer.vir — AST→Q-IR Lowering + Linear-Scan RegAlloc
 * =========================================================================
 * Pure Vir implementation. Transforms AST into Q-IR instructions,
 * performs liveness analysis, linear-scan register allocation,
 * spill code insertion, and tail-call optimization.
 *
 * Converted from C (core/src/ir_lower.c) for self-hosting.
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat, str_len, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get, vec_set
import "vir/compiler/lexer" use TokType
import "vir/compiler/parser" use AstNode, AstType, OpType, BuiltinId


# ═══════════════════════════════════════════════════════
# Q-IR Opcode Set
# ═══════════════════════════════════════════════════════

enum QOp
    Nop             = 0
    Load            = 1
    Move            = 2
    Add             = 3
    Sub             = 4
    Mul             = 5
    Div             = 6
    Mod             = 7
    And             = 8
    Or              = 9
    Xor             = 10
    Shl             = 11
    Shr             = 12
    CmpEq           = 20
    CmpNe           = 21
    CmpGt           = 22
    CmpLt           = 23
    CmpGe           = 24
    CmpLe           = 25
    Jump            = 30
    JumpIfNot       = 31
    Label           = 32
    Call            = 33
    CallFunc        = 34
    Ret             = 35
    Print           = 40
    PrintStr        = 41
    Input           = 42
    Alloc           = 50
    Free            = 51
    LoadByte        = 52
    StoreByte       = 53
    LoadWord        = 54
    StoreWord       = 55
    ArrNew          = 60
    ArrPush         = 61
    ArrGet          = 62
    ArrSet          = 63
    ArrLen          = 64
    StrLenOp        = 70
    StrGet          = 71
    StrCat          = 72
    StrEq           = 73
    IToStr          = 74
    StrToI          = 75
    FileOpen        = 80
    FileRead        = 81
    FileWrite       = 82
    FileClose       = 83
    FileWriteByte   = 84
    Exit            = 90
    PatchPoint      = 91
    LoadGlobal      = 92
    StoreGlobal     = 93
    GetArg          = 94
    ArgCount        = 95
end


# ═══════════════════════════════════════════════════════
# Q-IR Operand
# ═══════════════════════════════════════════════════════

enum OperandType
    None        = 0
    VReg        = 1
    Immediate   = 2
    LabelRef    = 3
    StringRef   = 4
    FuncIdx     = 5
end

entity QOperand
    op_type:    OperandType
    vreg:       u32
    imm_val:    i64
end

func q_none() -> QOperand
    out QOperand { op_type: OperandType::None, vreg: 0, imm_val: 0 }
end

func q_vreg(r: u32) -> QOperand
    out QOperand { op_type: OperandType::VReg, vreg: r, imm_val: 0 }
end

func q_imm(val: i64) -> QOperand
    out QOperand { op_type: OperandType::Immediate, vreg: 0, imm_val: val }
end

func q_label(id: u32) -> QOperand
    out QOperand { op_type: OperandType::LabelRef, vreg: id, imm_val: 0 }
end

func q_str_ref(idx: u32) -> QOperand
    out QOperand { op_type: OperandType::StringRef, vreg: idx, imm_val: 0 }
end

func q_func_idx(idx: u32) -> QOperand
    out QOperand { op_type: OperandType::FuncIdx, vreg: idx, imm_val: 0 }
end


# ═══════════════════════════════════════════════════════
# Q-IR Instruction
# ═══════════════════════════════════════════════════════

entity QInstr
    opcode:     QOp
    dest:       QOperand
    src1:       QOperand
    src2:       QOperand
    patch_id:   u32
end

func q_instr(op: QOp, d: QOperand, s1: QOperand, s2: QOperand) -> QInstr
    out QInstr { opcode: op, dest: d, src1: s1, src2: s2, patch_id: 0 }
end


# ═══════════════════════════════════════════════════════
# Q-IR Function & Module
# ═══════════════════════════════════════════════════════

entity QFunction
    name:           String
    body:           Vec<QInstr>
    param_count:    u32
    param_vregs:    Vec<u32>
end

func q_func_new(name: String) -> QFunction
    out QFunction {
        name:        name,
        body:        vec_new<QInstr>(),
        param_count: 0,
        param_vregs: vec_new<u32>()
    }
end

func q_func_emit(f: QFunction, instr: QInstr) -> QFunction
    vec_push(f.body, instr)
    out f
end


entity QModule
    name:       String
    functions:  Vec<QFunction>
    strings:    Vec<String>
end

func q_module_new(name: String) -> QModule
    out QModule {
        name:       name,
        functions:  vec_new<QFunction>(),
        strings:    vec_new<String>()
    }
end

func q_module_add_func(m: QModule, name: String) -> (QModule, i32)
    var f = q_func_new(name)
    vec_push(m.functions, f)
    var idx = vec_len(m.functions) - 1
    out (m, idx as i32)
end

func q_module_add_string(m: QModule, s: String) -> (QModule, u32)
    # Check if string already exists
    var i = 0
    while i < vec_len(m.strings)
        if str_eq(vec_get(m.strings, i), s) do
            out (m, i as u32)
        end
        i = i + 1
    end
    vec_push(m.strings, s)
    out (m, (vec_len(m.strings) - 1) as u32)
end


# ═══════════════════════════════════════════════════════
# Symbol Table
# ═══════════════════════════════════════════════════════

entity SymEntry
    name:       String
    vreg:       u32
end

entity SymTable
    entries:    Vec<SymEntry>
end

func sym_new() -> SymTable
    out SymTable { entries: vec_new<SymEntry>() }
end

func sym_define(st: SymTable, name: String, vreg: u32) -> SymTable
    # Overwrite if exists
    var i = 0
    while i < vec_len(st.entries)
        var entry = vec_get(st.entries, i)
        if str_eq(entry.name, name) do
            entry.vreg = vreg
            vec_set(st.entries, i, entry)
            out st
        end
        i = i + 1
    end
    vec_push(st.entries, SymEntry { name: name, vreg: vreg })
    out st
end

func sym_lookup(st: SymTable, name: String) -> (bool, u32)
    var i = 0
    while i < vec_len(st.entries)
        var entry = vec_get(st.entries, i)
        if str_eq(entry.name, name) do
            out (true, entry.vreg)
        end
        i = i + 1
    end
    out (false, 0)
end


# ═══════════════════════════════════════════════════════
# Enum / Entity Type Registry
# ═══════════════════════════════════════════════════════

entity EnumVariant
    name:   String
    value:  i64
end

entity EnumType
    name:       String
    variants:   Vec<EnumVariant>
end

entity EntityField
    name:   String
    offset: u32
end

entity EntityType
    name:       String
    fields:     Vec<EntityField>
end

func find_enum_type(types: Vec<EnumType>, name: String) -> (bool, i32)
    var i = 0
    while i < vec_len(types)
        var et = vec_get(types, i)
        if str_eq(et.name, name) do
            out (true, i)
        end
        i = i + 1
    end
    out (false, -1)
end

func enum_lookup_variant(et: EnumType, variant: String) -> (bool, i64)
    var i = 0
    while i < vec_len(et.variants)
        var v = vec_get(et.variants, i)
        if str_eq(v.name, variant) do
            out (true, v.value)
        end
        i = i + 1
    end
    out (false, 0)
end

func find_entity_type(types: Vec<EntityType>, name: String) -> (bool, i32)
    var i = 0
    while i < vec_len(types)
        var et = vec_get(types, i)
        if str_eq(et.name, name) do
            out (true, i)
        end
        i = i + 1
    end
    out (false, -1)
end

func entity_field_offset(et: EntityType, field: String) -> (bool, i32)
    var i = 0
    while i < vec_len(et.fields)
        var f = vec_get(et.fields, i)
        if str_eq(f.name, field) do
            out (true, f.offset as i32)
        end
        i = i + 1
    end
    out (false, -1)
end


# ═══════════════════════════════════════════════════════
# Lowering Context
# ═══════════════════════════════════════════════════════

entity LowerCtx
    mod:             QModule
    next_vreg:          u32
    label_counter:      u32
    symbols:            SymTable
    global_symbols:     SymTable
    global_idx_counter: u32
    enum_types:         Vec<EnumType>
    entity_types:       Vec<EntityType>
    current_func_idx:   i32
    loop_depth:         u32
    loop_start_labels:  Vec<u32>
    loop_end_labels:    Vec<u32>
    error_count:        u32
    last_error:         String
    patch_counter:      u32
end

func lower_ctx_new(mod_name: String) -> LowerCtx
    out LowerCtx {
        prog:             q_module_new(mod_name),
        next_vreg:          0,
        label_counter:      0,
        symbols:            sym_new(),
        global_symbols:     sym_new(),
        global_idx_counter: 0,
        enum_types:         vec_new<EnumType>(),
        entity_types:       vec_new<EntityType>(),
        current_func_idx:   -1,
        loop_depth:         0,
        loop_start_labels:  vec_new<u32>(),
        loop_end_labels:    vec_new<u32>(),
        error_count:        0,
        last_error:         str_new(""),
        patch_counter:      0
    }
end

func fresh_vreg(ctx: LowerCtx) -> (LowerCtx, u32)
    var r = ctx.next_vreg
    ctx.next_vreg = ctx.next_vreg + 1
    out (ctx, r)
end

func fresh_label(ctx: LowerCtx) -> (LowerCtx, u32)
    var l = ctx.label_counter
    ctx.label_counter = ctx.label_counter + 1
    out (ctx, l)
end

func lower_error(ctx: LowerCtx, msg: String) -> LowerCtx
    ctx.last_error = msg
    ctx.error_count = ctx.error_count + 1
    out ctx
end

func emit(ctx: LowerCtx, instr: QInstr) -> LowerCtx
    if ctx.current_func_idx >= 0 do
        var f = vec_get(ctx.module.functions, ctx.current_func_idx)
        f = q_func_emit(f, instr)
        vec_set(ctx.module.functions, ctx.current_func_idx, f)
    end
    out ctx
end

func sym_lookup_both(ctx: LowerCtx, name: String) -> (i32, u32)
    # Returns: 0=local, 1=global, -1=not found; and the vreg/index
    var (found, vreg) = sym_lookup(ctx.symbols, name)
    if found do
        out (0, vreg)
    end
    var (found2, idx) = sym_lookup(ctx.global_symbols, name)
    if found2 do
        out (1, idx)
    end
    out (-1, 0)
end

func find_func_index(ctx: LowerCtx, name: String) -> i32
    var i = 0
    while i < vec_len(ctx.module.functions)
        var f = vec_get(ctx.module.functions, i)
        if str_eq(f.name, name) do
            out i as i32
        end
        i = i + 1
    end
    out -1
end


# ═══════════════════════════════════════════════════════
# Expression Lowering
# ═══════════════════════════════════════════════════════

func lower_expr(ctx: LowerCtx, expr: AstNode) -> (LowerCtx, i32)
    if expr.node_type == AstType::LiteralInt do
        var (ctx2, r) = fresh_vreg(ctx)
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.int_val), q_none()))
        out (ctx2, r as i32)
    end

    if expr.node_type == AstType::LiteralFloat do
        var (ctx2, r) = fresh_vreg(ctx)
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.float_val as i64), q_none()))
        out (ctx2, r as i32)
    end

    if expr.node_type == AstType::LiteralStr do
        var (ctx2, str_idx) = q_module_add_string(ctx.module, expr.name)
        ctx.module = ctx2
        var (ctx3, r) = fresh_vreg(ctx)
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(r), q_str_ref(str_idx), q_none()))
        out (ctx3, r as i32)
    end

    if expr.node_type == AstType::Identifier do
        var (scope, idx) = sym_lookup_both(ctx, expr.name)
        if scope < 0 do
            ctx = lower_error(ctx, str_concat(str_new("undefined variable: "), expr.name))
            out (ctx, -1)
        end
        if scope == 1 do
            var (ctx2, rd) = fresh_vreg(ctx)
            ctx2 = emit(ctx2, q_instr(QOp::LoadGlobal, q_vreg(rd), q_imm(idx as i64), q_none()))
            out (ctx2, rd as i32)
        end
        out (ctx, idx as i32)
    end

    if expr.node_type == AstType::BinOp do
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0))
        if lhs < 0 do
            out (ctx2, -1)
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1))
        if rhs < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3)
        var op = QOp::Add
        if expr.op == OpType::Sub do
            op = QOp::Sub
        end
        if expr.op == OpType::Mul do
            op = QOp::Mul
        end
        if expr.op == OpType::Div do
            op = QOp::Div
        end
        if expr.op == OpType::ModOp do
            op = QOp::Mod
        end
        if expr.op == OpType::AndOp do
            op = QOp::And
        end
        if expr.op == OpType::OrOp do
            op = QOp::Or
        end
        if expr.op == OpType::XorOp do
            op = QOp::Xor
        end
        if expr.op == OpType::ShlOp do
            op = QOp::Shl
        end
        if expr.op == OpType::ShrOp do
            op = QOp::Shr
        end
        ctx4 = emit(ctx4, q_instr(op, q_vreg(rd), q_vreg(lhs as u32), q_vreg(rhs as u32)))
        out (ctx4, rd as i32)
    end

    if expr.node_type == AstType::Compare do
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0))
        if lhs < 0 do
            out (ctx2, -1)
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1))
        if rhs < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3)

        if expr.op == OpType::Ne do
            # NE = XOR(EQ(lhs, rhs), 1)
            var (ctx5, eq_r) = fresh_vreg(ctx4)
            var (ctx6, one_r) = fresh_vreg(ctx5)
            ctx6 = emit(ctx6, q_instr(QOp::CmpEq, q_vreg(eq_r), q_vreg(lhs as u32), q_vreg(rhs as u32)))
            ctx6 = emit(ctx6, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()))
            ctx6 = emit(ctx6, q_instr(QOp::Xor, q_vreg(rd), q_vreg(eq_r), q_vreg(one_r)))
            out (ctx6, rd as i32)
        end

        var cmp_op = QOp::CmpEq
        if expr.op == OpType::Gt do
            cmp_op = QOp::CmpGt
        end
        if expr.op == OpType::Lt do
            cmp_op = QOp::CmpLt
        end
        if expr.op == OpType::Ge do
            cmp_op = QOp::CmpGe
        end
        if expr.op == OpType::Le do
            cmp_op = QOp::CmpLe
        end
        ctx4 = emit(ctx4, q_instr(cmp_op, q_vreg(rd), q_vreg(lhs as u32), q_vreg(rhs as u32)))
        out (ctx4, rd as i32)
    end

    if expr.node_type == AstType::Call do
        var fidx = find_func_index(ctx, expr.name)
        if fidx < 0 do
            ctx = lower_error(ctx, str_concat(str_new("undefined function: "), expr.name))
            var (ctx2, rd) = fresh_vreg(ctx)
            ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(rd), q_imm(0), q_none()))
            out (ctx2, rd as i32)
        end

        # Evaluate arguments
        var arg_vregs = vec_new<i32>()
        var i = 0
        while i < vec_len(expr.children)
            var (ctx2, av) = lower_expr(ctx, vec_get(expr.children, i))
            ctx = ctx2
            if av < 0 do
                out (ctx, -1)
            end
            vec_push(arg_vregs, av)
            i = i + 1
        end

        # Move to R0..Rn
        i = 0
        while i < vec_len(arg_vregs)
            var av = vec_get(arg_vregs, i)
            ctx = emit(ctx, q_instr(QOp::Move, q_vreg(i as u32), q_vreg(av as u32), q_none()))
            i = i + 1
        end

        # Emit call
        ctx = emit(ctx, q_instr(QOp::CallFunc, q_none(), q_func_idx(fidx as u32), q_none()))

        # Result in R0
        var (ctx3, rd) = fresh_vreg(ctx)
        ctx3 = emit(ctx3, q_instr(QOp::Move, q_vreg(rd), q_vreg(0), q_none()))
        out (ctx3, rd as i32)
    end

    if expr.node_type == AstType::InputExpr do
        var (ctx2, rd) = fresh_vreg(ctx)
        ctx2 = emit(ctx2, q_instr(QOp::Input, q_vreg(rd), q_none(), q_none()))
        out (ctx2, rd as i32)
    end

    if expr.node_type == AstType::ArrayLiteral do
        var (ctx2, cap_r) = fresh_vreg(ctx)
        var (ctx3, arr_r) = fresh_vreg(ctx2)
        var n = vec_len(expr.children) as i64
        var cap = n
        if cap < 16 do
            cap = 16
        end
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(cap_r), q_imm(cap), q_none()))
        ctx3 = emit(ctx3, q_instr(QOp::ArrNew, q_vreg(arr_r), q_vreg(cap_r), q_none()))
        var i = 0
        while i < vec_len(expr.children)
            var (ctx4, elem) = lower_expr(ctx3, vec_get(expr.children, i))
            ctx3 = ctx4
            if elem >= 0 do
                ctx3 = emit(ctx3, q_instr(QOp::ArrPush, q_none(), q_vreg(arr_r), q_vreg(elem as u32)))
            end
            i = i + 1
        end
        out (ctx3, arr_r as i32)
    end

    if expr.node_type == AstType::IndexAccess do
        var (scope, arr_idx) = sym_lookup_both(ctx, expr.name)
        if scope < 0 do
            ctx = lower_error(ctx, str_new("undefined variable for index"))
            out (ctx, -1)
        end
        var arr_vreg = arr_idx
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx)
            ctx = ctx2
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx as i64), q_none()))
            arr_vreg = gv
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(expr.children, 0))
        if idx_v < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3)
        ctx4 = emit(ctx4, q_instr(QOp::ArrGet, q_vreg(rd), q_vreg(arr_vreg), q_vreg(idx_v as u32)))
        out (ctx4, rd as i32)
    end

    if expr.node_type == AstType::FieldAccess do
        # Check for enum access first
        var base = vec_get(expr.children, 0)
        if base.node_type == AstType::Identifier do
            var (found, eidx) = find_enum_type(ctx.enum_types, base.name)
            if found do
                var et = vec_get(ctx.enum_types, eidx)
                var (ok, val) = enum_lookup_variant(et, expr.name)
                if ok do
                    var (ctx2, r) = fresh_vreg(ctx)
                    ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(val), q_none()))
                    out (ctx2, r as i32)
                end
                ctx = lower_error(ctx, str_concat(str_new("unknown variant: "), expr.name))
                out (ctx, -1)
            end
        end

        # Entity field access
        var (ctx2, base_r) = lower_expr(ctx, vec_get(expr.children, 0))
        if base_r < 0 do
            out (ctx2, -1)
        end

        # Search entity types for field offset
        var offset: i32 = -1
        var j = 0
        while j < vec_len(ctx2.entity_types) and offset < 0
            var et = vec_get(ctx2.entity_types, j)
            var (ok, off) = entity_field_offset(et, expr.name)
            if ok do
                offset = off
            end
            j = j + 1
        end

        if offset < 0 do
            ctx2 = lower_error(ctx2, str_concat(str_new("unknown field: "), expr.name))
            out (ctx2, -1)
        end

        var (ctx3, off_r) = fresh_vreg(ctx2)
        var (ctx4, rd) = fresh_vreg(ctx3)
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset as i64), q_none()))
        ctx4 = emit(ctx4, q_instr(QOp::LoadWord, q_vreg(rd), q_vreg(base_r as u32), q_vreg(off_r)))
        out (ctx4, rd as i32)
    end

    if expr.node_type == AstType::EntityLiteral do
        var (found, eidx) = find_entity_type(ctx.entity_types, expr.name)
        if not found do
            ctx = lower_error(ctx, str_concat(str_new("undefined entity: "), expr.name))
            out (ctx, -1)
        end
        var et = vec_get(ctx.entity_types, eidx)
        var (ctx2, sz_r) = fresh_vreg(ctx)
        var (ctx3, ptr_r) = fresh_vreg(ctx2)
        var sz = vec_len(et.fields) as i64 * 8
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(sz_r), q_imm(sz), q_none()))
        ctx3 = emit(ctx3, q_instr(QOp::Alloc, q_vreg(ptr_r), q_vreg(sz_r), q_none()))

        var i = 0
        while i < vec_len(expr.children)
            var child = vec_get(expr.children, i)
            var (ok, foff) = entity_field_offset(et, child.name2)
            if ok do
                var (ctx4, val_r) = lower_expr(ctx3, child)
                ctx3 = ctx4
                if val_r >= 0 do
                    var (ctx5, off_r) = fresh_vreg(ctx3)
                    ctx3 = ctx5
                    ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(off_r), q_imm(foff as i64), q_none()))
                    ctx3 = emit(ctx3, q_instr(QOp::StoreWord, q_vreg(val_r as u32), q_vreg(ptr_r), q_vreg(off_r)))
                end
            end
            i = i + 1
        end
        out (ctx3, ptr_r as i32)
    end

    ctx = lower_error(ctx, str_new("unsupported expression type"))
    out (ctx, -1)
end


# ═══════════════════════════════════════════════════════
# Statement Lowering
# ═══════════════════════════════════════════════════════

func lower_stmt(ctx: LowerCtx, stmt: AstNode) -> LowerCtx

    if stmt.node_type == AstType::VarDecl or stmt.node_type == AstType::ConstDecl do
        var (ctx2, r) = fresh_vreg(ctx)
        ctx2.symbols = sym_define(ctx2.symbols, stmt.name, r)
        if vec_len(stmt.children) > 0 do
            var (ctx3, val) = lower_expr(ctx2, vec_get(stmt.children, 0))
            if val >= 0 and (val as u32) != r do
                ctx3 = emit(ctx3, q_instr(QOp::Move, q_vreg(r), q_vreg(val as u32), q_none()))
            end
            out ctx3
        else
            ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(0), q_none()))
            out ctx2
        end
    end

    if stmt.node_type == AstType::Assign do
        var (scope, idx) = sym_lookup_both(ctx, stmt.name)
        if scope < 0 do
            out lower_error(ctx, str_concat(str_new("assign to undefined: "), stmt.name))
        end
        var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0))
        if val < 0 do
            out ctx2
        end
        if scope == 1 do
            ctx2 = emit(ctx2, q_instr(QOp::StoreGlobal, q_none(), q_imm(idx as i64), q_vreg(val as u32)))
        else
            if (val as u32) != idx do
                ctx2 = emit(ctx2, q_instr(QOp::Move, q_vreg(idx), q_vreg(val as u32), q_none()))
            end
        end
        out ctx2
    end

    if stmt.node_type == AstType::IndexAssign do
        var (scope, arr_idx) = sym_lookup_both(ctx, stmt.name)
        if scope < 0 do
            out lower_error(ctx, str_new("index assign to undefined variable"))
        end
        var arr_vreg = arr_idx
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx)
            ctx = ctx2
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx as i64), q_none()))
            arr_vreg = gv
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(stmt.children, 0))
        var (ctx4, val_v) = lower_expr(ctx3, vec_get(stmt.children, 1))
        if idx_v >= 0 and val_v >= 0 do
            ctx4 = emit(ctx4, q_instr(QOp::ArrSet, q_vreg(val_v as u32), q_vreg(arr_vreg), q_vreg(idx_v as u32)))
        end
        out ctx4
    end

    if stmt.node_type == AstType::PrintStmt do
        var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0))
        if val >= 0 do
            ctx2 = emit(ctx2, q_instr(QOp::Print, q_none(), q_vreg(val as u32), q_none()))
        end
        out ctx2
    end

    if stmt.node_type == AstType::ReturnStmt do
        if vec_len(stmt.children) > 0 do
            var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0))
            if val >= 0 do
                ctx2 = emit(ctx2, q_instr(QOp::Ret, q_none(), q_vreg(val as u32), q_none()))
            end
            out ctx2
        else
            ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_none(), q_none()))
            out ctx
        end
    end

    if stmt.node_type == AstType::IfStmt do
        var (ctx2, cond_r) = lower_expr(ctx, vec_get(stmt.children, 0))
        if cond_r < 0 do
            out ctx2
        end
        var (ctx3, else_lbl) = fresh_label(ctx2)
        var (ctx4, end_lbl) = fresh_label(ctx3)

        ctx4 = emit(ctx4, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r as u32), q_label(else_lbl)))

        # Then block
        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1))

        if vec_len(stmt.children) > 2 do
            ctx4 = emit(ctx4, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()))
        end

        # Else label
        var lbl = q_instr(QOp::Label, q_none(), q_none(), q_none())
        lbl.patch_id = else_lbl
        ctx4 = emit(ctx4, lbl)

        # Else block
        if vec_len(stmt.children) > 2 do
            ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 2))
            lbl.patch_id = end_lbl
            ctx4 = emit(ctx4, lbl)
        end
        out ctx4
    end

    if stmt.node_type == AstType::WhileStmt do
        var (ctx2, loop_lbl) = fresh_label(ctx)
        var (ctx3, end_lbl) = fresh_label(ctx2)

        var lbl = q_instr(QOp::Label, q_none(), q_none(), q_none())
        lbl.patch_id = loop_lbl
        ctx3 = emit(ctx3, lbl)

        var (ctx4, cond_r) = lower_expr(ctx3, vec_get(stmt.children, 0))
        if cond_r < 0 do
            out ctx4
        end
        ctx4 = emit(ctx4, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r as u32), q_label(end_lbl)))

        # Push loop labels
        vec_push(ctx4.loop_start_labels, loop_lbl)
        vec_push(ctx4.loop_end_labels, end_lbl)
        ctx4.loop_depth = ctx4.loop_depth + 1

        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1))

        ctx4.loop_depth = ctx4.loop_depth - 1

        ctx4 = emit(ctx4, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()))

        lbl.patch_id = end_lbl
        ctx4 = emit(ctx4, lbl)
        out ctx4
    end

    if stmt.node_type == AstType::LoopStmt do
        # Counter-based loop
        var (ctx2, counter) = fresh_vreg(ctx)
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(counter), q_imm(0), q_none()))

        var (ctx3, limit_r) = lower_expr(ctx2, vec_get(stmt.children, 0))
        if limit_r < 0 do
            out ctx3
        end

        var (ctx4, loop_lbl) = fresh_label(ctx3)
        var (ctx5, cont_lbl) = fresh_label(ctx4)
        var (ctx6, end_lbl) = fresh_label(ctx5)

        var lbl = q_instr(QOp::Label, q_none(), q_none(), q_none())
        lbl.patch_id = loop_lbl
        ctx6 = emit(ctx6, lbl)

        var (ctx7, cmp_r) = fresh_vreg(ctx6)
        ctx7 = emit(ctx7, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(counter), q_vreg(limit_r as u32)))
        ctx7 = emit(ctx7, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)))

        vec_push(ctx7.loop_start_labels, cont_lbl)
        vec_push(ctx7.loop_end_labels, end_lbl)
        ctx7.loop_depth = ctx7.loop_depth + 1

        ctx7 = lower_stmt(ctx7, vec_get(stmt.children, 1))

        ctx7.loop_depth = ctx7.loop_depth - 1

        lbl.patch_id = cont_lbl
        ctx7 = emit(ctx7, lbl)
        var (ctx8, one_r) = fresh_vreg(ctx7)
        ctx8 = emit(ctx8, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()))
        ctx8 = emit(ctx8, q_instr(QOp::Add, q_vreg(counter), q_vreg(counter), q_vreg(one_r)))
        ctx8 = emit(ctx8, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()))

        lbl.patch_id = end_lbl
        ctx8 = emit(ctx8, lbl)
        out ctx8
    end

    if stmt.node_type == AstType::ForRange do
        var (ctx2, start_v) = lower_expr(ctx, vec_get(stmt.children, 0))
        if start_v < 0 do
            out ctx2
        end
        var (ctx3, end_v) = lower_expr(ctx2, vec_get(stmt.children, 1))
        if end_v < 0 do
            out ctx3
        end

        var (ctx4, loop_var) = fresh_vreg(ctx3)
        ctx4.symbols = sym_define(ctx4.symbols, stmt.name, loop_var)
        ctx4 = emit(ctx4, q_instr(QOp::Move, q_vreg(loop_var), q_vreg(start_v as u32), q_none()))

        var (ctx5, loop_lbl) = fresh_label(ctx4)
        var (ctx6, end_lbl) = fresh_label(ctx5)
        var (ctx7, cont_lbl) = fresh_label(ctx6)

        var lbl = q_instr(QOp::Label, q_none(), q_none(), q_none())
        lbl.patch_id = loop_lbl
        ctx7 = emit(ctx7, lbl)

        var (ctx8, cmp_r) = fresh_vreg(ctx7)
        ctx8 = emit(ctx8, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(loop_var), q_vreg(end_v as u32)))
        ctx8 = emit(ctx8, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)))

        vec_push(ctx8.loop_start_labels, cont_lbl)
        vec_push(ctx8.loop_end_labels, end_lbl)
        ctx8.loop_depth = ctx8.loop_depth + 1

        ctx8 = lower_stmt(ctx8, vec_get(stmt.children, 2))

        ctx8.loop_depth = ctx8.loop_depth - 1

        lbl.patch_id = cont_lbl
        ctx8 = emit(ctx8, lbl)
        var (ctx9, one_r) = fresh_vreg(ctx8)
        ctx9 = emit(ctx9, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()))
        ctx9 = emit(ctx9, q_instr(QOp::Add, q_vreg(loop_var), q_vreg(loop_var), q_vreg(one_r)))
        ctx9 = emit(ctx9, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()))

        lbl.patch_id = end_lbl
        ctx9 = emit(ctx9, lbl)
        out ctx9
    end

    if stmt.node_type == AstType::Block do
        var i = 0
        while i < vec_len(stmt.children)
            ctx = lower_stmt(ctx, vec_get(stmt.children, i))
            i = i + 1
        end
        out ctx
    end

    if stmt.node_type == AstType::BreakStmt do
        if ctx.loop_depth == 0 do
            out lower_error(ctx, str_new("break outside of loop"))
        end
        var end_lbl = vec_get(ctx.loop_end_labels, (ctx.loop_depth - 1) as i32)
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()))
        out ctx
    end

    if stmt.node_type == AstType::ContinueStmt do
        if ctx.loop_depth == 0 do
            out lower_error(ctx, str_new("continue outside of loop"))
        end
        var start_lbl = vec_get(ctx.loop_start_labels, (ctx.loop_depth - 1) as i32)
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(start_lbl), q_none()))
        out ctx
    end

    if stmt.node_type == AstType::EnumDef do
        var et = EnumType { name: stmt.name, variants: vec_new<EnumVariant>() }
        var i = 0
        while i < vec_len(stmt.children)
            var v = vec_get(stmt.children, i)
            vec_push(et.variants, EnumVariant { name: v.name, value: v.int_val })
            i = i + 1
        end
        vec_push(ctx.enum_types, et)
        out ctx
    end

    if stmt.node_type == AstType::EntityDef do
        var et = EntityType { name: stmt.name, fields: vec_new<EntityField>() }
        var i = 0
        while i < vec_len(stmt.children)
            var f = vec_get(stmt.children, i)
            vec_push(et.fields, EntityField { name: f.name, offset: i as u32 })
            i = i + 1
        end
        vec_push(ctx.entity_types, et)
        out ctx
    end

    if stmt.node_type == AstType::FieldAssign do
        var (scope, idx) = sym_lookup_both(ctx, stmt.name)
        if scope < 0 do
            out lower_error(ctx, str_concat(str_new("field assign to undefined: "), stmt.name))
        end
        var base_vreg = idx
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx)
            ctx = ctx2
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(idx as i64), q_none()))
            base_vreg = gv
        end

        # Find field offset across all entity types
        var offset: i32 = -1
        var j = 0
        while j < vec_len(ctx.entity_types) and offset < 0
            var et = vec_get(ctx.entity_types, j)
            var (ok, off) = entity_field_offset(et, stmt.name2)
            if ok do
                offset = off
            end
            j = j + 1
        end
        if offset < 0 do
            out lower_error(ctx, str_concat(str_new("unknown field: "), stmt.name2))
        end

        var (ctx3, val_r) = lower_expr(ctx, vec_get(stmt.children, 0))
        if val_r < 0 do
            out ctx3
        end
        var (ctx4, off_r) = fresh_vreg(ctx3)
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset as i64), q_none()))
        ctx4 = emit(ctx4, q_instr(QOp::StoreWord, q_vreg(val_r as u32), q_vreg(base_vreg), q_vreg(off_r)))
        out ctx4
    end

    if stmt.node_type == AstType::CheckCpu or stmt.node_type == AstType::PatchPoint do
        ctx.patch_counter = ctx.patch_counter + 1
        var pp = q_instr(QOp::PatchPoint, q_none(), q_none(), q_none())
        pp.patch_id = ctx.patch_counter
        ctx = emit(ctx, pp)
        out ctx
    end

    # Module system (compile-time only)
    if stmt.node_type == AstType::ImportStmt or
       stmt.node_type == AstType::ModuleStmt or
       stmt.node_type == AstType::ExportStmt or
       stmt.node_type == AstType::IncludeStmt do
        out ctx
    end

    # Default: try as expression statement
    var (ctx2, _) = lower_expr(ctx, stmt)
    out ctx2
end


# ═══════════════════════════════════════════════════════
# Function Lowering
# ═══════════════════════════════════════════════════════

func lower_func_def(ctx: LowerCtx, func_def: AstNode) -> LowerCtx
    var (ctx2, fidx) = q_module_add_func(ctx.module, func_def.name)
    ctx.module = ctx2
    ctx.current_func_idx = fidx

    # Save local scope
    var saved_syms = ctx.symbols
    ctx.symbols = sym_new()

    # Register parameters
    var body_idx = vec_len(func_def.children) - 1
    var i = 0
    while i < body_idx
        var param = vec_get(func_def.children, i)
        if param.node_type == AstType::Identifier do
            var (ctx3, pr) = fresh_vreg(ctx)
            ctx = ctx3
            ctx.symbols = sym_define(ctx.symbols, param.name, pr)
        end
        i = i + 1
    end

    # Lower body
    if vec_len(func_def.children) > 0 do
        ctx = lower_stmt(ctx, vec_get(func_def.children, body_idx))
    end

    # Restore scope
    ctx.symbols = saved_syms
    ctx.current_func_idx = -1
    out ctx
end


# ═══════════════════════════════════════════════════════
# Program Lowering
# ═══════════════════════════════════════════════════════

func lower_program(ctx: LowerCtx, program: AstNode) -> LowerCtx
    # Pass 0: register enum/entity types
    var i = 0
    while i < vec_len(program.children)
        var child = vec_get(program.children, i)
        if child.node_type == AstType::EnumDef or child.node_type == AstType::EntityDef do
            ctx = lower_stmt(ctx, child)
        end
        i = i + 1
    end

    # Pass 1: register function names for forward references
    var has_main = false
    var has_top_stmt = false
    i = 0
    while i < vec_len(program.children)
        var child = vec_get(program.children, i)
        if child.node_type == AstType::FuncDef do
            var (mod2, _) = q_module_add_func(ctx.module, child.name)
            ctx.module = mod2
            if str_eq(child.name, str_new("main")) do
                has_main = true
            end
        else
            if not is_metadata(child.node_type) do
                has_top_stmt = true
            end
        end
        i = i + 1
    end

    # Pass 2: lower function bodies and top-level code
    if not has_main do
        var (mod3, main_idx) = q_module_add_func(ctx.module, str_new("__main__"))
        ctx.module = mod3
        ctx.current_func_idx = main_idx

        i = 0
        while i < vec_len(program.children)
            var child = vec_get(program.children, i)
            if child.node_type != AstType::FuncDef do
                ctx = lower_stmt(ctx, child)
            end
            i = i + 1
        end

        # Implicit return 0
        var (ctx2, rz) = fresh_vreg(ctx)
        ctx = ctx2
        ctx = emit(ctx, q_instr(QOp::Load, q_vreg(rz), q_imm(0), q_none()))
        ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_vreg(rz), q_none()))
        ctx.current_func_idx = -1
    end

    # Lower all function definitions
    i = 0
    while i < vec_len(program.children)
        var child = vec_get(program.children, i)
        if child.node_type == AstType::FuncDef do
            ctx = lower_func_def(ctx, child)
        end
        i = i + 1
    end

    out ctx
end


func is_metadata(t: AstType) -> bool
    out t == AstType::EnumDef or t == AstType::EntityDef or
        t == AstType::ModuleStmt or t == AstType::ImportStmt or
        t == AstType::ExportStmt or t == AstType::IncludeStmt
end


# ═══════════════════════════════════════════════════════
# Liveness Analysis
# ═══════════════════════════════════════════════════════

entity LiveInterval
    vreg:       u32
    start:      u32
    end_pos:    u32
    phys_reg:   i32
    spill_slot: i32
end

func compute_liveness(func: QFunction) -> Vec<LiveInterval>
    var intervals = vec_new<LiveInterval>()

    var i = 0
    while i < vec_len(func.body)
        var instr = vec_get(func.body, i)

        # Definition (dest)
        if instr.dest.op_type == OperandType::VReg do
            var iv = find_or_create_interval(intervals, instr.dest.vreg)
            intervals = iv.0
            var idx = iv.1
            var interval = vec_get(intervals, idx)
            if (i as u32) < interval.start do
                interval.start = i as u32
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as u32
            end
            vec_set(intervals, idx, interval)
        end

        # Use (src1)
        if instr.src1.op_type == OperandType::VReg do
            var iv = find_or_create_interval(intervals, instr.src1.vreg)
            intervals = iv.0
            var idx = iv.1
            var interval = vec_get(intervals, idx)
            if (i as u32) < interval.start do
                interval.start = i as u32
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as u32
            end
            vec_set(intervals, idx, interval)
        end

        # Use (src2)
        if instr.src2.op_type == OperandType::VReg do
            var iv = find_or_create_interval(intervals, instr.src2.vreg)
            intervals = iv.0
            var idx = iv.1
            var interval = vec_get(intervals, idx)
            if (i as u32) < interval.start do
                interval.start = i as u32
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as u32
            end
            vec_set(intervals, idx, interval)
        end

        i = i + 1
    end
    out intervals
end


func find_or_create_interval(intervals: Vec<LiveInterval>, vreg: u32) -> (Vec<LiveInterval>, i32)
    var i = 0
    while i < vec_len(intervals)
        var iv = vec_get(intervals, i)
        if iv.vreg == vreg do
            out (intervals, i)
        end
        i = i + 1
    end
    vec_push(intervals, LiveInterval {
        vreg:       vreg,
        start:      0xFFFFFFFF as u32,
        end_pos:    0,
        phys_reg:   -1,
        spill_slot: -1
    })
    out (intervals, vec_len(intervals) - 1)
end


# ═══════════════════════════════════════════════════════
# Linear-Scan Register Allocation
# ═══════════════════════════════════════════════════════

func regalloc_linear_scan(intervals: Vec<LiveInterval>, num_phys_regs: u32) -> Vec<LiveInterval>
    if num_phys_regs == 0 or vec_len(intervals) == 0 do
        out intervals
    end

    # Sort by start position (bubble sort — simple for correctness)
    var n = vec_len(intervals)
    var s = 0
    while s < n - 1
        var t = 0
        while t < n - s - 1
            var a = vec_get(intervals, t)
            var b = vec_get(intervals, t + 1)
            if a.start > b.start do
                vec_set(intervals, t, b)
                vec_set(intervals, t + 1, a)
            end
            t = t + 1
        end
        s = s + 1
    end

    # Free register pool (bit-set, max 32 regs)
    var max_regs = num_phys_regs
    if max_regs > 32 do
        max_regs = 32
    end
    var free_mask: u32 = (1 shl max_regs) - 1

    # Active list (indices into intervals)
    var active = vec_new<i32>()
    var next_spill = 0

    var i = 0
    while i < n
        var cur = vec_get(intervals, i)

        # Expire finished intervals
        var new_active = vec_new<i32>()
        var a = 0
        while a < vec_len(active)
            var aidx = vec_get(active, a)
            var act = vec_get(intervals, aidx)
            if act.end_pos < cur.start do
                # Release register
                if act.phys_reg >= 0 do
                    free_mask = free_mask or (1 shl (act.phys_reg as u32))
                end
            else
                vec_push(new_active, aidx)
            end
            a = a + 1
        end
        active = new_active

        # Try to allocate a free register
        if free_mask != 0 do
            # Find lowest set bit
            var bit: u32 = 0
            var tmp = free_mask
            while (tmp and 1) == 0
                bit = bit + 1
                tmp = tmp shr 1
            end

            cur.phys_reg = bit as i32
            free_mask = free_mask and (not (1 shl bit))
            vec_set(intervals, i, cur)

            # Insert into active (sorted by end)
            var pos = vec_len(active)
            var k = 0
            while k < vec_len(active)
                var aidx = vec_get(active, k)
                var act = vec_get(intervals, aidx)
                if act.end_pos > cur.end_pos do
                    pos = k
                    k = vec_len(active)  # break
                end
                k = k + 1
            end
            # Insert at pos
            vec_push(active, i)  # placeholder
            var j = vec_len(active) - 1
            while j > pos
                vec_set(active, j, vec_get(active, j - 1))
                j = j - 1
            end
            vec_set(active, pos, i)
        else
            # Spill
            if vec_len(active) > 0 do
                var last_idx = vec_get(active, vec_len(active) - 1)
                var spill_cand = vec_get(intervals, last_idx)
                if spill_cand.end_pos > cur.end_pos do
                    cur.phys_reg = spill_cand.phys_reg
                    spill_cand.phys_reg = -1
                    spill_cand.spill_slot = next_spill
                    next_spill = next_spill + 1
                    vec_set(intervals, last_idx, spill_cand)
                    vec_set(intervals, i, cur)
                    # Remove last from active
                    var new_active2 = vec_new<i32>()
                    var k = 0
                    while k < vec_len(active) - 1
                        vec_push(new_active2, vec_get(active, k))
                        k = k + 1
                    end
                    active = new_active2
                    # Insert current
                    vec_push(active, i)
                else
                    cur.phys_reg = -1
                    cur.spill_slot = next_spill
                    next_spill = next_spill + 1
                    vec_set(intervals, i, cur)
                end
            else
                cur.phys_reg = -1
                cur.spill_slot = next_spill
                next_spill = next_spill + 1
                vec_set(intervals, i, cur)
            end
        end

        i = i + 1
    end

    out intervals
end


# ═══════════════════════════════════════════════════════
# Tail-Call Optimization
# ═══════════════════════════════════════════════════════

func tco_pass(func: QFunction) -> (QFunction, i32)
    var tco_count = 0
    var body_len = vec_len(func.body)
    if body_len < 2 do
        out (func, 0)
    end

    var i = 0
    while i + 1 < body_len
        var cur = vec_get(func.body, i)
        var next_instr = vec_get(func.body, i + 1)

        # Pattern: CALL followed by RET
        if cur.opcode == QOp::Call and next_instr.opcode == QOp::Ret do
            cur.opcode = QOp::Jump
            cur.dest = q_none()
            cur.src2 = q_none()
            vec_set(func.body, i, cur)

            next_instr.opcode = QOp::Nop
            next_instr.dest = q_none()
            next_instr.src1 = q_none()
            next_instr.src2 = q_none()
            vec_set(func.body, i + 1, next_instr)

            tco_count = tco_count + 1
            i = i + 2
        else
            i = i + 1
        end
    end
    out (func, tco_count)
end


# ═══════════════════════════════════════════════════════
# Get Physical Register for a VReg
# ═══════════════════════════════════════════════════════

func get_phys_reg(intervals: Vec<LiveInterval>, vreg: u32) -> i32
    var i = 0
    while i < vec_len(intervals)
        var iv = vec_get(intervals, i)
        if iv.vreg == vreg do
            out iv.phys_reg
        end
        i = i + 1
    end
    out -1
end
