# vir/compiler/virc.vri — Pure Vir Compiler Driver (Zero C/Python)
# =================================================================
# The self-hosting Vir compiler entry point. Uses ONLY the vir/rt/*
# modules (direct syscalls, mmap allocator, raw I/O). No Python,
# no C runtime, no libc, no external linker.
#
# Pipeline
#   source.vri → lex → parse → lower → regalloc → codegen → Mach-O/ELF
#
# This is the file that gets compiled by the Python compiler (Stage 0),
# then the resulting binary compiles itself (Stage 1), completing bootstrap.
#
# Usage
#   ./virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]

module vir.compiler.virc

# ── Runtime layer (pure Vir, no C) ──
include vir.rt.syscall
import sys_exit, sys_write, SYS_EXIT, SYS_WRITE from vir.rt.syscall
include vir.rt.alloc
import vir_alloc, vir_free, vir_realloc, heap_init from vir.rt.alloc
include vir.rt.string_rt
import rt_strlen, rt_strcmp, rt_streq, rt_strcat, rt_strdup,
       rt_itoa, rt_atoi, StringBuilder, sb_new, sb_append,
       sb_append_char, sb_append_int, sb_to_string, sb_free,
       str_from_cstr, fat_str_len from vir.rt.string_rt
include vir.rt.io
import print_str, print_int, print_ln, print_newline, eprint_ln,
       file_open_read, file_read_all, file_close,
       write_file_bytes, read_file_str from vir.rt.io
include vir.rt.vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt,
       vec_free_rt, bvec_new, bvec_push, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr,
       bvec_free from vir.rt.vec_rt
include vir.rt.start
import rt_argc, rt_argv from vir.rt.start
# Note: vir.str.string removed — compiler modules use stdlib/vir/string.vri shim instead

# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──
include vir.rt.macho
import MachOBuilder, macho_new, macho_write_to_file from vir.rt.macho
include vir.rt.elf
import ElfBuilder, elf_new, elf_write_to_file from vir.rt.elf

# ── Compiler modules (self-hosting, pure Vir) ──
include vir.compiler.lexer
import Lexer, TokType, Token, lexer_new, tokenize, lexer_lex from vir.compiler.lexer
include vir.compiler.parser
import Parser, AstNode, AstType, parser_new, parse_program from vir.compiler.parser
include vec
import Vec, vec_len, vec_get from vec


# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

const VERSION: "virc 2.1.0 (self-hosted)"

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64
    out_fmt:        int;    # 0=Mach-O, 1=ELF
    verbose:        int    # 0=quiet, 1=verbose
end.
func default_config:
    out CompilerConfig (
        input_path:  0,
        output_path: 0,
        target:      0,        # ARM64 (default on macOS)
        out_fmt:     0,        # Mach-O (default on macOS)
        verbose:     1
    )
end.
func cstr_ends_with_vri(s: int):
    if s == 0 do out 0 end
    let l = rt_strlen(s)
    if l < 4 do out 0 end
    if native_read_u8(s, l - 4) != 46 do out 0 end
    if native_read_u8(s, l - 3) != 118 do out 0 end
    if native_read_u8(s, l - 2) != 114 do out 0 end
    if native_read_u8(s, l - 1) != 105 do out 0 end
    out 1
end.

# ═══════════════════════════════════════════════════════
# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func parse_args:
    let argc = arg_count()
    let cfg = default_config()

    var base_idx = 0
    if argc > 1 and cstr_ends_with_vri(get_arg(0)) == 0 do
        base_idx = 1
    end

    if argc <= base_idx do
        print_ln("virc: error_msg: no input file")
        print_ln("Usage: virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]")
        exit_prog(1)
    end

    # First positional argument is the input file
    cfg.input_path = get_arg(base_idx)

    # Default output: a.out
    cfg.output_path = "a.out"

    var i = base_idx + 1
    when i < argc loop
        let arg = get_arg(i)

        if rt_streq(arg, "-o") do
            if i + 1 < argc do
                i = i + 1
                cfg.output_path = get_arg(i)
            else
                print_ln("virc: error_msg: -o requires an argument")
                exit_prog(1)
            end

        eif rt_streq(arg, "--target") do
            if i + 1 < argc do
                i = i + 1
                let tgt = get_arg(i)
                if rt_streq(tgt, "arm64") or rt_streq(tgt, "aarch64") do
                    cfg.target = 0
                eif rt_streq(tgt, "x86_64") or rt_streq(tgt, "x86-64") do
                    cfg.target = 1
                eif rt_streq(tgt, "wasm32") or rt_streq(tgt, "wasm") do
                    cfg.target = 2
                else
                    print_ln("virc: error_msg: unknown target (use arm64, x86_64 or wasm32)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "--format") do
            if i + 1 < argc do
                i = i + 1
                let fmt = get_arg(i)
                if rt_streq(fmt, "macho") do
                    cfg.out_fmt = 0
                eif rt_streq(fmt, "elf") do
                    cfg.out_fmt = 1
                eif rt_streq(fmt, "wasm") do
                    cfg.out_fmt = 2
                else
                    print_ln("virc: error_msg: unknown format (use macho, elf or wasm)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "--hir") do
            set_pipeline_hir_mode(1)

        eif rt_streq(arg, "--mir-full") do
            set_pipeline_mir_full(1)

        eif rt_streq(arg, "-q") or rt_streq(arg, "--quiet") do
            cfg.verbose = 0

        eif rt_streq(arg, "-v") or rt_streq(arg, "--version") do
            print_ln(VERSION)
            exit_prog(0)

        eif rt_streq(arg, "-h") or rt_streq(arg, "--help") do
            print_ln("virc — Vir Self-Hosting Compiler")
            print_ln("")
            print_ln("Usage: virc <input.vri> [-o output] [options]")
            print_ln("")
            print_ln("Options:")
            print_ln("  -o <file>           Output file (default: a.out)")
            print_ln("  --target <arch>     arm64, x86_64 or wasm32 (default: arm64)")
            print_ln("  --format <fmt>      macho, elf or wasm (default: macho)")
            print_ln("  --mir-full          Enable full MIR optimization pipeline")
            print_ln("  -q, --quiet         Suppress progress messages")
            print_ln("  -v, --version       Print version")
            print_ln("  -h, --help          Print this help")
            exit_prog(0)
        end

        i = i + 1
    end

    out cfg
end.
# ═══════════════════════════════════════════════════════
# Compiler Pipeline
# ═══════════════════════════════════════════════════════

func virc_compile(cfg: CompilerConfig):


    let verbose = cfg.verbose

    # ── Read source file ──
    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: reading ")
        sb = sb_append(sb, cfg.input_path)
        sb = sb_append(sb, "...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    let source_raw = read_file_str(cfg.input_path)
    if source_raw == 0 do
        print_ln("virc: error_msg: cannot read input file")
        exit_prog(1)
    end

    let src_len = rt_strlen(source_raw)
    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, src_len)
        sb = sb_append(sb, " bytes source")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 0: Preprocess includes + imports ──
    var last_slash = -1
    var pi = 0
    let path_len = rt_strlen(cfg.input_path)
    when pi < path_len loop
        if native_read_u8(cfg.input_path, pi) == 47 do
            last_slash = pi
        end
        pi = pi + 1
    end
    if last_slash >= 0 do
        let dbuf = vir_alloc(last_slash + 1)
        pi = 0
        when pi < last_slash loop
            native_write_u8(dbuf, pi, native_read_u8(cfg.input_path, pi))
            pi = pi + 1
        end
        native_write_u8(dbuf, last_slash, 0)
        g_inc_base = dbuf
    end

    var source_fat = str_from_cstr(source_raw)
    source_fat = text_ascii_sanitize(source_fat)
    print_ln("virc: expanding includes...")
    source_fat = expand_includes_text(source_fat)
    if g_inc_err == 1 do
        print_ln("virc: include expansion failed")
        exit_prog(1)
    end
    print_ln("virc: expanding imports...")
    source_fat = expand_imports_text(source_fat)
    if verbose == 1 do
        let sb_pre = sb_new()
        sb_pre = sb_append(sb_pre, "virc: ")
        sb_pre = sb_append_int(sb_pre, fat_str_len(source_fat))
        sb_pre = sb_append(sb_pre, " bytes after preprocess")
        print_ln(sb_to_string(sb_pre))
        sb_free(sb_pre)
    end

    # ── Step 1: Tokenize ──
    if verbose == 1 do
        print_ln("virc: tokenizing...")
    end

    # Snapshot before lexer_new — CALLs above can clobber source_fat (native ABI).
    held_src = source_fat
    let lex = lexer_new(held_src)
    lex = tokenize(lex)

    if fat_str_len(lex.error_msg) > 0 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: lex error_msg: ")
        sb = sb_append(sb, lex.error_msg)
        print_ln(sb_to_string(sb))
        sb_free(sb)
        exit_prog(1)
    end

    # Parser expects rt-vec of token pointers; lexer uses collections Vec.
    let tok_count = vec_len(lex.tokens)
    let tok_rt = vec_new_rt()
    let ti = 0
    when ti < tok_count loop
        let tok = vec_get(lex.tokens, ti)
        tok_rt = vec_push_rt(tok_rt, tok)
        ti = ti + 1
    end

    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, tok_count)
        sb = sb_append(sb, " tokens")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 2: Parse ──
    if verbose == 1 do
        print_ln("virc: parsing...")
    end

    let parser = parser_new(tok_rt)
    var (parser2, ast) = parse_program(parser)

    if verbose == 1 do
        let k_count = vec_len_rt(ast.children)
        let sb_ast = sb_new()
        sb_ast = sb_append(sb_ast, "virc: ast children ")
        sb_ast = sb_append_int(sb_ast, k_count)
        print_ln(sb_to_string(sb_ast))
        sb_free(sb_ast)
    end

    # Report parse errors
    if rt_strlen(parser2.error_msg) > 0 do
        let sb_pe = sb_new()
        sb_pe = sb_append(sb_pe, "virc: parse error (line ")
        sb_pe = sb_append_int(sb_pe, parser2.error_line)
        sb_pe = sb_append(sb_pe, "): ")
        sb_pe = sb_append(sb_pe, parser2.error_msg)
        print_ln(sb_to_string(sb_pe))
        sb_free(sb_pe)
    end
    exit_prog(0)
    out 0
end.
# ═══════════════════════════════════════════════════════
# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func main:
    print_ln("====================================")
    print_ln("  virc — Vir Self-Hosting Compiler")
    print_ln("  v2.2.0 — HIR/MIR/LIR pipeline")
    print_ln("====================================")

    let cfg = parse_args()
    let result = virc_compile(cfg)
    exit_prog(result)
    out result
end.
export vir_main, virc_compile, parse_args, CompilerConfig
