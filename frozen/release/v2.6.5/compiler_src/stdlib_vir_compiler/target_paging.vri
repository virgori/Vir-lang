##
 * vir/compiler/target_paging.vri — Target Memory Paging & Segment Alignment
 * =========================================================================
 * Provides authoritative page size and segment alignment constants for:
 *   - ARM64 Darwin (Mach-O): 16KB (0x4000)
 *   - ARM64 Linux (ELF):     64KB (0x10000) — safe for 4K/16K/64K kernels
 *   - x86_64 (All OS):       4KB  (0x1000)
 *   - RISC-V 64 Linux (ELF): 64KB (0x10000)
 *   - WebAssembly:           64KB (0x10000 / 65536) — W3C WASM Spec §2.5
 ##

module vir.compiler.target_paging

include types
include compiler.mc
import TargetArch, TargetOS, ObjectFormat from compiler.mc

const PAGE_SIZE_ARM64_DARWIN: int = 0x4000;   # 16KB (16384 bytes)
const PAGE_SIZE_ARM64_LINUX:  int = 0x10000;  # 64KB (65536 bytes)
const PAGE_SIZE_X86:          int = 0x1000;   # 4KB  (4096 bytes)
const PAGE_SIZE_RISCV64:      int = 0x10000;  # 64KB (65536 bytes)
const PAGE_SIZE_WASM:         int = 65536;    # 64KB (65536 bytes)

func target_get_page_size(arch: int, os: int, format: int) -> int:
    if arch == TargetArch.ARM64 or arch == 2 or arch == 0 do
        if os == TargetOS.Darwin or format == ObjectFormat.MachO or format == 0 do
            out PAGE_SIZE_ARM64_DARWIN
        else
            out PAGE_SIZE_ARM64_LINUX
        end
    end

    if arch == TargetArch.X86_64 or arch == 1 do
        out PAGE_SIZE_X86
    end

    if arch == TargetArch.RISCV64 or arch == 3 do
        out PAGE_SIZE_RISCV64
    end

    if arch == TargetArch.Wasm32 or arch == 4 or format == ObjectFormat.Wasm do
        out PAGE_SIZE_WASM
    end

    # Fallback to 4KB
    out PAGE_SIZE_X86
end.

export PAGE_SIZE_ARM64_DARWIN, PAGE_SIZE_ARM64_LINUX, PAGE_SIZE_X86,
       PAGE_SIZE_RISCV64, PAGE_SIZE_WASM, target_get_page_size

