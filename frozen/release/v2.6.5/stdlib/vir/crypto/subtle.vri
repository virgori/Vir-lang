##
 * vir/crypto/subtle.vri — Constant-Time Operations
 * =================================================
 * Inspired by Go: crypto/subtle
 * Inspired by Rust: subtle crate
 *
 * Branch-free helpers for secret-dependent selection/compare.
 ##

include types

func ct_equal:
    in  a: [int; 32]
        b: [int; 32]
        len: int
    # Returns 1 if equal, 0 if not. No early exit on mismatch.
    diff = 0
    i = 0
    when i < len loop
        diff = diff bit_or ((a[i] bit_xor b[i]) bit_and 255)
        i = i + 1
    end
    # ((diff - 1) >> 63) & 1  → 1 iff diff==0 on two's-complement
    out ((diff - 1) shr 63) bit_and 1
end.

func ct_equal_bytes(a: string, b: string):
    la = str_len(a)
    lb = str_len(b)
    # Length mismatch is non-secret for many protocols; still compare
    # min length bytes so timing does not leak content.
    lim = la
    if lb < lim do
        lim = lb
    end
    diff = (la bit_xor lb) bit_and 0xFFFFFFFF
    i = 0
    when i < lim loop
        diff = diff bit_or (str_byte_at(a, i) bit_xor str_byte_at(b, i))
        i = i + 1
    end
    out (((diff - 1) shr 63) bit_and 1) == 1
end.

func ct_select:
    in  condition: int
        a: int
        b: int
    # condition must be 0 or 1. Returns a if 1, b if 0 — no branch.
    mask = 0 - (condition bit_and 1)
    out (a bit_and mask) bit_or (b bit_and (mask bit_xor (-1)))
end.

func ct_byte_select:
    in  condition: int
        a: int
        b: int
    out ct_select(condition, a bit_and 255, b bit_and 255)
end.

func ct_copy_if:
    in  condition: int
        dst: [int; 32]
        src: [int; 32]
        len: int
    mask = 0 - (condition bit_and 1)
    notmask = mask bit_xor (-1)
    i = 0
    when i < len loop
        dst[i] = (src[i] bit_and mask) bit_or (dst[i] bit_and notmask)
        i = i + 1
    end
end.

func ct_is_zero(x: int):
    # 1 if x==0 else 0
    out (((x bit_or (0 - x)) shr 63) bit_xor 1) bit_and 1
end.

func ct_less_than(a: int, b: int):
    # Unsigned-ish via high bit of (a-b): 1 if a < b for non-negatives
    out (((a - b) shr 63) bit_and 1)
end.

func ct_clamp:
    in  x: int
        lo: int
        hi: int
    # Branch-free clamp into [lo, hi]
    below = ct_less_than(x, lo)
    x2 = ct_select(below, lo, x)
    above = ct_less_than(hi, x2)
    out ct_select(above, hi, x2)
end.

export ct_equal, ct_equal_bytes, ct_select, ct_byte_select
export ct_copy_if, ct_is_zero, ct_less_than, ct_clamp
