##
 * vir/compiler/sem_pass4_types.vri
 * ==============================================================
 * Pass 4: Type Resolution (Vir v2.0 Complete).
 * Resolves all primitive and compound type annotation strings (name2)
 * to TypeKind IDs and updates symbol type_id in SymbolTable.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree

include type_table
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, is_tensor_type_str from type_table

include io
import print_str, print_int, print_newline from io

func pass4_resolve_types(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    pass4_walk(symbols, scopes, node)
end.
func pass4_resolve_type_name(name: string):
    if fat_str_len(name) == 0 do
        out TypeKind.Void
    end
    # Primitive types
    if fat_cstr_eq(name, "int") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i8") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i16") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i32") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "uint") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u8") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u16") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u32") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "float") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "f32") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(name, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(name, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(name, "any") == 1 do out TypeKind.Void end

    # Compound & Advanced Vir Types (§4.1 - §4.5, §26.1)
    if is_tensor_type_str(name) do out TypeKind.Tensor end
    if fat_cstr_eq(name, "tensor") == 1 do out TypeKind.Tensor end
    if fat_cstr_eq(name, "array") == 1 do out TypeKind.Array end
    if fat_cstr_eq(name, "dict") == 1 do out TypeKind.Dict end
    if fat_cstr_eq(name, "tuple") == 1 do out TypeKind.Tuple end
    if fat_cstr_eq(name, "ref") == 1 or fat_cstr_eq(name, "&") == 1 do out TypeKind.Ref end
    if fat_cstr_eq(name, "mutref") == 1 or fat_cstr_eq(name, "&mut") == 1 do out TypeKind.MutRef end
    if fat_cstr_eq(name, "register") == 1 do out TypeKind.Register end
    if fat_cstr_eq(name, "mold") == 1 do out TypeKind.Mold end
    if fat_cstr_eq(name, "packed") == 1 do out TypeKind.Packed end
    if fat_cstr_eq(name, "flux") == 1 do out TypeKind.Flux end
    if fat_cstr_eq(name, "deck") == 1 do out TypeKind.Deck end
    if fat_cstr_eq(name, "optional") == 1 or fat_cstr_eq(name, "option") == 1 do out TypeKind.Optional end

    out TypeKind.Entity
end.
func pass4_walk(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node as i64 == 0 do
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        if fat_str_len(node.name2) > 0 do
            resolved = pass4_resolve_type_name(node.name2)
            pass4_update_symbol_type(symbols, scopes, node.name, resolved, node)
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        if fat_str_len(node.name2) > 0 do
            ret_type = pass4_resolve_type_name(node.name2)
            pass4_update_func_return(symbols, scopes, node.name, ret_type)
        end
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            if fat_str_len(param.name2) > 0 do
                param_type = pass4_resolve_type_name(param.name2)
                pass4_update_symbol_type(symbols, scopes, param.name, param_type, param)
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass4_walk(symbols, scopes, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        ret_type = pass4_resolve_type_name(node.name2)
        pass4_update_func_return(symbols, scopes, node.name, ret_type)
        pass4_update_func_ast(symbols, scopes, node.name, node)
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            field = vec_get_rt(node.children, i)
            if fat_str_len(field.name2) > 0 do
                field_type = pass4_resolve_type_name(field.name2)
            end
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default: recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass4_walk(symbols, scopes, child)
        i = i + 1
    end
    out 0
end.
func pass4_update_symbol_type(symbols: SymbolTable, scopes: ScopeTree, name: string, type_kind: TypeKind, ast_node: AstNode):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 16, type_kind as i64)
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.type_id = type_kind as i64
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.
func pass4_update_func_return(symbols: SymbolTable, scopes: ScopeTree, name: string, ret_type: TypeKind):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 64, ret_type as i64)
                sym.return_type = ret_type as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

func pass4_update_func_ast(symbols: SymbolTable, scopes: ScopeTree, name: string, ast_node: AstNode):
    if fat_str_len(name) == 0 do out 0 end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

export pass4_resolve_types, pass4_resolve_type_name
