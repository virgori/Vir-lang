##
 * vir/crypto/rng.vri — Cryptographically Secure PRNG (CSPRNG)
 * ============================================================
 * Inspired by Go: crypto/rand
 * Inspired by Python: secrets / os.urandom
 *
 * CSPRNG 128-bit and 256-bit draws from OS entropy:
 *   1) native_getrandom / vir_random_bytes (packed bytes) when linked
 *   2) /dev/urandom via sys_open + sys_read (pure Vir fallback)
 *
 * NOT for games/simulations — use vir/rand (xoshiro256**) for that.
 ##

module vir.crypto.rng

include types
include result
import Result, Ok, Err, is_err from result
include string
import String, str_new from string
include rt/syscall
import sys_open, sys_read, sys_close, O_RDONLY from rt/syscall

const CSPRNG_128_BYTES = 16
const CSPRNG_256_BYTES = 32

extern func native_getrandom(buf: ptr, len: int) -> int
extern func vir_random_bytes(buf: ptr, len: int) -> int

func _urandom_path_cstr:
    p = alloc(13)
    write_byte(p, 0, 47)
    write_byte(p, 1, 100)
    write_byte(p, 2, 101)
    write_byte(p, 3, 118)
    write_byte(p, 4, 47)
    write_byte(p, 5, 117)
    write_byte(p, 6, 114)
    write_byte(p, 7, 97)
    write_byte(p, 8, 110)
    write_byte(p, 9, 100)
    write_byte(p, 10, 111)
    write_byte(p, 11, 109)
    write_byte(p, 12, 0)
    out p
end.

func _csprng_read_packed(raw: int, len: int):
    # Fill packed byte buffer `raw[0..len)` from OS CSPRNG.
    # Returns 0 on success, nonzero on failure.
    if len <= 0 do
        out 0
    end
    rc = native_getrandom(raw, len)
    if rc == 0 do
        out 0
    end
    rc2 = vir_random_bytes(raw, len)
    if rc2 == 0 do
        out 0
    end
    path = _urandom_path_cstr()
    fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 do
        out -1
    end
    got = 0
    when got < len loop
        n = sys_read(fd, raw + got, len - got)
        if n <= 0 do
            sys_close(fd)
            out -1
        end
        got = got + n
    end
    sys_close(fd)
    out 0
end.

func csprng_fill(buf: [int], len: int):
    # Fill buf[i] with one random byte (0..255) for i in 0..len.
    if len <= 0 do
        out Ok(())
    end
    raw = alloc(len)
    i = 0
    when i < len loop
        write_byte(raw, i, 0)
        i = i + 1
    end
    rc = _csprng_read_packed(raw, len)
    if rc != 0 do
        out Err(str_new("csprng: OS entropy unavailable"))
    end
    i = 0
    when i < len loop
        buf[i] = read_byte(raw, i) bit_and 255
        i = i + 1
    end
    out Ok(())
end.

func csprng_128:
    var buf: [int; 16]
    i = 0
    when i < 16 loop
        buf[i] = 0
        i = i + 1
    end
    r = csprng_fill(buf, CSPRNG_128_BYTES)
    out (r, buf)
end.

func csprng_256:
    var buf: [int; 32]
    i = 0
    when i < 32 loop
        buf[i] = 0
        i = i + 1
    end
    r = csprng_fill(buf, CSPRNG_256_BYTES)
    out (r, buf)
end.

func csprng_u64:
    var buf: [int; 8]
    i = 0
    when i < 8 loop
        buf[i] = 0
        i = i + 1
    end
    r = csprng_fill(buf, 8)
    if is_err(r) do
        out Err(str_new("csprng_u64: entropy unavailable"))
    end
    val = ((buf[0] bit_and 255) shl 56) bit_or
        ((buf[1] bit_and 255) shl 48) bit_or
        ((buf[2] bit_and 255) shl 40) bit_or
        ((buf[3] bit_and 255) shl 32) bit_or
        ((buf[4] bit_and 255) shl 24) bit_or
        ((buf[5] bit_and 255) shl 16) bit_or
        ((buf[6] bit_and 255) shl 8) bit_or
        (buf[7] bit_and 255)
    out Ok(val)
end.

func crypto_random_bytes(buf: [int], len: int):
    out csprng_fill(buf, len)
end.

export csprng_fill, csprng_128, csprng_256, csprng_u64
export crypto_random_bytes, CSPRNG_128_BYTES, CSPRNG_256_BYTES
