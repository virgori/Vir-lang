##
 * vir/crypto — Cryptography package index
 * ========================================
 *
 * ⚠️  EXPERIMENTAL — NOT production-ready as a whole.
 * Prefer audited backends (libsodium / BoringSSL) for:
 *   Ed25519, full X.509 PKI, RSA (no blinding), software AES S-box.
 *
 * Safer-to-harden surfaces (still review before prod):
 *   crypto/hash.vri      SHA-256 / SHA-512
 *   crypto/hmac.vri      HMAC-SHA256
 *   crypto/rng.vri       CSPRNG 128 / 256 (OS entropy)
 *
 * Hardened in this tree but still experimental:
 *   crypto/aes.vri       AES-GCM CTR start + length block fixes
 *   crypto/chacha20.vri  Poly1305 + tag-length auth bypass fix
 *   crypto/x509.vri      fail-closed validate; wildcard host fix
 *   crypto/ed25519.vri   FAIL-CLOSED (verify always false)
 *
 * TLS:
 *   tls/tls.vri          TLS 1.2/1.3 streams (native FFI)
 *   tls/cert.vri         cert material helpers
 *
 * Non-crypto PRNG: vir/rand (xoshiro256**) — do NOT use for keys.
 ##

module vir.crypto

include crypto/hash
include crypto/hmac
include crypto/rng
include crypto/aes
include crypto/chacha20
include crypto/x509
include crypto/subtle

import sha256_hash, sha256_hex, sha256_new, sha256_update, sha256_finish from crypto/hash
import sha512_hash, sha512_hex from crypto/hash
import hmac_sha256, hmac_sha256_hex, hmac_sha256_verify from crypto/hmac
import csprng_128, csprng_256, csprng_fill, csprng_u64, crypto_random_bytes from crypto/rng

export sha256_hash, sha256_hex, sha512_hash, sha512_hex
export hmac_sha256, hmac_sha256_hex, hmac_sha256_verify
export csprng_128, csprng_256, csprng_fill, crypto_random_bytes
