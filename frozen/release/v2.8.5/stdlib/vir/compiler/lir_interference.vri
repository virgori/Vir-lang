##
 * vir/compiler/lir_interference.vri — Interference Graph
 * ==============================================================
 * Builds an interference graph with Dual Representation:
 * 1. Compact Bit-Matrix for strictly O(1) edge queries (get_edge)
 * 2. Adjacency Lists for O(degree) neighbor traversal
 *
 * Supports both Def-vs-Live-Out CFG graph construction and Sweep Line.
 * Implements the contract in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_interference

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include compiler.lir_liveness
import LiveInterval, lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2 from compiler.lir_liveness
include compiler.lir
import LirOperand, LirInstr, LirBlock, LirFunc, LirOp from compiler.lir
include string_rt
import native_read_i64, native_write_i64 from string_rt

func ig_new(num_nodes: i64, matrix: i64, degrees: i64, adj_lists: i64):
    p = alloc(32)
    native_write_i64(p, 0, num_nodes)
    native_write_i64(p, 8, matrix)
    native_write_i64(p, 16, degrees)
    native_write_i64(p, 24, adj_lists)
    out p
end.

entity InterferenceGraph:
    num_nodes: i64,
    matrix: [i64],
    degrees: [i64]
end.

func live_start_of(iv: LiveInterval):
    out native_read_i64(iv as i64, 8)
end.
func live_end_of(iv: LiveInterval):
    out native_read_i64(iv as i64, 16)
end.

func intervals_overlap(i1: LiveInterval, i2: LiveInterval):
    s1 = native_read_i64(i1 as i64, 8)
    if s1 == 0 - 1 do out false end
    s2 = native_read_i64(i2 as i64, 8)
    if s2 == 0 - 1 do out false end
    e1 = native_read_i64(i1 as i64, 16)
    e2 = native_read_i64(i2 as i64, 16)
    out s1 <= e2 & s2 <= e1
end.

func ig_num_nodes(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 0)
end.
func ig_matrix(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 8)
end.
func ig_degrees(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 16)
end.
func ig_adj_lists(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 24)
end.

func ig_add_edge(n_nodes: i64, words_per_row: i64, bit_matrix: i64, degrees: i64, adj_lists: i64, u: i64, v: i64):
    if u < 0 or u >= n_nodes or v < 0 or v >= n_nodes or u == v do out 0 end
    let w_u = (u * words_per_row) + (v / 64)
    let b_v = v and 63
    let cur_w_u = vec_get_rt(bit_matrix, w_u)
    if ((cur_w_u shr b_v) and 1) == 1 do
        out 0
    end
    vec_set_rt(bit_matrix, w_u, cur_w_u or (1 shl b_v))

    let w_v = (v * words_per_row) + (u / 64)
    let b_u = u and 63
    let cur_w_v = vec_get_rt(bit_matrix, w_v)
    vec_set_rt(bit_matrix, w_v, cur_w_v or (1 shl b_u))

    let list_u = vec_get_rt(adj_lists, u)
    vec_set_rt(adj_lists, u, vec_push_rt(list_u, v))
    let list_v = vec_get_rt(adj_lists, v)
    vec_set_rt(adj_lists, v, vec_push_rt(list_v, u))

    vec_set_rt(degrees, u, vec_get_rt(degrees, u) + 1)
    vec_set_rt(degrees, v, vec_get_rt(degrees, v) + 1)
    out 1
end.

# Median-of-3 Quicksort on active interval indices
func sort_intervals_by_start(active: i64, intervals: i64, left: i64, right: i64):
    if left >= right do out 0 end

    mid = left + ((right - left) shr 1)
    v_left = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, left)) as i64, 8)
    v_mid = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, mid)) as i64, 8)
    v_right = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, right)) as i64, 8)

    if v_left > v_mid do
        t = vec_get_rt(active, left)
        vec_set_rt(active, left, vec_get_rt(active, mid))
        vec_set_rt(active, mid, t)
        tv = v_left; v_left = v_mid; v_mid = tv
    end
    if v_left > v_right do
        t = vec_get_rt(active, left)
        vec_set_rt(active, left, vec_get_rt(active, right))
        vec_set_rt(active, right, t)
        tv = v_left; v_left = v_right; v_right = tv
    end
    if v_mid > v_right do
        t = vec_get_rt(active, mid)
        vec_set_rt(active, mid, vec_get_rt(active, right))
        vec_set_rt(active, right, t)
    end

    t = vec_get_rt(active, mid)
    vec_set_rt(active, mid, vec_get_rt(active, right))
    vec_set_rt(active, right, t)

    pivot_idx = vec_get_rt(active, right)
    pivot_val = native_read_i64(vec_get_rt(intervals, pivot_idx) as i64, 8)
    var i = left
    var j = left
    when j < right loop
        v = vec_get_rt(active, j)
        val = native_read_i64(vec_get_rt(intervals, v) as i64, 8)
        if val < pivot_val do
            tmp = vec_get_rt(active, i)
            vec_set_rt(active, i, v)
            vec_set_rt(active, j, tmp)
            i = i + 1
        end
        j = j + 1
    end
    tmp2 = vec_get_rt(active, i)
    vec_set_rt(active, i, vec_get_rt(active, right))
    vec_set_rt(active, right, tmp2)

    sort_intervals_by_start(active, intervals, left, i - 1)
    sort_intervals_by_start(active, intervals, i + 1, right)
    out 0
end.

# Build interference graph from intervals
func build_interference_graph(intervals: i64):
    let n_nodes = vec_len_rt(intervals)
    let degrees = vec_new_rt()
    let adj_lists = vec_new_rt()
    let active = vec_new_rt()

    var i = 0
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0)
        adj_lists = vec_push_rt(adj_lists, vec_new_rt())
        iv = vec_get_rt(intervals, i)
        if native_read_i64(iv as i64, 8) != 0 - 1 do
            active = vec_push_rt(active, i)
        end
        i = i + 1
    end

    let words_per_row = (n_nodes + 63) / 64
    let total_words = n_nodes * words_per_row
    let bit_matrix = vec_new_rt()
    var wi = 0
    when wi < total_words loop
        bit_matrix = vec_push_rt(bit_matrix, 0)
        wi = wi + 1
    end

    let n_active = vec_len_rt(active)
    if n_active > 1 do
        sort_intervals_by_start(active, intervals, 0, n_active - 1)
    end

    var ai = 0
    when ai < n_active loop
        let u = vec_get_rt(active, ai)
        let iv_u = vec_get_rt(intervals, u)
        let end_u = native_read_i64(iv_u as i64, 16)

        var aj = ai + 1
        var should_cont = true
        when aj < n_active & should_cont loop
            let v = vec_get_rt(active, aj)
            let iv_v = vec_get_rt(intervals, v)
            let start_v = native_read_i64(iv_v as i64, 8)
            if start_v > end_u do
                should_cont = false
            else
                # Record in Adjacency Lists
                list_u = vec_get_rt(adj_lists, u)
                list_u = vec_push_rt(list_u, v)
                vec_set_rt(adj_lists, u, list_u)

                list_v = vec_get_rt(adj_lists, v)
                list_v = vec_push_rt(list_v, u)
                vec_set_rt(adj_lists, v, list_v)

                # Record in Bit-Matrix (u -> v and v -> u)
                w_u = (u * words_per_row) + (v / 64)
                b_v = v and 63
                old_w_u = vec_get_rt(bit_matrix, w_u)
                vec_set_rt(bit_matrix, w_u, old_w_u or (1 shl b_v))

                w_v = (v * words_per_row) + (u / 64)
                b_u = u and 63
                old_w_v = vec_get_rt(bit_matrix, w_v)
                vec_set_rt(bit_matrix, w_v, old_w_v or (1 shl b_u))

                vec_set_rt(degrees, u, vec_get_rt(degrees, u) + 1)
                vec_set_rt(degrees, v, vec_get_rt(degrees, v) + 1)
            end
            aj = aj + 1
        end
        ai = ai + 1
    end

    out ig_new(n_nodes, bit_matrix, degrees, adj_lists)
end.

# Def-vs-Live-Out interference builder for exact CFG dataflow edges
func build_interference_graph_def_live_out(func_obj: LirFunc, intervals: i64):
    let n_nodes = vec_len_rt(intervals)
    let degrees = vec_new_rt()
    let adj_lists = vec_new_rt()

    var i = 0
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0)
        adj_lists = vec_push_rt(adj_lists, vec_new_rt())
        i = i + 1
    end

    let words_per_row = (n_nodes + 63) / 64
    let total_words = n_nodes * words_per_row
    let bit_matrix = vec_new_rt()
    var wi = 0
    when wi < total_words loop
        bit_matrix = vec_push_rt(bit_matrix, 0)
        wi = wi + 1
    end

    # Also include interval overlaps to guarantee soundness
    let base_ig = build_interference_graph(intervals)
    let base_adj = ig_adj_lists(base_ig)
    var u = 0
    when u < n_nodes loop
        let neighbors = vec_get_rt(base_adj, u)
        let nn = vec_len_rt(neighbors)
        var ni = 0
        when ni < nn loop
            let v = vec_get_rt(neighbors, ni)
            if v > u do
                ig_add_edge(n_nodes, words_per_row, bit_matrix, degrees, adj_lists, u, v)
            end
            ni = ni + 1
        end
        u = u + 1
    end

    # Walk function blocks to add specific def-vs-live-out edges
    let blocks = native_read_i64(func_obj as i64, 16)
    let n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let instrs = native_read_i64(b as i64, 8)
        let n_ins = vec_len_rt(instrs)
        var ii = 0
        when ii < n_ins loop
            let ins = vec_get_rt(instrs, ii)
            let op = native_read_i64(ins as i64, 0)
            let d = native_read_i64(ins as i64, 16) as LirOperand
            if lir_opnd_is_vreg(d) do
                let dv = lir_opnd_vreg_id(d)
                # Check move: do not add false interference with move src
                var skip_v = 0 - 1
                if op == 1 do # LirOp.Mov
                    let s1 = native_read_i64(ins as i64, 24) as LirOperand
                    if lir_opnd_is_vreg(s1) do skip_v = lir_opnd_vreg_id(s1) end
                end
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    out ig_new(n_nodes, bit_matrix, degrees, adj_lists)
end.

func get_edge(ig: InterferenceGraph, u: i64, v: i64):
    n = ig_num_nodes(ig)
    if u < 0 | u >= n | v < 0 | v >= n do out 0 end
    bm = ig_matrix(ig)
    if (bm as i64) == 0 do out 0 end
    words_per_row = (n + 63) / 64
    w_idx = (u * words_per_row) + (v / 64)
    bit_idx = v and 63
    word = vec_get_rt(bm, w_idx)
    out (word shr bit_idx) and 1
end.

export InterferenceGraph, build_interference_graph, build_interference_graph_def_live_out
export get_edge, ig_num_nodes, ig_degrees, ig_adj_lists, intervals_overlap, ig_add_edge
