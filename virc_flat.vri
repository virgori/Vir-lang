export x86_call_rel32, x86_cmp_rr, x86_sete, x86_setg, x86_setl, x86_setge, x86_setle
export x86_je_rel32, x86_jne_rel32, x86_xor_rr, x86_and_rr, x86_or_rr
export x86_shl_cl, x86_sar_cl, x86_idiv, x86_cqo, x86_syscall, x86_test_rr
export rex_w, modrm

# AVX emitters
export avx_vaddps, avx_vsubps, avx_vmulps, avx_vdivps
export avx_vminps, avx_vmaxps, avx_vmovaps_load, avx_vmovaps_store
export avx_vbroadcastss, avx_vhaddps, x86_vex2

# ARM64 emitters
export arm64_add_rrr, arm64_sub_rrr, arm64_mul_rrr, arm64_sdiv_rrr
export arm64_mov_imm16, arm64_movz_imm64, arm64_mov_rr
export arm64_cmp_rr, arm64_cmp_imm0
export arm64_cset_eq, arm64_cset_gt, arm64_cset_lt, arm64_cset_ge, arm64_cset_le
export arm64_b_imm26, arm64_beq_imm19, arm64_bne_imm19, arm64_bl_imm26
export arm64_ret, arm64_nop, arm64_stp_pre, arm64_ldp_post
export arm64_str_pre, arm64_ldr_post, arm64_svc, arm64_blr_x16
export arm64_and_rrr, arm64_orr_rrr, arm64_eor_rrr, arm64_lsl_rrr, arm64_asr_rrr
export arm64_ldrb_reg, arm64_strb_reg, arm64_ldr_reg, arm64_str_reg

# NEON emitters
export neon_ld1_4s, neon_st1_4s, neon_add_4s, neon_sub_4s, neon_mul_4s
export neon_fadd_4s, neon_fmul_4s, neon_fdiv_4s, neon_fmla_4s
export neon_smin_4s, neon_smax_4s, neon_addv_4s, neon_dup_4s_gpr, neon_tbl_16b

# Register mapping
export vreg_to_x86, vreg_to_arm, vreg_to_neon, vreg_to_xmm
export X86Reg, ArmReg
# ══ END vir/compiler/codegen ══

# ══ BEGIN vir/compiler/codegen_wasm ══
##
 * vir/compiler/codegen_wasm.vri — Q-IR → WebAssembly Backend
 * ============================================================
 * Self-hosted Vir implementation of WASM code generation.
 * Ported from Python codegen_wasm.py → pure Vir.
 *
 * Emits WebAssembly MVP binary:
 *   Module header → Type → Import → Function → Memory → Export → Code
 *
 * Strategy: Q-IR VRegs → WASM locals
 *           Q-IR ops   → push operands, stack op, pop to dest.
 ##


       SEC_MEMORY, SEC_EXPORT, SEC_CODE,
       WASM_MAGIC_0, WASM_MAGIC_1, WASM_MAGIC_2, WASM_MAGIC_3,
       WASM_VERSION from wasm


# ═══════════════════════════════════════════════════════
# WASM Binary Constants
# ═══════════════════════════════════════════════════════

const W_I32:       0x7F
const W_I64:       0x7E
const W_F32:       0x7D
const W_F64:       0x7C

const W_FUNCTYPE:  0x60

const EXP_FUNC:    0x00
const EXP_TABLE:   0x01
const EXP_MEMORY:  0x02
const EXP_GLOBAL:  0x03

# WASM opcodes (binary encoding)
const OP_UNREACHABLE:         0x00
const OP_NOP:                 0x01
const OP_BLOCK:               0x02
const OP_LOOP:                0x03
const OP_IF:                  0x04
const OP_ELSE:                0x05
const OP_END:                 0x0B
const OP_BR:                  0x0C
const OP_BR_IF:               0x0D
const OP_RETURN:              0x0F
const OP_CALL:                0x10
const OP_DROP:                0x1A
const OP_LOCAL_GET:           0x20
const OP_LOCAL_SET:           0x21
const OP_LOCAL_TEE:           0x22
const OP_I32_LOAD:            0x28
const OP_I64_LOAD:            0x29
const OP_I32_STORE:           0x36
const OP_I64_STORE:           0x37
const OP_I32_CONST:           0x41
const OP_I64_CONST:           0x42
const OP_F64_CONST:           0x44
const OP_I64_EQZ:             0x50
const OP_I64_EQ:              0x51
const OP_I64_NE:              0x52
const OP_I64_LT_S:            0x53
const OP_I64_GT_S:            0x55
const OP_I64_LE_S:            0x57
const OP_I64_GE_S:            0x59
const OP_F64_EQ:              0x61
const OP_F64_LT:              0x63
const OP_F64_GT:              0x64
const OP_I64_ADD:             0x7C
const OP_I64_SUB:             0x7D
const OP_I64_MUL:             0x7E
const OP_I64_DIV_S:           0x7F
const OP_I64_REM_S:           0x81
const OP_F64_ADD:             0xA0
const OP_F64_SUB:             0xA1
const OP_F64_MUL:             0xA2
const OP_F64_DIV:             0xA3
const OP_I64_EXTEND_I32_S:    0xAC
const OP_I64_TRUNC_F64_S:     0xB0
const OP_F64_CONVERT_I64_S:   0xB9


# ═══════════════════════════════════════════════════════
# LEB128 Encoding (pure Vir — replaces extern stubs)
# ═══════════════════════════════════════════════════════

func wasm_uleb128:
    in(value: int; buf: Vec<int>) -> Vec<int>
    let v = value
    loop
        let byte = v & 0x7F
        v = v >> 7
        if v != 0:
            byte = byte | 0x80
        end
        buf = vec_push<int>(buf, byte)
        if v == 0: break; end
    end
    out buf
end

func wasm_sleb128:
    in(value: int; buf: Vec<int>) -> Vec<int>
    let v = value
    let more = true
    when more loop
        let byte = v & 0x7F
        v = v >> 7
        if (v == 0 and (byte & 0x40) == 0) or (v == -1 and (byte & 0x40) != 0):
            more = false
        else
            byte = byte | 0x80
        end
        buf = vec_push<int>(buf, byte)
    end
    out buf
end

func wasm_encode_string:
    in(s: string; buf: Vec<int>) -> Vec<int>
    let slen = str_byte_len(s)
    buf = wasm_uleb128(slen, buf)
    let i = 0
    when i < slen loop
        buf = vec_push<int>(buf, str_byte_at(s, i))
        i = i + 1
    end
    out buf
end


# ═══════════════════════════════════════════════════════
# WASM Function Builder
# ═══════════════════════════════════════════════════════

entity WasmFunc:
    name:         string
    param_count:  int
    local_count:  int
    has_result:   bool
    body:         Vec<int>
end

func wasm_func_new:
    in(name: string; param_count: int) -> WasmFunc
    out WasmFunc (
        name:        name,
        param_count: param_count,
        local_count: 0,
        has_result:  true,
        body:        vec_new<int>()
    )
end

func wf_emit:
    in(wf: WasmFunc; opcode: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, opcode)
    out wf
end

func wf_emit_i64_const:
    in(wf: WasmFunc; value: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_I64_CONST)
    wf.body = wasm_sleb128(value, wf.body)
    out wf
end

func wf_emit_f64_const:
    in(wf: WasmFunc; value: float) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_F64_CONST)
    # Emit 8 bytes little-endian IEEE 754
    let bits = float_to_bits(value)
    let i = 0
    when i < 8 loop
        wf.body = vec_push<int>(wf.body, (bits >> (i * 8)) & 0xFF)
        i = i + 1
    end
    out wf
end

func wf_emit_local_get:
    in(wf: WasmFunc; idx: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_LOCAL_GET)
    wf.body = wasm_uleb128(idx, wf.body)
    out wf
end

func wf_emit_local_set:
    in(wf: WasmFunc; idx: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_LOCAL_SET)
    wf.body = wasm_uleb128(idx, wf.body)
    out wf
end

func wf_emit_call:
    in(wf: WasmFunc; func_idx: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_CALL)
    wf.body = wasm_uleb128(func_idx, wf.body)
    out wf
end

func wf_emit_br:
    in(wf: WasmFunc; depth: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_BR)
    wf.body = wasm_uleb128(depth, wf.body)
    out wf
end

func wf_emit_br_if:
    in(wf: WasmFunc; depth: int) -> WasmFunc
    wf.body = vec_push<int>(wf.body, OP_BR_IF)
    wf.body = wasm_uleb128(depth, wf.body)
    out wf
end

func wf_encode_body:
    in(wf: WasmFunc) -> Vec<int>
    let body = vec_new<int>()

    # Locals declaration
    if wf.local_count > 0:
        body = wasm_uleb128(1, body);             # 1 entry
        body = wasm_uleb128(wf.local_count, body); # count
        body = vec_push<int>(body, W_I64);         # type i64
    else
        body = wasm_uleb128(0, body);             # 0 entries
    end

    # Copy body bytes
    let i = 0
    let n = vec_len<int>(wf.body)
    when i < n loop
        body = vec_push<int>(body, vec_get<int>(wf.body, i))
        i = i + 1
    end

    # End opcode
    body = vec_push<int>(body, OP_END)

    # Wrap with size prefix
    let result = vec_new<int>()
    result = wasm_uleb128(vec_len<int>(body), result)
    let j = 0
    let m = vec_len<int>(body)
    when j < m loop
        result = vec_push<int>(result, vec_get<int>(body, j))
        j = j + 1
    end
    out result
end


# ═══════════════════════════════════════════════════════
# WASM Code Generator
# ═══════════════════════════════════════════════════════

entity WasmCodegen:
    functions:     Vec<WasmFunc>
    func_names:    Map<string, int>
    import_count:  int
    strings:       Vec<string>
end

func wasm_codegen_new:
    out WasmCodegen (
        functions:    vec_new<WasmFunc>(),
        func_names:   map_new<string, int>(),
        import_count: 0,
        strings:      vec_new<string>()
    )
end


# ═══════════════════════════════════════════════════════
# Operand Push Helpers
# ═══════════════════════════════════════════════════════

func wf_push_operand:
    in(wf: WasmFunc; op: Operand) -> WasmFunc
    if op.kind == OpndType::VReg:
        wf = wf_emit_local_get(wf, op.vreg)
    eif op.kind == OpndType::Imm:
        wf = wf_emit_i64_const(wf, op.imm)
    end
    out wf
end

func wf_pop_to_dest:
    in(wf: WasmFunc; op: Operand) -> WasmFunc
    if op.kind == OpndType::VReg:
        wf = wf_emit_local_set(wf, op.vreg)
    end
    out wf
end


# ═══════════════════════════════════════════════════════
# Instruction Compilation
# ═══════════════════════════════════════════════════════

func wasm_compile_instr:
    in(cg: WasmCodegen; wf: WasmFunc; instr: QInstr) -> WasmFunc
    let op = instr.opcode

    # ── Data Movement ──────────────────────────────────
    if op == QOp::Load or op == QOp::Move:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::LoadString:
        let idx = instr.string_idx
        wf = wf_emit_i64_const(wf, idx)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    # ── Integer Arithmetic ─────────────────────────────
    if op == QOp::Add:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_ADD)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::Sub:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_SUB)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::Mul:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_MUL)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::Div:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_DIV_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::Mod:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_REM_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    # ── Comparison ─────────────────────────────────────
    if op == QOp::CmpEq:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_EQ)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::CmpNe:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_NE)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::CmpGt:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_GT_S)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::CmpLt:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_LT_S)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::CmpGe:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_GE_S)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::CmpLe:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_I64_LE_S)
        wf = wf_emit(wf, OP_I64_EXTEND_I32_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    # ── Floating-point Arithmetic ──────────────────────
    if op == QOp::FAdd:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_F64_ADD)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::FSub:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_F64_SUB)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::FMul:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_F64_MUL)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::FDiv:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_push_operand(wf, instr.src2)
        wf = wf_emit(wf, OP_F64_DIV)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::FCvtI2F:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit(wf, OP_F64_CONVERT_I64_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    if op == QOp::FCvtF2I:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit(wf, OP_I64_TRUNC_F64_S)
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    # ── Control Flow ───────────────────────────────────
    if op == QOp::Label:
        # Labels handled via WASM block structure; no-op at byte level
        out wf
    end

    if op == QOp::Jump:
        wf = wf_emit_br(wf, 0)
        out wf
    end

    if op == QOp::JumpIf:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit(wf, OP_I64_EQZ)
        wf = wf_emit(wf, OP_I64_EQZ);      # double eqz → "is not zero"
        wf = wf_emit_br_if(wf, 0)
        out wf
    end

    if op == QOp::JumpIfNot:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit(wf, OP_I64_EQZ)
        wf = wf_emit_br_if(wf, 0)
        out wf
    end

    if op == QOp::Call:
        # Push argument
        wf = wf_push_operand(wf, instr.src1)
        # Look up function index by label
        let func_idx = 0
        let found = map_get(cg.func_names, instr.label_name)
        case found
            case Some(idx): func_idx = idx
            case None: func_idx = 0
        end
        wf = wf_emit_call(wf, func_idx)
        out wf
    end

    if op == QOp::Ret:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit(wf, OP_RETURN)
        out wf
    end

    # ── I/O ────────────────────────────────────────────
    if op == QOp::Print:
        wf = wf_push_operand(wf, instr.src1)
        wf = wf_emit_call(wf, 0);  # import[0] = env.print
        out wf
    end

    if op == QOp::Input:
        wf = wf_emit_call(wf, 1);  # import[1] = env.input
        wf = wf_pop_to_dest(wf, instr.dest)
        out wf
    end

    # ── NOP / HALT ─────────────────────────────────────
    if op == QOp::Nop:
        wf = wf_emit(wf, OP_NOP)
        out wf
    end

    if op == QOp::Halt:
        wf = wf_emit(wf, OP_UNREACHABLE)
        out wf
    end

    # Unknown opcode → nop
    out wf
end


# ═══════════════════════════════════════════════════════
# Function Compilation
# ═══════════════════════════════════════════════════════

func wasm_compile_function:
    in(cg: WasmCodegen; name: string; params: int; body: Vec<QInstr>) -> WasmFunc
    let wf = wasm_func_new(name, params)

    # Count max VReg index used → allocate locals
    let max_reg = params - 1
    let i = 0
    let n = vec_len<QInstr>(body)
    when i < n loop
        let instr = vec_get<QInstr>(body, i)
        if instr.dest.kind == OpndType::VReg and instr.dest.vreg > max_reg:
            max_reg = instr.dest.vreg
        end
        if instr.src1.kind == OpndType::VReg and instr.src1.vreg > max_reg:
            max_reg = instr.src1.vreg
        end
        if instr.src2.kind == OpndType::VReg and instr.src2.vreg > max_reg:
            max_reg = instr.src2.vreg
        end
        i = i + 1
    end

    wf.local_count = if max_reg + 1 > params: max_reg + 1 - params; else: 0; end

    # Compile each instruction
    let j = 0
    when j < n loop
        let instr = vec_get<QInstr>(body, j)
        wf = wasm_compile_instr(cg, wf, instr)
        j = j + 1
    end

    out wf
end


# ═══════════════════════════════════════════════════════
# Section Builder Helpers
# ═══════════════════════════════════════════════════════

func wasm_append_section:
    in(out_buf: Vec<int>; sec_id: int; content: Vec<int>) -> Vec<int>
    out_buf = vec_push<int>(out_buf, sec_id)
    out_buf = wasm_uleb128(vec_len<int>(content), out_buf)
    let i = 0
    let n = vec_len<int>(content)
    when i < n loop
        out_buf = vec_push<int>(out_buf, vec_get<int>(content, i))
        i = i + 1
    end
    out out_buf
end

func wasm_append_vec:
    in(dst: Vec<int>; src: Vec<int>) -> Vec<int>
    let i = 0
    let n = vec_len<int>(src)
    when i < n loop
        dst = vec_push<int>(dst, vec_get<int>(src, i))
        i = i + 1
    end
    out dst
end


# ═══════════════════════════════════════════════════════
# Binary Module Emitter
# ═══════════════════════════════════════════════════════

entity TypeSig:
    params:  Vec<int>
    results: Vec<int>
end

func wasm_emit_binary:
    in(cg: WasmCodegen) -> Vec<int>
    let out_buf = vec_new<int>()

    # ── Magic + Version ────────────────────────────────
    out_buf = vec_push<int>(out_buf, WASM_MAGIC_0);  # \0
    out_buf = vec_push<int>(out_buf, WASM_MAGIC_1);  # a
    out_buf = vec_push<int>(out_buf, WASM_MAGIC_2);  # s
    out_buf = vec_push<int>(out_buf, WASM_MAGIC_3);  # m
    out_buf = vec_push<int>(out_buf, 1);  # version
    out_buf = vec_push<int>(out_buf, 0)
    out_buf = vec_push<int>(out_buf, 0)
    out_buf = vec_push<int>(out_buf, 0)

    # ── Collect type signatures ────────────────────────
    let type_sigs = vec_new<TypeSig>()

    # Import types: env.print(i64) → void, env.input() → i64
    let sig0_p = vec_new<int>()
    sig0_p = vec_push<int>(sig0_p, W_I64)
    let sig0_r = vec_new<int>()
    type_sigs = vec_push<TypeSig>(type_sigs, TypeSig ( params: sig0_p, results: sig0_r ))

    let sig1_p = vec_new<int>()
    let sig1_r = vec_new<int>()
    sig1_r = vec_push<int>(sig1_r, W_I64)
    type_sigs = vec_push<TypeSig>(type_sigs, TypeSig ( params: sig1_p, results: sig1_r ))

    # User function types: i64^N → i64
    let fi = 0
    let fn_count = vec_len<WasmFunc>(cg.functions)
    when fi < fn_count loop
        let wf = vec_get<WasmFunc>(cg.functions, fi)
        let sig_idx = _find_or_add_sig(type_sigs, wf.param_count, wf.has_result)
        if sig_idx == -1:
            # New sig needed
            let sp = vec_new<int>()
            let pi = 0
            when pi < wf.param_count loop
                sp = vec_push<int>(sp, W_I64)
                pi = pi + 1
            end
            let sr = vec_new<int>()
            if wf.has_result:
                sr = vec_push<int>(sr, W_I64)
            end
            type_sigs = vec_push<TypeSig>(type_sigs, TypeSig ( params: sp, results: sr ))
        end
        fi = fi + 1
    end

    # ── Type Section ───────────────────────────────────
    let type_content = vec_new<int>()
    let num_types = vec_len<TypeSig>(type_sigs)
    type_content = wasm_uleb128(num_types, type_content)
    let ti = 0
    when ti < num_types loop
        let sig = vec_get<TypeSig>(type_sigs, ti)
        type_content = vec_push<int>(type_content, W_FUNCTYPE)
        let np = vec_len<int>(sig.params)
        type_content = wasm_uleb128(np, type_content)
        let pi = 0
        when pi < np loop
            type_content = vec_push<int>(type_content, vec_get<int>(sig.params, pi))
            pi = pi + 1
        end
        let nr = vec_len<int>(sig.results)
        type_content = wasm_uleb128(nr, type_content)
        let ri = 0
        when ri < nr loop
            type_content = vec_push<int>(type_content, vec_get<int>(sig.results, ri))
            ri = ri + 1
        end
        ti = ti + 1
    end
    out_buf = wasm_append_section(out_buf, SEC_TYPE, type_content)

    # ── Import Section ─────────────────────────────────
    let import_content = vec_new<int>()
    import_content = wasm_uleb128(2, import_content);   # 2 imports
    # env.print(i64) → void  (type index 0)
    import_content = wasm_encode_string("env", import_content)
    import_content = wasm_encode_string("print", import_content)
    import_content = vec_push<int>(import_content, 0x00);  # functype
    import_content = wasm_uleb128(0, import_content);       # type idx 0
    # env.input() → i64  (type index 1)
    import_content = wasm_encode_string("env", import_content)
    import_content = wasm_encode_string("input", import_content)
    import_content = vec_push<int>(import_content, 0x00);  # functype
    import_content = wasm_uleb128(1, import_content);       # type idx 1
    out_buf = wasm_append_section(out_buf, SEC_IMPORT, import_content)

    # ── Function Section ───────────────────────────────
    let func_content = vec_new<int>()
    func_content = wasm_uleb128(fn_count, func_content)
    let fj = 0
    when fj < fn_count loop
        let wf = vec_get<WasmFunc>(cg.functions, fj)
        let tidx = _find_sig_idx(type_sigs, wf.param_count, wf.has_result)
        func_content = wasm_uleb128(tidx, func_content)
        fj = fj + 1
    end
    out_buf = wasm_append_section(out_buf, SEC_FUNCTION, func_content)

    # ── Memory Section (1 page = 64 KB) ───────────────
    let mem_content = vec_new<int>()
    mem_content = wasm_uleb128(1, mem_content);   # 1 memory
    mem_content = vec_push<int>(mem_content, 0x00);  # no max
    mem_content = wasm_uleb128(1, mem_content);   # initial 1 page
    out_buf = wasm_append_section(out_buf, SEC_MEMORY, mem_content)

    # ── Export Section ─────────────────────────────────
    let export_content = vec_new<int>()
    let export_count = fn_count + 1;  # all functions + memory
    export_content = wasm_uleb128(export_count, export_content)
    let ej = 0
    when ej < fn_count loop
        let wf = vec_get<WasmFunc>(cg.functions, ej)
        export_content = wasm_encode_string(wf.name, export_content)
        export_content = vec_push<int>(export_content, EXP_FUNC)
        export_content = wasm_uleb128(cg.import_count + ej, export_content)
        ej = ej + 1
    end
    # Export memory
    export_content = wasm_encode_string("memory", export_content)
    export_content = vec_push<int>(export_content, EXP_MEMORY)
    export_content = wasm_uleb128(0, export_content)
    out_buf = wasm_append_section(out_buf, SEC_EXPORT, export_content)

    # ── Code Section ───────────────────────────────────
    let code_content = vec_new<int>()
    code_content = wasm_uleb128(fn_count, code_content)
    let ck = 0
    when ck < fn_count loop
        let wf = vec_get<WasmFunc>(cg.functions, ck)
        let encoded = wf_encode_body(wf)
        code_content = wasm_append_vec(code_content, encoded)
        ck = ck + 1
    end
    out_buf = wasm_append_section(out_buf, SEC_CODE, code_content)

    out out_buf
end


# ═══════════════════════════════════════════════════════
# Type Signature Lookup
# ═══════════════════════════════════════════════════════

func _find_or_add_sig:
    in(sigs: Vec<TypeSig>; param_count: int; has_result: bool) -> int
    let i = 0
    let n = vec_len<TypeSig>(sigs)
    when i < n loop
        let s = vec_get<TypeSig>(sigs, i)
        let np = vec_len<int>(s.params)
        let nr = vec_len<int>(s.results)
        let expect_r = if has_result: 1; else: 0; end
        if np == param_count and nr == expect_r:
            let all_i64 = true
            let j = 0
            when j < np loop
                if vec_get<int>(s.params, j) != W_I64: all_i64 = false; end
                j = j + 1
            end
            if all_i64:
                out i;   # found existing
            end
        end
        i = i + 1
    end
    out -1;  # not found
end

func _find_sig_idx:
    in(sigs: Vec<TypeSig>; param_count: int; has_result: bool) -> int
    let idx = _find_or_add_sig(sigs, param_count, has_result)
    if idx == -1: out 0; end   # fallback
    out idx
end


# ═══════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════

# Compile a list of QIR functions to WASM binary bytes.
# Each QIRFunc has: name: string, param_count: int, body: Vec<QInstr>.
entity QIRFunc:
    name:         string
    param_count:  int
    body:         Vec<QInstr>
end

func wasm_compile_module:
    in(funcs: Vec<QIRFunc>) -> Vec<int>
    let cg = wasm_codegen_new()
    cg.import_count = 2;  # env.print, env.input

    let i = 0
    let n = vec_len<QIRFunc>(funcs)

    # First pass: register names
    when i < n loop
        let f = vec_get<QIRFunc>(funcs, i)
        map_set(cg.func_names, f.name, cg.import_count + i)
        i = i + 1
    end

    # Second pass: compile bodies
    let j = 0
    when j < n loop
        let f = vec_get<QIRFunc>(funcs, j)
        let wf = wasm_compile_function(cg, f.name, f.param_count, f.body)
        cg.functions = vec_push<WasmFunc>(cg.functions, wf)
        j = j + 1
    end

    out wasm_emit_binary(cg)
end

func wasm_write_module:
    in(funcs: Vec<QIRFunc>; path: string)
    let bytes = wasm_compile_module(funcs)
    write_bytes_to_file(path, bytes)
end


# ═══════════════════════════════════════════════════════
# Exports
# ═══════════════════════════════════════════════════════

export WasmCodegen, WasmFunc, QIRFunc, TypeSig
export wasm_codegen_new, wasm_func_new
export wf_emit, wf_emit_i64_const, wf_emit_f64_const
export wf_emit_local_get, wf_emit_local_set, wf_emit_call
export wf_emit_br, wf_emit_br_if, wf_encode_body
export wf_push_operand, wf_pop_to_dest
export wasm_compile_instr, wasm_compile_function
export wasm_compile_module, wasm_write_module
export wasm_emit_binary
export wasm_uleb128, wasm_sleb128, wasm_encode_string
export wasm_append_section, wasm_append_vec
# ══ END vir/compiler/codegen_wasm ══

# ══ BEGIN vir/compiler/main ══
##
 * vir/compiler/main.vri — Vir Self-Hosting Compiler Driver
 * =========================================================
 * Phase 5: Bootstrap — Vir compiles itself to a standalone binary.
 *
 * Pipeline:
 *   source.vri → lex → parse → lower → regalloc → codegen → link → Mach-O
 *
 * Produces a standalone Mach-O ARM64 executable that uses direct
 * BSD syscalls — no Python, no C library, no external linker needed.
 *
 * Usage (Stage 1 — bootstrapped via C runtime):
 *   vir jit stdlib/vir/compiler/main.vri <input.vri> [-o output]
 *
 * Usage (Stage 2 — self-hosted):
 *   ./virc <input.vri> [-o output]
 *
 * Date: 9/3/2026
 ##

    buf_write_u32_le, buf_write_u64_le, buf_write_zeros,
    buf_write_string_padded, buf_write_bytes, buf_size, buf_align
    file_create, file_write_all, file_close


# ═══════════════════════════════════════════════════════
# Mach-O Constants (macOS ARM64)
# ═══════════════════════════════════════════════════════

const MACHO_MAGIC: 0xFEEDFACF
const CPU_ARM64: 0x0100000C
const CPU_SUB_ALL: 0x00000000
const MH_EXECUTE: 2
const MH_FLAGS: 0x00200085    # PIE | TWOLEVEL | DYLDLINK
const LC_SEGMENT_64: 0x19
const LC_MAIN: 0x80000028
const LC_SYMTAB: 0x02
const TEXT_BASE: 0x100000000
const PAGE_SIZE: 0x4000

# macOS BSD syscall numbers (add 0x2000000 for BSD layer)
const SYS_EXIT: 0x2000001
const SYS_WRITE: 0x2000004
const SYS_CHMOD: 0x200000F


# ═══════════════════════════════════════════════════════
# Module-Level Code Emission
# ═══════════════════════════════════════════════════════
# Emits all functions from a Q-IR module into a single
# code buffer with cross-function call resolution.

entity FuncLayout:
    name:       string
    code_off:   int    # byte offset in the code buffer
    fsize:      int
end

# Emit the ARM64 runtime stubs that compiled programs need:
#   offset 0: _rt_print_i64  — print integer to stdout + newline
#   offset N: _rt_exit       — exit process
# Returns (cb, print_offset, exit_offset, total_runtime_size)

func emit_runtime_arm64:
    in(cb:CodeBuf)
    g_rt_print_off = codebuf_offset(cb)

    # ── _rt_print_i64: X0 = value to print ──
    # Prologue: save frame + callee-saved registers
    cb = arm64_stp_pre(cb, 29, 30, 31, -160)    # STP X29, X30, [SP, #-160]!
    cb = arm64_mov_sp_to(cb, 29)               # MOV X29, SP
    # Save callee-saved registers X19-X26
    # STP X19, X20, [SP, #16]
    cb = codebuf_emit_u32(cb, 0xA90153F3)
    # STP X21, X22, [SP, #32]
    cb = codebuf_emit_u32(cb, 0xA9025BF5)
    # STP X23, X24, [SP, #48]
    cb = codebuf_emit_u32(cb, 0xA90363F7)
    # STP X25, X26, [SP, #64]
    cb = codebuf_emit_u32(cb, 0xA9046BF9)
    # STP X27, X28, [SP, #80]
    cb = codebuf_emit_u32(cb, 0xA90573FB)
    cb = arm64_mov_rr(cb, 19, 0)               # MOV X19, X0 (save value)
    cb = arm64_mov_rr(cb, 27, 0)               # MOV X27, X0 (preserve for caller)

    # Buffer at SP+96, X20 = buffer base, X21 = position
    # ADD X20, SP, #96
    # ARM64 ADD immediate: 0x91000000 | (imm12 << 10) | (Rn << 5) | Rd
    cb = codebuf_emit_u32(cb, 0x91000000 | (96 << 10) | (31 << 5) | 20)
    cb = arm64_mov_imm16(cb, 21, 0)            # MOV X21, #0 (position)
    cb = arm64_mov_imm16(cb, 22, 0)            # MOV X22, #0 (is_neg)

    # Handle negative: if X19 < 0
    # CMP X19, #0
    cb = arm64_cmp_imm0(cb, 19)
    # B.GE +3 instructions (skip negate)
    # B.GE is B.cond with cond=0b1010=10, imm19 = 3
    cb = codebuf_emit_u32(cb, 0x5400006A)   # B.GE +3*4
    # NEG X19, X19 → SUB X19, XZR, X19
    cb = codebuf_emit_u32(cb, 0xCB1303F3)   # SUB X19, XZR, X19
    # MOV X22, #1 (is_neg = true)
    cb = arm64_mov_imm16(cb, 22, 1)

    # Handle zero: CBZ X19, .is_zero → 4 instructions forward to .is_zero
    # CBZ X19 = 0xB4000000 | (imm19 << 5) | 19
    # .is_zero is after the digit loop, need forward ref
    # Use placeholder, will back-patch
    zero_check_patch = codebuf_offset(cb)
    cb = codebuf_emit_u32(cb, 0xB4000013)       # CBZ X19, placeholder

    # Digit conversion loop
    cb = arm64_mov_imm16(cb, 23, 10)             # MOV X23, #10
    # .digit_loop:
    digit_loop = codebuf_offset(cb)
    # CBZ X19, .digits_done
    digits_done_patch = codebuf_offset(cb)
    cb = codebuf_emit_u32(cb, 0xB4000013)       # CBZ X19, placeholder

    # UDIV X24, X19, X23
    cb = codebuf_emit_u32(cb, 0x9AD70A78)       # UDIV X24, X19, X23
    # MSUB X25, X24, X23, X19 → X25 = X19 - X24*X23
    cb = codebuf_emit_u32(cb, 0x9B17CF19)       # MSUB X25, X24, X23, X19
    # ADD X25, X25, #48 ('0')
    cb = codebuf_emit_u32(cb, 0x9100C339)       # ADD X25, X25, #48
    # STRB W25, [X20, X21]
    cb = codebuf_emit_u32(cb, 0x38356A99)       # STRB W25, [X20, X21]
    # ADD X21, X21, #1
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1
    # MOV X19, X24 (quotient)
    cb = arm64_mov_rr(cb, 19, 24)
    # B .digit_loop
    back = (digit_loop - codebuf_offset(cb)) / 4
    cb = codebuf_emit_u32(cb, 0x14000000 | (back & 0x03FFFFFF))
    # B .reverse (skip .is_zero)
    skip_zero_patch = codebuf_offset(cb)
    cb = codebuf_emit_u32(cb, 0x14000000)        # B placeholder

    # .is_zero: store '0'
    is_zero = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 25, 48)             # MOV X25, #'0'
    cb = codebuf_emit_u32(cb, 0x38356A99)        # STRB W25, [X20, X21]
    cb = codebuf_emit_u32(cb, 0x910006B5)        # ADD X21, X21, #1

    # .digits_done / .reverse:
    reverse_start = codebuf_offset(cb)

    # Patch zero_check_patch → .is_zero
    zc_off = (is_zero - zero_check_patch) / 4
    cb = codebuf_patch_u32(cb, zero_check_patch,
        0xB4000013 | ((zc_off & 0x7FFFF) << 5))

    # Patch digits_done_patch → reverse_start
    dd_off = (reverse_start - digits_done_patch) / 4
    cb = codebuf_patch_u32(cb, digits_done_patch,
        0xB4000013 | ((dd_off & 0x7FFFF) << 5))

    # Patch skip_zero_patch → reverse_start
    sz_off = (reverse_start - skip_zero_patch) / 4
    cb = codebuf_patch_u32(cb, skip_zero_patch,
        0x14000000 | (sz_off & 0x03FFFFFF))

    # Add '-' if negative
    # CBZ X22, .skip_minus
    skip_minus_patch = codebuf_offset(cb)
    cb = codebuf_emit_u32(cb, 0xB4000016)       # CBZ X22, placeholder
    cb = arm64_mov_imm16(cb, 25, 45)            # MOV X25, #'-'
    cb = codebuf_emit_u32(cb, 0x38356A99)       # STRB W25, [X20, X21]
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1
    # .skip_minus:
    skip_minus = codebuf_offset(cb)
    sm_off = (skip_minus - skip_minus_patch) / 4
    cb = codebuf_patch_u32(cb, skip_minus_patch,
        0xB4000016 | ((sm_off & 0x7FFFF) << 5))

    # Reverse the digit string in-place
    cb = arm64_mov_imm16(cb, 23, 0)             # X23 = left = 0
    cb = arm64_mov_rr(cb, 24, 21)               # X24 = right = X21 (len)
    cb = codebuf_emit_u32(cb, 0xD1000718)       # SUB X24, X24, #1

    # .rev_loop:
    rev_loop = codebuf_offset(cb)
    # CMP X23, X24
    cb = codebuf_emit_u32(cb, 0xEB1802FF)       # CMP X23, X24
    # B.GE .rev_done
    rev_done_patch = codebuf_offset(cb)
    cb = codebuf_emit_u32(cb, 0x5400000A)       # B.GE placeholder

    # LDRB W25, [X20, X23]
    cb = codebuf_emit_u32(cb, 0x38776A99)       # LDRB W25, [X20, X23]
    # LDRB W26, [X20, X24]
    cb = codebuf_emit_u32(cb, 0x38786A9A)       # LDRB W26, [X20, X24]
    # STRB W26, [X20, X23]
    cb = codebuf_emit_u32(cb, 0x38376A9A)       # STRB W26, [X20, X23]
    # STRB W25, [X20, X24]
    cb = codebuf_emit_u32(cb, 0x38386A99)       # STRB W25, [X20, X24]
    # ADD X23, X23, #1
    cb = codebuf_emit_u32(cb, 0x910006F7)       # ADD X23, X23, #1
    # SUB X24, X24, #1
    cb = codebuf_emit_u32(cb, 0xD1000718)       # SUB X24, X24, #1
    # B .rev_loop
    rv_off = (rev_loop - codebuf_offset(cb)) / 4
    cb = codebuf_emit_u32(cb, 0x14000000 | (rv_off & 0x03FFFFFF))

    # .rev_done:
    rev_done = codebuf_offset(cb)
    rd_off = (rev_done - rev_done_patch) / 4
    cb = codebuf_patch_u32(cb, rev_done_patch,
        0x5400000A | ((rd_off & 0x7FFFF) << 5))

    # Append newline: '\n' = 10
    cb = arm64_mov_imm16(cb, 25, 10)
    cb = codebuf_emit_u32(cb, 0x38356A99)       # STRB W25, [X20, X21]
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1

    # syscall write(1, X20, X21)
    cb = arm64_mov_imm16(cb, 0, 1)              # fd = stdout
    cb = arm64_mov_rr(cb, 1, 20)                # buf
    cb = arm64_mov_rr(cb, 2, 21)                # len
    # MOV X16, #0x2000004 (SYS_WRITE with BSD offset)
    cb = arm64_mov_imm16(cb, 16, 4)             # low 16 bits
    cb = codebuf_emit_u32(cb, 0xF2A04010)       # MOVK X16, #0x200, LSL#16

    cb = arm64_svc(cb, 128)                      # SVC #0x80

    # Restore X0 so caller's vreg0 is preserved
    cb = arm64_mov_rr(cb, 0, 27)               # MOV X0, X27

    # Restore callee-saved registers X19-X28
    # LDP X19, X20, [SP, #16]
    cb = codebuf_emit_u32(cb, 0xA94153F3)
    # LDP X21, X22, [SP, #32]
    cb = codebuf_emit_u32(cb, 0xA9425BF5)
    # LDP X23, X24, [SP, #48]
    cb = codebuf_emit_u32(cb, 0xA94363F7)
    # LDP X25, X26, [SP, #64]
    cb = codebuf_emit_u32(cb, 0xA9446BF9)
    # LDP X27, X28, [SP, #80]
    cb = codebuf_emit_u32(cb, 0xA94573FB)

    # Epilogue
    cb = arm64_ldp_post(cb, 29, 30, 31, 160)     # LDP X29, X30, [SP], #160
    cb = arm64_ret(cb)

    print_size = codebuf_offset(cb) - g_rt_print_off

    # ── _rt_print_str: X0 = char ptr, X1 = length ──
    cb.rt_printstr_off = codebuf_offset(cb)
    g_rt_printstr_off = cb.rt_printstr_off
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16)
    # MOV buffer and length to syscall args
    # write(1, buf, len) → X0=fd, X1=buf, X2=len
    cb = arm64_mov_rr(cb, 2, 1);               # X2 = len
    cb = arm64_mov_rr(cb, 1, 0);               # X1 = buf
    cb = arm64_mov_imm16(cb, 0, 1);            # X0 = 1 (stdout)
    cb = arm64_mov_imm16(cb, 16, 4);           # X16 = SYS_WRITE
    cb = codebuf_emit_u32(cb, 0xF2A04010);     # MOVK X16, #0x200, LSL#16
    cb = arm64_svc(cb, 128)
    # Print newline: write(1, "\n", 1)
    # Store '\n' on stack: MOV W17, #10; STRB W17, [SP, #-1]!
    cb = arm64_mov_imm16(cb, 17, 10)
    # STR byte on stack: SUB SP, SP, #16; STRB W17, [SP]
    cb = codebuf_emit_u32(cb, 0xD10043FF);     # SUB SP, SP, #16
    cb = codebuf_emit_u32(cb, 0x390003F1);     # STRB W17, [SP]
    cb = arm64_mov_imm16(cb, 0, 1);            # fd = stdout
    cb = arm64_mov_sp_to(cb, 1);               # buf = SP
    cb = arm64_mov_imm16(cb, 2, 1);            # len = 1
    cb = arm64_mov_imm16(cb, 16, 4)
    cb = codebuf_emit_u32(cb, 0xF2A04010)
    cb = arm64_svc(cb, 128)
    cb = codebuf_emit_u32(cb, 0x910043FF);     # ADD SP, SP, #16
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    # ── _rt_strlen: X0 = ptr to null-terminated string → X0 = length ──
    local_strlen_off = codebuf_offset(cb)
    cb = arm64_mov_rr(cb, 1, 0);                # MOV X1, X0 (save base)
    # .loop: LDRB W2, [X0], #1
    cb = codebuf_emit_u32(cb, 0x38401402);      # LDRB W2, [X0], #1
    # CBNZ W2, .loop (-1 instruction)
    cb = codebuf_emit_u32(cb, 0x35FFFFE2);      # CBNZ W2, -4
    cb = arm64_sub_rrr(cb, 0, 0, 1);            # SUB X0, X0, X1 (end-base)
    cb = codebuf_emit_u32(cb, 0xD1000400);      # SUB X0, X0, #1 (exclude null)
    cb = arm64_ret(cb)

    # ── _rt_strcat: X0 = s1, X1 = s2 → X0 = new concatenated string ptr ──
    # Uses bump allocator at globals[0] (accessible via X15)
    local_strcat_off = codebuf_offset(cb)
    # Prologue: save frame + callee-saved regs we use
    cb = arm64_stp_pre(cb, 29, 30, 31, -48);    # STP X29, X30, [SP, #-48]!
    cb = codebuf_emit_u32(cb, 0xA90153F3);      # STP X19, X20, [SP, #16]
    cb = codebuf_emit_u32(cb, 0xA9025BF5);      # STP X21, X22, [SP, #32]
    cb = arm64_mov_rr(cb, 19, 0);               # MOV X19, X0 (save s1)
    cb = arm64_mov_rr(cb, 20, 1);               # MOV X20, X1 (save s2)
    # strlen(s1): BL _rt_strlen
    strlen_bl1 = codebuf_offset(cb)
    strlen_delta1 = (local_strlen_off - strlen_bl1) / 4
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta1 & 0x03FFFFFF))
    cb = arm64_mov_rr(cb, 21, 0);               # MOV X21, X0 (len1)
    # strlen(s2)
    cb = arm64_mov_rr(cb, 0, 20);               # MOV X0, X20 (s2)
    strlen_bl2 = codebuf_offset(cb)
    strlen_delta2 = (local_strlen_off - strlen_bl2) / 4
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta2 & 0x03FFFFFF))
    cb = arm64_mov_rr(cb, 22, 0);               # MOV X22, X0 (len2)
    # Bump alloc: total = len1 + len2 + 1
    cb = arm64_add_rrr(cb, 2, 21, 22);          # ADD X2, X21, X22
    cb = codebuf_emit_u32(cb, 0x91000442);      # ADD X2, X2, #1 (null terminator)
    cb = arm64_ldr_imm(cb, 3, 15, 0);           # LDR X3, [X15, #0] (heap ptr)
    cb = arm64_mov_rr(cb, 4, 3);                # MOV X4, X3 (save new string start)
    cb = arm64_add_rrr(cb, 3, 3, 2);            # ADD X3, X3, X2 (advance heap)
    cb = arm64_str_imm(cb, 3, 15, 0);           # STR X3, [X15, #0]
    # Copy s1 bytes: dst=X4→X0, src=X19→X1, len=X21→X2
    cb = arm64_mov_rr(cb, 0, 4);                # MOV X0, X4 (dst)
    cb = arm64_mov_rr(cb, 1, 19);               # MOV X1, X19 (src=s1)
    cb = arm64_mov_rr(cb, 2, 21);               # MOV X2, X21 (len=len1)
    # CBZ X2, +4 (skip copy1 loop = 4 instrs ahead)
    cb = codebuf_emit_u32(cb, 0xB4000082);      # CBZ X2, +4
    # .copy1:
    cb = codebuf_emit_u32(cb, 0x38401423);      # LDRB W3, [X1], #1
    cb = codebuf_emit_u32(cb, 0x38001403);      # STRB W3, [X0], #1
    cb = codebuf_emit_u32(cb, 0xD1000442);      # SUB X2, X2, #1
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);      # CBNZ X2, -3 (.copy1)
    # Copy s2 bytes
    cb = arm64_mov_rr(cb, 1, 20);               # MOV X1, X20 (src=s2)
    cb = arm64_mov_rr(cb, 2, 22);               # MOV X2, X22 (len=len2)
    # CBZ X2, +4 (skip copy2 loop)
    cb = codebuf_emit_u32(cb, 0xB4000082);      # CBZ X2, +4
    # .copy2:
    cb = codebuf_emit_u32(cb, 0x38401423);      # LDRB W3, [X1], #1
    cb = codebuf_emit_u32(cb, 0x38001403);      # STRB W3, [X0], #1
    cb = codebuf_emit_u32(cb, 0xD1000442);      # SUB X2, X2, #1
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);      # CBNZ X2, -3 (.copy2)
    # Null terminate: STRB WZR, [X0]
    cb = codebuf_emit_u32(cb, 0x3900001F);      # STRB WZR, [X0, #0]
    # Return new string ptr
    cb = arm64_mov_rr(cb, 0, 4);                # MOV X0, X4
    # Epilogue: restore callee-saved regs
    cb = codebuf_emit_u32(cb, 0xA9425BF5);      # LDP X21, X22, [SP, #32]
    cb = codebuf_emit_u32(cb, 0xA94153F3);      # LDP X19, X20, [SP, #16]
    cb = arm64_ldp_post(cb, 29, 30, 31, 48);    # LDP X29, X30, [SP], #48
    cb = arm64_ret(cb)

    # ── _rt_exit: X0 = exit code (already in X0) ──
    cb.rt_exit_off = codebuf_offset(cb)
    g_rt_exit_off = cb.rt_exit_off
    # MOV X16, #0x2000001 (SYS_EXIT with BSD offset)
    cb = arm64_mov_imm16(cb, 16, 1)             # low bits
    cb = codebuf_emit_u32(cb, 0xF2A04010)       # MOVK X16, #0x200, LSL#16
    cb = arm64_svc(cb, 128)                      # SVC #0x80

    out cb
end


# ═══════════════════════════════════════════════════════
# Module Codegen
# ═══════════════════════════════════════════════════════
# Emits all functions in a QModule into a single CodeBuf.
# Cross-function calls are resolved via the FuncLayout table.

func codegen_emit_module:
    in(module:QModule; arch:TargetArch)
    # Phase 1: Emit runtime stubs + all functions
    cb = codebuf_new(arch)
    layouts = vec_new_rt()
    layout_count = 0
    fixup_offsets = vec_new_rt()
    fixup_targets = vec_new_rt()
    fixup_count = 0
    func_adr_patches = vec_new_rt()
    func_adr_targets = vec_new_rt()
    func_adr_dregs = vec_new_rt()
    main_idx = -1
    ginit_idx = -1

    # Scan all functions to find max global index used
    max_gidx = -1
    gi = 0
    nfuncs_scan = vec_len_rt(module.functions)
    when gi < nfuncs_scan loop
        gfn = vec_get_rt(module.functions, gi)
        gj = 0
        gbodylen = vec_len_rt(gfn.body)
        when gj < gbodylen loop
            gins = vec_get_rt(gfn.body, gj)
            if gins.opcode == QOp::LoadGlobal or gins.opcode == QOp::StoreGlobal:
                gval = gins.src1.imm_val
                if gval > max_gidx:
                    max_gidx = gval
                end
            end
            gj = gj + 1
        end
        gi = gi + 1
    end
    num_globals = max_gidx + 1

    # Reserve globals slots for string data pointers
    # Each string needs 2 slots: [ptr, len]
    # Start after globals[0] (heap ptr)
    str_count = vec_len_rt(module.strings)
    str_globals_base = 1 + num_globals;  # globals[0] = heap, then global vars, then strings
    str_adr_patches = vec_new_rt();   # offsets of ADR instructions to patch
    str_adr_indices = vec_new_rt();   # corresponding string index

    # Emit runtime stubs first
    rt_print_off = codebuf_offset(cb)
    cb = emit_runtime_arm64(cb)
    rt_exit_off = cb.rt_exit_off
    rt_printstr_off = cb.rt_printstr_off
    rt_strlen_off = rt_exit_off - 172
    rt_strcat_off = rt_exit_off - 148
    runtime_size = codebuf_offset(cb)

    # Emit each function
    fi = 0
    nfuncs = vec_len_rt(module.functions)
    when fi < nfuncs loop
        qfn = vec_get_rt(module.functions, fi)
        bodylen = vec_len_rt(qfn.body)
        func_start = codebuf_offset(cb)

        # Track main function
        if rt_streq(qfn.name, "main") or rt_streq(qfn.name, "__main__"):
            main_idx = fi
        end
        if rt_streq(qfn.name, "__ginit"):
            ginit_idx = fi
        end

        # All user functions need a stack frame since vregs map to callee-saved x19+
        needs_frame = 1

        # Scan max vreg for stack spilling
        max_vreg = 0
        vi = 0
        when vi < bodylen loop
            vins = vec_get_rt(qfn.body, vi)
            if vins.dest.op_type == OperandType::VReg and vins.dest.vreg > max_vreg:
                max_vreg = vins.dest.vreg
            end
            if vins.src1.op_type == OperandType::VReg and vins.src1.vreg > max_vreg:
                max_vreg = vins.src1.vreg
            end
            if vins.src2.op_type == OperandType::VReg and vins.src2.vreg > max_vreg:
                max_vreg = vins.src2.vreg
            end
            vi = vi + 1
        end
        spill_count = 0
        if max_vreg >= 16:
            spill_count = max_vreg - 15
        end
        spill_extra = ((spill_count + 1) / 2) * 16
        frame_size = 160 + spill_extra

        # Emit prologue
        if needs_frame == 1:
            # Save frame pointer, link register, and callee-saved x19-x28
            # Frame = frame_size bytes: 16(fp/lr) + 80(x19-x28) + 64(call spill) + spill_extra
            cb = arm64_stp_pre(cb, 29, 30, 31, 0 - frame_size)
            cb = arm64_mov_sp_to(cb, 29)
            # Save x19-x28 (callee-saved regs used for vregs)
            cb = codebuf_emit_u32(cb, 0xA90153F3);   # STP X19, X20, [SP, #16]
            cb = codebuf_emit_u32(cb, 0xA9025BF5);   # STP X21, X22, [SP, #32]
            cb = codebuf_emit_u32(cb, 0xA90363F7);   # STP X23, X24, [SP, #48]
            cb = codebuf_emit_u32(cb, 0xA9046BF9);   # STP X25, X26, [SP, #64]
            cb = codebuf_emit_u32(cb, 0xA90573FB);   # STP X27, X28, [SP, #80]
        end

        # Move function arguments from x0-x7 to callee-saved registers
        # vreg0=x19, vreg1=x20, etc.
        nparams = qfn.param_count
        if nparams > 0:
            cb = arm64_mov_rr(cb, 19, 0)
        end
        if nparams > 1:
            cb = arm64_mov_rr(cb, 20, 1)
        end
        if nparams > 2:
            cb = arm64_mov_rr(cb, 21, 2)
        end
        if nparams > 3:
            cb = arm64_mov_rr(cb, 22, 3)
        end
        if nparams > 4:
            cb = arm64_mov_rr(cb, 23, 4)
        end
        if nparams > 5:
            cb = arm64_mov_rr(cb, 24, 5)
        end
        if nparams > 6:
            cb = arm64_mov_rr(cb, 25, 6)
        end
        if nparams > 7:
            cb = arm64_mov_rr(cb, 26, 7)
        end

        # Emit instructions
        ps = patch_new()
        j = 0
        when j < vec_len_rt(qfn.body) loop
            ins = vec_get_rt(qfn.body, j)

            # Handle critical opcodes separately to avoid deep if/eif nesting
            handled = 0
            if ins.opcode == QOp::Print:
                if ins.src1.op_type == OperandType::VReg:
                    if ins.src1.vreg >= 16:
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8)
                    end
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                end
                # Save caller-saved vregs x9-x14 before print call
                cb = codebuf_emit_u32(cb, 0xA9062BE9);   # STP X9, X10, [SP, #96]
                cb = codebuf_emit_u32(cb, 0xA90733EB);   # STP X11, X12, [SP, #112]
                cb = codebuf_emit_u32(cb, 0xA9083BED);   # STP X13, X14, [SP, #128]
                print_bl_off = codebuf_offset(cb)
                delta = (rt_print_off - print_bl_off) / 4
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))
                # Restore caller-saved vregs x9-x14 after print call
                cb = codebuf_emit_u32(cb, 0xA9462BE9);   # LDP X9, X10, [SP, #96]
                cb = codebuf_emit_u32(cb, 0xA94733EB);   # LDP X11, X12, [SP, #112]
                cb = codebuf_emit_u32(cb, 0xA9483BED);   # LDP X13, X14, [SP, #128]
                handled = 1
            end
            if ins.opcode == QOp::Ret:
                if ins.src1.op_type == OperandType::VReg:
                    if ins.src1.vreg >= 16:
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8)
                    end
                    if vreg_to_arm(ins.src1.vreg) != 0:
                        cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                    end
                end
                if needs_frame == 1:
                    cb = codebuf_emit_u32(cb, 0xA94153F3);   # LDP X19, X20, [SP, #16]
                    cb = codebuf_emit_u32(cb, 0xA9425BF5);   # LDP X21, X22, [SP, #32]
                    cb = codebuf_emit_u32(cb, 0xA94363F7);   # LDP X23, X24, [SP, #48]
                    cb = codebuf_emit_u32(cb, 0xA9446BF9);   # LDP X25, X26, [SP, #64]
                    cb = codebuf_emit_u32(cb, 0xA94573FB);   # LDP X27, X28, [SP, #80]
                    cb = arm64_ldp_post(cb, 29, 30, 31, frame_size)
                end
                cb = arm64_ret(cb)
                handled = 1
            end
            if ins.opcode == QOp::Exit:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                end
                exit_bl_off = codebuf_offset(cb)
                delta = (rt_exit_off - exit_bl_off) / 4
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))
                handled = 1
            end
            if ins.opcode == QOp::Halt:
                cb = arm64_mov_imm16(cb, 0, 0)
                cb = arm64_ret(cb)
                handled = 1
            end
            if ins.opcode == QOp::Label:
                ps = patch_add_label(ps, ins.dest.vreg, codebuf_offset(cb))
                handled = 1
            end
            if ins.opcode == QOp::Jump:
                if ins.src1.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0)
                end
                cb = arm64_b_imm26(cb, 0)
                handled = 1
            end
            if ins.opcode == QOp::JumpIfNot:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg))
                end
                if ins.src2.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1)
                end
                cb = arm64_beq_imm19(cb, 0)
                handled = 1
            end
            if ins.opcode == QOp::JumpIf:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg))
                end
                if ins.src2.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1)
                end
                cb = arm64_bne_imm19(cb, 0)
                handled = 1
            end
            if ins.opcode == QOp::SetArg:
                # SetArg: dest.imm = ABI arg index (0..3), src1.vreg = value vreg
                cb = arm64_mov_rr(cb, ins.dest.imm_val, vreg_to_arm(ins.src1.vreg))
                handled = 1
            end
            if ins.opcode == QOp::LoadFuncAddr:
                # LoadFuncAddr: dest = address of function src1.vreg (func index)
                dreg = vreg_to_arm(ins.dest.vreg)
                func_adr_patches = vec_push_rt(func_adr_patches, codebuf_offset(cb))
                func_adr_targets = vec_push_rt(func_adr_targets, ins.src1.vreg)
                func_adr_dregs = vec_push_rt(func_adr_dregs, dreg)
                cb = codebuf_emit_u32(cb, 0x10000000 | dreg);   # ADR Xdreg, #0 placeholder
                handled = 1
            end
            if ins.opcode == QOp::Call or ins.opcode == QOp::CallFunc:
                # Save caller-saved vregs x9-x14 before call
                cb = codebuf_emit_u32(cb, 0xA9062BE9);   # STP X9, X10, [SP, #96]
                cb = codebuf_emit_u32(cb, 0xA90733EB);   # STP X11, X12, [SP, #112]
                cb = codebuf_emit_u32(cb, 0xA9083BED);   # STP X13, X14, [SP, #128]
                if ins.src1.op_type == OperandType::VReg:
                    # Indirect call: MOV X16, src_vreg; BLR X16
                    cb = arm64_mov_rr(cb, 16, vreg_to_arm(ins.src1.vreg))
                    cb = arm64_blr_x16(cb)
                eif ins.src1.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0)
                    cb = arm64_bl_imm26(cb, 0)
                eif ins.src1.op_type == OperandType::FuncIdx:
                    fixup_offsets = vec_push_rt(fixup_offsets, codebuf_offset(cb))
                    fixup_targets = vec_push_rt(fixup_targets, ins.src1.vreg)
                    fixup_count = fixup_count + 1
                    cb = arm64_bl_imm26(cb, 0)
                end
                # Restore caller-saved vregs x9-x14 after call
                cb = codebuf_emit_u32(cb, 0xA9462BE9);   # LDP X9, X10, [SP, #96]
                cb = codebuf_emit_u32(cb, 0xA94733EB);   # LDP X11, X12, [SP, #112]
                cb = codebuf_emit_u32(cb, 0xA9483BED);   # LDP X13, X14, [SP, #128]
                # Move return value from x0 directly into dest vreg
                if ins.dest.op_type == OperandType::VReg:
                    cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0)
                end
                handled = 1
            end
            if ins.opcode == QOp::LoadGlobal:
                # LoadGlobal: dest = globals[src1.imm]
                # X15 = globals base, globals[0] reserved for heap ptr, user globals at idx+1
                gidx = ins.src1.imm_val + 1
                cb = arm64_movz_imm64(cb, 17, gidx >> int)
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), 15, 17)
                handled = 1
            end
            if ins.opcode == QOp::StoreGlobal:
                # StoreGlobal: globals[src1.imm] = src2.vreg
                gidx = ins.src1.imm_val + 1
                cb = arm64_movz_imm64(cb, 17, gidx >> int)
                cb = arm64_str_reg(cb, vreg_to_arm(ins.src2.vreg), 15, 17)
                handled = 1
            end
            if ins.opcode == QOp::Alloc:
                # Alloc: dest = bump_alloc(src1.vreg bytes)
                # globals[0] = heap pointer (in X15)
                cb = arm64_ldr_imm(cb, 17, 15, 0);               # LDR X17, [X15, #0] — heap ptr
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 17);  # dest = current heap ptr
                cb = arm64_add_rrr(cb, 17, 17, vreg_to_arm(ins.src1.vreg));  # X17 += size
                cb = arm64_str_imm(cb, 17, 15, 0);               # STR X17, [X15, #0] — update heap ptr
                handled = 1
            end
            if ins.opcode == QOp::ArrNew:
                # ArrNew: dest = new array with capacity src1.vreg
                # Layout: [cap, len, data...] — (cap+2)*8 bytes
                # Use X17 for temp calculations
                cb = arm64_add_imm(cb, 17, vreg_to_arm(ins.src1.vreg), 2);  # X17 = cap + 2
                # Multiply by 8: LSL X17, X17, #3
                cb = codebuf_emit_u32(cb, 0xD37DF231);           # LSL X17, X17, #3 → UBFM X17,X17,#61,#60
                # Bump alloc
                rd = vreg_to_arm(ins.dest.vreg)
                cb = arm64_ldr_imm(cb, rd, 15, 0);               # LDR Xd, [X15] — heap ptr
                cb = arm64_add_rrr(cb, 17, rd, 17);              # X17 = heap + total_bytes
                cb = arm64_str_imm(cb, 17, 15, 0);               # STR X17, [X15] — update heap
                # Store capacity at [arr+0], length 0 at [arr+8]
                cb = arm64_str_imm(cb, vreg_to_arm(ins.src1.vreg), rd, 0);  # [arr] = cap
                cb = arm64_mov_imm16(cb, 17, 0);                 # X17 = 0
                cb = arm64_str_imm(cb, 17, rd, 8);               # [arr+8] = 0 (len=0)
                handled = 1
            end
            if ins.opcode == QOp::ArrPush:
                # ArrPush: src1=arr, src2=element — arr[len++] = elem
                arr_reg = vreg_to_arm(ins.src1.vreg)
                elem_reg = vreg_to_arm(ins.src2.vreg)
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);          # X17 = len
                cb = arm64_add_imm(cb, 17, 17, 2);               # X17 = len + 2 (skip header)
                cb = arm64_str_reg(cb, elem_reg, arr_reg, 17);   # [arr + X17*8] = elem
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);          # reload len
                cb = arm64_add_imm(cb, 17, 17, 1);               # len++
                cb = arm64_str_imm(cb, 17, arr_reg, 8);          # [arr+8] = new len
                handled = 1
            end
            if ins.opcode == QOp::ArrGet:
                # ArrGet: dest = arr[idx] — dest.vreg = src1.vreg[src2.vreg]
                arr_reg = vreg_to_arm(ins.src1.vreg)
                idx_reg = vreg_to_arm(ins.src2.vreg)
                cb = arm64_add_imm(cb, 17, idx_reg, 2);          # X17 = idx + 2
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17);  # dest = [arr + X17*8]
                handled = 1
            end
            if ins.opcode == QOp::ArrSet:
                # ArrSet: arr[idx] = val — src1.vreg[src2.vreg] = dest.vreg
                arr_reg = vreg_to_arm(ins.src1.vreg)
                idx_reg = vreg_to_arm(ins.src2.vreg)
                cb = arm64_add_imm(cb, 17, idx_reg, 2);          # X17 = idx + 2
                cb = arm64_str_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17);  # [arr + X17*8] = val
                handled = 1
            end
            if ins.opcode == QOp::PrintStr:
                # Save caller-saved vregs x9-x14 before any call
                cb = codebuf_emit_u32(cb, 0xA9062BE9)
                cb = codebuf_emit_u32(cb, 0xA90733EB)
                cb = codebuf_emit_u32(cb, 0xA9083BED)
                if ins.src1.op_type == OperandType::StringRef:
                    # StringRef: literal string — load ptr and len from globals
                    str_idx = ins.src1.vreg
                    slot = str_globals_base + str_idx * 2
                    cb = arm64_movz_imm64(cb, 17, slot)
                    cb = arm64_ldr_reg(cb, 0, 15, 17);     # X0 = globals[slot] = str ptr
                    slot_len = slot + 1
                    cb = arm64_movz_imm64(cb, 17, slot_len)
                    cb = arm64_ldr_reg(cb, 1, 15, 17);     # X1 = globals[slot+1] = str len
                else
                    # Variable string (null-terminated ptr in vreg)
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg));  # X0 = string ptr
                    # BL _rt_strlen to get length
                    ps_bl_off = codebuf_offset(cb)
                    ps_delta = (rt_strlen_off - ps_bl_off) / 4
                    cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta & 0x03FFFFFF))
                    cb = arm64_mov_rr(cb, 1, 0);            # X1 = len
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg));  # X0 = string ptr again
                end
                ps_bl_off = codebuf_offset(cb)
                ps_delta = (rt_printstr_off - ps_bl_off) / 4
                cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta & 0x03FFFFFF))
                # Restore caller-saved vregs
                cb = codebuf_emit_u32(cb, 0xA9462BE9)
                cb = codebuf_emit_u32(cb, 0xA94733EB)
                cb = codebuf_emit_u32(cb, 0xA9483BED)
                handled = 1
            end
            if ins.opcode == QOp::ArrLen:
                # ArrLen: dest = length of array src1
                # Array layout: [cap, len, data...] — len is at offset 8
                cb = arm64_ldr_imm(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), 8)
                handled = 1
            end
            if ins.opcode == QOp::StrCat:
                # StrCat: dest = str_cat(src1, src2)
                # src1, src2 are vregs holding null-terminated string ptrs
                # Call _rt_strcat(X0=s1, X1=s2) → X0=new ptr
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));  # X0 = s1
                cb = arm64_mov_rr(cb, 1, vreg_to_arm(ins.src2.vreg));  # X1 = s2
                # Save caller-saved vregs X9-X14
                cb = codebuf_emit_u32(cb, 0xA9062BE9)
                cb = codebuf_emit_u32(cb, 0xA90733EB)
                cb = codebuf_emit_u32(cb, 0xA9083BED)
                # Save callee-saved vregs X19-X22 (clobbered by _rt_strcat internally but it restores them)
                # Actually _rt_strcat saves/restores X19-X22 itself, so caller doesn't need to
                sc_bl_off = codebuf_offset(cb)
                sc_delta = (rt_strcat_off - sc_bl_off) / 4
                cb = codebuf_emit_u32(cb, 0x94000000 | (sc_delta & 0x03FFFFFF))
                # Result in X0 → dest vreg
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0)
                # Restore caller-saved vregs
                cb = codebuf_emit_u32(cb, 0xA9462BE9)
                cb = codebuf_emit_u32(cb, 0xA94733EB)
                cb = codebuf_emit_u32(cb, 0xA9483BED)
                handled = 1
            end
            if ins.opcode == QOp::StrLenOp:
                # StrLenOp: dest = strlen(src1)
                # src1 is a vreg holding a null-terminated string ptr
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));  # X0 = str ptr
                cb = codebuf_emit_u32(cb, 0xA9062BE9);  # save X9-X14
                cb = codebuf_emit_u32(cb, 0xA90733EB)
                cb = codebuf_emit_u32(cb, 0xA9083BED)
                sl_bl_off = codebuf_offset(cb)
                sl_delta = (rt_strlen_off - sl_bl_off) / 4
                cb = codebuf_emit_u32(cb, 0x94000000 | (sl_delta & 0x03FFFFFF))
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);  # dest = X0 = length
                cb = codebuf_emit_u32(cb, 0xA9462BE9);  # restore X9-X14
                cb = codebuf_emit_u32(cb, 0xA94733EB)
                cb = codebuf_emit_u32(cb, 0xA9483BED)
                handled = 1
            end

            if handled == 0:

            # Spill pre-load: load spilled source operands from stack
            # src1 spilled → load to X8 (vreg_to_arm returns X8 for ≥16)
            # src2 spilled → load to X16 to avoid collision with src1 in X8
            s1_reg = 0
            s2_reg = 0
            d_reg = 0
            if ins.src1.op_type == OperandType::VReg:
                s1_reg = vreg_to_arm(ins.src1.vreg)
                if spill_count > 0 and ins.src1.vreg >= 16:
                    cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8)
                end
            end
            if ins.src2.op_type == OperandType::VReg:
                s2_reg = vreg_to_arm(ins.src2.vreg)
                if spill_count > 0 and ins.src2.vreg >= 16:
                    # Use X16 for second spilled operand to avoid X8 collision
                    cb = arm64_ldr_imm(cb, 16, 29, 160 + (ins.src2.vreg - 16) * 8)
                    s2_reg = 16
                end
            end
            if ins.dest.op_type == OperandType::VReg:
                d_reg = vreg_to_arm(ins.dest.vreg)
            end

            if ins.opcode == QOp::Nop:
                cb = arm64_nop(cb)

            eif ins.opcode == QOp::Load:
                if ins.src1.op_type == OperandType::Immediate:
                    cb = arm64_movz_imm64(cb, d_reg, ins.src1.imm_val >> int)
                eif ins.src1.op_type == OperandType::StringRef:
                    # Load string pointer from globals table
                    slot = str_globals_base + ins.src1.vreg * 2
                    cb = arm64_movz_imm64(cb, 17, slot)
                    cb = arm64_ldr_reg(cb, d_reg, 15, 17)
                end

            eif ins.opcode == QOp::Move:
                cb = arm64_mov_rr(cb, d_reg, s1_reg)

            eif ins.opcode == QOp::Add:
                cb = arm64_add_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Sub:
                cb = arm64_sub_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Mul:
                cb = arm64_mul_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Div:
                cb = arm64_sdiv_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Mod:
                # ARM64: dest = src1 - (src1/src2)*src2
                # SDIV X17, Xs1, Xs2
                # MSUB Xd, X17, Xs2, Xs1 → Xd = Xs1 - X17*Xs2
                cb = arm64_sdiv_rrr(cb, 17, s1_reg, s2_reg)
                msub = 0x9B008000 | (s2_reg << 16) | (s1_reg << 10) | (17 << 5) | d_reg
                cb = codebuf_emit_u32(cb, msub)

            eif ins.opcode == QOp::CmpEq:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                cb = arm64_cset_eq(cb, d_reg)

            eif ins.opcode == QOp::CmpNe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                # CSET NE = CSINC Xd, XZR, XZR, EQ  → 0x9A9F07E0
                cb = codebuf_emit_u32(cb, 0x9A9F07E0 | (d_reg & 0x1F))

            eif ins.opcode == QOp::CmpGt:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                cb = arm64_cset_gt(cb, d_reg)

            eif ins.opcode == QOp::CmpLt:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                cb = arm64_cset_lt(cb, d_reg)

            eif ins.opcode == QOp::CmpGe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                cb = arm64_cset_ge(cb, d_reg)

            eif ins.opcode == QOp::CmpLe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg)
                cb = arm64_cset_le(cb, d_reg)

            eif ins.opcode == QOp::And:
                cb = arm64_and_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Or:
                cb = arm64_orr_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Xor:
                cb = arm64_eor_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Shl:
                cb = arm64_lsl_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::Shr:
                cb = arm64_asr_rrr(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::LoadByte:
                cb = arm64_ldrb_reg(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::StoreByte:
                cb = arm64_strb_reg(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::LoadWord:
                cb = arm64_ldr_reg(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::StoreWord:
                cb = arm64_str_reg(cb, d_reg, s1_reg, s2_reg)

            eif ins.opcode == QOp::PatchPoint:
                cb = arm64_nop(cb)

            else
                cb = arm64_nop(cb)
            end

            end # if handled == 0

            # Spill post-store: if dest vreg is spilled, store from d_reg to stack
            if spill_count > 0 and ins.dest.op_type == OperandType::VReg and ins.dest.vreg >= 16:
                cb = arm64_str_imm(cb, d_reg, 29, 160 + (ins.dest.vreg - 16) * 8)
            end

            j = j + 1
        end

        # If function has no explicit RET, add one
        if vec_len_rt(qfn.body) == 0 or vec_get_rt(qfn.body, vec_len_rt(qfn.body) - 1).opcode != QOp::Ret:
            if needs_frame == 1:
                cb = codebuf_emit_u32(cb, 0xA94153F3);   # LDP X19, X20, [SP, #16]
                cb = codebuf_emit_u32(cb, 0xA9425BF5);   # LDP X21, X22, [SP, #32]
                cb = codebuf_emit_u32(cb, 0xA94363F7);   # LDP X23, X24, [SP, #48]
                cb = codebuf_emit_u32(cb, 0xA9446BF9);   # LDP X25, X26, [SP, #64]
                cb = codebuf_emit_u32(cb, 0xA94573FB);   # LDP X27, X28, [SP, #80]
                cb = arm64_ldp_post(cb, 29, 30, 31, frame_size)
            end
            cb = arm64_ret(cb)
        end

        # Back-patch intra-function jumps
        cb = backpatch_arm64(cb, ps)

        func_size = codebuf_offset(cb) - func_start
        fl = FuncLayout (
            name:   qfn.name,
            code_off: func_start,
            fsize:   func_size
        )
        layouts = vec_push_rt(layouts, fl)
        layout_count = layout_count + 1

        fi = fi + 1
    end

    # Phase 2: Resolve cross-function calls
    fxi = 0
    when fxi < fixup_count loop
        patch_at = vec_get_rt(fixup_offsets, fxi)
        target_idx = vec_get_rt(fixup_targets, fxi)
        if target_idx >= 0 and target_idx < layout_count:
            target_layout = vec_get_rt(layouts, target_idx)
            target_off = target_layout.code_off
            byte_offset = target_off - patch_at
            imm26 = (byte_offset / 4) & 0x03FFFFFF
            cb = codebuf_patch_u32(cb, patch_at, 0x94000000 | imm26)
        end
        fxi = fxi + 1
    end

    # Phase 2b: Patch LoadFuncAddr ADR instructions
    fai = 0
    when fai < vec_len_rt(func_adr_patches) loop
        adr_off = vec_get_rt(func_adr_patches, fai)
        target_fi = vec_get_rt(func_adr_targets, fai)
        adr_rd = vec_get_rt(func_adr_dregs, fai)
        if target_fi >= 0 and target_fi < layout_count:
            target_layout = vec_get_rt(layouts, target_fi)
            target_off = target_layout.code_off
            adr_imm = target_off - adr_off
            immlo = adr_imm & 3
            immhi = (adr_imm >> 2) & 0x7FFFF
            adr_enc = 0x10000000 | (immlo << 29) | (immhi << 5) | adr_rd
            cb = codebuf_patch_u32(cb, adr_off, adr_enc)
        end
        fai = fai + 1
    end

    # Phase 3: Emit _start entry point
    # _start calls main(), then exits with return value
    start_offset = codebuf_offset(cb)
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16)
    cb = arm64_mov_sp_to(cb, 29)

    # ── Allocate globals area via mmap (result → X15) ──
    cb = arm64_mov_imm16(cb, 0, 0);              # x0 = 0 (any address)
    cb = codebuf_emit_u32(cb, 0xD2A00021);        # MOVZ X1, #1, LSL#16 (= 64KB)
    cb = arm64_mov_imm16(cb, 2, 3);              # x2 = PROT_READ|PROT_WRITE
    cb = arm64_mov_imm16(cb, 3, 4098);           # x3 = MAP_ANON|MAP_PRIVATE (0x1002)
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);        # MVN X4, XZR (fd = -1)
    cb = arm64_mov_imm16(cb, 5, 0);              # x5 = 0 (offset)
    cb = arm64_mov_imm16(cb, 16, 197);            # x16 = SYS_mmap (197)
    cb = codebuf_emit_u32(cb, 0xF2A04010);        # MOVK X16, #0x200, LSL#16
    cb = arm64_svc(cb, 128)
    cb = arm64_mov_rr(cb, 15, 0);                # x15 = mmap result (globals base)

    # ── Allocate heap area via mmap (result → globals[0]) ──
    cb = arm64_mov_imm16(cb, 0, 0);              # x0 = 0
    cb = codebuf_emit_u32(cb, 0xD2A00201);        # MOVZ X1, #0x10, LSL#16 (= 1MB)
    cb = arm64_mov_imm16(cb, 2, 3);              # x2 = PROT_READ|PROT_WRITE
    cb = arm64_mov_imm16(cb, 3, 4098);           # x3 = MAP_ANON|MAP_PRIVATE
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);        # MVN X4, XZR
    cb = arm64_mov_imm16(cb, 5, 0);              # x5 = 0
    cb = arm64_mov_imm16(cb, 16, 197);            # x16 = SYS_mmap
    cb = codebuf_emit_u32(cb, 0xF2A04010);        # MOVK X16, #0x200, LSL#16
    cb = arm64_svc(cb, 128)
    cb = arm64_str_imm(cb, 0, 15, 0);            # STR X0, [X15, #0] — globals[0] = heap ptr

    # ── Initialize string data pointers in globals ──
    # For each string in the module, we embedded its bytes after _start/exit.
    # Use ADR to compute runtime address of each string data block.
    si = 0
    when si < str_count loop
        str_val = vec_get_rt(module.strings, si)
        slen = rt_strlen(str_val)
        slot = str_globals_base + si * 2
        slot_len = slot + 1

        # ADR X17, string_data_offset — will be patched later
        str_adr_patches = vec_push_rt(str_adr_patches, codebuf_offset(cb))
        str_adr_indices = vec_push_rt(str_adr_indices, si)
        cb = codebuf_emit_u32(cb, 0x10000011);   # ADR X17, #0 (placeholder)

        # Store ptr in globals[slot]
        cb = arm64_movz_imm64(cb, 16, slot)
        cb = arm64_str_reg(cb, 17, 15, 16);      # globals[slot] = str ptr

        # Store length in globals[slot+1]
        cb = arm64_movz_imm64(cb, 17, slen)
        cb = arm64_movz_imm64(cb, 16, slot_len)
        cb = arm64_str_reg(cb, 17, 15, 16);      # globals[slot+1] = strlen

        si = si + 1
    end

    # Call __ginit if present (global variable initialization)
    if ginit_idx >= 0:
        ginit_layout = vec_get_rt(layouts, ginit_idx)
        ginit_off = ginit_layout.code_off
        ginit_bl = codebuf_offset(cb)
        delta_gi = (ginit_off - ginit_bl) / 4
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta_gi & 0x03FFFFFF))
    end

    if main_idx >= 0:
        # BL to main function
        main_layout = vec_get_rt(layouts, main_idx)
        main_off = main_layout.code_off
        main_bl = codebuf_offset(cb)
        delta = (main_off - main_bl) / 4
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))
    else
        # No main found — return 0
        cb = arm64_mov_imm16(cb, 0, 0)
    end

    # Exit with code 0
    cb = arm64_mov_imm16(cb, 0, 0)
    exit_bl = codebuf_offset(cb)
    exit_delta = (rt_exit_off - exit_bl) / 4
    cb = codebuf_emit_u32(cb, 0x94000000 | (exit_delta & 0x03FFFFFF))

    # LDP + RET (fallback, shouldn't reach)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    # ── Phase 4: Embed string data after code ──
    # Store offset of each string's data bytes, then emit the bytes
    str_data_offsets = vec_new_rt()
    si = 0
    when si < str_count loop
        str_val = vec_get_rt(module.strings, si)
        slen = rt_strlen(str_val)
        # Record the byte offset where this string's data starts
        str_data_offsets = vec_push_rt(str_data_offsets, codebuf_offset(cb))
        # Emit string bytes
        ci = 0
        when ci < slen loop
            ch = str_get(str_val, ci)
            cb = codebuf_emit_byte(cb, ch)
            ci = ci + 1
        end
        # Always null-terminate
        cb = codebuf_emit_byte(cb, 0)
        # Align to 4 bytes (ARM64 instruction alignment)
        when (codebuf_offset(cb) % 4) != 0 loop
            cb = codebuf_emit_byte(cb, 0)
        end
        si = si + 1
    end

    # ── Phase 5: Patch ADR instructions for string pointers ──
    pi = 0
    when pi < vec_len_rt(str_adr_patches) loop
        adr_off = vec_get_rt(str_adr_patches, pi)
        sidx = vec_get_rt(str_adr_indices, pi)
        data_off = vec_get_rt(str_data_offsets, sidx)
        # ADR Xd, offset: encodes PC-relative offset
        # ADR X17: opcode = 0x10000011
        # imm = data_off - adr_off
        adr_imm = data_off - adr_off
        # ADR encoding: immlo = imm[1:0] at bits [30:29], immhi = imm[20:2] at bits [23:5]
        immlo = adr_imm & 3
        immhi = (adr_imm >> 2) & 0x7FFFF
        adr_enc = 0x10000011 | (immlo << 29) | (immhi << 5)
        cb = codebuf_patch_u32(cb, adr_off, adr_enc)
        pi = pi + 1
    end

    cb.start_offset = start_offset
    out cb
end
# Produces a minimal Mach-O ARM64 executable:
#   __PAGEZERO + __TEXT (code) + LC_MAIN + LC_SYMTAB

func emit_macho_executable:
    in(code:CodeBuf)
    obuf = buf_new()
    code_size = codebuf_offset(code) >> int

    # Page-align the code segment
    if PAGE_SIZE == 0:
        text_filesize = code_size
    else
        text_filesize = ((code_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE
    end

    # Layout: [header 32B] [PAGEZERO 72B] [TEXT seg 72+80B] [LC_MAIN 24B] [LC_SYMTAB 24B]
    ncmds = 4 >> int
    cmds_size = (72 + 72 + 80 + 24 + 24) >> int   # 272 bytes
    header_plus_cmds = 32 + cmds_size >> int

    # Entry point = start of code (_start is at end of module, but we want
    # the _start function which is the last thing emitted in codegen_emit_module)
    # Actually the entry offset is relative to __TEXT segment start
    # Since code starts right after header+cmds, entry = offset of _start in code
    # For simplicity, entry at offset 0 (runtime stubs are first, _start is last)
    # We need to pass the _start offset... for now, use the code layout

    # ── Mach-O Header (32 bytes) ──
    obuf = buf_write_u32_le(obuf, MACHO_MAGIC)
    obuf = buf_write_u32_le(obuf, CPU_ARM64)
    obuf = buf_write_u32_le(obuf, CPU_SUB_ALL)
    obuf = buf_write_u32_le(obuf, MH_EXECUTE)
    obuf = buf_write_u32_le(obuf, ncmds)
    obuf = buf_write_u32_le(obuf, cmds_size)
    obuf = buf_write_u32_le(obuf, MH_FLAGS)
    obuf = buf_write_u32_le(obuf, 0)               # reserved

    # ── LC_SEGMENT_64: __PAGEZERO (72 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64)
    obuf = buf_write_u32_le(obuf, 72)
    obuf = buf_write_string_padded(obuf, "__PAGEZERO", 16)
    obuf = buf_write_u64_le(obuf, 0)               # vmaddr
    obuf = buf_write_u64_le(obuf, TEXT_BASE)        # vmsize = 4GB
    obuf = buf_write_u64_le(obuf, 0)               # fileoff
    obuf = buf_write_u64_le(obuf, 0)               # filesize
    obuf = buf_write_u32_le(obuf, 0)               # maxprot
    obuf = buf_write_u32_le(obuf, 0)               # initprot
    obuf = buf_write_u32_le(obuf, 0)               # nsects
    obuf = buf_write_u32_le(obuf, 0)               # flags

    # ── LC_SEGMENT_64: __TEXT (72 + 80 = 152 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64)
    obuf = buf_write_u32_le(obuf, 152)             # 72 + 1 section * 80
    obuf = buf_write_string_padded(obuf, "__TEXT", 16)
    obuf = buf_write_u64_le(obuf, TEXT_BASE)        # vmaddr
    obuf = buf_write_u64_le(obuf, text_filesize)   # vmsize
    obuf = buf_write_u64_le(obuf, 0)               # fileoff
    obuf = buf_write_u64_le(obuf, header_plus_cmds + text_filesize)  # filesize
    obuf = buf_write_u32_le(obuf, 5)               # maxprot (r-x)
    obuf = buf_write_u32_le(obuf, 5)               # initprot (r-x)
    obuf = buf_write_u32_le(obuf, 1)               # nsects
    obuf = buf_write_u32_le(obuf, 0)               # flags

    # __text section header (80 bytes)
    obuf = buf_write_string_padded(obuf, "__text", 16)       # sectname
    obuf = buf_write_string_padded(obuf, "__TEXT", 16)       # segname
    obuf = buf_write_u64_le(obuf, TEXT_BASE + header_plus_cmds)       # addr
    obuf = buf_write_u64_le(obuf, code_size)                          # size
    obuf = buf_write_u32_le(obuf, header_plus_cmds >> int)            # offset
    obuf = buf_write_u32_le(obuf, 2)               # align = 2^2 = 4 bytes
    obuf = buf_write_u32_le(obuf, 0)               # reloff
    obuf = buf_write_u32_le(obuf, 0)               # nreloc
    obuf = buf_write_u32_le(obuf, 0x80000400)      # flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    obuf = buf_write_u32_le(obuf, 0)               # reserved1
    obuf = buf_write_u32_le(obuf, 0)               # reserved2
    obuf = buf_write_u32_le(obuf, 0)               # reserved3

    # ── LC_MAIN (24 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_MAIN)
    obuf = buf_write_u32_le(obuf, 24)
    # Entry offset = code starts at header_plus_cmds, _start is a known offset
    # For now, we put the _start at the beginning of code
    # Actually _start is the LAST thing in the code... we need its offset.
    # We'll pass it as a parameter. For now, entry at 0 = runtime stubs start.
    obuf = buf_write_u64_le(obuf, 0)               # entryoff (will be patched)
    obuf = buf_write_u64_le(obuf, 0)               # stacksize

    # ── LC_SYMTAB (24 bytes, empty) ──
    obuf = buf_write_u32_le(obuf, LC_SYMTAB)
    obuf = buf_write_u32_le(obuf, 24)
    obuf = buf_write_u32_le(obuf, 0)               # symoff
    obuf = buf_write_u32_le(obuf, 0)               # nsyms
    obuf = buf_write_u32_le(obuf, 0)               # stroff
    obuf = buf_write_u32_le(obuf, 0)               # strsize

    # ── Pad to page boundary ──
    current = buf_size(obuf)
    pad_needed = header_plus_cmds >> int - current
    if pad_needed > 0:
        obuf = buf_write_zeros(obuf, pad_needed >> int)
    end

    # ── Code data ──
    cdata = code.data
    ci = 0
    when ci < code_size loop
        obuf = buf_write_u8(obuf, cdata[ci] >> int)
        ci = ci + 1
    end

    # ── Pad code to page ──
    code_pad = text_filesize >> int - code_size >> int
    if code_pad > 0:
        obuf = buf_write_zeros(obuf, code_pad >> int)
    end

    out obuf
end

# Emit with known _start offset
func emit_macho_with_entry:
    in(code:CodeBuf; start_offset:int)
    obuf = emit_macho_executable(code)

    # Patch LC_MAIN entryoff
    # LC_MAIN is at offset: 32 (header) + 72 (PAGEZERO) + 152 (TEXT+sect) + 8 (cmd+cmdsize)
    # = 264
    lc_main_entryoff = 264 >> int
    # Entry offset in file = header_plus_cmds + start_offset
    header_plus_cmds = 304 >> int       # 32 + 72 + 152 + 24 + 24 = 304

    # The entryoff field is at byte 264 (after cmd and cmdsize)
    # Entryoff = file offset relative to __TEXT vmaddr mapping
    # Since __TEXT maps from file offset 0 with vmaddr TEXT_BASE,
    # entryoff = header_plus_cmds + start_offset
    # No — LC_MAIN.entryoff is relative to __TEXT file offset which is 0
    # So entryoff = offset of _start code in the file = header_plus_cmds + start_offset

    # Actually looking at Apple docs: LC_MAIN.entryoff is the file offset
    # of the entry point from the start of the __TEXT segment.
    # __TEXT segment starts at file offset 0, so entryoff = header_plus_cmds + start_offset

    # Patch the entry offset in the output buffer
    # LC_MAIN starts at offset 256 (32+72+152), entryoff is at +8
    entry_patch_off = 32 + 72 + 152 + 8
    entryoff_val = header_plus_cmds + start_offset

    # Write little-endian u64 at entry_patch_off
    obuf.data = vec_set_at(obuf.data, entry_patch_off, (entryoff_val & 0xFF) >> int)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 1, ((entryoff_val >> 8) & 0xFF) >> int)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 2, ((entryoff_val >> 16) & 0xFF) >> int)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 3, ((entryoff_val >> 24) & 0xFF) >> int)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 4, 0)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 5, 0)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 6, 0)
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 7, 0)

    out obuf
end


# ═══════════════════════════════════════════════════════
# Compile Pipeline
# ═══════════════════════════════════════════════════════

func compile:
    in(source:string; output_path:string)
    # Step 1: Tokenize
    print "virc: tokenizing..."
    lex = lexer_new(source)
    lex = tokenize(lex)

    if rt_strlen(lex.error_msg) > 0:
        print "virc: lex error_msg: " + lex.error_msg
        out 1
    end

    tok_count = vec_len_rt(lex.tokens)
    print "virc: " + str_from_i64(tok_count) + " tokens"

    # Step 2: Parse
    print "virc: parsing..."
    parser = parser_new(lex.tokens)
    var (parser2, ast) = parse_program(parser)

    if ast.node_type == AstType::Program and vec_len_rt(ast.children) == 0:
        print "virc: parse error_msg: empty program"
        out 1
    end

    # Step 3: Lower to Q-IR
    print "virc: lowering to Q-IR..."
    ctx = lower_ctx_new("main")
    ctx = lower_program(ctx, ast)

    if ctx.error_count > 0:
        print "virc: lower error_msg: " + ctx.last_error
        out 1
    end

    func_count = vec_len_rt(ctx.module.functions)
    print "virc: " + str_from_i64(func_count) + " functions"

    # Step 4: Optimize — TCO + register allocation per function
    print "virc: optimizing..."
    fi = 0
    when fi < func_count loop
        qfn = vec_get_rt(ctx.module.functions, fi)
        print "virc: opt func"

        # Tail-call optimization
        var (func2, tco_count) = tco_pass(qfn)
        qfn = func2
        print "virc: tco done"

        # Liveness analysis + register allocation
        intervals = compute_liveness(qfn)
        print "virc: liveness done"
        allocated = regalloc_linear_scan(intervals, 14)    # 14 GPRs
        print "virc: regalloc done"

        # Rewrite vregs to physical registers (inline to avoid C VM entity copy bugs)
        print "virc: rewrite pass..."
        print vec_len_rt(allocated)
        ri = 0
        when ri < vec_len_rt(qfn.body) loop
            rins = vec_get_rt(qfn.body, ri)
            rchanged = 0
            if rins.dest.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.dest.vreg)
                if rpr >= 0 and (rpr as u32) != rins.dest.vreg:
                    rins.dest.vreg = rpr
                    rchanged = 1
                end
            end
            if rins.src1.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.src1.vreg)
                if rpr >= 0 and (rpr as u32) != rins.src1.vreg:
                    rins.src1.vreg = rpr
                    rchanged = 1
                end
            end
            if rins.src2.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.src2.vreg)
                if rpr >= 0 and (rpr as u32) != rins.src2.vreg:
                    rins.src2.vreg = rpr
                    rchanged = 1
                end
            end
            if rchanged == 1:
                vec_set_rt(qfn.body, ri, rins)
            end
            ri = ri + 1
        end

        vec_set_rt(ctx.module.functions, fi, qfn)
        fi = fi + 1
    end

    # Step 5: Code generation (ARM64)
    print "virc: generating ARM64 machine code..."
    code = codegen_emit_module(ctx.module, TargetArch::ARM64)
    code_size = codebuf_offset(code)
    print "virc: " + str_from_i64(code_size) + " bytes of machine code"

    # The _start entry point is at the known offset
    # (it's the last thing emitted by codegen_emit_module)
    # We need to find it... _start is after all functions + runtime
    # For now, record it as a return value from codegen_emit_module or calculate

    # Step 6: Link into Mach-O executable
    print "virc: linking Mach-O ARM64 executable..."
    binary = emit_macho_executable(code)

    # Step 7: Write output
    print "virc: writing " + output_path + "..."
    f = file_create(output_path)
    if is_err(f):
        print "virc: error_msg: cannot create output file"
        out 1
    end

    file = unwrap(f)
    data_slice = slice_new(binary.data.data, vec_len_rt(binary.data))
    file_write_all(file, data_slice)
    file_close(file)

    # Step 8: Make executable (chmod +x)
    # syscall(SYS_CHMOD, path, 0755)
    # For now this is handled by the build script

    file_size = vec_len_rt(binary.data)
    print "virc: done! " + output_path + " (" + str_from_i64(file_size) + " bytes)"
    out 0
end


# ═══════════════════════════════════════════════════════
# Main Entry Point
# ═══════════════════════════════════════════════════════

func virc_legacy_main:
    print "╔══════════════════════════════════════════════╗"
    print "║  virc — Vir Self-Hosting Compiler v1.2      ║"
    print "║  Phase 5: Bootstrap Binary                   ║"
    print "╚══════════════════════════════════════════════╝"

    if arg_count() < 1:
        print "Usage: virc <input.vri> [-o output]"
        print ""
        print "Compiles a Vir source file to a standalone"
        print "Mach-O ARM64 binary. No Python, no C runtime."
        out 1
    end

    input_path = get_arg(0)
    output_path = "a.out"

    # Parse -o flag
    if arg_count() >= 3:
        if rt_streq(get_arg(1), "-o"):
            output_path = get_arg(2)
        end
    end

    # Read source file
    print "virc: reading " + input_path + "..."
    f = file_open(input_path, FileMode::Read)
    if is_err(f):
        print "virc: error_msg: cannot open " + input_path
        out 1
    end

    file = unwrap(f)
    source_result = file_read_all(file)
    file_close(file)

    if is_err(source_result):
        print "virc: error_msg: cannot read " + input_path
        out 1
    end

    source = unwrap(source_result)
    print "virc: " + str_from_i64(rt_strlen(source)) + " bytes source"

    # Compile!
    result = compile(source, output_path)
    out result
end

export compile, virc_legacy_main, codegen_emit_module
export emit_runtime_arm64, emit_macho_executable, emit_macho_with_entry
export FuncLayout
# ══ END vir/compiler/main ══

# ══ BEGIN vir/compiler/virc ══
##
 * vir/compiler/virc.vri — Pure Vir Compiler Driver (Zero C/Python)
 * =================================================================
 * The self-hosting Vir compiler entry point. Uses ONLY the vir/rt/*
 * modules (direct syscalls, mmap allocator, raw I/O). No Python,
 * no C runtime, no libc, no external linker.
 *
 * Pipeline:
 *   source.vri → lex → parse → lower → regalloc → codegen → Mach-O/ELF
 *
 * This is the file that gets compiled by the Python compiler (Stage 0),
 * then the resulting binary compiles itself (Stage 1), completing bootstrap.
 *
 * Usage:
 *   ./virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]
 ##


# ── Runtime layer (pure Vir, no C) ──
       rt_itoa, rt_atoi, StringBuilder, sb_new, sb_append,
       sb_append_char, sb_append_int, sb_to_string, sb_free from string_rt
       file_open_read, file_read_all, file_close,
       write_file_bytes, read_file_str from io
       vec_free_rt, bvec_new, bvec_push, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr,
       bvec_free from vec_rt

# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──

# ── Compiler modules (self-hosting, pure Vir) ──
       codebuf_emit_u32, codebuf_patch_u32, codebuf_get_data from codegen


# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

const VERSION: "virc 1.2.0 (self-hosted)"

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64
    format:         int;    # 0=Mach-O, 1=ELF
    verbose:        int;    # 0=quiet, 1=verbose
end

func default_config:
    out CompilerConfig (
        input_path:  0,
        output_path: 0,
        target:      0,        # ARM64 (default on macOS)
        format:      0,        # Mach-O (default on macOS)
        verbose:     1
    )
end


# ═══════════════════════════════════════════════════════
# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func parse_args:
    let argc = arg_count()
    let cfg = default_config()

    if argc < 1:
        print_ln("virc: error_msg: no input file")
        print_ln("Usage: virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]")
        exit_prog(1)
    end

    # First positional argument is the input file
    cfg.input_path = get_arg(0)

    # Default output: a.out
    cfg.output_path = "a.out"

    let i = 1
    when i < argc loop
        let arg = get_arg(i)

        if rt_streq(arg, "-o"):
            if i + 1 < argc:
                i = i + 1
                cfg.output_path = get_arg(i)
            else
                print_ln("virc: error_msg: -o requires an argument")
                exit_prog(1)
            end

        eif rt_streq(arg, "--target"):
            if i + 1 < argc:
                i = i + 1
                let tgt = get_arg(i)
                if rt_streq(tgt, "arm64") or rt_streq(tgt, "aarch64"):
                    cfg.target = 0
                eif rt_streq(tgt, "x86_64") or rt_streq(tgt, "x86-64"):
                    cfg.target = 1
                eif rt_streq(tgt, "wasm32") or rt_streq(tgt, "wasm"):
                    cfg.target = 2
                else
                    print_ln("virc: error_msg: unknown target (use arm64, x86_64 or wasm32)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "--format"):
            if i + 1 < argc:
                i = i + 1
                let fmt = get_arg(i)
                if rt_streq(fmt, "macho"):
                    cfg.format = 0
                eif rt_streq(fmt, "elf"):
                    cfg.format = 1
                else
                    print_ln("virc: error_msg: unknown format (use macho or elf)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "-q") or rt_streq(arg, "--quiet"):
            cfg.verbose = 0

        eif rt_streq(arg, "-v") or rt_streq(arg, "--version"):
            print_ln(VERSION)
            exit_prog(0)

        eif rt_streq(arg, "-h") or rt_streq(arg, "--help"):
            print_ln("virc — Vir Self-Hosting Compiler")
            print_ln("")
            print_ln("Usage: virc <input.vri> [-o output] [options]")
            print_ln("")
            print_ln("Options:")
            print_ln("  -o <file>           Output file (default: a.out)")
            print_ln("  --target <arch>     arm64, x86_64 or wasm32 (default: arm64)")
            print_ln("  --format <fmt>      macho, elf or wasm (default: macho)")
            print_ln("  -q, --quiet         Suppress progress messages")
            print_ln("  -v, --version       Print version")
            print_ln("  -h, --help          Print this help")
            exit_prog(0)
        end

        i = i + 1
    end

    out cfg
end


# ═══════════════════════════════════════════════════════
# Compiler Pipeline
# ═══════════════════════════════════════════════════════

func virc_compile:
    in(cfg: CompilerConfig)

    let verbose = cfg.verbose

    # ── Read source file ──
    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: reading ")
        sb = sb_append(sb, cfg.input_path)
        sb = sb_append(sb, "...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    let source_raw = read_file_str(cfg.input_path)
    if source_raw == 0:
        print_ln("virc: error_msg: cannot read input file")
        exit_prog(1)
    end

    let src_len = rt_strlen(source_raw)
    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, src_len)
        sb = sb_append(sb, " bytes source")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 1: Tokenize ──
    if verbose == 1:
        print_ln("virc: tokenizing...")
    end

    # Use lexer_new directly with raw string pointer
    let lex = lexer_new(source_raw)
    lex = tokenize(lex)

    if rt_strlen(lex.error_msg) > 0:
        let sb = sb_new()
        sb = sb_append(sb, "virc: lex error_msg: ")
        sb = sb_append(sb, lex.error_msg)
        print_ln(sb_to_string(sb))
        sb_free(sb)
        exit_prog(1)
    end

    let tok_count = vec_len_rt(lex.tokens)
    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, tok_count)
        sb = sb_append(sb, " tokens")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 2: Parse ──
    if verbose == 1:
        print_ln("virc: parsing...")
    end

    let parser = parser_new(lex.tokens)
    var (parser2, ast) = parse_program(parser)

    if verbose == 1:
        let sb_ast = sb_new()
        sb_ast = sb_append(sb_ast, "virc: ast children ")
        sb_ast = sb_append_int(sb_ast, vec_len_rt(ast.children))
        print_ln(sb_to_string(sb_ast))
        sb_free(sb_ast)
    end

    # Report parse errors
    if rt_strlen(parser2.error_msg) > 0:
        let sb_pe = sb_new()
        sb_pe = sb_append(sb_pe, "virc: parse error (line ")
        sb_pe = sb_append_int(sb_pe, parser2.error_line)
        sb_pe = sb_append(sb_pe, "): ")
        sb_pe = sb_append(sb_pe, parser2.error_msg)
        print_ln(sb_to_string(sb_pe))
        sb_free(sb_pe)
    end

    # ── Step 3: Lower to Q-IR ──
    if verbose == 1:
        print_ln("virc: lowering to Q-IR...")
    end

    let ctx = lower_ctx_new("main")

    ctx = lower_program(ctx, ast)

    if ctx.error_count > 0:
        let sb = sb_new()
        sb = sb_append(sb, "virc: lower errors=")
        sb = sb_append_int(sb, ctx.error_count)
        sb = sb_append(sb, " last_error=")
        sb = sb_append(sb, ctx.last_error)
        print_ln(sb_to_string(sb))
        sb_free(sb)
        # Don't exit — may still generate partial code
    end

    let func_count = vec_len_rt(ctx.module.functions)

    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, func_count)
        sb = sb_append(sb, " functions")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 4: Skip (regalloc done in codegen via vreg_to_arm) ──
    if verbose == 1:
        print_ln("virc: optimizing via official QIR-M/QIR-L pipeline...")
    end

    # ── Step 5: Code Generation ──
    let target_arch = TargetArch::ARM64
    let target_name = "ARM64"
    if cfg.target == 1:
        target_arch = TargetArch::X86_64
        target_name = "x86_64"
    eif cfg.target == 2:
        target_arch = TargetArch::Wasm32
        target_name = "wasm32"
    end

    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: generating ")
        sb = sb_append(sb, target_name)
        sb = sb_append(sb, " machine code...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    let code = codegen_emit_module(ctx.module, target_arch)
    let code_size = codebuf_offset(code)

    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, code_size)
        sb = sb_append(sb, " bytes machine code")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 6: Extract machine code into byte vector ──
    let code_bytes = bvec_new()
    let ci = 0
    when ci < code_size loop
        code_bytes = bvec_push(code_bytes, codebuf_get_data(code, ci))
        ci = ci + 1
    end

    # ── Step 7: Emit executable ──
    if verbose == 1:
        let fmt_name = "Mach-O"
        if cfg.format == 1:
            fmt_name = "ELF"
        eif cfg.format == 2 or cfg.target == 2:
            fmt_name = "WASM"
        end
        let sb = sb_new()
        sb = sb_append(sb, "virc: linking ")
        sb = sb_append(sb, fmt_name)
        sb = sb_append(sb, " ")
        sb = sb_append(sb, target_name)
        sb = sb_append(sb, " executable...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    if cfg.target == 2 or cfg.format == 2:
        # WASM output: build QIRFunc list from QModule, emit .wasm
        let wasm_funcs = vec_new<QIRFunc>()
        let wfi = 0
        let wfn = vec_len_rt(ctx.module.functions)
        when wfi < wfn loop
            let qf = vec_get_rt(ctx.module.functions, wfi)
            wasm_funcs = vec_push<QIRFunc>(wasm_funcs, QIRFunc (
                name: qf.name,
                param_count: qf.param_count,
                body: qf.body
            ))
            wfi = wfi + 1
        end
        wasm_write_module(wasm_funcs, cfg.output_path)
    eif cfg.format == 0:
        # Mach-O
        let mb = macho_new(cfg.target)
        mb.text_code = code_bytes
        mb.entry_offset = code.start_offset
        macho_write_to_file(mb, cfg.output_path)
    else
        # ELF
        let eb = elf_new(cfg.target)
        eb.text_code = code_bytes
        eb.entry_offset = code.start_offset
        elf_write_to_file(eb, cfg.output_path)
    end

    if verbose == 1:
        let sb = sb_new()
        sb = sb_append(sb, "virc: done! ")
        sb = sb_append(sb, cfg.output_path)
        sb = sb_append(sb, " (")
        sb = sb_append_int(sb, code_size)
        sb = sb_append(sb, " bytes code)")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    out 0
end


# ═══════════════════════════════════════════════════════
# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func main:
    print_ln("====================================")
    print_ln("  virc — Vir Self-Hosting Compiler")
    print_ln("  v1.2.0 — Zero Python, Zero C")
    print_ln("====================================")

    let cfg = parse_args()
    let result = virc_compile(cfg)
    out result
end

export vir_main, virc_compile, parse_args, CompilerConfig
# ══ END vir/compiler/virc ══
