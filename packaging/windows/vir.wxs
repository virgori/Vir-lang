<?xml version="1.0" encoding="UTF-8"?>
<!--
═══════════════════════════════════════════════════════════════════
  Vir Language — WiX Installer for Windows Server
═══════════════════════════════════════════════════════════════════
  Build: candle vir.wxs && light vir.wixobj -o vir-lang-0.3.0-x86_64.msi
  Requires: WiX Toolset v3 or v4 (https://wixtoolset.org)
═══════════════════════════════════════════════════════════════════
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <?define ProductVersion = "0.3.0" ?>
  <?define ProductName = "Vir Language" ?>
  <?define Manufacturer = "Vir Team" ?>
  <?define UpgradeCode = "7A2C8E3D-F491-4B6A-9D5E-1C3A8F7B2E40" ?>

  <Product Id="*"
           Name="$(var.ProductName) $(var.ProductVersion)"
           Language="1033"
           Version="$(var.ProductVersion).0"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Vir Programming Language Runtime and Tools"
             Comments="Multilingual syntax, JIT, self-patching binary"
             Platform="x64" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ── Features ─────────────────────────────────── -->
    <Feature Id="CoreRuntime" Title="Vir Runtime" Level="1"
             Description="Core runtime, native library, and CLI tools" AllowAdvertise="no">
      <ComponentGroupRef Id="NativeLibs" />
      <ComponentGroupRef Id="PythonPackage" />
      <ComponentGroupRef Id="CLITools" />
      <ComponentGroupRef Id="Config" />
      <ComponentGroupRef Id="EnvPath" />
    </Feature>

    <Feature Id="Stdlib" Title="Standard Library" Level="1"
             Description="Vir standard library modules (.vri)">
      <ComponentGroupRef Id="StdlibFiles" />
    </Feature>

    <Feature Id="WindowsService" Title="Windows Service" Level="2"
             Description="Install Vir as a Windows Service (optional)">
      <ComponentGroupRef Id="ServiceComponents" />
    </Feature>

    <!-- ── Directory layout ─────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Vir">
          <Directory Id="BinDir" Name="bin" />
          <Directory Id="LibDir" Name="lib" />
          <Directory Id="StdlibDir" Name="stdlib" />
          <Directory Id="PythonDir" Name="python" />
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="VirDataDir" Name="Vir">
          <Directory Id="ConfigDir" Name="config" />
          <Directory Id="LogDir" Name="log" />
          <Directory Id="CacheDir" Name="cache" />
        </Directory>
      </Directory>
    </Directory>

    <!-- ── Native libraries ─────────────────────────── -->
    <ComponentGroup Id="NativeLibs" Directory="LibDir">
      <Component Id="VirCoreDLL" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890" Win64="yes">
        <File Id="vir_core_dll" Source="$(var.BuildDir)\vir_core.dll" KeyPath="yes" />
      </Component>
      <Component Id="VirCoreLib" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901" Win64="yes">
        <File Id="vir_core_lib" Source="$(var.BuildDir)\libvir_core.a" />
      </Component>
    </ComponentGroup>

    <!-- ── CLI tools ────────────────────────────────── -->
    <ComponentGroup Id="CLITools" Directory="BinDir">
      <Component Id="VirExe" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012" Win64="yes">
        <File Id="vir_exe" Source="$(var.BuildDir)\vir.exe" KeyPath="yes" />
      </Component>
      <Component Id="VirBat" Guid="D4E5F6A7-B8C9-0123-DEFA-234567890123" Win64="yes">
        <File Id="vir_bat" Source="packaging\windows\vir.bat" KeyPath="yes" />
      </Component>
      <Component Id="VironBat" Guid="E5F6A7B8-C9D0-1234-EFAB-345678901234" Win64="yes">
        <File Id="viron_bat" Source="packaging\windows\viron.bat" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Configuration ────────────────────────────── -->
    <ComponentGroup Id="Config" Directory="ConfigDir">
      <Component Id="VirConf" Guid="F6A7B8C9-D0E1-2345-FABC-456789012345" Win64="yes">
        <File Id="vir_conf" Source="packaging\windows\vir.conf" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── PATH environment variable ────────────────── -->
    <ComponentGroup Id="EnvPath" Directory="BinDir">
      <Component Id="PathEnv" Guid="A7B8C9D0-E1F2-3456-ABCD-567890123456" Win64="yes">
        <Environment Id="VirPath" Name="PATH" Value="[BinDir]"
                     Permanent="no" Part="last" Action="set" System="yes" />
        <Environment Id="VirHome" Name="VIR_HOME" Value="[INSTALLDIR]"
                     Permanent="no" Action="set" System="yes" />
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ── Python package (placeholder) ─────────────── -->
    <ComponentGroup Id="PythonPackage" Directory="PythonDir">
      <Component Id="PythonPkg" Guid="B8C9D0E1-F2A3-4567-BCDE-678901234567" Win64="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ── Stdlib ───────────────────────────────────── -->
    <ComponentGroup Id="StdlibFiles" Directory="StdlibDir">
      <Component Id="StdlibPlaceholder" Guid="C9D0E1F2-A3B4-5678-CDEF-789012345678" Win64="yes">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ── Windows Service (optional) ───────────────── -->
    <ComponentGroup Id="ServiceComponents" Directory="BinDir">
      <Component Id="VirService" Guid="D0E1F2A3-B4C5-6789-DEFA-890123456789" Win64="yes">
        <File Id="vir_service_ps1" Source="packaging\windows\vir-service.ps1" KeyPath="yes" />
        <ServiceInstall Id="VirServiceInstall"
                        Name="VirRuntime"
                        DisplayName="Vir Language Runtime"
                        Description="Vir Language Runtime Server"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\NetworkService" />
        <ServiceControl Id="VirServiceControl"
                        Name="VirRuntime"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── UI ───────────────────────────────────────── -->
    <UIRef Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\LICENSE.rtf" />

  </Product>
</Wix>
