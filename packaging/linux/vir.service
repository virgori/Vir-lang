[Unit]
Description=Vir Language Runtime Server
Documentation=https://github.com/vir-lang/vir
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=vir
Group=vir

EnvironmentFile=-/etc/vir/vir.conf
ExecStart=/usr/local/bin/vir --server --config /etc/vir/vir.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/vir /var/log/vir /var/cache/vir
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096
MemoryMax=4G
TasksMax=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vir

[Install]
WantedBy=multi-user.target
