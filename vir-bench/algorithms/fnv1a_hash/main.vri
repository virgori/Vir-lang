# Algorithm Benchmark: fnv1a_hash (Vir Implementation)

func fnv1a_32(data, len):
    var hash = 2166136261
    let prime = 16777619
    var i = 0
    when i < len loop
        let b = read_byte(data, i)
        let x = hash bit_xor b
        hash = (x * prime) bit_and 0xFFFFFFFF
        i = i + 1
    end
    out hash
end.

func main:
    let sz = 10 * 1024 * 1024 # 10 MB
    let buf = alloc(sz)
    var i = 0
    when i < sz loop
        write_byte(buf, i, (i * 37) bit_and 0xFF)
        i = i + 1
    end

    var final_hash = 0
    var rep = 0
    when rep < 5 loop
        final_hash = fnv1a_32(buf, sz)
        rep = rep + 1
    end

    print(final_hash)
    out 0
end.
