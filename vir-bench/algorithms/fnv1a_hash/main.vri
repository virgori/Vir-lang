# Algorithm Benchmark: fnv1a_hash (Vir Implementation)

func fnv1a_64(data, len):
    var hash = 0xCBF29CE484222325
    let prime = 0x100000001B3
    var i = 0
    when i < len loop
        let b = read_byte(data, i)
        hash = hash bit_xor b
        hash = hash * prime
        i = i + 1
    end
    out hash
end.

func main:
    let sz = 10 * 1024 * 1024 # 10 MB
    let buf = alloc(sz)
    var i = 0
    when i < sz loop
        write_byte(buf, i, (i * 37) bit_and 0xFF)
        i = i + 1
    end

    var final_hash = 0
    var rep = 0
    when rep < 5 loop
        final_hash = fnv1a_64(buf, sz)
        rep = rep + 1
    end

    print(final_hash)
    out 0
end.
