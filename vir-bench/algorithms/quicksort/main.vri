# Algorithm Benchmark: quicksort (Vir Implementation)

func swap(arr, i, j):
    let tmp = read_word(arr, i * 8)
    write_word(arr, i * 8, read_word(arr, j * 8))
    write_word(arr, j * 8, tmp)
end.

func partition(arr, low, high):
    let pivot = read_word(arr, high * 8)
    var i = low - 1
    var j = low
    when j < high loop
        if read_word(arr, j * 8) <= pivot do
            i = i + 1
            let tmp = read_word(arr, i * 8)
            write_word(arr, i * 8, read_word(arr, j * 8))
            write_word(arr, j * 8, tmp)
        end
        j = j + 1
    end
    let tmp2 = read_word(arr, (i + 1) * 8)
    write_word(arr, (i + 1) * 8, read_word(arr, high * 8))
    write_word(arr, high * 8, tmp2)
    out i + 1
end.

func quicksort(arr, low, high):
    if low < high do
        let pi = partition(arr, low, high)
        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    end
end.

func main:
    let n = 50000
    let arr = alloc(n * 8)

    # Standard POSIX LCG PRNG
    var seed = 12345678
    var i = 0
    when i < n loop
        seed = ((seed * 1103515245) + 12345) bit_and 0x7FFFFFFF
        let mod_val = seed - ((seed / 1000000) * 1000000)
        write_word(arr, i * 8, mod_val)
        i = i + 1
    end

    quicksort(arr, 0, n - 1)

    # Checksum
    var chk = 0
    i = 0
    when i < n loop
        chk = (chk * 33) bit_xor read_word(arr, i * 8)
        i = i + 1
    end

    print(chk)
    out 0
end.
