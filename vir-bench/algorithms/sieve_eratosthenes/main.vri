# Algorithm Benchmark: sieve_eratosthenes (Vir Implementation)

func bench_sieve(limit):
    let is_prime = alloc(limit + 1)
    var i = 0
    when i <= limit loop
        write_byte(is_prime, i, 1)
        i = i + 1
    end
    write_byte(is_prime, 0, 0)
    write_byte(is_prime, 1, 0)

    var p = 2
    when (p * p) <= limit loop
        if read_byte(is_prime, p) == 1 do
            var mult = p * p
            when mult <= limit loop
                write_byte(is_prime, mult, 0)
                mult = mult + p
            end
        end
        p = p + 1
    end

    var count = 0
    i = 2
    when i <= limit loop
        if read_byte(is_prime, i) == 1 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func main:
    let limit = 1000000
    let reps = 20
    var last_count = 0
    var r = 0
    when r < reps loop
        last_count = bench_sieve(limit)
        r = r + 1
    end
    print(last_count)
    out 0
end.
