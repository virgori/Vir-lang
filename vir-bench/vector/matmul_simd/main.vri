# Vector Benchmark: matmul_simd (Vir 128-bit NEON SIMD Implementation)

func main:
    let a = alloc(512)
    let b = alloc(512)
    
    write_word(a, 0, 3)
    write_word(a, 8, 6)
    write_word(b, 0, 7)
    write_word(b, 8, 14)

    var sum = 0
    var rep = 0
    when rep < 1000000 loop
        let c = a ** b
        sum = sum + read_word(c, 0) + read_word(c, 8)
        rep = rep + 1
    end

    print(sum)
    out 0
end.
