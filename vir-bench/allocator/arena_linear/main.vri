# Allocator Benchmark: arena_linear (Vir Implementation)

func arena_new(cap):
    let a = alloc(24)
    write_word(a, 0, alloc(cap))
    write_word(a, 8, cap)
    write_word(a, 16, 0)
    out a
end.

func arena_alloc_block(a, size):
    let aligned_sz = (size + 7) bit_and (0 - 8)
    let buf = read_word(a, 0)
    let cap = read_word(a, 8)
    var off = read_word(a, 16)

    if (off + aligned_sz) > cap do
        off = 0
    end

    let ptr = buf + off
    write_word(a, 16, off + aligned_sz)
    out ptr
end.

func main:
    let a = arena_new(64 * 1024 * 1024) # 64 MB

    var sum = 0
    var rep = 0
    when rep < 5000000 loop
        let p = arena_alloc_block(a, 64)
        write_word(p, 0, rep bit_xor 0xDEADBEEF)
        sum = sum + read_word(p, 0)
        rep = rep + 1
    end

    print(sum)
    out 0
end.
