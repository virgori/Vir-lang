# Allocator Benchmark: arena_linear (Vir Inlined Arena Benchmark)

func main:
    let cap = 64 * 1024 * 1024
    let buf = alloc(cap)
    var off = 0

    var sum = 0
    var rep = 0
    when rep < 5000000 loop
        if (off + 64) > cap do
            off = 0
        end
        let p = buf + off
        off = off + 64
        write_word(p, 0, rep bit_xor 0xDEADBEEF)
        sum = sum + read_word(p, 0)
        rep = rep + 1
    end

    print(sum)
    out 0
end.
