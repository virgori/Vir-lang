# Microbenchmark: int_arith (Vir Implementation)

func bench_int_arith(n):
    var x = 123456789
    var i = 0
    when i < n loop
        x = ((x * 13) + 7) bit_xor (x shr 3)
        let sum = x + (i * 3)
        x = sum - ((sum / 1000000007) * 1000000007)
        i = i + 1
    end
    out x
end.

func main:
    let n = 30000000
    let res = bench_int_arith(n)
    print(res)
    out 0
end.
