# Microbenchmark: int_arith (Vir Implementation)

func bench_int_arith(n):
    var x = 123456789
    var i = 0
    when i < n loop
        let t1 = (x * 13) + 7
        let t2 = x shr 3
        let t3 = t1 bit_xor t2
        let sum = t3 + (i * 3)
        x = sum - ((sum / 1000000007) * 1000000007)
        i = i + 1
    end
    out x
end.

func main:
    let n = 30000000
    let res = bench_int_arith(n)
    print(res)
    out 0
end.
