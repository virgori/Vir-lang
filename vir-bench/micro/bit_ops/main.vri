# Microbenchmark: bit_ops (Vir Implementation)

func rotl32(x, k):
    let left = (x shl k) bit_and 0xFFFFFFFF
    let right = (x shr (32 - k)) bit_and 0xFFFFFFFF
    out (left bit_or right) bit_and 0xFFFFFFFF
end.

func bench_bit_ops(n):
    var s = 0x12345678
    let c_k = 0x9E3779B9
    let m_a = 0xAAAAAAAA
    let m_5 = 0x55555555

    var i = 0
    when i < n loop
        let r = rotl32(s, 7)
        let sh = (s shr 11) bit_and 0xFFFFFFFF
        let x = (r bit_xor sh) + c_k
        s = x bit_and 0xFFFFFFFF
        let part1 = s bit_and m_a
        let part2 = (s bit_xor (i bit_and 0xFFFFFFFF)) bit_and m_5
        s = (part1 bit_or part2) bit_and 0xFFFFFFFF
        i = i + 1
    end
    out s
end.

func main:
    let n = 20000000
    let res = bench_bit_ops(n)
    print(res)
    out 0
end.
