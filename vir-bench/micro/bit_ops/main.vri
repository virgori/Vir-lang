# Microbenchmark: bit_ops (Vir Implementation)

func rotl64(x, k):
    out (x shl k) bit_or (x shr (64 - k))
end.

func bench_bit_ops(n):
    var s = 0x123456789ABCDEF0
    var i = 0
    when i < n loop
        s = rotl64(s, 7) bit_xor (s shr 11)
        s = s + 0x9E3779B97F4A7C15
        s = (s bit_and 0xAAAAAAAAAAAAAAAA) bit_or ((s bit_xor i) bit_and 0x5555555555555555)
        i = i + 1
    end
    out s
end.

func main:
    let n = 20000000
    let res = bench_bit_ops(n)
    print(res)
    out 0
end.
