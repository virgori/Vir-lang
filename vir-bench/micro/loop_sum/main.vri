# Microbenchmark: loop_sum (Vir Implementation)

func bench_loop_sum(n):
    var s0 = 0
    var s1 = 0
    var s2 = 0
    var s3 = 0
    var i = 0
    let n4 = (n / 4) * 4
    when i < n4 loop
        s0 = s0 + (i bit_and 0xFFF)
        s1 = s1 + ((i + 1) bit_and 0xFFF)
        s2 = s2 + ((i + 2) bit_and 0xFFF)
        s3 = s3 + ((i + 3) bit_and 0xFFF)
        i = i + 4
    end
    var s = (s0 + s1) + (s2 + s3)
    when i < n loop
        s = s + (i bit_and 0xFFF)
        i = i + 1
    end
    out s
end.

func main:
    let n = 50000000 # 50 million iterations
    let res = bench_loop_sum(n)
    print(res)
    out 0
end.
