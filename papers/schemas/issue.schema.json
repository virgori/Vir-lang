{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue.schema.json",
  "title": "VIR ISSUE metadata",
  "allOf": [
    {"$ref": "paper.schema.json"},
    {
      "type": "object",
      "required": ["severity", "priority"],
      "properties": {
        "type": {"const": "ISSUE"},
        "status": {
          "enum": ["DRAFT", "OPEN", "TRIAGED", "PLANNED", "IMPLEMENTING", "VERIFYING", "RESOLVED", "CLOSED", "REOPENED", "REJECTED"]
        },
        "severity": {"enum": ["S0", "S1", "S2", "S3", "S4"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]}
      }
    }
  ],
  "unevaluatedProperties": false
}
