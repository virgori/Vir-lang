{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "VIR REPORT metadata",
  "allOf": [
    {"$ref": "paper.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "REPORT"},
        "status": {
          "enum": ["DRAFT", "REVIEW", "ACCEPTED", "REJECTED", "SUPERSEDED"]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
