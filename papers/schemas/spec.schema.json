{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec.schema.json",
  "title": "VIR SPEC metadata",
  "allOf": [
    {"$ref": "paper.schema.json"},
    {
      "type": "object",
      "required": ["version", "language", "spec_class", "aliases"],
      "properties": {
        "type": {"const": "SPEC"},
        "status": {
          "enum": ["DRAFT", "REVIEW", "ACTIVE", "SUPERSEDED", "RETIRED"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "language": {"type": "string", "minLength": 1},
        "spec_class": {
          "enum": ["ARCHITECTURE", "ALGORITHM", "SPECIFICATION", "CONTRACT", "REFERENCE"]
        },
        "aliases": {"$ref": "paper.schema.json#/$defs/stringSet"}
      }
    }
  ],
  "unevaluatedProperties": false
}
