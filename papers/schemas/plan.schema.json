{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "VIR PLAN metadata",
  "allOf": [
    {"$ref": "paper.schema.json"},
    {
      "type": "object",
      "properties": {
        "type": {"const": "PLAN"},
        "status": {
          "enum": ["DRAFT", "REVIEW", "APPROVED", "ACTIVE", "COMPLETED", "SUPERSEDED", "CANCELLED"]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
