{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper.schema.json",
  "title": "VIR Paper common metadata",
  "type": "object",
  "required": [
    "id",
    "type",
    "domain",
    "title",
    "status",
    "created",
    "updated",
    "owners",
    "components",
    "related",
    "supersedes",
    "superseded_by",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-(ISS|PLN|RPT|SPC)-[0-9]{4}$"
    },
    "type": {
      "enum": ["ISSUE", "PLAN", "REPORT", "SPEC"]
    },
    "domain": {
      "enum": ["VIR", "VIRC", "VLSP", "STLB", "IVIR", "VIRON"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "owners": {
      "$ref": "#/$defs/stringSet"
    },
    "components": {
      "$ref": "#/$defs/stringSet"
    },
    "related": {
      "type": "object",
      "required": ["issues", "plans", "reports"],
      "properties": {
        "issues": {
          "$ref": "#/$defs/idSet"
        },
        "plans": {
          "$ref": "#/$defs/idSet"
        },
        "reports": {
          "$ref": "#/$defs/idSet"
        }
      },
      "additionalProperties": false
    },
    "supersedes": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/paperId"}
      ]
    },
    "superseded_by": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/paperId"}
      ]
    },
    "tags": {
      "$ref": "#/$defs/stringSet"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"domain": {"const": "VIR"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^VIR-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"domain": {"const": "VIRC"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^VIRC-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"domain": {"const": "VLSP"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^VLSP-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"domain": {"const": "STLB"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^STLB-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"domain": {"const": "IVIR"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^IVIR-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"domain": {"const": "VIRON"}}, "required": ["domain"]},
      "then": {"properties": {"id": {"pattern": "^VIRON-(ISS|PLN|RPT|SPC)-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "ISSUE"}}, "required": ["type"]},
      "then": {"properties": {"id": {"pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-ISS-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "PLAN"}}, "required": ["type"]},
      "then": {"properties": {"id": {"pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-PLN-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "REPORT"}}, "required": ["type"]},
      "then": {"properties": {"id": {"pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-RPT-[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"type": {"const": "SPEC"}}, "required": ["type"]},
      "then": {"properties": {"id": {"pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-SPC-[0-9]{4}$"}}}
    }
  ],
  "$defs": {
    "paperId": {
      "type": "string",
      "pattern": "^(VIR|VIRC|VLSP|STLB|IVIR|VIRON)-(ISS|PLN|RPT|SPC)-[0-9]{4}$"
    },
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "idSet": {
      "type": "array",
      "items": {"$ref": "#/$defs/paperId"},
      "uniqueItems": true
    }
  }
}
