##
 * vir_lsp_test.transport — Stdio pipe transport for native vir-lsp daemon
 * ========================================================================
 * Owns process spawning, bidirectional stdio pipes, and Content-Length
 * framing protocol per LSP specification.
 ##


extern func pipe(fds: int) -> int
extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

entity LspTransport:
    child_pid:   int,
    in_write_fd: int,
    out_read_fd: int,
    is_alive:    int
end.

func lsp_sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func lsp_sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func lsp_sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func lsp_sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func lsp_sys_read(fd: int, buf: int, count: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall3(0, fd, buf, count) end
    out syscall3(0x2000003, fd, buf, count)
end.

func lsp_sys_write(fd: int, buf: int, count: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall3(1, fd, buf, count) end
    out syscall3(0x2000004, fd, buf, count)
end.

func lsp_sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func lsp_sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func lsp_get_i32(ptr: int) -> int:
    out read_byte(ptr, 0) + (read_byte(ptr, 1) shl 8) + (read_byte(ptr, 2) shl 16) + (read_byte(ptr, 3) shl 24)
end.

func lsp_raw_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func lsp_transport_spawn(lsp_binary: int, stdlib_registry: int) -> LspTransport:
    let in_pipe = alloc(16)
    let out_pipe = alloc(16)
    if pipe(in_pipe) != 0 or pipe(out_pipe) != 0 do
        out LspTransport(child_pid: 0, in_write_fd: 0 - 1, out_read_fd: 0 - 1, is_alive: 0)
    end

    let in_r = lsp_get_i32(in_pipe)
    let in_w = lsp_get_i32(in_pipe + 4)
    let out_r = lsp_get_i32(out_pipe)
    let out_w = lsp_get_i32(out_pipe + 4)

    let my_pid = lsp_sys_getpid()
    let child_pid = lsp_sys_fork()
    let cur_pid = lsp_sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        # Child process: wire stdin/stdout to pipes
        lsp_sys_dup2(in_r, 0)
        lsp_sys_dup2(out_w, 1)

        lsp_sys_close(in_r)
        lsp_sys_close(in_w)
        lsp_sys_close(out_r)
        lsp_sys_close(out_w)

        let argv = alloc(64)
        native_write_i64(argv, 0, lsp_binary)
        native_write_i64(argv, 8, "--stdio" as int)
        var argc_off = 16
        if stdlib_registry != 0 do
            native_write_i64(argv, argc_off, "--stdlib-registry" as int)
            argc_off = argc_off + 8
            native_write_i64(argv, argc_off, stdlib_registry)
            argc_off = argc_off + 8
        end
        native_write_i64(argv, argc_off, 0)

        let envp = alloc(16)
        native_write_i64(envp, 0, 0)

        lsp_sys_execve(lsp_binary, argv, envp)
        exit_prog(127)
    end

    # Parent process: close unused pipe ends
    lsp_sys_close(in_r)
    lsp_sys_close(out_w)

    out LspTransport(child_pid: child_pid, in_write_fd: in_w, out_read_fd: out_r, is_alive: 1)
end.

func lsp_transport_send(ref t: LspTransport, json_body: int):
    if t.is_alive != 1 do out end
    let body_len = lsp_raw_strlen(json_body)
    var v = body_len
    let digits = alloc(16)
    var dlen = 0
    if v == 0 do
        write_byte(digits, 0, 48)
        dlen = 1
    else
        when v > 0 loop
            write_byte(digits, dlen, 48 + (v mod 10))
            v = v / 10
            dlen = dlen + 1
        end
    end
    let hdr = alloc(64)
    let prefix = "Content-Length: " as int
    var hlen = 0
    var i = 0
    when i < 16 loop
        write_byte(hdr, hlen, read_byte(prefix, i))
        hlen = hlen + 1
        i = i + 1
    end
    i = dlen - 1
    when i >= 0 loop
        write_byte(hdr, hlen, read_byte(digits, i))
        hlen = hlen + 1
        i = i - 1
    end
    write_byte(hdr, hlen, 13)
    write_byte(hdr, hlen + 1, 10)
    write_byte(hdr, hlen + 2, 13)
    write_byte(hdr, hlen + 3, 10)
    hlen = hlen + 4

    lsp_sys_write(t.in_write_fd, hdr, hlen)
    lsp_sys_write(t.in_write_fd, json_body, body_len)
end.

func lsp_transport_read(ref t: LspTransport) -> int:
    if t.is_alive != 1 do out 0 end
    let hdr = alloc(256)
    var hpos = 0
    var b1 = 0
    var b2 = 0
    var b3 = 0
    var b4 = 0
    var found_sep = 0
    let one_byte = alloc(1)

    when found_sep == 0 and hpos < 250 loop
        let n = lsp_sys_read(t.out_read_fd, one_byte, 1)
        if n <= 0 do
            out 0
        end
        let b = read_byte(one_byte, 0)
        write_byte(hdr, hpos, b)
        hpos = hpos + 1

        b1 = b2
        b2 = b3
        b3 = b4
        b4 = b
        if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 do
            found_sep = 1
        end
    end
    if found_sep == 0 do out 0 end

    var content_len = 0
    var idx = 0
    when idx < hpos - 15 loop
        var match = 1
        let c0 = read_byte(hdr, idx)
        if c0 != 67 and c0 != 99 do match = 0 end
        if match == 1 do
            if read_byte(hdr, idx + 14) == 58 do
                var p = idx + 15
                when p < hpos and (read_byte(hdr, p) == 32 or read_byte(hdr, p) == 9) loop
                    p = p + 1
                end
                when p < hpos and read_byte(hdr, p) >= 48 and read_byte(hdr, p) <= 57 loop
                    content_len = content_len * 10 + (read_byte(hdr, p) - 48)
                    p = p + 1
                end
                idx = hpos
            end
        end
        idx = idx + 1
    end

    if content_len <= 0 do out 0 end

    let body = alloc(content_len + 1)
    var total = 0
    when total < content_len loop
        let n = lsp_sys_read(t.out_read_fd, body + total, content_len - total)
        if n <= 0 do
            out 0
        end
        total = total + n
    end
    write_byte(body, content_len, 0)
    out body
end.

func lsp_transport_close(ref t: LspTransport) -> int:
    if t.is_alive == 1 do
        lsp_sys_close(t.in_write_fd)
        lsp_sys_close(t.out_read_fd)
        let st = alloc(8)
        lsp_sys_wait4(t.child_pid, st, 0)
        let exit_code = read_byte(st, 1)
        t.is_alive = 0
        out exit_code
    end
    out 0
end.

func lsp_transport_kill(ref t: LspTransport) -> int:
    if t.is_alive == 1 do
        kill(t.child_pid, 9)
        lsp_sys_close(t.in_write_fd)
        lsp_sys_close(t.out_read_fd)
        let st = alloc(8)
        lsp_sys_wait4(t.child_pid, st, 0)
        t.is_alive = 0
        out 0
    end
    out 0
end.
