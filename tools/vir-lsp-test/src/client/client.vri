##
 * vir_lsp_test.client — High-level LSP client interface
 * =======================================================
 * Manages LSP daemon lifecycle, request/response correlation,
 * and standard handshake / shutdown flows.
 ##

include vir_lsp_test.transport
include vir_lsp_test.json

entity LspClient:
    transport: LspTransport,
    req_id:    int,
    is_init:   int
end.

func lsp_client_new(lsp_bin: int, stdlib_reg: int) -> LspClient:
    let trans = lsp_transport_spawn(lsp_bin, stdlib_reg)
    out LspClient(transport: trans, req_id: 1, is_init: 0)
end.

func lsp_client_request(ref c: LspClient, method_str: int, params_json: int) -> int:
    let cur_id = c.req_id
    c.req_id = cur_id + 1
    let req_body = lsp_json_make_request(cur_id, method_str, params_json)
    lsp_transport_send(c.transport, req_body)
    out cur_id
end.

func lsp_client_notify(ref c: LspClient, method_str: int, params_json: int):
    let notif_body = lsp_json_make_notify(method_str, params_json)
    lsp_transport_send(c.transport, notif_body)
end.

func lsp_client_read_resp(ref c: LspClient, expected_id: int) -> int:
    var attempts = 0
    when attempts < 200 loop
        let msg = lsp_transport_read(c.transport)
        if msg != 0 do
            let mid = lsp_json_extract_id(msg)
            if mid == expected_id do
                out msg
            end
        end
        usleep(5000) # 5ms
        attempts = attempts + 1
    end
    out 0
end.

func lsp_client_read_any(ref c: LspClient) -> int:
    var attempts = 0
    when attempts < 100 loop
        let msg = lsp_transport_read(c.transport)
        if msg != 0 do
            out msg
        end
        usleep(5000)
        attempts = attempts + 1
    end
    out 0
end.

func lsp_client_call(ref c: LspClient, method_str: int, params_json: int) -> int:
    let rid = lsp_client_request(c, method_str, params_json)
    out lsp_client_read_resp(c, rid)
end.

func lsp_client_initialize(ref c: LspClient, root_uri: int) -> int:
    let params1 = "{\"processId\":1,\"rootUri\":\"" as int
    let params2 = "\",\"capabilities\":{\"workspace\":{\"workspaceEdit\":{\"documentChanges\":true}}}}" as int
    let params = lsp_json_concat3(params1, root_uri, params2)
    let resp = lsp_client_call(c, "initialize" as int, params)
    if resp != 0 do
        c.is_init = 1
        lsp_client_notify(c, "initialized" as int, "{}" as int)
    end
    out resp
end.

func lsp_client_shutdown(ref c: LspClient) -> int:
    let resp = lsp_client_call(c, "shutdown" as int, "{}" as int)
    lsp_client_notify(c, "exit" as int, "{}" as int)
    let exit_code = lsp_transport_close(c.transport)
    c.is_init = 0
    out exit_code
end.
