##
 * vir_lsp_test.json — JSON-RPC framing and parsing helpers
 * =========================================================
 * Provides string builders for LSP JSON-RPC requests/notifications
 * and scanner functions for analyzing server responses.
 ##


extern func vir_alloc(sz: int) -> int
extern func vir_free(ptr: int)

func lsp_json_raw_len(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func lsp_json_int_to_str(val: int) -> int:
    var v = val
    if v == 0 do
        let res0 = alloc(2)
        write_byte(res0, 0, 48)
        write_byte(res0, 1, 0)
        out res0
    end
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var rpos = 0
    if is_neg == 1 do
        write_byte(res, rpos, 45)
        rpos = 1
    end
    var di = dlen - 1
    when di >= 0 loop
        write_byte(res, rpos, read_byte(digits, di))
        rpos = rpos + 1
        di = di - 1
    end
    write_byte(res, rpos, 0)
    out res
end.

func lsp_json_concat3(a: int, b: int, c: int) -> int:
    let la = lsp_json_raw_len(a)
    let lb = lsp_json_raw_len(b)
    let lc = lsp_json_raw_len(c)
    let res = alloc(la + lb + lc + 1)
    var p = 0
    var i = 0
    when i < la loop
        write_byte(res, p, read_byte(a, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, p, read_byte(b, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < lc loop
        write_byte(res, p, read_byte(c, i))
        p = p + 1
        i = i + 1
    end
    write_byte(res, p, 0)
    out res
end.

func lsp_json_concat5(a: int, b: int, c: int, d: int, e: int) -> int:
    let la = lsp_json_raw_len(a)
    let lb = lsp_json_raw_len(b)
    let lc = lsp_json_raw_len(c)
    let ld = lsp_json_raw_len(d)
    let le = lsp_json_raw_len(e)
    let res = alloc(la + lb + lc + ld + le + 1)
    var p = 0
    var i = 0
    when i < la loop
        write_byte(res, p, read_byte(a, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, p, read_byte(b, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < lc loop
        write_byte(res, p, read_byte(c, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < ld loop
        write_byte(res, p, read_byte(d, i))
        p = p + 1
        i = i + 1
    end
    i = 0
    when i < le loop
        write_byte(res, p, read_byte(e, i))
        p = p + 1
        i = i + 1
    end
    write_byte(res, p, 0)
    out res
end.

# Format: {"jsonrpc":"2.0","id":<id>,"method":"<method>","params":<params_json>}
func lsp_json_make_request(id: int, method_str: int, params_json: int) -> int:
    let id_str = lsp_json_int_to_str(id)
    let part1 = "{\"jsonrpc\":\"2.0\",\"id\":" as int
    let part2 = ",\"method\":\"" as int
    let part3 = "\",\"params\":" as int
    let part4 = "}" as int
    let p1_2 = lsp_json_concat3(part1, id_str, part2)
    let p3_4 = lsp_json_concat3(method_str, part3, params_json)
    out lsp_json_concat3(p1_2, p3_4, part4)
end.

# Format: {"jsonrpc":"2.0","method":"<method>","params":<params_json>}
func lsp_json_make_notify(method_str: int, params_json: int) -> int:
    let part1 = "{\"jsonrpc\":\"2.0\",\"method\":\"" as int
    let part2 = "\",\"params\":" as int
    let part3 = "}" as int
    out lsp_json_concat5(part1, method_str, part2, params_json, part3)
end.

func lsp_json_contains(haystack: int, needle: int) -> int:
    if haystack == 0 or needle == 0 do out 0 end
    let hlen = lsp_json_raw_len(haystack)
    let nlen = lsp_json_raw_len(needle)
    if nlen == 0 do out 1 end
    if hlen < nlen do out 0 end
    var i = 0
    when i <= hlen - nlen loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func lsp_json_extract_id(response_json: int) -> int:
    if response_json == 0 do out (0 - 1) end
    let key = "\"id\":" as int
    let klen = 5
    let rlen = lsp_json_raw_len(response_json)
    var i = 0
    when i <= rlen - klen loop
        var match = 1
        var j = 0
        when j < klen loop
            if read_byte(response_json, i + j) != read_byte(key, j) do
                match = 0
                j = klen
            else
                j = j + 1
            end
        end
        if match == 1 do
            var p = i + klen
            when p < rlen and (read_byte(response_json, p) == 32 or read_byte(response_json, p) == 9) loop
                p = p + 1
            end
            var num = 0
            var has_digit = 0
            when p < rlen and read_byte(response_json, p) >= 48 and read_byte(response_json, p) <= 57 loop
                num = num * 10 + (read_byte(response_json, p) - 48)
                has_digit = 1
                p = p + 1
            end
            if has_digit == 1 do out num end
        end
        i = i + 1
    end
    out (0 - 1)
end.
