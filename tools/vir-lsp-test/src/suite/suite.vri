##
 * vir_lsp_test.suite — Native LSP test assertions and test cases
 * ==============================================================
 * Comprehensive pure-Vir test suite executing against native
 * vir-lsp daemon over stdio JSON-RPC transport.
 ##

include vir_lsp_test.client

extern func getcwd(buffer: int, size: int) -> int

func lsp_assert(cond: int, test_name: int, detail: int) -> int:
    if cond == 1 do
        print_str("PASS: ")
        print_str(test_name as string)
        print_str("\n")
        out 1
    end
    print_str("FAIL: ")
    print_str(test_name as string)
    print_str(" — ")
    print_str(detail as string)
    print_str("\n")
    out 0
end.

func lsp_suite_run_in_ref_out_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0

    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0 and lsp_json_contains(init_resp, "\"capabilities\"" as int) == 1,
                  "initialize" as int, "missing capabilities in response" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test didOpen
    let doc_uri = "file:///tmp/param_blocks.vri" as int
    let doc_content = "func process:\\n    in input_data: int\\n    ref buffer: int\\n    out result: int\\n    buffer = buffer + input_data\\n    result = buffer * 2\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_content, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)
    passes = passes + 1
    print_str("PASS: textDocument/didOpen\n")

    # Test hover on 'in' keyword (line 1, col 5)
    let h1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":5}}" as int)
    let h1_resp = lsp_client_call(client, "textDocument/hover" as int, h1_params)
    if lsp_assert(h1_resp != 0 and lsp_json_contains(h1_resp, "in" as int) == 1,
                  "hover 'in' keyword" as int, "hover response missing 'in'" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test hover on 'ref' keyword (line 2, col 5)
    let h2_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":5}}" as int)
    let h2_resp = lsp_client_call(client, "textDocument/hover" as int, h2_params)
    if lsp_assert(h2_resp != 0 and lsp_json_contains(h2_resp, "ref" as int) == 1,
                  "hover 'ref' keyword" as int, "hover response missing 'ref'" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test hover on 'out' keyword (line 3, col 5)
    let h3_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":3,\"character\":5}}" as int)
    let h3_resp = lsp_client_call(client, "textDocument/hover" as int, h3_params)
    if lsp_assert(h3_resp != 0 and lsp_json_contains(h3_resp, "out" as int) == 1,
                  "hover 'out' keyword" as int, "hover response missing 'out'" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test hover on ref parameter 'buffer' (line 2, col 10)
    let h_buf_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":10}}" as int)
    let h_buf_resp = lsp_client_call(client, "textDocument/hover" as int, h_buf_params)
    if lsp_assert(h_buf_resp != 0 and lsp_json_contains(h_buf_resp, "virBorrowed" as int) == 1,
                  "hover parameter 'buffer' (virBorrowed)" as int, "missing virBorrowed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test hover on out parameter 'result' (line 3, col 10)
    let h_res_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":3,\"character\":10}}" as int)
    let h_res_resp = lsp_client_call(client, "textDocument/hover" as int, h_res_params)
    if lsp_assert(h_res_resp != 0 and lsp_json_contains(h_res_resp, "virOut" as int) == 1,
                  "hover parameter 'result' (virOut)" as int, "missing virOut" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test goto definition on 'buffer'
    let def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":4,\"character\":6}}" as int)
    let def_resp = lsp_client_call(client, "textDocument/definition" as int, def_params)
    if lsp_assert(def_resp != 0 and (lsp_json_contains(def_resp, "range" as int) == 1 or lsp_json_contains(def_resp, "uri" as int) == 1),
                  "textDocument/definition on 'buffer'" as int, "missing definition target" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test find references on 'buffer'
    let ref_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":10}}" as int)
    let ref_resp = lsp_client_call(client, "textDocument/references" as int, ref_params)
    if lsp_assert(ref_resp != 0 and lsp_json_contains(ref_resp, "uri" as int) == 1,
                  "textDocument/references on 'buffer'" as int, "missing references list" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test rename parameter 'buffer' to 'state_buf' (line 2, col 10)
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":10},\"newName\":\"state_buf\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and (lsp_json_contains(ren_resp, "changes" as int) == 1 or lsp_json_contains(ren_resp, "documentChanges" as int) == 1),
                  "rename 'buffer' parameter" as int, "rename response missing changes" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test vir/semanticSnapshot custom extension
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "symbols" as int) == 1,
                  "vir/semanticSnapshot symbol snapshot" as int, "missing snapshot symbols" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Test shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "shutdown and exit clean" as int, "non-zero exit code" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.
func lsp_suite_run_handshake_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0 and lsp_json_contains(init_resp, "\"hoverProvider\":true" as int) == 1,
                  "handshake: hoverProvider supported" as int, "missing hoverProvider" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end
    if lsp_assert(init_resp != 0 and lsp_json_contains(init_resp, "\"name\":\"vir-lsp\"" as int) == 1,
                  "handshake: serverInfo name vir-lsp" as int, "missing serverInfo" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "handshake: clean shutdown and exit" as int, "exit code non-zero" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end
    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_features_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0 and lsp_json_contains(init_resp, "\"schemaVersion\":1" as int) == 1,
                  "features: initialize schemaVersion 1" as int, "missing schemaVersion" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-features-sample.vri" as int
    let doc_content = "func add(a: int, b: int) -> int:\\n    out a + b\\nend.\\n\\nfunc main():\\n    let x = add(1, 2)\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_content, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)
    passes = passes + 1
    print_str("PASS: features: textDocument/didOpen\n")

    # Hover on 'add'
    let h_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":6}}" as int)
    let h_resp = lsp_client_call(client, "textDocument/hover" as int, h_params)
    if lsp_assert(h_resp != 0 and lsp_json_contains(h_resp, "function" as int) == 1 and lsp_json_contains(h_resp, "add" as int) == 1,
                  "features: textDocument/hover on function add" as int, "missing hover info" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition on 'add' call
    let def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":5,\"character\":13}}" as int)
    let def_resp = lsp_client_call(client, "textDocument/definition" as int, def_params)
    if lsp_assert(def_resp != 0 and lsp_json_contains(def_resp, "range" as int) == 1,
                  "features: textDocument/definition on add call" as int, "missing definition range" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # References on 'add'
    let ref_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":6}}" as int)
    let ref_resp = lsp_client_call(client, "textDocument/references" as int, ref_params)
    if lsp_assert(ref_resp != 0 and lsp_json_contains(ref_resp, "uri" as int) == 1,
                  "features: textDocument/references on add" as int, "missing references" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Completion in main
    let comp_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":6,\"character\":0}}" as int)
    let comp_resp = lsp_client_call(client, "textDocument/completion" as int, comp_params)
    if lsp_assert(comp_resp != 0 and lsp_json_contains(comp_resp, "func" as int) == 1 and lsp_json_contains(comp_resp, "add" as int) == 1,
                  "features: textDocument/completion contains func & add" as int, "missing completion items" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # PrepareRename on 'add'
    let prep_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":6}}" as int)
    let prep_resp = lsp_client_call(client, "textDocument/prepareRename" as int, prep_params)
    if lsp_assert(prep_resp != 0 and lsp_json_contains(prep_resp, "placeholder" as int) == 1,
                  "features: textDocument/prepareRename placeholder" as int, "missing placeholder" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename negative: collision with keyword 'func' rejected (-32602)
    let ren_neg_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":6},\"newName\":\"func\"}" as int)
    let ren_neg_resp = lsp_client_call(client, "textDocument/rename" as int, ren_neg_params)
    if lsp_assert(ren_neg_resp != 0 and lsp_json_contains(ren_neg_resp, "-32602" as int) == 1,
                  "features: rename collision with keyword rejected (-32602)" as int, "keyword collision not rejected" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename positive: 'add' -> 'sum_values'
    let ren_pos_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":6},\"newName\":\"sum_values\"}" as int)
    let ren_pos_resp = lsp_client_call(client, "textDocument/rename" as int, ren_pos_params)
    if lsp_assert(ren_pos_resp != 0 and lsp_json_contains(ren_pos_resp, "sum_values" as int) == 1,
                  "features: rename positive replacing add with sum_values" as int, "rename missing sum_values" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # SemanticTokens/full
    let tok_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let tok_resp = lsp_client_call(client, "textDocument/semanticTokens/full" as int, tok_params)
    if lsp_assert(tok_resp != 0 and lsp_json_contains(tok_resp, "data" as int) == 1,
                  "features: textDocument/semanticTokens/full delta tokens" as int, "missing token data" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # vir/semanticSnapshot
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "occurrences" as int) == 1 and lsp_json_contains(snap_resp, "functions" as int) == 1,
                  "features: vir/semanticSnapshot occurrences and functions" as int, "missing snapshot data" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # vir/diagnosticSnapshot
    let dsnap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let dsnap_resp = lsp_client_call(client, "vir/diagnosticSnapshot" as int, dsnap_params)
    if lsp_assert(dsnap_resp != 0 and lsp_json_contains(dsnap_resp, "\"schemaVersion\":1" as int) == 1,
                  "features: vir/diagnosticSnapshot schemaVersion 1" as int, "missing diagnostic snapshot" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # didChange with syntax error -> emits E1004
    let bad_text = "func compute():\\n    let m = Matrix<1, 2, 3>\\nend.\\n" as int
    let change_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"version\":2},\"contentChanges\":[{\"text\":\"" as int, bad_text, "\"}]}" as int)
    lsp_client_notify(client, "textDocument/didChange" as int, change_params)
    var diag_msg = 0
    var attempt = 0
    when attempt < 10 loop
        let msg = lsp_client_read_any(client)
        if msg != 0 and lsp_json_contains(msg, "textDocument/publishDiagnostics" as int) == 1 do
            diag_msg = msg
            attempt = 10
        end
        attempt = attempt + 1
    end
    if lsp_assert(diag_msg != 0 and lsp_json_contains(diag_msg, "E1004" as int) == 1,
                  "features: textDocument/didChange emits E1004" as int, "missing E1004 in publishDiagnostics" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Shutdown and exit clean
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "features: clean shutdown and exit" as int, "exit code non-zero" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_registry_cwd_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0

    # 1. Valid explicit registry
    let reg_path = lsp_json_concat3(root_path, "/stdlib/stdlib.vri" as int, "" as int)
    var client = lsp_client_new(lsp_bin, reg_path)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0 and lsp_json_contains(init_resp, "\"capabilities\"" as int) == 1,
                  "registry_cwd: explicit registry initialize" as int, "init failed with explicit registry" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-foreign-cwd.vri" as int
    let doc_content = "func main:\\n    var value = 1\\n    print value\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":3,\"text\":\"" as int, doc_content, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "\"complete\":true" as int) == 1,
                  "registry_cwd: semanticSnapshot complete with explicit registry" as int, "snapshot incomplete" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "registry_cwd: clean shutdown" as int, "non-zero exit" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # 2. Invalid/missing explicit registry fails closed with code 1 and E2120
    let bad_reg = lsp_json_concat3(root_path, "/scratch/missing-registry.vri" as int, "" as int)
    let bad_trans = lsp_transport_spawn(lsp_bin, bad_reg)
    let st = alloc(8)
    lsp_sys_wait4(bad_trans.child_pid, st, 0)
    let bad_exit = read_byte(st, 1)
    free(st)
    if lsp_assert(bad_exit == 1, "registry_cwd: missing configured sysroot fails closed (exit code 1)" as int, "missing registry did not exit with code 1" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_absolute_root(root_path: int) -> int:
    if root_path != 0 and read_byte(root_path, 0) == 47 do out root_path end
    let result = alloc(4096)
    let status = getcwd(result, 4096)
    if status == 0 do out root_path end
    out result
end.

func lsp_suite_run_registry_collision_tests(lsp_bin: int, root_path: int) -> int:
    var
        passes = 0
        fails = 0
        client = lsp_client_new(lsp_bin, 0)

    let absolute_root = lsp_suite_absolute_root(root_path)
    let fixture_root = lsp_json_concat3(
        absolute_root,
        "/tests/modules/registry_stdlib_collision" as int,
        "" as int
    )
    let init_resp = lsp_client_initialize(client, fixture_root)
    if lsp_assert(init_resp != 0, "registry_collision: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = lsp_json_concat3(
        "file://" as int,
        fixture_root,
        "/stdlib_collision_rejected.vri" as int
    )
    let doc_content = "include json\\n\\nfunc main:\\n    out 0\\nend.\\n" as int
    let open_params = lsp_json_concat5(
        "{\"textDocument\":{\"uri\":\"" as int,
        doc_uri,
        "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int,
        doc_content,
        "\"}}" as int
    )
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    var
        diagnostic_message = 0
        attempt = 0
    when attempt < 10 loop
        let message = lsp_client_read_any(client)
        if message != 0 and
            lsp_json_contains(message, "textDocument/publishDiagnostics" as int) == 1 and
            lsp_json_contains(message, "E2123" as int) == 1 do
            diagnostic_message = message
            attempt = 10
        end
        attempt = attempt + 1
    end

    let collision_ok = diagnostic_message != 0 and
        lsp_json_contains(diagnostic_message, "E2123" as int) == 1 and
        lsp_json_contains(diagnostic_message, "relatedInformation" as int) == 1 and
        lsp_json_contains(diagnostic_message, "stdlib/stdlib.vri" as int) == 1 and
        lsp_json_contains(diagnostic_message, "project mapping: local_json.vri; standard library mapping: json.vri" as int) == 1
    if collision_ok == 0 and diagnostic_message != 0 do
        print_str("registry_collision payload: ")
        print_str(diagnostic_message)
        print_str("\n")
    end
    if lsp_assert(collision_ok, "registry_collision: E2123 related provenance and mappings" as int,
                  "missing collision identity or provenance" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "registry_collision: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_isolation_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "isolation: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_a = "file:///tmp/vir-isol-a.vri" as int
    let doc_b = "file:///tmp/vir-isol-b.vri" as int
    let text_a = "func alpha:\\n    var valueA = 10\\n    out valueA\\nend.\\n" as int
    let text_b = "func beta:\\n    var valueB = 20\\n    out valueB\\nend.\\n" as int

    let open_a = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_a, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, text_a, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_a)

    let open_b = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_b, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, text_b, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_b)

    # Hover on doc_a valueA
    let h_a_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_a, "\"},\"position\":{\"line\":1,\"character\":9}}" as int)
    let h_a = lsp_client_call(client, "textDocument/hover" as int, h_a_params)
    if lsp_assert(h_a != 0 and lsp_json_contains(h_a, "valueA" as int) == 1 and lsp_json_contains(h_a, "int" as int) == 1,
                  "isolation: hover doc A has valueA: int" as int, "missing valueA: int" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover on doc_b valueB
    let h_b_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_b, "\"},\"position\":{\"line\":1,\"character\":9}}" as int)
    let h_b = lsp_client_call(client, "textDocument/hover" as int, h_b_params)
    if lsp_assert(h_b != 0 and lsp_json_contains(h_b, "valueB" as int) == 1 and lsp_json_contains(h_b, "int" as int) == 1,
                  "isolation: hover doc B has valueB: int" as int, "missing valueB: int" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename on doc_a only modifies doc_a
    let ren_a_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_a, "\"},\"position\":{\"line\":1,\"character\":9},\"newName\":\"renamedA\"}" as int)
    let ren_a = lsp_client_call(client, "textDocument/rename" as int, ren_a_params)
    if lsp_assert(ren_a != 0 and lsp_json_contains(ren_a, "renamedA" as int) == 1 and lsp_json_contains(ren_a, doc_b) == 0,
                  "isolation: rename in doc A does not affect doc B" as int, "rename leaked into doc B" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # didClose doc_a
    let close_a_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_a, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didClose" as int, close_a_params)

    # Hover doc_b still works after doc_a is closed
    let h_b2 = lsp_client_call(client, "textDocument/hover" as int, h_b_params)
    if lsp_assert(h_b2 != 0 and lsp_json_contains(h_b2, "valueB" as int) == 1,
                  "isolation: hover doc B works after doc A closed" as int, "doc B broken after closing doc A" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "isolation: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_cross_file_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "cross_file: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let dep_uri = "file:///tmp/vir-lsp-cross-dep.vri" as int
    let root_uri = "file:///tmp/vir-lsp-cross-root.vri" as int
    let dep_text = "func helper(v: int) -> int:\\n    out v + 10\\nend.\\n" as int
    let root_text = "include vir-lsp-cross-dep\\nfunc main():\\n    let res = helper(5)\\nend.\\n" as int

    let open_dep = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, dep_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, dep_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_dep)

    let open_root = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, root_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_root)

    # Semantic snapshot on root
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "\"complete\":true" as int) == 1,
                  "cross_file: semantic snapshot on multi-file root" as int, "snapshot incomplete" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition on helper call in root_uri (line 2, col 15)
    let def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\"},\"position\":{\"line\":2,\"character\":15}}" as int)
    let def_resp = lsp_client_call(client, "textDocument/definition" as int, def_params)
    if lsp_assert(def_resp != 0 and lsp_json_contains(def_resp, "range" as int) == 1,
                  "cross_file: definition resolves across files" as int, "definition missing range" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # References on helper declaration in dep_uri (line 0, col 6)
    let ref_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, dep_uri, "\"},\"position\":{\"line\":0,\"character\":6}}" as int)
    let ref_resp = lsp_client_call(client, "textDocument/references" as int, ref_params)
    if lsp_assert(ref_resp != 0 and lsp_json_contains(ref_resp, "range" as int) == 1,
                  "cross_file: references finds symbol occurrences" as int, "references missing" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "cross_file: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_type_graph_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "type_graph: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-type-graph.vri" as int
    let doc_text = "entity Box:\\n    value: int\\nend.\\n\\nfunc get_val(b: Box) -> int:\\n    out b.value\\nend.\\n\\nfunc main():\\n    let bx = Box(value: 42)\\n    print get_val(bx)\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Hover on entity type Box in signature (line 4, col 18)
    let h_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":4,\"character\":18}}" as int)
    let h_resp = lsp_client_call(client, "textDocument/hover" as int, h_params)
    if lsp_assert(h_resp != 0 and lsp_json_contains(h_resp, "Box" as int) == 1,
                  "type_graph: hover entity Box" as int, "missing Box hover" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Semantic snapshot contains symbols and type occurrences
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "\"symbols\"" as int) == 1 and lsp_json_contains(snap_resp, "Box" as int) == 1,
                  "type_graph: semanticSnapshot records entity symbols" as int, "missing entity symbols" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename entity Box to Container
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":0,\"character\":8},\"newName\":\"Container\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and lsp_json_contains(ren_resp, "Container" as int) == 1,
                  "type_graph: rename entity Box propagates edits" as int, "missing Container in edits" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "type_graph: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_cancellation_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "cancellation: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-cancel-doc.vri" as int
    let doc_text = "func compute():\\n    var s = 0\\n    s = s + 1\\n    out s\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Send request then immediately send cancelRequest
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let req_id = lsp_client_request(client, "vir/semanticSnapshot" as int, snap_params)
    let cancel_params = lsp_json_concat3("{\"id\":" as int, lsp_json_int_to_str(req_id), "}" as int)
    lsp_client_notify(client, "$/cancelRequest" as int, cancel_params)

    let resp = lsp_client_read_resp(client, req_id)
    if lsp_assert(resp != 0 and (lsp_json_contains(resp, "-32800" as int) == 1 or lsp_json_contains(resp, "result" as int) == 1),
                  "cancellation: request responds cleanly without stall" as int, "request stalled or invalid" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "cancellation: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_import_alias_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "import_alias: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let dep_uri = "file:///tmp/vir_lsp_alias/compute.vri" as int
    let root_uri = "file:///tmp/vir_lsp_alias/main.vri" as int
    let dep_text = "func compute(v: int) -> int:\\n    out v * 2\\nend.\\nexport compute\\n" as int
    let root_text = "import compute from compute as calc\\nfunc main():\\n    print calc(10)\\nend.\\n" as int

    let open_dep = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, dep_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, dep_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_dep)

    let open_root = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, root_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_root)

    # Hover on alias 'calc' in call (line 2, col 10)
    let h_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\"},\"position\":{\"line\":2,\"character\":10}}" as int)
    let h_resp = lsp_client_call(client, "textDocument/hover" as int, h_params)
    if lsp_assert(h_resp != 0 and (lsp_json_contains(h_resp, "calc" as int) == 1 or lsp_json_contains(h_resp, "compute" as int) == 1),
                  "import_alias: hover on alias resolves" as int, "alias hover failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition on alias points to declaration in root
    let def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\"},\"position\":{\"line\":2,\"character\":10}}" as int)
    let def_resp = lsp_client_call(client, "textDocument/definition" as int, def_params)
    if lsp_assert(def_resp != 0 and lsp_json_contains(def_resp, "range" as int) == 1,
                  "import_alias: definition on alias" as int, "missing range" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename alias in root
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, root_uri, "\"},\"position\":{\"line\":2,\"character\":10},\"newName\":\"runCalc\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and lsp_json_contains(ren_resp, "runCalc" as int) == 1,
                  "import_alias: rename alias updates occurrences" as int, "missing runCalc in rename" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Whole-module namespace facts must retain provider provenance and expose
    # only the provider's explicit export surface through member completion.
    let absolute_root = lsp_suite_absolute_root(root_path)
    let ns_dep_uri = lsp_json_concat3("file://" as int, absolute_root, "/tests/modules/fixture_export_kinds.vri" as int)
    let ns_root_uri = lsp_json_concat3("file://" as int, absolute_root, "/tests/modules/test_whole_module_lsp_namespace.vri" as int)
    let ns_dep_text = "const EXPORTED_CONST: int = 7\\nconst HIDDEN_CONST: int = 99\\nfunc exported_kind_func() -> int:\\n    out EXPORTED_CONST\\nend.\\nfunc hidden_kind_func() -> int:\\n    out HIDDEN_CONST\\nend.\\nexport EXPORTED_CONST, exported_kind_func\\n" as int
    let ns_root_text = "import mod.fixture_export_kinds as fe\\nentity LocalValue:\\n    value: int\\nend.\\nfunc module_use():\\n    print fe.exported_kind_func()\\nend.\\nfunc local_use():\\n    let fe = LocalValue(value: 100)\\n    print fe.value\\nend.\\n" as int

    let open_ns_dep = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, ns_dep_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, ns_dep_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_ns_dep)

    let open_ns_root = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, ns_root_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, ns_root_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_ns_root)

    let ns_snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, ns_root_uri, "\"}}" as int)
    let ns_snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, ns_snap_params)
    if lsp_assert(ns_snap_resp != 0 and lsp_json_contains(ns_snap_resp, "\"complete\":true" as int) == 1,
                  "import_alias: whole-module compiler snapshot is complete" as int, "namespace compiler facts are incomplete" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let ns_comp_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, ns_root_uri, "\"},\"position\":{\"line\":5,\"character\":13}}" as int)
    let ns_comp_resp = lsp_client_call(client, "textDocument/completion" as int, ns_comp_params)
    let local_comp_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, ns_root_uri, "\"},\"position\":{\"line\":9,\"character\":13}}" as int)
    let local_comp_resp = lsp_client_call(client, "textDocument/completion" as int, local_comp_params)
    if lsp_assert(ns_comp_resp != 0 and lsp_json_contains(ns_comp_resp, "\"label\":\"EXPORTED_CONST\"" as int) == 1 and lsp_json_contains(ns_comp_resp, "\"label\":\"exported_kind_func\"" as int) == 1 and lsp_json_contains(ns_comp_resp, "\"label\":\"HIDDEN_CONST\"" as int) == 0 and lsp_json_contains(ns_comp_resp, "\"label\":\"hidden_kind_func\"" as int) == 0,
                  "import_alias: whole-module completion exposes exports only" as int, "namespace completion leaked private symbols or missed an export" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if lsp_assert(local_comp_resp != 0 and lsp_json_contains(local_comp_resp, "\"label\":\"value\"" as int) == 1 and lsp_json_contains(local_comp_resp, "\"label\":\"exported_kind_func\"" as int) == 0,
                  "import_alias: local receiver shadows module alias in completion" as int, "module namespace completion overrode a visible local receiver" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let ns_def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, ns_root_uri, "\"},\"position\":{\"line\":5,\"character\":16}}" as int)
    let ns_def_resp = lsp_client_call(client, "textDocument/definition" as int, ns_def_params)
    if lsp_assert(ns_def_resp != 0 and lsp_json_contains(ns_def_resp, "fixture_export_kinds.vri" as int) == 1 and lsp_json_contains(ns_def_resp, "range" as int) == 1,
                  "import_alias: whole-module definition retains provider provenance" as int, "definition did not resolve to provider" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "import_alias: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_completion_contract_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "completion_contract: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-comp-contract.vri" as int
    let doc_text = "entity Point:\\n    x: int,\\n    y: int\\nend.\\n\\nfunc calculate(pt: Point) -> int:\\n    var sum = pt.x + pt.y\\n    out sum\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Completion at top-level
    let comp1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":5,\"character\":0}}" as int)
    let comp1 = lsp_client_call(client, "textDocument/completion" as int, comp1_params)
    if lsp_assert(comp1 != 0 and lsp_json_contains(comp1, "func" as int) == 1,
                  "completion_contract: top-level keyword completion" as int, "missing func keyword" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Completion inside calculate function (line 7, col 4)
    let comp2_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":7,\"character\":4}}" as int)
    let comp2 = lsp_client_call(client, "textDocument/completion" as int, comp2_params)
    if lsp_assert(comp2 != 0 and (lsp_json_contains(comp2, "sum" as int) == 1 or lsp_json_contains(comp2, "pt" as int) == 1),
                  "completion_contract: local variable completion" as int, "missing local symbols" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "completion_contract: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_member_graph_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "member_graph: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-lsp-member-graph.vri" as int
    let doc_text = "entity Box:\\n    value: int\\nend.\\nentity Other:\\n    value: int\\nend.\\nfunc main():\\n    var b = Box(value: 1)\\n    var o = Other(value: 2)\\n    print b.value\\n    print o.value\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Definition on b.value (line 8, col 12) -> points to Box.value (line 1, col 4)
    let def_b_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":8,\"character\":12}}" as int)
    let def_b_resp = lsp_client_call(client, "textDocument/definition" as int, def_b_params)
    if lsp_assert(def_b_resp != 0 and lsp_json_contains(def_b_resp, "range" as int) == 1,
                  "member_graph: definition on b.value resolves to Box.value" as int, "missing range" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # References on Box.value (line 1, col 4)
    let ref_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":4}}" as int)
    let ref_resp = lsp_client_call(client, "textDocument/references" as int, ref_params)
    if lsp_assert(ref_resp != 0 and lsp_json_contains(ref_resp, "range" as int) == 1,
                  "member_graph: references on Box.value finds field occurrences" as int, "missing references" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename Box.value to itemValue
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":4},\"newName\":\"itemValue\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and lsp_json_contains(ren_resp, "itemValue" as int) == 1,
                  "member_graph: rename Box.value propagates to member access" as int, "missing itemValue in rename" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "member_graph: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_compiler_facts_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "compiler_facts: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/compiler-facts-unsaved.vri" as int
    let doc_text = "func main:\\n    var text = \\\"hello\\\"\\n    var ratio = 1.25\\n    var flag = true\\n    print text\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Hover on text literal (line 1, col 17) -> Compiler expression type: `string`
    let h1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":17}}" as int)
    let h1_resp = lsp_client_call(client, "textDocument/hover" as int, h1_params)
    if lsp_assert(h1_resp != 0 and lsp_json_contains(h1_resp, "string" as int) == 1,
                  "compiler_facts: literal expression hover shows string" as int, "missing string type" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover on ratio literal (line 2, col 17) -> float
    let h2_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":17}}" as int)
    let h2_resp = lsp_client_call(client, "textDocument/hover" as int, h2_params)
    if lsp_assert(h2_resp != 0 and lsp_json_contains(h2_resp, "float" as int) == 1,
                  "compiler_facts: literal expression hover shows float" as int, "missing float type" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover on flag literal (line 3, col 15) -> bool
    let h3_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":3,\"character\":15}}" as int)
    let h3_resp = lsp_client_call(client, "textDocument/hover" as int, h3_params)
    if lsp_assert(h3_resp != 0 and lsp_json_contains(h3_resp, "bool" as int) == 1,
                  "compiler_facts: literal expression hover shows bool" as int, "missing bool type" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Semantic snapshot contains displayType and analysisId
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap_resp != 0 and lsp_json_contains(snap_resp, "\"displayType\"" as int) == 1 and lsp_json_contains(snap_resp, "\"analysisId\"" as int) == 1,
                  "compiler_facts: semanticSnapshot includes expression facts" as int, "missing displayType or analysisId" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Invalid identifier rename rejected (-32602)
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":9},\"newName\":\"bad-hyphen\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and lsp_json_contains(ren_resp, "-32602" as int) == 1,
                  "compiler_facts: invalid identifier rename rejected (-32602)" as int, "did not reject invalid name" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "compiler_facts: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_focus_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "focus: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-focus-test.vri" as int
    let doc_text = "func alpha():\\n    var val = 1\\n    print val\\nend.\\nfunc beta():\\n    var val = 2\\n    print val\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Full mode snapshot
    let full_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"mode\":\"full\",\"version\":1}" as int)
    let full_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, full_params)
    if lsp_assert(full_resp != 0 and lsp_json_contains(full_resp, "\"complete\":true" as int) == 1,
                  "focus: semanticSnapshot full mode" as int, "full mode failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Stale version rejected (-32801)
    let stale_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"version\":0}" as int)
    let stale_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, stale_params)
    if lsp_assert(stale_resp != 0 and lsp_json_contains(stale_resp, "-32801" as int) == 1,
                  "focus: stale document version rejected (-32801)" as int, "stale version not rejected" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Invalid focusSymbolId rejected (-32602)
    let inv_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"mode\":\"focus\",\"focusSymbolId\":\"unknown_999\"}" as int)
    let inv_resp = lsp_client_call(client, "vir/semanticSnapshot" as int, inv_params)
    if lsp_assert(inv_resp != 0 and lsp_json_contains(inv_resp, "-32602" as int) == 1,
                  "focus: invalid focusSymbolId rejected (-32602)" as int, "invalid symbol not rejected" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "focus: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_session_resources_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "session_resources: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir-session-resources.vri" as int
    let doc_text = "func main():\\n    var v0 = 0\\n    var v1 = 1\\n    out v0 + v1\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Initial snapshot
    let s1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let s1 = lsp_client_call(client, "vir/semanticSnapshot" as int, s1_params)
    if lsp_assert(s1 != 0 and lsp_json_contains(s1, "\"complete\":true" as int) == 1,
                  "session_resources: initial snapshot complete" as int, "initial snapshot failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Incremental update v2
    let chg_v2 = "func main():\\n    var v0 = 10\\n    var v1 = 20\\n    out v0 + v1\\nend.\\n" as int
    let c2_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"version\":2},\"contentChanges\":[{\"text\":\"" as int, chg_v2, "\"}]}" as int)
    lsp_client_notify(client, "textDocument/didChange" as int, c2_params)

    let s2 = lsp_client_call(client, "vir/semanticSnapshot" as int, s1_params)
    if lsp_assert(s2 != 0 and lsp_json_contains(s2, "\"documentVersion\":2" as int) == 1,
                  "session_resources: updated snapshot records documentVersion 2" as int, "version 2 not recorded" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Repeat query without modification returns identical complete status
    let s2_repeat = lsp_client_call(client, "vir/semanticSnapshot" as int, s1_params)
    if lsp_assert(s2_repeat != 0 and lsp_json_contains(s2_repeat, "\"documentVersion\":2" as int) == 1,
                  "session_resources: repeat query maintains snapshot stability" as int, "repeat query unstable" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "session_resources: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_repro_turn3_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "repro_turn3: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # P1: Block shadowing
    let doc_p1_uri = "file:///tmp/repro-turn3-p1.vri" as int
    let doc_p1_text = "func foo(x: int) -> int:\\n    if true do\\n        var x = 10\\n        x = x + 1\\n    end\\n    out x\\nend.\\n" as int
    let open1_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_p1_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_p1_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open1_params)

    # Definition of outer 'x' at line 5 (out x) -> line 0
    let def_p1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_p1_uri, "\"},\"position\":{\"line\":5,\"character\":8}}" as int)
    let def_p1_resp = lsp_client_call(client, "textDocument/definition" as int, def_p1_params)
    if lsp_assert(def_p1_resp != 0 and lsp_json_contains(def_p1_resp, "\"line\":0" as int) == 1,
                  "repro_turn3: outer 'x' definition points to signature (line 0)" as int, "failed outer definition" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename inner 'x' inside if block (line 2, character 12)
    let ren_p1_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_p1_uri, "\"},\"position\":{\"line\":2,\"character\":12},\"newName\":\"inner_x\"}" as int)
    let ren_p1_resp = lsp_client_call(client, "textDocument/rename" as int, ren_p1_params)
    if lsp_assert(ren_p1_resp != 0 and lsp_json_contains(ren_p1_resp, "inner_x" as int) == 1,
                  "repro_turn3: inner 'x' rename succeeds" as int, "inner rename failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # P2: Standalone section headers
    let doc_p2_uri = "file:///tmp/repro-turn3-p2.vri" as int
    let doc_p2_text = "func transfer:\\n    in\\n        source: int\\n        destination: int\\n    ref\\n        buffer: int\\n    out\\n        status: int\\n    buffer = buffer + source\\n    status = destination\\nend.\\n" as int
    let open2_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_p2_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_p2_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open2_params)

    # Hover on 'source' (line 2, character 9)
    let h_src_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_p2_uri, "\"},\"position\":{\"line\":2,\"character\":9}}" as int)
    let h_src = lsp_client_call(client, "textDocument/hover" as int, h_src_params)
    if lsp_assert(h_src != 0 and lsp_json_contains(h_src, "source" as int) == 1,
                  "repro_turn3: hover on standalone 'in' param" as int, "missing source in hover" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover on 'buffer' (line 5, character 9) -> virBorrowed
    let h_buf_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_p2_uri, "\"},\"position\":{\"line\":5,\"character\":9}}" as int)
    let h_buf = lsp_client_call(client, "textDocument/hover" as int, h_buf_params)
    if lsp_assert(h_buf != 0 and lsp_json_contains(h_buf, "virBorrowed" as int) == 1,
                  "repro_turn3: hover on standalone 'ref' param shows virBorrowed" as int, "missing virBorrowed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover on 'status' (line 7, character 9) -> virOut
    let h_stat_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_p2_uri, "\"},\"position\":{\"line\":7,\"character\":9}}" as int)
    let h_stat = lsp_client_call(client, "textDocument/hover" as int, h_stat_params)
    if lsp_assert(h_stat != 0 and lsp_json_contains(h_stat, "virOut" as int) == 1,
                  "repro_turn3: hover on standalone 'out' param shows virOut" as int, "missing virOut" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "repro_turn3: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_repro_p1_p2_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "repro_p1_p2: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/repro-p1-p2-multi.vri" as int
    let doc_text = "func foo:\\n    ref buffer: int\\n    buffer = buffer + 1\\nend.\\n\\nfunc bar:\\n    ref buffer: int\\n        other: int\\n    buffer = buffer + 2\\n    other = other + 1\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Hover on continuation parameter 'other' (line 7, character 9)
    let h_other_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":7,\"character\":9}}" as int)
    let h_other = lsp_client_call(client, "textDocument/hover" as int, h_other_params)
    if lsp_assert(h_other != 0 and lsp_json_contains(h_other, "other" as int) == 1 and lsp_json_contains(h_other, "virBorrowed" as int) == 1,
                  "repro_p1_p2: hover on continuation param 'other' shows virBorrowed" as int, "missing other or virBorrowed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition of 'buffer' in foo (line 2, character 5) -> line 1
    let def_foo_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":5}}" as int)
    let def_foo = lsp_client_call(client, "textDocument/definition" as int, def_foo_params)
    if lsp_assert(def_foo != 0 and lsp_json_contains(def_foo, "\"line\":1" as int) == 1,
                  "repro_p1_p2: definition of 'buffer' in foo resolves to line 1" as int, "missing line 1 definition" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition of 'buffer' in bar (line 8, character 5) -> line 6
    let def_bar_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":8,\"character\":5}}" as int)
    let def_bar = lsp_client_call(client, "textDocument/definition" as int, def_bar_params)
    if lsp_assert(def_bar != 0 and lsp_json_contains(def_bar, "\"line\":6" as int) == 1,
                  "repro_p1_p2: definition of 'buffer' in bar resolves to line 6" as int, "missing line 6 definition" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename 'buffer' in foo (line 1, character 9) to new_buf
    let ren_foo_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":9},\"newName\":\"new_buf\"}" as int)
    let ren_foo = lsp_client_call(client, "textDocument/rename" as int, ren_foo_params)
    if lsp_assert(ren_foo != 0 and lsp_json_contains(ren_foo, "new_buf" as int) == 1,
                  "repro_p1_p2: rename 'buffer' in foo succeeds" as int, "foo rename failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "repro_p1_p2: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_unicode_roundtrip_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "unicode_roundtrip: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/vir%20roundtrip-unicode.vri" as int
    let doc_text = "func main:\\r\\n\\tvar label = \\\"test😀\\\"; var value = 1; print value\\r\\nend.\\r\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":7,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Snapshot before
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap1 = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap1 != 0 and lsp_json_contains(snap1, "\"complete\":true" as int) == 1,
                  "unicode_roundtrip: initial semanticSnapshot complete" as int, "snapshot incomplete" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Definition of 'value' (at decl: 27, use: 44)
    let def_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":27}}" as int)
    let def_resp = lsp_client_call(client, "textDocument/definition" as int, def_params)
    if lsp_assert(def_resp != 0 and lsp_json_contains(def_resp, "range" as int) == 1,
                  "unicode_roundtrip: definition resolves across unicode offsets" as int, "def failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Rename 'value' to 'renamedVal' (at character 27)
    let ren_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":27},\"newName\":\"renamedVal\"}" as int)
    let ren_resp = lsp_client_call(client, "textDocument/rename" as int, ren_params)
    if lsp_assert(ren_resp != 0 and lsp_json_contains(ren_resp, "renamedVal" as int) == 1,
                  "unicode_roundtrip: rename produces valid UTF-16 edit ranges" as int, "rename failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "unicode_roundtrip: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_partial_input_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "partial_input: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    let doc_uri = "file:///tmp/partial-frame-unsaved.vri" as int
    let doc_text = "func main:\\n    print 1\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # Snapshot
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap != 0 and lsp_json_contains(snap, "\"documentVersion\":1" as int) == 1,
                  "partial_input: semanticSnapshot returns version 1" as int, "snapshot version mismatch" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Hover
    let h_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":1,\"character\":10}}" as int)
    let h_resp = lsp_client_call(client, "textDocument/hover" as int, h_params)
    if lsp_assert(h_resp != 0, "partial_input: hover query completes" as int, "hover query failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "partial_input: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_checker_equivalence_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "checker_equivalence: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # didOpen unsaved snapshot with borrow error
    let doc_uri = "file:///tmp/unsaved-double_mut_borrow.vri" as int
    let doc_text = "func main:\\n    var a = 10\\n    let b = &mut a\\n    let c = &mut a\\n    print b\\n    print c\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # semanticSnapshot records checker facts
    let snap_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let snap = lsp_client_call(client, "vir/semanticSnapshot" as int, snap_params)
    if lsp_assert(snap != 0 and (lsp_json_contains(snap, "virBorrowed" as int) == 1 or lsp_json_contains(snap, "occurrences" as int) == 1),
                  "checker_equivalence: semanticSnapshot captures loan occurrences" as int, "snapshot missing loan occurrences" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # diagnosticSnapshot captures borrow error
    let diag_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let diag = lsp_client_call(client, "vir/diagnosticSnapshot" as int, diag_params)
    if lsp_assert(diag != 0 and lsp_json_contains(diag, "\"diagnostics\"" as int) == 1,
                  "checker_equivalence: diagnosticSnapshot contains borrow diagnostics" as int, "diagnostics missing" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # hover on loan variable
    let h_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"},\"position\":{\"line\":2,\"character\":8}}" as int)
    let h_resp = lsp_client_call(client, "textDocument/hover" as int, h_params)
    if lsp_assert(h_resp != 0, "checker_equivalence: loan variable hover succeeds" as int, "hover failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "checker_equivalence: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.

func lsp_suite_run_diagnostic_mapping_tests(lsp_bin: int, root_path: int) -> int:
    var passes = 0
    var fails = 0
    var client = lsp_client_new(lsp_bin, 0)
    let init_resp = lsp_client_initialize(client, root_path)
    if lsp_assert(init_resp != 0, "diagnostic_mapping: initialize" as int, "init failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # didOpen invalid syntax document
    let doc_uri = "file:///tmp/syntax-invalid-mapping.vri" as int
    let doc_text = "func bad(out value: int):\\nend.\\n" as int
    let open_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"languageId\":\"vir\",\"version\":1,\"text\":\"" as int, doc_text, "\"}}" as int)
    lsp_client_notify(client, "textDocument/didOpen" as int, open_params)

    # diagnosticSnapshot records syntax error
    let diag_params = lsp_json_concat3("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\"}}" as int)
    let diag = lsp_client_call(client, "vir/diagnosticSnapshot" as int, diag_params)
    if lsp_assert(diag != 0 and lsp_json_contains(diag, "\"diagnostics\"" as int) == 1,
                  "diagnostic_mapping: diagnosticSnapshot contains syntax diagnostics" as int, "missing diagnostics" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # didChange to valid code
    let chg_text = "func main:\\n    out 0\\nend.\\n" as int
    let chg_params = lsp_json_concat5("{\"textDocument\":{\"uri\":\"" as int, doc_uri, "\",\"version\":2},\"contentChanges\":[{\"text\":\"" as int, chg_text, "\"}]}" as int)
    lsp_client_notify(client, "textDocument/didChange" as int, chg_params)

    # semanticSnapshot on repaired document
    let snap = lsp_client_call(client, "vir/semanticSnapshot" as int, diag_params)
    if lsp_assert(snap != 0 and lsp_json_contains(snap, "\"documentVersion\":2" as int) == 1,
                  "diagnostic_mapping: semanticSnapshot reports updated version 2" as int, "version update failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    # Clean shutdown
    let exit_code = lsp_client_shutdown(client)
    if lsp_assert(exit_code == 0, "diagnostic_mapping: clean shutdown" as int, "shutdown failed" as int) == 1 do
        passes = passes + 1
    else
        fails = fails + 1
    end

    if fails == 0 do out passes end
    out (0 - fails)
end.
