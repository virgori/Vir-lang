##
 * vir-lsp-test — Pure-Vir Native LSP Verification Test Runner
 * ============================================================
 * Governed by VIRC-ISS-0050 & VIRC-PLN-0029 (Phase 4).
 * Replaces Python test runner with a self-hosted native test client.
 ##

include vir_lsp_test.suite

func main_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func main_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = main_strlen(a)
    let lb = main_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func main_print_int(n: int):
    if n == 0 do
        print_str("0")
        out 0
    end
    var v = n
    if v < 0 do
        print_str("-")
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        let ch = alloc(2)
        write_byte(ch, 0, read_byte(digits, i))
        write_byte(ch, 1, 0)
        print_str(ch as string)
        free(ch)
        i = i - 1
    end
    free(digits)
    out 0
end.

func main():
    print_str("====================================\n")
    print_str("  vir-lsp-test — Native LSP Test Runner\n")
    print_str("  Governed by VIRC-ISS-0050 & VIRC-PLN-0029\n")
    print_str("====================================\n\n")

    var lsp_bin = "bin/vir-lsp" as int
    var root_path = "." as int
    var suite_name = "all" as int

    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if main_streq(arg, "--lsp" as int) == 1 and i + 1 < argc do
            i = i + 1
            lsp_bin = get_arg(i) as int
        eif main_streq(arg, "--root" as int) == 1 and i + 1 < argc do
            i = i + 1
            root_path = get_arg(i) as int
        eif main_streq(arg, "--suite" as int) == 1 and i + 1 < argc do
            i = i + 1
            suite_name = get_arg(i) as int
        end
        i = i + 1
    end

    print_str("Target LSP daemon: ")
    print_str(lsp_bin as string)
    print_str("\n\n")

    var total_checks = 0
    var has_failure = 0

    let run_all = main_streq(suite_name, "all" as int)

    if run_all == 1 or main_streq(suite_name, "handshake" as int) == 1 do
        print_str("--- Suite: handshake ---\n")
        let r = lsp_suite_run_handshake_tests(lsp_bin, root_path)
        if r > 0 do
            total_checks = total_checks + r
        else
            has_failure = 1
        end
        print_str("\n")
    end

    if run_all == 1 or main_streq(suite_name, "features" as int) == 1 do
        print_str("--- Suite: features ---\n")
        let r = lsp_suite_run_features_tests(lsp_bin, root_path)
        if r > 0 do
            total_checks = total_checks + r
        else
            has_failure = 1
        end
        print_str("\n")
    end

