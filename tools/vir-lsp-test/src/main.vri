    if run_all == 1 or main_streq(suite_name, "diagnostic_mapping" as int) == 1 do
        print_str("--- Suite: diagnostic_mapping ---\n")
        let r = lsp_suite_run_diagnostic_mapping_tests(lsp_bin, root_path)
        if r > 0 do
            total_checks = total_checks + r
        else
            has_failure = 1
        end
        print_str("\n")
    end

    print_str("------------------------------------\n")
    if has_failure == 0 and total_checks > 0 do
        print_str("Result: ALL LSP SUITES PASSED (")
        main_print_int(total_checks)
        print_str(" checks)\n")
        exit_prog(0)
    else
        print_str("Result: LSP SUITES FAILED\n")
        exit_prog(1)
    end
end.
