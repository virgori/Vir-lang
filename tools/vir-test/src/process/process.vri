# ═════════════════════════════════════════════════════════════════════
# vir_test.process — Process Spawning, Syscalls & Output Redirection
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
extern func vir_get_platform() -> int
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, v: int)
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func mkdir(path: int, mode: int) -> int
extern func rmdir(path: int) -> int
extern func exit_prog(code: int)

func proc_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func proc_int_to_str(n: int) -> int:
    if n == 0 do
        let res0 = alloc(2)
        write_byte(res0, 0, 48)
        write_byte(res0, 1, 0)
        out res0
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func proc_str_concat2(a: int, b: int) -> int:
    let la = proc_strlen(a)
    let lb = proc_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func proc_str_concat3(a: int, b: int, c: int) -> int:
    out proc_str_concat2(proc_str_concat2(a, b), c)
end.

func proc_str_concat4(a: int, b: int, c: int, d: int) -> int:
    out proc_str_concat2(proc_str_concat3(a, b, c), d)
end.

func proc_str_contains(haystack: int, needle: int) -> int:
    let hlen = proc_strlen(haystack)
    let nlen = proc_strlen(needle)
    if nlen == 0 do out 1 end
    if hlen < nlen do out 0 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func proc_str_trim(s: int) -> int:
    let len = proc_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 10 or read_byte(s, start) == 13) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 10 or read_byte(s, end_pos - 1) == 13) loop
        end_pos = end_pos - 1
    end
    let n = end_pos - start
    if n <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let buf = alloc(n + 1)
    var j = 0
    when j < n loop
        write_byte(buf, j, read_byte(s, start + j))
        j = j + 1
    end
    write_byte(buf, n, 0)
    out buf
end.

func proc_sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall0(172)
    eif plat == 3 do
        out syscall0(39)
    else
        out syscall0(0x2000014)
    end
end.

func proc_sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall5(220, 17, 0, 0, 0, 0) # Linux ARM64 clone(SIGCHLD=17)
    eif plat == 3 do
        out syscall0(57)                  # Linux x86_64 fork
    else
        out syscall0(0x2000002)           # Darwin fork
    end
end.

func proc_sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(24, old_fd, new_fd, 0) # Linux ARM64 dup3
    eif plat == 3 do
        out syscall2(33, old_fd, new_fd)    # Linux x86_64 dup2
    else
        out syscall2(0x200005A, old_fd, new_fd) # Darwin dup2
    end
end.

func proc_sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall4(56, -100, path, 0x241, 420)
    eif plat == 3 do
        out syscall3(2, path, 0x241, 420)
    else
        out syscall3(0x2000005, path, 0x601, 420)
    end
end.

func proc_sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall1(57, fd)
    eif plat == 3 do
        out syscall1(3, fd)
    else
        out syscall1(0x2000006, fd)
    end
end.

func proc_sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall4(260, pid, status_ptr, options, 0)
    eif plat == 3 do
        out syscall4(61, pid, status_ptr, options, 0)
    else
        out syscall4(0x2000007, pid, status_ptr, options, 0)
    end
end.

func proc_sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(221, path, argv, envp)
    eif plat == 3 do
        out syscall3(59, path, argv, envp)
    else
        out syscall3(0x200003B, path, argv, envp)
    end
end.

func proc_unlink(path: int) -> int:
    if path == 0 do out -1 end
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(35, -100, path, 0)
    eif plat == 3 do
        out syscall1(87, path)
    else
        out syscall1(0x200000A, path)
    end
end.

func proc_mkdir(path: int) -> int:
    out mkdir(path, 493) # 0755
end.

func proc_rmdir(path: int) -> int:
    out rmdir(path)
end.

func proc_file_exists(path: int) -> int:
    if path == 0 do out 0 end
    let len = slurp_len(path)
    if len >= 0 do out 1 end
    out 0
end.

func proc_read_file(path: int) -> int:
    let len = slurp_len(path)
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let buf = alloc(len + 1)
    slurp_file(path, buf, len)
    write_byte(buf, len, 0)
    out buf
end.

func proc_write_file(path: int, content: int):
    let fd = proc_sys_open_write(path)
    if fd < 0 do out end
    let len = proc_strlen(content)
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        syscall3(64, fd, content, len)
    eif plat == 3 do
        syscall3(1, fd, content, len)
    else
        syscall3(0x2000004, fd, content, len)
    end
    proc_sys_close(fd)
end.

func proc_write_ptr(buf: int, offset: int, val: int):
    native_write_i64(buf, offset, val)
end.

func proc_find_node() -> int:
    if proc_file_exists("/usr/local/bin/node" as int) == 1 do
        out "/usr/local/bin/node" as int
    eif proc_file_exists("/opt/homebrew/bin/node" as int) == 1 do
        out "/opt/homebrew/bin/node" as int
    eif proc_file_exists("/usr/bin/node" as int) == 1 do
        out "/usr/bin/node" as int
    eif proc_file_exists("node" as int) == 1 do
        out "node" as int
    end
    out 0
end.

func proc_build_envp() -> int:
    let plat = vir_get_platform()
    let capacity = 65536
    let buf = alloc(capacity)
    var size = 0
    var start = 0

    if plat == 0 or plat == 1 do
        let mib = alloc(12)
        write_byte(mib, 0, 1)
        write_byte(mib, 4, 49)
        let pid = syscall0(0x2000014)
        write_byte(mib, 8, pid bit_and 255)
        write_byte(mib, 9, (pid shr 8) bit_and 255)
        write_byte(mib, 10, (pid shr 16) bit_and 255)
        write_byte(mib, 11, (pid shr 24) bit_and 255)
        let size_ptr = alloc(8)
        proc_write_ptr(size_ptr, 0, capacity)
        let rc = syscall6(0x20000CA, mib, 3, buf, size_ptr, 0, 0)
        if rc == 0 do
            size = native_read_i64(size_ptr, 0)
        end
        var argc = 0
        if size >= 4 do
            argc = read_byte(buf, 0) + (read_byte(buf, 1) shl 8) + (read_byte(buf, 2) shl 16) + (read_byte(buf, 3) shl 24)
        end
        var pos = 4
        when pos < size and read_byte(buf, pos) != 0 loop
            pos = pos + 1
        end
        when pos < size and read_byte(buf, pos) == 0 loop
            pos = pos + 1
        end
        var ai = 0
        when ai < argc and pos < size loop
            when pos < size and read_byte(buf, pos) != 0 loop
                pos = pos + 1
            end
            pos = pos + 1
            ai = ai + 1
        end
        start = pos
    eif plat == 2 or plat == 4 do
        let fd = syscall4(56, -100, "/proc/self/environ" as int, 0, 0)
        if fd >= 0 do
            size = syscall3(63, fd, buf, capacity)
            syscall1(57, fd)
        end
        start = 0
    eif plat == 3 do
        let fd = syscall3(2, "/proc/self/environ" as int, 0, 0)
        if fd >= 0 do
            size = syscall3(0, fd, buf, capacity)
            syscall1(3, fd)
        end
        start = 0
    else
        start = 0
        size = 0
    end

    if size <= 0 or start >= size do
        let fallback_env = alloc(16)
        proc_write_ptr(fallback_env, 0, 0)
        out fallback_env
    end

    let envp = alloc(4096)
    var env_count = 0
    var p = start
    when p < size and env_count < 510 loop
        when p < size and read_byte(buf, p) == 0 loop
            p = p + 1
        end
        if p < size do
            var has_eq = 0
            var q = p
            when q < size and read_byte(buf, q) != 0 loop
                if read_byte(buf, q) == 61 do has_eq = 1 end
                q = q + 1
            end
            if has_eq == 1 do
                proc_write_ptr(envp, env_count * 8, buf + p)
                env_count = env_count + 1
            end
            p = q + 1
        end
    end
    proc_write_ptr(envp, env_count * 8, 0)
    out envp
end.

func proc_wait_timeout(child_pid: int, timeout_ms: int) -> int:
    let st = alloc(8)
    var max_ticks = timeout_ms / 10
    if max_ticks <= 0 do max_ticks = 1 end
    var ticks = 0
    when ticks < max_ticks loop
        let wpid = proc_sys_wait4(child_pid, st, 1) # WNOHANG = 1
        if wpid == child_pid do
            let sig = read_byte(st, 0)
            let code = read_byte(st, 1)
            if sig != 0 do out 128 + sig end
            out code
        eif wpid < 0 do
            out -1
        end
        usleep(10000) # 10ms
        ticks = ticks + 1
    end
    # Watchdog timeout expired: kill child and reap
    kill(child_pid, 9) # SIGKILL
    proc_sys_wait4(child_pid, st, 0)
    out -999
end.

func proc_compile_file_captured:
    in  virc_bin: int
        src_file: int
        out_bin: int
        target: int
        opt_level: int
        is_check: int
        extra_flags: int
        stdout_file: int
        stderr_file: int
        timeout_ms: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if proc_strlen(stdout_file) > 0 do
            let out_fd = proc_sys_open_write(stdout_file)
            if out_fd >= 0 do
                proc_sys_dup2(out_fd, 1)
                proc_sys_close(out_fd)
            end
        end
        if proc_strlen(stderr_file) > 0 do
            let err_fd = proc_sys_open_write(stderr_file)
            if err_fd >= 0 do
                proc_sys_dup2(err_fd, 2)
                proc_sys_close(err_fd)
            end
        end

        let argv = alloc(256)
        var ai = 0
        proc_write_ptr(argv, ai, virc_bin)
        ai = ai + 8

        proc_write_ptr(argv, ai, src_file)
        ai = ai + 8

        if is_check == 1 do
            proc_write_ptr(argv, ai, "--check" as int)
            ai = ai + 8
        else
            proc_write_ptr(argv, ai, "-o" as int)
            ai = ai + 8
            proc_write_ptr(argv, ai, out_bin)
            ai = ai + 8
        end

        if proc_strlen(target) > 0 do
            proc_write_ptr(argv, ai, "--target" as int)
            ai = ai + 8
            proc_write_ptr(argv, ai, target)
            ai = ai + 8
        end

        if proc_strlen(opt_level) > 0 do
            proc_write_ptr(argv, ai, opt_level)
            ai = ai + 8
        end

        if proc_strlen(extra_flags) > 0 do
            let eptr = extra_flags
            let elen = proc_strlen(extra_flags)
            var ep = 0
            when ep < elen loop
                when ep < elen and (read_byte(eptr, ep) == 32 or read_byte(eptr, ep) == 9) loop
                    ep = ep + 1
                end
                if ep < elen do
                    let token_start = ep
                    when ep < elen and read_byte(eptr, ep) != 32 and read_byte(eptr, ep) != 9 loop
                        ep = ep + 1
                    end
                    let tlen = ep - token_start
                    let token = alloc(tlen + 1)
                    var ti = 0
                    when ti < tlen loop
                        write_byte(token, ti, read_byte(eptr, token_start + ti))
                        ti = ti + 1
                    end
                    write_byte(token, tlen, 0)
                    proc_write_ptr(argv, ai, token)
                    ai = ai + 8
                end
            end
        end

        proc_write_ptr(argv, ai, 0)

        let envp = proc_build_envp()
        proc_sys_execve(virc_bin, argv, envp)
        exit_prog(127)
    end

    out proc_wait_timeout(child_pid, timeout_ms)
end.

func proc_run_binary_captured:
    in  bin_path: int
        stdout_file: int
        stderr_file: int
        timeout_ms: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if proc_strlen(stdout_file) > 0 do
            let out_fd = proc_sys_open_write(stdout_file)
            if out_fd >= 0 do
                proc_sys_dup2(out_fd, 1)
                proc_sys_close(out_fd)
            end
        end
        if proc_strlen(stderr_file) > 0 do
            let err_fd = proc_sys_open_write(stderr_file)
            if err_fd >= 0 do
                proc_sys_dup2(err_fd, 2)
                proc_sys_close(err_fd)
            end
        end

        let argv = alloc(32)
        proc_write_ptr(argv, 0, bin_path)
        proc_write_ptr(argv, 8, 0)

        let envp = proc_build_envp()
        proc_sys_execve(bin_path, argv, envp)
        exit_prog(127)
    end

    out proc_wait_timeout(child_pid, timeout_ms)
end.

func proc_run_cmd5_captured:
    in  bin_path: int
        arg1: int
        arg2: int
        arg3: int
        arg4: int
        stdout_file: int
        stderr_file: int
        timeout_ms: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if proc_strlen(stdout_file) > 0 do
            let out_fd = proc_sys_open_write(stdout_file)
            if out_fd >= 0 do
                proc_sys_dup2(out_fd, 1)
                proc_sys_close(out_fd)
            end
        end
        if proc_strlen(stderr_file) > 0 do
            let err_fd = proc_sys_open_write(stderr_file)
            if err_fd >= 0 do
                proc_sys_dup2(err_fd, 2)
                proc_sys_close(err_fd)
            end
        end

        let argv = alloc(128)
        var ai = 0
        proc_write_ptr(argv, ai, bin_path)
        ai = ai + 8
        if proc_strlen(arg1) > 0 do
            proc_write_ptr(argv, ai, arg1)
            ai = ai + 8
        end
        if proc_strlen(arg2) > 0 do
            proc_write_ptr(argv, ai, arg2)
            ai = ai + 8
        end
        if proc_strlen(arg3) > 0 do
            proc_write_ptr(argv, ai, arg3)
            ai = ai + 8
        end
        if proc_strlen(arg4) > 0 do
            proc_write_ptr(argv, ai, arg4)
            ai = ai + 8
        end
        proc_write_ptr(argv, ai, 0)

        let envp = proc_build_envp()
        proc_sys_execve(bin_path, argv, envp)
        exit_prog(127)
    end

    out proc_wait_timeout(child_pid, timeout_ms)
end.

func proc_compile_asm_captured:
    in  virc_bin: int
        src_file: int
        out_asm: int
        target: int
        opt_level: int
        is_quiet: int
        stdout_file: int
        stderr_file: int
        timeout_ms: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if proc_strlen(stdout_file) > 0 do
            let out_fd = proc_sys_open_write(stdout_file)
            if out_fd >= 0 do
                proc_sys_dup2(out_fd, 1)
                proc_sys_close(out_fd)
            end
        end
        if proc_strlen(stderr_file) > 0 do
            let err_fd = proc_sys_open_write(stderr_file)
            if err_fd >= 0 do
                proc_sys_dup2(err_fd, 2)
                proc_sys_close(err_fd)
            end
        end

        let argv = alloc(256)
        var ai = 0
        proc_write_ptr(argv, ai, virc_bin)
        ai = ai + 8

        proc_write_ptr(argv, ai, src_file)
        ai = ai + 8

        proc_write_ptr(argv, ai, "-S" as int)
        ai = ai + 8

        proc_write_ptr(argv, ai, "-o" as int)
        ai = ai + 8
        proc_write_ptr(argv, ai, out_asm)
        ai = ai + 8

        if proc_strlen(target) > 0 do
            proc_write_ptr(argv, ai, "--target" as int)
            ai = ai + 8
            proc_write_ptr(argv, ai, target)
            ai = ai + 8
        end

        if proc_strlen(opt_level) > 0 do
            proc_write_ptr(argv, ai, opt_level)
            ai = ai + 8
        end

        if is_quiet == 1 do
            proc_write_ptr(argv, ai, "-q" as int)
            ai = ai + 8
        end

        proc_write_ptr(argv, ai, 0)

        let envp = proc_build_envp()
        proc_sys_execve(virc_bin, argv, envp)
        exit_prog(127)
    end

    out proc_wait_timeout(child_pid, timeout_ms)
end.

export proc_strlen, proc_int_to_str, proc_str_concat2, proc_str_concat3, proc_str_concat4, proc_str_contains, proc_str_trim, proc_sys_getpid, proc_unlink, proc_mkdir, proc_rmdir, proc_file_exists, proc_read_file, proc_write_file, proc_find_node, proc_wait_timeout, proc_compile_file_captured, proc_run_binary_captured, proc_run_cmd5_captured, proc_compile_asm_captured
