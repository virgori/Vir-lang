# ═════════════════════════════════════════════════════════════════════
# vir_test.reporter — Formatted Console Reporting & Contract Summaries
# ═════════════════════════════════════════════════════════════════════

extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func vir_get_platform() -> int
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, v: int)

entity ResultRecord:
    test_id: int,
    kind: int,
    status: int
end.

func rep_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func rep_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = rep_strlen(a)
    let lb = rep_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func rep_print(s: int):
    if s == 0 do out end
    let len = rep_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 4 do
            syscall3(64, 1, s, len)
        eif plat == 3 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func rep_print_int(n: int):
    if n == 0 do
        rep_print("0" as int)
        out
    end
    var v = n
    if v < 0 do
        rep_print("-" as int)
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    var i = dlen - 1
    let ch = alloc(2)
    write_byte(ch, 1, 0)
    when i >= 0 loop
        write_byte(ch, 0, read_byte(digits, i))
        rep_print(ch)
        i = i - 1
    end
end.

func rep_print_header:
    in  manifest: int
        virc_bin: int
        target: int
        opt_level: int
        total_tests: int
    rep_print("==================================================\n" as int)
    rep_print("  Vir Spec Gap Contract Runner (Native Vir)\n" as int)
    rep_print("  Manifest : " as int)
    rep_print(manifest)
    rep_print("\n  Compiler : " as int)
    rep_print(virc_bin)
    rep_print("\n  Target   : " as int)
    rep_print(target)
    if rep_strlen(opt_level) > 0 do
        rep_print("\n  OptLevel : " as int)
        rep_print(opt_level)
    end
    rep_print("\n  Total    : " as int)
    rep_print_int(total_tests)
    rep_print(" tests\n==================================================\n\n" as int)
end.

func rep_print_test_row:
    in  idx: int
        total: int
        test_id: int
        kind: int
        status: int
        reason: int
    rep_print("[" as int)
    if idx < 10 do rep_print("0" as int) end
    rep_print_int(idx)
    rep_print("/" as int)
    if total < 10 do rep_print("0" as int) end
    rep_print_int(total)
    rep_print("] " as int)

    rep_print(test_id)
    var id_pad = 16 - rep_strlen(test_id)
    when id_pad > 0 loop
        rep_print(" " as int)
        id_pad = id_pad - 1
    end

    rep_print("[" as int)
    rep_print(kind)
    var k_pad = 14 - rep_strlen(kind)
    when k_pad > 0 loop
        rep_print(" " as int)
        k_pad = k_pad - 1
    end
    rep_print("] " as int)

    let esc = alloc(2)
    write_byte(esc, 0, 27)
    write_byte(esc, 1, 0)

    if rep_streq(status, "PASS" as int) == 1 do
        rep_print(esc)
        rep_print("[92mPASS" as int)
        rep_print(esc)
        rep_print("[0m" as int)
    eif rep_streq(status, "BLOCKED" as int) == 1 do
        rep_print(esc)
        rep_print("[93mBLOCKED" as int)
        rep_print(esc)
        rep_print("[0m" as int)
    else
        rep_print(esc)
        rep_print("[91mFAIL" as int)
        rep_print(esc)
        rep_print("[0m" as int)
    end

    rep_print(" : " as int)
    rep_print(reason)
    rep_print("\n" as int)
end.

func rep_print_verbose_fail:
    in  compile_exit: int
        run_exit: int
        stdout_content: int
        stderr_content: int
    if compile_exit != 0 do
        rep_print("    Compile Error (exit " as int)
        rep_print_int(compile_exit)
        rep_print("):\n" as int)
        if rep_strlen(stdout_content) > 0 do
            rep_print("      " as int)
            rep_print(stdout_content)
            rep_print("\n" as int)
        end
        if rep_strlen(stderr_content) > 0 do
            rep_print("      " as int)
            rep_print(stderr_content)
            rep_print("\n" as int)
        end
    eif run_exit != 0 do
        rep_print("    Run Output (exit " as int)
        rep_print_int(run_exit)
        rep_print("):\n" as int)
        if rep_strlen(stdout_content) > 0 do
            rep_print("      " as int)
            rep_print(stdout_content)
            rep_print("\n" as int)
        end
        if rep_strlen(stderr_content) > 0 do
            rep_print("      " as int)
            rep_print(stderr_content)
            rep_print("\n" as int)
        end
    end
end.

func rep_print_summary:
    in  pass_cnt: int
        fail_cnt: int
        blocked_cnt: int
        total_cnt: int
    rep_print("\nSummary:\n" as int)
    rep_print("  PASS    : " as int)
    rep_print_int(pass_cnt)
    rep_print("\n  FAIL    : " as int)
    rep_print_int(fail_cnt)
    rep_print("\n  BLOCKED : " as int)
    rep_print_int(blocked_cnt)
    rep_print("\n  TOTAL   : " as int)
    rep_print_int(total_cnt)
    rep_print("\n\n" as int)
end.

func rep_save_baseline:
    in  path: int
        records_arr: int
        count: int
    let buf_cap = 65536
    let buf = alloc(buf_cap)
    var bp = 0

    let header = "# id\tkind\tstatus\n" as int
    let hlen = rep_strlen(header)
    var hi = 0
    when hi < hlen loop
        write_byte(buf, bp, read_byte(header, hi))
        bp = bp + 1
        hi = hi + 1
    end

    var i = 0
    when i < count loop
        let rec = native_read_i64(records_arr, i * 8) as ResultRecord
        let id_len = rep_strlen(rec.test_id)
        let k_len = rep_strlen(rec.kind)
        let s_len = rep_strlen(rec.status)

        var j = 0
        when j < id_len loop
            write_byte(buf, bp, read_byte(rec.test_id, j))
            bp = bp + 1
            j = j + 1
        end
        write_byte(buf, bp, 9)
        bp = bp + 1

        j = 0
        when j < k_len loop
            write_byte(buf, bp, read_byte(rec.kind, j))
            bp = bp + 1
            j = j + 1
        end
        write_byte(buf, bp, 9)
        bp = bp + 1

        j = 0
        when j < s_len loop
            write_byte(buf, bp, read_byte(rec.status, j))
            bp = bp + 1
            j = j + 1
        end
        write_byte(buf, bp, 10)
        bp = bp + 1

        i = i + 1
    end
    write_byte(buf, bp, 0)
    proc_write_file(path, buf)
    rep_print("\nBaseline saved to: " as int)
    rep_print(path)
    rep_print("\n" as int)
end.

func rep_check_baseline:
    in  baseline_path: int
        records_arr: int
        count: int
    let content = proc_read_file(baseline_path)
    if rep_strlen(content) <= 0 do
        rep_print("\nBaseline check: FAIL\n  - baseline does not exist: " as int)
        rep_print(baseline_path)
        rep_print("\n" as int)
        out 0
    end

    let clen = rep_strlen(content)

    # Allocate baseline records array (up to 4096 records)
    let b_records = alloc(32768)
    var b_count = 0
    var line_num = 0
    var pos = 0

    when pos < clen loop
        var line_end = pos
        when line_end < clen and read_byte(content, line_end) != 10 and read_byte(content, line_end) != 13 loop
            line_end = line_end + 1
        end
        line_num = line_num + 1

        var line_start = pos
        when line_start < line_end and (read_byte(content, line_start) == 32 or read_byte(content, line_start) == 9) loop
            line_start = line_start + 1
        end

        if line_start < line_end and read_byte(content, line_start) != 35 do # '#'
            var c0_end = line_start
            when c0_end < line_end and read_byte(content, c0_end) != 9 loop
                c0_end = c0_end + 1
            end

            if c0_end >= line_end do
                rep_print("\nBaseline check: FAIL\n  - invalid baseline row " as int)
                rep_print_int(line_num)
                rep_print(": expected at least 3 fields\n" as int)
                out 0
            end

            let b_id = alloc(c0_end - line_start + 1)
            var k = 0
            when k < c0_end - line_start loop
                write_byte(b_id, k, read_byte(content, line_start + k))
                k = k + 1
            end
            write_byte(b_id, k, 0)

            var c1_start = c0_end + 1
            var c1_end = c1_start
            when c1_end < line_end and read_byte(content, c1_end) != 9 loop
                c1_end = c1_end + 1
            end

            if c1_end >= line_end do
                rep_print("\nBaseline check: FAIL\n  - invalid baseline row " as int)
                rep_print_int(line_num)
                rep_print(": expected at least 3 fields\n" as int)
                out 0
            end

            let b_kind = alloc(c1_end - c1_start + 1)
            k = 0
            when k < c1_end - c1_start loop
                write_byte(b_kind, k, read_byte(content, c1_start + k))
                k = k + 1
            end
            write_byte(b_kind, k, 0)

            # Fix for Point 4: only take characters up to next tab (\t) as status, ignoring 4th+ columns!
            var c2_start = c1_end + 1
            var c2_end = c2_start
            when c2_end < line_end and read_byte(content, c2_end) != 9 loop
                c2_end = c2_end + 1
            end
            let b_status = alloc(c2_end - c2_start + 1)
            k = 0
            when k < c2_end - c2_start loop
                write_byte(b_status, k, read_byte(content, c2_start + k))
                k = k + 1
            end
            write_byte(b_status, k, 0)

            # Check duplicate baseline ID
            var bi = 0
            var is_dup = 0
            when bi < b_count and is_dup == 0 loop
                let prev_b = native_read_i64(b_records, bi * 8) as ResultRecord
                if rep_streq(prev_b.test_id, b_id) == 1 do
                    is_dup = 1
                end
                bi = bi + 1
            end

            if is_dup == 1 do
                rep_print("\nBaseline check: FAIL\n  - duplicate baseline id at row " as int)
                rep_print_int(line_num)
                rep_print(": " as int)
                rep_print(b_id)
                rep_print("\n" as int)
                out 0
            end

            let b_rec = ResultRecord(test_id: b_id, kind: b_kind, status: b_status)
            native_write_i64(b_records, b_count * 8, b_rec as int)
            b_count = b_count + 1
        end

        pos = line_end + 1
        if pos < clen and read_byte(content, pos - 1) == 13 and read_byte(content, pos) == 10 do
            pos = pos + 1
        end
    end

    var all_ok = 1

    # 1. Missing current results
    var bi = 0
    when bi < b_count loop
        let b_rec = native_read_i64(b_records, bi * 8) as ResultRecord
        var in_cur = 0
        var ci = 0
        when ci < count and in_cur == 0 loop
            let c_rec = native_read_i64(records_arr, ci * 8) as ResultRecord
            if rep_streq(b_rec.test_id, c_rec.test_id) == 1 do
                in_cur = 1
            end
            ci = ci + 1
        end

        if in_cur == 0 do
            if all_ok == 1 do
                rep_print("\nBaseline check: FAIL\n" as int)
                all_ok = 0
            end
            rep_print("  - missing current result: " as int)
            rep_print(b_rec.test_id)
            rep_print("\n" as int)
        end
        bi = bi + 1
    end

    # 2. New results absent from baseline
    var ci = 0
    when ci < count loop
        let c_rec = native_read_i64(records_arr, ci * 8) as ResultRecord
        var in_base = 0
        var bj = 0
        when bj < b_count and in_base == 0 loop
            let b_rec = native_read_i64(b_records, bj * 8) as ResultRecord
            if rep_streq(c_rec.test_id, b_rec.test_id) == 1 do
                in_base = 1
            end
            bj = bj + 1
        end

        if in_base == 0 do
            if all_ok == 1 do
                rep_print("\nBaseline check: FAIL\n" as int)
                all_ok = 0
            end
            rep_print("  - new result absent from baseline: " as int)
            rep_print(c_rec.test_id)
            rep_print("\n" as int)
        end
        ci = ci + 1
    end

    # 3. Check mismatches for matched IDs
    bi = 0
    when bi < b_count loop
        let b_rec = native_read_i64(b_records, bi * 8) as ResultRecord
        var cj = 0
        when cj < count loop
            let c_rec = native_read_i64(records_arr, cj * 8) as ResultRecord
            if rep_streq(b_rec.test_id, c_rec.test_id) == 1 do
                if rep_streq(b_rec.kind, c_rec.kind) == 0 or rep_streq(b_rec.status, c_rec.status) == 0 do
                    if all_ok == 1 do
                        rep_print("\nBaseline check: FAIL\n" as int)
                        all_ok = 0
                    end
                    rep_print("  - " as int)
                    rep_print(c_rec.test_id)
                    rep_print(": expected kind/status " as int)
                    rep_print(b_rec.kind)
                    rep_print("/" as int)
                    rep_print(b_rec.status)
                    rep_print(", got " as int)
                    rep_print(c_rec.kind)
                    rep_print("/" as int)
                    rep_print(c_rec.status)
                    rep_print("\n" as int)
                end
                cj = count
            else
                cj = cj + 1
            end
        end
        bi = bi + 1
    end

    if all_ok == 1 do
        rep_print("\nBaseline check: PASS (" as int)
        rep_print_int(count)
        rep_print(" unchanged results)\n" as int)
        out 1
    else
        out 0
    end
end.

export ResultRecord, rep_strlen, rep_streq, rep_print, rep_print_int, rep_print_header, rep_print_test_row, rep_print_verbose_fail, rep_print_summary, rep_save_baseline, rep_check_baseline
