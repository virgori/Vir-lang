# ═════════════════════════════════════════════════════════════════════
# vir_test.oracle — Test Oracle Evaluator & Diagnostic Matcher
# ═════════════════════════════════════════════════════════════════════

func orac_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func orac_to_lower(b: int) -> int:
    if b >= 65 and b <= 90 do
        out b + 32
    end
    out b
end.

func orac_contains_ignore_case(haystack: int, needle: int) -> int:
    if needle == 0 do out 1 end
    let nlen = orac_strlen(needle)
    if nlen == 0 do out 1 end
    if haystack == 0 do out 0 end
    let hlen = orac_strlen(haystack)
    if hlen < nlen do out 0 end

    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            let hb = orac_to_lower(read_byte(haystack, i + j))
            let nb = orac_to_lower(read_byte(needle, j))
            if hb != nb do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func orac_sub_str(src: int, start: int, len: int) -> int:
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(len + 1)
    var i = 0
    when i < len loop
        write_byte(res, i, read_byte(src, start + i))
        i = i + 1
    end
    write_byte(res, len, 0)
    out res
end.

func orac_trim(s: int) -> int:
    let len = orac_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    if end_pos <= start do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    out orac_sub_str(s, start, end_pos - start)
end.

func oracle_check_compile_fail(oracle: int, output: int) -> int:
    let olen = orac_strlen(oracle)
    if olen == 0 do
        if orac_contains_ignore_case(output, "error" as int) == 1 or orac_contains_ignore_case(output, "e1" as int) == 1 or orac_contains_ignore_case(output, "e2" as int) == 1 do
            out 1
        end
        out 0
    end

    # Look for "diagnostic contains "
    var p = 0
    var spec_start = -1
    when p + 20 < olen loop
        if orac_contains_ignore_case(orac_sub_str(oracle, p, 20), "diagnostic contains " as int) == 1 do
            spec_start = p + 20
            p = olen
        end
        p = p + 1
    end

    if spec_start >= 0 do
        var spec_end = olen
        var k = spec_start
        when k < olen loop
            if read_byte(oracle, k) == 59 do # ';'
                spec_end = k
                k = olen
            end
            k = k + 1
        end

        let spec_str = orac_trim(orac_sub_str(oracle, spec_start, spec_end - spec_start))
        let slen = orac_strlen(spec_str)
        if slen == 0 do out 1 end

        # Parse terms separated by " and "
        var term_start = 0
        var ti = 0
        when ti <= slen loop
            var is_sep = 0
            if ti + 5 <= slen and read_byte(spec_str, ti) == 32 and read_byte(spec_str, ti + 1) == 97 and read_byte(spec_str, ti + 2) == 110 and read_byte(spec_str, ti + 3) == 100 and read_byte(spec_str, ti + 4) == 32 do
                is_sep = 1
            eif ti == slen do
                is_sep = 1
            end

            if is_sep == 1 do
                let term = orac_trim(orac_sub_str(spec_str, term_start, ti - term_start))
                let tlen = orac_strlen(term)
                if tlen > 0 do
                    var slash_pos = -1
                    var si = 0
                    when si < tlen loop
                        if read_byte(term, si) == 47 do
                            slash_pos = si
                            si = tlen
                        end
                        si = si + 1
                    end

                    if slash_pos >= 0 do
                        let sub1 = orac_trim(orac_sub_str(term, 0, slash_pos))
                        let sub2 = orac_trim(orac_sub_str(term, slash_pos + 1, tlen - slash_pos - 1))
                        if orac_contains_ignore_case(output, sub1) == 0 and orac_contains_ignore_case(output, sub2) == 0 do
                            out 0
                        end
                    else
                        if orac_contains_ignore_case(output, term) == 0 do
                            out 0
                        end
                    end
                end

                if ti < slen do
                    term_start = ti + 5
                    ti = ti + 4
                end
            end
            ti = ti + 1
        end

        out 1
    end

    if orac_contains_ignore_case(oracle, "parser diagnostic" as int) == 1 do
        if orac_contains_ignore_case(output, "e1004" as int) == 1 or orac_contains_ignore_case(output, "parse" as int) == 1 or orac_contains_ignore_case(output, "syntax" as int) == 1 or orac_contains_ignore_case(output, "error" as int) == 1 do
            out 1
        end
        out 0
    end

    if orac_contains_ignore_case(output, "error" as int) == 1 or orac_contains_ignore_case(output, "e1" as int) == 1 or orac_contains_ignore_case(output, "e2" as int) == 1 or orac_contains_ignore_case(output, "e3" as int) == 1 do
        out 1
    end

    out 0
end.

func orac_unescape_newlines(s: int) -> int:
    let len = orac_strlen(s)
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let buf = alloc(len + 1)
    var bi = 0
    var i = 0
    when i < len loop
        if i + 1 < len and read_byte(s, i) == 92 and read_byte(s, i + 1) == 110 do
            write_byte(buf, bi, 10)
            bi = bi + 1
            i = i + 2
        else
            write_byte(buf, bi, read_byte(s, i))
            bi = bi + 1
            i = i + 1
        end
    end
    write_byte(buf, bi, 0)
    out buf
end.

func oracle_check_stdout(oracle: int, fixture_expected: int, actual_stdout: int) -> int:
    var expected = 0
    let olen = orac_strlen(oracle)

    if olen >= 7 and read_byte(oracle, 0) == 115 and read_byte(oracle, 1) == 116 and read_byte(oracle, 2) == 100 and read_byte(oracle, 3) == 111 and read_byte(oracle, 4) == 117 and read_byte(oracle, 5) == 116 and read_byte(oracle, 6) == 61 do
        var end_pos = olen
        var k = 7
        when k < olen loop
            if read_byte(oracle, k) == 59 do # ';'
                end_pos = k
                k = olen
            end
            k = k + 1
        end
        expected = orac_unescape_newlines(orac_trim(orac_sub_str(oracle, 7, end_pos - 7)))
    eif orac_strlen(fixture_expected) > 0 do
        expected = orac_trim(fixture_expected)
    end

    if orac_strlen(expected) == 0 do
        out 1
    end

    let act_trimmed = orac_trim(actual_stdout)
    let elen = orac_strlen(expected)
    let alen = orac_strlen(act_trimmed)
    if elen != alen do out 0 end

    var i = 0
    when i < elen loop
        if read_byte(expected, i) != read_byte(act_trimmed, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func oracle_extract_expected_exit(oracle: int) -> int:
    let olen = orac_strlen(oracle)
    if olen < 5 do out -9999 end
    var p = 0
    var num_start = -1
    when p + 5 <= olen loop
        if read_byte(oracle, p) == 101 and read_byte(oracle, p + 1) == 120 and read_byte(oracle, p + 2) == 105 and read_byte(oracle, p + 3) == 116 and (read_byte(oracle, p + 4) == 32 or read_byte(oracle, p + 4) == 61) do
            var q = p + 5
            when q < olen and read_byte(oracle, q) == 32 loop
                q = q + 1
            end
            if q < olen do
                num_start = q
                p = olen
            end
        end
        p = p + 1
    end
    if num_start < 0 do out -9999 end
    var is_neg = 0
    var cur = num_start
    if read_byte(oracle, cur) == 45 do
        is_neg = 1
        cur = cur + 1
    end
    var val = 0
    var digit_count = 0
    when cur < olen loop
        let b = read_byte(oracle, cur)
        if b >= 48 and b <= 57 do
            val = val * 10 + (b - 48)
            digit_count = digit_count + 1
            cur = cur + 1
        else
            cur = olen
        end
    end
    if digit_count == 0 do out -9999 end
    if is_neg == 1 do out 0 - val end
    out val
end.

func oracle_check_exit_code(expected: int, actual: int) -> int:
    if actual == -999 do out 0 end
    if expected == -9999 do
        if actual != 0 and actual != 127 and actual != -999 do out 1 end
        out 0
    end
    if actual == expected do out 1 end
    if expected > 128 and actual == 0 - (expected - 128) do out 1 end
    if expected < 0 and actual == 128 + (0 - expected) do out 1 end
    out 0
end.

func orac_index_of(haystack: int, needle: int, start_pos: int) -> int:
    let hlen = orac_strlen(haystack)
    let nlen = orac_strlen(needle)
    if nlen == 0 do out start_pos end
    if hlen < nlen or start_pos + nlen > hlen do out 0 - 1 end
    var i = start_pos
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func orac_streq(a: int, b: int) -> int:
    let
        a_len = orac_strlen(a)
        b_len = orac_strlen(b)
    if a_len != b_len do out 0 end

    var i = 0
    when i < a_len loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func orac_extract_function_body(asm_content: int, primary_label: int, fallback_label: int) -> int:
    var start = orac_index_of(asm_content, primary_label, 0)
    if start < 0 do
        start = orac_index_of(asm_content, fallback_label, 0)
    end
    if start < 0 do
        out orac_sub_str(asm_content, 0, 0)
    end

    let content_len = orac_strlen(asm_content)
    var finish = orac_index_of(asm_content, "\n.globl" as int, start + 1)
    if finish < 0 do
        finish = orac_index_of(asm_content, "\n.global" as int, start + 1)
    end
    if finish < 0 do
        finish = content_len
    end
    out orac_trim(orac_sub_str(asm_content, start, finish - start))
end.

func oracle_check_ffi003_noopt(asm_o0: int, asm_o1: int, asm_o2: int, asm_o3: int) -> int:
    let
        exact_o0 = orac_extract_function_body(asm_o0, "_exact_sequence:" as int, "exact_sequence:" as int)
        exact_o1 = orac_extract_function_body(asm_o1, "_exact_sequence:" as int, "exact_sequence:" as int)
        exact_o2 = orac_extract_function_body(asm_o2, "_exact_sequence:" as int, "exact_sequence:" as int)
        exact_o3 = orac_extract_function_body(asm_o3, "_exact_sequence:" as int, "exact_sequence:" as int)
        control_o0 = orac_extract_function_body(asm_o0, "_optimized_control:" as int, "optimized_control:" as int)
        control_o3 = orac_extract_function_body(asm_o3, "_optimized_control:" as int, "optimized_control:" as int)

    if orac_strlen(exact_o0) == 0 or orac_strlen(exact_o1) == 0 or orac_strlen(exact_o2) == 0 or orac_strlen(exact_o3) == 0 do
        out 0
    end
    if orac_streq(exact_o0, exact_o1) == 0 or orac_streq(exact_o0, exact_o2) == 0 or orac_streq(exact_o0, exact_o3) == 0 do
        out 0
    end
    if orac_strlen(control_o0) == 0 do out 0 end
    if orac_streq(control_o0, control_o3) == 1 do out 0 end
    out 1
end.

func oracle_check_structural_free(asm_content: int) -> int:
    var main_idx = orac_index_of(asm_content, "_main:" as int, 0)
    if main_idx < 0 do
        main_idx = orac_index_of(asm_content, "main:" as int, 0)
    end
    if main_idx < 0 do out 0 end

    let clen = orac_strlen(asm_content)
    var body_end = clen
    var pos = main_idx + 6
    when pos < clen loop
        if read_byte(asm_content, pos) == 10 do
            let next_b = read_byte(asm_content, pos + 1)
            if next_b == 46 or next_b == 47 or next_b == 95 do
                body_end = pos
                pos = clen
            end
        end
        pos = pos + 1
    end
    let main_body = orac_sub_str(asm_content, main_idx, body_end - main_idx)

    if orac_contains_ignore_case(main_body, "bl _vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "bl vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "bl _heap_free" as int) == 1 or orac_contains_ignore_case(main_body, "bl heap_free" as int) == 1 do
        out 1
    end
    if orac_contains_ignore_case(main_body, "call _vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "call vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "call _heap_free" as int) == 1 or orac_contains_ignore_case(main_body, "call heap_free" as int) == 1 do
        out 1
    end
    if orac_contains_ignore_case(main_body, "jal _vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "jal vir_free" as int) == 1 or orac_contains_ignore_case(main_body, "jal _heap_free" as int) == 1 or orac_contains_ignore_case(main_body, "jal heap_free" as int) == 1 do
        out 1
    end
    out 0
end.

func oracle_check_ffi008_arm(asm_content: int) -> int:
    if orac_contains_ignore_case(asm_content, "fmov d0," as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "bl fabs" as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "bl ldexp" as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "fmov x0, d0" as int) == 0 do out 0 end

    let p1 = orac_index_of(asm_content, "fmov d0," as int, 0)
    if p1 < 0 do out 0 end
    var p2 = orac_index_of(asm_content, "mov x0, #3" as int, p1)
    if p2 < 0 do p2 = orac_index_of(asm_content, "movz x0, #3" as int, p1) end
    if p2 < 0 do p2 = orac_index_of(asm_content, "mov x0, 3" as int, p1) end
    if p2 < 0 do p2 = orac_index_of(asm_content, "movz x0, 3" as int, p1) end
    if p2 < 0 do out 0 end
    let p3 = orac_index_of(asm_content, "bl ldexp" as int, p2)
    if p3 < 0 do out 0 end
    out 1
end.

func oracle_check_ffi008_x86(asm_content: int) -> int:
    if orac_contains_ignore_case(asm_content, "movq xmm0," as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "call fabs" as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "call ldexp" as int) == 0 do out 0 end
    if orac_contains_ignore_case(asm_content, "movq rax, xmm0" as int) == 0 do out 0 end

    let p1 = orac_index_of(asm_content, "movq xmm0," as int, 0)
    if p1 < 0 do out 0 end
    var p2 = orac_index_of(asm_content, "mov rdi, 3" as int, p1)
    if p2 < 0 do p2 = orac_index_of(asm_content, "mov $3, %edi" as int, p1) end
    if p2 < 0 do p2 = orac_index_of(asm_content, "movq $3, %rdi" as int, p1) end
    if p2 < 0 do out 0 end
    let p3 = orac_index_of(asm_content, "call ldexp" as int, p2)
    if p3 < 0 do out 0 end
    out 1
end.

export orac_strlen, orac_sub_str, orac_trim, orac_contains_ignore_case, orac_index_of, oracle_check_compile_fail, oracle_check_stdout, oracle_extract_expected_exit, oracle_check_exit_code, oracle_check_structural_free, oracle_check_ffi003_noopt, oracle_check_ffi008_arm, oracle_check_ffi008_x86
