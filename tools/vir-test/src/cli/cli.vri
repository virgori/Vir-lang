# ═════════════════════════════════════════════════════════════════════
# vir_test.cli — CLI Argument Parsing for Native Contract Runner
# ═════════════════════════════════════════════════════════════════════

include virgex

extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func vir_get_platform() -> int
extern func exit_prog(code: int)

entity TestConfig:
    manifest_path: int,
    fixtures_dir: int,
    virc_bin: int,
    target: int,
    filter: int,
    group: int,
    verbose: int,
    opt_level: int,
    test_timeout: int,
    compile_timeout: int,
    check_baseline: int,
    save_baseline: int,
    has_filter: int
end.

func cli_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cli_to_lower(b: int) -> int:
    if b >= 65 and b <= 90 do out b + 32 end
    out b
end.

func cli_to_upper_str(s: int) -> int:
    let len = cli_strlen(s)
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let buf = alloc(len + 1)
    var i = 0
    when i < len loop
        let b = read_byte(s, i)
        if b >= 97 and b <= 122 do
            write_byte(buf, i, b - 32)
        else
            write_byte(buf, i, b)
        end
        i = i + 1
    end
    write_byte(buf, len, 0)
    out buf
end.

func cli_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = cli_strlen(a)
    let lb = cli_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func cli_streq_ci(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = cli_strlen(a)
    let lb = cli_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if cli_to_lower(read_byte(a, i)) != cli_to_lower(read_byte(b, i)) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func cli_starts_with(s: int, prefix: int) -> int:
    if prefix == 0 do out 1 end
    let plen = cli_strlen(prefix)
    if plen == 0 do out 1 end
    if s == 0 do out 0 end
    let slen = cli_strlen(s)
    if slen < plen do out 0 end
    var i = 0
    when i < plen loop
        if read_byte(s, i) != read_byte(prefix, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func cli_starts_with_ci(s: int, prefix: int) -> int:
    if prefix == 0 do out 1 end
    let plen = cli_strlen(prefix)
    if plen == 0 do out 1 end
    if s == 0 do out 0 end
    let slen = cli_strlen(s)
    if slen < plen do out 0 end
    var i = 0
    when i < plen loop
        let sb = cli_to_lower(read_byte(s, i))
        let pb = cli_to_lower(read_byte(prefix, i))
        if sb != pb do out 0 end
        i = i + 1
    end
    out 1
end.

func cli_contains_ignore_case(haystack: int, needle: int) -> int:
    if needle == 0 do out 1 end
    let nlen = cli_strlen(needle)
    if nlen == 0 do out 1 end
    if haystack == 0 do out 0 end
    let hlen = cli_strlen(haystack)
    if hlen < nlen do out 0 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            let hb = cli_to_lower(read_byte(haystack, i + j))
            let nb = cli_to_lower(read_byte(needle, j))
            if hb != nb do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func cli_print_out(s: int):
    let len = cli_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 4 do
            syscall3(64, 1, s, len)
        eif plat == 3 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func cli_print_help():
    let msg = "usage: gap_contract_runner.py [-h] [--manifest MANIFEST] [--fixtures FIXTURES]\n                              [--virc VIRC] [--target TARGET]\n                              [--save-baseline SAVE_BASELINE]\n                              [--check-baseline [CHECK_BASELINE]]\n                              [--filter FILTER] [--group GROUP]\n                              [--timeout TIMEOUT]\n                              [--compile-timeout COMPILE_TIMEOUT]\n                              [--opt-level OPT_LEVEL] [--verbose]\n\nVir Spec Gap Contract Runner\n\noptions:\n  -h, --help            show this help message and exit\n  --manifest MANIFEST   Path to manifest.tsv\n  --fixtures FIXTURES   Fixtures directory\n  --virc VIRC           Path to virc compiler\n  --target TARGET       Target architecture\n  --save-baseline SAVE_BASELINE\n                        Path to save baseline TSV\n  --check-baseline [CHECK_BASELINE]\n                        Compare IDs/kinds/statuses with a baseline TSV\n                        (default: docs/spec_gap_contract_baseline.tsv)\n  --filter FILTER       Virgex pattern filter by test ID (VPS syntax)\n  --group GROUP         Filter by group/phase (e.g. Phase1)\n  --timeout TIMEOUT     Execution timeout in seconds\n  --compile-timeout COMPILE_TIMEOUT\n                        Compilation timeout in seconds (default 30; use 60+\n                        for -O2/-O3)\n  --opt-level OPT_LEVEL\n                        Optimization level flag (-O0, -O1, -O2, -O3)\n  --verbose, -v         Print details for every test\n" as int
    cli_print_out(msg)
    exit_prog(0)
end.

func cli_print_err(s: int):
    let len = cli_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 4 do
            syscall3(64, 2, s, len)
        eif plat == 3 do
            syscall3(1, 2, s, len)
        else
            syscall3(0x2000004, 2, s, len)
        end
    end
end.

func cli_parse_timeout_ms(s: int, default_ms: int) -> int:
    let len = cli_strlen(s)
    if len <= 0 do out default_ms end
    var sec_part = 0
    var frac_part = 0
    var seen_dot = 0
    var frac_digits = 0
    var digit_count = 0
    var i = 0
    when i < len loop
        let b = read_byte(s, i)
        if b == 46 do # '.'
            if seen_dot == 1 do out -1 end # multiple dots -> error
            seen_dot = 1
        eif b >= 48 and b <= 57 do
            digit_count = digit_count + 1
            if seen_dot == 0 do
                sec_part = sec_part * 10 + (b - 48)
            else
                if frac_digits < 3 do
                    frac_part = frac_part * 10 + (b - 48)
                    frac_digits = frac_digits + 1
                end
            end
        else
            out -1 # malformed character (e.g. 'nope')
        end
        i = i + 1
    end
    if digit_count == 0 do out -1 end # e.g. "." alone -> error
    when frac_digits < 3 loop
        frac_part = frac_part * 10
        frac_digits = frac_digits + 1
    end
    let total_ms = sec_part * 1000 + frac_part
    if total_ms < 0 do out -1 end
    out total_ms
end.

# ── Virgex filter matcher (uses official virgex.isMatch API) ──

func cli_filter_matches(test_id: int, group: int, has_filter: int, ref pat: Pattern) -> int:
    if cli_strlen(group) > 0 and cli_streq_ci(group, "phase1" as int) == 1 do
        if cli_starts_with_ci(test_id, "PREC-" as int) == 1 or cli_starts_with_ci(test_id, "NEG-" as int) == 1 or cli_starts_with_ci(test_id, "FLOAT-" as int) == 1 or cli_starts_with_ci(test_id, "CAST-" as int) == 1 do
            if has_filter == 1 do
                if virgex.isMatch(pat, test_id as string) do
                    out 1
                else
                    out 0
                end
            end
            out 1
        end
        out 0
    eif has_filter == 1 do
        if virgex.isMatch(pat, test_id as string) do
            out 1
        else
            out 0
        end
    else
        out 1
    end
end.

func cli_parse_args() -> TestConfig:
    var manifest = "tests/spec_gap_contract/manifest.tsv" as int
    var fixtures = "tests/spec_gap_contract" as int
    var virc = "bin/virc" as int
    var target = "macos-arm64" as int
    var filter = "" as int
    var group = "" as int
    var verbose = 0
    var opt_level = "" as int
    var test_timeout = 5000
    var comp_timeout = 30000
    var check_baseline = 0
    var save_baseline = 0

    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if cli_streq(arg, "--help" as int) == 1 or cli_streq(arg, "-h" as int) == 1 do
            cli_print_help()
        eif cli_streq(arg, "--manifest" as int) == 1 and i + 1 < argc do
            manifest = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--fixtures" as int) == 1 and i + 1 < argc do
            fixtures = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--target" as int) == 1 and i + 1 < argc do
            target = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--filter" as int) == 1 do
            if i + 1 >= argc do
                cli_print_err("gap_contract_runner: error: argument --filter: expected one argument\n" as int)
                exit_prog(2)
            end
            filter = get_arg(i + 1) as int
            if cli_strlen(filter) > 0 do
                let tok_res = vps_tokenize(filter as string)
                if isFailure(tok_res) do
                    cli_print_err("gap_contract_runner: error: argument --filter: invalid Virgex pattern: '" as int)
                    cli_print_err(filter)
                    cli_print_err("'\n" as int)
                    exit_prog(2)
                end
            end
            i = i + 1
        eif cli_streq(arg, "--group" as int) == 1 and i + 1 < argc do
            group = get_arg(i + 1) as int
            i = i + 1
        eif (cli_streq(arg, "--opt" as int) == 1 or cli_streq(arg, "--opt-level" as int) == 1) and i + 1 < argc do
            opt_level = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--timeout" as int) == 1 and i + 1 < argc do
            let to_val = get_arg(i + 1) as int
            let parsed_to = cli_parse_timeout_ms(to_val, 5000)
            if parsed_to < 0 do
                cli_print_err("gap_contract_runner: error: argument --timeout: invalid float value: '" as int)
                cli_print_err(to_val)
                cli_print_err("'\n" as int)
                exit_prog(2)
            end
            test_timeout = parsed_to
            i = i + 1
        eif cli_streq(arg, "--compile-timeout" as int) == 1 and i + 1 < argc do
            let to_val = get_arg(i + 1) as int
            let parsed_to = cli_parse_timeout_ms(to_val, 30000)
            if parsed_to < 0 do
                cli_print_err("gap_contract_runner: error: argument --compile-timeout: invalid float value: '" as int)
                cli_print_err(to_val)
                cli_print_err("'\n" as int)
                exit_prog(2)
            end
            comp_timeout = parsed_to
            i = i + 1
        eif cli_streq(arg, "--check-baseline" as int) == 1 or cli_streq(arg, "--baseline" as int) == 1 do
            if i + 1 < argc do
                let next_arg = get_arg(i + 1) as int
                if cli_starts_with(next_arg, "--" as int) == 0 do
                    check_baseline = next_arg
                    i = i + 1
                else
                    check_baseline = "docs/spec_gap_contract_baseline.tsv" as int
                end
            else
                check_baseline = "docs/spec_gap_contract_baseline.tsv" as int
            end
        eif cli_streq(arg, "--save-baseline" as int) == 1 and i + 1 < argc do
            save_baseline = get_arg(i + 1) as int
            i = i + 1
        eif cli_streq(arg, "--verbose" as int) == 1 or cli_streq(arg, "-v" as int) == 1 do
            verbose = 1
        else
            if cli_starts_with(arg, "-" as int) == 1 do
                cli_print_err("gap_contract_runner: error: unrecognized arguments: " as int)
                cli_print_err(arg)
                cli_print_err("\n" as int)
                exit_prog(2)
            end
        end
        i = i + 1
    end

    var has_filter = 0
    if cli_strlen(filter) > 0 do
        has_filter = 1
    end

    out TestConfig(
        manifest_path: manifest,
        fixtures_dir: fixtures,
        virc_bin: virc,
        target: target,
        filter: filter,
        group: group,
        verbose: verbose,
        opt_level: opt_level,
        test_timeout: test_timeout,
        compile_timeout: comp_timeout,
        check_baseline: check_baseline,
        save_baseline: save_baseline,
        has_filter: has_filter
    )
end.

export TestConfig, cli_strlen, cli_streq, cli_streq_ci, cli_starts_with, cli_starts_with_ci, cli_contains_ignore_case, cli_parse_timeout_ms, cli_filter_matches, cli_parse_args
