# ═════════════════════════════════════════════════════════════════════
# vir_test.manifest — TSV Manifest Parser & Fixture Comment Extractor
# ═════════════════════════════════════════════════════════════════════

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, v: int)

entity TestRow:
    test_id: int,
    kind: int,
    fixture: int,
    oracle: int
end.

entity ManifestTable:
    rows: int,       # pointer to array of TestRow pointers (alloc(max_rows * 8))
    count: int
end.

func man_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func man_sub_str(src: int, start: int, len: int) -> int:
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(len + 1)
    var i = 0
    when i < len loop
        write_byte(res, i, read_byte(src, start + i))
        i = i + 1
    end
    write_byte(res, len, 0)
    out res
end.

func man_trim(s: int) -> int:
    let len = man_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    if end_pos <= start do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    out man_sub_str(s, start, end_pos - start)
end.

func manifest_parse(content: int) -> ManifestTable:
    let len = man_strlen(content)
    let max_rows = 512
    let rows_arr = alloc(max_rows * 8)
    var count = 0

    if len <= 0 do
        out ManifestTable(rows: rows_arr, count: 0)
    end

    var pos = 0
    when pos < len and count < max_rows loop
        var line_end = pos
        when line_end < len and read_byte(content, line_end) != 10 and read_byte(content, line_end) != 13 loop
            line_end = line_end + 1
        end

        # Skip leading whitespace
        var cur = pos
        when cur < line_end and (read_byte(content, cur) == 32 or read_byte(content, cur) == 9) loop
            cur = cur + 1
        end

        # Check for non-empty, non-comment line
        if cur < line_end and read_byte(content, cur) != 35 do # '#'
            # Parse tab-separated columns
            var col0_start = cur
            var col0_end = col0_start
            when col0_end < line_end and read_byte(content, col0_end) != 9 loop
                col0_end = col0_end + 1
            end

            if col0_end < line_end do
                var col1_start = col0_end + 1
                var col1_end = col1_start
                when col1_end < line_end and read_byte(content, col1_end) != 9 loop
                    col1_end = col1_end + 1
                end

                if col1_end < line_end do
                    var col2_start = col1_end + 1
                    var col2_end = col2_start
                    when col2_end < line_end and read_byte(content, col2_end) != 9 loop
                        col2_end = col2_end + 1
                    end

                    var col3_start = col2_end
                    var col3_end = line_end
                    if col2_end < line_end do
                        col3_start = col2_end + 1
                    end

                    let id_str = man_trim(man_sub_str(content, col0_start, col0_end - col0_start))
                    let kind_str = man_trim(man_sub_str(content, col1_start, col1_end - col1_start))
                    let fixt_str = man_trim(man_sub_str(content, col2_start, col2_end - col2_start))
                    let orac_str = man_trim(man_sub_str(content, col3_start, col3_end - col3_start))

                    if man_strlen(id_str) > 0 and man_strlen(kind_str) > 0 do
                        let row = TestRow(
                            test_id: id_str,
                            kind: kind_str,
                            fixture: fixt_str,
                            oracle: orac_str
                        )
                        native_write_i64(rows_arr, count * 8, row as int)
                        count = count + 1
                    end
                end
            end
        end

        pos = line_end + 1
    end

    out ManifestTable(rows: rows_arr, count: count)
end.

func manifest_get_row(rows_arr: int, count: int, idx: int) -> TestRow:
    if idx < 0 or idx >= count do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out TestRow(test_id: empty, kind: empty, fixture: empty, oracle: empty)
    end
    let r_ptr = native_read_i64(rows_arr, idx * 8)
    out r_ptr as TestRow
end.

func fixture_extract_virc_flags(content: int) -> int:
    let len = man_strlen(content)
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    # Look for "# VIRC_FLAGS:"
    var p = 0
    when p + 13 < len loop
        if read_byte(content, p) == 35 and read_byte(content, p + 1) == 32 and read_byte(content, p + 2) == 86 and read_byte(content, p + 3) == 73 and read_byte(content, p + 4) == 82 and read_byte(content, p + 5) == 67 and read_byte(content, p + 6) == 95 and read_byte(content, p + 7) == 70 and read_byte(content, p + 8) == 76 and read_byte(content, p + 9) == 65 and read_byte(content, p + 10) == 71 and read_byte(content, p + 11) == 83 and read_byte(content, p + 12) == 58 do
            var fs = p + 13
            when fs < len and read_byte(content, fs) == 32 loop
                fs = fs + 1
            end
            var fe = fs
            when fe < len and read_byte(content, fe) != 10 and read_byte(content, fe) != 13 loop
                fe = fe + 1
            end
            out man_trim(man_sub_str(content, fs, fe - fs))
        end
        p = p + 1
    end
    let empty = alloc(1)
    write_byte(empty, 0, 0)
    out empty
end.

func fixture_extract_expected_stdout(content: int) -> int:
    let len = man_strlen(content)
    if len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end

    # Look for "# EXPECT_START"
    var p = 0
    when p + 14 < len loop
        if read_byte(content, p) == 35 and read_byte(content, p + 1) == 32 and read_byte(content, p + 2) == 69 and read_byte(content, p + 3) == 88 and read_byte(content, p + 4) == 80 and read_byte(content, p + 5) == 69 and read_byte(content, p + 6) == 67 and read_byte(content, p + 7) == 84 and read_byte(content, p + 8) == 95 and read_byte(content, p + 9) == 83 and read_byte(content, p + 10) == 84 and read_byte(content, p + 11) == 65 and read_byte(content, p + 12) == 82 and read_byte(content, p + 13) == 84 do
            var start_line = p + 14
            when start_line < len and read_byte(content, start_line) != 10 loop
                start_line = start_line + 1
            end
            start_line = start_line + 1

            # Accumulate lines until "# EXPECT_END"
            var end_pos = start_line
            var res_buf = alloc(4096)
            var res_idx = 0
            when end_pos + 12 < len loop
                if read_byte(content, end_pos) == 35 and read_byte(content, end_pos + 1) == 32 and read_byte(content, end_pos + 2) == 69 and read_byte(content, end_pos + 3) == 88 and read_byte(content, end_pos + 4) == 80 and read_byte(content, end_pos + 5) == 69 and read_byte(content, end_pos + 6) == 67 and read_byte(content, end_pos + 7) == 84 and read_byte(content, end_pos + 8) == 95 and read_byte(content, end_pos + 9) == 69 and read_byte(content, end_pos + 10) == 78 and read_byte(content, end_pos + 11) == 68 do
                    write_byte(res_buf, res_idx, 0)
                    out man_trim(res_buf)
                end

                # Copy line content (stripping leading "# ")
                var cur = end_pos
                if read_byte(content, cur) == 35 do
                    cur = cur + 1
                    if read_byte(content, cur) == 32 do
                        cur = cur + 1
                    end
                end
                var le = cur
                when le < len and read_byte(content, le) != 10 and read_byte(content, le) != 13 loop
                    write_byte(res_buf, res_idx, read_byte(content, le))
                    res_idx = res_idx + 1
                    le = le + 1
                end
                write_byte(res_buf, res_idx, 10)
                res_idx = res_idx + 1
                end_pos = le + 1
            end
            write_byte(res_buf, res_idx, 0)
            out man_trim(res_buf)
        end
        p = p + 1
    end

    # Look for single-line "# EXPECT: "
    p = 0
    when p + 9 < len loop
        if read_byte(content, p) == 35 and read_byte(content, p + 1) == 32 and read_byte(content, p + 2) == 69 and read_byte(content, p + 3) == 88 and read_byte(content, p + 4) == 80 and read_byte(content, p + 5) == 69 and read_byte(content, p + 6) == 67 and read_byte(content, p + 7) == 84 and read_byte(content, p + 8) == 58 do
            var es = p + 9
            when es < len and read_byte(content, es) == 32 loop
                es = es + 1
            end
            var ee = es
            when ee < len and read_byte(content, ee) != 10 and read_byte(content, ee) != 13 loop
                ee = ee + 1
            end
            out man_trim(man_sub_str(content, es, ee - es))
        end
        p = p + 1
    end

    let empty = alloc(1)
    write_byte(empty, 0, 0)
    out empty
end.

export TestRow, ManifestTable, manifest_parse, manifest_get_row, fixture_extract_virc_flags, fixture_extract_expected_stdout
