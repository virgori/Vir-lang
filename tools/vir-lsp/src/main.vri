# ═════════════════════════════════════════════════════════════════════
# Console Printing & CLI
# ═════════════════════════════════════════════════════════════════════

func lsp_print_str(msg: string):
    let len = rt_strlen(msg as i64)
    if len > 0 do
        sys_write(1, msg as int, len)
    end
    let nl = 10
    let nl_buf = vir_alloc(2)
    native_write_u8(nl_buf, 0, nl)
    sys_write(1, nl_buf, 1)
    vir_free(nl_buf)
end.

func print_banner():
    lsp_print_str("==============================================")
    lsp_print_str("        V I R - L S P   1.3.0 (Native)        ")
    lsp_print_str("      Language Server Protocol Daemon         ")
    lsp_print_str("==============================================")
end.

func print_help():
    print_banner()
    lsp_print_str("Usage: vir-lsp [options]")
    lsp_print_str("")
    lsp_print_str("Options:")
    lsp_print_str("  --stdio          Run Language Server daemon over stdio (JSON-RPC 2.0)")
    lsp_print_str("  --sysroot PATH   Override toolchain sysroot path")
    lsp_print_str("  --stdlib-registry PATH  Use an explicit stdlib/stdlib.vri registry")
    lsp_print_str("  --version (-v)   Display version information")
    lsp_print_str("  --help (-h)      Display this help message")
    lsp_print_str("")
    lsp_print_str("VS Code / Antigravity IDE Integration:")
    lsp_print_str("  Add to settings.json:")
    lsp_print_str("    \"vir.lsp.serverPath\": \"<path_to_workspace>/bin/vir-lsp\"")
end.

func print_version():
    lsp_print_str("vir-lsp 1.3.0 (Language Server Protocol daemon - standalone pure vir)")
end.

# ═════════════════════════════════════════════════════════════════════
# Character & String Helpers
# ═════════════════════════════════════════════════════════════════════

func is_alpha(c: int):
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
        out 1
    end
    out 0
end.

func is_digit(c: int):
    if c >= 48 and c <= 57 do
        out 1
    end
    out 0
end.

func is_alnum(c: int):
    if is_alpha(c) == 1 or is_digit(c) == 1 do
        out 1
    end
    out 0
end.

func is_whitespace(c: int):
    if c == 32 or c == 9 or c == 13 or c == 10 do
        out 1
    end
    out 0
end.

func copy_sub_string(src: int, start: int, len: int):
    if src == 0 or len <= 0 or start < 0 or len > 20000000 do
        let empty = vir_alloc(1)
        if empty != 0 do native_write_u8(empty, 0, 0) end
        out empty
    end
    let dst = vir_alloc(len + 1)
    if dst == 0 do
        let empty = vir_alloc(1)
        if empty != 0 do native_write_u8(empty, 0, 0) end
        out empty
    end
    rt_memcpy(dst, src + start, len)
    native_write_u8(dst, len, 0)
    out dst
end.

func is_keyword(s: int):
    if rt_streq(s as i64, "func" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "let" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "var" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "in" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "ref" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "out" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "if" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "else" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "elif" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "eif" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "for" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "while" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "loop" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "when" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "do" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "end" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "entity" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "type" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "enum" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "include" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "import" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "export" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "from" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "return" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "int" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "float" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "string" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "bool" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "Matrix" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "Vector" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "matmul" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "grad" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "embed" as i64) == 1 do out 1 end
    if rt_streq(s as i64, "train" as i64) == 1 do out 1 end
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# In-Memory Analysis Tables & Document State
# ═════════════════════════════════════════════════════════════════════

var g_doc_uri: int = 0
var g_doc_version: int = 1
var g_analysisGeneration: int = 0
var g_sessionStartedNs: int = 0
var g_sessionProcessId: int = 0
var g_analysisSupervisor: int = 1
var g_doc_text: int = 0
var g_doc_text_len: int = 0

func lsp_get_line_start(target_line: int):
    if g_doc_text == 0 or g_doc_text_len <= 0 or target_line <= 0 do
        out 0
    end
    var p = 0
    var cur_l = 0
    var l_start = 0
    when p <= g_doc_text_len loop
        var is_eol = 0
        if p == g_doc_text_len do is_eol = 1
        eif native_read_u8(g_doc_text, p) == 10 do is_eol = 1
        end
        if is_eol == 1 do
            if cur_l == target_line do
                out l_start
            end
            l_start = p + 1
            cur_l = cur_l + 1
        end
        p = p + 1
    end
    out l_start
end.

func lsp_byte_col_to_utf16(line_idx: int, byte_col: int):
    if g_doc_text == 0 or byte_col <= 0 do
        out 0
    end
    let l_start = lsp_get_line_start(line_idx)
    var b_idx = 0
    var u16_col = 0
    when b_idx < byte_col and (l_start + b_idx) < g_doc_text_len loop
        let b = native_read_u8(g_doc_text, l_start + b_idx)
        if b == 10 or b == 13 do
            break
        end
        if b < 128 do
            b_idx = b_idx + 1
            u16_col = u16_col + 1
        eif b >= 192 and b <= 223 do
            b_idx = b_idx + 2
            u16_col = u16_col + 1
        eif b >= 224 and b <= 239 do
            b_idx = b_idx + 3
            u16_col = u16_col + 1
        eif b >= 240 and b <= 247 do
            b_idx = b_idx + 4
            u16_col = u16_col + 2
        else
            b_idx = b_idx + 1
            u16_col = u16_col + 1
        end
    end
    out u16_col
end.

func lsp_utf16_col_to_byte(line_idx: int, u16_col: int):
    if g_doc_text == 0 or u16_col <= 0 do
        out 0
    end
    let l_start = lsp_get_line_start(line_idx)
    var b_idx = 0
    var cur_u16 = 0
    when (l_start + b_idx) < g_doc_text_len and cur_u16 < u16_col loop
        let b = native_read_u8(g_doc_text, l_start + b_idx)
        if b == 10 or b == 13 do
            break
        end
        if b < 128 do
            b_idx = b_idx + 1
            cur_u16 = cur_u16 + 1
        eif b >= 192 and b <= 223 do
            b_idx = b_idx + 2
            cur_u16 = cur_u16 + 1
        eif b >= 224 and b <= 239 do
            b_idx = b_idx + 3
            cur_u16 = cur_u16 + 1
        eif b >= 240 and b <= 247 do
            b_idx = b_idx + 4
            cur_u16 = cur_u16 + 2
        else
            b_idx = b_idx + 1
            cur_u16 = cur_u16 + 1
        end
    end
    out b_idx
end.

var g_sym_table: int = 0
var g_sym_count: int = 0

var g_occ_table: int = 0
var g_occ_count: int = 0

var g_mod_table: int = 0
var g_mod_count: int = 0

var g_diag_table: int = 0
var g_diag_count: int = 0
var g_diag_capacity: int = 128
var g_diagRecord: int = 0
var g_diagSource: int = 0
var g_diagPublishSource: int = 0

var g_scope_table: int = 0
var g_scope_count: int = 0
var g_scope_stack: int = 0
var g_scope_stack_top: int = 0

var g_func_scopes: int = 0
var g_func_count: int = 0

func sym_get_name(idx: int): out native_read_i64(g_sym_table, idx * 88 + 0) end.
func sym_get_kind(idx: int): out native_read_i64(g_sym_table, idx * 88 + 8) end.
func sym_get_line(idx: int): out native_read_i64(g_sym_table, idx * 88 + 16) end.
func sym_get_col(idx: int): out native_read_i64(g_sym_table, idx * 88 + 24) end.
func sym_get_end_col(idx: int): out native_read_i64(g_sym_table, idx * 88 + 32) end.
func sym_get_type_desc(idx: int): out native_read_i64(g_sym_table, idx * 88 + 40) end.
func sym_get_doc(idx: int): out native_read_i64(g_sym_table, idx * 88 + 48) end.
func sym_get_state(idx: int): out native_read_i64(g_sym_table, idx * 88 + 56) end.
func sym_get_scope_id(idx: int): out native_read_i64(g_sym_table, idx * 88 + 64) end.
func sym_get_activity(idx: int): out 1 end.
func sym_get_id(idx: int): out native_read_i64(g_sym_table, idx * 88 + 72) end.

func lsp_add_symbol_state_scoped(name: int, kind: int, line: int, col: int, end_col: int, type_desc: int, doc: int, state: int, scope_id: int):
    if g_sym_count >= 500 do out 0 end
    let idx = g_sym_count
    let id_val = idx + 1
    let base = g_sym_table + idx * 88
    native_write_i64(base, 0, name)
    native_write_i64(base, 8, kind)
    native_write_i64(base, 16, line)
    native_write_i64(base, 24, col)
    native_write_i64(base, 32, end_col)
    native_write_i64(base, 40, type_desc)
    native_write_i64(base, 48, doc)
    native_write_i64(base, 56, state)
    native_write_i64(base, 64, scope_id)
    native_write_i64(base, 72, id_val)
    native_write_i64(base, 80, g_buildSource)
    g_sym_count = g_sym_count + 1
    out id_val
end.

func lsp_add_symbol_state(name: int, kind: int, line: int, col: int, end_col: int, type_desc: int, doc: int, state: int):
    out lsp_add_symbol_state_scoped(name, kind, line, col, end_col, type_desc, doc, state, 0)
end.

func lsp_add_symbol(name: int, kind: int, line: int, col: int, end_col: int, type_desc: int, doc: int):
    out lsp_add_symbol_state_scoped(name, kind, line, col, end_col, type_desc, doc, 1024, 0)
end.

func lsp_add_occ(sym_id: int, line: int, col: int, end_line: int, end_col: int, kind: int, state: int, role: int):
    if g_occ_count >= 2000 do out 0 end
    let idx = g_occ_count
    let base = g_occ_table + idx * 88
    native_write_i64(base, 0, sym_id)
    native_write_i64(base, 8, line)
    native_write_i64(base, 16, col)
    native_write_i64(base, 24, end_line)
    native_write_i64(base, 32, end_col)
    native_write_i64(base, 40, kind)
    native_write_i64(base, 48, state)
    native_write_i64(base, 56, role)
    native_write_i64(base, 64, g_buildSource)
    native_write_i64(base, 72, g_buildLoan)
    native_write_i64(base, 80, g_buildLifetimeEnd)
    g_occ_count = g_occ_count + 1
    out idx
end.

func lsp_add_module(name: int, line: int, col: int, end_col: int, activity: int):
    if g_mod_count >= 100 do out 0 end
    let idx = g_mod_count
    let base = g_mod_table + idx * 40
    native_write_i64(base, 0, name)
    native_write_i64(base, 8, line)
    native_write_i64(base, 16, col)
    native_write_i64(base, 24, end_col)
    native_write_i64(base, 32, activity)
    g_mod_count = g_mod_count + 1
    out idx
end.

func lsp_add_diag(line: int, col: int, end_line: int, end_col: int, severity: int, code: int, message: int):
    if g_diag_count >= g_diag_capacity do
        let capacity = g_diag_capacity * 2
        let replacement = vir_alloc(capacity * 72)
        rt_memcpy(replacement, g_diag_table, g_diag_count * 72)
        vir_free(g_diag_table)
        g_diag_table = replacement
        g_diag_capacity = capacity
    end
    let idx = g_diag_count
    let base = g_diag_table + idx * 72
    native_write_i64(base, 0, line)
    native_write_i64(base, 8, col)
    native_write_i64(base, 16, end_line)
    native_write_i64(base, 24, end_col)
    native_write_i64(base, 32, severity)
    native_write_i64(base, 40, code)
    native_write_i64(base, 48, message)
    native_write_i64(base, 56, g_diagSource)
    native_write_i64(base, 64, g_diagRecord)
    g_diag_count = g_diag_count + 1
    out idx
end.

func lsp_scope_get_id(idx: int): out native_read_i64(g_scope_table, idx * 40 + 0) end.

func lsp_scope_get_parent(sid: int):
    var i = 0
    when i < g_scope_count loop
        if native_read_i64(g_scope_table, i * 40 + 0) == sid do
            out native_read_i64(g_scope_table, i * 40 + 8)
        end
        i = i + 1
    end
    out 0
end.

func lsp_scope_get_func(sid: int):
    var i = 0
    when i < g_scope_count loop
        if native_read_i64(g_scope_table, i * 40 + 0) == sid do
            out native_read_i64(g_scope_table, i * 40 + 16)
        end
        i = i + 1
    end
    out 0
end.

func lsp_scope_get_start(sid: int):
    var i = 0
    when i < g_scope_count loop
        if native_read_i64(g_scope_table, i * 40 + 0) == sid do
            out native_read_i64(g_scope_table, i * 40 + 24)
        end
        i = i + 1
    end
    out 0
end.

func lsp_scope_get_end(sid: int):
    var i = 0
    when i < g_scope_count loop
        if native_read_i64(g_scope_table, i * 40 + 0) == sid do
            out native_read_i64(g_scope_table, i * 40 + 32)
        end
        i = i + 1
    end
    out 999999
end.

func lsp_scope_set_end(sid: int, end_l: int):
    var i = 0
    when i < g_scope_count loop
        if native_read_i64(g_scope_table, i * 40 + 0) == sid do
            native_write_i64(g_scope_table, i * 40 + 32, end_l)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func lsp_push_scope(parent_sid: int, func_sid: int, start_line: int):
    if g_scope_count >= 1000 do out parent_sid end
    let sid = g_scope_count + 1
    let idx = g_scope_count
    let base = g_scope_table + idx * 40
    native_write_i64(base, 0, sid)
    native_write_i64(base, 8, parent_sid)
    native_write_i64(base, 16, func_sid)
    native_write_i64(base, 24, start_line)
    native_write_i64(base, 32, 999999)
    g_scope_count = g_scope_count + 1

    if g_scope_stack_top < 120 do
        native_write_i64(g_scope_stack, g_scope_stack_top * 8, sid)
        g_scope_stack_top = g_scope_stack_top + 1
    end
    out sid
end.

func lsp_pop_scope(end_line: int):
    if g_scope_stack_top > 0 do
        g_scope_stack_top = g_scope_stack_top - 1
        let sid = native_read_i64(g_scope_stack, g_scope_stack_top * 8)
        lsp_scope_set_end(sid, end_line)
        if g_scope_stack_top > 0 do
            out native_read_i64(g_scope_stack, (g_scope_stack_top - 1) * 8)
        end
    end
    out 0
end.

func lsp_peek_scope():
    if g_scope_stack_top > 0 do
        out native_read_i64(g_scope_stack, (g_scope_stack_top - 1) * 8)
    end
    out 0
end.

func lsp_get_scope_for_line(line: int):
    var best_scope = 0
    var min_span = 9999999
    var i = 0
    when i < g_scope_count loop
        let sid = native_read_i64(g_scope_table, i * 40 + 0)
        let s_start = native_read_i64(g_scope_table, i * 40 + 24)
        let s_end = native_read_i64(g_scope_table, i * 40 + 32)
        if line >= s_start and line <= s_end do
            let span = s_end - s_start
            if span < min_span do
                min_span = span
                best_scope = sid
            end
        end
        i = i + 1
    end
    out best_scope
end.

func lsp_get_func_for_line(line: int):
    let sc = lsp_get_scope_for_line(line)
    if sc > 0 do
        out lsp_scope_get_func(sc)
    end
    out 0
end.

func lsp_is_ancestor_scope(ancestor_id: int, child_id: int):
    var cur = child_id
    when cur > 0 loop
        if cur == ancestor_id do out 1 end
        cur = lsp_scope_get_parent(cur)
    end
    out 0
end.

func lsp_find_sym_in_single_scope(name: int, scope_id: int, at_line: int):
    var best_idx = 0 - 1
    var best_line = 0 - 1
    var i = 0
    when i < g_sym_count loop
        if sym_get_scope_id(i) == scope_id do
            let sname = sym_get_name(i)
            if rt_streq(name as i64, sname as i64) == 1 do
                let sline = sym_get_line(i)
                if at_line < 0 or sline <= at_line do
                    if sline > best_line do
                        best_line = sline
                        best_idx = i
                    end
                end
            end
        end
        i = i + 1
    end
    out best_idx
end.

func lsp_find_sym_scoped(name: int, current_scope_id: int, at_line: int):
    if g_compilerAnalysisAvailable == 1 do
        out lspCompilerFindVisible(name, at_line)
    end
    var cur_scope = current_scope_id
    when cur_scope > 0 loop
        let s_start = lsp_scope_get_start(cur_scope)
        let s_end = lsp_scope_get_end(cur_scope)
        if at_line < 0 or (at_line >= s_start and at_line <= s_end) do
            let sym_idx = lsp_find_sym_in_single_scope(name, cur_scope, at_line)
            if sym_idx >= 0 do
                out sym_idx
            end
        end
        cur_scope = lsp_scope_get_parent(cur_scope)
    end

    # Fall back to global scope (scope_id == 0)
    let g_idx = lsp_find_sym_in_single_scope(name, 0, at_line)
    out g_idx
end.

func lsp_find_sym_by_name(name: int):
    out lsp_find_sym_scoped(name, 0, 0 - 1)
end.

func lsp_find_sym_by_id(id_val: int):
    var i = 0
    when i < g_sym_count loop
        if sym_get_id(i) == id_val do
            out i
        end
        i = i + 1
    end
    out 0 - 1
end.

func lsp_find_occ_at(line: int, col: int):
    var i = 0
    when i < g_occ_count loop
        let o_line = native_read_i64(g_occ_table, i * 88 + 8)
        if o_line == line & rt_streq(lspSourceUri(native_read_i64(g_occ_table, i * 88 + 64)), g_doc_uri) == 1 do
            let o_col = native_read_i64(g_occ_table, i * 88 + 16)
            let o_end = native_read_i64(g_occ_table, i * 88 + 32)
            if col >= o_col and col <= o_end do
                out i
            end
        end
        i = i + 1
    end
    out 0 - 1
end.

func lsp_find_sym_at(line: int, col: int):
    let occ_idx = lsp_find_occ_at(line, col)
    if occ_idx >= 0 do
        let sid = native_read_i64(g_occ_table, occ_idx * 88 + 0)
        out lsp_find_sym_by_id(sid)
    end
    let cur_scope = lsp_get_scope_for_line(line)
    var i = 0
    when i < g_sym_count loop
        let s_line = sym_get_line(i)
        if s_line == line & rt_streq(lspSourceUri(native_read_i64(g_sym_table, i * 88 + 80)), g_doc_uri) == 1 do
            let s_col = sym_get_col(i)
            let s_end = sym_get_end_col(i)
            if col >= s_col and col <= s_end do
                let s_scope = sym_get_scope_id(i)
                if s_scope == 0 or s_scope == cur_scope or lsp_is_ancestor_scope(s_scope, cur_scope) == 1 do
                    out i
                end
            end
        end
        i = i + 1
    end
    out 0 - 1
end.

func lsp_sort_occ():
    var i = 1
    when i < g_occ_count loop
        var j = i
        when j > 0 loop
            let l_curr = native_read_i64(g_occ_table, j * 88 + 8)
            let c_curr = native_read_i64(g_occ_table, j * 88 + 16)
            let l_prev = native_read_i64(g_occ_table, (j - 1) * 88 + 8)
            let c_prev = native_read_i64(g_occ_table, (j - 1) * 88 + 16)
            if l_curr < l_prev or (l_curr == l_prev and c_curr < c_prev) do
                var b = 0
                when b < 11 loop
                    let tmp = native_read_i64(g_occ_table, j * 88 + b * 8)
                    native_write_i64(g_occ_table, j * 88 + b * 8, native_read_i64(g_occ_table, (j - 1) * 88 + b * 8))
                    native_write_i64(g_occ_table, (j - 1) * 88 + b * 8, tmp)
                    b = b + 1
                end
                j = j - 1
            else
                break
            end
        end
        i = i + 1
    end
    out 0
end.

func line_has_word_end(text: int, start: int, len: int):
    var i = start
    let limit = start + len
    when i + 3 <= limit loop
        if native_read_u8(text, i) == 101 and native_read_u8(text, i + 1) == 110 and native_read_u8(text, i + 2) == 100 do
            var before_ok = 0
            if i == start or is_alnum(native_read_u8(text, i - 1)) == 0 do
                before_ok = 1
            end
            var after_ok = 0
            if i + 3 == limit or (is_alnum(native_read_u8(text, i + 3)) == 0 and native_read_u8(text, i + 3) != 46) do
                after_ok = 1
            end
            if before_ok == 1 and after_ok == 1 do
                out 1
            end
        end
        i = i + 1
    end
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# Document Parser & Semantic Analysis Engine
# ═════════════════════════════════════════════════════════════════════

var g_compilerAnalysisFailure: int = 0

func lsp_analyze_document():
    g_analysisGeneration = g_analysisGeneration + 1
    if g_analysisSupervisor == 1 do out 0 end
    g_compilerAnalysisAvailable = 0
    g_compilerAnalysisFailure = 0
    g_ideSessionErrors = 0
    g_sym_count = 0
    g_occ_count = 0
    g_mod_count = 0
    g_diag_count = 0
    g_func_count = 0
    g_scope_count = 0
    g_scope_stack_top = 0

    if g_doc_text == 0 or g_doc_text_len <= 0 do
        out 0
    end

    # Pass 1: Scan declarations line-by-line
    var p = 0
    var line_start = 0
    var line_idx = 0
    var cur_func_sid = 0
    var cur_param_mode = 0
    var cur_scope_idx = 0 - 1
    var in_block_comment = 0   # inside ## ... ## block
    var cur_var_mode = 0       # 1=var block, 2=let block (grouped declaration continuation)

    when p <= g_doc_text_len loop
        var is_eol = 0
        if p == g_doc_text_len do
            is_eol = 1
        eif native_read_u8(g_doc_text, p) == 10 do
            is_eol = 1
        end

        if is_eol == 1 do
            var line_len = p - line_start
            if line_len > 0 and native_read_u8(g_doc_text, line_start + line_len - 1) == 13 do
                line_len = line_len - 1
            end

            # Detect ## block-comment toggle (line starts with "##" possibly with leading whitespace)
            var skip_line = 0
            var bc_ci = 0
            when bc_ci < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + bc_ci)) == 1 loop
                bc_ci = bc_ci + 1
            end
            if bc_ci + 1 < line_len and native_read_u8(g_doc_text, line_start + bc_ci) == 35 and native_read_u8(g_doc_text, line_start + bc_ci + 1) == 35 do
                if in_block_comment == 0 do
                    in_block_comment = 1
                else
                    in_block_comment = 0
                end
                skip_line = 1
            end

            # Skip entire line if inside a ## block comment
            if in_block_comment == 1 do
                skip_line = 1
            end

            if skip_line == 0 do
            # Strip trailing single-line comment '#' for declaration parsing
            var eff_len = line_len
            var ci = 0
            when ci < line_len loop
                if native_read_u8(g_doc_text, line_start + ci) == 35 do
                    eff_len = ci
                    break
                end
                ci = ci + 1
            end
            line_len = eff_len

            var c = 0
            when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop
                c = c + 1
            end

            if c < line_len do
                let w_start = c
                when c < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 or native_read_u8(g_doc_text, line_start + c) == 46) loop
                    c = c + 1
                end
                let w_len = c - w_start
                if w_len > 0 do
                    let first_word = copy_sub_string(g_doc_text, line_start + w_start, w_len)

                    # 0. end. definition closer
                    if rt_streq(first_word as i64, "end." as i64) == 1 do
                        when g_scope_stack_top > 0 loop
                            lsp_pop_scope(line_idx)
                        end
                        if cur_scope_idx >= 0 do
                            native_write_i64(g_func_scopes, cur_scope_idx * 24 + 16, line_idx)
                            cur_scope_idx = 0 - 1
                        end
                        cur_func_sid = 0
                        cur_param_mode = 0
                        cur_var_mode = 0

                    # 0b. end block closer
                    eif rt_streq(first_word as i64, "end" as i64) == 1 do
                        if g_scope_stack_top > 1 do
                            lsp_pop_scope(line_idx)
                        end
                        cur_param_mode = 0
                        cur_var_mode = 0

                    # 1. func declaration
                    eif rt_streq(first_word as i64, "func" as i64) == 1 do
                        when g_scope_stack_top > 0 loop
                            lsp_pop_scope(line_idx - 1)
                        end
                        if cur_scope_idx >= 0 do
                            native_write_i64(g_func_scopes, cur_scope_idx * 24 + 16, line_idx - 1)
                            cur_scope_idx = 0 - 1
                        end
                        cur_param_mode = 0
                        cur_var_mode = 0

                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_start = c
                        when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_len = c - name_start
                        if name_len > 0 do
                            let fn_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                            var sig_len = line_len - name_start
                            if sig_len < 0 do sig_len = 0 end
                            let sig = copy_sub_string(g_doc_text, line_start + name_start, sig_len)
                            let sid = lsp_add_symbol_state_scoped(fn_name, 1, line_idx, name_start, name_start + name_len, sig, "Vir function definition" as int, 1024, 0)
                            lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 12, 1024, 1)

                            cur_func_sid = sid
                            let fn_scope = lsp_push_scope(0, sid, line_idx)
                            if g_func_count < 200 do
                                let f_idx = g_func_count
                                native_write_i64(g_func_scopes, f_idx * 24 + 0, sid)
                                native_write_i64(g_func_scopes, f_idx * 24 + 8, line_idx)
                                native_write_i64(g_func_scopes, f_idx * 24 + 16, 999999)
                                cur_scope_idx = f_idx
                                g_func_count = g_func_count + 1
                            end

                            # Check for parenthesized parameter list: (a: int, ref b: int, out c: int)
                            var pc = c
                            when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                            if pc < line_len and native_read_u8(g_doc_text, line_start + pc) == 40 do
                                pc = pc + 1
                                when pc < line_len and native_read_u8(g_doc_text, line_start + pc) != 41 loop
                                    let previousParamPosition = pc
                                    when pc < line_len and (is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 or native_read_u8(g_doc_text, line_start + pc) == 44) loop pc = pc + 1 end
                                    if pc >= line_len or native_read_u8(g_doc_text, line_start + pc) == 41 do break end
                                    var p_mod = 1024
                                    var p_doc = "Input parameter (by value / read-only)" as int
                                    if pc + 4 <= line_len and native_read_u8(g_doc_text, line_start + pc) == 114 and native_read_u8(g_doc_text, line_start + pc + 1) == 101 and native_read_u8(g_doc_text, line_start + pc + 2) == 102 and native_read_u8(g_doc_text, line_start + pc + 3) == 32 do
                                        p_mod = 131072 # virBorrowed
                                        p_doc = "Reference parameter (mutable borrow &mut)" as int
                                        pc = pc + 4
                                        when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                    eif pc + 4 <= line_len and native_read_u8(g_doc_text, line_start + pc) == 111 and native_read_u8(g_doc_text, line_start + pc + 1) == 117 and native_read_u8(g_doc_text, line_start + pc + 2) == 116 and native_read_u8(g_doc_text, line_start + pc + 3) == 32 do
                                        p_mod = 4096 # virOut
                                        p_doc = "Output parameter (destination binding)" as int
                                        pc = pc + 4
                                        when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                    eif pc + 3 <= line_len and native_read_u8(g_doc_text, line_start + pc) == 105 and native_read_u8(g_doc_text, line_start + pc + 1) == 110 and native_read_u8(g_doc_text, line_start + pc + 2) == 32 do
                                        p_mod = 1024 # virAlive
                                        p_doc = "Input parameter (by value / read-only)" as int
                                        pc = pc + 3
                                        when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                    end
                                    let p_name_start = pc
                                    when pc < line_len and is_alnum(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                    let p_name_len = pc - p_name_start
                                    if p_name_len > 0 do
                                        let p_name = copy_sub_string(g_doc_text, line_start + p_name_start, p_name_len)
                                        var p_type = "unknown" as int
                                        when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                        if pc < line_len and native_read_u8(g_doc_text, line_start + pc) == 58 do
                                            pc = pc + 1
                                            when pc < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + pc)) == 1 loop pc = pc + 1 end
                                            let pt_start = pc
                                            when pc < line_len and native_read_u8(g_doc_text, line_start + pc) != 44 and native_read_u8(g_doc_text, line_start + pc) != 41 loop pc = pc + 1 end
                                            if pc > pt_start do
                                                p_type = copy_sub_string(g_doc_text, line_start + pt_start, pc - pt_start)
                                            end
                                        end
                                        let p_sid = lsp_add_symbol_state_scoped(p_name, 4, line_idx, p_name_start, p_name_start + p_name_len, p_type, p_doc, p_mod, fn_scope)
                                        lsp_add_occ(p_sid, line_idx, p_name_start, line_idx, p_name_start + p_name_len, 7, p_mod, 1)
                                    end
                                    if pc <= previousParamPosition do pc = pc + 1 end
                                end
                            end
                        end

                    # 2. entity declaration
                    eif rt_streq(first_word as i64, "entity" as i64) == 1 do
                        when g_scope_stack_top > 0 loop
                            lsp_pop_scope(line_idx - 1)
                        end
                        if cur_scope_idx >= 0 do
                            native_write_i64(g_func_scopes, cur_scope_idx * 24 + 16, line_idx - 1)
                            cur_scope_idx = 0 - 1
                        end
                        cur_func_sid = 0
                        cur_param_mode = 0

                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_start = c
                        when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_len = c - name_start
                        if name_len > 0 do
                            let ent_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                            let sid = lsp_add_symbol_state_scoped(ent_name, 3, line_idx, name_start, name_start + name_len, "entity type" as int, "Vir entity type definition" as int, 1024, 0)
                            lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 1, 1024, 1)
                        end

                    # 3. let / var declaration (single-line or grouped block)
                    eif rt_streq(first_word as i64, "let" as i64) == 1 or rt_streq(first_word as i64, "var" as i64) == 1 do
                        cur_param_mode = 0
                        # Set grouped-block mode: 1=var, 2=let
                        if rt_streq(first_word as i64, "var" as i64) == 1 do
                            cur_var_mode = 1
                        else
                            cur_var_mode = 2
                        end
                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_start = c
                        when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_len = c - name_start
                        if name_len > 0 do
                            let var_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                            let sid = lsp_add_symbol_state_scoped(var_name, 2, line_idx, name_start, name_start + name_len, "unknown" as int, "Type unavailable: compiler type snapshot is not connected" as int, 1024, lsp_peek_scope())
                            lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 8, 1024, 1)
                        end
                        # bare 'var'/'let' alone on a line acts as block header; cur_var_mode stays active

                    # 4. include declaration
                    eif rt_streq(first_word as i64, "include" as i64) == 1 do
                        cur_param_mode = 0
                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        let name_start = c
                        when c < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 or native_read_u8(g_doc_text, line_start + c) == 46) loop c = c + 1 end
                        let name_len = c - name_start
                        if name_len > 0 do
                            let mod_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                            lsp_add_module(mod_name, line_idx, name_start, name_start + name_len, 1)
                        end

                    # 5. Block statement: if, when, for, loop, try, case, select
                    eif rt_streq(first_word as i64, "if" as i64) == 1 or rt_streq(first_word as i64, "when" as i64) == 1 or rt_streq(first_word as i64, "for" as i64) == 1 or rt_streq(first_word as i64, "loop" as i64) == 1 or rt_streq(first_word as i64, "try" as i64) == 1 or rt_streq(first_word as i64, "case" as i64) == 1 or rt_streq(first_word as i64, "select" as i64) == 1 do
                        cur_param_mode = 0
                        let block_sc = lsp_push_scope(lsp_peek_scope(), cur_func_sid, line_idx)
                        if rt_streq(first_word as i64, "for" as i64) == 1 do
                            when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                            let v_start = c
                            when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                            let v_len = c - v_start
                            if v_len > 0 do
                                let v_name = copy_sub_string(g_doc_text, line_start + v_start, v_len)
                                let sid = lsp_add_symbol_state_scoped(v_name, 2, line_idx, v_start, v_start + v_len, "int" as int, "Loop variable binding" as int, 1024, block_sc)
                                lsp_add_occ(sid, line_idx, v_start, line_idx, v_start + v_len, 8, 1024, 1)
                            end
                        end
                        if line_has_word_end(g_doc_text, line_start + c, line_len - c) == 1 do
                            lsp_pop_scope(line_idx)
                        end

                    # 6. Branch statement: else, eif
                    eif rt_streq(first_word as i64, "else" as i64) == 1 or rt_streq(first_word as i64, "eif" as i64) == 1 do
                        cur_param_mode = 0
                        if g_scope_stack_top > 1 do
                            lsp_pop_scope(line_idx - 1)
                            lsp_push_scope(lsp_peek_scope(), cur_func_sid, line_idx)
                            if line_has_word_end(g_doc_text, line_start + c, line_len - c) == 1 do
                                lsp_pop_scope(line_idx)
                            end
                        end

                    # 7. in parameter section / header
                    eif rt_streq(first_word as i64, "in" as i64) == 1 do
                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        if c < line_len and native_read_u8(g_doc_text, line_start + c) == 58 do
                            c = c + 1
                            when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        end
                        cur_param_mode = 1
                        if c < line_len do
                            let name_start = c
                            when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                            let name_len = c - name_start
                            if name_len > 0 do
                                let p_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                                var p_type = "unknown" as int
                                var scan_t = c
                                when scan_t < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_t)) == 1 loop scan_t = scan_t + 1 end
                                if scan_t < line_len and native_read_u8(g_doc_text, line_start + scan_t) == 58 do
                                    scan_t = scan_t + 1
                                    when scan_t < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_t)) == 1 loop scan_t = scan_t + 1 end
                                    let pt_start = scan_t
                                    when scan_t < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + scan_t)) == 1 or native_read_u8(g_doc_text, line_start + scan_t) == 91 or native_read_u8(g_doc_text, line_start + scan_t) == 93) loop scan_t = scan_t + 1 end
                                    if scan_t > pt_start do
                                        p_type = copy_sub_string(g_doc_text, line_start + pt_start, scan_t - pt_start)
                                    end
                                end
                                let sid = lsp_add_symbol_state_scoped(p_name, 4, line_idx, name_start, name_start + name_len, p_type, "Input parameter (by value / read-only)" as int, 1024, lsp_peek_scope())
                                lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 7, 1024, 1)
                            end
                        end

                    # 8. ref parameter section / header
                    eif rt_streq(first_word as i64, "ref" as i64) == 1 do
                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        if c < line_len and native_read_u8(g_doc_text, line_start + c) == 58 do
                            c = c + 1
                            when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        end
                        cur_param_mode = 2
                        if c < line_len do
                            let name_start = c
                            when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                            let name_len = c - name_start
                            if name_len > 0 do
                                let p_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                                var p_type = "unknown" as int
                                var scan_t = c
                                when scan_t < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_t)) == 1 loop scan_t = scan_t + 1 end
                                if scan_t < line_len and native_read_u8(g_doc_text, line_start + scan_t) == 58 do
                                    scan_t = scan_t + 1
                                    when scan_t < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_t)) == 1 loop scan_t = scan_t + 1 end
                                    let pt_start = scan_t
                                    when scan_t < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + scan_t)) == 1 or native_read_u8(g_doc_text, line_start + scan_t) == 91 or native_read_u8(g_doc_text, line_start + scan_t) == 93) loop scan_t = scan_t + 1 end
                                    if scan_t > pt_start do
                                        p_type = copy_sub_string(g_doc_text, line_start + pt_start, scan_t - pt_start)
                                    end
                                end
                                let sid = lsp_add_symbol_state_scoped(p_name, 4, line_idx, name_start, name_start + name_len, p_type, "Reference parameter (mutable borrow &mut)" as int, 131072, lsp_peek_scope())
                                lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 7, 131072, 1)
                            end
                        end

                    # 9. out parameter section / header vs out expr return
                    eif rt_streq(first_word as i64, "out" as i64) == 1 do
                        when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        var colon_after_out = 0
                        if c < line_len and native_read_u8(g_doc_text, line_start + c) == 58 do
                            colon_after_out = 1
                            c = c + 1
                            when c < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                        end
                        if c >= line_len do
                            # Standalone 'out' or 'out:' header
                            cur_param_mode = 3
                        else
                            # Something follows 'out'
                            let name_start = c
                            when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop c = c + 1 end
                            let name_len = c - name_start
                            var scan_col = c
                            when scan_col < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_col)) == 1 loop scan_col = scan_col + 1 end
                            if (colon_after_out == 1 or (scan_col < line_len and native_read_u8(g_doc_text, line_start + scan_col) == 58)) and name_len > 0 do
                                cur_param_mode = 3
                                let p_name = copy_sub_string(g_doc_text, line_start + name_start, name_len)
                                var p_type = "unknown" as int
                                if scan_col < line_len and native_read_u8(g_doc_text, line_start + scan_col) == 58 do
                                    scan_col = scan_col + 1
                                    when scan_col < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_col)) == 1 loop scan_col = scan_col + 1 end
                                    let pt_start = scan_col
                                    when scan_col < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + scan_col)) == 1 or native_read_u8(g_doc_text, line_start + scan_col) == 91 or native_read_u8(g_doc_text, line_start + scan_col) == 93) loop scan_col = scan_col + 1 end
                                    if scan_col > pt_start do
                                        p_type = copy_sub_string(g_doc_text, line_start + pt_start, scan_col - pt_start)
                                    end
                                end
                                let sid = lsp_add_symbol_state_scoped(p_name, 4, line_idx, name_start, name_start + name_len, p_type, "Output parameter (destination binding)" as int, 4096, lsp_peek_scope())
                                lsp_add_occ(sid, line_idx, name_start, line_idx, name_start + name_len, 7, 4096, 1)
                            else
                                # 'out <expr>' return statement
                                cur_param_mode = 0
                            end
                        end

                    # 10. Grouped var/let block continuation (no keyword needed on continuation lines)
                    eif cur_var_mode != 0 and cur_func_sid != 0 and is_keyword(first_word as i64) == 0 do
                        # A continuation line looks like: <name> = <expr>  or  <name>: <type> = <expr>
                        # We only need the name; register it with the same mutability as the block opener
                        let vb_name = copy_sub_string(g_doc_text, line_start + w_start, w_len)
                        let sid = lsp_add_symbol_state_scoped(vb_name, 2, line_idx, w_start, w_start + w_len, "unknown" as int, "Type unavailable: compiler type snapshot is not connected" as int, 1024, lsp_peek_scope())
                        lsp_add_occ(sid, line_idx, w_start, line_idx, w_start + w_len, 8, 1024, 1)
                        # keep cur_var_mode active for the next continuation line

                    # 11. Continuation parameter line in section block (§14.2)
                    eif cur_param_mode != 0 and cur_func_sid != 0 do
                        if is_keyword(first_word as i64) == 0 do
                            var scan_col = c
                            when scan_col < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_col)) == 1 loop scan_col = scan_col + 1 end
                            if scan_col < line_len and native_read_u8(g_doc_text, line_start + scan_col) == 58 do
                                let p_name = copy_sub_string(g_doc_text, line_start + w_start, w_len)
                                var p_type = "unknown" as int
                                scan_col = scan_col + 1
                                when scan_col < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + scan_col)) == 1 loop scan_col = scan_col + 1 end
                                let pt_start = scan_col
                                when scan_col < line_len and (is_alnum(native_read_u8(g_doc_text, line_start + scan_col)) == 1 or native_read_u8(g_doc_text, line_start + scan_col) == 91 or native_read_u8(g_doc_text, line_start + scan_col) == 93) loop scan_col = scan_col + 1 end
                                if scan_col > pt_start do
                                    p_type = copy_sub_string(g_doc_text, line_start + pt_start, scan_col - pt_start)
                                end
                                var p_mod = 1024
                                var p_doc = "Input parameter (by value / read-only)" as int
                                if cur_param_mode == 2 do
                                    p_mod = 131072 # virBorrowed
                                    p_doc = "Reference parameter (mutable borrow &mut)" as int
                                eif cur_param_mode == 3 do
                                    p_mod = 4096 # virOut
                                    p_doc = "Output parameter (destination binding)" as int
                                end
                                let sid = lsp_add_symbol_state_scoped(p_name, 4, line_idx, w_start, w_start + w_len, p_type, p_doc, p_mod, lsp_peek_scope())
                                lsp_add_occ(sid, line_idx, w_start, line_idx, w_start + w_len, 7, p_mod, 1)
                            else
                                cur_param_mode = 0
                                cur_var_mode = 0
                            end
                        else
                            cur_param_mode = 0
                            cur_var_mode = 0
                        end
                    else
                        cur_param_mode = 0
                        cur_var_mode = 0
                    end

                    vir_free(first_word)
                end
            end
            end  # if skip_line == 0

            line_start = p + 1
            line_idx = line_idx + 1
        end

        p = p + 1
    end

    when g_scope_stack_top > 0 loop
        lsp_pop_scope(line_idx)
    end
    if cur_scope_idx >= 0 do
        native_write_i64(g_func_scopes, cur_scope_idx * 24 + 16, line_idx)
        cur_scope_idx = 0 - 1
    end

    # Pass 2: Scan identifier usages & occurrences across document
    p = 0
    line_start = 0
    line_idx = 0

    when p <= g_doc_text_len loop
        var is_eol = 0
        if p == g_doc_text_len do
            is_eol = 1
        eif native_read_u8(g_doc_text, p) == 10 do
            is_eol = 1
        end

        if is_eol == 1 do
            var line_len = p - line_start
            if line_len > 0 and native_read_u8(g_doc_text, line_start + line_len - 1) == 13 do
                line_len = line_len - 1
            end

            let cur_scope = lsp_get_scope_for_line(line_idx)
            var c = 0
            when c < line_len loop
                let ch = native_read_u8(g_doc_text, line_start + c)
                if ch == 35 do # '#' comment skips rest of line
                    break
                end

                # Check Matrix diagnostic: Matrix<...>
                if c + 7 <= line_len and ch == 77 and native_read_u8(g_doc_text, line_start + c + 1) == 97 and native_read_u8(g_doc_text, line_start + c + 2) == 116 and native_read_u8(g_doc_text, line_start + c + 3) == 114 and native_read_u8(g_doc_text, line_start + c + 4) == 105 and native_read_u8(g_doc_text, line_start + c + 5) == 120 and native_read_u8(g_doc_text, line_start + c + 6) == 60 do
                    let m_start = c
                    var m_pos = c + 7
                    var comma_cnt = 0
                    when m_pos < line_len and native_read_u8(g_doc_text, line_start + m_pos) != 62 loop
                        if native_read_u8(g_doc_text, line_start + m_pos) == 44 do
                            comma_cnt = comma_cnt + 1
                        end
                        m_pos = m_pos + 1
                    end
                    if m_pos < line_len and comma_cnt != 1 do
                        let msg = "Matrix shape must have exactly 2 dimensions: Matrix<rows, cols>."
                        lsp_add_diag(line_idx, m_start, line_idx, m_pos + 1, 1, "E3010" as int, msg as int)
                    end
                end

                if is_alpha(ch) == 1 do
                    let w_start = c
                    when c < line_len and is_alnum(native_read_u8(g_doc_text, line_start + c)) == 1 loop
                        c = c + 1
                    end
                    let w_len = c - w_start
                    let word = copy_sub_string(g_doc_text, line_start + w_start, w_len)

                    if is_keyword(word as i64) == 0 do
                        let s_idx = lsp_find_sym_scoped(word, cur_scope, line_idx)
                        if s_idx >= 0 do
                            let s_line = sym_get_line(s_idx)
                            let s_col = sym_get_col(s_idx)
                            # Only add non-declaration references
                            if s_line != line_idx or s_col != w_start do
                                var role = 2 # read
                                var k = c
                                when k < line_len and is_whitespace(native_read_u8(g_doc_text, line_start + k)) == 1 loop k = k + 1 end
                                if k < line_len and native_read_u8(g_doc_text, line_start + k) == 40 do
                                    role = 4 # call
                                eif k < line_len and native_read_u8(g_doc_text, line_start + k) == 61 do
                                    role = 3 # write
                                end

                                var state = 1024 # virAlive
                                let skind = sym_get_kind(s_idx)
                                var tok_type = 8 # variable
                                if skind == 1 do tok_type = 12 end # function
                                if skind == 3 do tok_type = 1 end # type
                                if skind == 4 do
                                    tok_type = 7 # parameter
                                    state = sym_get_state(s_idx)
                                end

                                lsp_add_occ(sym_get_id(s_idx), line_idx, w_start, line_idx, w_start + w_len, tok_type, state, role)
                            end
                        end
                    end
                    vir_free(word)
                else
                    c = c + 1
                end
            end

            line_start = p + 1
            line_idx = line_idx + 1
        end

        p = p + 1
    end

    lspApplyCompilerFacts()
    lsp_sort_occ()
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# JSON-RPC 2.0 Framing & Transport Engine
# ═════════════════════════════════════════════════════════════════════

func lsp_read_byte():
    when lspInputReady() == 0 loop
        lspWorkerTick()
    end
    let buf = vir_alloc(2)
    let n = sys_read(0, buf, 1)
    if n <= 0 do
        vir_free(buf)
        out 0 - 1
    end
    let b = native_read_u8(buf, 0)
    vir_free(buf)
    out b
end.

func lsp_read_header(hdr_buf: int, max_hdr_len: int):
    var count = 0
    var b1 = 0
    var b2 = 0
    var b3 = 0
    var b4 = 0

    loop
        let b = lsp_read_byte()
        if b < 0 do
            out 0 - 1
        end
        if count < max_hdr_len - 1 do
            native_write_u8(hdr_buf, count, b)
            count = count + 1
        end
        b1 = b2
        b2 = b3
        b3 = b4
        b4 = b
        if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 do
            out count
        end
    end
end.

func lsp_parse_content_length(hdr_buf: int, hdr_len: int):
    var i = 0
    let limit = hdr_len - 16
    when i < limit loop
        var match = 1
        let c0 = native_read_u8(hdr_buf, i)
        if c0 != 67 and c0 != 99 do match = 0 end
        if match == 1 do
            if native_read_u8(hdr_buf, i + 1) != 111 do match = 0 end
            if native_read_u8(hdr_buf, i + 2) != 110 do match = 0 end
            if native_read_u8(hdr_buf, i + 3) != 116 do match = 0 end
            if native_read_u8(hdr_buf, i + 4) != 101 do match = 0 end
            if native_read_u8(hdr_buf, i + 5) != 110 do match = 0 end
            if native_read_u8(hdr_buf, i + 6) != 116 do match = 0 end
            if native_read_u8(hdr_buf, i + 7) != 45 do match = 0 end
            let c8 = native_read_u8(hdr_buf, i + 8)
            if c8 != 76 and c8 != 108 do match = 0 end
            if native_read_u8(hdr_buf, i + 9) != 101 do match = 0 end
            if native_read_u8(hdr_buf, i + 10) != 110 do match = 0 end
            if native_read_u8(hdr_buf, i + 11) != 103 do match = 0 end
            if native_read_u8(hdr_buf, i + 12) != 116 do match = 0 end
            if native_read_u8(hdr_buf, i + 13) != 104 do match = 0 end
            if native_read_u8(hdr_buf, i + 14) != 58 do match = 0 end
        end

        if match == 1 do
            var p = i + 15
            when p < hdr_len and native_read_u8(hdr_buf, p) == 32 loop
                p = p + 1
            end
            var num = 0
            when p < hdr_len loop
                let digit = native_read_u8(hdr_buf, p)
                if digit >= 48 and digit <= 57 do
                    num = num * 10 + (digit - 48)
                    p = p + 1
                else
                    out num
                end
            end
            out num
        end
        i = i + 1
    end
    out 0 - 1
end.

func lsp_read_exact(buf: int, len: int):
    var received = 0
    when received < len loop
        when lspInputReady() == 0 loop
            lspWorkerTick()
        end
        let n = sys_read(0, buf + received, len - received)
        if n <= 0 do
            out 0 - 1
        end
        received = received + n
    end
    native_write_u8(buf, len, 0)
    out received
end.

func lsp_send_raw(body_ptr: int, body_len: int):
    if g_analysisSupervisor == 0 & g_workerOutput != 0 do
        let used = native_read_i64(g_workerOutput, 0)
        if used + body_len + 16 >= LSP_WORKER_CAPACITY do sys_exit(1) end
        native_write_i64(g_workerOutput, used + 8, body_len)
        rt_memcpy(g_workerOutput + used + 16, body_ptr, body_len)
        native_write_i64(g_workerOutput, 0, used + body_len + 8)
        out 0
    end
    let hdr_buf = vir_alloc(128)
    let prefix = "Content-Length: "
    let plen = rt_strlen(prefix as i64)
    rt_memcpy(hdr_buf, prefix as int, plen)
    var hpos = plen

    let len_str = rt_itoa(body_len)
    let lslen = rt_strlen(len_str as i64)
    rt_memcpy(hdr_buf + hpos, len_str as int, lslen)
    hpos = hpos + lslen

    let sep = "\r\n\r\n"
    rt_memcpy(hdr_buf + hpos, sep as int, 4)
    hpos = hpos + 4

    sys_write(1, hdr_buf, hpos)
    sys_write(1, body_ptr, body_len)

    vir_free(hdr_buf)
end.

func lsp_send_response(id_val: int, result_json: string):
    let lres = rt_strlen(result_json as i64)
    let body_buf = vir_alloc(lres + 256)
    if body_buf == 0 do out 0 end
    var pos = 0

    let p1 = "{\"jsonrpc\":\"2.0\",\"id\":"
    let lp1 = rt_strlen(p1 as i64)
    rt_memcpy(body_buf + pos, p1 as int, lp1)
    pos = pos + lp1

    let id_str = rt_itoa(id_val)
    let lid = rt_strlen(id_str as i64)
    rt_memcpy(body_buf + pos, id_str as int, lid)
    pos = pos + lid

    let p2 = ",\"result\":"
    let lp2 = rt_strlen(p2 as i64)
    rt_memcpy(body_buf + pos, p2 as int, lp2)
    pos = pos + lp2

    rt_memcpy(body_buf + pos, result_json as int, lres)
    pos = pos + lres

    native_write_u8(body_buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(body_buf, pos, 0)

    lsp_send_raw(body_buf, pos)
    vir_free(body_buf)
end.

func lsp_send_error(id_val: int, code: int, msg: &string):
    let lmsg = rt_strlen(msg as i64)
    let body_buf = vir_alloc(lmsg + 256)
    if body_buf == 0 do out 0 end
    var pos = 0

    let p1 = "{\"jsonrpc\":\"2.0\",\"id\":"
    let lp1 = rt_strlen(p1 as i64)
    rt_memcpy(body_buf + pos, p1 as int, lp1)
    pos = pos + lp1

    let id_str = rt_itoa(id_val)
    let lid = rt_strlen(id_str as i64)
    rt_memcpy(body_buf + pos, id_str as int, lid)
    pos = pos + lid

    let p2 = ",\"error\":{\"code\":"
    let lp2 = rt_strlen(p2 as i64)
    rt_memcpy(body_buf + pos, p2 as int, lp2)
    pos = pos + lp2

    let c_str = rt_itoa(code)
    let lc = rt_strlen(c_str as i64)
    rt_memcpy(body_buf + pos, c_str as int, lc)
    pos = pos + lc

    let p3 = ",\"message\":\""
    let lp3 = rt_strlen(p3 as i64)
    rt_memcpy(body_buf + pos, p3 as int, lp3)
    pos = pos + lp3

    rt_memcpy(body_buf + pos, msg as int, lmsg)
    pos = pos + lmsg

    let p4 = "\"}}"
    rt_memcpy(body_buf + pos, p4 as int, 3)
    pos = pos + 3
    native_write_u8(body_buf, pos, 0)

    lsp_send_raw(body_buf, pos)
    vir_free(body_buf)
end.

func lsp_send_null_response(id_val: int):
    let body_buf = vir_alloc(512)
    var pos = 0

    let p1 = "{\"jsonrpc\":\"2.0\",\"id\":"
    let lp1 = rt_strlen(p1 as i64)
    rt_memcpy(body_buf + pos, p1 as int, lp1)
    pos = pos + lp1

    let id_str = rt_itoa(id_val)
    let lid = rt_strlen(id_str as i64)
    rt_memcpy(body_buf + pos, id_str as int, lid)
    pos = pos + lid

    let p2 = ",\"result\":null}"
    let lp2 = rt_strlen(p2 as i64)
    rt_memcpy(body_buf + pos, p2 as int, lp2)
    pos = pos + lp2
    native_write_u8(body_buf, pos, 0)

    lsp_send_raw(body_buf, pos)
    vir_free(body_buf)
end.

func lsp_send_notification(method_name: string, params_json: string):
    let lmeth = rt_strlen(method_name as i64)
    let lpar = rt_strlen(params_json as i64)
    let body_buf = vir_alloc(lmeth + lpar + 64)
    var pos = 0

    let p1 = "{\"jsonrpc\":\"2.0\",\"method\":\""
    let lp1 = rt_strlen(p1 as i64)
    rt_memcpy(body_buf + pos, p1 as int, lp1)
    pos = pos + lp1

    rt_memcpy(body_buf + pos, method_name as int, lmeth)
    pos = pos + lmeth

    let p2 = "\",\"params\":"
    let lp2 = rt_strlen(p2 as i64)
    rt_memcpy(body_buf + pos, p2 as int, lp2)
    pos = pos + lp2

    rt_memcpy(body_buf + pos, params_json as int, lpar)
    pos = pos + lpar

    native_write_u8(body_buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(body_buf, pos, 0)

    lsp_send_raw(body_buf, pos)
    vir_free(body_buf)
end.

func lsp_publish_diagnostics():
    if g_analysisSupervisor == 1 do
        lspRunAnalysisWorker(0, 0, 0 - 1)
        out 0
    end
    g_diagPublishSource = g_rootSource
    lspPublishSourceDiagnostics()
    var sourceEntry = g_ideVirtualFiles
    when sourceEntry != 0 loop
        if sourceEntry != g_rootSource do
            let path = native_read_i64(native_read_i64(sourceEntry, 8), 0)
            var included = 0
            var moduleIndex = 0
            when moduleIndex < vec_len_rt(g_ideResolvedModules) loop
                let entry = vec_get_rt(g_ideResolvedModules, moduleIndex)
                let resolvedPath = native_read_i64(entry, 16)
                if resolvedPath != 0 do
                    if rt_streq(path, resolvedPath) == 1 do included = 1 end
                end
                moduleIndex = moduleIndex + 1
            end
            if included == 1 do
                g_diagPublishSource = sourceEntry
                lspPublishSourceDiagnostics()
            end
        end
        sourceEntry = native_read_i64(sourceEntry, 0)
    end
    out 0
end.

func lspPublishSourceDiagnostics():
    if g_doc_uri == 0 do out 0 end
    let sourceUri = lspSourceUri(g_diagPublishSource)
    let uri_len = rt_strlen(sourceUri)
    var diagnosticCapacity = uri_len * 6 + g_diag_count * 256 + 256
    var capacityIndex = 0
    when capacityIndex < g_diag_count loop
        diagnosticCapacity = diagnosticCapacity + rt_strlen(native_read_i64(g_diag_table, capacityIndex * 72 + 48)) * 6
        let diagnosticRecord = native_read_i64(g_diag_table, capacityIndex * 72 + 64)
        if diagnosticRecord != 0 do
            let note = native_read_i64(diagnosticRecord, 56)
            if note != 0 do diagnosticCapacity = diagnosticCapacity + rt_strlen(note) * 6 + 512 end
            let secondaryPath = native_read_i64(diagnosticRecord, 96)
            if secondaryPath != 0 do diagnosticCapacity = diagnosticCapacity + rt_strlen(secondaryPath) * 18 + 128 end
        end
        capacityIndex = capacityIndex + 1
    end
    let body_buf = vir_alloc(diagnosticCapacity)
    var pos = 0

    let p1 = "{\"uri\":\""
    let lp1 = rt_strlen(p1 as i64)
    rt_memcpy(body_buf + pos, p1 as int, lp1)
    pos = pos + lp1

    let escapedUri = lspJsonEscape(sourceUri)
    rt_memcpy(body_buf + pos, escapedUri, rt_strlen(escapedUri))
    pos = pos + rt_strlen(escapedUri) - uri_len
    vir_free(escapedUri)
    pos = pos + uri_len

    let p2 = "\",\"version\":"
    let lp2 = rt_strlen(p2 as i64)
    rt_memcpy(body_buf + pos, p2 as int, lp2)
    pos = pos + lp2

    var version = g_doc_version
    if g_diagPublishSource != 0 do version = native_read_i64(g_diagPublishSource, 32) end
    var v_str = "null" as int
    if version >= 0 do v_str = rt_itoa(version) end
    let lv = rt_strlen(v_str as i64)
    rt_memcpy(body_buf + pos, v_str as int, lv)
    pos = pos + lv

    let p3 = ",\"diagnostics\":["
    let lp3 = rt_strlen(p3 as i64)
    rt_memcpy(body_buf + pos, p3 as int, lp3)
    pos = pos + lp3

    var i = 0
    var emitted = 0
    when i < g_diag_count loop
        var diagnosticSource = native_read_i64(g_diag_table, i * 72 + 56)
        if diagnosticSource == 0 do diagnosticSource = g_rootSource end
        if diagnosticSource != g_diagPublishSource do
            i = i + 1
            skip
        end
        if emitted > 0 do
            native_write_u8(body_buf, pos, 44) # ','
            pos = pos + 1
        end
        let d_line = native_read_i64(g_diag_table, i * 72 + 0)
        let d_col = native_read_i64(g_diag_table, i * 72 + 8)
        let d_eline = native_read_i64(g_diag_table, i * 72 + 16)
        let d_ecol = native_read_i64(g_diag_table, i * 72 + 24)
        let d_sev = native_read_i64(g_diag_table, i * 72 + 32)
        let d_code = native_read_i64(g_diag_table, i * 72 + 40)
        let d_msg = native_read_i64(g_diag_table, i * 72 + 48)

        # Append single diagnostic JSON
        let sub = "{\"range\":{\"start\":{\"line\":"
        let lsub = rt_strlen(sub as i64)
        rt_memcpy(body_buf + pos, sub as int, lsub)
        pos = pos + lsub

        let s1 = rt_itoa(d_line)
        rt_memcpy(body_buf + pos, s1 as int, rt_strlen(s1 as i64))
        pos = pos + rt_strlen(s1 as i64)

        let sub2 = ",\"character\":"
        rt_memcpy(body_buf + pos, sub2 as int, rt_strlen(sub2 as i64))
        pos = pos + rt_strlen(sub2 as i64)

        let s2 = rt_itoa(lspSourceUtf16(g_diagPublishSource, d_line, d_col))
        rt_memcpy(body_buf + pos, s2 as int, rt_strlen(s2 as i64))
        pos = pos + rt_strlen(s2 as i64)

        let sub3 = "},\"end\":{\"line\":"
        rt_memcpy(body_buf + pos, sub3 as int, rt_strlen(sub3 as i64))
        pos = pos + rt_strlen(sub3 as i64)

        let s3 = rt_itoa(d_eline)
        rt_memcpy(body_buf + pos, s3 as int, rt_strlen(s3 as i64))
        pos = pos + rt_strlen(s3 as i64)

        let sub4 = ",\"character\":"
        rt_memcpy(body_buf + pos, sub4 as int, rt_strlen(sub4 as i64))
        pos = pos + rt_strlen(sub4 as i64)

        let s4 = rt_itoa(lspSourceUtf16(g_diagPublishSource, d_eline, d_ecol))
        rt_memcpy(body_buf + pos, s4 as int, rt_strlen(s4 as i64))
        pos = pos + rt_strlen(s4 as i64)

        let sub5 = "}},\"severity\":"
        rt_memcpy(body_buf + pos, sub5 as int, rt_strlen(sub5 as i64))
        pos = pos + rt_strlen(sub5 as i64)

        let s5 = rt_itoa(d_sev)
        rt_memcpy(body_buf + pos, s5 as int, rt_strlen(s5 as i64))
        pos = pos + rt_strlen(s5 as i64)

        let sub6 = ",\"code\":\""
        rt_memcpy(body_buf + pos, sub6 as int, rt_strlen(sub6 as i64))
        pos = pos + rt_strlen(sub6 as i64)

        rt_memcpy(body_buf + pos, d_code as int, rt_strlen(d_code as i64))
        pos = pos + rt_strlen(d_code as i64)

        let sub7 = "\",\"message\":\""
        rt_memcpy(body_buf + pos, sub7 as int, rt_strlen(sub7 as i64))
        pos = pos + rt_strlen(sub7 as i64)

        let escapedMessage = lspJsonEscape(d_msg)
        rt_memcpy(body_buf + pos, escapedMessage, rt_strlen(escapedMessage))
        pos = pos + rt_strlen(escapedMessage)
        vir_free(escapedMessage)
        emitted = emitted + 1

        native_write_u8(body_buf, pos, 34) # '"'
        pos = pos + 1
        pos = lspAppendRelatedDiagnostic(body_buf, pos, native_read_i64(g_diag_table, i * 72 + 64))
        native_write_u8(body_buf, pos, 125) # '}'
        pos = pos + 1

        i = i + 1
    end

    native_write_u8(body_buf, pos, 93) # ']'
    pos = pos + 1
    native_write_u8(body_buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(body_buf, pos, 0)

    lsp_send_notification("textDocument/publishDiagnostics", body_buf as string)
    vir_free(body_buf)
    out 0
end.

func lsp_get_capabilities_json():
    out "{\"capabilities\":{\"positionEncoding\":\"utf-16\",\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]},\"renameProvider\":{\"prepareProvider\":true},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"event\",\"function\",\"method\",\"macro\",\"keyword\",\"modifier\",\"comment\",\"string\",\"number\",\"regexp\",\"operator\"],\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"static\",\"deprecated\",\"abstract\",\"async\",\"modification\",\"documentation\",\"defaultLibrary\",\"virAlive\",\"virMoved\",\"virOut\",\"virInvalid\",\"virInactive\",\"virUnresolved\",\"virLastUse\",\"virBorrowed\",\"virMaybeMoved\"]},\"full\":true},\"experimental\":{\"vir\":{\"schemaVersion\":1,\"semanticSnapshot\":true,\"diagnosticSnapshot\":true,\"focusLifetime\":true,\"semanticTokenModifiers\":[\"virAlive\",\"virMoved\",\"virOut\",\"virInvalid\",\"virInactive\",\"virUnresolved\",\"virLastUse\",\"virBorrowed\",\"virMaybeMoved\"]}}},\"serverInfo\":{\"name\":\"vir-lsp\",\"version\":\"1.3.0\"}}"
end.

# ═════════════════════════════════════════════════════════════════════
# LSP Request Handlers & Serializers
# ═════════════════════════════════════════════════════════════════════

func lsp_handle_hover(id_val: int, line: int, col: int):
    let byte_col = lsp_utf16_col_to_byte(line, col)
    let s_idx = lsp_find_sym_at(line, byte_col)
    if s_idx < 0 do
        if g_doc_text != 0 and g_doc_text_len > 0 do
            let l_start = lsp_get_line_start(line)
            var l_len = 0
            when (l_start + l_len) < g_doc_text_len and native_read_u8(g_doc_text, l_start + l_len) != 10 and native_read_u8(g_doc_text, l_start + l_len) != 13 loop
                l_len = l_len + 1
            end
            if byte_col < l_len do
                var w_start = byte_col
                when w_start > 0 and is_alnum(native_read_u8(g_doc_text, l_start + w_start - 1)) == 1 loop
                    w_start = w_start - 1
                end
                var w_end = byte_col
                when w_end < l_len and is_alnum(native_read_u8(g_doc_text, l_start + w_end)) == 1 loop
                    w_end = w_end + 1
                end
                if w_end > w_start do
                    let kw = copy_sub_string(g_doc_text, l_start + w_start, w_end - w_start)
                    var kw_doc = 0
                    if rt_streq(kw as i64, "in" as i64) == 1 do
                        kw_doc = "`in` — Parameter modifier / section header for by-value input parameters (read-only or moved/consumed)." as int
                    eif rt_streq(kw as i64, "ref" as i64) == 1 do
                        kw_doc = "`ref` — Parameter modifier / section header for mutable borrowed reference parameters (`&mut`), must be initialized before call." as int
                    eif rt_streq(kw as i64, "out" as i64) == 1 do
                        kw_doc = "`out` — Function return statement (`out expr`) or output parameter modifier / section header (caller passes uninitialized/destination binding, callee must assign before exit)." as int
                    eif rt_streq(kw as i64, "func" as i64) == 1 do
                        kw_doc = "`func` — Function declaration keyword. Closes with `end.`." as int
                    eif rt_streq(kw as i64, "entity" as i64) == 1 do
                        kw_doc = "`entity` — Entity type definition keyword. Closes with `end.`." as int
                    eif rt_streq(kw as i64, "let" as i64) == 1 do
                        kw_doc = "`let` — Immutable local binding declaration." as int
                    eif rt_streq(kw as i64, "var" as i64) == 1 do
                        kw_doc = "`var` — Mutable local variable declaration." as int
                    eif rt_streq(kw as i64, "shr" as i64) == 1 or rt_streq(kw as i64, "bit_shr" as i64) == 1 do
                        kw_doc = "`a shr n` — bitwise shift right. `>>` is type cast, not shift." as int
                    eif rt_streq(kw as i64, "shl" as i64) == 1 or rt_streq(kw as i64, "bit_shl" as i64) == 1 do
                        kw_doc = "`a shl n` — bitwise shift left." as int
                    eif rt_streq(kw as i64, "of" as i64) == 1 do
                        kw_doc = "`of` — Generic specialization delimiter: `Type of (T1, T2)`." as int
                    eif rt_streq(kw as i64, "enum" as i64) == 1 do
                        kw_doc = "`enum` — Enumerated type declaration. Closes with `end.`." as int
                    eif rt_streq(kw as i64, "type" as i64) == 1 do
                        kw_doc = "`type` — Type alias or declaration." as int
                    end
                    if kw_doc != 0 do
                        let kbuf = vir_alloc(1024)
                        var kpos = 0
                        let kp1 = "{\"contents\":{\"kind\":\"markdown\",\"value\":\""
                        rt_memcpy(kbuf + kpos, kp1 as int, rt_strlen(kp1 as i64))
                        kpos = kpos + rt_strlen(kp1 as i64)
                        rt_memcpy(kbuf + kpos, kw_doc, rt_strlen(kw_doc as i64))
                        kpos = kpos + rt_strlen(kw_doc as i64)
                        let kp2 = "\"}}"
                        rt_memcpy(kbuf + kpos, kp2 as int, rt_strlen(kp2 as i64))
                        kpos = kpos + rt_strlen(kp2 as i64)
                        native_write_u8(kbuf, kpos, 0)
                        lsp_send_response(id_val, kbuf as string)
                        vir_free(kbuf)
                        vir_free(kw)
                        out 0
                    end

                    if lspCompilerExpressionHover(id_val, line, byte_col) == 1 do
                        vir_free(kw)
                        out 0
                    end

                    if rt_streq(kw as i64, "int" as i64) == 1 or rt_streq(kw as i64, "i64" as i64) == 1 or rt_streq(kw as i64, "i32" as i64) == 1 do
                        kw_doc = "### type `int`\\n\\n64-bit signed integer type." as int
                    eif rt_streq(kw as i64, "float" as i64) == 1 or rt_streq(kw as i64, "f64" as i64) == 1 or rt_streq(kw as i64, "f32" as i64) == 1 do
                        kw_doc = "### type `float`\\n\\n64-bit IEEE 754 floating-point type." as int
                    eif rt_streq(kw as i64, "string" as i64) == 1 do
                        kw_doc = "### type `string`\\n\\nUTF-8 string fat pointer (data + length)." as int
                    eif rt_streq(kw as i64, "bool" as i64) == 1 do
                        kw_doc = "### type `bool`\\n\\nBoolean truth type (`true` or `false`)." as int
                    eif rt_streq(kw as i64, "Matrix" as i64) == 1 do
                        kw_doc = "### type `Matrix<rows, cols>`\\n\\n2D tensor type with compile-time verified static shape metadata." as int
                    eif rt_streq(kw as i64, "Vector" as i64) == 1 do
                        kw_doc = "### type `Vector<n>`\\n\\n1D tensor vector type with static dimension." as int
                    eif rt_streq(kw as i64, "matmul" as i64) == 1 do
                        kw_doc = "### func `matmul(a, b)`\\n\\nMultiplies matrix/tensor values with compile-time shape verification." as int
                    eif rt_streq(kw as i64, "grad" as i64) == 1 do
                        kw_doc = "### func `grad(x)`\\n\\nComputes analytical gradient for automatic differentiation." as int
                    eif rt_streq(kw as i64, "embed" as i64) == 1 do
                        kw_doc = "### func `embed(x)`\\n\\nProjects tokens/identifiers into vector embedding space." as int
                    eif rt_streq(kw as i64, "train" as i64) == 1 do
                        kw_doc = "### func `train(params, grads)`\\n\\nApplies parameter gradient updates for model training." as int
                    eif rt_streq(kw as i64, "print" as i64) == 1 or rt_streq(kw as i64, "println" as i64) == 1 do
                        kw_doc = "### func `print(val)`\\n\\nBuilt-in console output function." as int
                    eif rt_streq(kw as i64, "assert" as i64) == 1 or rt_streq(kw as i64, "panic" as i64) == 1 do
                        kw_doc = "### func `assert(cond)` / `panic(msg)`\\n\\nRuntime invariant check and fatal termination." as int
                    eif rt_streq(kw as i64, "true" as i64) == 1 or rt_streq(kw as i64, "false" as i64) == 1 do
                        kw_doc = "### literal `bool`\\n\\nBoolean literal value." as int
                    eif is_digit(native_read_u8(kw, 0)) == 1 do
                        kw_doc = 0
                    end
                    if kw_doc != 0 do
                        let kbuf = vir_alloc(1024)
                        var kpos = 0
                        let kp1 = "{\"contents\":{\"kind\":\"markdown\",\"value\":\""
                        rt_memcpy(kbuf + kpos, kp1 as int, rt_strlen(kp1 as i64))
                        kpos = kpos + rt_strlen(kp1 as i64)
                        rt_memcpy(kbuf + kpos, kw_doc, rt_strlen(kw_doc as i64))
                        kpos = kpos + rt_strlen(kw_doc as i64)
                        let kp2 = "\"}}"
                        rt_memcpy(kbuf + kpos, kp2 as int, rt_strlen(kp2 as i64))
                        kpos = kpos + rt_strlen(kp2 as i64)
                        native_write_u8(kbuf, kpos, 0)
                        lsp_send_response(id_val, kbuf as string)
                        vir_free(kbuf)
                        vir_free(kw)
                        out 0
                    end
                    vir_free(kw)
                end
            end
        end
        if lspCompilerExpressionHover(id_val, line, byte_col) == 1 do out 0 end
        lsp_send_null_response(id_val)
        out 0
    end

    let s_name = sym_get_name(s_idx)
    let s_kind = sym_get_kind(s_idx)
    let s_sig = sym_get_type_desc(s_idx)
    let s_id = sym_get_id(s_idx)

    var kind_str = "variable"
    if s_kind == 1 do kind_str = "function" end
    if s_kind == 3 do kind_str = "type" end
    if s_kind == 4 do kind_str = "parameter" end

    let buf = vir_alloc(1024 + 6 * (rt_strlen(s_name) + rt_strlen(s_sig) + rt_strlen(sym_get_doc(s_idx))))
    var pos = 0
    let p1 = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### "
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    rt_memcpy(buf + pos, kind_str as int, rt_strlen(kind_str as i64))
    pos = pos + rt_strlen(kind_str as i64)

    let p2 = " `"
    rt_memcpy(buf + pos, p2 as int, 2)
    pos = pos + 2

    let esc_name = lspJsonEscape(s_name)
    rt_memcpy(buf + pos, esc_name as int, rt_strlen(esc_name as i64))
    pos = pos + rt_strlen(esc_name as i64)
    vir_free(esc_name)

    let p3 = "`: `"
    rt_memcpy(buf + pos, p3 as int, 4)
    pos = pos + 4

    let esc_sig = lspJsonEscape(s_sig)
    rt_memcpy(buf + pos, esc_sig as int, rt_strlen(esc_sig as i64))
    pos = pos + rt_strlen(esc_sig as i64)
    vir_free(esc_sig)

    let p4 = "`\\n\\n*Status*: `active` · *Symbol ID*: `#"
    rt_memcpy(buf + pos, p4 as int, rt_strlen(p4 as i64))
    pos = pos + rt_strlen(p4 as i64)

    let sid_str = rt_itoa(s_id)
    rt_memcpy(buf + pos, sid_str as int, rt_strlen(sid_str as i64))
    pos = pos + rt_strlen(sid_str as i64)

    if s_kind == 4 do
        let s_st = sym_get_state(s_idx)
        if s_st == 131072 do
            let p_mod_str = "` · *Modifier*: `virBorrowed` (`ref`)"
            rt_memcpy(buf + pos, p_mod_str as int, rt_strlen(p_mod_str as i64))
            pos = pos + rt_strlen(p_mod_str as i64)
        eif s_st == 4096 do
            let p_mod_str = "` · *Modifier*: `virOut` (`out`)"
            rt_memcpy(buf + pos, p_mod_str as int, rt_strlen(p_mod_str as i64))
            pos = pos + rt_strlen(p_mod_str as i64)
        else
            let p_mod_str = "` · *Modifier*: `virAlive` (`in`)"
            rt_memcpy(buf + pos, p_mod_str as int, rt_strlen(p_mod_str as i64))
            pos = pos + rt_strlen(p_mod_str as i64)
        end
    else
        let p_end_tick = "`"
        rt_memcpy(buf + pos, p_end_tick as int, 1)
        pos = pos + 1
    end

    let s_doc = sym_get_doc(s_idx)
    if s_doc != 0 do
        let p_doc_sep = "\\n\\n"
        rt_memcpy(buf + pos, p_doc_sep as int, 4)
        pos = pos + 4
        let esc_doc = lspJsonEscape(s_doc)
        rt_memcpy(buf + pos, esc_doc as int, rt_strlen(esc_doc as i64))
        pos = pos + rt_strlen(esc_doc as i64)
        vir_free(esc_doc)
    end

    let p5 = "\"}}"
    rt_memcpy(buf + pos, p5 as int, rt_strlen(p5 as i64))
    pos = pos + rt_strlen(p5 as i64)
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

func lsp_handle_definition(id_val: int, line: int, col: int):
    let byte_col = lsp_utf16_col_to_byte(line, col)
    let s_idx = lsp_find_sym_at(line, byte_col)
    if s_idx < 0 do
        lsp_send_null_response(id_val)
        out 0
    end

    let source = native_read_i64(g_sym_table, s_idx * 88 + 80)
    var uri_to_send = lspSourceUri(source)
    if uri_to_send == 0 do
        uri_to_send = "file:///workspace/main.vri" as int
    end

    let s_line = sym_get_line(s_idx)
    let s_col = sym_get_col(s_idx)
    let s_end = sym_get_end_col(s_idx)

    let buf = vir_alloc(rt_strlen(uri_to_send) * 6 + 1024)
    var pos = 0

    let p1 = "{\"uri\":\""
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    rt_memcpy(buf + pos, uri_to_send as int, rt_strlen(uri_to_send as i64))
    pos = pos + rt_strlen(uri_to_send as i64)

    let p2 = "\",\"range\":{\"start\":{\"line\":"
    rt_memcpy(buf + pos, p2 as int, rt_strlen(p2 as i64))
    pos = pos + rt_strlen(p2 as i64)

    let l_str = rt_itoa(s_line)
    rt_memcpy(buf + pos, l_str as int, rt_strlen(l_str as i64))
    pos = pos + rt_strlen(l_str as i64)

    let p3 = ",\"character\":"
    rt_memcpy(buf + pos, p3 as int, rt_strlen(p3 as i64))
    pos = pos + rt_strlen(p3 as i64)

    let c_str = rt_itoa(lspSourceUtf16(source, s_line, s_col))
    rt_memcpy(buf + pos, c_str as int, rt_strlen(c_str as i64))
    pos = pos + rt_strlen(c_str as i64)

    let p4 = "},\"end\":{\"line\":"
    rt_memcpy(buf + pos, p4 as int, rt_strlen(p4 as i64))
    pos = pos + rt_strlen(p4 as i64)

    rt_memcpy(buf + pos, l_str as int, rt_strlen(l_str as i64))
    pos = pos + rt_strlen(l_str as i64)

    let p5 = ",\"character\":"
    rt_memcpy(buf + pos, p5 as int, rt_strlen(p5 as i64))
    pos = pos + rt_strlen(p5 as i64)

    let ec_str = rt_itoa(lspSourceUtf16(source, s_line, s_end))
    rt_memcpy(buf + pos, ec_str as int, rt_strlen(ec_str as i64))
    pos = pos + rt_strlen(ec_str as i64)

    let p6 = "}}}"
    rt_memcpy(buf + pos, p6 as int, 3)
    pos = pos + 3
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

func lsp_handle_references(id_val: int, line: int, col: int):
    let byte_col = lsp_utf16_col_to_byte(line, col)
    let s_idx = lsp_find_sym_at(line, byte_col)
    if s_idx < 0 do
        lsp_send_response(id_val, "[]")
        out 0
    end

    let target_id = sym_get_id(s_idx)
    var uri_to_send = g_doc_uri
    if uri_to_send == 0 do
        uri_to_send = "file:///workspace/main.vri" as int
    end

    var capacity = 256
    var ri = 0
    when ri < g_occ_count loop
        capacity = capacity + rt_strlen(lspSourceUri(native_read_i64(g_occ_table, ri * 88 + 64))) * 6 + 192
        ri = ri + 1
    end
    let buf = vir_alloc(capacity)
    var pos = 0
    native_write_u8(buf, pos, 91) # '['
    pos = pos + 1

    var match_count = 0
    var oi = 0
    when oi < g_occ_count loop
        if native_read_i64(g_occ_table, oi * 88 + 0) == target_id do
            if match_count > 0 do
                native_write_u8(buf, pos, 44) # ','
                pos = pos + 1
            end
            let source = native_read_i64(g_occ_table, oi * 88 + 64)
            uri_to_send = lspSourceUri(source)
            let o_line = native_read_i64(g_occ_table, oi * 88 + 8)
            let o_col = native_read_i64(g_occ_table, oi * 88 + 16)
            let o_ecol = native_read_i64(g_occ_table, oi * 88 + 32)

            let p1 = "{\"uri\":\""
            rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
            pos = pos + rt_strlen(p1 as i64)

            rt_memcpy(buf + pos, uri_to_send as int, rt_strlen(uri_to_send as i64))
            pos = pos + rt_strlen(uri_to_send as i64)

            let p2 = "\",\"range\":{\"start\":{\"line\":"
            rt_memcpy(buf + pos, p2 as int, rt_strlen(p2 as i64))
            pos = pos + rt_strlen(p2 as i64)

            let l1 = rt_itoa(o_line)
            rt_memcpy(buf + pos, l1 as int, rt_strlen(l1 as i64))
            pos = pos + rt_strlen(l1 as i64)

            let p3 = ",\"character\":"
            rt_memcpy(buf + pos, p3 as int, rt_strlen(p3 as i64))
            pos = pos + rt_strlen(p3 as i64)

            let c1 = rt_itoa(lspSourceUtf16(source, o_line, o_col))
            rt_memcpy(buf + pos, c1 as int, rt_strlen(c1 as i64))
            pos = pos + rt_strlen(c1 as i64)

            let p4 = "},\"end\":{\"line\":"
            rt_memcpy(buf + pos, p4 as int, rt_strlen(p4 as i64))
            pos = pos + rt_strlen(p4 as i64)

            rt_memcpy(buf + pos, l1 as int, rt_strlen(l1 as i64))
            pos = pos + rt_strlen(l1 as i64)

            let p5 = ",\"character\":"
            rt_memcpy(buf + pos, p5 as int, rt_strlen(p5 as i64))
            pos = pos + rt_strlen(p5 as i64)

            let c2 = rt_itoa(lspSourceUtf16(source, o_line, o_ecol))
            rt_memcpy(buf + pos, c2 as int, rt_strlen(c2 as i64))
            pos = pos + rt_strlen(c2 as i64)

            let p6 = "}}}"
            rt_memcpy(buf + pos, p6 as int, 3)
            pos = pos + 3

            match_count = match_count + 1
        end
        oi = oi + 1
    end

    native_write_u8(buf, pos, 93) # ']'
    pos = pos + 1
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

func lsp_handle_completion(id_val: int, q_line: int, q_col: int):
    var completionCapacity = 8192
    var capacitySymbol = 0
    when capacitySymbol < g_sym_count loop
        completionCapacity = completionCapacity + rt_strlen(sym_get_name(capacitySymbol)) + rt_strlen(sym_get_type_desc(capacitySymbol)) + 192
        capacitySymbol = capacitySymbol + 1
    end
    let buf = vir_alloc(completionCapacity)
    var pos = 0

    let p1 = "{\"isIncomplete\":true,\"items\":["
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    # Check if this is a receiver member completion (cursor preceded by '.')
    let byte_col = lsp_utf16_col_to_byte(q_line, q_col)
    let l_start = lsp_get_line_start(q_line)
    var is_member = 0
    var check_pos = byte_col - 1
    when check_pos >= 0 and native_read_u8(g_doc_text, l_start + check_pos) == 32 loop
        check_pos = check_pos - 1
    end
    if check_pos >= 0 and native_read_u8(g_doc_text, l_start + check_pos) == 46 do
        is_member = 1
    end

    if is_member == 1 do
        pos = lspAppendCompilerMembers(buf, pos, q_line, check_pos)
    else
        # Keywords & types
        let kw = "{\"label\":\"func\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"let\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"var\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"out\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"in\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"ref\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"entity\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"enum\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"type\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"of\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"shr\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"shl\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"if\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"eif\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"else\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"when\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"loop\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"for\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"try\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"revert\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"ensure\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"throw\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"include\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"import\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"export\",\"kind\":14,\"detail\":\"Vir keyword\"},{\"label\":\"int\",\"kind\":7,\"detail\":\"Vir type\"},{\"label\":\"float\",\"kind\":7,\"detail\":\"Vir type\"},{\"label\":\"string\",\"kind\":7,\"detail\":\"Vir type\"},{\"label\":\"bool\",\"kind\":7,\"detail\":\"Vir type\"},{\"label\":\"Matrix\",\"kind\":7,\"detail\":\"Vir tensor type\"},{\"label\":\"Vector\",\"kind\":7,\"detail\":\"Vir tensor type\"}"
        rt_memcpy(buf + pos, kw as int, rt_strlen(kw as i64))
        pos = pos + rt_strlen(kw as i64)

        # Symbols visible in current lexical scope
        var cur_scope = lsp_get_scope_for_line(q_line)
        if g_compilerAnalysisAvailable == 1 do cur_scope = lspCompilerScopeAt(q_line) end
        var si = 0
        when si < g_sym_count loop
            let s_scope = sym_get_scope_id(si)
            var visible = 0
            if s_scope == 0 do
                visible = 1
            eif lsp_is_ancestor_scope(s_scope, cur_scope) == 1 do
                visible = 1
            end

            if g_compilerAnalysisAvailable == 1 do
                visible = 0
                if lspCompilerFindVisible(sym_get_name(si), q_line) == si do visible = 1 end
            end

            if visible == 1 do
                native_write_u8(buf, pos, 44) # ','
                pos = pos + 1

                let sname = sym_get_name(si)
                let skind = sym_get_kind(si)
                var ckind = 6 # variable
                if skind == 1 do ckind = 3 end # function
                if skind == 3 do ckind = 7 end # type
                if skind == 4 do ckind = 6 end # parameter

                let p_item = "{\"label\":\""
                rt_memcpy(buf + pos, p_item as int, rt_strlen(p_item as i64))
                pos = pos + rt_strlen(p_item as i64)

                let esc_sname = lspJsonEscape(sname)
                rt_memcpy(buf + pos, esc_sname as int, rt_strlen(esc_sname as i64))
                pos = pos + rt_strlen(esc_sname as i64)
                vir_free(esc_sname)

                let p_k = "\",\"kind\":"
                rt_memcpy(buf + pos, p_k as int, rt_strlen(p_k as i64))
                pos = pos + rt_strlen(p_k as i64)

                let k_str = rt_itoa(ckind)
                rt_memcpy(buf + pos, k_str as int, rt_strlen(k_str as i64))
                pos = pos + rt_strlen(k_str as i64)

                let p_end = "}"
                rt_memcpy(buf + pos, p_end as int, 1)
                pos = pos + 1
            end

            si = si + 1
        end
    end

    native_write_u8(buf, pos, 93) # ']'
    pos = pos + 1
    native_write_u8(buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

# Unresolved member/UFCS facts can refer to a declaration with the same name.
# Until the compiler exports their binding ID, no partial rename is safe.
func lspCompilerImportsComplete() -> int:
    var index = 0
    when index < vec_len_rt(g_ideResolvedModules) loop
        let moduleEntry = vec_get_rt(g_ideResolvedModules, index)
        if native_read_i64(moduleEntry, 40) != 1 do out 0 end
        index = index + 1
    end
    index = 0
    when index < vec_len_rt(g_ideImportOrigins) loop
        let origin = vec_get_rt(g_ideImportOrigins, index)
        if lspCompilerImportToken(origin) == 0 do out 0 end
        index = index + 1
    end
    out 1
end.

func lspCompilerRenameCoverage(symbolIndex: int) -> int:
    if lspCompilerUnsupportedGraph(g_ideSessionAst) == 1 do out 0 end
    if g_compilerAnalysisAvailable == 0 || g_ideSessionErrors > 0 do out 0 end
    if g_ideHasImports > 0 do
        if lspCompilerImportsComplete() == 0 do out 0 end
        let symbolFact = native_read_i64(g_compilerSymbolFacts, symbolIndex * 8)
        if symbolFact == 0 do out 0 end
        let importOrigin = lspCompilerImportOrigin(symbolFact)
        if importOrigin != 0 do
            if lspCompilerImportToken(importOrigin) == 0 do out 0 end
        end
    end
    if native_read_i64(g_compilerSymbolCoverage, symbolIndex * 8) == 0 do out 0 end
    let name = sym_get_name(symbolIndex)
    var index = 0
    when index < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, index)
        let kind = native_read_i64(fact, 104)
        if (kind == 41 || kind == 62) & native_read_i64(fact, 8) < 0 do
            let memberName = native_read_i64(fact, 96)
            if memberName != 0 do
                if fat_cstr_eq(memberName, name) == 1 do out 0 end
            end
        end
        index = index + 1
    end
    out 1
end.

func lsp_handle_prepare_rename(id_val: int, line: int, col: int):
    let byte_col = lsp_utf16_col_to_byte(line, col)
    let s_idx = lsp_find_sym_at(line, byte_col)
    if s_idx < 0 do
        lsp_send_null_response(id_val)
        out 0
    end

    if lspCompilerRenameCoverage(s_idx) == 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: compiler binding graph is incomplete")
        out 0
    end
    let s_name = sym_get_name(s_idx)
    let s_line = sym_get_line(s_idx)
    let s_col = sym_get_col(s_idx)
    let s_end = sym_get_end_col(s_idx)

    let buf = vir_alloc(512)
    var pos = 0

    let p1 = "{\"range\":{\"start\":{\"line\":"
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    let l1 = rt_itoa(s_line)
    rt_memcpy(buf + pos, l1 as int, rt_strlen(l1 as i64))
    pos = pos + rt_strlen(l1 as i64)

    let p2 = ",\"character\":"
    rt_memcpy(buf + pos, p2 as int, rt_strlen(p2 as i64))
    pos = pos + rt_strlen(p2 as i64)

    let c1 = rt_itoa(lsp_byte_col_to_utf16(s_line, s_col))
    rt_memcpy(buf + pos, c1 as int, rt_strlen(c1 as i64))
    pos = pos + rt_strlen(c1 as i64)

    let p3 = "},\"end\":{\"line\":"
    rt_memcpy(buf + pos, p3 as int, rt_strlen(p3 as i64))
    pos = pos + rt_strlen(p3 as i64)

    rt_memcpy(buf + pos, l1 as int, rt_strlen(l1 as i64))
    pos = pos + rt_strlen(l1 as i64)

    let p4 = ",\"character\":"
    rt_memcpy(buf + pos, p4 as int, rt_strlen(p4 as i64))
    pos = pos + rt_strlen(p4 as i64)

    let c2 = rt_itoa(lsp_byte_col_to_utf16(s_line, s_end))
    rt_memcpy(buf + pos, c2 as int, rt_strlen(c2 as i64))
    pos = pos + rt_strlen(c2 as i64)

    let p5 = "}},\"placeholder\":\""
    rt_memcpy(buf + pos, p5 as int, rt_strlen(p5 as i64))
    pos = pos + rt_strlen(p5 as i64)

    let esc_pname = lspJsonEscape(s_name)
    rt_memcpy(buf + pos, esc_pname as int, rt_strlen(esc_pname as i64))
    pos = pos + rt_strlen(esc_pname as i64)
    vir_free(esc_pname)

    let p6 = "\"}"
    rt_memcpy(buf + pos, p6 as int, 2)
    pos = pos + 2
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

func lsp_handle_rename(id_val: int, line: int, col: int, new_name: int):
    let nlen = rt_strlen(new_name as i64)
    if nlen <= 0 or is_alpha(native_read_u8(new_name, 0)) == 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: invalid identifier name")
        out 0
    end
    var nameIndex = 1
    when nameIndex < nlen loop
        if is_alnum(native_read_u8(new_name, nameIndex)) == 0 do
            lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: invalid identifier name")
            out 0
        end
        nameIndex = nameIndex + 1
    end
    if is_keyword(new_name) == 1 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: new name collides with Vir reserved keyword")
        out 0
    end
    let byte_col = lsp_utf16_col_to_byte(line, col)
    let s_idx = lsp_find_sym_at(line, byte_col)
    if s_idx < 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: target symbol not found")
        out 0
    end

    if g_compilerAnalysisAvailable == 0 or g_ideSessionErrors > 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: compiler binding graph is incomplete")
        out 0
    end
    if lspCompilerRenameCoverage(s_idx) == 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: occurrence ranges are incomplete")
        out 0
    end
    let target_scope = native_read_i64(g_compilerSymbolScopes, s_idx * 8)

    # Check collision in target scope or variable capture in child/descendant scopes
    var si_chk = 0
    when si_chk < g_sym_count loop
        let other_name = sym_get_name(si_chk)
        if rt_streq(new_name as i64, other_name as i64) == 1 do
            let other_sc = native_read_i64(g_compilerSymbolScopes, si_chk * 8)
            if other_sc == target_scope or lspCompilerAncestor(target_scope, other_sc) == 1 or lspCompilerAncestor(other_sc, target_scope) == 1 do
                lsp_send_error(id_val, 0 - 32602, "Symbol rename rejected: new name causes collision or variable capture in scope")
                out 0
            end
        end
        si_chk = si_chk + 1
    end

    if g_versionedEdits == 0 do
        lsp_send_error(id_val, 0 - 32602, "Symbol rename requires versioned documentChanges support")
        out 0
    end

    let targetId = sym_get_id(s_idx)
    var capacity = 256
    var occurrence = 0
    when occurrence < g_occ_count loop
        capacity = capacity + nlen + rt_strlen(lspSourceUri(native_read_i64(g_occ_table, occurrence * 88 + 64))) * 6 + 256
        occurrence = occurrence + 1
    end
    let buffer = vir_alloc(capacity)
    var position = lspAppendRaw(buffer, 0, "{\"documentChanges\":[" as int)
    var source = g_ideVirtualFiles
    var documents = 0
    when source != 0 loop
        var matches = 0
        occurrence = 0
        when occurrence < g_occ_count loop
            if native_read_i64(g_occ_table, occurrence * 88) == targetId & native_read_i64(g_occ_table, occurrence * 88 + 64) == source do matches = matches + 1 end
            occurrence = occurrence + 1
        end
        if matches > 0 do
            if native_read_i64(source, 32) < 0 do
                vir_free(buffer)
                lsp_send_error(id_val, -32602, "Rename requires all affected documents to be open and versioned")
                out 0
            end
            if documents > 0 do position = lspAppendRaw(buffer, position, "," as int) end
            position = lspAppendRaw(buffer, position, "{\"textDocument\":{\"uri\":\"" as int)
            position = lspAppendRaw(buffer, position, lspJsonEscape(lspSourceUri(source)))
            position = lspAppendRaw(buffer, position, "\",\"version\":" as int)
            position = lspAppendRaw(buffer, position, rt_itoa(native_read_i64(source, 32)))
            position = lspAppendRaw(buffer, position, "},\"edits\":[" as int)
            var edits = 0
            occurrence = 0
            when occurrence < g_occ_count loop
                if native_read_i64(g_occ_table, occurrence * 88) == targetId & native_read_i64(g_occ_table, occurrence * 88 + 64) == source do
                    if edits > 0 do position = lspAppendRaw(buffer, position, "," as int) end
                    let line = native_read_i64(g_occ_table, occurrence * 88 + 8)
                    let column = native_read_i64(g_occ_table, occurrence * 88 + 16)
                    let endColumn = native_read_i64(g_occ_table, occurrence * 88 + 32)
                    position = lspAppendRaw(buffer, position, "{\"range\":{\"start\":{\"line\":" as int)
                    position = lspAppendRaw(buffer, position, rt_itoa(line))
                    position = lspAppendRaw(buffer, position, ",\"character\":" as int)
                    position = lspAppendRaw(buffer, position, rt_itoa(lspSourceUtf16(source, line, column)))
                    position = lspAppendRaw(buffer, position, "},\"end\":{\"line\":" as int)
                    position = lspAppendRaw(buffer, position, rt_itoa(line))
                    position = lspAppendRaw(buffer, position, ",\"character\":" as int)
                    position = lspAppendRaw(buffer, position, rt_itoa(lspSourceUtf16(source, line, endColumn)))
                    position = lspAppendRaw(buffer, position, "}},\"newText\":\"" as int)
                    position = lspAppendRaw(buffer, position, new_name)
                    position = lspAppendRaw(buffer, position, "\"}" as int)
                    edits = edits + 1
                end
                occurrence = occurrence + 1
            end
            position = lspAppendRaw(buffer, position, "]}" as int)
            documents = documents + 1
        end
        source = native_read_i64(source, 0)
    end
    position = lspAppendRaw(buffer, position, "]}" as int)
    native_write_u8(buffer, position, 0)
    lsp_send_response(id_val, buffer as string)
    vir_free(buffer)
end.

func lspAppendRaw(buffer: int, position: int, text) -> int:
    let length = rt_strlen(text as i64)
    rt_memcpy(buffer + position, text as int, length)
    out position + length
end.

func lsp_handle_semantic_tokens(id_val: int):
    if g_occ_table == 0 or g_doc_uri == 0 do
        lsp_send_response(id_val, "{\"data\":[]}")
        out 0
    end
    let buf = vir_alloc(g_occ_count * 88 + 256)
    if buf == 0 do
        lsp_send_response(id_val, "{\"data\":[]}")
        out 0
    end
    var pos = 0

    let p1 = "{\"data\":["
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    var prev_line = 0
    var prev_u16_col = 0
    var oi = 0
    var emitted = 0

    when oi < g_occ_count loop
        let occ_source = native_read_i64(g_occ_table, oi * 88 + 64)
        let doc_uri = lspSourceUri(occ_source)
        if doc_uri == 0 or rt_streq(doc_uri, g_doc_uri) == 0 do
            oi = oi + 1
            skip
        end
        if emitted > 0 do
            native_write_u8(buf, pos, 44) # ','
            pos = pos + 1
        end

        let o_line = native_read_i64(g_occ_table, oi * 88 + 8)
        let o_col = native_read_i64(g_occ_table, oi * 88 + 16)
        let o_ecol = native_read_i64(g_occ_table, oi * 88 + 32)
        let o_kind = native_read_i64(g_occ_table, oi * 88 + 40)
        let o_state = native_read_i64(g_occ_table, oi * 88 + 48)

        let u16_col = lsp_byte_col_to_utf16(o_line, o_col)
        let u16_ecol = lsp_byte_col_to_utf16(o_line, o_ecol)

        var delta_line = o_line - prev_line
        var delta_col = u16_col
        if delta_line == 0 do
            delta_col = u16_col - prev_u16_col
        end
        let t_len = u16_ecol - u16_col

        prev_line = o_line
        prev_u16_col = u16_col

        # Append delta_line,delta_col,t_len,o_kind,o_state
        let s_dl = rt_itoa(delta_line)
        rt_memcpy(buf + pos, s_dl as int, rt_strlen(s_dl as i64))
        pos = pos + rt_strlen(s_dl as i64)
        native_write_u8(buf, pos, 44) # ','
        pos = pos + 1

        let s_dc = rt_itoa(delta_col)
        rt_memcpy(buf + pos, s_dc as int, rt_strlen(s_dc as i64))
        pos = pos + rt_strlen(s_dc as i64)
        native_write_u8(buf, pos, 44) # ','
        pos = pos + 1

        let s_len = rt_itoa(t_len)
        rt_memcpy(buf + pos, s_len as int, rt_strlen(s_len as i64))
        pos = pos + rt_strlen(s_len as i64)
        native_write_u8(buf, pos, 44) # ','
        pos = pos + 1

        let s_k = rt_itoa(o_kind)
        rt_memcpy(buf + pos, s_k as int, rt_strlen(s_k as i64))
        pos = pos + rt_strlen(s_k as i64)
        native_write_u8(buf, pos, 44) # ','
        pos = pos + 1

        let s_st = rt_itoa(o_state)
        rt_memcpy(buf + pos, s_st as int, rt_strlen(s_st as i64))
        pos = pos + rt_strlen(s_st as i64)

        emitted = emitted + 1
        oi = oi + 1
    end

    native_write_u8(buf, pos, 93) # ']'
    pos = pos + 1
    native_write_u8(buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

var g_requestedFocusId: int = 0

func lsp_handle_semantic_snapshot(id_val: int):
    var uri_to_send = g_doc_uri
    if uri_to_send == 0 do
        uri_to_send = "file:///workspace/main.vri" as int
    end

    var factCount = 0
    if g_compilerAnalysisAvailable == 1 do factCount = vec_len_rt(g_ideFacts) end
    var capacity = g_occ_count * 512 + g_sym_count * 512 + g_mod_count * 128 + factCount * 1024 + 4096
    var maxUriLength = 0
    var sourceEntry = g_ideVirtualFiles
    when sourceEntry != 0 loop
        let uriLength = rt_strlen(lspSourceUri(sourceEntry))
        if uriLength > maxUriLength do maxUriLength = uriLength end
        capacity = capacity + uriLength * 6 + 128
        sourceEntry = native_read_i64(sourceEntry, 0)
    end
    capacity = capacity + maxUriLength * 6 * (g_occ_count * 2 + g_sym_count * 2 + factCount * 6)
    if capacity > LSP_WORKER_CAPACITY - 1024 do
        lsp_send_error(id_val, -32603, "Semantic snapshot exceeds the response size limit")
        out 0
    end
    let buf = vir_alloc(capacity)
    var focusBuffer = 0
    var focusPosition = 0
    if g_requestedFocusId != 0 do focusBuffer = vir_alloc(capacity) end
    var pos = 0

    let p1 = "{\"schemaVersion\":1,\"uri\":\""
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)

    rt_memcpy(buf + pos, uri_to_send as int, rt_strlen(uri_to_send as i64))
    pos = pos + rt_strlen(uri_to_send as i64)

    let p2 = "\",\"documentVersion\":"
    rt_memcpy(buf + pos, p2 as int, rt_strlen(p2 as i64))
    pos = pos + rt_strlen(p2 as i64)

    let v_str = rt_itoa(g_doc_version)
    rt_memcpy(buf + pos, v_str as int, rt_strlen(v_str as i64))
    pos = pos + rt_strlen(v_str as i64)

    var identityPrefix = ",\"analysisId\":\"fallback-buffer-"
    if g_compilerAnalysisAvailable == 1 do
        identityPrefix = ",\"analysisId\":\"compiler-buffer-"
    end
    rt_memcpy(buf + pos, identityPrefix as int, rt_strlen(identityPrefix as int))
    pos = pos + rt_strlen(identityPrefix as int)
    let processId = rt_itoa(g_sessionProcessId)
    rt_memcpy(buf + pos, processId, rt_strlen(processId))
    pos = pos + rt_strlen(processId)
    native_write_u8(buf, pos, 45)
    pos = pos + 1
    let started = rt_itoa(g_sessionStartedNs)
    rt_memcpy(buf + pos, started, rt_strlen(started))
    pos = pos + rt_strlen(started)
    native_write_u8(buf, pos, 45)
    pos = pos + 1
    let generation = rt_itoa(g_analysisGeneration)
    rt_memcpy(buf + pos, generation, rt_strlen(generation))
    pos = pos + rt_strlen(generation)
    var fallbackHeader = "\",\"complete\":false,\"unavailableReason\":\"compiler analysis unavailable; lexical fallback\",\"occurrences\":["
    if g_compilerAnalysisFailure == 1 do
        fallbackHeader = "\",\"complete\":false,\"unavailableReason\":\"compiler preprocessing/parser rejected this source; lexical fallback\",\"occurrences\":["
    end
    if g_compilerAnalysisFailure == 2 do
        fallbackHeader = "\",\"complete\":false,\"unavailableReason\":\"compiler symbol/reference capacity exceeded; lexical fallback\",\"occurrences\":["
    end
    if g_compilerAnalysisAvailable == 1 do
        fallbackHeader = "\",\"complete\":false,\"unavailableReason\":\"compiler CU graph has diagnostics, missing ranges or unsupported type/import references\",\"occurrences\":["
        if lspCompilerSnapshotComplete() == 1 do
            fallbackHeader = "\",\"complete\":true,\"occurrences\":["
        end
    end
    rt_memcpy(buf + pos, fallbackHeader as int, rt_strlen(fallbackHeader as int))
    pos = pos + rt_strlen(fallbackHeader as int)

    var oi = 0
    when oi < g_occ_count loop
        if oi > 0 do
            native_write_u8(buf, pos, 44) # ','
            pos = pos + 1
        end

        let source = native_read_i64(g_occ_table, oi * 88 + 64)
        uri_to_send = lspSourceUri(source)
        let sid = native_read_i64(g_occ_table, oi * 88 + 0)
        let o_line = native_read_i64(g_occ_table, oi * 88 + 8)
        let o_col = native_read_i64(g_occ_table, oi * 88 + 16)
        let o_eline = native_read_i64(g_occ_table, oi * 88 + 24)
        let o_ecol = native_read_i64(g_occ_table, oi * 88 + 32)
        let o_kind = native_read_i64(g_occ_table, oi * 88 + 40)
        let o_state = native_read_i64(g_occ_table, oi * 88 + 48)

        var k_str = "variable"
        if o_kind == 12 do k_str = "function" end
        if o_kind == 1 do k_str = "type" end

        let occurrenceStart = pos
        let op1 = "{\"symbolId\":\""
        rt_memcpy(buf + pos, op1 as int, rt_strlen(op1 as i64))
        pos = pos + rt_strlen(op1 as i64)

        let sid_s = rt_itoa(sid)
        rt_memcpy(buf + pos, sid_s as int, rt_strlen(sid_s as i64))
        pos = pos + rt_strlen(sid_s as i64)

        let op2 = "\",\"uri\":\""
        rt_memcpy(buf + pos, op2 as int, rt_strlen(op2 as i64))
        pos = pos + rt_strlen(op2 as i64)

        rt_memcpy(buf + pos, uri_to_send as int, rt_strlen(uri_to_send as i64))
        pos = pos + rt_strlen(uri_to_send as i64)

        let op3 = "\",\"range\":{\"start\":{\"line\":"
        rt_memcpy(buf + pos, op3 as int, rt_strlen(op3 as i64))
        pos = pos + rt_strlen(op3 as i64)

        let l_s = rt_itoa(o_line)
        rt_memcpy(buf + pos, l_s as int, rt_strlen(l_s as i64))
        pos = pos + rt_strlen(l_s as i64)

        let op4 = ",\"character\":"
        rt_memcpy(buf + pos, op4 as int, rt_strlen(op4 as i64))
        pos = pos + rt_strlen(op4 as i64)

        let c_s = rt_itoa(lspSourceUtf16(source, o_line, o_col))
        rt_memcpy(buf + pos, c_s as int, rt_strlen(c_s as i64))
        pos = pos + rt_strlen(c_s as i64)

        let op5 = "},\"end\":{\"line\":"
        rt_memcpy(buf + pos, op5 as int, rt_strlen(op5 as i64))
        pos = pos + rt_strlen(op5 as i64)

        let el_s = rt_itoa(o_eline)
        rt_memcpy(buf + pos, el_s as int, rt_strlen(el_s as i64))
        pos = pos + rt_strlen(el_s as i64)

        let op6 = ",\"character\":"
        rt_memcpy(buf + pos, op6 as int, rt_strlen(op6 as i64))
        pos = pos + rt_strlen(op6 as i64)

        let ec_s = rt_itoa(lspSourceUtf16(source, o_eline, o_ecol))
        rt_memcpy(buf + pos, ec_s as int, rt_strlen(ec_s as i64))
        pos = pos + rt_strlen(ec_s as i64)

        let op7 = "}},\"kind\":\""
        rt_memcpy(buf + pos, op7 as int, rt_strlen(op7 as i64))
        pos = pos + rt_strlen(op7 as i64)

        rt_memcpy(buf + pos, k_str as int, rt_strlen(k_str as i64))
        pos = pos + rt_strlen(k_str as i64)

        let occurrenceRole = native_read_i64(g_occ_table, oi * 88 + 56)
        var roleName = "read"
        if occurrenceRole == 1 do roleName = "declaration" end
        if occurrenceRole == 3 do roleName = "write" end
        if occurrenceRole == 4 || occurrenceRole == 6 do roleName = "call" end
        if occurrenceRole == 5 do roleName = "type-use" end
        pos = lspAppendRaw(buf, pos, "\",\"role\":\"" as int)
        pos = lspAppendRaw(buf, pos, roleName as int)
        var borrowKind = "none"
        let loanMode = native_read_i64(g_occ_table, oi * 88 + 72)
        if loanMode == 1 do borrowKind = "shared" end
        if loanMode == 2 do borrowKind = "mutable" end
        if loanMode == 3 do borrowKind = "conflicting" end
        pos = lspAppendRaw(buf, pos, "\",\"borrowKind\":\"" as int)
        pos = lspAppendRaw(buf, pos, borrowKind as int)
        pos = lspAppendRaw(buf, pos, "\",\"lifetimeEnd\":" as int)
        let boundary = native_read_i64(g_occ_table, oi * 88 + 80)
        var boundarySpan = 0
        if boundary != 0 do
            let boundaryFact = ideFactFind(boundary)
            if boundaryFact != 0 do boundarySpan = sm_get_span(g_active_source_manager, native_read_i64(boundaryFact, 80)) end
        end
        if boundarySpan == 0 do
            pos = lspAppendRaw(buf, pos, "null" as int)
        else
            let boundarySource = lspSourceForFile(native_read_i64(boundarySpan, 0))
            let boundaryLine = native_read_i64(boundarySpan, 8) - 1
            let boundaryColumn = native_read_i64(boundarySpan, 16) - 1
            pos = lspAppendRaw(buf, pos, "{\"uri\":\"" as int)
            pos = lspAppendRaw(buf, pos, lspJsonEscape(lspSourceUri(boundarySource)))
            pos = lspAppendRaw(buf, pos, "\",\"position\":{\"line\":" as int)
            pos = lspAppendRaw(buf, pos, rt_itoa(boundaryLine))
            pos = lspAppendRaw(buf, pos, ",\"character\":" as int)
            pos = lspAppendRaw(buf, pos, rt_itoa(lspSourceUtf16(boundarySource, boundaryLine, boundaryColumn)))
            pos = lspAppendRaw(buf, pos, "}}" as int)
        end
        var boundaryReason = "not a borrow"
        if loanMode != 0 do boundaryReason = "checker has not established last use on every path" end
        if boundary != 0 do boundaryReason = "checker-proven NLL boundary has no source range" end
        if boundarySpan != 0 do boundaryReason = "checker-proven NLL boundary" end
        if boundary != 0 do
            let boundaryKind = native_read_i64(boundary, 16)
            var conservative = 0
            if boundaryKind == 8 do conservative = 1 end
            if boundaryKind == 9 do conservative = 1 end
            if boundaryKind == 10 do conservative = 1 end
            if boundaryKind == 11 do conservative = 1 end
            if boundaryKind == 59 do conservative = 1 end
            if boundaryKind == 67 do conservative = 1 end
            if boundaryKind == 82 do conservative = 1 end
            if conservative == 1 do boundaryReason = "conservative control-flow boundary; no single linear last use" end
        end
        pos = lspAppendRaw(buf, pos, ",\"lifetimeEndReason\":\"" as int)
        pos = lspAppendRaw(buf, pos, boundaryReason as int)
        pos = lspAppendRaw(buf, pos, "\"" as int)
        let op8a = ",\"states\":["
        rt_memcpy(buf + pos, op8a as int, rt_strlen(op8a as i64))
        pos = pos + rt_strlen(op8a as i64)

        var st_count = 0
        if (o_state and 131072) != 0 do
            if st_count > 0 do native_write_u8(buf, pos, 44); pos = pos + 1 end
            let st_name = "\"virBorrowed\""
            rt_memcpy(buf + pos, st_name as int, rt_strlen(st_name as i64))
            pos = pos + rt_strlen(st_name as i64)
            st_count = st_count + 1
        end
        if (o_state and 4096) != 0 do
            if st_count > 0 do native_write_u8(buf, pos, 44); pos = pos + 1 end
            let st_name = "\"virOut\""
            rt_memcpy(buf + pos, st_name as int, rt_strlen(st_name as i64))
            pos = pos + rt_strlen(st_name as i64)
            st_count = st_count + 1
        end
        if (o_state and 2048) != 0 do
            if st_count > 0 do native_write_u8(buf, pos, 44); pos = pos + 1 end
            let st_name = "\"virMoved\""
            rt_memcpy(buf + pos, st_name as int, rt_strlen(st_name as i64))
            pos = pos + rt_strlen(st_name as i64)
            st_count = st_count + 1
        end
        if (o_state and 65536) != 0 do
            if st_count > 0 do native_write_u8(buf, pos, 44); pos = pos + 1 end
            let st_name = "\"virLastUse\""
            rt_memcpy(buf + pos, st_name as int, rt_strlen(st_name as i64))
            pos = pos + rt_strlen(st_name as i64)
            st_count = st_count + 1
        end
        if (o_state and 1024) != 0 or st_count == 0 do
            if st_count > 0 do native_write_u8(buf, pos, 44); pos = pos + 1 end
            let st_name = "\"virAlive\""
            rt_memcpy(buf + pos, st_name as int, rt_strlen(st_name as i64))
            pos = pos + rt_strlen(st_name as i64)
            st_count = st_count + 1
        end

        native_write_u8(buf, pos, 93) # ']'
        pos = pos + 1
        native_write_u8(buf, pos, 125) # '}'
        pos = pos + 1

        if focusBuffer != 0 do
            if rt_streq(rt_itoa(sid), g_requestedFocusId) == 1 do
                if focusPosition > 0 do
                    native_write_u8(focusBuffer, focusPosition, 44)
                    focusPosition = focusPosition + 1
                end
                rt_memcpy(focusBuffer + focusPosition, buf + occurrenceStart, pos - occurrenceStart)
                focusPosition = focusPosition + pos - occurrenceStart
            end
        end
        oi = oi + 1
    end

    let p4 = "],\"functions\":["
    rt_memcpy(buf + pos, p4 as int, rt_strlen(p4 as i64))
    pos = pos + rt_strlen(p4 as i64)

    var f_count = 0
    var si = 0
    when si < g_sym_count loop
        if sym_get_kind(si) == 1 do
            if f_count > 0 do
                native_write_u8(buf, pos, 44) # ','
                pos = pos + 1
            end
            let source = native_read_i64(g_sym_table, si * 88 + 80)
            uri_to_send = lspSourceUri(source)
            let sid = sym_get_id(si)
            let s_line = sym_get_line(si)
            let s_col = sym_get_col(si)
            let s_end = sym_get_end_col(si)

            let fp1 = "{\"symbolId\":\""
            rt_memcpy(buf + pos, fp1 as int, rt_strlen(fp1 as i64))
            pos = pos + rt_strlen(fp1 as i64)

            let sid_s = rt_itoa(sid)
            rt_memcpy(buf + pos, sid_s as int, rt_strlen(sid_s as i64))
            pos = pos + rt_strlen(sid_s as i64)

            let fp2 = "\",\"uri\":\""
            rt_memcpy(buf + pos, fp2 as int, rt_strlen(fp2 as i64))
            pos = pos + rt_strlen(fp2 as i64)

            rt_memcpy(buf + pos, uri_to_send as int, rt_strlen(uri_to_send as i64))
            pos = pos + rt_strlen(uri_to_send as i64)

            let fp3 = "\",\"declarationRange\":{\"start\":{\"line\":"
            rt_memcpy(buf + pos, fp3 as int, rt_strlen(fp3 as i64))
            pos = pos + rt_strlen(fp3 as i64)

            let l_s = rt_itoa(s_line)
            rt_memcpy(buf + pos, l_s as int, rt_strlen(l_s as i64))
            pos = pos + rt_strlen(l_s as i64)

            let fp4 = ",\"character\":"
            rt_memcpy(buf + pos, fp4 as int, rt_strlen(fp4 as i64))
            pos = pos + rt_strlen(fp4 as i64)

            let c_s = rt_itoa(lspSourceUtf16(source, s_line, s_col))
            rt_memcpy(buf + pos, c_s as int, rt_strlen(c_s as i64))
            pos = pos + rt_strlen(c_s as i64)

            let fp5 = "},\"end\":{\"line\":"
            rt_memcpy(buf + pos, fp5 as int, rt_strlen(fp5 as i64))
            pos = pos + rt_strlen(fp5 as i64)

            rt_memcpy(buf + pos, l_s as int, rt_strlen(l_s as i64))
            pos = pos + rt_strlen(l_s as i64)

            let fp6 = ",\"character\":"
            rt_memcpy(buf + pos, fp6 as int, rt_strlen(fp6 as i64))
            pos = pos + rt_strlen(fp6 as i64)

            let ec_s = rt_itoa(lspSourceUtf16(source, s_line, s_end))
            rt_memcpy(buf + pos, ec_s as int, rt_strlen(ec_s as i64))
            pos = pos + rt_strlen(ec_s as i64)

            let fp7 = "}},\"activity\":\"active\"}"
            rt_memcpy(buf + pos, fp7 as int, rt_strlen(fp7 as i64))
            pos = pos + rt_strlen(fp7 as i64)

            f_count = f_count + 1
        end
        si = si + 1
    end

    let p5 = "],\"modules\":["
    rt_memcpy(buf + pos, p5 as int, rt_strlen(p5 as i64))
    pos = pos + rt_strlen(p5 as i64)

    uri_to_send = g_doc_uri
    var mi = 0
    when mi < g_mod_count loop
        if mi > 0 do
            native_write_u8(buf, pos, 44) # ','
            pos = pos + 1
        end
        let mname = native_read_i64(g_mod_table, mi * 40 + 0)
        let m_line = native_read_i64(g_mod_table, mi * 40 + 8)
        let m_col = native_read_i64(g_mod_table, mi * 40 + 16)
        let m_end = native_read_i64(g_mod_table, mi * 40 + 24)

        let mp1 = "{\"canonicalName\":\""
        rt_memcpy(buf + pos, mp1 as int, rt_strlen(mp1 as i64))
        pos = pos + rt_strlen(mp1 as i64)

        pos = lspAppendRaw(buf, pos, lspJsonEscape(mname))

        let mp2 = "\",\"uri\":\""
        rt_memcpy(buf + pos, mp2 as int, rt_strlen(mp2 as i64))
        pos = pos + rt_strlen(mp2 as i64)

        pos = lspAppendRaw(buf, pos, lspJsonEscape(g_doc_uri))

        let mp3 = "\",\"includeRange\":{\"start\":{\"line\":"
        rt_memcpy(buf + pos, mp3 as int, rt_strlen(mp3 as i64))
        pos = pos + rt_strlen(mp3 as i64)

        let l_s = rt_itoa(m_line)
        rt_memcpy(buf + pos, l_s as int, rt_strlen(l_s as i64))
        pos = pos + rt_strlen(l_s as i64)

        let mp4 = ",\"character\":"
        rt_memcpy(buf + pos, mp4 as int, rt_strlen(mp4 as i64))
        pos = pos + rt_strlen(mp4 as i64)

        let c_s = rt_itoa(lsp_byte_col_to_utf16(m_line, m_col))
        rt_memcpy(buf + pos, c_s as int, rt_strlen(c_s as i64))
        pos = pos + rt_strlen(c_s as i64)

        let mp5 = "},\"end\":{\"line\":"
        rt_memcpy(buf + pos, mp5 as int, rt_strlen(mp5 as i64))
        pos = pos + rt_strlen(mp5 as i64)

        rt_memcpy(buf + pos, l_s as int, rt_strlen(l_s as i64))
        pos = pos + rt_strlen(l_s as i64)

        let mp6 = ",\"character\":"
        rt_memcpy(buf + pos, mp6 as int, rt_strlen(mp6 as i64))
        pos = pos + rt_strlen(mp6 as i64)

        let ec_s = rt_itoa(lsp_byte_col_to_utf16(m_line, m_end))
        rt_memcpy(buf + pos, ec_s as int, rt_strlen(ec_s as i64))
        pos = pos + rt_strlen(ec_s as i64)

        let mp7 = "}},\"activity\":\"active\"}"
        rt_memcpy(buf + pos, mp7 as int, rt_strlen(mp7 as i64))
        pos = pos + rt_strlen(mp7 as i64)

        mi = mi + 1
    end

    native_write_u8(buf, pos, 93) # ']'
    pos = pos + 1

    let p_syms = ",\"symbols\":["
    rt_memcpy(buf + pos, p_syms as int, rt_strlen(p_syms as i64))
    pos = pos + rt_strlen(p_syms as i64)

    var s_idx = 0
    when s_idx < g_sym_count loop
        if s_idx > 0 do
            native_write_u8(buf, pos, 44) # ','
            pos = pos + 1
        end
        let source = native_read_i64(g_sym_table, s_idx * 88 + 80)
        uri_to_send = lspSourceUri(source)
        let s_id = sym_get_id(s_idx)
        let s_name = sym_get_name(s_idx)
        let s_kind = sym_get_kind(s_idx)
        let s_line = sym_get_line(s_idx)
        let s_col = sym_get_col(s_idx)
        let s_end = sym_get_end_col(s_idx)
        var s_scope = sym_get_scope_id(s_idx)
        if g_compilerAnalysisAvailable == 1 do s_scope = native_read_i64(g_compilerSymbolScopes, s_idx * 8) end
        let s_sig = sym_get_type_desc(s_idx)

        var skind_str = "variable"
        if s_kind == 1 do skind_str = "function" end
        if s_kind == 3 do skind_str = "type" end
        if s_kind == 4 do skind_str = "parameter" end

        let sp1 = "{\"symbolId\":\""
        rt_memcpy(buf + pos, sp1 as int, rt_strlen(sp1 as i64))
        pos = pos + rt_strlen(sp1 as i64)

        let sid_str = rt_itoa(s_id)
        rt_memcpy(buf + pos, sid_str as int, rt_strlen(sid_str as i64))
        pos = pos + rt_strlen(sid_str as i64)

        let sp2 = "\",\"name\":\""
        rt_memcpy(buf + pos, sp2 as int, rt_strlen(sp2 as i64))
        pos = pos + rt_strlen(sp2 as i64)

        let esc_snap_name = lspJsonEscape(s_name)
        rt_memcpy(buf + pos, esc_snap_name as int, rt_strlen(esc_snap_name as i64))
        pos = pos + rt_strlen(esc_snap_name as i64)
        vir_free(esc_snap_name)

        let sp3 = "\",\"kind\":\""
        rt_memcpy(buf + pos, sp3 as int, rt_strlen(sp3 as i64))
        pos = pos + rt_strlen(sp3 as i64)

        rt_memcpy(buf + pos, skind_str as int, rt_strlen(skind_str as i64))
        pos = pos + rt_strlen(skind_str as i64)

        let sp4 = "\",\"scopeId\":\""
        rt_memcpy(buf + pos, sp4 as int, rt_strlen(sp4 as i64))
        pos = pos + rt_strlen(sp4 as i64)

        let sc_str = rt_itoa(s_scope)
        rt_memcpy(buf + pos, sc_str as int, rt_strlen(sc_str as i64))
        pos = pos + rt_strlen(sc_str as i64)

        pos = lspAppendRaw(buf, pos, "\",\"uri\":\"" as int)
        pos = lspAppendRaw(buf, pos, lspJsonEscape(uri_to_send))
        let sp5 = "\",\"range\":{\"start\":{\"line\":"
        rt_memcpy(buf + pos, sp5 as int, rt_strlen(sp5 as i64))
        pos = pos + rt_strlen(sp5 as i64)

        let sl_str = rt_itoa(s_line)
        rt_memcpy(buf + pos, sl_str as int, rt_strlen(sl_str as i64))
        pos = pos + rt_strlen(sl_str as i64)

        let sp6 = ",\"character\":"
        rt_memcpy(buf + pos, sp6 as int, rt_strlen(sp6 as i64))
        pos = pos + rt_strlen(sp6 as i64)

        let sc1_str = rt_itoa(lspSourceUtf16(source, s_line, s_col))
        rt_memcpy(buf + pos, sc1_str as int, rt_strlen(sc1_str as i64))
        pos = pos + rt_strlen(sc1_str as i64)

        let sp7 = "},\"end\":{\"line\":"
        rt_memcpy(buf + pos, sp7 as int, rt_strlen(sp7 as i64))
        pos = pos + rt_strlen(sp7 as i64)

        rt_memcpy(buf + pos, sl_str as int, rt_strlen(sl_str as i64))
        pos = pos + rt_strlen(sl_str as i64)

        let sp8 = ",\"character\":"
        rt_memcpy(buf + pos, sp8 as int, rt_strlen(sp8 as i64))
        pos = pos + rt_strlen(sp8 as i64)

        let sc2_str = rt_itoa(lspSourceUtf16(source, s_line, s_end))
        rt_memcpy(buf + pos, sc2_str as int, rt_strlen(sc2_str as i64))
        pos = pos + rt_strlen(sc2_str as i64)

        let sp9 = "}},\"type\":\""
        rt_memcpy(buf + pos, sp9 as int, rt_strlen(sp9 as i64))
        pos = pos + rt_strlen(sp9 as i64)

        let esc_snap_sig = lspJsonEscape(s_sig)
        rt_memcpy(buf + pos, esc_snap_sig as int, rt_strlen(esc_snap_sig as i64))
        pos = pos + rt_strlen(esc_snap_sig as i64)
        vir_free(esc_snap_sig)

        pos = lspAppendRaw(buf, pos, "\",\"containerId\":" as int)
        let compilerId = s_id - 1000000
        var containerId = -1
        var symbolFact = 0
        if g_compilerAnalysisAvailable == 1 do symbolFact = native_read_i64(g_compilerSymbolFacts, s_idx * 8) end
        if compilerId >= 0 & compilerId < vec_len_rt(g_ideSymbolNodes) do
            let compilerSymbol = vec_get_rt(g_ideSymbolNodes, compilerId)
            containerId = native_read_i64(compilerSymbol, 72)
            if native_read_i64(compilerSymbol, 0) == 8 and symbolFact != 0 do
                containerId = native_read_i64(symbolFact, 184)
            end
        end
        if containerId >= 0 do
            pos = lspAppendRaw(buf, pos, "\"" as int)
            pos = lspAppendRaw(buf, pos, rt_itoa(containerId + 1000000))
            pos = lspAppendRaw(buf, pos, "\"" as int)
        else
            pos = lspAppendRaw(buf, pos, "null" as int)
        end
        pos = lspAppendRaw(buf, pos, ",\"typeId\":" as int)

        if symbolFact != 0 do
            pos = lspAppendRaw(buf, pos, "\"" as int)
            pos = lspAppendFactTypeId(buf, pos, symbolFact)
            pos = lspAppendRaw(buf, pos, "\"" as int)
        else
            pos = lspAppendRaw(buf, pos, "null" as int)
        end
        pos = lspAppendRaw(buf, pos, "}" as int)

        s_idx = s_idx + 1
    end

    pos = lspAppendDetailedFacts(buf, pos)
    pos = lspAppendRaw(buf, pos, "],\"scopes\":[" as int)
    var scopeIndex = 0
    var scopeCount = 0
    if g_compilerAnalysisAvailable == 1 do
        when scopeIndex < vec_len_rt(g_ideFacts) loop
            let fact = vec_get_rt(g_ideFacts, scopeIndex)
            let scopeId = native_read_i64(fact, 136) - 1
            let firstLine = native_read_i64(fact, 88)
            let lastLine = native_read_i64(fact, 144)
            if scopeId >= 0 and scopeId < vec_len_rt(g_ideScopeParents) do
                let source = lspSourceForFile(sm_file_from_line(g_active_source_manager, firstLine))
                if scopeCount > 0 do pos = lspAppendRaw(buf, pos, "," as int) end
                pos = lspAppendRaw(buf, pos, "{\"scopeId\":\"" as int)
                pos = lspAppendRaw(buf, pos, rt_itoa(scopeId))
                pos = lspAppendRaw(buf, pos, "\",\"parentScopeId\":\"" as int)
                pos = lspAppendRaw(buf, pos, rt_itoa(vec_get_rt(g_ideScopeParents, scopeId)))
                pos = lspAppendRaw(buf, pos, "\",\"uri\":\"" as int)
                pos = lspAppendRaw(buf, pos, lspJsonEscape(lspSourceUri(source)))
                pos = lspAppendRaw(buf, pos, "\",\"startLine\":" as int)
                pos = lspAppendRaw(buf, pos, rt_itoa(sm_line_from_expanded(g_active_source_manager, firstLine) - 1))
                pos = lspAppendRaw(buf, pos, ",\"endLine\":" as int)
                pos = lspAppendRaw(buf, pos, rt_itoa(sm_line_from_expanded(g_active_source_manager, lastLine) - 1))
                pos = lspAppendRaw(buf, pos, "}" as int)
                scopeCount = scopeCount + 1
            end
            scopeIndex = scopeIndex + 1
        end
    end
    pos = lspAppendRaw(buf, pos, "],\"dependencies\":[" as int)
    var dependency = g_ideVirtualFiles
    var dependencyCount = 0
    when dependency != 0 loop
        if dependencyCount > 0 do pos = lspAppendRaw(buf, pos, "," as int) end
        pos = lspAppendRaw(buf, pos, "{\"uri\":\"" as int)
        pos = lspAppendRaw(buf, pos, lspJsonEscape(lspSourceUri(dependency)))
        pos = lspAppendRaw(buf, pos, "\",\"documentVersion\":" as int)
        if native_read_i64(dependency, 32) < 0 do pos = lspAppendRaw(buf, pos, "null" as int)
        else pos = lspAppendRaw(buf, pos, rt_itoa(native_read_i64(dependency, 32))) end
        pos = lspAppendRaw(buf, pos, "}" as int)
        dependencyCount = dependencyCount + 1
        dependency = native_read_i64(dependency, 0)
    end
    pos = lspAppendRaw(buf, pos, "]" as int)
    if focusBuffer != 0 do
        native_write_u8(focusBuffer, focusPosition, 0)
        pos = lspAppendRaw(buf, pos, ",\"focus\":{\"symbolId\":\"" as int)
        pos = lspAppendRaw(buf, pos, lspJsonEscape(g_requestedFocusId))
        pos = lspAppendRaw(buf, pos, "\",\"path\":[" as int)
        pos = lspAppendRaw(buf, pos, focusBuffer)
        pos = lspAppendRaw(buf, pos, "]}" as int)
        vir_free(focusBuffer)
    end
    native_write_u8(buf, pos, 125) # '}'
    pos = pos + 1
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

func lsp_handle_diagnostic_snapshot(id_val: int, uri_arg: int, code_arg: int, build_arg: int):
    var uri_to_send = uri_arg
    if uri_to_send == 0 do
        uri_to_send = g_doc_uri
    end
    if uri_to_send == 0 do
        uri_to_send = "file:///workspace/main.vri" as int
    end

    if lspValidDocumentUri(uri_to_send) == 0 do
        lsp_send_error(id_val, -32602, "Diagnostic snapshot requires an absolute local file URI")
        out 0
    end
    let entry_path = lspUriPath(uri_to_send)

    var code_val = code_arg
    if code_val == 0 do
        code_val = "all" as int
    end

    let payload = diagnosticStoreQuery(entry_path, code_val, build_arg)
    vir_free(entry_path)
    if payload != 0 do
        lsp_send_response(id_val, payload as string)
        out 0
    end

    let buf = vir_alloc(512)
    var pos = 0
    let p1 = "{\"schemaVersion\":1,\"status\":\"missing\",\"message\":\"no diagnostic snapshot for entry\",\"diagnostics\":[]}"
    rt_memcpy(buf + pos, p1 as int, rt_strlen(p1 as i64))
    pos = pos + rt_strlen(p1 as i64)
    native_write_u8(buf, pos, 0)

    lsp_send_response(id_val, buf as string)
    vir_free(buf)
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# LSP Request Dispatcher
# ═════════════════════════════════════════════════════════════════════

var g_is_shutdown: int = 0
var g_versionedEdits: int = 0

# Open buffers own copies independent of the currently analyzed buffer.
var g_openDocuments: int = 0

func lspFindDocument(uri: int) -> int:
    var node = g_openDocuments
    when node != 0 loop
        if rt_streq(uri as i64, native_read_i64(node, 8) as i64) == 1 do out node end
        node = native_read_i64(node, 0)
    end
    out 0
end.

func lspSaveDocument():
    var node = lspFindDocument(g_doc_uri)
    if node == 0 do
        node = vir_alloc(32)
        native_write_i64(node, 0, g_openDocuments)
        native_write_i64(node, 8, copy_sub_string(g_doc_uri, 0, rt_strlen(g_doc_uri as i64)))
        native_write_i64(node, 16, 0)
        g_openDocuments = node
    end
    let oldText = native_read_i64(node, 16)
    if oldText != 0 do vir_free(oldText) end
    native_write_i64(node, 16, copy_sub_string(g_doc_text, 0, g_doc_text_len))
    native_write_i64(node, 24, g_doc_version)
end.

func lspSelectDocument(uri: int) -> int:
    let node = lspFindDocument(uri)
    if node == 0 do out 0 end
    if g_doc_uri != 0 and rt_streq(g_doc_uri as i64, uri as i64) == 1 do out 1 end
    if g_doc_uri != 0 do vir_free(g_doc_uri) end
    if g_doc_text != 0 do vir_free(g_doc_text) end
    let savedUri = native_read_i64(node, 8)
    let savedText = native_read_i64(node, 16)
    g_doc_uri = copy_sub_string(savedUri, 0, rt_strlen(savedUri as i64))
    g_doc_text_len = rt_strlen(savedText as i64)
    g_doc_text = copy_sub_string(savedText, 0, g_doc_text_len)
    g_doc_version = native_read_i64(node, 24)
    lsp_analyze_document()
    out 1
end.

func lspCloseDocument(uri: int):
    var node = g_openDocuments
    var previous = 0
    when node != 0 loop
        let next = native_read_i64(node, 0)
        if rt_streq(uri as i64, native_read_i64(node, 8) as i64) == 1 do
            if previous == 0 do g_openDocuments = next
            else native_write_i64(previous, 0, next) end
            vir_free(native_read_i64(node, 8))
            vir_free(native_read_i64(node, 16))
            vir_free(node)
            if g_doc_uri != 0 and rt_streq(g_doc_uri as i64, uri as i64) == 1 do
                vir_free(g_doc_uri)
                vir_free(g_doc_text)
                g_doc_uri = 0
                g_doc_text = 0
                g_doc_text_len = 0
            end
            out 0
        end
        previous = node
        node = next
    end
end.

# One worker owns one immutable compiler snapshot. Its serialized response is
# published by the supervisor only after successful exit and version checks.
# Shared memory avoids pipe backpressure and partial JSON publication on kill.
const LSP_WORKER_CAPACITY = 16777216
var g_workerPid: int = 0
var g_workerOutput: int = 0
var g_workerRequest: int = -1
var g_workerStarted: int = 0
var g_workerQueue: int = 0
var g_workerQueueTail: int = 0
var g_workerQueueCount: int = 0
var g_workerStatus: int = 0
var g_workerSnapshotUri: int = 0
var g_snapshotCacheUri: int = 0
var g_snapshotCacheResult: int = 0
var g_snapshotCacheGeneration: int = -1
var g_pollElapsedNs: int = 0

# Poll timeouts remain available when the host denies the CLI's clock query.
# Count completed ten-millisecond waits so unavailable time cannot stall work.
func lspNowNs() -> int:
    let now = cliClockNowNs()
    if now >= 0 do out now end
    out g_pollElapsedNs
end.

func lspSnapshotCacheClear():
    if g_snapshotCacheUri != 0 do vir_free(g_snapshotCacheUri) end
    if g_snapshotCacheResult != 0 do vir_free(g_snapshotCacheResult) end
    g_snapshotCacheUri = 0
    g_snapshotCacheResult = 0
    g_snapshotCacheGeneration = -1
end.

func lspSnapshotRequest(body: int, length: int) -> int:
    if body == 0 do out 0 end
    let document = toolJsonParse(body, length)
    if document == 0 do out 0 end
    let method = toolJsonString(document, toolJsonField(document, 1, "method"))
    var snapshot = 0
    if method != 0 do
        if rt_streq(method, "vir/semanticSnapshot") == 1 do
            snapshot = 1
            let params = toolJsonField(document, 1, "params")
            let focus = toolJsonField(document, params, "focusSymbolId")
            let mode = toolJsonString(document, toolJsonField(document, params, "mode"))
            if focus > 0 do snapshot = 0 end
            if mode != 0 do
                if rt_streq(mode, "full") == 0 do snapshot = 0 end
            end
            let version = toolJsonField(document, params, "version")
            if version > 0 do
                if toolJsonInteger(document, version, -1) != g_doc_version do snapshot = 0 end
            end
        end
    end
    toolJsonFree(document)
    out snapshot
end.

func lspSnapshotCacheStore(body: int, length: int):
    if g_workerSnapshotUri == 0 do out 0 end
    let document = toolJsonParse(body, length)
    if document == 0 do out 0 end
    let result = toolJsonField(document, 1, "result")
    if result == 0 do toolJsonFree(document); out 0 end
    let dependencies = toolJsonField(document, result, "dependencies")
    if dependencies == 0 do toolJsonFree(document); out 0 end
    var dependency = native_read_i64(toolJsonNode(document, dependencies), 24)
    var cacheable = 1
    when dependency > 0 loop
        let version = toolJsonField(document, dependency, "documentVersion")
        if version == 0 do cacheable = 0
        else
            if native_read_i64(toolJsonNode(document, version), 0) != 2 do cacheable = 0 end
        end
        dependency = native_read_i64(toolJsonNode(document, dependency), 32)
    end
    if cacheable == 1 do
        let node = toolJsonNode(document, result)
        let start = native_read_i64(node, 8)
        let endOffset = native_read_i64(node, 16)
        lspSnapshotCacheClear()
        g_snapshotCacheUri = copy_sub_string(g_workerSnapshotUri, 0, rt_strlen(g_workerSnapshotUri))
        g_snapshotCacheResult = copy_sub_string(body, start, endOffset - start)
        g_snapshotCacheGeneration = g_analysisGeneration
    end
    toolJsonFree(document)
end.
var g_pollState: int = 0

func lspInputReady() -> int:
    native_write_i64(g_pollState, 0, 1 shl 32)
    let platform = sys_platform()
    var ready = 0
    if platform == Platform.MacOS_ARM64 do
        ready = syscall3(0x20000E6, g_pollState, 1, 10)
    eif platform == Platform.Linux_x86_64 do
        ready = syscall3(7, g_pollState, 1, 10)
    else
        native_write_i64(g_pollState, 8, 0)
        native_write_i64(g_pollState, 16, 10000000)
        ready = syscall5(73, g_pollState, 1, g_pollState + 8, 0, 8)
    end
    if ready == 0 do g_pollElapsedNs = g_pollElapsedNs + 10000000 end
    out ready
end.

func lspWorkerRelease():
    if g_workerSnapshotUri != 0 do vir_free(g_workerSnapshotUri) end
    g_workerSnapshotUri = 0
    if g_workerOutput != 0 do
        sys_munmap(g_workerOutput, LSP_WORKER_CAPACITY)
        g_workerOutput = 0
    end
    g_workerPid = 0
    g_workerRequest = -1
end.

func lspWorkerStop(code: int, message: string):
    lspSnapshotCacheClear()
    if g_workerPid > 0 do
        sys_kill(g_workerPid, 9)
        sys_wait4(g_workerPid, g_workerStatus, 0)
        let request = g_workerRequest
        lspWorkerRelease()
        if request >= 0 do lsp_send_error(request, code, message) end
    end
end.

func lspDiscardQueued(code: int, message: &string):
    when g_workerQueue != 0 loop
        let item = g_workerQueue
        g_workerQueue = native_read_i64(item, 0)
        let request = native_read_i64(item, 24)
        if request >= 0 do lsp_send_error(request, code, message) end
        if native_read_i64(item, 8) != 0 do vir_free(native_read_i64(item, 8)) end
        vir_free(native_read_i64(item, 32))
        vir_free(item)
    end
    g_workerQueueTail = 0
    g_workerQueueCount = 0
end.

func lspCancelRequest(requestId: int):
    if g_workerPid > 0 do
        if g_workerRequest == requestId do
            lspWorkerStop(-32800, "Request cancelled")
        end
    end
    var item = g_workerQueue
    var previous = 0
    when item != 0 loop
        let next = native_read_i64(item, 0)
        if native_read_i64(item, 24) == requestId do
            if previous == 0 do g_workerQueue = next
            else native_write_i64(previous, 0, next) end
            if g_workerQueueTail == item do g_workerQueueTail = previous end
            if native_read_i64(item, 8) != 0 do vir_free(native_read_i64(item, 8)) end
            vir_free(native_read_i64(item, 32))
            vir_free(item)
            g_workerQueueCount = g_workerQueueCount - 1
            lsp_send_error(requestId, -32800, "Request cancelled")
            out 0
        end
        previous = item
        item = next
    end
end.

func lspRunAnalysisWorker(body: int, length: int, requestId: int):
    if g_snapshotCacheResult != 0 and requestId >= 0 do
        if g_snapshotCacheGeneration == g_analysisGeneration do
            if rt_streq(g_snapshotCacheUri, g_doc_uri) == 1 do
                if lspSnapshotRequest(body, length) == 1 do
                    lsp_send_response(requestId, g_snapshotCacheResult as string)
                    out 0
                end
            end
        end
    end
    if g_workerQueueCount >= 64 do
        if requestId >= 0 do lsp_send_error(requestId, -32603, "Analysis queue is full") end
        out 0
    end
    let item = vir_alloc(48)
    native_write_i64(item, 0, 0)
    var savedBody = 0
    if body != 0 do savedBody = copy_sub_string(body, 0, length) end
    native_write_i64(item, 8, savedBody)
    native_write_i64(item, 16, length)
    native_write_i64(item, 24, requestId)
    native_write_i64(item, 32, copy_sub_string(g_doc_uri, 0, rt_strlen(g_doc_uri)))
    native_write_i64(item, 40, lspNowNs())
    if g_workerQueueTail == 0 do g_workerQueue = item
    else native_write_i64(g_workerQueueTail, 0, item) end
    g_workerQueueTail = item
    g_workerQueueCount = g_workerQueueCount + 1
end.

func lspWorkerTick():
    if g_workerPid > 0 do
        native_write_i64(g_workerStatus, 0, 0)
        let waited = sys_wait4(g_workerPid, g_workerStatus, 1)
        if waited == g_workerPid do
            let request = g_workerRequest
            let length = native_read_i64(g_workerOutput, 0)
            if native_read_i64(g_workerStatus, 0) == 0 & length > 0 & length < LSP_WORKER_CAPACITY - 8 do
                var frame = 0
                when frame < length loop
                    let frameLength = native_read_i64(g_workerOutput, frame + 8)
                    if frameLength <= 0 do break end
                    if frame + frameLength + 8 > length do break end
                    lspSnapshotCacheStore(g_workerOutput + frame + 16, frameLength)
                    lsp_send_raw(g_workerOutput + frame + 16, frameLength)
                    frame = frame + frameLength + 8
                end
            else
                if request >= 0 do lsp_send_error(request, -32603, "Compiler analysis worker failed") end
            end
            lspWorkerRelease()
        else
            if lspNowNs() - g_workerStarted > 10000000000 do
                lspWorkerStop(-32800, "Compiler analysis timed out")
            end
        end
    end
    if g_workerPid != 0 do out 0 end
    if g_workerQueue == 0 do out 0 end
    let item = g_workerQueue
    if native_read_i64(item, 24) < 0 do
        let queuedAt = native_read_i64(item, 40)
        let now = lspNowNs()
        if queuedAt >= 0 and now >= queuedAt do
            if now - queuedAt < 50000000 do out 0 end
        end
    end
    g_workerQueue = native_read_i64(item, 0)
    if g_workerQueue == 0 do g_workerQueueTail = 0 end
    g_workerQueueCount = g_workerQueueCount - 1
    let body = native_read_i64(item, 8)
    let length = native_read_i64(item, 16)
    g_workerRequest = native_read_i64(item, 24)
    lspSelectDocument(native_read_i64(item, 32))
    if lspSnapshotRequest(body, length) == 1 do
        g_workerSnapshotUri = copy_sub_string(g_doc_uri, 0, rt_strlen(g_doc_uri))
    end
    var flags = 0x1001
    if sys_platform() != Platform.MacOS_ARM64 do flags = 0x21 end
    g_workerOutput = sys_mmap(0, LSP_WORKER_CAPACITY, 3, flags, -1, 0)
    if g_workerOutput <= 0 do
        g_workerOutput = 0
        if g_workerRequest >= 0 do lsp_send_error(g_workerRequest, -32603, "Unable to allocate analysis response") end
    else
        native_write_i64(g_workerOutput, 0, 0)
        let parentPid = sys_getpid()
        let childPid = sys_fork()
        if sys_getpid() != parentPid do
            g_analysisSupervisor = 0
            lsp_analyze_document()
            if body == 0 do lsp_publish_diagnostics()
            else lsp_dispatch_message(body, length) end
            sys_exit(0)
        end
        if childPid > 0 do
            g_workerPid = childPid
            g_workerStarted = lspNowNs()
        else
            let request = g_workerRequest
            lspWorkerRelease()
            if request >= 0 do lsp_send_error(request, -32603, "Unable to start compiler analysis worker") end
        end
    end
    if body != 0 do vir_free(body) end
    vir_free(native_read_i64(item, 32))
    vir_free(item)
end.

func lspIsAnalysisRequest(method: int) -> int:
    if rt_streq(method, "textDocument/hover") == 1 do out 1 end
    if rt_streq(method, "textDocument/completion") == 1 do out 1 end
    if rt_streq(method, "textDocument/definition") == 1 do out 1 end
    if rt_streq(method, "textDocument/references") == 1 do out 1 end
    if rt_streq(method, "textDocument/prepareRename") == 1 do out 1 end
    if rt_streq(method, "textDocument/rename") == 1 do out 1 end
    if rt_streq(method, "textDocument/semanticTokens/full") == 1 do out 1 end
    if rt_streq(method, "vir/semanticSnapshot") == 1 do out 1 end
    out 0
end.

func lsp_dispatch_message(body_buf: int, body_len: int):
    let doc = toolJsonParse(body_buf, body_len)
    if doc == 0 do
        out 0
    end

    let id_node = toolJsonField(doc, 1, "id")
    let id_val = toolJsonInteger(doc, id_node, 0)

    let method_node = toolJsonField(doc, 1, "method")
    let method_str = toolJsonString(doc, method_node)

    if method_str != 0 do
        let requestParams = toolJsonField(doc, 1, "params")
        let requestDocument = toolJsonField(doc, requestParams, "textDocument")
        let requestUri = toolJsonString(doc, toolJsonField(doc, requestDocument, "uri"))
        if requestUri != 0 do
            if lspValidDocumentUri(requestUri) == 0 do
                if id_node > 0 do lsp_send_error(id_val, -32602, "Unsupported or malformed document URI") end
                toolJsonFree(doc)
                out 0
            end
        end
        if g_analysisSupervisor == 1 do
            if rt_streq(method_str, "$/cancelRequest") == 1 do
                let cancelId = toolJsonInteger(doc, toolJsonField(doc, requestParams, "id"), -1)
                if cancelId >= 0 do lspCancelRequest(cancelId) end
                toolJsonFree(doc)
                out 0
            end
        end
        if rt_streq(method_str, "textDocument/didClose") == 1 do
            lspWorkerStop(-32801, "Document closed")
            lspDiscardQueued(-32801, "Document closed")
            if requestUri != 0 do lspCloseDocument(requestUri) end
            toolJsonFree(doc)
            out 0
        end
        if requestUri != 0 and rt_streq(method_str, "textDocument/didOpen") == 0 and rt_streq(method_str, "vir/diagnosticSnapshot") == 0 do
            if lspSelectDocument(requestUri) == 0 do
                if id_node > 0 do lsp_send_error(id_val, 0 - 32602, "Document is not open") end
                toolJsonFree(doc)
                out 0
            end
            if rt_streq(method_str, "textDocument/didChange") == 1 do
                let incomingVersion = toolJsonInteger(doc, toolJsonField(doc, requestDocument, "version"), 0)
                if incomingVersion <= g_doc_version do
                    toolJsonFree(doc)
                    out 0
                end
            end
        end
        if g_analysisSupervisor == 1 & id_node > 0 & lspIsAnalysisRequest(method_str) == 1 do
            lspRunAnalysisWorker(body_buf, body_len, id_val)
            toolJsonFree(doc)
            out 0
        end
        if rt_streq(method_str, "initialize") do
            let clientCaps = toolJsonField(doc, requestParams, "capabilities")
            let workspaceCaps = toolJsonField(doc, clientCaps, "workspace")
            let editCaps = toolJsonField(doc, workspaceCaps, "workspaceEdit")
            let versioned = toolJsonField(doc, editCaps, "documentChanges")
            g_versionedEdits = 0
            if versioned > 0 do
                if native_read_i64(toolJsonNode(doc, versioned), 0) == 5 do g_versionedEdits = 1 end
            end
            let caps = lsp_get_capabilities_json()
            lsp_send_response(id_val, caps as string)
        end
        if rt_streq(method_str, "initialized") do
            # Client confirmed initialization
        end
        if rt_streq(method_str, "textDocument/didOpen") do
            lspWorkerStop(-32801, "Workspace changed")
            lspDiscardQueued(-32801, "Workspace changed")
            let params_node = toolJsonField(doc, 1, "params")
            let td_node = toolJsonField(doc, params_node, "textDocument")
            let uri_node = toolJsonField(doc, td_node, "uri")
            let uri_str = toolJsonString(doc, uri_node)
            let ver_node = toolJsonField(doc, td_node, "version")
            let text_node = toolJsonField(doc, td_node, "text")
            let text_str = toolJsonString(doc, text_node)

            if uri_str != 0 do
                let ulen = rt_strlen(uri_str as i64)
                if g_doc_uri != 0 do vir_free(g_doc_uri) end
                g_doc_uri = vir_alloc(ulen + 1)
                rt_memcpy(g_doc_uri, uri_str as int, ulen)
                native_write_u8(g_doc_uri, ulen, 0)
            end

            g_doc_version = toolJsonInteger(doc, ver_node, 1)

            if text_str != 0 do
                let tlen = rt_strlen(text_str as i64)
                if g_doc_text != 0 do vir_free(g_doc_text) end
                g_doc_text = vir_alloc(tlen + 1)
                rt_memcpy(g_doc_text, text_str as int, tlen)
                native_write_u8(g_doc_text, tlen, 0)
                g_doc_text_len = tlen
            end

            lspSaveDocument()
            lsp_analyze_document()
            lsp_publish_diagnostics()
        end
        if rt_streq(method_str, "textDocument/didChange") do
            lspWorkerStop(-32801, "Document changed")
            lspDiscardQueued(-32801, "Document changed")
            let params_node = toolJsonField(doc, 1, "params")
            let td_node = toolJsonField(doc, params_node, "textDocument")
            let ver_node = toolJsonField(doc, td_node, "version")
            g_doc_version = toolJsonInteger(doc, ver_node, g_doc_version + 1)

            let cc_node = toolJsonField(doc, params_node, "contentChanges")
            var first_change = 0
            if cc_node > 0 do
                first_change = native_read_i64(toolJsonNode(doc, cc_node), 24)
            end
            var text_str = 0
            if first_change > 0 do
                let text_node = toolJsonField(doc, first_change, "text")
                text_str = toolJsonString(doc, text_node)
            end

            if text_str != 0 do
                let tlen = rt_strlen(text_str as i64)
                if g_doc_text != 0 do vir_free(g_doc_text) end
                g_doc_text = vir_alloc(tlen + 1)
                rt_memcpy(g_doc_text, text_str as int, tlen)
                native_write_u8(g_doc_text, tlen, 0)
                g_doc_text_len = tlen
            end

            lspSaveDocument()
            lsp_analyze_document()
            lsp_publish_diagnostics()
        end
        if rt_streq(method_str, "textDocument/hover") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            lsp_handle_hover(id_val, q_line, q_col)
        end
        if rt_streq(method_str, "textDocument/definition") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            lsp_handle_definition(id_val, q_line, q_col)
        end
        if rt_streq(method_str, "textDocument/references") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            lsp_handle_references(id_val, q_line, q_col)
        end
        if rt_streq(method_str, "textDocument/completion") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            lsp_handle_completion(id_val, q_line, q_col)
        end
        if rt_streq(method_str, "textDocument/prepareRename") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            lsp_handle_prepare_rename(id_val, q_line, q_col)
        end
        if rt_streq(method_str, "textDocument/rename") do
            let params_node = toolJsonField(doc, 1, "params")
            let pos_node = toolJsonField(doc, params_node, "position")
            let line_node = toolJsonField(doc, pos_node, "line")
            let char_node = toolJsonField(doc, pos_node, "character")
            let q_line = toolJsonInteger(doc, line_node, 0)
            let q_col = toolJsonInteger(doc, char_node, 0)
            let nn_node = toolJsonField(doc, params_node, "newName")
            let new_name_str = toolJsonString(doc, nn_node)
            lsp_handle_rename(id_val, q_line, q_col, new_name_str)
        end
        if rt_streq(method_str, "textDocument/semanticTokens/full") do
            lsp_handle_semantic_tokens(id_val)
        end
        if rt_streq(method_str, "vir/semanticSnapshot") do
            let params = toolJsonField(doc, 1, "params")
            let version = toolJsonField(doc, params, "version")
            if version > 0 do
                if toolJsonInteger(doc, version, -1) != g_doc_version do
                    lsp_send_error(id_val, -32801, "Snapshot document version is stale")
                    out 0
                end
            end
            g_requestedFocusId = 0
            let mode = toolJsonString(doc, toolJsonField(doc, params, "mode"))
            if mode != 0 do
                if rt_streq(mode, "full") == 0 & rt_streq(mode, "focus") == 0 do
                    lsp_send_error(id_val, -32602, "Unsupported snapshot mode")
                    out 0
                end
                if rt_streq(mode, "focus") == 1 do
                    g_requestedFocusId = toolJsonString(doc, toolJsonField(doc, params, "focusSymbolId"))
                    var foundFocus = 0
                    if g_requestedFocusId != 0 do
                        var symbolIndex = 0
                        when symbolIndex < g_sym_count loop
                            if rt_streq(rt_itoa(sym_get_id(symbolIndex)), g_requestedFocusId) == 1 do foundFocus = 1 end
                            symbolIndex = symbolIndex + 1
                        end
                    end
                    if foundFocus == 0 do
                        lsp_send_error(id_val, -32602, "Focus symbol is unavailable in this analysis")
                        out 0
                    end
                end
            end
            lsp_handle_semantic_snapshot(id_val)
        end
        if rt_streq(method_str, "vir/diagnosticSnapshot") do
            let params_node = toolJsonField(doc, 1, "params")
            var uri_str = 0
            var code_str = 0
            var build_str = 0
            if params_node > 0 do
                let td_node = toolJsonField(doc, params_node, "textDocument")
                if td_node > 0 do
                    let u_node = toolJsonField(doc, td_node, "uri")
                    uri_str = toolJsonString(doc, u_node)
                end
                if uri_str == 0 do
                    let u_node2 = toolJsonField(doc, params_node, "uri")
                    uri_str = toolJsonString(doc, u_node2)
                end
                let c_node = toolJsonField(doc, params_node, "code")
                code_str = toolJsonString(doc, c_node)
                let b_node = toolJsonField(doc, params_node, "buildId")
                build_str = toolJsonString(doc, b_node)
            end
            lsp_handle_diagnostic_snapshot(id_val, uri_str, code_str, build_str)
        end
        if rt_streq(method_str, "shutdown") do
            lspWorkerStop(-32800, "Server shutting down")
            lspDiscardQueued(-32800, "Server shutting down")
            g_is_shutdown = 1
            lsp_send_null_response(id_val)
        end
        if rt_streq(method_str, "exit") do
            lspWorkerStop(-32800, "Server exiting")
            lspDiscardQueued(-32800, "Server exiting")
            toolJsonFree(doc)
            if g_is_shutdown == 1 do
                sys_exit(0)
            else
                sys_exit(1)
            end
        end
    end

    toolJsonFree(doc)
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# Main Stdio Loop
# ═════════════════════════════════════════════════════════════════════

func lsp_stdio_server():
    cliClockReset()
    g_sessionStartedNs = cliClockNowNs()
    g_sessionProcessId = sys_getpid()
    let hdr_buf = vir_alloc(4096)
    g_workerStatus = vir_alloc(8)
    g_pollState = vir_alloc(24)

    # Initialize analysis tables
    g_sym_table = vir_alloc(512 * 88)
    g_occ_table = vir_alloc(2048 * 88)
    g_mod_table = vir_alloc(128 * 40)
    g_diag_table = vir_alloc(g_diag_capacity * 72)
    g_func_scopes = vir_alloc(256 * 24)
    g_scope_table = vir_alloc(1024 * 40)
    g_scope_stack = vir_alloc(128 * 8)

    loop
        if lspInputReady() <= 0 do
            lspWorkerTick()
            skip
        end
        let hdr_len = lsp_read_header(hdr_buf, 4096)
        if hdr_len < 0 do
            lspWorkerStop(-32800, "Input closed")
            lspDiscardQueued(-32800, "Input closed")
            vir_free(g_workerStatus)
            vir_free(g_pollState)
            when g_openDocuments != 0 loop
                let node = g_openDocuments
                g_openDocuments = native_read_i64(node, 0)
                vir_free(native_read_i64(node, 8))
                vir_free(native_read_i64(node, 16))
                vir_free(node)
            end
            if g_doc_uri != 0 do vir_free(g_doc_uri) end
            if g_doc_text != 0 do vir_free(g_doc_text) end
            vir_free(hdr_buf)
            vir_free(g_sym_table)
            vir_free(g_occ_table)
            vir_free(g_mod_table)
            vir_free(g_diag_table)
            vir_free(g_func_scopes)
            vir_free(g_scope_table)
            vir_free(g_scope_stack)
            out 0
        end

        let content_len = lsp_parse_content_length(hdr_buf, hdr_len)
        if content_len > 0 do
            let body_buf = vir_alloc(content_len + 8)
            let read_bytes = lsp_read_exact(body_buf, content_len)
            if read_bytes == content_len do
                lsp_dispatch_message(body_buf, content_len)
            end
            vir_free(body_buf)
        end
    end

    vir_free(hdr_buf)
    vir_free(g_sym_table)
    vir_free(g_occ_table)
    vir_free(g_mod_table)
    vir_free(g_diag_table)
    vir_free(g_func_scopes)
    vir_free(g_scope_table)
    vir_free(g_scope_stack)
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# Entry Point
# ═════════════════════════════════════════════════════════════════════

func main():
    let argc = arg_count()
    if argc <= 1 do
        print_help()
        sys_exit(0)
    end

    var is_stdio = 0
    var cli_sysroot = 0
    var explicit_registry = 0
    var argument = 1
    when argument < argc loop
        let a = get_arg(argument)
        if rt_streq(a as i64, "--stdio" as i64) == 1 do
            is_stdio = 1
            argument = argument + 1
        eif rt_streq(a as i64, "--stdlib-registry" as i64) == 1 do
            if argument + 1 >= argc do sys_exit(1) end
            explicit_registry = get_arg(argument + 1)
            argument = argument + 2
        eif rt_streq(a as i64, "--sysroot" as i64) == 1 do
            if argument + 1 >= argc do sys_exit(1) end
            cli_sysroot = get_arg(argument + 1)
            argument = argument + 2
        eif rt_streq(a as i64, "help" as i64) == 1 or rt_streq(a as i64, "-h" as i64) == 1 or rt_streq(a as i64, "--help" as i64) == 1 do
            print_help()
            sys_exit(0)
        eif rt_streq(a as i64, "version" as i64) == 1 or rt_streq(a as i64, "-v" as i64) == 1 or rt_streq(a as i64, "--version" as i64) == 1 do
            print_version()
            sys_exit(0)
        else
            let err_msg = "vir-lsp: unknown option. Run 'vir-lsp --help' for usage."
            lsp_print_str(err_msg)
            sys_exit(1)
        end
    end

    # Shared toolchain sysroot discovery: Precedence 1 (--sysroot), Precedence 2 (VIR_SYSROOT), Precedence 3 (executable)
    virc_resolve_sysroot(cli_sysroot)
    if explicit_registry != 0 do
        let parent_dir = virc_path_parent(explicit_registry)
        if virc_validate_registry_file(explicit_registry, parent_dir) != 1 do
            if parent_dir != 0 do vir_free(parent_dir) end
            lsp_print_str("vir-lsp: error [E2120]: invalid or incompatible explicit stdlib registry")
            sys_exit(1)
        end
        if parent_dir != 0 do vir_free(parent_dir) end
        g_ideStdlibRegistry = explicit_registry
    else
        g_ideStdlibRegistry = g_virc_stdlib_registry
    end

    if g_ideStdlibRegistry == 0 do
        lsp_print_str("vir-lsp: error [E2120]: failed to resolve toolchain sysroot and stdlib")
        sys_exit(1)
    end

    if is_stdio == 1 do
        lsp_stdio_server()
        sys_exit(0)
    end
    print_help()
    sys_exit(0)
end.

# Per-source metadata shares the overlay list layout used by the compiler.
# [next, normalized path, source fat-string, original URI, document version]
var g_buildSource: int = 0
var g_buildLoan: int = 0
var g_buildLifetimeEnd: int = 0
var g_rootSource: int = 0
var g_rootTokens: int = 0

func lspHexDigit(value: int) -> int:
    if value >= 48 & value <= 57 do out value - 48 end
    if value >= 65 & value <= 70 do out value - 55 end
    if value >= 97 & value <= 102 do out value - 87 end
    out -1
end.

# The native VFS accepts absolute local paths. Reject unsupported authorities,
# malformed escapes and encoded NUL before a URI can alias another file.
func lspValidDocumentUri(uri: int) -> int:
    if uri == 0 do out 0 end
    let length = rt_strlen(uri)
    if length < 8 do out 0 end
    let prefix = "file:///" as int
    var index = 0
    when index < 8 loop
        if native_read_u8(uri, index) != native_read_u8(prefix, index) do out 0 end
        index = index + 1
    end
    when index < length loop
        let value = native_read_u8(uri, index)
        if value < 32 do out 0 end
        if value == 63 do out 0 end
        if value == 35 do out 0 end
        if value == 37 do
            if index + 2 >= length do out 0 end
            let high = lspHexDigit(native_read_u8(uri, index + 1))
            let low = lspHexDigit(native_read_u8(uri, index + 2))
            if high < 0 do out 0 end
            if low < 0 do out 0 end
            if high * 16 + low == 0 do out 0 end
            index = index + 2
        end
        index = index + 1
    end
    out 1
end.

func lspUriPath(uri: int) -> int:
    let length = rt_strlen(uri)
    var start = 0
    if length >= 7 do
        if native_read_u8(uri, 0) == 102 & native_read_u8(uri, 4) == 58 do start = 7 end
    end
    let result = vir_alloc(length + 1)
    var position = 0
    when start < length loop
        let value = native_read_u8(uri, start)
        if value == 37 & start + 2 < length do
            let high = lspHexDigit(native_read_u8(uri, start + 1))
            let low = lspHexDigit(native_read_u8(uri, start + 2))
            if high >= 0 & low >= 0 do
                native_write_u8(result, position, high * 16 + low)
                start = start + 3
                position = position + 1
                skip
            end
        end
        native_write_u8(result, position, value)
        position = position + 1
        start = start + 1
    end
    native_write_u8(result, position, 0)
    out result
end.

func lspBuildOverlay():
    g_ideVirtualFiles = 0
    var document = g_openDocuments
    when document != 0 loop
        let entry = vir_alloc(40)
        let uri = native_read_i64(document, 8)
        let pathCstr: int = lspUriPath(uri)
        let pathFat: int = str_from_cstr(pathCstr) as int
        let normalizedPath: int = path_normalize_fat(pathFat as string) as int
        let documentText: int = native_read_i64(document, 16)
        let sourceFat: int = str_from_cstr(documentText) as int
        native_write_i64(entry, 0, g_ideVirtualFiles)
        native_write_i64(entry, 8, normalizedPath)
        native_write_i64(entry, 16, sourceFat)
        native_write_i64(entry, 24, uri)
        native_write_i64(entry, 32, native_read_i64(document, 24))
        g_ideVirtualFiles = entry
        if rt_streq(uri, g_doc_uri) == 1 do g_rootSource = entry end
        document = native_read_i64(document, 0)
    end
    g_buildSource = g_rootSource
end.

func lspSourceUri(source: int) -> int:
    if source == 0 do out g_doc_uri end
    let uri = native_read_i64(source, 24)
    if uri == 0 do out g_doc_uri end
    out uri
end.

func lspSourceUtf16(source: int, line: int, column: int) -> int:
    if source == 0 do out lsp_byte_col_to_utf16(line, column) end
    let text = native_read_i64(source, 16)
    if text == 0 do out lsp_byte_col_to_utf16(line, column) end
    let saved = g_doc_text
    let savedLength = g_doc_text_len
    g_doc_text = native_read_i64(text, 0)
    g_doc_text_len = native_read_i64(text, 8)
    let result = lsp_byte_col_to_utf16(line, column)
    g_doc_text = saved
    g_doc_text_len = savedLength
    out result
end.

func lspSourceForFile(fileId: int) -> int:
    let path = sm_get_file_path(g_active_source_manager, fileId)
    out lspSourceForPath(path)
end.

func lspSourceForPath(path: int) -> int:
    if path == 0 do out 0 end
    let normalized: int = path_normalize_fat(str_from_cstr(path)) as int
    var entry = g_ideVirtualFiles
    let normalizedData: int = native_read_i64(normalized, 0)
    when entry != 0 loop
        let entryPath: int = native_read_i64(entry, 8)
        let entryData: int = native_read_i64(entryPath, 0)
        if rt_streq(normalizedData, entryData) == 1 do out entry end
        entry = native_read_i64(entry, 0)
    end
    let text = try_read_file(normalized as string)
    if text == 0 do out 0 end
    let uri = vir_alloc(rt_strlen(path) * 3 + 8)
    rt_memcpy(uri, "file://" as int, 7)
    var index = 0
    var position = 7
    let hex = "0123456789ABCDEF"
    when native_read_u8(path, index) != 0 loop
        let value = native_read_u8(path, index)
        if value == 32 || value == 37 || value == 35 || value == 63 do
            native_write_u8(uri, position, 37)
            native_write_u8(uri, position + 1, native_read_u8(hex as int, value / 16))
            native_write_u8(uri, position + 2, native_read_u8(hex as int, value mod 16))
            position = position + 3
        else
            native_write_u8(uri, position, value)
            position = position + 1
        end
        index = index + 1
    end
    native_write_u8(uri, position, 0)
    entry = vir_alloc(40)
    native_write_i64(entry, 0, g_ideVirtualFiles)
    native_write_i64(entry, 8, normalized)
    native_write_i64(entry, 16, text)
    native_write_i64(entry, 24, uri)
    native_write_i64(entry, 32, -1)
    g_ideVirtualFiles = entry
    out entry
end.

var g_compilerAnalysisAvailable: int = 0
var g_compilerSymbolFacts: int = 0
var g_compilerSymbolScopes: int = 0
var g_compilerSymbolCoverage: int = 0
var g_compilerSymbolImportSafety: int = 0

func lspCompilerTypeName(kind: int) -> int:
    if kind == 1 do out "int" as int end
    if kind == 2 do out "float" as int end
    if kind == 3 do out "bool" as int end
    if kind == 4 do out "string" as int end
    if kind == 5 do out "entity" as int end
    if kind == 6 do out "enum" as int end
    if kind == 7 do out "array" as int end
    if kind == 9 do out "ptr" as int end
    if kind == 10 do out "dict" as int end
    if kind == 11 do out "tuple" as int end
    if kind == 12 do out "&" as int end
    if kind == 13 do out "&mut" as int end
    if kind == 20 do out "tensor" as int end
    if kind == 21 do out "none" as int end
    out "unknown" as int
end.

# Anchor AST facts using compiler lexer tokens, never a name search in source text.
func lspCompilerToken(fact: int, role: int) -> int:
    let fatName = native_read_i64(fact, 96)
    if fatName == 0 do out 0 end
    let line = native_read_i64(fact, 88)
    let originSpan = native_read_i64(fact, 80)
    # Lexer finalization assigns consecutive span IDs. Validate the candidate
    # before using this index; retain a bounded scan for nonconsecutive origins.
    if originSpan > 0 and lexer_token_count() > 0 do
        let firstToken = lexer_token_get(0)
        let candidateIndex = originSpan - native_read_i64(firstToken, 72)
        if candidateIndex >= 0 and candidateIndex < lexer_token_count() do
            let candidate = lexer_token_get(candidateIndex)
            if native_read_i64(candidate, 72) == originSpan do out candidate end
        end
    end
    var column = 0
    let span = sm_get_span(g_active_source_manager, native_read_i64(fact, 80))
    if span != 0 do column = native_read_i64(span, 16) end
    var match = 0
    var count = 0
    var ti = 0
    when ti < lexer_token_count() loop
        let token = lexer_token_get(ti)
        var originMatches = 0
        if originSpan > 0 do
            if native_read_i64(token, 72) == originSpan do originMatches = 1 end
        end
        if originMatches == 1 do out token end
        if native_read_i64(token, 8) == line or originMatches == 1 do
            let start = native_read_i64(token, 24)
            let length = native_read_i64(token, 32)
            if length == native_read_i64(fatName, 8) do
                let tokenName = copy_sub_string(g_ideExpandedSource, start, length)
                let sameName = fat_cstr_eq(fatName, tokenName)
                vir_free(tokenName)
                if sameName == 1 do
                    if originMatches == 1 do out token end
                    let tokenColumn = native_read_i64(token, 16)
                    if column > 0 and tokenColumn == column do out token end
                    count = count + 1
                    if match == 0 do match = token end
                end
            end
        end
        ti = ti + 1
    end
    if count == 1 do out match end
    out 0
end.

func lspCompilerSignature(ast: int) -> int:
    let children = native_read_i64(ast, 64)
    var capacity = 128
    var index = 0
    when index < vec_len_rt(children) loop
        let parameter = vec_get_rt(children, index)
        let name = native_read_i64(parameter, 0)
        let annotation = native_read_i64(parameter, 8)
        if name != 0 do capacity = capacity + native_read_i64(name, 8) end
        if annotation != 0 do capacity = capacity + native_read_i64(annotation, 8) end
        capacity = capacity + 16
        index = index + 1
    end
    let returnType = native_read_i64(ast, 8)
    if returnType != 0 do capacity = capacity + native_read_i64(returnType, 8) end
    let buffer = vir_alloc(capacity)
    var position = lspAppendRaw(buffer, 0, "(" as int)
    var parameterCount = 0
    index = 0
    when index < vec_len_rt(children) loop
        let parameter = vec_get_rt(children, index)
        let kind = native_read_i64(parameter, 16)
        if kind == 22 or kind == 66 or kind == 119 or kind == 33 do
            if parameterCount > 0 do position = lspAppendRaw(buffer, position, ", " as int) end
            if kind == 66 do position = lspAppendRaw(buffer, position, "ref " as int) end
            if kind == 119 do position = lspAppendRaw(buffer, position, "out " as int) end
            let name = native_read_i64(parameter, 0)
            position = lspAppendRaw(buffer, position, native_read_i64(name, 0))
            position = lspAppendRaw(buffer, position, ": " as int)
            let annotation = native_read_i64(parameter, 8)
            if annotation != 0 and native_read_i64(annotation, 8) > 0 do
                position = lspAppendRaw(buffer, position, native_read_i64(annotation, 0))
            else
                position = lspAppendRaw(buffer, position, "unknown" as int)
            end
            parameterCount = parameterCount + 1
        end
        index = index + 1
    end
    position = lspAppendRaw(buffer, position, ") -> " as int)
    if returnType != 0 and native_read_i64(returnType, 8) > 0 do
        position = lspAppendRaw(buffer, position, native_read_i64(returnType, 0))
    else
        position = lspAppendRaw(buffer, position, "void" as int)
    end
    native_write_u8(buffer, position, 0)
    out buffer
end.

func lspCompilerImportOrigin(fact: int) -> int:
    let name = native_read_i64(fact, 96)
    let span = sm_get_span(g_active_source_manager, native_read_i64(fact, 80))
    if name == 0 or span == 0 do out 0 end
    let source = lspSourceForFile(native_read_i64(span, 0))
    let sourcePath = native_read_i64(source, 8)
    var index = 0
    when index < vec_len_rt(g_ideImportOrigins) loop
        let origin = vec_get_rt(g_ideImportOrigins, index)
        if fat_str_eq(name as string, native_read_i64(origin, 0) as string) == 1 do
            let parentPath = path_normalize_fat(str_from_cstr(native_read_i64(origin, 24)))
            let importedPath = path_normalize_fat(str_from_cstr(native_read_i64(origin, 16)))
            if fat_str_eq(parentPath, native_read_i64(g_rootSource, 8) as string) == 1 do
                if fat_str_eq(importedPath, sourcePath as string) == 1 do out origin end
            end
        end
        index = index + 1
    end
    out 0
end.

func lspCompilerImportToken(origin: int) -> int:
    let name = native_read_i64(origin, 0)
    let line = native_read_i64(origin, 32)
    var index = 0
    when index < vec_len_rt(g_rootTokens) loop
        let token = vec_get_rt(g_rootTokens, index)
        if native_read_i64(token, 8) == line do
            let length = native_read_i64(token, 32)
            if length == native_read_i64(name, 8) do
                let spelling = copy_sub_string(g_doc_text, native_read_i64(token, 24), length)
                let sameName = fat_cstr_eq(name, spelling)
                vir_free(spelling)
                if sameName == 1 do
                    # `import helper from helper` has the same spelling for
                    # its local selector and module path.  The first matching
                    # token on the statement is the selector; later matches
                    # are the module path or aliases and must not make this
                    # otherwise exact source origin ambiguous.
                    out token
                end
            end
        end
        index = index + 1
    end
    out 0
end.

func lspApplyCompilerFacts():
    lspBuildOverlay()
    # Root import tokens precede expansion and use their own byte columns.
    g_active_source_manager = 0
    lexer_lex(g_doc_text)
    g_rootTokens = vec_new_rt()
    var rootTokenIndex = 0
    when rootTokenIndex < lexer_token_count() loop
        g_rootTokens = vec_push_rt(g_rootTokens, lexer_token_get(rootTokenIndex))
        rootTokenIndex = rootTokenIndex + 1
    end
    let rootPath = native_read_i64(native_read_i64(g_rootSource, 8), 0)
    g_compilerAnalysisAvailable = ideSessionAnalyze(g_doc_text, rootPath)
    g_diag_count = 0
    g_diagSource = g_rootSource
    g_diagRecord = 0
    lspApplyCompilerDiagnostics()
    if g_compilerAnalysisAvailable == 0 do
        g_compilerAnalysisFailure = 1
        out 0
    end
    lspApplyCompilerModules()
    var declarationCount = 0
    var referenceCount = 0
    var capacityFact = 0
    when capacityFact < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, capacityFact)
        if native_read_i64(fact, 8) >= 0 do
            let role = native_read_i64(fact, 24)
            if role == 1 do declarationCount = declarationCount + 1 end
            if role > 1 do referenceCount = referenceCount + 1 end
        end
        capacityFact = capacityFact + 1
    end
    if declarationCount > 500 or declarationCount + referenceCount > 2000 do
        g_compilerAnalysisAvailable = 0
        g_compilerAnalysisFailure = 2
        out 0
    end
    if g_compilerSymbolScopes == 0 do
        g_compilerSymbolFacts = vir_alloc(500 * 8)
        g_compilerSymbolScopes = vir_alloc(500 * 8)
        g_compilerSymbolCoverage = vir_alloc(500 * 8)
        g_compilerSymbolImportSafety = vir_alloc(500 * 8)
    end
    g_sym_count = 0
    g_occ_count = 0
    var fi = 0
    g_buildLoan = 0
    g_buildLifetimeEnd = 0
    when fi < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, fi)
        let ast = native_read_i64(fact, 0)
        let role = native_read_i64(fact, 24)
        let resolverId = native_read_i64(fact, 8)
        if role == 1 and resolverId >= 0 do
            let token = lspCompilerToken(fact, role)
            if token != 0 do
                let tokenSpan = sm_get_span(g_active_source_manager, native_read_i64(token, 72))
                var line = native_read_i64(tokenSpan, 8) - 1
                var col = native_read_i64(token, 16) - 1
                g_buildSource = lspSourceForFile(native_read_i64(token, 64))
                var length = native_read_i64(token, 32)
                let name = copy_sub_string(g_ideExpandedSource, native_read_i64(token, 24), length)
                let importOrigin = lspCompilerImportOrigin(fact)
                var importedToken = 0
                if importOrigin != 0 do
                    importedToken = lspCompilerImportToken(importOrigin)
                    if fat_str_eq(native_read_i64(importOrigin, 0) as string, native_read_i64(importOrigin, 8) as string) == 0 do
                        if importedToken != 0 do
                            line = native_read_i64(importedToken, 8) - 1
                            col = native_read_i64(importedToken, 24) - lsp_get_line_start(line)
                            length = native_read_i64(importedToken, 32)
                            g_buildSource = g_rootSource
                        end
                    end
                end
                let nt = native_read_i64(fact, 104)
                var kind = 2
                var tokenKind = 8
                var state = 1024
                if nt == 2 do kind = 1; tokenKind = 12 end
                if nt == 17 or nt == 16 or nt == 63 or nt == 64 or nt == 87 or nt == 91 do kind = 3; tokenKind = 1 end
                if nt == 16 do tokenKind = 3 end
                if resolverId < vec_len_rt(g_ideSymbolNodes) do
                    if native_read_i64(vec_get_rt(g_ideSymbolNodes, resolverId), 0) == 8 do tokenKind = 10 end
                end
                if nt == 22 or nt == 66 or nt == 119 do kind = 4; tokenKind = 7 end
                if nt == 66 do state = 131072 end
                if nt == 119 do state = 4096 end
                var typeName = lspCompilerTypeName(native_read_i64(fact, 32))
                let annotation = native_read_i64(fact, 112)
                if annotation != 0 and native_read_i64(annotation, 8) > 0 do
                    typeName = copy_sub_string(native_read_i64(annotation, 0), 0, native_read_i64(annotation, 8))
                end
                if (annotation == 0 or native_read_i64(annotation, 8) == 0) and native_read_i64(fact, 32) == 5 do
                    let children = native_read_i64(ast, 64)
                    if vec_len_rt(children) > 0 do
                        let initializer = vec_get_rt(children, 0)
                        if native_read_i64(initializer, 16) == 43 do
                            let entityName = native_read_i64(initializer, 0)
                            if entityName != 0 and native_read_i64(entityName, 8) > 0 do
                                typeName = copy_sub_string(native_read_i64(entityName, 0), 0, native_read_i64(entityName, 8))
                            end
                        end
                    end
                end
                var lexicalScope = lsp_get_scope_for_line(line)
                if nt == 2 do typeName = lspCompilerSignature(ast) end
                if nt == 2 or nt == 17 or nt == 16 or nt == 63 or nt == 64 or nt == 87 or nt == 91 do lexicalScope = 0 end
                let sid = lsp_add_symbol_state_scoped(name, kind, line, col, col + length, typeName, "Compiler resolver/type snapshot" as int, state, lexicalScope)
                native_write_i64(g_sym_table, (g_sym_count - 1) * 88 + 72, resolverId + 1000000)
                native_write_i64(g_compilerSymbolFacts, (g_sym_count - 1) * 8, fact)
                native_write_i64(g_compilerSymbolScopes, (g_sym_count - 1) * 8, native_read_i64(fact, 16))
                native_write_i64(g_compilerSymbolCoverage, (g_sym_count - 1) * 8, 1)
                native_write_i64(g_compilerSymbolImportSafety, (g_sym_count - 1) * 8, 0)
                if importOrigin != 0 and importedToken != 0 do
                    if fat_str_eq(native_read_i64(importOrigin, 0) as string, native_read_i64(importOrigin, 8) as string) == 0 do
                        native_write_i64(g_compilerSymbolImportSafety, (g_sym_count - 1) * 8, 1)
                    end
                end
                lsp_add_occ(resolverId + 1000000, line, col, line, col + length, tokenKind, state, 1)
                if importOrigin != 0 do
                    if importedToken == 0 do native_write_i64(g_compilerSymbolCoverage, (g_sym_count - 1) * 8, 0) end
                    if fat_str_eq(native_read_i64(importOrigin, 0) as string, native_read_i64(importOrigin, 8) as string) == 1 do
                        if importedToken != 0 do
                            g_buildSource = g_rootSource
                            let importLine = native_read_i64(importedToken, 8) - 1
                            let importColumn = native_read_i64(importedToken, 24) - lsp_get_line_start(importLine)
                            lsp_add_occ(resolverId + 1000000, importLine, importColumn, importLine, importColumn + native_read_i64(importedToken, 32), tokenKind, state, 2)
                        end
                    end
                end
            end
        end
        fi = fi + 1
    end
    fi = 0
    when fi < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, fi)
        let role = native_read_i64(fact, 24)
        let resolverId = native_read_i64(fact, 8)
        if role > 1 and resolverId >= 0 do
            let ast = native_read_i64(fact, 0)
            let token = lspCompilerToken(fact, role)
            let si = lsp_find_sym_by_id(resolverId + 1000000)
            if token == 0 and si >= 0 do native_write_i64(g_compilerSymbolCoverage, si * 8, 0) end
            if token != 0 and si >= 0 do
                let tokenSpan = sm_get_span(g_active_source_manager, native_read_i64(token, 72))
                let line = native_read_i64(tokenSpan, 8) - 1
                let col = native_read_i64(token, 16) - 1
                g_buildSource = lspSourceForFile(native_read_i64(token, 64))
                let length = native_read_i64(token, 32)
                let kind = sym_get_kind(si)
                var tokenKind = 8
                if kind == 1 do tokenKind = 12 end
                if kind == 3 do tokenKind = 1 end
                if kind == 4 do tokenKind = 7 end
                if resolverId < vec_len_rt(g_ideSymbolNodes) do
                    let resolverKind = native_read_i64(vec_get_rt(g_ideSymbolNodes, resolverId), 0)
                    if resolverKind == 7 do tokenKind = 3 end
                    if resolverKind == 8 do tokenKind = 10 end
                end
                var state = sym_get_state(si)
                g_buildLoan = native_read_i64(fact, 120)
                g_buildLifetimeEnd = native_read_i64(fact, 72)
                if g_buildLoan != 0 do state = state or 131072 end
                let checkerState = native_read_i64(fact, 40)
                if checkerState == 4 do state = 2048 end
                if checkerState == 8 do state = 4096 end
                if checkerState == 16 do state = 8192 end
                if native_read_i64(fact, 64) == 1 do state = state or 65536 or 131072 end
                var occurrenceRole = role
                let originalKind = native_read_i64(fact, 104)
                if originalKind == 36 || originalKind == 62 do occurrenceRole = 6 end
                if originalKind == 41 & role == 4 do occurrenceRole = 3 end
                lsp_add_occ(resolverId + 1000000, line, col, line, col + length, tokenKind, state, occurrenceRole)
            end
        end
        fi = fi + 1
    end
end.

# Member candidates come from the compiler AST for the receiver's named type.
# Unknown receiver types deliberately keep an empty, incomplete result.
func lspAppendCompilerMembers(buf: int, pos: int, line: int, dotColumn: int) -> int:
    if g_compilerAnalysisAvailable == 0 do out pos end
    var receiverEnd = dotColumn
    let lineStart = lsp_get_line_start(line)
    when receiverEnd > 0 and native_read_u8(g_doc_text, lineStart + receiverEnd - 1) == 32 loop
        receiverEnd = receiverEnd - 1
    end
    var receiverStart = receiverEnd
    when receiverStart > 0 and is_alnum(native_read_u8(g_doc_text, lineStart + receiverStart - 1)) == 1 loop
        receiverStart = receiverStart - 1
    end
    if receiverStart == receiverEnd do out pos end
    let receiver = copy_sub_string(g_doc_text, lineStart + receiverStart, receiverEnd - receiverStart)
    let receiverSymbol = lsp_find_sym_scoped(receiver, lsp_get_scope_for_line(line), line)
    vir_free(receiver)
    if receiverSymbol < 0 do out pos end
    let receiverFact = native_read_i64(g_compilerSymbolFacts, receiverSymbol * 8)
    if receiverFact == 0 do out pos end
    let namedType = native_read_i64(receiverFact, 184)
    if namedType < 0 or namedType >= vec_len_rt(g_ideSymbolNodes) do out pos end
    let typeSymbol = vec_get_rt(g_ideSymbolNodes, namedType)
    let entityNode = native_read_i64(typeSymbol, 32)
    if entityNode == 0 do out pos end
    let children = native_read_i64(entityNode, 64)
    var ci = 0
    var count = 0
    var resultPos = pos
    when ci < vec_len_rt(children) and resultPos < 7400 loop
        let child = vec_get_rt(children, ci)
        let nt = native_read_i64(child, 16)
        let name = native_read_i64(child, 0)
        if (nt == 33 or nt == 2 or nt == 30) and name != 0 do
            let nameLength = native_read_i64(name, 8)
            if nameLength > 0 and nameLength < 256 do
                if count > 0 do native_write_u8(buf, resultPos, 44); resultPos = resultPos + 1 end
                let prefix = "{\"label\":\""
                rt_memcpy(buf + resultPos, prefix as int, rt_strlen(prefix as i64))
                resultPos = resultPos + rt_strlen(prefix as i64)
                rt_memcpy(buf + resultPos, native_read_i64(name, 0), nameLength)
                resultPos = resultPos + nameLength
                var suffix = "\",\"kind\":5,\"detail\":\"Compiler entity field\"}"
                if nt == 30 do suffix = "\",\"kind\":20,\"detail\":\"Compiler enum variant\"}" end
                if nt == 2 do suffix = "\",\"kind\":2,\"detail\":\"Compiler entity method\"}" end
                rt_memcpy(buf + resultPos, suffix as int, rt_strlen(suffix as i64))
                resultPos = resultPos + rt_strlen(suffix as i64)
                count = count + 1
            end
        end
        ci = ci + 1
    end
    out resultPos
end.

func lspCompilerScopeAt(line: int) -> int:
    var scope = 0
    var smallest = 2147483647
    var index = 0
    when index < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, index)
        let innerScope = native_read_i64(fact, 136) - 1
        let startLine = native_read_i64(fact, 88)
        let endLine = native_read_i64(fact, 144)
        if innerScope >= 0 and endLine >= startLine do
            let source = lspSourceForFile(sm_file_from_line(g_active_source_manager, startLine))
            if rt_streq(lspSourceUri(source), g_doc_uri) == 1 do
                let first = sm_line_from_expanded(g_active_source_manager, startLine) - 1
                let last = sm_line_from_expanded(g_active_source_manager, endLine) - 1
                if line >= first and line <= last do
                    if last - first < smallest do
                        smallest = last - first
                        scope = innerScope
                    end
                end
            end
        end
        index = index + 1
    end
    out scope
end.

func lspCompilerFindVisible(name: int, line: int) -> int:
    var scope = lspCompilerScopeAt(line)
    var remaining = vec_len_rt(g_ideScopeParents)
    when scope >= 0 and scope < vec_len_rt(g_ideScopeParents) and remaining > 0 loop
        var index = 0
        when index < g_sym_count loop
            if native_read_i64(g_compilerSymbolScopes, index * 8) == scope do
                if rt_streq(name, sym_get_name(index)) == 1 do
                    let source = native_read_i64(g_sym_table, index * 88 + 80)
                    if rt_streq(lspSourceUri(source), g_doc_uri) == 0 or sym_get_line(index) <= line do out index end
                end
            end
            index = index + 1
        end
        scope = vec_get_rt(g_ideScopeParents, scope)
        remaining = remaining - 1
    end
    out -1
end.

func lspCompilerAncestor(ancestor: int, child: int) -> int:
    var current = child
    var remaining = vec_len_rt(g_ideScopeParents)
    when current >= 0 and current < vec_len_rt(g_ideScopeParents) and remaining > 0 loop
        if current == ancestor do out 1 end
        current = vec_get_rt(g_ideScopeParents, current)
        remaining = remaining - 1
    end
    out 0
end.

func lspJsonEscape(input: int) -> int:
    let length = rt_strlen(input)
    let result = vir_alloc(length * 6 + 1)
    var i = 0
    var pos = 0
    when i < length loop
        let ch = native_read_u8(input, i)
        if ch == 34 or ch == 92 do
            native_write_u8(result, pos, 92); pos = pos + 1
            native_write_u8(result, pos, ch); pos = pos + 1
        eif ch < 32 do
            let prefix = "\\u00"
            rt_memcpy(result + pos, prefix as int, 4); pos = pos + 4
            let hex = "0123456789abcdef"
            native_write_u8(result, pos, native_read_u8(hex as int, ch / 16)); pos = pos + 1
            native_write_u8(result, pos, native_read_u8(hex as int, ch mod 16)); pos = pos + 1
        else
            native_write_u8(result, pos, ch); pos = pos + 1
        end
        i = i + 1
    end
    native_write_u8(result, pos, 0)
    out result
end.

func lspApplyCompilerDiagnostics():
    if g_ideParseLine > 0 do
        let line = g_ideParseLine - 1
        var col = g_ideParseColumn - 1
        if col < 0 do col = 0 end
        g_diagSource = lspSourceForFile(g_ideParseFileId)
        let message = pass10_code_to_msg(g_ideParseCode, g_ideParseMessage as string)
        lsp_add_diag(line, col, line, col + 1, 1, lspDiagnosticCode(0, g_ideParseCode), message as int)
    end
    var i = 0
    when i < vec_len_rt(g_ideSessionDiagnostics) loop
        let d = vec_get_rt(g_ideSessionDiagnostics, i)
        g_diagRecord = d
        let code = native_read_i64(d, 8)
        let fileId = native_read_i64(d, 64)
        let path = native_read_i64(d, 80)
        var source = g_rootSource
        if path != 0 do source = lspSourceForPath(path)
        eif g_active_source_manager != 0 do source = lspSourceForFile(fileId) end
        g_diagSource = source
        var line = native_read_i64(d, 16) - 1
        var endLine = line
        var col = native_read_i64(d, 24) - 1
        var endColumn = col + 1
        let spanId = native_read_i64(d, 72)
        if g_active_source_manager != 0 do
            if spanId > 0 do
                let span = sm_get_span(g_active_source_manager, spanId)
                if span != 0 do
                    line = native_read_i64(span, 8) - 1
                    col = native_read_i64(span, 16) - 1
                    endLine = native_read_i64(span, 24) - 1
                    endColumn = native_read_i64(span, 32) - 1
                end
            end
        end
        if col < 0 do col = 0 end
        if line >= 0 do
            let codeName = lspDiagnosticCode(native_read_i64(d, 0), code)
            let message = pass10_code_to_msg(code, native_read_i64(d, 32) as string)
            lsp_add_diag(line, col, endLine, endColumn, lspDiagnosticSeverity(native_read_i64(d, 0)), codeName, message as int)
        end
        i = i + 1
    end
end.
func lspCompilerExpressionHover(id: int, line: int, byteColumn: int) -> int:
    if g_compilerAnalysisAvailable == 0 do out 0 end
    var selected = 0
    var selectedLength = 9223372036854775807
    var index = 0
    when index < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, index)
        if native_read_i64(fact, 32) > 0 do
            let span = sm_get_span(g_active_source_manager, native_read_i64(fact, 80))
            if span != 0 do
                if rt_streq(lspSourceUri(lspSourceForFile(native_read_i64(span, 0))), g_doc_uri) == 1 do
                    let firstLine = native_read_i64(span, 8) - 1
                    let firstColumn = native_read_i64(span, 16) - 1
                    let lastLine = native_read_i64(span, 24) - 1
                    let lastColumn = native_read_i64(span, 32) - 1
                    var afterStart = 0
                    var beforeEnd = 0
                    if line > firstLine do afterStart = 1 end
                    if line == firstLine and byteColumn >= firstColumn do afterStart = 1 end
                    if line < lastLine do beforeEnd = 1 end
                    if line == lastLine and byteColumn < lastColumn do beforeEnd = 1 end
                    if afterStart == 1 and beforeEnd == 1 do
                        let length = native_read_i64(span, 48) - native_read_i64(span, 40)
                        if length < selectedLength do
                            selected = fact
                            selectedLength = length
                        end
                    end
                end
            end
        end
        index = index + 1
    end
    if selected == 0 do out 0 end
    var typeName = lspCompilerTypeName(native_read_i64(selected, 32))
    let namedType = native_read_i64(selected, 184)
    if namedType >= 0 and namedType < vec_len_rt(g_ideSymbolNodes) do
        let typeSymbol = vec_get_rt(g_ideSymbolNodes, namedType)
        typeName = native_read_i64(native_read_i64(typeSymbol, 8), 0)
    end
    let escapedType = lspJsonEscape(typeName)
    let buffer = vir_alloc(256 + rt_strlen(escapedType))
    var position = lspAppendRaw(buffer, 0, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"Compiler expression type: `" as int)
    position = lspAppendRaw(buffer, position, escapedType)
    position = lspAppendRaw(buffer, position, "`\"}}" as int)
    native_write_u8(buffer, position, 0)
    lsp_send_response(id, buffer as string)
    vir_free(buffer)
    vir_free(escapedType)
    out 1
end.

# Facts retain parser origins and resolved type/checker values in the worker.
func lspAppendFactRange(buffer: int, position: int, span: int) -> int:
    let source = lspSourceForFile(native_read_i64(span, 0))
    let firstLine = native_read_i64(span, 8) - 1
    let lastLine = native_read_i64(span, 24) - 1
    var next = lspAppendRaw(buffer, position, "{\"start\":{\"line\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(firstLine))
    next = lspAppendRaw(buffer, next, ",\"character\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(lspSourceUtf16(source, firstLine, native_read_i64(span, 16) - 1)))
    next = lspAppendRaw(buffer, next, "},\"end\":{\"line\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(lastLine))
    next = lspAppendRaw(buffer, next, ",\"character\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(lspSourceUtf16(source, lastLine, native_read_i64(span, 32) - 1)))
    out lspAppendRaw(buffer, next, "}}" as int)
end.

func lspAppendCheckerOrigin(buffer: int, position: int, expandedLine: int) -> int:
    if expandedLine <= 0 do out lspAppendRaw(buffer, position, "null" as int) end
    let source = lspSourceForFile(sm_file_from_line(g_active_source_manager, expandedLine))
    var next = lspAppendRaw(buffer, position, "{\"uri\":\"" as int)
    next = lspAppendRaw(buffer, next, lspJsonEscape(lspSourceUri(source)))
    next = lspAppendRaw(buffer, next, "\",\"line\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(sm_line_from_expanded(g_active_source_manager, expandedLine) - 1))
    out lspAppendRaw(buffer, next, "}" as int)
end.

func lspAppendDetailedFacts(buffer: int, position: int) -> int:
    var next = lspAppendRaw(buffer, position, "],\"expressions\":[" as int)
    var index = 0
    var count = 0
    if g_compilerAnalysisAvailable == 1 do
        when index < vec_len_rt(g_ideFacts) loop
            let fact = vec_get_rt(g_ideFacts, index)
            let typeKind = native_read_i64(fact, 32)
            let span = sm_get_span(g_active_source_manager, native_read_i64(fact, 80))
            if typeKind > 0 & span != 0 do
                if count > 0 do next = lspAppendRaw(buffer, next, "," as int) end
                next = lspAppendRaw(buffer, next, "{\"expressionId\":\"" as int)
                next = lspAppendRaw(buffer, next, rt_itoa(index))
                next = lspAppendRaw(buffer, next, "\",\"uri\":\"" as int)
                next = lspAppendRaw(buffer, next, lspJsonEscape(lspSourceUri(lspSourceForFile(native_read_i64(span, 0)))))
                next = lspAppendRaw(buffer, next, "\",\"range\":" as int)
                next = lspAppendFactRange(buffer, next, span)
                next = lspAppendRaw(buffer, next, ",\"typeId\":\"" as int)
                next = lspAppendFactTypeId(buffer, next, fact)
                next = lspAppendRaw(buffer, next, "\",\"displayType\":\"" as int)
                let resolvedType = native_read_i64(fact, 184)
                if resolvedType >= 0 do
                    let entry = vec_get_rt(g_ideSymbolNodes, resolvedType)
                    next = lspAppendRaw(buffer, next, native_read_i64(native_read_i64(entry, 8), 0))
                else
                    next = lspAppendRaw(buffer, next, lspCompilerTypeName(typeKind))
                end
                next = lspAppendRaw(buffer, next, "\"}" as int)
                count = count + 1
            end
            index = index + 1
        end
    end
    next = lspAppendRaw(buffer, next, "],\"checkerFacts\":[" as int)
    index = 0
    count = 0
    if g_compilerAnalysisAvailable == 1 do
        when index < vec_len_rt(g_ideFacts) loop
            let fact = vec_get_rt(g_ideFacts, index)
            let binding = native_read_i64(fact, 48)
            let resolverId = native_read_i64(fact, 8)
            let span = sm_get_span(g_active_source_manager, native_read_i64(fact, 80))
            if binding != 0 & resolverId >= 0 & span != 0 do
                if count > 0 do next = lspAppendRaw(buffer, next, "," as int) end
                next = lspAppendRaw(buffer, next, "{\"symbolId\":\"" as int)
                next = lspAppendRaw(buffer, next, rt_itoa(resolverId + 1000000))
                next = lspAppendRaw(buffer, next, "\",\"bindingId\":\"" as int)
                next = lspAppendRaw(buffer, next, lspJsonEscape(native_read_i64(binding, 0)))
                next = lspAppendRaw(buffer, next, "\",\"uri\":\"" as int)
                next = lspAppendRaw(buffer, next, lspJsonEscape(lspSourceUri(lspSourceForFile(native_read_i64(span, 0)))))
                next = lspAppendRaw(buffer, next, "\",\"range\":" as int)
                next = lspAppendFactRange(buffer, next, span)
                var lastUseMode = "unavailable"
                if native_read_i64(fact, 64) == 1 do lastUseMode = "proven" end
                if native_read_i64(fact, 64) == 2 do lastUseMode = "conservative" end
                next = lspAppendRaw(buffer, next, ",\"lastUseMode\":\"" as int)
                next = lspAppendRaw(buffer, next, lastUseMode as int)
                next = lspAppendRaw(buffer, next, "\"" as int)
                next = lspAppendRaw(buffer, next, ",\"stateBefore\":" as int)
                next = lspAppendRaw(buffer, next, rt_itoa(native_read_i64(fact, 152)))
                next = lspAppendRaw(buffer, next, ",\"stateAfter\":" as int)
                next = lspAppendRaw(buffer, next, rt_itoa(native_read_i64(fact, 40)))
                next = lspAppendRaw(buffer, next, ",\"moveOrigin\":" as int)
                next = lspAppendCheckerOrigin(buffer, next, native_read_i64(fact, 160))
                next = lspAppendRaw(buffer, next, ",\"borrowOrigin\":" as int)
                next = lspAppendCheckerOrigin(buffer, next, native_read_i64(fact, 168))
                let owner = native_read_i64(fact, 176)
                next = lspAppendRaw(buffer, next, ",\"ownerBindingId\":" as int)
                if owner == 0 do next = lspAppendRaw(buffer, next, "null" as int)
                else
                    next = lspAppendRaw(buffer, next, "\"" as int)
                    next = lspAppendRaw(buffer, next, lspJsonEscape(native_read_i64(owner, 0)))
                    next = lspAppendRaw(buffer, next, "\"" as int)
                end
                next = lspAppendRaw(buffer, next, "}" as int)
                count = count + 1
            end
            index = index + 1
        end
    end
    out next
end.

# Completeness applies only to this analyzed CU. It never promises a workspace
# index or references to annotation/import constructs the resolver did not emit.
func lspCompilerSnapshotComplete() -> int:
    if g_compilerAnalysisAvailable == 0 do out 0 end
    if g_ideSessionErrors > 0 do out 0 end
    if g_ideHasImports > 0 do
        if lspCompilerImportsComplete() == 0 do out 0 end
    end
    if lspCompilerUnsupportedGraph(g_ideSessionAst) == 1 do out 0 end
    var index = 0
    when index < g_sym_count loop
        if native_read_i64(g_compilerSymbolCoverage, index * 8) == 0 do out 0 end
        index = index + 1
    end
    index = 0
    when index < vec_len_rt(g_ideFacts) loop
        let fact = vec_get_rt(g_ideFacts, index)
        let kind = native_read_i64(fact, 104)
        let boundary = native_read_i64(fact, 72)
        if boundary != 0 do
            let boundaryFact = ideFactFind(boundary)
            if boundaryFact == 0 do out 0 end
            if sm_get_span(g_active_source_manager, native_read_i64(boundaryFact, 80)) == 0 do out 0 end
        end
        if kind == 41 || kind == 62 do
            if native_read_i64(fact, 8) < 0 do out 0 end
        end
        index = index + 1
    end
    out 1
end.

func lspAppendFactTypeId(buffer: int, position: int, fact: int) -> int:
    let typeSymbol = native_read_i64(fact, 184)
    if typeSymbol >= 0 do
        let next = lspAppendRaw(buffer, position, "symbol:" as int)
        out lspAppendRaw(buffer, next, rt_itoa(typeSymbol + 1000000))
    end
    let next = lspAppendRaw(buffer, position, "kind:" as int)
    out lspAppendRaw(buffer, next, rt_itoa(native_read_i64(fact, 32)))
end.

# Project compiler resolver records onto their original lexer tokens.
func lspApplyCompilerModules():
    g_mod_count = 0
    var moduleIndex = 0
    when moduleIndex < vec_len_rt(g_ideResolvedModules) loop
        let entry = vec_get_rt(g_ideResolvedModules, moduleIndex)
        let parent = native_read_i64(entry, 24)
        let rootPath = native_read_i64(native_read_i64(g_rootSource, 8), 0)
        if parent != 0 do
            if rt_streq(parent, rootPath) == 1 do
                let name = native_read_i64(entry, 0)
                let line = native_read_i64(entry, 32)
                var tokenIndex = 0
                when tokenIndex < vec_len_rt(g_rootTokens) loop
                    let token = vec_get_rt(g_rootTokens, tokenIndex)
                    if native_read_i64(token, 8) == line do
                        let start = native_read_i64(token, 24)
                        let length = native_read_i64(name, 8)
                        if start + length <= g_doc_text_len do
                            let spelling = copy_sub_string(g_doc_text, start, length)
                            let matches = fat_cstr_eq(name, spelling)
                            vir_free(spelling)
                            if matches == 1 do
                                let column = start - lsp_get_line_start(line - 1)
                                var canonical = native_read_i64(entry, 8)
                                if canonical == 0 do canonical = native_read_i64(name, 0) end
                                lsp_add_module(canonical, line - 1, column, column + length, native_read_i64(entry, 40))
                                break
                            end
                        end
                    end
                    tokenIndex = tokenIndex + 1
                end
            end
        end
        moduleIndex = moduleIndex + 1
    end
end.

func lspDiagnosticSeverity(level: int) -> int:
    if level == 0 do out 1 end
    if level == 1 do out 2 end
    out 3
end.

func lspDiagnosticCode(level: int, code: int) -> int:
    let number = rt_itoa(code)
    let result = vir_alloc(rt_strlen(number) + 6)
    var position = 1
    var prefix = 69
    if level == 1 do prefix = 87 end
    if level == 2 do prefix = 73 end
    native_write_u8(result, 0, prefix)
    if code < 1000 do native_write_u8(result, position, 48); position = position + 1 end
    if code < 100 do native_write_u8(result, position, 48); position = position + 1 end
    if code < 10 do native_write_u8(result, position, 48); position = position + 1 end
    rt_memcpy(result + position, number, rt_strlen(number) + 1)
    out result
end.

func lspAppendRelatedDiagnostic(buffer: int, position: int, diagnosticRecord: int) -> int:
    if diagnosticRecord == 0 do out position end
    let line = native_read_i64(diagnosticRecord, 40) - 1
    if line < 0 do out position end
    var column = native_read_i64(diagnosticRecord, 48) - 1
    if column < 0 do column = 0 end
    let source = lspSourceForPath(native_read_i64(diagnosticRecord, 96))
    let utf16Column = lspSourceUtf16(source, line, column)
    var next = lspAppendRaw(buffer, position, ",\"relatedInformation\":[{\"location\":{\"uri\":\"" as int)
    next = lspAppendRaw(buffer, next, lspJsonEscape(lspSourceUri(source)))
    next = lspAppendRaw(buffer, next, "\",\"range\":{\"start\":{\"line\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(line))
    next = lspAppendRaw(buffer, next, ",\"character\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(utf16Column))
    next = lspAppendRaw(buffer, next, "},\"end\":{\"line\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(line))
    next = lspAppendRaw(buffer, next, ",\"character\":" as int)
    next = lspAppendRaw(buffer, next, rt_itoa(lspSourceUtf16(source, line, column + 1)))
    next = lspAppendRaw(buffer, next, "}}},\"message\":\"" as int)
    let note = native_read_i64(diagnosticRecord, 56)
    if note != 0 && rt_strlen(note) > 0 do
        next = lspAppendRaw(buffer, next, lspJsonEscape(note))
    else
        next = lspAppendRaw(buffer, next, "related location" as int)
    end
    out lspAppendRaw(buffer, next, "\"}]" as int)
end.

func lspCompilerUnsupportedGraph(node: int) -> int:
    if node == 0 do out 0 end
    let children = native_read_i64(node, 64)
    var index = 0
    when index < vec_len_rt(children) loop
        if lspCompilerUnsupportedGraph(vec_get_rt(children, index)) == 1 do out 1 end
        index = index + 1
    end
    out 0
end.
