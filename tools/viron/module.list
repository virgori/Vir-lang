# Mandatory module registry for Viron standalone tool
root = src
viron.main = main.vri
viron.cli = cli/cli.vri
viron.diagnostic = diagnostic/diagnostic.vri
viron.project = project/project.vri
viron.manifest = manifest/manifest.vri
viron.lock = lock/lock.vri
viron.resolve = resolve/resolve.vri
viron.module_map = module_map/module_map.vri
viron.toolchain = toolchain/toolchain.vri
viron.cache = cache/cache.vri
viron.registry = registry/registry.vri
viron.package = package/package.vri
viron.stdlib_lifecycle = stdlib_lifecycle/stdlib_lifecycle.vri
viron.security = security/security.vri
viron.process = process/process.vri
