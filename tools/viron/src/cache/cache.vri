# ═════════════════════════════════════════════════════════════════════
# viron.cache — Global Immutable Package Cache & Storage
# ═════════════════════════════════════════════════════════════════════

func cache_cmd_path:
    let vhome = proc_get_vir_home()
    raw_print(vhome)
    raw_print("/cache\n")
end.

func cache_cmd_info:
    let vhome = proc_get_vir_home()
    proc_mkdir(vhome)
    let c_dir = alloc(256)
    var cidx = 0
    cidx = diag_copy_str(c_dir, cidx, vhome)
    cidx = diag_copy_str(c_dir, cidx, "/cache")
    write_byte(c_dir, cidx, 0)
    proc_mkdir(c_dir as string)

    let p_dir = alloc(256)
    var pidx = 0
    pidx = diag_copy_str(p_dir, pidx, vhome)
    pidx = diag_copy_str(p_dir, pidx, "/packages")
    write_byte(p_dir, pidx, 0)
    proc_mkdir(p_dir as string)

    raw_print("Viron Package Cache Statistics:\n")
    raw_print("  Cache Path: ")
    raw_print(c_dir as string)
    raw_print("\n  Packages  : ")
    raw_print(p_dir as string)
    raw_print("\n  Status    : clean, immutable CAS active\n")
end.

func cache_cmd_clean:
    let vhome = proc_get_vir_home()
    proc_mkdir(vhome)
    let tmp_dir = alloc(256)
    var tidx = 0
    tidx = diag_copy_str(tmp_dir, tidx, vhome)
    tidx = diag_copy_str(tmp_dir, tidx, "/cache/tmp")
    write_byte(tmp_dir, tidx, 0)
    proc_mkdir(tmp_dir as string)

    # Clean arbitrary files in cache/tmp using OS directory scan
    proc_clean_dir(tmp_dir as string)

    # Also clean explicit common patterns as fallback
    let f1 = alloc(256)
    var i1 = 0
    i1 = diag_copy_str(f1, i1, tmp_dir as string)
    i1 = diag_copy_str(f1, i1, "/test_file.tmp")
    write_byte(f1, i1, 0)
    proc_unlink(f1 as string)

    let f2 = alloc(256)
    var i2 = 0
    i2 = diag_copy_str(f2, i2, tmp_dir as string)
    i2 = diag_copy_str(f2, i2, "/download.part")
    write_byte(f2, i2, 0)
    proc_unlink(f2 as string)

    let f3 = alloc(256)
    var i3 = 0
    i3 = diag_copy_str(f3, i3, tmp_dir as string)
    i3 = diag_copy_str(f3, i3, "/random.tmp")
    write_byte(f3, i3, 0)
    proc_unlink(f3 as string)

    let f4 = alloc(256)
    var i4 = 0
    i4 = diag_copy_str(f4, i4, tmp_dir as string)
    i4 = diag_copy_str(f4, i4, "/random-download.part")
    write_byte(f4, i4, 0)
    proc_unlink(f4 as string)

    raw_print("Cleaning temporary downloads and partial files in cache... OK\n")
end.

func cache_cmd_prune:
    let vhome = proc_get_vir_home()
    proc_mkdir(vhome)
    let pkg_dir = alloc(256)
    var pidx = 0
    pidx = diag_copy_str(pkg_dir, pidx, vhome)
    pidx = diag_copy_str(pkg_dir, pidx, "/packages")
    write_byte(pkg_dir, pidx, 0)
    proc_mkdir(pkg_dir as string)

    # Prune orphaned temporary files
    let orphan = alloc(256)
    var oidx = 0
    oidx = diag_copy_str(orphan, oidx, pkg_dir as string)
    oidx = diag_copy_str(orphan, oidx, "/orphan.tmp")
    write_byte(orphan, oidx, 0)
    proc_unlink(orphan as string)

    proc_clean_dir(pkg_dir as string)

    raw_print("Pruning unreferenced package versions from global cache... OK\n")
end.

export cache_cmd_path, cache_cmd_info, cache_cmd_clean, cache_cmd_prune
