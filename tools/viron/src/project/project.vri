# ═════════════════════════════════════════════════════════════════════
# viron.project — Project Lifecycle, Scaffolding & Discovery
# ═════════════════════════════════════════════════════════════════════

func proj_strlen(s: string) -> int:
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func proj_copy_str:
    in  dst: int
        dst_idx: int
        src: string
    let sl = proj_strlen(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src as int, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func project_generate_module_list:
    in  pkg_name: string
        is_lib: int
    let buf = alloc(512)
    var idx = 0

    idx = proj_copy_str(buf, idx, "# Mandatory project module registry\nroot = src\n\n")
    idx = proj_copy_str(buf, idx, pkg_name)
    if is_lib == 1 do
        idx = proj_copy_str(buf, idx, " = lib.vri\n")
    else
        idx = proj_copy_str(buf, idx, " = main.vri\n")
    end
    write_byte(buf, idx, 0)
    out buf as string
end.

func project_generate_src:
    in  pkg_name: string
        is_lib: int
    let buf = alloc(512)
    var idx = 0

    if is_lib == 1 do
        idx = proj_copy_str(buf, idx, "# Library: ")
        idx = proj_copy_str(buf, idx, pkg_name)
        idx = proj_copy_str(buf, idx, "\n\nfunc greet(name: string) -> string:\n    out name\nend.\n\nexport greet\n")
    else
        idx = proj_copy_str(buf, idx, "func main():\n    print_str(\"Hello from Vir standalone application!\\n\")\n    exit_prog(0)\nend.\n")
    end
    write_byte(buf, idx, 0)
    out buf as string
end.

func project_generate_test:
    in  pkg_name: string
    let buf = alloc(512)
    var idx = 0
    idx = proj_copy_str(buf, idx, "func main():\n    print_str(\"  PASS: tests/test_basic.vri (1/1)\\n\")\n    print_str(\"All tests passed successfully (100%).\\n\")\n    exit_prog(0)\nend.\n")
    write_byte(buf, idx, 0)
    out buf as string
end.

export project_generate_module_list, project_generate_src, project_generate_test
