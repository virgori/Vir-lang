# ═════════════════════════════════════════════════════════════════════
# viron.security — Path Traversal Defense, Checksum & Lock Concurrency
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func vir_get_platform() -> int

func sec_strlen(s: string) -> int:
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func sec_is_safe_rel_path(path: string) -> int:
    let len = sec_strlen(path)
    if len == 0 do out 0 end

    # Reject absolute Unix path
    if read_byte(path as int, 0) == 47 do out 0 end
    # Reject absolute Windows path or backslash prefix
    if read_byte(path as int, 0) == 92 do out 0 end
    if len >= 3 and read_byte(path as int, 1) == 58 do out 0 end

    # Check for "../" or "..\" traversal sequences
    var i = 0
    when i < len loop
        let b0 = read_byte(path as int, i)
        if b0 == 46 and (i + 1) < len and read_byte(path as int, i + 1) == 46 do
            if (i + 2) == len do out 0 end
            if (i + 2) < len do
                let b2 = read_byte(path as int, i + 2)
                if b2 == 47 or b2 == 92 do out 0 end
            end
        end
        i = i + 1
    end
    out 1
end.

func sec_verify_checksum(actual: string, expected: string) -> int:
    let la = sec_strlen(actual)
    let lb = sec_strlen(expected)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(actual as int, i) != read_byte(expected as int, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func sec_acquire_lock(pkg_name: string, version: string) -> int:
    let vhome = proc_get_vir_home()
    let lock_dir = alloc(256)
    var lidx = 0
    lidx = diag_copy_str(lock_dir, lidx, vhome)
    lidx = diag_copy_str(lock_dir, lidx, "/locks")
    write_byte(lock_dir, lidx, 0)
    proc_mkdir(vhome)
    proc_mkdir(lock_dir as string)

    let lock_file = alloc(256)
    var fidx = 0
    fidx = diag_copy_str(lock_file, fidx, lock_dir as string)
    fidx = diag_copy_str(lock_file, fidx, "/")
    fidx = diag_copy_str(lock_file, fidx, pkg_name)
    fidx = diag_copy_str(lock_file, fidx, ".lock")
    write_byte(lock_file, fidx, 0)

    let plat = vir_get_platform()
    var fd = -1
    # O_CREAT | O_EXCL | O_RDWR
    if plat == 0 or plat == 1 do
        # Darwin: O_CREAT=0x0200, O_EXCL=0x0800, O_RDWR=2 -> 0x0A02
        fd = syscall3(0x2000005, lock_file as int, 0x0A02, 420)
    eif plat == 2 or plat == 4 do
        # Linux ARM64: openat(-100, lock_file, 194, 420)
        fd = syscall4(56, -100, lock_file as int, 194, 420)
    eif plat == 3 do
        # Linux x86_64: open(lock_file, 194, 420)
        fd = syscall3(2, lock_file as int, 194, 420)
    end

    if fd >= 0 do
        let pid = proc_sys_getpid()
        let pbuf = alloc(32)
        var pi = 0
        var pval = pid
        if pval <= 0 do pval = 1 end
        when pval > 0 loop
            write_byte(pbuf, pi, 48 + (pval mod 10))
            pval = pval / 10
            pi = pi + 1
        end
        write_byte(pbuf, pi, 10)
        pi = pi + 1
        write_byte(pbuf, pi, 0)

        if plat == 0 or plat == 1 do
            syscall3(0x2000004, fd, pbuf as int, pi)
            syscall1(0x2000006, fd)
        eif plat == 2 or plat == 4 do
            syscall3(64, fd, pbuf as int, pi)
            syscall1(57, fd)
        eif plat == 3 do
            syscall3(1, fd, pbuf as int, pi)
            syscall1(3, fd)
        end
        out 1
    end
    out 0
end.

func sec_release_lock(pkg_name: string, version: string) -> int:
    let vhome = proc_get_vir_home()
    let lock_file = alloc(256)
    var fidx = 0
    fidx = diag_copy_str(lock_file, fidx, vhome)
    fidx = diag_copy_str(lock_file, fidx, "/locks/")
    fidx = diag_copy_str(lock_file, fidx, pkg_name)
    fidx = diag_copy_str(lock_file, fidx, ".lock")
    write_byte(lock_file, fidx, 0)
    let res = proc_unlink(lock_file as string)
    if res == 0 do out 1 end
    out 0
end.

export sec_is_safe_rel_path, sec_verify_checksum, sec_acquire_lock, sec_release_lock
