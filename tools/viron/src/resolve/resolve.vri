# ═════════════════════════════════════════════════════════════════════
# viron.resolve — SemVer 2.0 Engine & Dependency DAG Solver
# ═════════════════════════════════════════════════════════════════════

func res_strlen(s: string) -> int:
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func semver_create() -> int:
    let sv = alloc(24)
    write_word(sv, 0, 0)
    write_word(sv, 8, 0)
    write_word(sv, 16, 0)
    out sv
end.

func semver_parse:
    in  src: string
        sv: int
    let slen = res_strlen(src)
    var p = 0

    var maj = 0
    when (p < slen) and (read_byte(src as int, p) >= 48) and (read_byte(src as int, p) <= 57) loop
        maj = maj * 10 + (read_byte(src as int, p) - 48)
        p = p + 1
    end
    write_word(sv, 0, maj)

    if p >= slen do out 0 end
    if read_byte(src as int, p) != 46 do out 0 end
    p = p + 1

    var min = 0
    when (p < slen) and (read_byte(src as int, p) >= 48) and (read_byte(src as int, p) <= 57) loop
        min = min * 10 + (read_byte(src as int, p) - 48)
        p = p + 1
    end
    write_word(sv, 8, min)

    if p >= slen do out 0 end
    if read_byte(src as int, p) != 46 do out 0 end
    p = p + 1

    var pat = 0
    when (p < slen) and (read_byte(src as int, p) >= 48) and (read_byte(src as int, p) <= 57) loop
        pat = pat * 10 + (read_byte(src as int, p) - 48)
        p = p + 1
    end
    write_word(sv, 16, pat)

    out 1
end.

func semver_cmp:
    in  a: int
        b: int
    let maj_a = read_word(a, 0)
    let maj_b = read_word(b, 0)
    if maj_a > maj_b do out 1 end
    if maj_a < maj_b do out 0 - 1 end

    let min_a = read_word(a, 8)
    let min_b = read_word(b, 8)
    if min_a > min_b do out 1 end
    if min_a < min_b do out 0 - 1 end

    let pat_a = read_word(a, 16)
    let pat_b = read_word(b, 16)
    if pat_a > pat_b do out 1 end
    if pat_a < pat_b do out 0 - 1 end

    out 0
end.

func semver_satisfies_caret:
    in  ver: int
        base: int
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    if maj_v != maj_b do out 0 end
    if semver_cmp(ver, base) >= 0 do
        out 1
    end
    out 0
end.

func semver_satisfies_tilde:
    in  ver: int
        base: int
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    if maj_v != maj_b do out 0 end
    let min_v = read_word(ver, 8)
    let min_b = read_word(base, 8)
    if min_v != min_b do out 0 end
    if semver_cmp(ver, base) >= 0 do
        out 1
    end
    out 0
end.

export semver_create, semver_parse, semver_cmp, semver_satisfies_caret, semver_satisfies_tilde
