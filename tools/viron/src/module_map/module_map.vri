# ═════════════════════════════════════════════════════════════════════
# viron.module_map — Module Map (.vir/build/module-map.json) Generator
# ═════════════════════════════════════════════════════════════════════

func mm_strlen(s: string) -> int:
    if s as int == 0 do out 0 end
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func mm_copy_str:
    in  dst: int
        dst_idx: int
        src: string
    let sl = mm_strlen(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src as int, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func module_list_validate(content: string) -> int:
    let ptr = content as int
    let len = mm_strlen(content)
    if len <= 0 do out 0 end

    var p = 0
    var has_root = 0

    when p < len loop
        var le = p
        when le < len and read_byte(ptr, le) != 10 and read_byte(ptr, le) != 13 loop
            le = le + 1
        end

        var cur = p
        when cur < le and (read_byte(ptr, cur) == 32 or read_byte(ptr, cur) == 9) loop
            cur = cur + 1
        end

        if cur < le and read_byte(ptr, cur) != 35 do
            let rem = le - cur
            if rem >= 4 and read_byte(ptr, cur) == 114 and read_byte(ptr, cur + 1) == 111 and read_byte(ptr, cur + 2) == 111 and read_byte(ptr, cur + 3) == 116 do
                var after = cur + 4
                when after < le and (read_byte(ptr, after) == 32 or read_byte(ptr, after) == 9) loop
                    after = after + 1
                end
                if after < le and read_byte(ptr, after) == 61 do
                    has_root = 1
                end
            end
        end

        p = le + 1
    end

    if has_root == 1 do out 1 end
    out 0
end.

func module_map_generate:
    in  toolchain_ver: string
        sysroot_path: string
        pkg_name: string
        entry_path: string
    let buf = alloc(2048)
    var idx = 0

    idx = mm_copy_str(buf, idx, "{\n  \"schemaVersion\": 1,\n  \"toolchain\": {\n    \"version\": \"")
    idx = mm_copy_str(buf, idx, toolchain_ver)
    idx = mm_copy_str(buf, idx, "\",\n    \"sysroot\": \"")
    idx = mm_copy_str(buf, idx, sysroot_path)
    idx = mm_copy_str(buf, idx, "\"\n  },\n  \"packages\": {\n    \"")
    idx = mm_copy_str(buf, idx, pkg_name)
    idx = mm_copy_str(buf, idx, "\": {\n      \"root\": \".\",\n      \"entry\": \"")
    idx = mm_copy_str(buf, idx, entry_path)
    idx = mm_copy_str(buf, idx, "\"\n    }\n  },\n  \"modules\": {\n    \"")
    idx = mm_copy_str(buf, idx, pkg_name)
    idx = mm_copy_str(buf, idx, "\": {\n      \"package\": \"")
    idx = mm_copy_str(buf, idx, pkg_name)
    idx = mm_copy_str(buf, idx, "\",\n      \"entry\": \"")
    idx = mm_copy_str(buf, idx, entry_path)
    idx = mm_copy_str(buf, idx, "\"\n    }\n  }\n}\n")
    write_byte(buf, idx, 0)
    out buf as string
end.

export module_map_generate, module_list_validate
