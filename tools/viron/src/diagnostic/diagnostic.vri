# ═════════════════════════════════════════════════════════════════════
# viron.diagnostic — Structured Diagnostic & Error Reporting Engine
# ═════════════════════════════════════════════════════════════════════

extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func vir_get_platform() -> int

func diag_strlen(s: string) -> int:
    if s as int == 0 do out 0 end
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func raw_print(s: string):
    if s as int == 0 do out end
    let len = diag_strlen(s)
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        syscall3(64, 1, s as int, len)
    eif plat == 3 do
        syscall3(1, 1, s as int, len)
    else
        syscall3(0x2000004, 1, s as int, len)
    end
end.

func diag_code_str(code: int) -> string:
    if code == 4001 do out "VIR4001" end
    if code == 4002 do out "VIR4002" end
    if code == 4003 do out "VIR4003" end
    if code == 4101 do out "VIR4101" end
    if code == 4201 do out "VIR4201" end
    if code == 4202 do out "VIR4202" end
    if code == 4203 do out "VIR4203" end
    if code == 4204 do out "VIR4204" end
    if code == 4301 do out "VIR4301" end
    if code == 4302 do out "VIR4302" end
    if code == 4401 do out "VIR4401" end
    if code == 4501 do out "VIR4501" end
    out "VIR4000"
end.

func diag_copy_str:
    in  dst: int
        dst_idx: int
        src: string
    if src as int == 0 do out dst_idx end
    var i = 0
    when read_byte(src as int, i) != 0 loop
        write_byte(dst, dst_idx, read_byte(src as int, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func diag_error(code: int, msg: string):
    let buf = alloc(512)
    var idx = 0
    let c = diag_code_str(code)
    idx = diag_copy_str(buf, idx, "error[")
    idx = diag_copy_str(buf, idx, c)
    idx = diag_copy_str(buf, idx, "]: ")
    idx = diag_copy_str(buf, idx, msg)
    idx = diag_copy_str(buf, idx, "\n")
    write_byte(buf, idx, 0)
    raw_print(buf as string)
end.

func diag_error_with_help:
    in  code: int
        msg: string
        help_text: string
    let buf = alloc(512)
    var idx = 0
    let c = diag_code_str(code)
    idx = diag_copy_str(buf, idx, "error[")
    idx = diag_copy_str(buf, idx, c)
    idx = diag_copy_str(buf, idx, "]: ")
    idx = diag_copy_str(buf, idx, msg)
    idx = diag_copy_str(buf, idx, "\n  help: ")
    idx = diag_copy_str(buf, idx, help_text)
    idx = diag_copy_str(buf, idx, "\n")
    write_byte(buf, idx, 0)
    raw_print(buf as string)
end.

func diag_json(code: int, msg: string):
    let buf = alloc(1024)
    var idx = 0
    let c = diag_code_str(code)
    idx = diag_copy_str(buf, idx, "{\"schemaVersion\":1,\"error\":{\"code\":\"")
    idx = diag_copy_str(buf, idx, c)
    idx = diag_copy_str(buf, idx, "\",\"message\":\"")
    idx = diag_copy_str(buf, idx, msg)
    idx = diag_copy_str(buf, idx, "\"}}\n")
    write_byte(buf, idx, 0)
    raw_print(buf as string)
end.

export diag_code_str, diag_copy_str, diag_error, diag_error_with_help, diag_json, raw_print, diag_strlen
