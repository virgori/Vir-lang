# ═════════════════════════════════════════════════════════════════════
# viron.cli — CLI Dispatcher, Help & Banner
# ═════════════════════════════════════════════════════════════════════

func cli_strlen(s: string) -> int:
    if s as int == 0 do out 0 end
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cli_streq(a: string, b: string) -> int:
    let pa = a as int
    let pb = b as int
    if pa == 0 and pb == 0 do out 1 end
    if pa == 0 do out 0 end
    if pb == 0 do out 0 end
    let la = cli_strlen(a)
    let lb = cli_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(pa, i) != read_byte(pb, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func print_banner:
    raw_print("==============================================\n")
    raw_print("     V I R O N   v2.0.0 (Native Toolchain)    \n")
    raw_print("   Modern Deterministic Package Manager for Vir\n")
    raw_print("==============================================\n")
end.

func print_version:
    raw_print("viron 2.0.0 (Vir native standalone toolchain)\n")
end.

func print_help:
    print_banner()
    raw_print("Usage:\n")
    raw_print("    viron <command> [options] [arguments]\n\n")
    raw_print("Commands:\n")
    raw_print("    new <name> [--lib]          Initialize a new Vir package\n")
    raw_print("    init                        Initialize vir.toml in current directory\n")
    raw_print("    add <pkg> [--version <ver>] Add a dependency to vir.toml\n")
    raw_print("    check                       Validate manifest and check package with virc\n")
    raw_print("    build [--release] [--frozen] [--offline]\n")
    raw_print("                                Build project into executable or library\n")
    raw_print("    run [args...]               Build and run the project executable\n")
    raw_print("    test                        Run project test suite\n")
    raw_print("    package                     Build reproducible distribution archive\n")
    raw_print("    publish [--dry-run]         Validate and publish package to registry\n")
    raw_print("    tree                        Resolve and display dependency DAG\n")
    raw_print("    resolve <pkg>               Inspect canonical module resolution\n")
    raw_print("    lock [--frozen]             Resolve dependencies and write vir.lock\n")
    raw_print("    toolchain <cmd> [arg]       Manage compiler toolchains\n")
    raw_print("    setup                       Bootstrap VIR_HOME environment\n")
    raw_print("    cache <cmd>                 Manage global package cache\n")
    raw_print("    doctor [--repair]           Audit system health, cache, and toolchains\n")
    raw_print("    std <cmd> [pkg]             Manage official standard library lifecycle\n\n")
    raw_print("Options:\n")
    raw_print("    --version, -v               Print version information\n")
    raw_print("    --help, -h                  Print this help message\n")
    raw_print("    --frozen                    Require up-to-date vir.lock without modifications\n")
    raw_print("    --offline                   Prevent all network activity\n")
    raw_print("    --release                   Build in release mode with optimizations\n")
    raw_print("    --repair                    Automatically repair detected issues\n")
end.

func cmd_new_action:
    in  name: string
        is_lib: int
    if cli_strlen(name) == 0 do
        diag_error(4101, "'new' requires a project name. Usage: viron new <name> [--lib]")
        exit_prog(2)
    end

    raw_print("Creating new Vir project '")
    raw_print(name)
    raw_print("'...\n")

    proc_mkdir("src")
    proc_mkdir("tests")

    let toml = manifest_generate(name, "0.1.0", is_lib)
    let modlist = project_generate_module_list(name, is_lib)
    let src = project_generate_src(name, is_lib)
    let test_src = project_generate_test(name)

    write_bytes("vir.toml", toml as int, cli_strlen(toml))
    write_bytes("module.list", modlist as int, cli_strlen(modlist))
    let lic_text = "Apache License\nVersion 2.0, January 2004\nhttp://www.apache.org/licenses/\n"
    write_bytes("LICENSE", lic_text as int, cli_strlen(lic_text))
    if is_lib == 1 do
        write_bytes("src/lib.vri", src as int, cli_strlen(src))
    else
        write_bytes("src/main.vri", src as int, cli_strlen(src))
    end
    write_bytes("tests/test_main.vri", test_src as int, cli_strlen(test_src))

    raw_print("  [+] Created vir.toml\n")
    raw_print("  [+] Created module.list\n")
    raw_print("  [+] Created LICENSE\n")
    raw_print("  [+] Created src/\n")
    raw_print("  [+] Created tests/\n")
    raw_print("Project '")
    raw_print(name)
    raw_print("' initialized successfully.\n")
end.

func cmd_doctor_action(repair_flag: int):
    let vhome = proc_get_vir_home()
    var pass_count = 0
    var issue_count = 0

    raw_print("Running Viron System Health Audit (10 checks):\n")

    # 1. VIR_HOME directory
    raw_print("  [1] VIR_HOME directory (")
    raw_print(vhome)
    raw_print("): ")
    if proc_file_exists(vhome) == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        if repair_flag == 1 do
            proc_mkdir(vhome)
            raw_print("REPAIRED (created)\n")
            pass_count = pass_count + 1
        else
            raw_print("NOT FOUND\n")
            issue_count = issue_count + 1
        end
    end

    # 2. Viron standalone binary integrity
    let self_exe = proc_get_self_exe()
    var self_sz = slurp_len(self_exe)
    if self_sz < 0 do self_sz = slurp_len("bin/viron") end
    raw_print("  [2] Viron standalone binary integrity: ")
    if self_sz >= 1024 do
        raw_print("OK (size > 1KB, native binary)\n")
        pass_count = pass_count + 1
    else
        raw_print("CORRUPTED or MISSING\n")
        issue_count = issue_count + 1
    end

    # 3. Active compiler binary (virc)
    let virc = proc_find_virc()
    let virc_sz = slurp_len(virc)
    raw_print("  [3] Compiler binary (virc): ")
    if virc_sz >= 1024 do
        raw_print("OK (")
        raw_print(virc)
        raw_print(")\n")
        pass_count = pass_count + 1
    else
        raw_print("MISSING or CORRUPTED (< 1KB)\n")
        issue_count = issue_count + 1
    end

    # 4. Sysroot standard library
    let s_std = alloc(256)
    var ssidx = 0
    ssidx = diag_copy_str(s_std, ssidx, vhome)
    ssidx = diag_copy_str(s_std, ssidx, "/sysroot/stdlib")
    write_byte(s_std, ssidx, 0)
    raw_print("  [4] Sysroot standard library: ")
    if proc_file_exists(s_std as string) == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        if repair_flag == 1 do
            proc_mkdir(vhome)
            let s_sys = alloc(256)
            var syi = 0
            syi = diag_copy_str(s_sys, syi, vhome)
            syi = diag_copy_str(s_sys, syi, "/sysroot")
            write_byte(s_sys, syi, 0)
            proc_mkdir(s_sys as string)
            proc_mkdir(s_std as string)
            raw_print("REPAIRED (initialized sysroot/stdlib)\n")
            pass_count = pass_count + 1
        else
            raw_print("NOT FOUND\n")
            issue_count = issue_count + 1
        end
    end

    # 5. Project manifest (vir.toml)
    raw_print("  [5] Project manifest (vir.toml): ")
    if proc_file_exists("vir.toml") == 1 do
        let toml_str = proc_read_file("vir.toml")
        if manifest_validate(toml_str) == 1 do
            raw_print("OK (valid)\n")
            pass_count = pass_count + 1
        else
            raw_print("MALFORMED\n")
            issue_count = issue_count + 1
        end
    else
        raw_print("ABSENT (outside project)\n")
    end

    # 6. Project module list (module.list)
    raw_print("  [6] Module registry (module.list): ")
    if proc_file_exists("module.list") == 1 do
        let mod_str = proc_read_file("module.list")
        if module_list_validate(mod_str) == 1 do
            raw_print("OK (valid)\n")
            pass_count = pass_count + 1
        else
            raw_print("MALFORMED\n")
            issue_count = issue_count + 1
        end
    else
        raw_print("ABSENT (outside project)\n")
    end

    # 7. Project lockfile (vir.lock)
    raw_print("  [7] Project lockfile (vir.lock): ")
    if proc_file_exists("vir.lock") == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        raw_print("ABSENT (outside project or unlocked)\n")
    end

    # 8. Global cache storage
    let c_dir = alloc(256)
    var cidx = 0
    cidx = diag_copy_str(c_dir, cidx, vhome)
    cidx = diag_copy_str(c_dir, cidx, "/cache")
    write_byte(c_dir, cidx, 0)
    raw_print("  [8] Global cache storage: ")
    if proc_file_exists(c_dir as string) == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        if repair_flag == 1 do
            proc_mkdir(c_dir as string)
            raw_print("REPAIRED\n")
            pass_count = pass_count + 1
        else
            raw_print("NOT FOUND\n")
            issue_count = issue_count + 1
        end
    end

    # 9. Temporary staging directory
    let t_dir = alloc(256)
    var tidx = 0
    tidx = diag_copy_str(t_dir, tidx, vhome)
    tidx = diag_copy_str(t_dir, tidx, "/cache/tmp")
    write_byte(t_dir, tidx, 0)
    raw_print("  [9] Temporary staging directory: ")
    if proc_file_exists(t_dir as string) == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        if repair_flag == 1 do
            proc_mkdir(t_dir as string)
            raw_print("REPAIRED\n")
            pass_count = pass_count + 1
        else
            raw_print("NOT FOUND\n")
            issue_count = issue_count + 1
        end
    end

    # 10. Toolchain repository
    let tc_dir = alloc(256)
    var tcdidx = 0
    tcdidx = diag_copy_str(tc_dir, tcdidx, vhome)
    tcdidx = diag_copy_str(tc_dir, tcdidx, "/toolchains")
    write_byte(tc_dir, tcdidx, 0)
    raw_print("  [10] Toolchain repository: ")
    if proc_file_exists(tc_dir as string) == 1 do
        raw_print("OK\n")
        pass_count = pass_count + 1
    else
        if repair_flag == 1 do
            proc_mkdir(tc_dir as string)
            raw_print("REPAIRED\n")
            pass_count = pass_count + 1
        else
            raw_print("NOT FOUND\n")
            issue_count = issue_count + 1
        end
    end

    if repair_flag == 1 do
        raw_print("\nRepair mode completed: System state reconciled.\n")
    end

    raw_print("\nSystem health audit finished: ")
    if issue_count == 0 do
        raw_print("0 issues detected.\n")
    else
        raw_print("issues detected (see above).\n")
    end
end.

export cli_strlen, cli_streq, print_banner, print_version, print_help, cmd_new_action, cmd_doctor_action
