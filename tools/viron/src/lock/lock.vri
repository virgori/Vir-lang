# ═════════════════════════════════════════════════════════════════════
# viron.lock — Deterministic Lockfile (vir.lock) Engine
# ═════════════════════════════════════════════════════════════════════

func lock_strlen(s: string) -> int:
    if s as int == 0 do out 0 end
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

func lock_copy_str:
    in  dst: int
        dst_idx: int
        src: string
    let sl = lock_strlen(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src as int, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func lock_find_substr:
    in  c_ptr: int
        c_len: int
        needle: string
    let nlen = lock_strlen(needle)
    if nlen == 0 do out 0 end
    if c_len < nlen do out 0 - 1 end

    var i = 0
    var limit = c_len - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            let cb = read_byte(c_ptr, i + j)
            let nb = read_byte(needle as int, j)
            if cb != nb do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func lock_generate:
    in  pkg_name: string
        version: string
    let buf = alloc(8192)
    var idx = 0

    idx = lock_copy_str(buf, idx, "# This file is automatically generated by Viron.\n# Manual edits may be overwritten.\nversion = 1\n\n[[package]]\nname = \"")
    idx = lock_copy_str(buf, idx, pkg_name)
    idx = lock_copy_str(buf, idx, "\"\nversion = \"")
    idx = lock_copy_str(buf, idx, version)
    idx = lock_copy_str(buf, idx, "\"\nsource = \"local\"\n")

    # Parse dependencies from vir.toml if present
    let toml_len = slurp_len("vir.toml")
    if toml_len > 0 do
        let toml_str = proc_read_file("vir.toml")
        let t_ptr = toml_str as int
        let t_len = lock_strlen(toml_str)
        let dpos = lock_find_substr(t_ptr, t_len, "[dependencies]")
        if dpos >= 0 do
            var p = dpos + 14
            when p < t_len and read_byte(t_ptr, p) != 10 loop
                p = p + 1
            end
            if p < t_len and read_byte(t_ptr, p) == 10 do p = p + 1 end

            when p < t_len and read_byte(t_ptr, p) != 91 loop
                var line_end = p
                when line_end < t_len and read_byte(t_ptr, line_end) != 10 and read_byte(t_ptr, line_end) != 13 loop
                    line_end = line_end + 1
                end

                var cur = p
                when cur < line_end and (read_byte(t_ptr, cur) == 32 or read_byte(t_ptr, cur) == 9) loop
                    cur = cur + 1
                end

                if cur < line_end and read_byte(t_ptr, cur) != 35 do
                    var eq = cur
                    when eq < line_end and read_byte(t_ptr, eq) != 61 loop
                        eq = eq + 1
                    end
                    if eq < line_end do
                        var name_end = eq
                        when name_end > cur and (read_byte(t_ptr, name_end - 1) == 32 or read_byte(t_ptr, name_end - 1) == 9) loop
                            name_end = name_end - 1
                        end
                        let dname_len = name_end - cur

                        var q1 = eq + 1
                        when q1 < line_end and read_byte(t_ptr, q1) != 34 loop
                            q1 = q1 + 1
                        end
                        if q1 < line_end do
                            var q2 = q1 + 1
                            when q2 < line_end and read_byte(t_ptr, q2) != 34 loop
                                q2 = q2 + 1
                            end
                            if q2 <= line_end and dname_len > 0 do
                                var vpos = q1 + 1
                                if vpos < q2 and (read_byte(t_ptr, vpos) == 94 or read_byte(t_ptr, vpos) == 126) do
                                    vpos = vpos + 1
                                end
                                let dver_len = q2 - vpos

                                idx = lock_copy_str(buf, idx, "\n[[package]]\nname = \"")
                                var di = 0
                                when di < dname_len loop
                                    write_byte(buf, idx, read_byte(t_ptr, cur + di))
                                    idx = idx + 1
                                    di = di + 1
                                end
                                idx = lock_copy_str(buf, idx, "\"\nversion = \"")
                                var vi = 0
                                when vi < dver_len loop
                                    write_byte(buf, idx, read_byte(t_ptr, vpos + vi))
                                    idx = idx + 1
                                    vi = vi + 1
                                end
                                idx = lock_copy_str(buf, idx, "\"\nsource = \"local\"\nchecksum = \"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n")
                            end
                        end
                    end
                end
                p = line_end + 1
            end
        end
    end

    write_byte(buf, idx, 0)
    out buf as string
end.

func lock_validate_frozen:
    in  lock_content: string
        pkg_name: string
        version: string
    let ptr = lock_content as int
    let len = lock_strlen(lock_content)
    let has_ver_tag = lock_find_substr(ptr, len, "version = 1")
    if has_ver_tag < 0 do out 0 end
    let has_pkg = lock_find_substr(ptr, len, pkg_name)
    if has_pkg < 0 do out 0 end
    let has_ver = lock_find_substr(ptr, len, version)
    if has_ver < 0 do out 0 end

    # Validate all dependencies in vir.toml
    let toml_len = slurp_len("vir.toml")
    if toml_len > 0 do
        let toml_str = proc_read_file("vir.toml")
        let t_ptr = toml_str as int
        let t_len = lock_strlen(toml_str)
        let dpos = lock_find_substr(t_ptr, t_len, "[dependencies]")
        if dpos >= 0 do
            var p = dpos + 14
            when p < t_len and read_byte(t_ptr, p) != 10 loop
                p = p + 1
            end
            if p < t_len and read_byte(t_ptr, p) == 10 do p = p + 1 end

            when p < t_len and read_byte(t_ptr, p) != 91 loop
                var line_end = p
                when line_end < t_len and read_byte(t_ptr, line_end) != 10 and read_byte(t_ptr, line_end) != 13 loop
                    line_end = line_end + 1
                end

                var cur = p
                when cur < line_end and (read_byte(t_ptr, cur) == 32 or read_byte(t_ptr, cur) == 9) loop
                    cur = cur + 1
                end

                if cur < line_end and read_byte(t_ptr, cur) != 35 do
                    var eq = cur
                    when eq < line_end and read_byte(t_ptr, eq) != 61 loop
                        eq = eq + 1
                    end
                    if eq < line_end do
                        var name_end = eq
                        when name_end > cur and (read_byte(t_ptr, name_end - 1) == 32 or read_byte(t_ptr, name_end - 1) == 9) loop
                            name_end = name_end - 1
                        end
                        let dname_len = name_end - cur

                        var q1 = eq + 1
                        when q1 < line_end and read_byte(t_ptr, q1) != 34 loop
                            q1 = q1 + 1
                        end
                        if q1 < line_end do
                            var q2 = q1 + 1
                            when q2 < line_end and read_byte(t_ptr, q2) != 34 loop
                                q2 = q2 + 1
                            end
                            if q2 <= line_end and dname_len > 0 do
                                var vpos = q1 + 1
                                if vpos < q2 and (read_byte(t_ptr, vpos) == 94 or read_byte(t_ptr, vpos) == 126) do
                                    vpos = vpos + 1
                                end
                                let dver_len = q2 - vpos

                                let dname_buf = alloc(dname_len + 1)
                                var di = 0
                                when di < dname_len loop
                                    write_byte(dname_buf, di, read_byte(t_ptr, cur + di))
                                    di = di + 1
                                end
                                write_byte(dname_buf, dname_len, 0)

                                let dver_buf = alloc(dver_len + 1)
                                var vi = 0
                                when vi < dver_len loop
                                    write_byte(dver_buf, vi, read_byte(t_ptr, vpos + vi))
                                    vi = vi + 1
                                end
                                write_byte(dver_buf, dver_len, 0)

                                if lock_find_substr(ptr, len, dname_buf as string) < 0 do
                                    out 0
                                end
                                if lock_find_substr(ptr, len, dver_buf as string) < 0 do
                                    out 0
                                end
                            end
                        end
                    end
                end
                p = line_end + 1
            end
        end
    end

    out 1
end.

export lock_generate, lock_validate_frozen
