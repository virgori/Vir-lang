# ═════════════════════════════════════════════════════════════════════
# viron.process — Subprocess Adapter, Kernel Syscalls & Compiler Runner
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
extern func vir_get_platform() -> int
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, v: int)

func proc_strlen(s: string) -> int:
    if s as int == 0 do out 0 end
    var i = 0
    when read_byte(s as int, i) != 0 loop
        i = i + 1
    end
    out i
end.

# ── Cross-Platform Syscalls ──────────────────────────────────────────

func proc_sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall0(172)
    eif plat == 3 do
        out syscall0(39)
    else
        out syscall0(0x2000014)
    end
end.

func proc_sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall5(220, 17, 0, 0, 0, 0) # Linux ARM64 clone(SIGCHLD=17)
    eif plat == 3 do
        out syscall0(57)                  # Linux x86_64 fork
    else
        out syscall0(0x2000002)           # Darwin fork
    end
end.

func proc_sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall4(260, pid, status_ptr, options, 0)
    eif plat == 3 do
        out syscall4(61, pid, status_ptr, options, 0)
    else
        out syscall4(0x2000007, pid, status_ptr, options, 0)
    end
end.

func proc_sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(221, path, argv, envp)
    eif plat == 3 do
        out syscall3(59, path, argv, envp)
    else
        out syscall3(0x200003B, path, argv, envp)
    end
end.

func proc_mkdir(path: string) -> int:
    if path as int == 0 do out -1 end
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(34, -100, path as int, 511)
    eif plat == 3 do
        out syscall2(83, path as int, 511)
    else
        out syscall2(0x2000088, path as int, 511)
    end
end.

func proc_unlink(path: string) -> int:
    if path as int == 0 do out -1 end
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall3(35, -100, path as int, 0)
    eif plat == 3 do
        out syscall1(87, path as int)
    else
        out syscall1(0x200000A, path as int)
    end
end.

func proc_chmod(path: string, mode: int) -> int:
    if path as int == 0 do out -1 end
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall4(53, -100, path as int, mode, 0)
    eif plat == 3 do
        out syscall2(90, path as int, mode)
    else
        out syscall2(0x200000F, path as int, mode)
    end
end.

func proc_rename(old_path: string, new_path: string) -> int:
    if old_path as int == 0 or new_path as int == 0 do out -1 end
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do
        out syscall4(38, -100, old_path as int, -100, new_path as int)
    eif plat == 3 do
        out syscall2(82, old_path as int, new_path as int)
    else
        out syscall2(0x2000080, old_path as int, new_path as int)
    end
end.

func proc_clean_dir(dir_path: string) -> int:
    let plat = vir_get_platform()
    let buf_sz = 8192
    let buf = alloc(buf_sz)
    var fd = -1

    if plat == 0 or plat == 1 do
        fd = syscall3(0x2000005, dir_path as int, 0, 0)
    eif plat == 2 or plat == 4 do
        fd = syscall4(56, -100, dir_path as int, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, dir_path as int, 0, 0)
    end

    if fd < 0 do out -1 end

    var nread = 0
    if plat == 0 or plat == 1 do
        let basep = alloc(8)
        native_write_i64(basep, 0, 0)
        nread = syscall4(344, fd, buf, buf_sz, basep)
    eif plat == 2 or plat == 4 do
        nread = syscall3(61, fd, buf, buf_sz)
    eif plat == 3 do
        nread = syscall3(217, fd, buf, buf_sz)
    end

    if plat == 0 or plat == 1 do
        syscall1(0x2000006, fd)
    eif plat == 2 or plat == 4 do
        syscall1(57, fd)
    eif plat == 3 do
        syscall1(3, fd)
    end

    if nread <= 0 do out 0 end

    var pos = 0
    let dlen = proc_strlen(dir_path)
    when pos < nread loop
        var reclen = 0
        var name_off = 0
        if plat == 0 or plat == 1 do
            reclen = read_byte(buf, pos + 16) + (read_byte(buf, pos + 17) shl 8)
            name_off = 21
        else
            reclen = read_byte(buf, pos + 16) + (read_byte(buf, pos + 17) shl 8)
            name_off = 19
        end

        if reclen <= 0 or pos + reclen > nread do
            pos = nread
        else
            let b0 = read_byte(buf, pos + name_off)
            let b1 = read_byte(buf, pos + name_off + 1)
            var is_dot = 0
            if b0 == 46 and b1 == 0 do is_dot = 1 end
            if b0 == 46 and b1 == 46 and read_byte(buf, pos + name_off + 2) == 0 do is_dot = 1 end

            if is_dot == 0 and b0 != 0 do
                let fpath = alloc(dlen + 256)
                var k = 0
                when k < dlen loop
                    write_byte(fpath, k, read_byte(dir_path as int, k))
                    k = k + 1
                end
                if read_byte(fpath, dlen - 1) != 47 do
                    write_byte(fpath, k, 47)
                    k = k + 1
                end
                var ni = 0
                when read_byte(buf, pos + name_off + ni) != 0 and ni < 250 loop
                    write_byte(fpath, k + ni, read_byte(buf, pos + name_off + ni))
                    ni = ni + 1
                end
                write_byte(fpath, k + ni, 0)
                proc_unlink(fpath as string)
            end
            pos = pos + reclen
        end
    end
    out 0
end.


func proc_file_exists(path: string) -> int:
    if path as int == 0 do out 0 end
    let len = slurp_len(path)
    if len >= 0 do out 1 end
    out 0
end.

func proc_read_file(path: string) -> string:
    let len = slurp_len(path)
    if len <= 0 do out "" end
    let buf = alloc(len + 1)
    slurp_file(path, buf, len)
    write_byte(buf, len, 0)
    out buf as string
end.

func proc_write_file:
    in  path: string
        content: string
    if content as int == 0 do out 0 end
    let len = proc_strlen(content)
    let res = write_bytes(path, content as int, len)
    out res
end.

func proc_write_ptr(buf: int, offset: int, val: int):
    write_byte(buf, offset, val bit_and 255)
    write_byte(buf, offset + 1, (val shr 8) bit_and 255)
    write_byte(buf, offset + 2, (val shr 16) bit_and 255)
    write_byte(buf, offset + 3, (val shr 24) bit_and 255)
    write_byte(buf, offset + 4, (val shr 32) bit_and 255)
    write_byte(buf, offset + 5, (val shr 40) bit_and 255)
    write_byte(buf, offset + 6, (val shr 48) bit_and 255)
    write_byte(buf, offset + 7, (val shr 56) bit_and 255)
end.

# ── Kernel Environment Lookup (No libc) ──────────────────────────────

func proc_getenv(name: string) -> string:
    let nlen = proc_strlen(name)
    if nlen == 0 do out "" end
    let plat = vir_get_platform()
    let capacity = 65536
    let buf = alloc(capacity)
    var size = 0
    var start = 0

    if plat == 0 or plat == 1 do
        # Darwin: sysctl KERN_PROCARGS2
        let mib = alloc(12)
        write_byte(mib, 0, 1)
        write_byte(mib, 4, 49)
        let pid = syscall0(0x2000014)
        write_byte(mib, 8, pid bit_and 255)
        write_byte(mib, 9, (pid shr 8) bit_and 255)
        write_byte(mib, 10, (pid shr 16) bit_and 255)
        write_byte(mib, 11, (pid shr 24) bit_and 255)

        let size_ptr = alloc(8)
        native_write_i64(size_ptr, 0, capacity)

        let st = syscall6(0x20000CA, mib, 3, buf, size_ptr, 0, 0)
        if st != 0 do out "" end
        size = native_read_i64(size_ptr, 0)
        if size <= 0 or size > capacity do out "" end

        let argc = read_byte(buf, 0) + (read_byte(buf, 1) shl 8) + (read_byte(buf, 2) shl 16) + (read_byte(buf, 3) shl 24)
        var pos = 4
        # Skip exec_path
        when pos < size and read_byte(buf, pos) != 0 loop
            pos = pos + 1
        end
        # Skip padding zeros
        when pos < size and read_byte(buf, pos) == 0 loop
            pos = pos + 1
        end
        # Skip argv strings
        var ai = 0
        when ai < argc and pos < size loop
            when pos < size and read_byte(buf, pos) != 0 loop
                pos = pos + 1
            end
            pos = pos + 1
            ai = ai + 1
        end
        start = pos
    eif plat == 2 or plat == 4 do
        # Linux ARM64: openat(AT_FDCWD, "/proc/self/environ", O_RDONLY, 0)
        let fd = syscall4(56, -100, "/proc/self/environ" as int, 0, 0)
        if fd < 0 do out "" end
        size = syscall3(63, fd, buf, capacity)
        syscall1(57, fd)
        if size <= 0 do out "" end
        start = 0
    eif plat == 3 do
        # Linux x86_64: open("/proc/self/environ", O_RDONLY, 0)
        let fd = syscall3(2, "/proc/self/environ" as int, 0, 0)
        if fd < 0 do out "" end
        size = syscall3(0, fd, buf, capacity)
        syscall1(3, fd)
        if size <= 0 do out "" end
        start = 0
    else
        out ""
    end

    # Search environment entries "NAME=VAL\0" starting at `start`
    var p = start
    when p < size loop
        var end_pos = p
        when end_pos < size and read_byte(buf, end_pos) != 0 loop
            end_pos = end_pos + 1
        end
        if end_pos > p and (end_pos - p) > nlen do
            var match = 1
            var j = 0
            when j < nlen loop
                if read_byte(buf, p + j) != read_byte(name as int, j) do
                    match = 0
                    j = nlen
                else
                    j = j + 1
                end
            end
            if match == 1 and read_byte(buf, p + nlen) == 61 do
                let val_start = p + nlen + 1
                let val_len = end_pos - val_start
                let res = alloc(val_len + 1)
                var k = 0
                when k < val_len loop
                    write_byte(res, k, read_byte(buf, val_start + k))
                    k = k + 1
                end
                write_byte(res, val_len, 0)
                out res as string
            end
        end
        p = end_pos + 1
    end
    out ""
end.

func proc_build_envp() -> int:
    let plat = vir_get_platform()
    let capacity = 65536
    let buf = alloc(capacity)
    var size = 0
    var start = 0

    if plat == 0 or plat == 1 do
        let mib = alloc(12)
        write_byte(mib, 0, 1)
        write_byte(mib, 4, 49)
        let pid = syscall0(0x2000014)
        write_byte(mib, 8, pid bit_and 255)
        write_byte(mib, 9, (pid shr 8) bit_and 255)
        write_byte(mib, 10, (pid shr 16) bit_and 255)
        write_byte(mib, 11, (pid shr 24) bit_and 255)

        let size_ptr = alloc(8)
        native_write_i64(size_ptr, 0, capacity)

        let st = syscall6(0x20000CA, mib, 3, buf, size_ptr, 0, 0)
        if st != 0 do
            let fallback_env = alloc(16)
            proc_write_ptr(fallback_env, 0, 0)
            out fallback_env
        end
        size = native_read_i64(size_ptr, 0)
        if size <= 4 or size > capacity do
            let fallback_env = alloc(16)
            proc_write_ptr(fallback_env, 0, 0)
            out fallback_env
        end

        let argc = read_byte(buf, 0) + (read_byte(buf, 1) shl 8) + (read_byte(buf, 2) shl 16) + (read_byte(buf, 3) shl 24)
        var pos = 4
        when pos < size and read_byte(buf, pos) != 0 loop
            pos = pos + 1
        end
        when pos < size and read_byte(buf, pos) == 0 loop
            pos = pos + 1
        end
        var ai = 0
        when ai < argc and pos < size loop
            when pos < size and read_byte(buf, pos) != 0 loop
                pos = pos + 1
            end
            pos = pos + 1
            ai = ai + 1
        end
        start = pos
    eif plat == 2 or plat == 4 do
        let fd = syscall4(56, -100, "/proc/self/environ" as int, 0, 0)
        if fd >= 0 do
            size = syscall3(63, fd, buf, capacity)
            syscall1(57, fd)
        end
        start = 0
    eif plat == 3 do
        let fd = syscall3(2, "/proc/self/environ" as int, 0, 0)
        if fd >= 0 do
            size = syscall3(0, fd, buf, capacity)
            syscall1(3, fd)
        end
        start = 0
    else
        start = 0
        size = 0
    end

    if size <= 0 or start >= size do
        let fallback_env = alloc(16)
        proc_write_ptr(fallback_env, 0, 0)
        out fallback_env
    end

    let envp = alloc(4096)
    var env_count = 0
    var p = start
    when p < size and env_count < 510 loop
        when p < size and read_byte(buf, p) == 0 loop
            p = p + 1
        end
        if p < size do
            var has_eq = 0
            var q = p
            when q < size and read_byte(buf, q) != 0 loop
                if read_byte(buf, q) == 61 do has_eq = 1 end
                q = q + 1
            end
            if has_eq == 1 do
                proc_write_ptr(envp, env_count * 8, buf + p)
                env_count = env_count + 1
            end
            p = q + 1
        end
    end
    proc_write_ptr(envp, env_count * 8, 0)
    out envp
end.

func proc_get_vir_home() -> string:
    let env_vh = proc_getenv("VIR_HOME")
    if proc_strlen(env_vh) > 0 do out env_vh end
    out ".vir"
end.

func proc_get_self_exe() -> string:
    let plat = vir_get_platform()
    if plat == 0 or plat == 1 do
        let mib = alloc(12)
        write_byte(mib, 0, 1)
        write_byte(mib, 4, 49)
        let pid = syscall0(0x2000014)
        write_byte(mib, 8, pid bit_and 255)
        write_byte(mib, 9, (pid shr 8) bit_and 255)
        write_byte(mib, 10, (pid shr 16) bit_and 255)
        write_byte(mib, 11, (pid shr 24) bit_and 255)
        let size_ptr = alloc(8)
        native_write_i64(size_ptr, 0, 65536)
        let buf = alloc(65536)
        let st = syscall6(0x20000CA, mib, 3, buf, size_ptr, 0, 0)
        if st != 0 do out "" end
        let size = native_read_i64(size_ptr, 0)
        if size <= 4 do out "" end
        var end_pos = 4
        when end_pos < size and read_byte(buf, end_pos) != 0 loop
            end_pos = end_pos + 1
        end
        let elen = end_pos - 4
        let res = alloc(elen + 1)
        var k = 0
        when k < elen loop
            write_byte(res, k, read_byte(buf, 4 + k))
            k = k + 1
        end
        write_byte(res, elen, 0)
        out res as string
    eif plat == 2 or plat == 4 do
        let buf = alloc(1024)
        let n = syscall4(78, -100, "/proc/self/exe" as int, buf, 1024)
        if n > 0 do
            write_byte(buf, n, 0)
            out buf as string
        end
    eif plat == 3 do
        let buf = alloc(1024)
        let n = syscall3(89, "/proc/self/exe" as int, buf, 1024)
        if n > 0 do
            write_byte(buf, n, 0)
            out buf as string
        end
    end
    out ""
end.

func proc_search_path:
    in  bin_name: string
    let env_path = proc_getenv("PATH")
    let plen = proc_strlen(env_path)
    if plen <= 0 do out "" end

    let blen = proc_strlen(bin_name)
    var p = 0
    when p < plen loop
        var colon = p
        when colon < plen and read_byte(env_path as int, colon) != 58 loop
            colon = colon + 1
        end
        let dlen = colon - p
        if dlen > 0 do
            let cand = alloc(dlen + blen + 4)
            var k = 0
            when k < dlen loop
                write_byte(cand, k, read_byte(env_path as int, p + k))
                k = k + 1
            end
            if read_byte(cand, dlen - 1) != 47 do
                write_byte(cand, dlen, 47)
                k = dlen + 1
            else
                k = dlen
            end
            k = diag_copy_str(cand, k, bin_name)
            write_byte(cand, k, 0)
            if proc_file_exists(cand as string) == 1 do
                out cand as string
            end
        end
        p = colon + 1
    end
    out ""
end.

func proc_find_virc() -> string:
    # 1. Check relative build paths
    if proc_file_exists("./bin/virc") == 1 do out "./bin/virc" end
    if proc_file_exists("../bin/virc") == 1 do out "../bin/virc" end
    if proc_file_exists("../../bin/virc") == 1 do out "../../bin/virc" end

    # 2. Check next to running viron binary
    let self_exe = proc_get_self_exe()
    let self_len = proc_strlen(self_exe)
    if self_len > 0 do
        var slash = self_len - 1
        when slash >= 0 and read_byte(self_exe as int, slash) != 47 loop
            slash = slash - 1
        end
        if slash > 0 do
            let cand = alloc(slash + 16)
            var ci = 0
            when ci <= slash loop
                write_byte(cand, ci, read_byte(self_exe as int, ci))
                ci = ci + 1
            end
            ci = diag_copy_str(cand, ci, "virc")
            write_byte(cand, ci, 0)
            if proc_file_exists(cand as string) == 1 do
                out cand as string
            end
        end
    end

    # 3. Check VIR_HOME/bin/virc if set
    let vhome = proc_getenv("VIR_HOME")
    if proc_strlen(vhome) > 0 do
        let vh_buf = alloc(256)
        var vh_idx = 0
        vh_idx = diag_copy_str(vh_buf, vh_idx, vhome)
        vh_idx = diag_copy_str(vh_buf, vh_idx, "/bin/virc")
        write_byte(vh_buf, vh_idx, 0)
        if proc_file_exists(vh_buf as string) == 1 do out vh_buf as string end
    end

    # 4. Check active local toolchain
    if proc_file_exists(".vir/bin/virc") == 1 do out ".vir/bin/virc" end

    # 5. Search directories in PATH environment variable
    let p_virc = proc_search_path("virc")
    if proc_strlen(p_virc) > 0 do out p_virc end

    # 6. Check standard system directories
    if proc_file_exists("/usr/local/bin/virc") == 1 do out "/usr/local/bin/virc" end
    if proc_file_exists("/opt/homebrew/bin/virc") == 1 do out "/opt/homebrew/bin/virc" end
    if proc_file_exists("/usr/bin/virc") == 1 do out "/usr/bin/virc" end
    out "virc"
end.

func proc_find_zstd() -> string:
    let p_zstd = proc_search_path("zstd")
    if proc_strlen(p_zstd) > 0 do out p_zstd end
    if proc_file_exists("/opt/homebrew/bin/zstd") == 1 do out "/opt/homebrew/bin/zstd" end
    if proc_file_exists("/usr/local/bin/zstd") == 1 do out "/usr/local/bin/zstd" end
    if proc_file_exists("/usr/bin/zstd") == 1 do out "/usr/bin/zstd" end
    out ""
end.

func proc_find_sysroot(virc_path: string) -> string:
    let vhome = proc_getenv("VIR_HOME")
    if proc_strlen(vhome) > 0 do
        let vh_buf = alloc(256)
        var vi = 0
        vi = diag_copy_str(vh_buf, vi, vhome)
        vi = diag_copy_str(vh_buf, vi, "/sysroot")
        write_byte(vh_buf, vi, 0)
        if proc_file_exists(vh_buf as string) == 1 do
            out vh_buf as string
        end
    end

    let vlen = proc_strlen(virc_path)
    if vlen > 0 do
        var s1 = vlen - 1
        when s1 >= 0 and read_byte(virc_path as int, s1) != 47 loop
            s1 = s1 - 1
        end
        if s1 > 0 do
            var s2 = s1 - 1
            when s2 >= 0 and read_byte(virc_path as int, s2) != 47 loop
                s2 = s2 - 1
            end
            if s2 >= 0 do
                let test_buf = alloc(s2 + 32)
                var ti = 0
                when ti <= s2 loop
                    write_byte(test_buf, ti, read_byte(virc_path as int, ti))
                    ti = ti + 1
                end
                ti = diag_copy_str(test_buf, ti, "stdlib/stdlib.vri")
                write_byte(test_buf, ti, 0)
                if proc_file_exists(test_buf as string) == 1 do
                    let root_buf = alloc(s2 + 1)
                    var ri = 0
                    when ri < s2 loop
                        write_byte(root_buf, ri, read_byte(virc_path as int, ri))
                        ri = ri + 1
                    end
                    write_byte(root_buf, ri, 0)
                    out root_buf as string
                end
            end
        end
    end
    out ""
end.

func proc_compile_file:
    in  virc_path: string
        src_path: string
        out_bin: string
        opt_level: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()
    if cur_pid != my_pid or child_pid == 0 do
        # Child process
        let sysroot = proc_find_sysroot(virc_path)
        let has_sysroot = proc_strlen(sysroot) > 0
        let argv = alloc(128)
        var opt_str = "-O1"
        if opt_level == 3 do
            opt_str = "-O3"
        eif opt_level == 0 do
            opt_str = "-O0"
        end

        var ai = 0
        proc_write_ptr(argv, ai, virc_path as int)
        ai = ai + 8
        proc_write_ptr(argv, ai, opt_str as int)
        ai = ai + 8
        if has_sysroot == 1 do
            proc_write_ptr(argv, ai, "--sysroot" as int)
            ai = ai + 8
            proc_write_ptr(argv, ai, sysroot as int)
            ai = ai + 8
        end
        proc_write_ptr(argv, ai, src_path as int)
        ai = ai + 8
        proc_write_ptr(argv, ai, "-o" as int)
        ai = ai + 8
        proc_write_ptr(argv, ai, out_bin as int)
        ai = ai + 8
        proc_write_ptr(argv, ai, 0)

        let envp = proc_build_envp()
        proc_sys_execve(virc_path as int, argv, envp)
        exit_prog(127)
    end
    # Parent process
    let st = alloc(8)
    proc_sys_wait4(child_pid, st, 0)
    let sig = read_byte(st, 0)
    let code = read_byte(st, 1)
    if sig != 0 do out 128 + sig end
    out code
end.

func proc_run_binary_with_args:
    in  bin_path: string
        start_arg: int
        end_arg: int
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()
    if cur_pid != my_pid or child_pid == 0 do
        # Child process
        var extra_count = 0
        if end_arg > start_arg do
            extra_count = end_arg - start_arg
        end
        let argv = alloc((extra_count + 2) * 8)
        proc_write_ptr(argv, 0, bin_path as int)
        var i = 0
        when i < extra_count loop
            let a = get_arg(start_arg + i)
            proc_write_ptr(argv, (i + 1) * 8, a as int)
            i = i + 1
        end
        proc_write_ptr(argv, (extra_count + 1) * 8, 0)
        let envp = proc_build_envp()
        proc_sys_execve(bin_path as int, argv, envp)
        exit_prog(127)
    end
    # Parent process
    let st = alloc(8)
    proc_sys_wait4(child_pid, st, 0)
    let sig = read_byte(st, 0)
    let code = read_byte(st, 1)
    if sig != 0 do out 128 + sig end
    out code
end.

func proc_run_binary(bin_path: string) -> int:
    out proc_run_binary_with_args(bin_path, 0, 0)
end.

func proc_run_tool:
    in  tool_path: string
        arg1: string
        arg2: string
        arg3: string
    let my_pid = proc_sys_getpid()
    let child_pid = proc_sys_fork()
    let cur_pid = proc_sys_getpid()
    if cur_pid != my_pid or child_pid == 0 do
        # Child process
        let argv = alloc(48)
        proc_write_ptr(argv, 0, tool_path as int)
        proc_write_ptr(argv, 8, arg1 as int)
        proc_write_ptr(argv, 16, arg2 as int)
        proc_write_ptr(argv, 24, arg3 as int)
        proc_write_ptr(argv, 32, 0)
        let envp = proc_build_envp()
        proc_sys_execve(tool_path as int, argv, envp)
        exit_prog(127)
    end
    # Parent process
    let st = alloc(8)
    proc_sys_wait4(child_pid, st, 0)
    let sig = read_byte(st, 0)
    let code = read_byte(st, 1)
    if sig != 0 do out 128 + sig end
    out code
end.

export proc_strlen, proc_mkdir, proc_unlink, proc_chmod, proc_rename, proc_clean_dir, proc_file_exists, proc_read_file, proc_write_file, proc_write_ptr, proc_getenv, proc_get_vir_home, proc_find_virc, proc_find_zstd, proc_find_sysroot, proc_compile_file, proc_run_binary, proc_run_binary_with_args, proc_run_tool, proc_get_self_exe, proc_search_path, proc_build_envp

