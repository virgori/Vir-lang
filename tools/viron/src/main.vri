# ═════════════════════════════════════════════════════════════════════
# tools/viron/src/main.vri — viron 2.0.0 (Vir native standalone toolchain)
# ═════════════════════════════════════════════════════════════════════

include viron.diagnostic
include viron.security
include viron.process
include viron.manifest
include viron.lock
include viron.resolve
include viron.module_map
include viron.project
include viron.toolchain
include viron.cache
include viron.registry
include viron.package
include viron.stdlib_lifecycle
include viron.cli

func main():
    let argc = arg_count()
    if argc <= 1 do
        print_help()
        exit_prog(0)
    end

    let cmd = get_arg(1)

    # ── Help & Version Options ─────────────────────────────
    if cli_streq(cmd, "help") != 0 or cli_streq(cmd, "-h") != 0 or cli_streq(cmd, "--help") != 0 do
        print_help()
        exit_prog(0)
    end

    if cli_streq(cmd, "version") != 0 or cli_streq(cmd, "-v") != 0 or cli_streq(cmd, "--version") != 0 do
        print_version()
        exit_prog(0)
    end

    # ── Project Initialization: new, init ──────────────────
    if cli_streq(cmd, "new") != 0 do
        if argc <= 2 do
            diag_error(4101, "'new' requires a project name. Usage: viron new <name> [--lib]")
            exit_prog(2)
        end
        var is_lib = 0
        var name = get_arg(2)
        if cli_streq(name, "--lib") != 0 do
            is_lib = 1
            if argc > 3 do
                name = get_arg(3)
            else
                diag_error(4101, "'new --lib' requires a project name.")
                exit_prog(2)
            end
        eif argc > 3 do
            if cli_streq(get_arg(3), "--lib") != 0 do
                is_lib = 1
            end
        end

        cmd_new_action(name, is_lib)
        exit_prog(0)
    end

    if cli_streq(cmd, "init") != 0 do
        cmd_new_action("vir_app", 0)
        exit_prog(0)
    end

    # ── Dependency Management: add ─────────────────────────
    if cli_streq(cmd, "add") != 0 do
        if argc <= 2 do
            diag_error(4101, "'add' requires a package name. Usage: viron add <package> [version]")
            exit_prog(2)
        end
        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty in current directory")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        let dep_name = get_arg(2)
        var dep_ver = "^1.0.0"
        if argc > 3 do
            dep_ver = get_arg(3)
        end

        let new_toml = manifest_add_dependency(toml_str, dep_name, dep_ver)
        proc_write_file("vir.toml", new_toml)

        let abuf = alloc(256)
        var aidx = 0
        aidx = diag_copy_str(abuf, aidx, "Adding dependency '")
        aidx = diag_copy_str(abuf, aidx, dep_name)
        aidx = diag_copy_str(abuf, aidx, "' (")
        aidx = diag_copy_str(abuf, aidx, dep_ver)
        aidx = diag_copy_str(abuf, aidx, ") to vir.toml... OK\n")
        write_byte(abuf, aidx, 0)
        raw_print(abuf as string)
        exit_prog(0)
    end

    # ── Verification: check ────────────────────────────────
    if cli_streq(cmd, "check") != 0 do
        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty in current directory")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        if manifest_validate(toml_str) == 0 do
            diag_error(4001, "malformed vir.toml: missing [package], name, or version")
            exit_prog(1)
        end
        let mod_len = slurp_len("module.list")
        if mod_len <= 0 do
            diag_error(4002, "mandatory module.list not found or empty in current directory")
            exit_prog(1)
        end
        let mod_str = proc_read_file("module.list")
        if module_list_validate(mod_str) == 0 do
            diag_error(4002, "malformed module.list: missing root directive")
            exit_prog(1)
        end
        raw_print("Project check: manifest and module registry valid (0 errors).\n")
        exit_prog(0)
    end

    # ── Compilation & Execution: build, run, test ──────────
    if cli_streq(cmd, "build") != 0 do
        var is_frozen = 0
        var is_offline = 0
        var is_release = 0
        var arg_i = 2
        when arg_i < argc loop
            let a = get_arg(arg_i)
            if cli_streq(a, "--frozen") != 0 do is_frozen = 1 end
            if cli_streq(a, "--offline") != 0 do is_offline = 1 end
            if cli_streq(a, "--release") != 0 do is_release = 1 end
            arg_i = arg_i + 1
        end

        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty in current directory")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        if manifest_validate(toml_str) == 0 do
            diag_error(4001, "malformed vir.toml: missing [package], name, or version")
            exit_prog(1)
        end

        let mod_len = slurp_len("module.list")
        if mod_len <= 0 do
            diag_error(4002, "mandatory module.list not found or empty in current directory")
            exit_prog(1)
        end
        let mod_str = proc_read_file("module.list")
        if module_list_validate(mod_str) == 0 do
            diag_error(4002, "malformed module.list: missing root directive")
            exit_prog(1)
        end

        if is_frozen == 1 do
            let lock_len = slurp_len("vir.lock")
            if lock_len <= 0 do
                diag_error(4204, "--frozen flag specified but vir.lock is missing or empty")
                exit_prog(1)
            end
            let lock_str = proc_read_file("vir.lock")
            let pkg_name = manifest_extract_name(toml_str)
            let pkg_ver = manifest_extract_version(toml_str)
            if lock_validate_frozen(lock_str, pkg_name, pkg_ver) == 0 do
                diag_error(4204, "--frozen flag specified but vir.lock is out of sync with vir.toml")
                exit_prog(1)
            end
        end

        raw_print("Compiling project via virc...\n")
        if is_release == 1 do
            raw_print("  [+] Profile: release (-O3, optimizations enabled)\n")
        else
            raw_print("  [+] Profile: dev (-O1)\n")
        end
        if is_offline == 1 do
            raw_print("  [+] Mode: offline (0 network requests permitted)\n")
        end

        # Create target directories
        proc_mkdir("target")
        proc_mkdir("target/debug")
        if is_release == 1 do
            proc_mkdir("target/release")
        end

        # Determine target artifact
        var out_artifact = "target/debug/output"
        if is_release == 1 do
            out_artifact = "target/release/output"
        end

        var opt_lvl = 1
        if is_release == 1 do
            opt_lvl = 3
        end

        let declared_entry = manifest_extract_entry(toml_str)
        var entry_file = ""
        var is_entry_lib = 0

        if man_strlen(declared_entry) > 0 do
            if proc_file_exists(declared_entry) == 0 do
                diag_error(4101, "cannot build project: no entrypoint found (declared entry file not found)")
                exit_prog(1)
            end
            entry_file = declared_entry
            let elen = man_strlen(entry_file)
            if elen >= 7 and read_byte(entry_file as int, elen - 7) == 108 and read_byte(entry_file as int, elen - 6) == 105 and read_byte(entry_file as int, elen - 5) == 98 do
                is_entry_lib = 1
            end
        else
            if slurp_len("src/main.vri") >= 0 do
                entry_file = "src/main.vri"
            eif slurp_len("src/lib.vri") >= 0 do
                entry_file = "src/lib.vri"
                is_entry_lib = 1
            else
                diag_error(4101, "cannot build project: no entrypoint found (expected src/main.vri or src/lib.vri)")
                exit_prog(1)
            end
        end

        if is_entry_lib == 0 do
            let virc_path = proc_find_virc()
            let cres = proc_compile_file(virc_path, entry_file, out_artifact, opt_lvl)
            if cres != 0 or slurp_len(out_artifact) <= 0 do
                diag_error(4101, "virc compilation failed")
                exit_prog(1)
            end
        else
            if is_release == 1 do
                out_artifact = "target/release/lib.vri"
            else
                out_artifact = "target/debug/lib.vri"
            end
            let lib_src = proc_read_file(entry_file)
            proc_write_file(out_artifact, lib_src)
            if slurp_len(out_artifact) <= 0 do
                diag_error(4101, "failed to produce library artifact")
                exit_prog(1)
            end
        end

        if slurp_len(out_artifact) <= 0 do
            diag_error(4101, "build failed: target artifact was not generated")
            exit_prog(1)
        end

        raw_print("Build finished successfully (")
        raw_print(out_artifact)
        raw_print(").\n")
        exit_prog(0)
    end

    if cli_streq(cmd, "run") != 0 do
        if slurp_len("target/debug/output") <= 0 do
            if slurp_len("src/main.vri") < 0 do
                diag_error(4101, "cannot run project: entrypoint src/main.vri not found")
                exit_prog(1)
            end
            # Build first
            let virc_path = proc_find_virc()
            proc_mkdir("target")
            proc_mkdir("target/debug")
            let bres = proc_compile_file(virc_path, "src/main.vri", "target/debug/output", 1)
            if bres != 0 or slurp_len("target/debug/output") <= 0 do
                diag_error(4101, "failed to build executable for run")
                exit_prog(1)
            end
        end
        raw_print("Building and executing project...\n")
        let run_code = proc_run_binary_with_args("target/debug/output", 2, argc)
        exit_prog(run_code)
    end

    if cli_streq(cmd, "test") != 0 do
        var test_file = ""
        if slurp_len("tests/test_main.vri") >= 0 do
            test_file = "tests/test_main.vri"
        eif slurp_len("tests/test_basic.vri") >= 0 do
            test_file = "tests/test_basic.vri"
        else
            diag_error(4101, "no test files found in tests/ (expected test_main.vri or test_basic.vri)")
            exit_prog(1)
        end
        proc_mkdir("target")
        proc_mkdir("target/debug")
        let virc_path = proc_find_virc()
        let tc_res = proc_compile_file(virc_path, test_file, "target/debug/test_runner", 0)
        if tc_res != 0 or slurp_len("target/debug/test_runner") <= 0 do
            diag_error(4101, "failed to compile test suite")
            exit_prog(1)
        end
        raw_print("Running project test suites...\n")
        let tr_code = proc_run_binary("target/debug/test_runner")
        exit_prog(tr_code)
    end

    # ── Packaging & Registry: package, publish ────────────
    if cli_streq(cmd, "package") != 0 do
        let toml_str = proc_read_file("vir.toml")
        var pkg_name = manifest_extract_name(toml_str)
        if cli_strlen(pkg_name) == 0 do pkg_name = "app" end
        var pkg_ver = manifest_extract_version(toml_str)
        if cli_strlen(pkg_ver) == 0 do pkg_ver = "0.1.0" end
        pkg_build_archive(pkg_name, pkg_ver)
        exit_prog(0)
    end

    if cli_streq(cmd, "publish") != 0 do
        var is_dry = 0
        if argc > 2 do
            if cli_streq(get_arg(2), "--dry-run") != 0 do
                is_dry = 1
            end
        end
        if is_dry == 1 do
            reg_publish_dry_run()
            exit_prog(0)
        else
            reg_publish()
            exit_prog(1)
        end
    end

    # ── Dependency Resolution: tree, resolve, lock ─────────
    if cli_streq(cmd, "tree") != 0 do
        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty in current directory")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        manifest_print_tree(toml_str)
        exit_prog(0)
    end

    if cli_streq(cmd, "resolve") != 0 do
        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty in current directory")
            exit_prog(1)
        end
        let mod_len = slurp_len("module.list")
        if mod_len <= 0 do
            diag_error(4002, "mandatory module.list not found or empty in current directory")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        let mod_str = proc_read_file("module.list")
        manifest_print_resolve(toml_str, mod_str)
        exit_prog(0)
    end

    if cli_streq(cmd, "lock") != 0 do
        var is_frozen = 0
        if argc > 2 do
            if cli_streq(get_arg(2), "--frozen") != 0 do
                is_frozen = 1
            end
        end
        let toml_len = slurp_len("vir.toml")
        if toml_len <= 0 do
            diag_error(4001, "vir.toml not found or empty")
            exit_prog(1)
        end
        let toml_str = proc_read_file("vir.toml")
        let pkg_name = manifest_extract_name(toml_str)
        let pkg_ver = manifest_extract_version(toml_str)

        if is_frozen == 1 do
            let lock_len = slurp_len("vir.lock")
            if lock_len <= 0 do
                diag_error(4204, "--frozen flag specified but vir.lock is missing")
                exit_prog(1)
            end
            let lock_str = proc_read_file("vir.lock")
            if lock_validate_frozen(lock_str, pkg_name, pkg_ver) == 0 do
                diag_error(4204, "--frozen flag specified but vir.lock is out of sync with vir.toml")
                exit_prog(1)
            end
            raw_print("vir.lock verified and matches vir.toml.\n")
        else
            var p_name = pkg_name
            if cli_strlen(p_name) == 0 do p_name = "app" end
            var p_ver = pkg_ver
            if cli_strlen(p_ver) == 0 do p_ver = "0.1.0" end
            let lock_buf = lock_generate(p_name, p_ver)
            write_bytes("vir.lock", lock_buf as int, cli_strlen(lock_buf))
            raw_print("Wrote deterministic vir.lock (1 package resolved).\n")
        end
        exit_prog(0)
    end

    # ── Toolchain Management: toolchain, setup ─────────────
    if cli_streq(cmd, "toolchain") != 0 do
        if argc <= 2 do
            tc_print_installed()
            exit_prog(0)
        end
        let sub = get_arg(2)
        if cli_streq(sub, "list") != 0 do
            tc_print_installed()
        eif cli_streq(sub, "install") != 0 do
            var ver = "3.2.0"
            if argc > 3 do ver = get_arg(3) end
            tc_install(ver)
        eif cli_streq(sub, "default") != 0 do
            var ver = "2026.1"
            if argc > 3 do ver = get_arg(3) end
            tc_default(ver)
        eif cli_streq(sub, "rollback") != 0 do
            tc_rollback()
        eif cli_streq(sub, "verify") != 0 do
            var ver = "2026.1"
            if argc > 3 do ver = get_arg(3) end
            tc_verify(ver)
        eif cli_streq(sub, "repair") != 0 do
            tc_repair()
        else
            diag_error(4101, "unknown toolchain subcommand")
            exit_prog(1)
        end
        exit_prog(0)
    end

    if cli_streq(cmd, "setup") != 0 do
        let vhome = proc_get_vir_home()
        proc_mkdir(vhome)
        let b1 = alloc(256)
        var i1 = 0
        i1 = diag_copy_str(b1, i1, vhome)
        i1 = diag_copy_str(b1, i1, "/bin")
        write_byte(b1, i1, 0)
        proc_mkdir(b1 as string)

        let b2 = alloc(256)
        var i2 = 0
        i2 = diag_copy_str(b2, i2, vhome)
        i2 = diag_copy_str(b2, i2, "/toolchains")
        write_byte(b2, i2, 0)
        proc_mkdir(b2 as string)

        let b3 = alloc(256)
        var i3 = 0
        i3 = diag_copy_str(b3, i3, vhome)
        i3 = diag_copy_str(b3, i3, "/cache")
        write_byte(b3, i3, 0)
        proc_mkdir(b3 as string)

        let b4 = alloc(256)
        var i4 = 0
        i4 = diag_copy_str(b4, i4, vhome)
        i4 = diag_copy_str(b4, i4, "/cache/tmp")
        write_byte(b4, i4, 0)
        proc_mkdir(b4 as string)

        let b5 = alloc(256)
        var i5 = 0
        i5 = diag_copy_str(b5, i5, vhome)
        i5 = diag_copy_str(b5, i5, "/packages")
        write_byte(b5, i5, 0)
        proc_mkdir(b5 as string)

        raw_print("Bootstrap complete: VIR_HOME initialized at ")
        raw_print(vhome)
        raw_print(" with toolchains, cache, and dispatcher shims.\n")
        exit_prog(0)
    end

    # ── Cache Management: cache ────────────────────────────
    if cli_streq(cmd, "cache") != 0 do
        if argc <= 2 do
            cache_cmd_info()
            exit_prog(0)
        end
        let sub = get_arg(2)
        if cli_streq(sub, "path") != 0 do
            cache_cmd_path()
        eif cli_streq(sub, "info") != 0 do
            cache_cmd_info()
        eif cli_streq(sub, "clean") != 0 do
            cache_cmd_clean()
        eif cli_streq(sub, "prune") != 0 do
            cache_cmd_prune()
        else
            diag_error(4101, "unknown cache subcommand")
            exit_prog(1)
        end
        exit_prog(0)
    end

    # ── Doctor & Health Audit: doctor ──────────────────────
    if cli_streq(cmd, "doctor") != 0 do
        var has_repair = 0
        if argc > 2 do
            if cli_streq(get_arg(2), "--repair") != 0 do
                has_repair = 1
            end
        end
        cmd_doctor_action(has_repair)
        exit_prog(0)
    end

    # ── Standard Library Lifecycle: std ────────────────────
    if cli_streq(cmd, "std") != 0 do
        if argc <= 2 do
            std_cmd_list()
            exit_prog(0)
        end
        let sub = get_arg(2)
        if cli_streq(sub, "list") != 0 do
            std_cmd_list()
        eif cli_streq(sub, "install") != 0 do
            var pkg = "vir.json"
            if argc > 3 do pkg = get_arg(3) end
            std_cmd_install(pkg)
        eif cli_streq(sub, "update") != 0 do
            var pkg = ""
            if argc > 3 do pkg = get_arg(3) end
            std_cmd_update(pkg)
        eif cli_streq(sub, "verify") != 0 do
            std_cmd_verify()
        eif cli_streq(sub, "repair") != 0 do
            std_cmd_repair()
        eif cli_streq(sub, "rollback") != 0 do
            std_cmd_rollback()
        else
            diag_error(4101, "unknown std subcommand")
            exit_prog(1)
        end
        exit_prog(0)
    end

    # ── Unknown Command ────────────────────────────────────
    let ubuf = alloc(256)
    var uidx = 0
    uidx = diag_copy_str(ubuf, uidx, "unknown command '")
    uidx = diag_copy_str(ubuf, uidx, cmd)
    uidx = diag_copy_str(ubuf, uidx, "'. Run 'viron --help' for usage.")
    write_byte(ubuf, uidx, 0)
    diag_error(4101, ubuf as string)
    exit_prog(127)
end.
