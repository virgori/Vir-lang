# Scenario: indirect call — `abs` is only used through `helper`, which main calls.
# expect import abs active
# expect import min inactive
# expect function helper active
# expect function orphan inactive
include math
import abs, min from math

func helper(v: int):
    out abs(v)
end.

func orphan(v: int):
    out v
end.

func main:
    out helper(0 - 3)
end.
