{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vir",
  "scopeName": "source.vri",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#types"
    },
    {
      "include": "#intrinsicsGradeS"
    },
    {
      "include": "#aiOps"
    },
    {
      "include": "#systemOps"
    },
    {
      "include": "#shape"
    },
    {
      "include": "#specialOperators"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functionDecl"
    },
    {
      "include": "#params"
    },
    {
      "include": "#typeReferences"
    },
    {
      "include": "#variableDecl"
    },
    {
      "include": "#forVariable"
    },
    {
      "include": "#assignmentLhs"
    },
    {
      "include": "#entityName"
    },
    {
      "include": "#matrixPunctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.vri",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.vri",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.vri",
          "begin": "#",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vri",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vri",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vri",
          "match": "\\b(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.vri",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "meta.annotation.vri",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.vri",
          "match": "\\b(?:entity|func|enum)\\b"
        },
        {
          "name": "keyword.control.secondary.vri",
          "match": "\\b(?:var|in|out)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.import.vri",
          "match": "\\b(?:import|export|get)\\b"
        },
        {
          "name": "keyword.control.terminator.vri",
          "match": "\\bend\\b"
        },
        {
          "name": "keyword.control.vri",
          "match": "\\b(?:if|elif|else|for|while|return)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tensor.vri",
          "match": "\\b(?:Matrix|Vector)\\b"
        },
        {
          "name": "storage.type.scalar.vri",
          "match": "\\b(?:int|float|bool|string)\\b"
        }
      ]
    },
    "aiOps": {
      "patterns": [
        {
          "name": "support.function.ai.matmul.vri",
          "match": "\\bmatmul\\b"
        },
        {
          "name": "support.function.ai.grad.vri",
          "match": "\\bgrad\\b"
        },
        {
          "name": "support.function.ai.embed.vri",
          "match": "\\bembed\\b"
        },
        {
          "name": "support.function.ai.train.vri",
          "match": "\\btrain\\b"
        }
      ]
    },
    "systemOps": {
      "patterns": [
        {
          "name": "support.function.system.xor.vri",
          "match": "\\bxor\\b"
        },
        {
          "name": "support.function.system.shift.vri",
          "match": "\\b(?:shr|shl)\\b"
        }
      ]
    },
    "intrinsicsGradeS": {
      "patterns": [
        {
          "name": "support.function.intrinsic.grade-s.simd.vri",
          "match": "\\b(?:simd_add|simd_sub|simd_mul|simd_fma|simd_div|simd_load|simd_store|simd_splat|simd_reduce_sum|simd_min|simd_max)\\b"
        },
        {
          "name": "support.function.intrinsic.grade-s.matmul.vri",
          "match": "\\bmatmul\\b"
        },
        {
          "name": "support.function.intrinsic.grade-s.kernel.vri",
          "match": "\\b(?:neon_gemm|neon_add|neon_mul|neon_fmla|avx_add|avx_mul|avx_fma)\\b"
        }
      ]
    },
    "shape": {
      "patterns": [
        {
          "name": "meta.tensor.shape.vri",
          "begin": "\\b(?:Matrix|Vector)\\s*(<)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.typeparameters.begin.vri"
            }
          },
          "end": "(>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.typeparameters.end.vri"
            }
          },
          "patterns": [
            {
              "name": "constant.numeric.dimension.vri",
              "match": "\\b\\d+\\b"
            },
            {
              "name": "punctuation.separator.comma.vri",
              "match": ","
            }
          ]
        }
      ]
    },
    "specialOperators": {
      "patterns": [
        {
          "name": "keyword.operator.power.vri",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.cast.vri",
          "match": ">>"
        },
        {
          "name": "keyword.operator.math-context.vri",
          "match": "\\$"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vri",
          "match": "->|\\+|-|\\*|/|==|!=|<=|>=|<|>|="
        }
      ]
    },
    "functionDecl": {
      "patterns": [
        {
          "name": "meta.function.vri",
          "match": "\\bfunc\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.vri"
            }
          }
        }
      ]
    },
    "params": {
      "patterns": [
        {
          "name": "meta.parameters.vri",
          "match": "\\b(?:in|out)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.parameter.vri"
            }
          }
        }
      ]
    },
    "typeReferences": {
      "patterns": [
        {
          "name": "meta.type.annotation.vri",
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.vri"
            },
            "2": {
              "name": "entity.name.type.vri"
            }
          }
        },
        {
          "name": "meta.type.annotation.vri",
          "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.vri"
            },
            "2": {
              "name": "entity.name.type.vri"
            }
          }
        }
      ]
    },
    "variableDecl": {
      "patterns": [
        {
          "name": "meta.variable.declaration.vri",
          "match": "\\bvar\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "forVariable": {
      "patterns": [
        {
          "name": "meta.variable.loop.vri",
          "match": "\\bfor\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "assignmentLhs": {
      "patterns": [
        {
          "name": "meta.assignment.lhs.vri",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*=(?!=))",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "entityName": {
      "patterns": [
        {
          "name": "meta.entity.vri",
          "match": "\\bentity\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.vri"
            }
          }
        }
      ]
    },
    "matrixPunctuation": {
      "patterns": [
        {
          "name": "punctuation.section.matrix.vri",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.separator.matrix.vri",
          "match": ","
        }
      ]
    }
  }
}
