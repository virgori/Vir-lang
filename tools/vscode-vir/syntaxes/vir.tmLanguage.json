{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vir",
  "scopeName": "source.vri",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#returnArrow"
    },
    {
      "include": "#operatorsUnified"
    },
    {
      "include": "#shape"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#types"
    },
    {
      "include": "#intrinsicsGradeS"
    },
    {
      "include": "#aiOps"
    },
    {
      "include": "#systemOps"
    },
    {
      "include": "#moduleDecl"
    },
    {
      "include": "#generics"
    },
    {
      "include": "#ufcs"
    },
    {
      "include": "#functionDecl"
    },
    {
      "include": "#params"
    },
    {
      "include": "#typeReferences"
    },
    {
      "include": "#variableDecl"
    },
    {
      "include": "#forVariable"
    },
    {
      "include": "#assignmentLhs"
    },
    {
      "include": "#entityName"
    },
    {
      "include": "#matrixPunctuation"
    }
  ],
  "repository": {
    "fileBanner": {
      "patterns": [
        {
          "name": "comment.block.banner.vri",
          "contentName": "comment.block.banner.content.vri",
          "begin": "\\A(?:#![^\\n]*\\n)?[ \\t]*(#\\*#)[ \\t]*\\n?",
          "end": "#\\*#",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.banner.vri"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.banner.vri"
            }
          },
          "patterns": [
            {
              "name": "comment.block.banner.rule.vri",
              "match": "^[ \\t]*(?:\\*[ \\t]*)?([=\\-_~*#+.]{3,})[ \\t]*$"
            },
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            }
          ]
        },
        {
          "name": "comment.block.banner.vri",
          "contentName": "comment.block.banner.content.vri",
          "begin": "\\A(?:#![^\\n]*\\n)?[ \\t]*(##)[ \\t]*\\n?",
          "end": "##",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.banner.vri"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.banner.vri"
            }
          },
          "patterns": [
            {
              "name": "comment.block.banner.rule.vri",
              "match": "^[ \\t]*(?:\\*[ \\t]*)?([=\\-_~*#+.]{3,})[ \\t]*$"
            },
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            }
          ]
        },
        {
          "name": "meta.banner.leading-blank.vri",
          "begin": "\\A(?:#![^\\n]*)?[ \\t]*$",
          "end": "(?<=##)|(?<=#\\*#)|^(?![ \\t]*$)",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "name": "comment.block.banner.vri",
              "contentName": "comment.block.banner.content.vri",
              "begin": "^[ \\t]*(#\\*#)[ \\t]*\\n?",
              "end": "#\\*#",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.comment.banner.vri"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.banner.vri"
                }
              },
              "patterns": [
                {
                  "name": "comment.block.banner.rule.vri",
                  "match": "^[ \\t]*(?:\\*[ \\t]*)?([=\\-_~*#+.]{3,})[ \\t]*$"
                },
                {
                  "name": "keyword.other.todo.vri",
                  "match": "\\bTODO\\b"
                },
                {
                  "name": "keyword.other.fixme.vri",
                  "match": "\\bFIXME\\b"
                },
                {
                  "name": "keyword.other.note.vri",
                  "match": "\\bNOTE\\b"
                }
              ]
            },
            {
              "name": "comment.block.banner.vri",
              "contentName": "comment.block.banner.content.vri",
              "begin": "^[ \\t]*(##)[ \\t]*\\n?",
              "end": "##",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.comment.banner.vri"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.banner.vri"
                }
              },
              "patterns": [
                {
                  "name": "comment.block.banner.rule.vri",
                  "match": "^[ \\t]*(?:\\*[ \\t]*)?([=\\-_~*#+.]{3,})[ \\t]*$"
                },
                {
                  "name": "keyword.other.todo.vri",
                  "match": "\\bTODO\\b"
                },
                {
                  "name": "keyword.other.fixme.vri",
                  "match": "\\bFIXME\\b"
                },
                {
                  "name": "keyword.other.note.vri",
                  "match": "\\bNOTE\\b"
                }
              ]
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "include": "#fileBanner"
        },
        {
          "name": "comment.block.hash-star.vri",
          "contentName": "comment.block.hash-star.content.vri",
          "begin": "(#\\*#)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.hash-star.vri"
            }
          },
          "end": "(#\\*#)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.comment.hash-star.vri"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.block.double-hash.vri",
          "contentName": "comment.block.double-hash.content.vri",
          "begin": "(##)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.double-hash.vri"
            }
          },
          "end": "(##)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.comment.double-hash.vri"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.block.vri",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.vri",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.vri",
          "begin": "#(?![*#])",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.todo.vri",
              "match": "\\bTODO\\b"
            },
            {
              "name": "keyword.other.fixme.vri",
              "match": "\\bFIXME\\b"
            },
            {
              "name": "keyword.other.note.vri",
              "match": "\\bNOTE\\b"
            },
            {
              "name": "keyword.other.optimize.vri",
              "match": "\\bOPTIMIZE\\b"
            },
            {
              "name": "keyword.other.virnn.vri",
              "match": "\\bVIRNN\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vri",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vri",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<=[:=,(\\[])\\s*(-\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)",
          "captures": {
            "1": {
              "name": "constant.numeric.vri"
            }
          }
        },
        {
          "name": "constant.numeric.vri",
          "match": "\\b(?:\\d+\\.\\d+|\\d+)(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.vri",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "meta.annotation.vri",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.vri",
          "match": "\\b(?:entity|func|enum|var|let|const|method|class|type|extern|struct|record|packed|register)\\b"
        },
        {
          "name": "keyword.control.secondary.vri",
          "match": "\\b(?:in|out)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.import.vri",
          "match": "\\b(?:import|export|get|from)\\b"
        },
        {
          "name": "keyword.control.include.vri",
          "match": "\\binclude\\b"
        },
        {
          "name": "keyword.control.async.vri",
          "match": "\\b(?:async|await|task|wait|cancel|send|recv|select|pass|timeout|resume|emit|isolate)\\b"
        },
        {
          "name": "keyword.control.terminator.vri",
          "match": "\\bend\\b"
        },
        {
          "name": "keyword.control.vri",
          "match": "\\b(?:if|eif|elif|else|for|while|when|loop|do|then|case|break|skip|continue|return|ensure|revert|try|has|share)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tensor.vri",
          "match": "\\b(?:Matrix|Vector|tensor|Tensor|flux)\\b"
        },
        {
          "name": "storage.type.generic.vri",
          "match": "\\b(?:Option|Result|Vec|Map)\\b"
        },
        {
          "name": "storage.type.scalar.vri",
          "match": "\\b(?:int|float|bool|string|i64|i32|i16|i8|u64|u32|u16|u8|f32|f64|void|none)\\b"
        }
      ]
    },
    "aiOps": {
      "patterns": [
        {
          "name": "support.function.ai.matmul.vri",
          "match": "\\bmatmul\\b"
        },
        {
          "name": "support.function.ai.grad.vri",
          "match": "\\bgrad\\b"
        },
        {
          "name": "support.function.ai.embed.vri",
          "match": "\\bembed\\b"
        },
        {
          "name": "support.function.ai.train.vri",
          "match": "\\btrain\\b"
        }
      ]
    },
    "systemOps": {
      "patterns": [
        {
          "name": "keyword.operator.word.vri",
          "match": "\\b(?:and|or|xor|not|shl|shr|mod|bit_and|bit_or|bit_xor|bit_shl|bit_shr)\\b"
        }
      ]
    },
    "intrinsicsGradeS": {
      "patterns": [
        {
          "name": "support.function.intrinsic.grade-s.simd.vri",
          "match": "\\b(?:simd_add|simd_sub|simd_mul|simd_fma|simd_div|simd_load|simd_store|simd_splat|simd_reduce_sum|simd_min|simd_max)\\b"
        },
        {
          "name": "support.function.intrinsic.grade-s.matmul.vri",
          "match": "\\bmatmul\\b"
        },
        {
          "name": "support.function.intrinsic.grade-s.kernel.vri",
          "match": "\\b(?:neon_gemm|neon_add|neon_mul|neon_fmla|avx_add|avx_mul|avx_fma)\\b"
        }
      ]
    },
    "returnArrow": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.vri",
          "match": "->"
        }
      ]
    },
    "shape": {
      "patterns": [
        {
          "name": "meta.tensor.shape.bracket.vri",
          "begin": "(?:(:)\\s*|\\b(var|let|const)\\s+|(?<=->)\\s*)?\\b(tensor|Tensor)\\s*(\\[)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.type.vri"
            },
            "2": {
              "name": "keyword.declaration.vri"
            },
            "3": {
              "name": "storage.type.tensor.vri"
            },
            "4": {
              "name": "punctuation.section.tensor.shape.begin.vri"
            }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.tensor.shape.end.vri"
            }
          },
          "patterns": [
            {
              "include": "#tensorShapeInterior"
            }
          ]
        },
        {
          "name": "meta.tensor.shape.angle.vri",
          "begin": "(?:(:)\\s*|\\b(var|let|const)\\s+|(?<=->)\\s*)?\\b(Matrix|Vector|flux)\\s*(<)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.type.vri"
            },
            "2": {
              "name": "keyword.declaration.vri"
            },
            "3": {
              "name": "storage.type.tensor.vri"
            },
            "4": {
              "name": "punctuation.section.tensor.shape.begin.vri"
            }
          },
          "end": "(>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.tensor.shape.end.vri"
            }
          },
          "patterns": [
            {
              "include": "#tensorShapeInterior"
            }
          ]
        }
      ]
    },
    "tensorShapeInterior": {
      "patterns": [
        {
          "name": "punctuation.separator.tensor.shape.vri",
          "match": "[;,]"
        },
        {
          "name": "constant.numeric.dimension.vri",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "storage.type.tensor.element.vri",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f16|f32|f64|int|float|bool)\\b"
        }
      ]
    },
    "moduleDecl": {
      "patterns": [
        {
          "name": "meta.module.declaration.vri",
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.module.vri"
            },
            "2": {
              "name": "entity.name.namespace.module.vri"
            }
          }
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "name": "meta.generic.instantiation.vri",
          "begin": "\\b(of)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.generic.of.vri"
            },
            "2": {
              "name": "punctuation.section.generic.begin.vri"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.generic.end.vri"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.vri",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.generic.vri",
              "match": ","
            },
            {
              "include": "#types"
            }
          ]
        },
        {
          "name": "meta.generic.call.after-of.vri",
          "match": "\\bof\\s*\\([^)]*\\)\\s*(\\(\\))",
          "captures": {
            "1": {
              "name": "punctuation.section.generic.call.vri"
            }
          }
        },
        {
          "name": "meta.generic.func.empty.vri",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\(\\))",
          "captures": {
            "1": {
              "name": "keyword.declaration.vri"
            },
            "2": {
              "name": "entity.name.function.vri"
            },
            "3": {
              "name": "punctuation.section.generic.call.vri"
            }
          }
        }
      ]
    },
    "ufcs": {
      "patterns": [
        {
          "name": "meta.function-call.ufcs.vri",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.ufcs.dot.vri"
            },
            "2": {
              "name": "support.function.ufcs.vri"
            }
          }
        }
      ]
    },
    "operatorsUnified": {
      "patterns": [
        {
          "name": "keyword.operator.vri",
          "match": ">>|>=|<=|==|!=|\\^|\\$|><|\\*\\*|\\+|\\-(?![>\\d])|\\*|/|%|:~|<(?!=)|=(?!=)|\\||&|(?<!-)>"
        }
      ]
    },
    "functionDecl": {
      "patterns": [
        {
          "name": "meta.function.vri",
          "match": "\\bfunc\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.vri"
            }
          }
        }
      ]
    },
    "params": {
      "patterns": [
        {
          "name": "meta.parameters.vri",
          "match": "\\b(?:in|out)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.parameter.vri"
            }
          }
        }
      ]
    },
    "typeReferences": {
      "patterns": [
        {
          "name": "meta.type.annotation.tensor.vri",
          "match": "(?:(:)|(?<=->))\\s*\\b(Matrix|Vector|tensor|Tensor|flux)\\b",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.vri"
            },
            "2": {
              "name": "storage.type.tensor.vri"
            }
          }
        },
        {
          "name": "meta.type.annotation.vri",
          "match": "(?<=->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.vri"
            }
          }
        },
        {
          "name": "meta.type.annotation.vri",
          "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.vri"
            },
            "2": {
              "name": "entity.name.type.vri"
            }
          }
        }
      ]
    },
    "variableDecl": {
      "patterns": [
        {
          "name": "meta.variable.declaration.vri",
          "match": "\\bvar\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "forVariable": {
      "patterns": [
        {
          "name": "meta.variable.loop.vri",
          "match": "\\bfor\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "assignmentLhs": {
      "patterns": [
        {
          "name": "meta.assignment.lhs.vri",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*=(?!=))",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.vri"
            }
          }
        }
      ]
    },
    "entityName": {
      "patterns": [
        {
          "name": "meta.entity.vri",
          "match": "\\bentity\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.vri"
            }
          }
        }
      ]
    },
    "matrixPunctuation": {
      "patterns": [
        {
          "name": "punctuation.section.matrix.vri",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.separator.matrix.vri",
          "match": ","
        }
      ]
    }
  }
}