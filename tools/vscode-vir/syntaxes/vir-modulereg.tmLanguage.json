{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vir Module Registry",
  "scopeName": "source.vir-modulereg",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#assignments"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.registry.vri",
          "match": "#.*$"
        }
      ]
    },
    "assignments": {
      "patterns": [
        {
          "name": "meta.registry.assignment.vri",
          "match": "^\\s*(root)\\s*(=)\\s*(\\S+)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.registry.root.vri"
            },
            "2": {
              "name": "punctuation.separator.key-value.registry.vri"
            },
            "3": {
              "name": "constant.language.registry.root-value.vri"
            }
          }
        },
        {
          "name": "meta.registry.assignment.vri",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*(=)\\s*(\\S+)\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.tag.module-key.registry.vri"
            },
            "2": {
              "name": "punctuation.separator.key-value.registry.vri"
            },
            "3": {
              "name": "string.unquoted.path.registry.vri",
              "patterns": [
                {
                  "name": "constant.language.file-extension.vri",
                  "match": "\\.vri$"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
