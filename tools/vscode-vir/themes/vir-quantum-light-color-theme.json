{
  "name": "Vir Quantum Light",
  "type": "light",
  "colors": {},
  "tokenColors": [
    {
      "name": "Vir Block Comments (fallback)",
      "scope": [
        "comment.block.hash-star.content.vri",
        "comment.block.double-hash.content.vri",
        "punctuation.definition.comment.hash-star.vri",
        "punctuation.definition.comment.double-hash.vri",
        "comment.block.hash-star.vri",
        "comment.block.double-hash.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri",
        "comment.vri"
      ],
      "settings": {
        "foreground": "#50835E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Tensor Type (AI/ML)",
      "scope": [
        "storage.type.tensor.vri"
      ],
      "settings": {
        "foreground": "#00796B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Tensor Shape Delimiters",
      "scope": [
        "punctuation.section.tensor.shape.begin.vri",
        "punctuation.section.tensor.shape.end.vri",
        "punctuation.separator.tensor.shape.vri"
      ],
      "settings": {
        "foreground": "#00695C"
      }
    },
    {
      "name": "Vir Tensor Element Type",
      "scope": [
        "storage.type.tensor.element.vri"
      ],
      "settings": {
        "foreground": "#2E8B7A"
      }
    },
    {
      "name": "Vir Tensor Shape Dimensions",
      "scope": [
        "constant.numeric.dimension.vri"
      ],
      "settings": {
        "foreground": "#00897B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.arrow.vri"
      ],
      "settings": {
        "foreground": "#4D7C0F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "comment.block.banner.vri",
        "comment.block.banner.content.vri"
      ],
      "settings": {
        "foreground": "#155E75",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.comment.banner.vri",
        "comment.block.banner.rule.vri"
      ],
      "settings": {
        "foreground": "#0E7490",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "tensorType": {
      "foreground": "#00796B",
      "fontStyle": "bold"
    },
    "shapeDimension": {
      "foreground": "#00897B",
      "fontStyle": "bold"
    },
    "shape": "#00695C",
    "returnArrow": {
      "foreground": "#4D7C0F",
      "fontStyle": "bold"
    },
    "bannerTitle": {
      "foreground": "#164E63",
      "fontStyle": "bold"
    },
    "moduleName.active": "#B45309",
    "moduleName.inactive": "#7A5C48",
    "function.active": "#B45309",
    "function.inactive": "#7A5C48",
    "type.active": "#B45309",
    "type.inactive": "#7A5C48",
    "constant.active": "#B45309",
    "constant.inactive": "#7A5C48",
    "importedSymbol.active": "#B45309",
    "importedSymbol.inactive": "#7A5C48"
  }
}
