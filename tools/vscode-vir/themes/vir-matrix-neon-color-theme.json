{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vir Matrix Neon",
  "type": "dark",
  "colors": {
    "editor.background": "#050816",
    "editor.foreground": "#E6EDF7",
    "editor.lineHighlightBackground": "#101735",
    "editor.selectionBackground": "#1D2A54",
    "editorError.foreground": "#FF5370",
    "editorWarning.foreground": "#FFB020",
    "editorInfo.foreground": "#38BDF8",
    "sideBar.background": "#0A1024",
    "panel.background": "#0A1024",
    "activityBar.background": "#0A1024",
    "statusBar.background": "#0A1024",
    "statusBar.foreground": "#E6EDF7"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": "keyword.declaration.vri",
      "settings": { "foreground": "#3B82F6" }
    },
    {
      "scope": ["keyword.control.vri", "keyword.control.secondary.vri"],
      "settings": { "foreground": "#C792EA" }
    },
    {
      "scope": "keyword.control.import.vri",
      "settings": { "foreground": "#EA580C" }
    },
    {
      "scope": "keyword.control.include.vri",
      "settings": { "foreground": "#B91C1C" }
    },
    {
      "scope": "keyword.control.async.vri",
      "settings": { "foreground": "#A855F7" }
    },
    {
      "scope": "keyword.control.terminator.vri",
      "settings": { "foreground": "#8A5AB8", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.function.vri",
      "settings": { "foreground": "#82AAFF" }
    },
    {
      "scope": "entity.name.type.vri",
      "settings": { "foreground": "#4FC1FF" }
    },
    {
      "scope": ["storage.type.tensor.vri", "storage.type.scalar.vri"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "scope": [
        "support.function.ai.matmul.vri",
        "support.function.ai.embed.vri",
        "support.function.ai.train.vri",
        "support.function.ai.grad.vri"
      ],
      "settings": { "foreground": "#F97316" }
    },
    {
      "scope": [
        "support.function.intrinsic.grade-s.simd.vri",
        "support.function.intrinsic.grade-s.matmul.vri",
        "support.function.intrinsic.grade-s.kernel.vri"
      ],
      "settings": { "foreground": "#FF2D6F", "fontStyle": "bold" }
    },
    {
      "scope": "constant.numeric.vri",
      "settings": { "foreground": "#9EFFA1" }
    },
    {
      "scope": "string.quoted.double.vri",
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": [
        "keyword.operator.vri",
        "keyword.operator.word.vri",
        "keyword.operator.power.vri",
        "keyword.operator.math-context.vri",
        "keyword.operator.cast.vri",
        "support.function.system.xor.vri",
        "support.function.system.shift.vri"
      ],
      "settings": { "foreground": "#89DDFF" }
    },
    {
      "scope": [
        "comment.block.vri",
        "comment.block.hash-star.vri",
        "comment.block.double-hash.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri"
      ],
      "settings": { "foreground": "#22C55E", "fontStyle": "italic" }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#C792EA",
    "importKeyword": "#EA580C",
    "includeKeyword": "#B91C1C",
    "asyncKeyword": "#A855F7",
    "terminatorKeyword": {
      "foreground": "#8A5AB8",
      "fontStyle": "bold"
    },
    "function": "#82AAFF",
    "type": "#FFD700",
    "number": "#9EFFA1",
    "string": "#FFB86C",
    "operator": "#89DDFF",
    "aiOp": "#F97316",
    "systemOp": "#89DDFF",
    "tensorType": "#FFD700",
    "shape": "#22C55E",
    "comment": "#22C55E"
  }
}
