{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vir Quantum Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0B1020",
    "editor.foreground": "#E6EDF7",
    "editorLineNumber.foreground": "#475569",
    "editorLineNumber.activeForeground": "#94A3B8",
    "editor.lineHighlightBackground": "#161D33",
    "editor.selectionBackground": "#22304F",
    "editor.inactiveSelectionBackground": "#1A2640",
    "editorCursor.foreground": "#E6EDF7",
    "editorWhitespace.foreground": "#2B364E",
    "editorIndentGuide.background1": "#1F2A44",
    "editorIndentGuide.activeBackground1": "#344566",
    "editorError.foreground": "#FF5370",
    "editorWarning.foreground": "#FFB020",
    "editorInfo.foreground": "#38BDF8",
    "editorHint.foreground": "#8B9BB4",
    "editorGutter.modifiedBackground": "#38BDF8",
    "editorGutter.addedBackground": "#22C55E",
    "editorGutter.deletedBackground": "#EF4444",
    "sideBar.background": "#11172A",
    "activityBar.background": "#11172A",
    "panel.background": "#11172A",
    "statusBar.background": "#11172A",
    "statusBar.foreground": "#E6EDF7",
    "titleBar.activeBackground": "#11172A",
    "titleBar.activeForeground": "#E6EDF7"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Vir Declaration Keywords",
      "scope": [
        "keyword.declaration.vri"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "name": "Vir Control Keywords",
      "scope": [
        "keyword.control.vri"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Vir Secondary Keywords",
      "scope": [
        "keyword.control.secondary.vri"
      ],
      "settings": {
        "foreground": "#60A5FA"
      }
    },
    {
      "name": "Vir Import Export Get",
      "scope": [
        "keyword.control.import.vri"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "name": "Vir Include",
      "scope": [
        "keyword.control.include.vri"
      ],
      "settings": {
        "foreground": "#B91C1C"
      }
    },
    {
      "name": "Vir Async Keywords",
      "scope": [
        "keyword.control.async.vri"
      ],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "name": "Vir End Terminator",
      "scope": [
        "keyword.control.terminator.vri"
      ],
      "settings": {
        "foreground": "#7A4FA0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Scalar Types",
      "scope": [
        "storage.type.scalar.vri"
      ],
      "settings": {
        "foreground": "#EBCB8B"
      }
    },
    {
      "name": "Vir Function Names",
      "scope": [
        "entity.name.function.vri"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Vir Entity Names",
      "scope": [
        "entity.name.type.vri"
      ],
      "settings": {
        "foreground": "#4FC1FF"
      }
    },
    {
      "name": "Vir Parameters",
      "scope": [
        "variable.parameter.vri"
      ],
      "settings": {
        "foreground": "#F8C555"
      }
    },
    {
      "name": "Vir AI Ops",
      "scope": [
        "support.function.ai.matmul.vri",
        "support.function.ai.embed.vri",
        "support.function.ai.train.vri",
        "support.function.ai.grad.vri"
      ],
      "settings": {
        "foreground": "#F97316"
      }
    },
    {
      "name": "Vir Grade S Intrinsics (SIMD/NEON/AVX)",
      "scope": [
        "support.function.intrinsic.grade-s.simd.vri",
        "support.function.intrinsic.grade-s.matmul.vri",
        "support.function.intrinsic.grade-s.kernel.vri"
      ],
      "settings": {
        "foreground": "#FF2D6F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Operator Keywords",
      "scope": [
        "keyword.operator.word.vri",
        "support.function.system.xor.vri",
        "support.function.system.shift.vri"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Vir Numbers",
      "scope": [
        "constant.numeric.vri"
      ],
      "settings": {
        "foreground": "#A6E3A1"
      }
    },
    {
      "name": "Vir Strings",
      "scope": [
        "string.quoted.double.vri"
      ],
      "settings": {
        "foreground": "#F2A97F"
      }
    },
    {
      "name": "Vir Boolean Literals",
      "scope": [
        "constant.language.boolean.vri"
      ],
      "settings": {
        "foreground": "#8BD5CA"
      }
    },
    {
      "name": "Vir Generic Of",
      "scope": [
        "keyword.other.generic.of.vri"
      ],
      "settings": {
        "foreground": "#E879F9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Generic Punctuation",
      "scope": [
        "punctuation.section.generic.begin.vri",
        "punctuation.section.generic.end.vri",
        "punctuation.section.generic.call.vri",
        "punctuation.separator.generic.vri"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "name": "Vir Generic Type Params",
      "scope": [
        "entity.name.type.parameter.vri",
        "storage.type.generic.vri"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Vir UFCS Calls",
      "scope": [
        "support.function.ufcs.vri",
        "keyword.operator.ufcs.dot.vri"
      ],
      "settings": {
        "foreground": "#93C5FD"
      }
    },
    {
      "name": "Vir Module Declaration",
      "scope": [
        "keyword.declaration.module.vri"
      ],
      "settings": {
        "foreground": "#FB923C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Module Namespace",
      "scope": [
        "entity.name.namespace.module.vri"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Block Comment Delimiters",
      "scope": [
        "punctuation.definition.comment.hash-star.vri",
        "punctuation.definition.comment.double-hash.vri"
      ],
      "settings": {
        "foreground": "#3B7E54",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Hash-Star Block Body",
      "scope": [
        "comment.block.hash-star.content.vri"
      ],
      "settings": {
        "foreground": "#3A6F4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Double-Hash Block Body",
      "scope": [
        "comment.block.double-hash.content.vri"
      ],
      "settings": {
        "foreground": "#3A6F4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Module Registry",
      "scope": [
        "comment.line.registry.vri"
      ],
      "settings": {
        "foreground": "#64748B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Registry Module Keys",
      "scope": [
        "entity.name.tag.module-key.registry.vri"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Vir Registry Paths",
      "scope": [
        "string.unquoted.path.registry.vri"
      ],
      "settings": {
        "foreground": "#F2A97F"
      }
    },
    {
      "name": "Vir Registry Root",
      "scope": [
        "keyword.other.registry.root.vri",
        "constant.language.registry.root-value.vri"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Registry Separators",
      "scope": [
        "punctuation.separator.key-value.registry.vri"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "name": "Vir Operators",
      "scope": [
        "keyword.operator.vri",
        "keyword.operator.power.vri",
        "keyword.operator.cast.vri",
        "keyword.operator.math-context.vri",
        "keyword.operator.word.vri"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Vir Matrix Punctuation",
      "scope": [
        "punctuation.section.matrix.vri"
      ],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "Vir Matrix Separators",
      "scope": [
        "punctuation.separator.matrix.vri"
      ],
      "settings": {
        "foreground": "#526077"
      }
    },
    {
      "name": "Vir Shape Angle Brackets",
      "scope": [
        "punctuation.definition.typeparameters.begin.vri",
        "punctuation.definition.typeparameters.end.vri"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Vir Metadata",
      "scope": [
        "meta.annotation.vri"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Vir Comments",
      "scope": [
        "comment.vri",
        "comment.block.vri",
        "comment.block.hash-star.vri",
        "comment.block.double-hash.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri",
        "comment.block.documentation.vri"
      ],
      "settings": {
        "foreground": "#3A6F4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Doc Comments",
      "scope": [
        "comment.block.documentation.vri"
      ],
      "settings": {
        "foreground": "#3A6F4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir TODO",
      "scope": [
        "keyword.other.todo.vri"
      ],
      "settings": {
        "foreground": "#F59E0B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir FIXME",
      "scope": [
        "keyword.other.fixme.vri"
      ],
      "settings": {
        "foreground": "#EF4444",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir NOTE",
      "scope": [
        "keyword.other.note.vri"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir OPTIMIZE",
      "scope": [
        "keyword.other.optimize.vri",
        "keyword.other.virnn.vri"
      ],
      "settings": {
        "foreground": "#22C55E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Tensor Type (AI/ML)",
      "scope": [
        "storage.type.tensor.vri"
      ],
      "settings": {
        "foreground": "#00F5D4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Tensor Shape Delimiters",
      "scope": [
        "punctuation.section.tensor.shape.begin.vri",
        "punctuation.section.tensor.shape.end.vri",
        "punctuation.separator.tensor.shape.vri"
      ],
      "settings": {
        "foreground": "#0EA5A0"
      }
    },
    {
      "name": "Vir Tensor Element Type",
      "scope": [
        "storage.type.tensor.element.vri"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "name": "Vir Tensor Shape Dimensions",
      "scope": [
        "constant.numeric.dimension.vri"
      ],
      "settings": {
        "foreground": "#2DD4BF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.arrow.vri"
      ],
      "settings": {
        "foreground": "#BEF264",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "comment.block.banner.vri",
        "comment.block.banner.content.vri"
      ],
      "settings": {
        "foreground": "#B5EDFF",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.comment.banner.vri",
        "comment.block.banner.rule.vri"
      ],
      "settings": {
        "foreground": "#67E8F9",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#C792EA",
    "importKeyword": "#EA580C",
    "includeKeyword": "#B91C1C",
    "asyncKeyword": "#A855F7",
    "terminatorKeyword": {
      "foreground": "#7A4FA0",
      "fontStyle": "bold"
    },
    "function": "#82AAFF",
    "type": "#FFD166",
    "number": "#A6E3A1",
    "string": "#F2A97F",
    "operator": "#89DDFF",
    "aiOp": "#F97316",
    "systemOp": "#89DDFF",
    "gradeSOp": "#FF2D6F",
    "tensorType": {
      "foreground": "#00F5D4",
      "fontStyle": "bold"
    },
    "shape": "#0EA5A0",
    "comment": "#3A6F4F",
    "shapeDimension": {
      "foreground": "#2DD4BF",
      "fontStyle": "bold"
    },
    "returnArrow": {
      "foreground": "#BEF264",
      "fontStyle": "bold"
    },
    "bannerTitle": {
      "foreground": "#D6F6FF",
      "fontStyle": "bold"
    },
    "moduleName.active": "#FFB454",
    "moduleName.inactive": "#92745F",
    "function.active": "#FFB454",
    "function.inactive": "#92745F",
    "type.active": "#FFB454",
    "type.inactive": "#92745F",
    "constant.active": "#FFB454",
    "constant.inactive": "#92745F",
    "importedSymbol.active": "#FFB454",
    "importedSymbol.inactive": "#92745F"
  }
}
