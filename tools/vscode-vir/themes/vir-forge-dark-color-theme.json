{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vir Forge Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#111111",
    "editor.foreground": "#E5E5E5",
    "editor.lineHighlightBackground": "#1B1B1B",
    "editor.selectionBackground": "#2D2D2D",
    "editorError.foreground": "#FF5370",
    "editorWarning.foreground": "#FFB020",
    "editorInfo.foreground": "#61AFEF",
    "sideBar.background": "#161616",
    "panel.background": "#161616",
    "activityBar.background": "#161616",
    "statusBar.background": "#161616",
    "statusBar.foreground": "#E5E5E5"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": [
        "keyword.declaration.vri"
      ],
      "settings": {
        "foreground": "#3B82F6"
      }
    },
    {
      "scope": [
        "keyword.control.vri",
        "keyword.control.secondary.vri"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": [
        "keyword.control.import.vri"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "scope": [
        "keyword.control.include.vri"
      ],
      "settings": {
        "foreground": "#B91C1C"
      }
    },
    {
      "scope": [
        "keyword.control.async.vri"
      ],
      "settings": {
        "foreground": "#A855F7"
      }
    },
    {
      "scope": [
        "keyword.control.terminator.vri"
      ],
      "settings": {
        "foreground": "#8E5FA8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.vri"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "scope": [
        "entity.name.type.vri"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "storage.type.scalar.vri"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "support.function.ai.matmul.vri",
        "support.function.ai.embed.vri",
        "support.function.ai.train.vri",
        "support.function.ai.grad.vri"
      ],
      "settings": {
        "foreground": "#F97316"
      }
    },
    {
      "scope": [
        "support.function.intrinsic.grade-s.simd.vri",
        "support.function.intrinsic.grade-s.matmul.vri",
        "support.function.intrinsic.grade-s.kernel.vri"
      ],
      "settings": {
        "foreground": "#FF2D6F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric.vri"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "scope": [
        "string.quoted.double.vri"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "keyword.other.generic.of.vri",
        "punctuation.section.generic.begin.vri",
        "punctuation.section.generic.end.vri",
        "punctuation.section.generic.call.vri"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "scope": [
        "support.function.ufcs.vri",
        "keyword.operator.ufcs.dot.vri"
      ],
      "settings": {
        "foreground": "#7FB3D5"
      }
    },
    {
      "scope": [
        "keyword.declaration.module.vri"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.namespace.module.vri"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.hash-star.content.vri",
        "comment.block.double-hash.content.vri",
        "punctuation.definition.comment.hash-star.vri",
        "punctuation.definition.comment.double-hash.vri",
        "comment.block.hash-star.vri",
        "comment.block.double-hash.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri"
      ],
      "settings": {
        "foreground": "#3A6F4F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.line.registry.vri",
        "entity.name.tag.module-key.registry.vri",
        "string.unquoted.path.registry.vri"
      ],
      "settings": {
        "foreground": "#5C6370",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator.vri",
        "keyword.operator.word.vri",
        "keyword.operator.power.vri",
        "keyword.operator.math-context.vri",
        "keyword.operator.cast.vri",
        "support.function.system.xor.vri",
        "support.function.system.shift.vri"
      ],
      "settings": {
        "foreground": "#ABB2BF"
      }
    },
    {
      "scope": [
        "comment.block.vri",
        "comment.block.hash-star.vri",
        "comment.block.double-hash.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri"
      ],
      "settings": {
        "foreground": "#45CE78",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Tensor Type (AI/ML)",
      "scope": [
        "storage.type.tensor.vri"
      ],
      "settings": {
        "foreground": "#00F5D4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Tensor Shape Delimiters",
      "scope": [
        "punctuation.section.tensor.shape.begin.vri",
        "punctuation.section.tensor.shape.end.vri",
        "punctuation.separator.tensor.shape.vri"
      ],
      "settings": {
        "foreground": "#0EA5A0"
      }
    },
    {
      "name": "Vir Tensor Element Type",
      "scope": [
        "storage.type.tensor.element.vri"
      ],
      "settings": {
        "foreground": "#A7F3D0"
      }
    },
    {
      "name": "Vir Tensor Shape Dimensions",
      "scope": [
        "constant.numeric.dimension.vri"
      ],
      "settings": {
        "foreground": "#2DD4BF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.arrow.vri"
      ],
      "settings": {
        "foreground": "#BEF264",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "comment.block.banner.vri",
        "comment.block.banner.content.vri"
      ],
      "settings": {
        "foreground": "#B5EDFF",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.comment.banner.vri",
        "comment.block.banner.rule.vri"
      ],
      "settings": {
        "foreground": "#67E8F9",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#C586C0",
    "importKeyword": "#EA580C",
    "includeKeyword": "#B91C1C",
    "asyncKeyword": "#A855F7",
    "terminatorKeyword": {
      "foreground": "#8E5FA8",
      "fontStyle": "bold"
    },
    "function": "#61AFEF",
    "type": "#E5C07B",
    "number": "#98C379",
    "string": "#D19A66",
    "operator": "#ABB2BF",
    "aiOp": "#F97316",
    "systemOp": "#ABB2BF",
    "tensorType": {
      "foreground": "#00F5D4",
      "fontStyle": "bold"
    },
    "shape": "#0EA5A0",
    "comment": "#3A6F4F",
    "shapeDimension": {
      "foreground": "#2DD4BF",
      "fontStyle": "bold"
    },
    "returnArrow": {
      "foreground": "#BEF264",
      "fontStyle": "bold"
    },
    "bannerTitle": {
      "foreground": "#D6F6FF",
      "fontStyle": "bold"
    },
    "moduleName.active": "#FFB454",
    "moduleName.inactive": "#92745F",
    "function.active": "#FFB454",
    "function.inactive": "#92745F",
    "type.active": "#FFB454",
    "type.inactive": "#92745F",
    "constant.active": "#FFB454",
    "constant.inactive": "#92745F",
    "importedSymbol.active": "#FFB454",
    "importedSymbol.inactive": "#92745F"
  }
}
