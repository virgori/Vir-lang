{
  "Vir Entity": {
    "prefix": "entity",
    "body": [
      "entity ${1:Model} {",
      "    var ${2:weights}: Matrix<${3:128}, ${4:64}>",
      "}"
    ],
    "description": "Create a Vir entity block"
  },
  "Vir Function": {
    "prefix": "func",
    "body": [
      "func ${1:forward}(in ${2:x}: Matrix<${3:32}, ${4:128}>) out ${5:y}: Matrix<${6:32}, ${7:64}> {",
      "    var ${8:w}: Matrix<${4:128}, ${7:64}>",
      "    $5 = matmul(${2:x}, ${8:w})",
      "    return ${5:y}",
      "}"
    ],
    "description": "Create a Vir function with tensor shape"
  },
  "Vir Training Step": {
    "prefix": "train",
    "body": [
      "func ${1:train_step}(in ${2:x}: Matrix<${3:32}, ${4:128}>, in ${5:y_true}: Matrix<${3:32}, ${6:10}>) out ${7:loss}: float {",
      "    var ${8:logits}: Matrix<${3:32}, ${6:10}> = matmul(${2:x}, ${9:w})",
      "    var ${10:g}: Matrix<${4:128}, ${6:10}> = grad(${8:logits})",
      "    train(${9:w}, ${10:g})",
      "    return ${7:loss}",
      "}"
    ],
    "description": "Create a Vir training function skeleton"
  },

  "SIMD Matrix Multiply (Grade S)": {
    "prefix": ["matmul_neon", "simd_matmul", "gemm"],
    "body": [
      "// ⚡ Grade S: NEON-tiled GEMM — 4-wide micro-kernel",
      "func ${1:matmul}(in ${2:a}: Matrix<${3:M}, ${4:K}>, in ${5:b}: Matrix<${4:K}, ${6:N}>) out ${7:c}: Matrix<${3:M}, ${6:N}> {",
      "    // Tile sizes optimized for ARM64 L1D: 8×8×4",
      "    $7 = matmul($2, $5)",
      "    return $7",
      "}"
    ],
    "description": "⚡ Grade S: NEON-tiled matrix multiply using optimized micro-kernel (4-wide FMLA)"
  },
  "SIMD Add (Grade S)": {
    "prefix": ["simd_add", "neon_add", "vec_add"],
    "body": [
      "// ⚡ Grade S: 4-wide SIMD addition (NEON ADD.4S / AVX VADDPS)",
      "var ${1:result}: Vector<${2:N}> = simd_add(${3:a}, ${4:b})"
    ],
    "description": "⚡ Grade S: SIMD 4-wide vector addition — processes 4 elements per cycle"
  },
  "SIMD Multiply (Grade S)": {
    "prefix": ["simd_mul", "neon_mul", "vec_mul"],
    "body": [
      "// ⚡ Grade S: 4-wide SIMD multiply (NEON MUL.4S / AVX VMULPS)",
      "var ${1:result}: Vector<${2:N}> = simd_mul(${3:a}, ${4:b})"
    ],
    "description": "⚡ Grade S: SIMD 4-wide vector multiply — processes 4 elements per cycle"
  },
  "SIMD FMA (Grade S)": {
    "prefix": ["simd_fma", "neon_fma", "fused_multiply_add"],
    "body": [
      "// ⚡ Grade S: Fused multiply-add (NEON FMLA / AVX FMA)",
      "// acc += a * b  — single-cycle on ARM64 NEON",
      "var ${1:acc}: Vector<${2:N}> = simd_fma(${3:acc}, ${4:a}, ${5:b})"
    ],
    "description": "⚡ Grade S: SIMD fused multiply-add — acc += a * b in one instruction"
  },
  "SIMD Load/Store (Grade S)": {
    "prefix": ["simd_load", "neon_load", "vec_load"],
    "body": [
      "// ⚡ Grade S: Aligned 128-bit SIMD load (4×f32)",
      "var ${1:v}: Vector<4> = simd_load(${2:ptr})",
      "// Process...",
      "simd_store(${3:out_ptr}, $1)"
    ],
    "description": "⚡ Grade S: SIMD aligned vector load/store — 128-bit (4×f32) per operation"
  },
  "SIMD Reduce Sum (Grade S)": {
    "prefix": ["simd_reduce", "neon_reduce", "horizontal_sum"],
    "body": [
      "// ⚡ Grade S: Horizontal sum — reduce 4 SIMD lanes to scalar",
      "var ${1:total}: float = simd_reduce_sum(${2:vec})"
    ],
    "description": "⚡ Grade S: SIMD horizontal reduce — sum all 4 vector lanes to one scalar"
  },
  "SIMD Loop Pattern (Grade S)": {
    "prefix": ["simd_loop", "neon_loop", "vec_loop"],
    "body": [
      "// ⚡ Grade S: Auto-vectorized loop — 4× throughput via NEON/AVX",
      "// The compiler vectorizes this loop with SIMD (Phase 6):",
      "//   Main body: ${1:N}/4 vector iterations (4 elements/cycle)",
      "//   Tail: ${1:N}%4 scalar iterations",
      "var ${2:i} = 0",
      "while $2 < ${1:N} {",
      "    ${3:// loop body (add, sub, mul, fma supported)}",
      "    $2 = $2 + 1",
      "}"
    ],
    "description": "⚡ Grade S: Auto-vectorized loop pattern — compiler emits NEON/AVX SIMD"
  },
  "Elementwise NEON Kernel": {
    "prefix": ["elementwise_neon", "ew_kernel"],
    "body": [
      "// ⚡ Grade S: Elementwise operation with NEON 4-wide kernel",
      "func ${1:ew_op}(in ${2:a}: Vector<${3:N}>, in ${4:b}: Vector<${3:N}>) out ${5:c}: Vector<${3:N}> {",
      "    $5 = simd_${6|add,sub,mul,div|}($2, $4)",
      "    return $5",
      "}"
    ],
    "description": "⚡ Grade S: Elementwise operation using NEON 4-wide SIMD kernel"
  },
  "SIMD Min/Max (Grade S)": {
    "prefix": ["simd_minmax", "neon_minmax", "vec_minmax"],
    "body": [
      "// ⚡ Grade S: SIMD min/max — 4-wide comparison per cycle",
      "var ${1:lo}: Vector<${2:N}> = simd_min(${3:a}, ${4:b})",
      "var ${5:hi}: Vector<$2> = simd_max($3, $4)"
    ],
    "description": "⚡ Grade S: SIMD min/max — element-wise min/max with 4× throughput"
  }
}
