{
  "name": "virgori-core",
  "displayName": "Virgori Core",
  "description": "Professional IDE support for Virgori (VIR): grammar, semantic tokens, LSP client framework, and curated dark themes.",
  "version": "3.1.2",
  "publisher": "virgori",
  "author": {
    "name": "Virgori"
  },
  "icon": "assets/Ae4356cf756194929a3164d887ce43092n.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/virgori/vscode-vir-language-support.git"
  },
  "bugs": {
    "url": "https://github.com/virgori/vscode-vir-language-support/issues"
  },
  "homepage": "https://dev.virgori.com",
  "keywords": [
    "vir",
    "vri",
    "sri",
    "sci",
    "vsib",
    "virgori",
    "ai",
    "matrix",
    "language",
    "theme",
    "lsp",
    "semantic-tokens"
  ],
  "files": [
    "out/**",
    "themes/**",
    "syntaxes/**",
    "snippets/**",
    "assets/**",
    "language-configuration.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package",
    "publish": "npm run compile && npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "vir.restartLanguageServer",
        "title": "Virgori: Restart Language Server",
        "category": "Virgori"
      }
    ],
    "configuration": {
      "title": "Virgori",
      "properties": {
        "vir.lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the Virgori LSP server executable. Leave empty to use semantic/fallback providers only."
        },
        "vir.lsp.serverArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Arguments passed to the Virgori LSP server executable."
        },
        "vir.ide.enableFallbackIntellisense": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable built-in hover, completion, and diagnostics providers when no LSP server is configured."
        },
        "vir.semantic.enableEnhanced": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable enhanced semantic tokenization for Virgori source files."
        }
      }
    },
    "languages": [
      {
        "id": "vir",
        "aliases": [
          "Virgori",
          "VIR",
          "vir"
        ],
        "extensions": [
          ".vri",
          ".vri"
        ],
        "icon": {
          "light": "./assets/A978be7097ebe4d28be13c1296a30ffd9E.svg",
          "dark": "./assets/A978be7097ebe4d28be13c1296a30ffd9E.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sri",
        "aliases": [
          "SRI Binary",
          "sri"
        ],
        "extensions": [
          ".sri",
          ".sci",
          ".svi"
        ]
      },
      {
        "id": "vsib",
        "aliases": [
          "VSIB Library",
          "vsib"
        ],
        "extensions": [
          ".vsib"
        ]
      }
    ],
    "grammars": [
      {
        "language": "vir",
        "scopeName": "source.vri",
        "path": "./syntaxes/vir.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vir",
        "path": "./snippets/vir.code-snippets"
      }
    ],
    "themes": [
      {
        "label": "Vir Quantum Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-quantum-dark-color-theme.json"
      },
      {
        "label": "Vir Matrix Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-matrix-neon-color-theme.json"
      },
      {
        "label": "Vir Forge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-forge-dark-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "aiOp",
        "description": "Vir AI and neural operations"
      },
      {
        "id": "importKeyword",
        "description": "Vir import/export/get keywords"
      },
      {
        "id": "terminatorKeyword",
        "description": "Vir block terminator keyword"
      },
      {
        "id": "systemOp",
        "description": "Vir low-level and bitwise operations"
      },
      {
        "id": "tensorType",
        "description": "Vir tensor and vector types"
      },
      {
        "id": "shape",
        "description": "Vir tensor shape metadata"
      },
      {
        "id": "functionCall",
        "description": "Virgori function call sites"
      },
      {
        "id": "functionUnused",
        "description": "Virgori declared functions that are never called in current document"
      },
      {
        "id": "object",
        "description": "Virgori object delimiters"
      },
      {
        "id": "objectProperty",
        "description": "Virgori object property keys"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vir",
        "scopes": {
          "keyword": [
            "keyword.control.vri",
            "keyword.declaration.vri",
            "keyword.control.import.vri",
            "keyword.control.terminator.vri"
          ],
          "importKeyword": [
            "keyword.control.import.vri"
          ],
          "terminatorKeyword": [
            "keyword.control.terminator.vri"
          ],
          "function": [
            "entity.name.function.vri"
          ],
          "functionCall": [
            "meta.function-call.vri",
            "support.function.call.vri"
          ],
          "functionUnused": [
            "entity.name.function.unused.vri"
          ],
          "parameter": [
            "variable.parameter.vri"
          ],
          "variable": [
            "variable.other.readwrite.vri"
          ],
          "object": [
            "meta.object.vri",
            "punctuation.definition.object.vri"
          ],
          "objectProperty": [
            "variable.other.property.vri"
          ],
          "type": [
            "storage.type.scalar.vri",
            "storage.type.tensor.vri",
            "entity.name.type.vri"
          ],
          "tensorType": [
            "storage.type.tensor.vri"
          ],
          "aiOp": [
            "support.function.ai.matmul.vri",
            "support.function.ai.grad.vri",
            "support.function.ai.embed.vri",
            "support.function.ai.train.vri"
          ],
          "systemOp": [
            "support.function.system.xor.vri",
            "support.function.system.shift.vri"
          ],
          "number": [
            "constant.numeric.vri"
          ],
          "string": [
            "string.quoted.double.vri"
          ],
          "operator": [
            "keyword.operator.vri"
          ],
          "shape": [
            "meta.tensor.shape.vri"
          ]
        }
      }
    ]
  }
}
