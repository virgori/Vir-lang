{
  "name": "vir-lang",
  "displayName": "Vir-lang",
  "description": "Professional IDE support for Virgori (VIR): grammar, semantic tokens, LSP client framework, and curated dark themes.",
  "version": "4.7.0",
  "publisher": "VirgoriLabs",
  "author": {
    "name": "Virgori"
  },
  "icon": "assets/virgori-logo-128.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/virgori/vscode-vir-language-support.git"
  },
  "bugs": {
    "url": "https://github.com/virgori/vscode-vir-language-support/issues"
  },
  "homepage": "https://dev.virgori.com",
  "keywords": [
    "vir",
    "vri",
    "sri",
    "sci",
    "vsib",
    "virgori",
    "ai",
    "matrix",
    "language",
    "theme",
    "lsp",
    "semantic-tokens"
  ],
  "files": [
    "out/**",
    "themes/**",
    "syntaxes/**",
    "snippets/**",
    "fileicons/**",
    "assets/virgori-logo-128.png",
    "assets/virgori-file-icon.png",
    "language-configuration.json",
    "language-configuration-modulereg.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vsix": "npm run package",
    "package": "npm run compile && npx @vscode/vsce package --out vir-lang-${npm_package_version}.vsix",
    "publish": "npm run compile && npx @vscode/vsce publish",
    "test": "npm run compile && node test/unit.js && node test/compiler_symbols.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "vir.restartLanguageServer",
        "title": "Virgori: Restart Language Server",
        "category": "Virgori"
      },
      {
        "command": "vir.showVariableLifetime",
        "title": "Vir: Show Variable Lifetime",
        "category": "Virgori"
      },
      {
        "command": "vir.smartBar.autoCompleteHashLength",
        "title": "Smart Bar: Auto-Complete Hash Length",
        "category": "Virgori Smart Bar"
      },
      {
        "command": "vir.smartBar.boxSelection",
        "title": "Smart Bar: Wrap Selection in Box",
        "category": "Virgori Smart Bar"
      },
      {
        "command": "vir.smartBar.toggleFunctionCollapse",
        "title": "Smart Bar: Toggle Function Collapse",
        "category": "Virgori Smart Bar"
      }
    ],
    "keybindings": [
      {
        "command": "vir.smartBar.boxSelection",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "editorTextFocus && editorLangId == vir"
      },
      {
        "command": "vir.smartBar.toggleFunctionCollapse",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorTextFocus && editorLangId == vir"
      }
    ],
    "configuration": {
      "title": "Virgori",
      "properties": {
        "vir.lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the Virgori LSP server executable. Leave empty to use semantic/fallback providers only."
        },
        "vir.lsp.serverArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Arguments passed to the Virgori LSP server executable."
        },
        "vir.ide.enableFallbackIntellisense": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable built-in hover, completion, and diagnostics providers when no LSP server is configured."
        },
        "vir.semantic.enableEnhanced": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable enhanced semantic tokenization for Virgori source files."
        },
        "vir.semantic.lifetime.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show variable lifetime and module include activity from `virc --ide-semantic` (compiler-backed)."
        },
        "vir.semantic.shape.compilerBacked": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `virc --ide-semantic` is available, tag static shape dimension literals with semantic token `shapeDimension` instead of plain `number` (themes may style via `constant.numeric.dimension.vri`)."
        },
        "vir.semantic.lifetime.debounceMs": {
          "type": "number",
          "default": 400,
          "markdownDescription": "Debounce (ms) before re-running IDE semantic analysis after edits."
        },
        "vir.semantic.lifetime.focusOnCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Dim other bindings when the cursor is on a variable (Focus Lifetime)."
        },
        "vir.compiler.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `virc` for IDE semantic analysis. Defaults to `<workspace>/bin/virc`."
        },
        "vir.semantic.symbolState.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Colour module names, functions, types, constants and imported symbols as **active** (`#FFB454`) or **inactive** (`#92745F`). The state is resolved by the Vir compiler (`virc --ide-semantic`); the extension never analyses usage itself. Unresolved symbols are left untouched."
        }
      }
    },
    "languages": [
      {
        "id": "vir",
        "aliases": [
          "Virgori",
          "VIR",
          "vir"
        ],
        "extensions": [
          ".vri"
        ],
        "icon": {
          "light": "./assets/virgori-file-icon.png",
          "dark": "./assets/virgori-file-icon.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "sri",
        "aliases": [
          "SRI Binary",
          "sri"
        ],
        "extensions": [
          ".sri",
          ".sci",
          ".svi"
        ],
        "icon": {
          "light": "./assets/virgori-file-icon.png",
          "dark": "./assets/virgori-file-icon.png"
        }
      },
      {
        "id": "vsib",
        "aliases": [
          "VSIB Library",
          "vsib"
        ],
        "extensions": [
          ".vsib"
        ],
        "icon": {
          "light": "./assets/virgori-file-icon.png",
          "dark": "./assets/virgori-file-icon.png"
        }
      },
      {
        "id": "vir-modulereg",
        "aliases": [
          "Vir Module Registry",
          "Vir stdlib map"
        ],
        "filenames": [
          "stdlib.vri",
          "module.list"
        ],
        "configuration": "./language-configuration-modulereg.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vir-lang-icons",
        "label": "Vir-lang File Icons",
        "path": "./fileicons/vir-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "vir",
        "scopeName": "source.vri",
        "path": "./syntaxes/vir.tmLanguage.json"
      },
      {
        "language": "vir-modulereg",
        "scopeName": "source.vir-modulereg",
        "path": "./syntaxes/vir-modulereg.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vir",
        "path": "./snippets/vir.code-snippets"
      }
    ],
    "themes": [
      {
        "label": "Vir Quantum Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-quantum-dark-color-theme.json"
      },
      {
        "label": "Vir Matrix Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-matrix-neon-color-theme.json"
      },
      {
        "label": "Vir Forge Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vir-forge-dark-color-theme.json"
      },
      {
        "label": "Vir Quantum Light",
        "uiTheme": "vs",
        "path": "./themes/vir-quantum-light-color-theme.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "aiOp",
        "description": "Vir AI and neural operations"
      },
      {
        "id": "importKeyword",
        "description": "Vir import/export/get keywords"
      },
      {
        "id": "includeKeyword",
        "description": "Vir include keyword"
      },
      {
        "id": "asyncKeyword",
        "description": "Vir async/concurrency keywords"
      },
      {
        "id": "terminatorKeyword",
        "description": "Vir block terminator keyword"
      },
      {
        "id": "systemOp",
        "description": "Vir low-level and bitwise operations"
      },
      {
        "id": "tensorType",
        "description": "Vir tensor and vector types"
      },
      {
        "id": "shape",
        "description": "Vir tensor shape metadata"
      },
      {
        "id": "shapeDimension",
        "description": "Compile-time tensor/Matrix/Vector shape dimension literal (IDE/LSP-known)"
      },
      {
        "id": "returnArrow",
        "description": "Vir function/type return arrow `->`"
      },
      {
        "id": "functionCall",
        "description": "Virgori function call sites"
      },
      {
        "id": "object",
        "description": "Virgori object delimiters"
      },
      {
        "id": "objectProperty",
        "description": "Virgori object property keys"
      },
      {
        "id": "bannerTitle",
        "description": "First content line (title) of the file banner"
      },
      {
        "id": "moduleName",
        "description": "Vir module name with compiler-resolved active/inactive state"
      },
      {
        "id": "importedSymbol",
        "description": "Symbol in an import list with compiler-resolved active/inactive state"
      },
      {
        "id": "constant",
        "description": "Vir constant with compiler-resolved active/inactive state"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "vir",
        "scopes": {
          "keyword": [
            "keyword.control.vri",
            "keyword.declaration.vri",
            "keyword.control.import.vri",
            "keyword.control.include.vri",
            "keyword.control.async.vri",
            "keyword.control.terminator.vri"
          ],
          "importKeyword": [
            "keyword.control.import.vri"
          ],
          "includeKeyword": [
            "keyword.control.include.vri"
          ],
          "asyncKeyword": [
            "keyword.control.async.vri"
          ],
          "terminatorKeyword": [
            "keyword.control.terminator.vri"
          ],
          "function": [
            "entity.name.function.vri"
          ],
          "functionCall": [
            "meta.function-call.vri",
            "support.function.call.vri"
          ],
          "parameter": [
            "variable.parameter.vri"
          ],
          "variable": [
            "variable.other.readwrite.vri"
          ],
          "object": [
            "meta.object.vri",
            "punctuation.definition.object.vri"
          ],
          "objectProperty": [
            "variable.other.property.vri"
          ],
          "type": [
            "storage.type.scalar.vri",
            "storage.type.tensor.vri",
            "entity.name.type.vri"
          ],
          "tensorType": [
            "storage.type.tensor.vri"
          ],
          "aiOp": [
            "support.function.ai.matmul.vri",
            "support.function.ai.grad.vri",
            "support.function.ai.embed.vri",
            "support.function.ai.train.vri"
          ],
          "systemOp": [
            "keyword.operator.word.vri",
            "support.function.system.xor.vri",
            "support.function.system.shift.vri"
          ],
          "number": [
            "constant.numeric.vri"
          ],
          "string": [
            "string.quoted.double.vri"
          ],
          "operator": [
            "keyword.operator.vri"
          ],
          "returnArrow": [
            "keyword.operator.arrow.vri"
          ],
          "shape": [
            "meta.tensor.shape.vri"
          ],
          "shapeDimension": [
            "constant.numeric.dimension.vri"
          ],
          "bannerTitle": [
            "comment.block.banner.title.vri"
          ],
          "moduleName": [
            "entity.name.namespace.vri"
          ],
          "importedSymbol": [
            "entity.name.function.imported.vri"
          ],
          "constant": [
            "variable.other.constant.vri"
          ]
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "active",
        "description": "Symbol is used (directly, indirectly, as a callback, or needed by the compilation unit) — compiler-resolved"
      },
      {
        "id": "inactive",
        "description": "Symbol resolves but nothing reachable uses it — compiler-resolved; not a diagnostic"
      }
    ]
  }
}
