func main:
    let v = vec_new();
    print_int(v.len);
    print_str("\n");
    mutate_vec(v);
    print_int(v.len);
    print_str("\n");
    out 0
end.

entity VecTest:
    len: i64
end.

func vec_new:
    out VecTest ( len: 0 )
end.

func mutate_vec:
    in(v: VecTest)
    v.len = 5
end.

extern func print_int(val: i64);
extern func print_str(val: i64);
