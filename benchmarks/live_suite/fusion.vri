func run_fusion(n):
    let sz = n * 8
    let a = alloc(sz)
    let b = alloc(sz)
    let d = alloc(sz)
    let c = alloc(sz)

    var i = 0
    when i < n loop
        let off = i * 8
        write_word(a, off, (i mod 50) + 1)
        write_word(b, off, (i mod 30) + 1)
        write_word(d, off, 100)
        i = i + 1
    end

    var j = 0
    when j < n loop
        let off2 = j * 8
        let val = read_word(a, off2) * read_word(b, off2) - read_word(d, off2)
        var relu = 0
        if val > 0 do
            relu = val
        end
        write_word(c, off2, relu)
        j = j + 1
    end

    out read_word(c, (n / 2) * 8)
end.

func main:
    var iter = 0
    var res = 0
    when iter < 10 loop
        res = run_fusion(1000000)
        iter = iter + 1
    end
    print_str("Fusion Checksum: ")
    print(res)
end.
