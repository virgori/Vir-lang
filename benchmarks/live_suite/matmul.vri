func run_matmul(n):
    let sz = n * n * 8
    let a = alloc(sz)
    let b = alloc(sz)
    let c = alloc(sz)

    var i = 0
    when i < n loop
        var j = 0
        when j < n loop
            let offset = (i * n + j) * 8
            write_word(a, offset, (i + j) % 100)
            write_word(b, offset, (i * j) % 100)
            write_word(c, offset, 0)
            j = j + 1
        end
        i = i + 1
    end

    var i2 = 0
    when i2 < n loop
        var k = 0
        when k < n loop
            let a_ik = read_word(a, (i2 * n + k) * 8)
            var j2 = 0
            when j2 < n loop
                let b_kj = read_word(b, (k * n + j2) * 8)
                let c_offset = (i2 * n + j2) * 8
                let prev_c = read_word(c, c_offset)
                write_word(c, c_offset, prev_c + a_ik * b_kj)
                j2 = j2 + 1
            end
            k = k + 1
        end
        i2 = i2 + 1
    end

    out read_word(c, (n * n - 1) * 8)
end.

func main:
    var iter = 0
    var checksum = 0
    when iter < 10 loop
        checksum = run_matmul(128)
        iter = iter + 1
    end
    print_str("Matmul Checksum: ")
    print(checksum)
end.
