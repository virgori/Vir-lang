/*
 * vir/process/process.vri — Process Spawning & Management
 * =========================================================
 * Inspired by Python: subprocess
 * Inspired by C: fork, exec, waitpid, pipe
 *
 * Dùng cho: chạy external tools, build toolchain.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Process Builder
# ═══════════════════════════════════════════════════════

enum Stdio
    Inherit = 0   # Kế thừa từ parent
    Pipe    = 1   # Capture output
    Null    = 2   # /dev/null
end

entity Command
    program: String
    args:    Vec<String>
    cwd:     Option<String>
    env:     Vec<EnvPair>
    stdin:   Stdio
    stdout:  Stdio
    stderr:  Stdio
end

entity EnvPair
    key: String
    val: String
end

func command_new(program: String) -> Command
    out Command {
        program = program,
        args = vec_new(),
        cwd = None,
        env = vec_new(),
        stdin = Stdio.Inherit,
        stdout = Stdio.Inherit,
        stderr = Stdio.Inherit
    }
end

func command_arg(cmd: &Command, arg: String)
    vec_push(&cmd.args, arg)
end

func command_args(cmd: &Command, args: Vec<String>)
    var i: usize = 0
    lặp_khi i < vec_len(args)
        vec_push(&cmd.args, vec_get(args, i))
        i = i + 1
    end
end

func command_cwd(cmd: &Command, dir: String)
    cmd.cwd = Some(dir)
end

func command_env(cmd: &Command, key: String, val: String)
    vec_push(&cmd.env, EnvPair { key = key, val = val })
end

func command_stdin(cmd: &Command, s: Stdio)
    cmd.stdin = s
end

func command_stdout(cmd: &Command, s: Stdio)
    cmd.stdout = s
end

func command_stderr(cmd: &Command, s: Stdio)
    cmd.stderr = s
end

# ═══════════════════════════════════════════════════════
# Process Output
# ═══════════════════════════════════════════════════════

entity Output
    exit_code: i32
    stdout:    String    # captured if Stdio.Pipe
    stderr:    String    # captured if Stdio.Pipe
end

entity Child
    pid:       i32
    stdin_fd:  Option<i32>   # fd if piped
    stdout_fd: Option<i32>
    stderr_fd: Option<i32>
end

# ═══════════════════════════════════════════════════════
# Execution
# ═══════════════════════════════════════════════════════

func command_spawn(cmd: Command) -> Result<Child, String>
    # Khởi chạy process con, out Child handle.
    var child_pid: i32 = 0
    var stdin_fd: i32 = -1
    var stdout_fd: i32 = -1
    var stderr_fd: i32 = -1
    
    var rc = native_spawn(
        cmd.program.data, cmd.program.byte_len,
        &cmd.args, &cmd.env,
        cmd.cwd,
        cmd.stdin, cmd.stdout, cmd.stderr,
        &child_pid, &stdin_fd, &stdout_fd, &stderr_fd
    )
    
    if rc != 0
        out Err(str_new("spawn failed"))
    end
    
    out Ok(Child {
        pid = child_pid,
        stdin_fd = if stdin_fd >= 0 Some(stdin_fd) else None end,
        stdout_fd = if stdout_fd >= 0 Some(stdout_fd) else None end,
        stderr_fd = if stderr_fd >= 0 Some(stderr_fd) else None end
    })
end

func child_wait(c: &Child) -> Result<i32, String>
    # Chờ process con kết thúc, out exit code.
    var status: i32 = 0
    var rc = native_waitpid(c.pid, &status)
    if rc < 0 out Err(str_new("waitpid failed")) end
    out Ok(status)
end

func child_kill(c: &Child) -> Result<void, String>
    var rc = native_kill(c.pid, 9)   # SIGKILL
    if rc != 0 out Err(str_new("kill failed")) end
    out Ok(void)
end

func command_output(cmd: Command) -> Result<Output, String>
    # Run, chờ kết thúc, capture stdout/stderr.
    var piped = cmd
    piped.stdout = Stdio.Pipe
    piped.stderr = Stdio.Pipe
    
    var child_result = command_spawn(piped)
    chọn child_result
        case Err(e) out Err(e)
        case Ok(child)
            # Đọc stdout
            var stdout_str = str_new("")
            chọn child.stdout_fd
                case Some(fd)
                    stdout_str = native_read_all_fd(fd)
                    native_close(fd)
                case None {}
            end
            
            # Đọc stderr
            var stderr_str = str_new("")
            chọn child.stderr_fd
                case Some(fd)
                    stderr_str = native_read_all_fd(fd)
                    native_close(fd)
                case None {}
            end
            
            var wait_result = child_wait(&child)
            chọn wait_result
                case Err(e) out Err(e)
                case Ok(code)
                    out Ok(Output {
                        exit_code = code,
                        stdout = stdout_str,
                        stderr = stderr_str
                    })
            end
    end
end

func command_status(cmd: Command) -> Result<i32, String>
    # Run, chờ, chỉ lấy exit code.
    var child_result = command_spawn(cmd)
    chọn child_result
        case Err(e) out Err(e)
        case Ok(child) out child_wait(&child)
    end
end

# ─── Convenience ──────────────────────────────────────

func run(program: String, args: Vec<String>) -> Result<Output, String>
    var cmd = command_new(program)
    command_args(&cmd, args)
    out command_output(cmd)
end

func shell(script: String) -> Result<Output, String>
    # Chạy qua /bin/sh -c "script"
    var cmd = command_new(str_new("/bin/sh"))
    command_arg(&cmd, str_new("-c"))
    command_arg(&cmd, script)
    out command_output(cmd)
end
