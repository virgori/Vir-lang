/*
 * vir/lsp/lsp.vri — Language Server Protocol (stub)
 * ====================================================
 * Phase D — IDE support for Vir
 *
 * Implements LSP JSON-RPC over stdio
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_concat
import "vir/collections/vec" use Vec, vec_new, vec_push
import "vir/collections/map" use Map, map_new, map_set
import "vir/json/json" use JsonValue, json_object, json_string, json_number, json_array, json_null, json_to_string
import "vir/io/stdio" use read_line, eprint

# ═══════════════════════════════════════════════════════
# LSP Types
# ═══════════════════════════════════════════════════════

entity Position
    line:      u32
    character: u32
end

entity Range
    start: Position
    end:   Position
end

entity Location
    uri:   String
    range: Range
end

enum DiagnosticSeverity
    Error       = 1
    Warning     = 2
    Information = 3
    Hint        = 4
end

entity Diagnostic
    range:    Range
    severity: DiagnosticSeverity
    message:  String
    source:   String
end

entity CompletionItem
    label:  String
    kind:   i32       # 1=Text, 2=Method, 3=Function, 6=Variable, 7=Class, ...
    detail: String
end

# ═══════════════════════════════════════════════════════
# JSON-RPC Message
# ═══════════════════════════════════════════════════════

entity RpcMessage
    jsonrpc: String    # "2.0"
    id:      Option<i64>
    method:  Option<String>
    params:  JsonValue
end

func rpc_response(id: i64, result: JsonValue) -> JsonValue
    var obj = map_new()
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")))
    map_set(&obj, str_new("id"), json_number(id))
    map_set(&obj, str_new("result"), result)
    out json_object(obj)
end

func rpc_error(id: i64, code: i64, message: String) -> JsonValue
    var err = map_new()
    map_set(&err, str_new("code"), json_number(code))
    map_set(&err, str_new("message"), json_string(message))
    
    var obj = map_new()
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")))
    map_set(&obj, str_new("id"), json_number(id))
    map_set(&obj, str_new("error"), json_object(err))
    out json_object(obj)
end

func rpc_notification(method: String, params: JsonValue) -> JsonValue
    var obj = map_new()
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")))
    map_set(&obj, str_new("method"), json_string(method))
    map_set(&obj, str_new("params"), params)
    out json_object(obj)
end

# ═══════════════════════════════════════════════════════
# Server Capabilities
# ═══════════════════════════════════════════════════════

func server_capabilities() -> JsonValue
    var caps = map_new()
    
    # Text document sync
    map_set(&caps, str_new("textDocumentSync"), json_number(1))   # Full sync
    
    # Completion
    var comp = map_new()
    var triggers = json_array(vec_new())
    vec_push(&triggers, json_string(str_new(".")))
    map_set(&comp, str_new("triggerCharacters"), triggers)
    map_set(&caps, str_new("completionProvider"), json_object(comp))
    
    # Hover
    map_set(&caps, str_new("hoverProvider"), json_bool(true))
    
    # Definition
    map_set(&caps, str_new("definitionProvider"), json_bool(true))
    
    # Diagnostics (push)
    map_set(&caps, str_new("diagnosticProvider"), json_bool(true))
    
    out json_object(caps)
end

# ═══════════════════════════════════════════════════════
# LSP Server (stub — main loop)
# ═══════════════════════════════════════════════════════

entity LspServer
    running:     bool
    initialized: bool
    documents:   Map<String, String>   # uri -> content
end

func lsp_server_new() -> LspServer
    out LspServer {
        running = true,
        initialized = false,
        documents = map_new()
    }
end

func lsp_handle_initialize(server: &LspServer, id: i64) -> JsonValue
    server.initialized = true
    
    var result = map_new()
    map_set(&result, str_new("capabilities"), server_capabilities())
    
    var info = map_new()
    map_set(&info, str_new("name"), json_string(str_new("vir-lsp")))
    map_set(&info, str_new("version"), json_string(str_new("0.1.0")))
    map_set(&result, str_new("serverInfo"), json_object(info))
    
    out rpc_response(id, json_object(result))
end

func lsp_handle_shutdown(server: &LspServer, id: i64) -> JsonValue
    server.running = false
    out rpc_response(id, json_null())
end

func lsp_diagnostic(uri: String, diags: Vec<Diagnostic>) -> JsonValue
    var arr = vec_new()
    var i: usize = 0
    lặp_khi i < vec_len(diags)
        var d = vec_get(diags, i)
        var dobj = map_new()
        
        var range_obj = map_new()
        var start_obj = map_new()
        map_set(&start_obj, str_new("line"), json_number(d.range.start.line))
        map_set(&start_obj, str_new("character"), json_number(d.range.start.character))
        var end_obj = map_new()
        map_set(&end_obj, str_new("line"), json_number(d.range.end.line))
        map_set(&end_obj, str_new("character"), json_number(d.range.end.character))
        map_set(&range_obj, str_new("start"), json_object(start_obj))
        map_set(&range_obj, str_new("end"), json_object(end_obj))
        
        map_set(&dobj, str_new("range"), json_object(range_obj))
        map_set(&dobj, str_new("severity"), json_number(d.severity))
        map_set(&dobj, str_new("message"), json_string(d.message))
        map_set(&dobj, str_new("source"), json_string(d.source))
        vec_push(&arr, json_object(dobj))
        i = i + 1
    end
    
    var params = map_new()
    map_set(&params, str_new("uri"), json_string(uri))
    map_set(&params, str_new("diagnostics"), json_array(arr))
    out rpc_notification(str_new("textDocument/publishDiagnostics"), json_object(params))
end
