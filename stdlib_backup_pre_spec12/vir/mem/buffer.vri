/*
 * vir/mem/buffer.vri — Growable Byte Buffer (sở hữu dữ liệu)
 * ============================================================
 * Buffer = Vec<u8> chuyên biệt — use cho machine code emit, binary I/O.
 * Tự grow khi cần, deallocate khi free.
 *
 * Compiler uses internally: code buffer cho codegen, output binary.
 */

import "vir/core/types" use all
import "vir/mem/alloc" use alloc, realloc, free
import "vir/mem/slice" use Slice, slice_new
import "vir/mem/copy" use mem_copy, mem_set

const BUFFER_INITIAL_CAP : u64 = 256

entity Buffer
    data: ptr
    len: u64
    cap: u64
end

func buffer_new(cap: u64) -> Buffer
    var actual_cap = if cap > 0 cap else BUFFER_INITIAL_CAP end
    out Buffer {
        data: alloc(actual_cap),
        len: 0,
        cap: actual_cap
    }
end

func buffer_default() -> Buffer
    out buffer_new(BUFFER_INITIAL_CAP)
end

func buffer_grow(b: Buffer, min_cap: u64)
    if min_cap <= b.cap out end
    var new_cap = b.cap * 2
    while new_cap < min_cap
        new_cap = new_cap * 2
    end
    b.data = realloc(b.data, new_cap)
    b.cap = new_cap
end

func buffer_push(b: Buffer, byte: u8)
    buffer_grow(b, b.len + 1)
    native_write_u8(b.data, b.len, byte)
    b.len = b.len + 1
end

func buffer_push_u16(b: Buffer, val: u16)
    buffer_grow(b, b.len + 2)
    native_write_u16_le(b.data, b.len, val)
    b.len = b.len + 2
end

func buffer_push_u32(b: Buffer, val: u32)
    buffer_grow(b, b.len + 4)
    native_write_u32_le(b.data, b.len, val)
    b.len = b.len + 4
end

func buffer_push_u64(b: Buffer, val: u64)
    buffer_grow(b, b.len + 8)
    native_write_u64_le(b.data, b.len, val)
    b.len = b.len + 8
end

func buffer_write(b: Buffer, data: Slice)
    buffer_grow(b, b.len + data.len)
    mem_copy(b.data + b.len, data.data, data.len)
    b.len = b.len + data.len
end

func buffer_write_bytes(b: Buffer, src: ptr, count: u64)
    buffer_grow(b, b.len + count)
    mem_copy(b.data + b.len, src, count)
    b.len = b.len + count
end

func buffer_read_u8(b: Buffer, offset: u64) -> u8
    if offset >= b.len panic("buffer read out of bounds") end
    out native_read_u8(b.data, offset)
end

func buffer_read_u32(b: Buffer, offset: u64) -> u32
    if offset + 4 > b.len panic("buffer read out of bounds") end
    out native_read_u32_le(b.data, offset)
end

func buffer_write_at(b: Buffer, offset: u64, val: u8)
    if offset >= b.len panic("buffer write out of bounds") end
    native_write_u8(b.data, offset, val)
end

func buffer_write_u32_at(b: Buffer, offset: u64, val: u32)
    if offset + 4 > b.len panic("buffer write out of bounds") end
    native_write_u32_le(b.data, offset, val)
end

func buffer_patch_u32(b: Buffer, offset: u64, val: u32)
    # Alias rõ nghĩa hơn cho binary patching
    buffer_write_u32_at(b, offset, val)
end

func buffer_as_slice(b: Buffer) -> Slice
    out slice_new(b.data, b.len)
end

func buffer_clear(b: Buffer)
    b.len = 0
end

func buffer_free(b: Buffer)
    free(b.data)
    b.data = null
    b.len = 0
    b.cap = 0
end

func buffer_len(b: Buffer) -> u64
    out b.len
end

func buffer_cap(b: Buffer) -> u64
    out b.cap
end

func buffer_is_empty(b: Buffer) -> bool
    out b.len == 0
end

func buffer_reserve(b: Buffer, additional: u64)
    buffer_grow(b, b.len + additional)
end

func buffer_truncate(b: Buffer, new_len: u64)
    if new_len < b.len
        b.len = new_len
    end
end
