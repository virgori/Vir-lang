/*
 * vir/mem/alloc.vri — Memory Allocator Interface
 * ================================================
 * Inspired by C23: <stdlib.h> malloc/calloc/realloc/free
 * Vir use quản lý memory thủ công (manual) + arena cho bulk allocation.
 *
 * Compiler uses internally: AST node alloc, instruction buffer, symbol table.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err

entity AllocError
    msg: String
    requested_size: u64
end

# ═══════════════════════════════════════════════════════
# Global allocator (wraps OS malloc/free)
# ═══════════════════════════════════════════════════════

func alloc(size: u64) -> ptr
    # Cấp phát `size` bytes trên heap. Panic if end memory.
    if size == 0 out null end
    var p = native_malloc(size)
    if p == null
        panic("out of memory: alloc(" + to_string(size) + ")")
    end
    out p
end

func alloc_zeroed(size: u64) -> ptr
    # Cấp phát `size` bytes, khởi tạo toàn bộ = 0.
    if size == 0 out null end
    var p = native_calloc(1, size)
    if p == null
        panic("out of memory: alloc_zeroed(" + to_string(size) + ")")
    end
    out p
end

func try_alloc(size: u64) -> Result<ptr, AllocError>
    # Cấp phát không panic — trả Result.
    if size == 0 out Ok(null) end
    var p = native_malloc(size)
    if p == null
        out Err(AllocError { msg: "allocation failed", requested_size: size })
    end
    out Ok(p)
end

func realloc(p: ptr, new_size: u64) -> ptr
    # Thay đổi size vùng nhớ. Panic if failed.
    var new_p = native_realloc(p, new_size)
    if new_p == null and new_size > 0
        panic("out of memory: realloc(" + to_string(new_size) + ")")
    end
    out new_p
end

func free(p: ptr)
    # Giải phóng vùng nhớ. Safe to call với null.
    if p != null
        native_free(p)
    end
end

# ═══════════════════════════════════════════════════════
# Kích thước type
# ═══════════════════════════════════════════════════════

func size_of_i8()  -> u64 out 1 end
func size_of_i16() -> u64 out 2 end
func size_of_i32() -> u64 out 4 end
func size_of_i64() -> u64 out 8 end
func size_of_u8()  -> u64 out 1 end
func size_of_u16() -> u64 out 2 end
func size_of_u32() -> u64 out 4 end
func size_of_u64() -> u64 out 8 end
func size_of_f32() -> u64 out 4 end
func size_of_f64() -> u64 out 8 end
func size_of_ptr() -> u64 out 8 end   # 64-bit platform
