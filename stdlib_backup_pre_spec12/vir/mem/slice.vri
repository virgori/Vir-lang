/*
 * vir/mem/slice.vri — Borrowed View (không sở hữu)
 * ==================================================
 * Slice = (ptr, len) — trỏ vào dữ liệu already exists, không alloc/free.
 * Giống C pointer + length, giống Go slice, giống Rust &[T].
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None

entity Slice
    data: ptr
    len: u64
end

func slice_new(data: ptr, len: u64) -> Slice
    out Slice { data: data, len: len }
end

func slice_empty() -> Slice
    out Slice { data: null, len: 0 }
end

func slice_get(s: Slice, i: u64) -> u8
    if i >= s.len
        panic("slice index out of bounds: " + to_string(i) + " >= " + to_string(s.len))
    end
    out native_read_u8(s.data, i)
end

func slice_set(s: Slice, i: u64, val: u8)
    if i >= s.len
        panic("slice index out of bounds")
    end
    native_write_u8(s.data, i, val)
end

func slice_sub(s: Slice, from: u64, to: u64) -> Slice
    if from > to or to > s.len
        panic("slice_sub: invalid range")
    end
    out Slice { data: s.data + from, len: to - from }
end

func slice_eq(a: Slice, b: Slice) -> bool
    if a.len != b.len out false end
    out mem_cmp(a.data, b.data, a.len) == 0
end

func slice_find_byte(s: Slice, b: u8) -> Option<u64>
    với mỗi i in 0..s.len
        if slice_get(s, i) == b
            out Some(i)
        end
    end
    out None
end

func slice_copy_to(src: Slice, dst: Slice)
    var n = min(src.len, dst.len)
    mem_copy(dst.data, src.data, n)
end

func slice_fill(s: Slice, val: u8)
    mem_set(s.data, val, s.len)
end
