/*
 * vir/net/net.vri — Networking (TCP / UDP / DNS)
 * ================================================
 * Inspired by C23: POSIX sockets
 * Inspired by Python: socket, ssl
 *
 * Phase C — production networking
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/io/traits" use Reader, Writer
import "vir/collections/vec" use Vec, vec_new, vec_push

# ═══════════════════════════════════════════════════════
# Address types
# ═══════════════════════════════════════════════════════

enum AddrFamily
    IPv4 = 2    # AF_INET
    IPv6 = 10   # AF_INET6
end

entity IpAddr
    family: AddrFamily
    octets: Vec<u8>    # 4 bytes (IPv4) or 16 bytes (IPv6)
end

entity SocketAddr
    ip:   IpAddr
    port: u16
end

func ipv4(a: u8, b: u8, c: u8, d: u8) -> IpAddr
    var octets = vec_new()
    vec_push(&octets, a)
    vec_push(&octets, b)
    vec_push(&octets, c)
    vec_push(&octets, d)
    out IpAddr { family = AddrFamily.IPv4, octets = octets }
end

func socket_addr(ip: IpAddr, port: u16) -> SocketAddr
    out SocketAddr { ip = ip, port = port }
end

func localhost(port: u16) -> SocketAddr
    out socket_addr(ipv4(127, 0, 0, 1), port)
end

# ═══════════════════════════════════════════════════════
# DNS Resolution
# ═══════════════════════════════════════════════════════

func ngoài native_dns_resolve(host: ptr, host_len: usize, out_addrs: ptr, max: usize) -> i32

func dns_resolve(hostname: String) -> Result<Vec<IpAddr>, String>
    var buf: [u8; 1024]
    var count = native_dns_resolve(str_ptr(hostname), str_byte_len(hostname), &buf, 64)
    if count < 0
        out Err(str_new("DNS resolution failed"))
    end
    
    var addrs = vec_new()
    var i: i32 = 0
    lặp_khi i < count
        # Parse native address result
        var addr = _parse_native_addr(&buf, i)
        vec_push(&addrs, addr)
        i = i + 1
    end
    out Ok(addrs)
end

func _parse_native_addr(buf: &[u8], idx: i32) -> IpAddr
    # Read 4 bytes at offset idx * 4 for IPv4
    var off = idx * 4
    out ipv4(buf[off], buf[off + 1], buf[off + 2], buf[off + 3])
end

# ═══════════════════════════════════════════════════════
# TCP
# ═══════════════════════════════════════════════════════

entity TcpStream
    fd: i32
end

entity TcpListener
    fd: i32
end

func ngoài native_socket_tcp() -> i32
func ngoài native_socket_connect(fd: i32, ip: ptr, ip_len: usize, port: u16) -> i32
func ngoài native_socket_bind(fd: i32, ip: ptr, ip_len: usize, port: u16) -> i32
func ngoài native_socket_listen(fd: i32, backlog: i32) -> i32
func ngoài native_socket_accept(fd: i32, out_ip: ptr, out_port: ptr) -> i32
func ngoài native_socket_read(fd: i32, buf: ptr, len: usize) -> i64
func ngoài native_socket_write(fd: i32, buf: ptr, len: usize) -> i64
func ngoài native_socket_close(fd: i32) -> i32
func ngoài native_socket_shutdown(fd: i32, how: i32) -> i32
func ngoài native_socket_set_nonblock(fd: i32, on: bool) -> i32
func ngoài native_socket_set_reuseaddr(fd: i32, on: bool) -> i32
func ngoài native_socket_set_nodelay(fd: i32, on: bool) -> i32
func ngoài native_socket_set_timeout(fd: i32, kind: i32, ms: u64) -> i32

# ─── TcpStream ────────────────────────────────────────

func tcp_connect(addr: SocketAddr) -> Result<TcpStream, String>
    var fd = native_socket_tcp()
    if fd < 0 out Err(str_new("failed to create socket")) end
    
    var rc = native_socket_connect(fd, &addr.ip.octets, vec_len(addr.ip.octets), addr.port)
    if rc < 0
        native_socket_close(fd)
        out Err(str_new("connection failed"))
    end
    out Ok(TcpStream { fd = fd })
end

func tcp_read(stream: &TcpStream, buf: &[u8], len: usize) -> Result<usize, String>
    var n = native_socket_read(stream.fd, buf, len)
    if n < 0 out Err(str_new("read error")) end
    out Ok(n)
end

func tcp_write(stream: &TcpStream, data: &[u8], len: usize) -> Result<usize, String>
    var n = native_socket_write(stream.fd, data, len)
    if n < 0 out Err(str_new("write error")) end
    out Ok(n)
end

func tcp_write_all(stream: &TcpStream, data: &[u8], len: usize) -> Result<void, String>
    var written: usize = 0
    lặp_khi written < len
        var n = native_socket_write(stream.fd, &data[written], len - written)
        if n <= 0 out Err(str_new("write error")) end
        written = written + n
    end
    out Ok(())
end

func tcp_close(stream: &TcpStream)
    native_socket_close(stream.fd)
end

func tcp_set_nodelay(stream: &TcpStream, on: bool)
    native_socket_set_nodelay(stream.fd, on)
end

func tcp_set_read_timeout(stream: &TcpStream, ms: u64)
    native_socket_set_timeout(stream.fd, 0, ms)
end

func tcp_set_write_timeout(stream: &TcpStream, ms: u64)
    native_socket_set_timeout(stream.fd, 1, ms)
end

# ─── TcpListener ──────────────────────────────────────

func tcp_listen(addr: SocketAddr, backlog: i32) -> Result<TcpListener, String>
    var fd = native_socket_tcp()
    if fd < 0 out Err(str_new("failed to create socket")) end
    
    native_socket_set_reuseaddr(fd, true)
    
    var rc = native_socket_bind(fd, &addr.ip.octets, vec_len(addr.ip.octets), addr.port)
    if rc < 0
        native_socket_close(fd)
        out Err(str_new("bind failed"))
    end
    
    rc = native_socket_listen(fd, backlog)
    if rc < 0
        native_socket_close(fd)
        out Err(str_new("listen failed"))
    end
    
    out Ok(TcpListener { fd = fd })
end

func tcp_accept(listener: &TcpListener) -> Result<(TcpStream, SocketAddr), String>
    var out_ip: [u8; 16]
    var out_port: u16 = 0
    var client_fd = native_socket_accept(listener.fd, &out_ip, &out_port)
    if client_fd < 0 out Err(str_new("accept failed")) end
    
    var addr = socket_addr(ipv4(out_ip[0], out_ip[1], out_ip[2], out_ip[3]), out_port)
    out Ok((TcpStream { fd = client_fd }, addr))
end

func listener_close(listener: &TcpListener)
    native_socket_close(listener.fd)
end

# ═══════════════════════════════════════════════════════
# UDP
# ═══════════════════════════════════════════════════════

entity UdpSocket
    fd: i32
end

func ngoài native_socket_udp() -> i32
func ngoài native_socket_sendto(fd: i32, buf: ptr, len: usize, ip: ptr, ip_len: usize, port: u16) -> i64
func ngoài native_socket_recvfrom(fd: i32, buf: ptr, len: usize, out_ip: ptr, out_port: ptr) -> i64

func udp_bind(addr: SocketAddr) -> Result<UdpSocket, String>
    var fd = native_socket_udp()
    if fd < 0 out Err(str_new("failed to create UDP socket")) end
    
    var rc = native_socket_bind(fd, &addr.ip.octets, vec_len(addr.ip.octets), addr.port)
    if rc < 0
        native_socket_close(fd)
        out Err(str_new("UDP bind failed"))
    end
    out Ok(UdpSocket { fd = fd })
end

func udp_send_to(sock: &UdpSocket, data: &[u8], len: usize, addr: SocketAddr) -> Result<usize, String>
    var n = native_socket_sendto(sock.fd, data, len,
        &addr.ip.octets, vec_len(addr.ip.octets), addr.port)
    if n < 0 out Err(str_new("sendto failed")) end
    out Ok(n)
end

func udp_recv_from(sock: &UdpSocket, buf: &[u8], len: usize) -> Result<(usize, SocketAddr), String>
    var out_ip: [u8; 16]
    var out_port: u16 = 0
    var n = native_socket_recvfrom(sock.fd, buf, len, &out_ip, &out_port)
    if n < 0 out Err(str_new("recvfrom failed")) end
    var addr = socket_addr(ipv4(out_ip[0], out_ip[1], out_ip[2], out_ip[3]), out_port)
    out Ok((n, addr))
end

func udp_close(sock: &UdpSocket)
    native_socket_close(sock.fd)
end
