/*
 * vir/ffi/ffi.vri — Foreign Function Interface
 * ===============================================
 * Phase D — call C/native libraries from Vir
 *
 * Inspired by Python: ctypes, cffi
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push

# ═══════════════════════════════════════════════════════
# Dynamic Library Loading
# ═══════════════════════════════════════════════════════

entity DynLib
    _handle: ptr
    path:    String
end

func ngoài native_dlopen(path: ptr, path_len: usize, flags: i32) -> ptr
func ngoài native_dlclose(handle: ptr) -> i32
func ngoài native_dlsym(handle: ptr, name: ptr, name_len: usize) -> ptr
func ngoài native_dlerror(buf: ptr, buf_len: usize) -> i32

func lib_open(path: String) -> Result<DynLib, String>
    var handle = native_dlopen(str_ptr(path), str_byte_len(path), 1)  # RTLD_LAZY
    if handle == ptr_null()
        var buf: [u8; 256]
        var n = native_dlerror(&buf, 256)
        out Err(if n > 0 str_from_bytes(&buf, n) else str_new("dlopen failed") end)
    end
    out Ok(DynLib { _handle = handle, path = path })
end

func lib_close(lib: &DynLib)
    native_dlclose(lib._handle)
end

func lib_symbol(lib: &DynLib, name: String) -> Result<ptr, String>
    var sym = native_dlsym(lib._handle, str_ptr(name), str_byte_len(name))
    if sym == ptr_null()
        out Err(str_concat(str_new("symbol not found: "), name))
    end
    out Ok(sym)
end

# ═══════════════════════════════════════════════════════
# FFI Types (for describing C function signatures)
# ═══════════════════════════════════════════════════════

enum CType
    Void    = 0
    I8      = 1
    I16     = 2
    I32     = 3
    I64     = 4
    U8      = 5
    U16     = 6
    U32     = 7
    U64     = 8
    F32     = 9
    F64     = 10
    Ptr     = 11
    Str     = 12     # char*
    Bool    = 13
end

entity CFuncType
    args:    Vec<CType>
    ret:     CType
end

func cfunc_type(args: Vec<CType>, ret: CType) -> CFuncType
    out CFuncType { args = args, ret = ret }
end

# ═══════════════════════════════════════════════════════
# FFI Call (type-erased)
# ═══════════════════════════════════════════════════════

entity CValue
    tag:  CType
    _i64: i64
    _f64: f64
    _ptr: ptr
end

func cval_i64(v: i64) -> CValue
    out CValue { tag = CType.I64, _i64 = v, _f64 = 0.0, _ptr = ptr_null() }
end

func cval_f64(v: f64) -> CValue
    out CValue { tag = CType.F64, _i64 = 0, _f64 = v, _ptr = ptr_null() }
end

func cval_ptr(v: ptr) -> CValue
    out CValue { tag = CType.Ptr, _i64 = 0, _f64 = 0.0, _ptr = v }
end

func cval_str(s: String) -> CValue
    out CValue { tag = CType.Str, _i64 = 0, _f64 = 0.0, _ptr = str_ptr(s) }
end

func ngoài native_ffi_call(func_ptr: ptr, args: ptr, arg_count: usize, arg_types: ptr, ret_type: i32) -> CValue

func ffi_call(func: ptr, sig: CFuncType, args: Vec<CValue>) -> Result<CValue, String>
    if vec_len(args) != vec_len(sig.args)
        out Err(str_new("argument count mismatch"))
    end
    
    var result = native_ffi_call(func, vec_ptr(&args), vec_len(args),
                                   vec_ptr(&sig.args), sig.ret)
    out Ok(result)
end

# ═══════════════════════════════════════════════════════
# C String Helpers
# ═══════════════════════════════════════════════════════

func ngoài native_strlen(s: ptr) -> usize

func cstr_to_string(p: ptr) -> String
    if p == ptr_null() out str_new("") end
    var len = native_strlen(p)
    out str_from_bytes(p, len)
end

func string_to_cstr(s: String) -> ptr
    # Returns null-terminated copy — caller must free
    var len = str_byte_len(s)
    var buf = native_alloc(len + 1)
    native_memcpy(buf, str_ptr(s), len)
    native_memset(buf + len, 0, 1)
    out buf
end
