/*
 * vir/io/stdio.vri — Standard I/O (stdin, stdout, stderr)
 * =========================================================
 * Inspired by C23: <stdio.h> printf, scanf, fputs, fgets
 * Inspired by Python: print(), input(), sys.stdin/stdout/stderr
 *
 * Compiler uses internally: in error messages, đọc source từ stdin.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String
import "vir/error/error" use IoError

# ═══════════════════════════════════════════════════════
# Output
# ═══════════════════════════════════════════════════════

func print(s: String)
    # In ra stdout, không xuống dòng
    native_write_stdout(s.data, s.byte_len)
end

func println(s: String)
    # In ra stdout + xuống dòng
    native_write_stdout(s.data, s.byte_len)
    native_write_stdout_byte(0x0A)  # '\n'
end

func print_i64(n: i64)
    println(i64_to_str(n))
end

func print_f64(f: f64)
    println(f64_to_str(f))
end

func print_bool(b: bool)
    if b println(str_new("true"))
    else println(str_new("false"))
    end
end

# ═══════════════════════════════════════════════════════
# Error output
# ═══════════════════════════════════════════════════════

func eprint(s: String)
    # In ra stderr, không xuống dòng
    native_write_stderr(s.data, s.byte_len)
end

func eprintln(s: String)
    # In ra stderr + xuống dòng
    native_write_stderr(s.data, s.byte_len)
    native_write_stderr_byte(0x0A)
end

# ═══════════════════════════════════════════════════════
# Input
# ═══════════════════════════════════════════════════════

func read_line() -> Result<String, IoError>
    # Đọc một dòng từ stdin. Bỏ character newline cuối.
    var buf = buffer_new(256)
    var running = true

    while running
        var byte = native_read_stdin_byte()
        if byte < 0
            # EOF
            if buffer_is_empty(buf)
                buffer_free(buf)
                out Err(IoError { kind: IoErrorKind.UnexpectedEof, msg: "EOF reached" })
            end
            running = false
        eif byte == 0x0A
            # newline -> kết thúc dòng
            running = false
        else
            buffer_push(buf, to_u8(byte))
        end
    end

    var s = str_from_bytes(buf.data, buffer_len(buf))
    buffer_free(buf)
    out Ok(s)
end

func input(prompt: String) -> Result<String, IoError>
    # In prompt rồi đọc dòng — giống Python input()
    print(prompt)
    native_flush_stdout()
    out read_line()
end

# ═══════════════════════════════════════════════════════
# Flush
# ═══════════════════════════════════════════════════════

func flush_stdout()
    native_flush_stdout()
end

func flush_stderr()
    native_flush_stderr()
end
