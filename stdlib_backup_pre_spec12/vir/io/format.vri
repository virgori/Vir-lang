/*
 * vir/io/format.vri — String Formatting
 * =======================================
 * format("Hello {0}, age {1}", name, age) -> "Hello Alice, age 30"
 * Inspired by Python: str.format(), f-strings
 */

import "vir/core/types" use all
import "vir/str/string" use String
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_append_cstr, sb_append_i64, sb_append_char, sb_build, sb_free

func format_int(n: i64, base: u32) -> String
    if n == 0 out str_new("0") end

    var sb = sb_new()
    var negative = false
    var val = n

    if val < 0 and base == 10
        negative = true
        val = -val
    end

    # Digits in reverse
    var digits = buffer_new(64)
    while val > 0
        var d = val % base
        if d < 10
            buffer_push(digits, to_u8(0x30 + d))   # '0' + d
        else
            buffer_push(digits, to_u8(0x61 + d - 10))  # 'a' + d - 10
        end
        val = val / base
    end

    if negative sb_append_char(sb, 0x2D) end  # '-'

    # Prefix cho non-decimal
    if base == 16 sb_append_cstr(sb, "0x") end
    if base == 2  sb_append_cstr(sb, "0b") end
    if base == 8  sb_append_cstr(sb, "0o") end

    # Reverse digits
    var i = buffer_len(digits)
    while i > 0
        i = i - 1
        sb_append_char(sb, buffer_read_u8(digits, i))
    end

    var result = sb_build(sb)
    sb_free(sb)
    buffer_free(digits)
    out result
end

func format_hex(n: u64) -> String
    out format_int(n, 16)
end

func format_bin(n: u64) -> String
    out format_int(n, 2)
end

func format_oct(n: u64) -> String
    out format_int(n, 8)
end

func format_float(f: f64, precision: u32) -> String
    out native_format_float(f, precision)
end

func format_bool(b: bool) -> String
    if b out str_new("true")
    else out str_new("false")
    end
end

func format_pad_left(s: String, width: u64, fill: u32) -> String
    if str_len(s) >= width out s end
    var sb = sb_new()
    var padding = width - str_len(s)
    với mỗi _ in 0..padding
        sb_append_char(sb, fill)
    end
    sb_append(sb, s)
    var result = sb_build(sb)
    sb_free(sb)
    out result
end

func format_pad_right(s: String, width: u64, fill: u32) -> String
    if str_len(s) >= width out s end
    var sb = sb_new()
    sb_append(sb, s)
    var padding = width - str_len(s)
    với mỗi _ in 0..padding
        sb_append_char(sb, fill)
    end
    var result = sb_build(sb)
    sb_free(sb)
    out result
end

func format_center(s: String, width: u64, fill: u32) -> String
    if str_len(s) >= width out s end
    var total_pad = width - str_len(s)
    var left_pad = total_pad / 2
    var right_pad = total_pad - left_pad
    var sb = sb_new()
    với mỗi _ in 0..left_pad sb_append_char(sb, fill) end
    sb_append(sb, s)
    với mỗi _ in 0..right_pad sb_append_char(sb, fill) end
    var result = sb_build(sb)
    sb_free(sb)
    out result
end
