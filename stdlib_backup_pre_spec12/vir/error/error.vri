/*
 * vir/error/error.vri — Error Types & Handling
 * ===============================================
 * Inspired by Python: BaseException hierarchy
 * Inspired by Rust: Error trait, thiserror
 * Inspired by C23: errno.h
 *
 * Vir sử dụng Result<T,E> thay vì exception — nhưng cần hierarchy
 * error types để phân biệt loại lỗi.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat

# ═══════════════════════════════════════════════════════
# Error Kinds — Các loại lỗi cơ bản
# ═══════════════════════════════════════════════════════

enum ErrorKind
    # I/O
    NotFound        = 1
    PermissionDenied = 2
    AlreadyExists   = 3
    BrokenPipe      = 4
    WouldBlock      = 5
    TimedOut        = 6
    ConnectionRefused = 7
    ConnectionReset = 8
    Interrupted     = 9
    
    # Parse
    InvalidInput    = 20
    InvalidData     = 21
    InvalidEncoding = 22
    ParseIntError   = 23
    ParseFloatError = 24
    SyntaxError     = 25
    
    # Runtime
    OutOfMemory     = 40
    Overflow        = 41
    DivisionByZero  = 42
    IndexOutOfBounds = 43
    NullPointer     = 44
    StackOverflow   = 45
    
    # Logic
    Unimplemented   = 60
    Unreachable     = 61
    AssertionFailed = 62
    
    # Generic
    Other           = 99
end

# ═══════════════════════════════════════════════════════
# Error — Generic error type
# ═══════════════════════════════════════════════════════

entity Error
    kind:    ErrorKind
    message: String
    source:  Option<ptr>   # chain to cause (optional)
end

# ─── Constructors ─────────────────────────────────────

func error_new(kind: ErrorKind, msg: String) -> Error
    out Error { kind = kind, message = msg, source = None }
end

func error_with_source(kind: ErrorKind, msg: String, src: Error) -> Error
    # Chuỗi lỗi: error này gây ra bởi src.
    var src_ptr = native_box(src)   # heap-allocate cause
    out Error { kind = kind, message = msg, source = Some(src_ptr) }
end

# ─── Access ───────────────────────────────────────────

func error_kind(e: Error) -> ErrorKind
    out e.kind
end

func error_message(e: Error) -> String
    out e.message
end

func error_source(e: Error) -> Option<Error>
    chọn e.source
        case Some(p) out Some(native_unbox(p))
        case None out None
    end
end

# ─── Display ──────────────────────────────────────────

func error_to_string(e: Error) -> String
    var prefix = error_kind_name(e.kind)
    out str_concat(str_concat(prefix, str_new(": ")), e.message)
end

func error_chain(e: Error) -> String
    # In toàn bộ string lỗi: "kind: msg\n caused by: ..."
    var s = error_to_string(e)
    var cause = error_source(e)
    lặp_khi is_some(cause)
        var c = unwrap(cause)
        s = str_concat(s, str_new("\n  caused by: "))
        s = str_concat(s, error_to_string(c))
        cause = error_source(c)
    end
    out s
end

func error_kind_name(kind: ErrorKind) -> String
    chọn kind
        case ErrorKind.NotFound out str_new("NotFound")
        case ErrorKind.PermissionDenied out str_new("PermissionDenied")
        case ErrorKind.AlreadyExists out str_new("AlreadyExists")
        case ErrorKind.BrokenPipe out str_new("BrokenPipe")
        case ErrorKind.InvalidInput out str_new("InvalidInput")
        case ErrorKind.InvalidData out str_new("InvalidData")
        case ErrorKind.ParseIntError out str_new("ParseIntError")
        case ErrorKind.ParseFloatError out str_new("ParseFloatError")
        case ErrorKind.SyntaxError out str_new("SyntaxError")
        case ErrorKind.OutOfMemory out str_new("OutOfMemory")
        case ErrorKind.Overflow out str_new("Overflow")
        case ErrorKind.DivisionByZero out str_new("DivisionByZero")
        case ErrorKind.IndexOutOfBounds out str_new("IndexOutOfBounds")
        case ErrorKind.NullPointer out str_new("NullPointer")
        case ErrorKind.Unimplemented out str_new("Unimplemented")
        case ErrorKind.AssertionFailed out str_new("AssertionFailed")
        mặc_định out str_new("Error")
    end
end

# ═══════════════════════════════════════════════════════
# Convenience Constructors
# ═══════════════════════════════════════════════════════

func io_error(msg: String) -> Error
    out error_new(ErrorKind.NotFound, msg)
end

func parse_error(msg: String) -> Error
    out error_new(ErrorKind.InvalidInput, msg)
end

func overflow_error(msg: String) -> Error
    out error_new(ErrorKind.Overflow, msg)
end

func index_error(msg: String) -> Error
    out error_new(ErrorKind.IndexOutOfBounds, msg)
end

func null_error() -> Error
    out error_new(ErrorKind.NullPointer, str_new("null pointer dereference"))
end

func todo_error(msg: String) -> Error
    out error_new(ErrorKind.Unimplemented, msg)
end

# ═══════════════════════════════════════════════════════
# IoError — Specialized cho I/O
# ═══════════════════════════════════════════════════════

entity IoError
    kind:    ErrorKind
    message: String
    errno:   i32           # POSIX errno
end

func io_error_from_errno(errno: i32) -> IoError
    var kind: ErrorKind
    var msg: String
    
    chọn errno
        case 2 # ENOENT
            kind = ErrorKind.NotFound
            msg = str_new("file not found")
        case 13 # EACCES
            kind = ErrorKind.PermissionDenied
            msg = str_new("permission denied")
        case 17 # EEXIST
            kind = ErrorKind.AlreadyExists
            msg = str_new("already exists")
        case 12 # ENOMEM
            kind = ErrorKind.OutOfMemory
            msg = str_new("out of memory")
        mặc_định
            kind = ErrorKind.Other
            msg = str_new("I/O error")
    end
    
    out IoError { kind = kind, message = msg, errno = errno }
end

func io_error_to_error(e: IoError) -> Error
    out error_new(e.kind, e.message)
end

# ═══════════════════════════════════════════════════════
# Panic — Unrecoverable error
# ═══════════════════════════════════════════════════════

func panic_msg(msg: String)
    # Ghi lỗi ra stderr, dump trace, abort.
    eprintln(str_concat(str_new("PANIC: "), msg))
    native_abort()
end

func unreachable()
    panic_msg(str_new("entered unreachable code"))
end

func unimplemented(feature: String)
    panic_msg(str_concat(str_new("not yet implemented: "), feature))
end

func todo(what: String)
    panic_msg(str_concat(str_new("TODO: "), what))
end
