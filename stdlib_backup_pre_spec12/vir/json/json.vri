/*
 * vir/json/json.vri — JSON Parser & Serializer
 * ================================================
 * Inspired by Python: json
 * Tuân thủ RFC 8259 (JSON)
 *
 * Cung cấp: parse JSON -> JsonValue tree, serialize JsonValue -> String
 * Compiler use: config files, tool output, language server protocol.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_byte_at, str_byte_len, str_slice_bytes, str_concat, str_from_bytes
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_append_byte, sb_build
import "vir/str/char" use is_digit, is_space
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, string_map_new, map_insert, map_get, map_keys, map_len
import "vir/io/format" use format_int, format_float

# ═══════════════════════════════════════════════════════
# JSON Value — Tagged Union
# ═══════════════════════════════════════════════════════

enum JsonType
    Null    = 0
    Bool    = 1
    Number  = 2
    Str     = 3
    Array   = 4
    Object  = 5
end

entity JsonValue
    tag:     JsonType
    bool_v:  bool
    num_v:   f64
    str_v:   String
    arr_v:   Vec<JsonValue>
    obj_v:   Map<String, JsonValue>
end

# ─── Constructors ─────────────────────────────────────

func json_null() -> JsonValue
    out JsonValue { tag = JsonType.Null, bool_v = false, num_v = 0.0, str_v = str_new(""), arr_v = vec_new(), obj_v = string_map_new() }
end

func json_bool(v: bool) -> JsonValue
    var j = json_null()
    j.tag = JsonType.Bool
    j.bool_v = v
    out j
end

func json_number(v: f64) -> JsonValue
    var j = json_null()
    j.tag = JsonType.Number
    j.num_v = v
    out j
end

func json_int(v: i64) -> JsonValue
    out json_number(native_i64_to_f64(v))
end

func json_string(v: String) -> JsonValue
    var j = json_null()
    j.tag = JsonType.Str
    j.str_v = v
    out j
end

func json_array() -> JsonValue
    var j = json_null()
    j.tag = JsonType.Array
    out j
end

func json_object() -> JsonValue
    var j = json_null()
    j.tag = JsonType.Object
    out j
end

# ─── Access ───────────────────────────────────────────

func json_is_null(j: JsonValue) -> bool
    out j.tag == JsonType.Null
end

func json_is_bool(j: JsonValue) -> bool
    out j.tag == JsonType.Bool
end

func json_is_number(j: JsonValue) -> bool
    out j.tag == JsonType.Number
end

func json_is_string(j: JsonValue) -> bool
    out j.tag == JsonType.Str
end

func json_is_array(j: JsonValue) -> bool
    out j.tag == JsonType.Array
end

func json_is_object(j: JsonValue) -> bool
    out j.tag == JsonType.Object
end

func json_as_bool(j: JsonValue) -> Option<bool>
    if j.tag != JsonType.Bool out None end
    out Some(j.bool_v)
end

func json_as_number(j: JsonValue) -> Option<f64>
    if j.tag != JsonType.Number out None end
    out Some(j.num_v)
end

func json_as_string(j: JsonValue) -> Option<String>
    if j.tag != JsonType.Str out None end
    out Some(j.str_v)
end

func json_as_i64(j: JsonValue) -> Option<i64>
    if j.tag != JsonType.Number out None end
    out Some(native_f64_to_i64(j.num_v))
end

# ─── Array Operations ─────────────────────────────────

func json_array_push(j: &JsonValue, val: JsonValue)
    vec_push(&j.arr_v, val)
end

func json_array_get(j: JsonValue, idx: usize) -> Option<JsonValue>
    if j.tag != JsonType.Array out None end
    if idx >= vec_len(j.arr_v) out None end
    out Some(vec_get(j.arr_v, idx))
end

func json_array_len(j: JsonValue) -> usize
    if j.tag != JsonType.Array out 0 end
    out vec_len(j.arr_v)
end

# ─── Object Operations ────────────────────────────────

func json_object_set(j: &JsonValue, key: String, val: JsonValue)
    map_insert(&j.obj_v, key, val)
end

func json_object_get(j: JsonValue, key: String) -> Option<JsonValue>
    if j.tag != JsonType.Object out None end
    out map_get(j.obj_v, key)
end

func json_object_has(j: JsonValue, key: String) -> bool
    out is_some(json_object_get(j, key))
end

func json_object_keys(j: JsonValue) -> Vec<String>
    if j.tag != JsonType.Object out vec_new() end
    out map_keys(j.obj_v)
end

# ═══════════════════════════════════════════════════════
# JSON Serializer (JsonValue -> String)
# ═══════════════════════════════════════════════════════

func json_to_string(j: JsonValue) -> String
    var sb = sb_new()
    _serialize(&sb, j, 0, false)
    out sb_build(sb)
end

func json_to_string_pretty(j: JsonValue) -> String
    var sb = sb_new()
    _serialize(&sb, j, 0, true)
    out sb_build(sb)
end

func _serialize(sb: &StringBuilder, j: JsonValue, depth: usize, pretty: bool)
    chọn j.tag
        case JsonType.Null
            sb_append(sb, str_new("null"))
        
        case JsonType.Bool
            if j.bool_v
                sb_append(sb, str_new("true"))
            else
                sb_append(sb, str_new("false"))
            end
        
        case JsonType.Number
            # Nếu là integer, output không có dấu chấm
            var as_int = native_f64_to_i64(j.num_v)
            if native_i64_to_f64(as_int) == j.num_v
                sb_append(sb, format_int(as_int, 10))
            else
                sb_append(sb, format_float(j.num_v, 15))
            end
        
        case JsonType.Str
            _serialize_string(sb, j.str_v)
        
        case JsonType.Array
            sb_append_byte(sb, 0x5B)   # [
            var len = vec_len(j.arr_v)
            var i: usize = 0
            lặp_khi i < len
                if i > 0 sb_append_byte(sb, 0x2C) end   # ,
                if pretty
                    sb_append_byte(sb, 0x0A)   # \n
                    _indent(sb, depth + 1)
                end
                _serialize(sb, vec_get(j.arr_v, i), depth + 1, pretty)
                i = i + 1
            end
            if pretty and len > 0
                sb_append_byte(sb, 0x0A)
                _indent(sb, depth)
            end
            sb_append_byte(sb, 0x5D)   # ]
        
        case JsonType.Object
            sb_append_byte(sb, 0x7B)   # {
            var keys = map_keys(j.obj_v)
            var klen = vec_len(keys)
            var i: usize = 0
            lặp_khi i < klen
                if i > 0 sb_append_byte(sb, 0x2C) end
                if pretty
                    sb_append_byte(sb, 0x0A)
                    _indent(sb, depth + 1)
                end
                var key = vec_get(keys, i)
                _serialize_string(sb, key)
                sb_append_byte(sb, 0x3A)   # :
                if pretty sb_append_byte(sb, 0x20) end   # space
                var val = unwrap(map_get(j.obj_v, key))
                _serialize(sb, val, depth + 1, pretty)
                i = i + 1
            end
            if pretty and klen > 0
                sb_append_byte(sb, 0x0A)
                _indent(sb, depth)
            end
            sb_append_byte(sb, 0x7D)   # }
    end
end

func _serialize_string(sb: &StringBuilder, s: String)
    sb_append_byte(sb, 0x22)   # "
    var len = str_byte_len(s)
    var i: usize = 0
    lặp_khi i < len
        var ch = str_byte_at(s, i)
        chọn ch
            case 0x22 sb_append(sb, str_new("\\\""))    # "
            case 0x5C sb_append(sb, str_new("\\\\"))    # \
            case 0x08 sb_append(sb, str_new("\\b"))     # backspace
            case 0x0C sb_append(sb, str_new("\\f"))     # form feed
            case 0x0A sb_append(sb, str_new("\\n"))     # newline
            case 0x0D sb_append(sb, str_new("\\r"))     # carriage return
            case 0x09 sb_append(sb, str_new("\\t"))     # tab
            mặc_định
                if ch < 0x20
                    # Control char -> \u00xx
                    sb_append(sb, str_new("\\u00"))
                    sb_append_byte(sb, _hex_digit(ch >> 4))
                    sb_append_byte(sb, _hex_digit(ch & 0x0F))
                else
                    sb_append_byte(sb, ch)
                end
        end
        i = i + 1
    end
    sb_append_byte(sb, 0x22)   # "
end

func _indent(sb: &StringBuilder, depth: usize)
    var i: usize = 0
    lặp_khi i < depth
        sb_append(sb, str_new("  "))   # 2-space indent
        i = i + 1
    end
end

func _hex_digit(n: u8) -> u8
    if n < 10 out 0x30 + n end
    out 0x61 + n - 10
end

# ═══════════════════════════════════════════════════════
# JSON Parser (String -> JsonValue)
# ═══════════════════════════════════════════════════════

entity JsonParser
    src:  String
    pos:  usize
    len:  usize
end

func json_parse(input: String) -> Result<JsonValue, String>
    var p = JsonParser { src = input, pos = 0, len = str_byte_len(input) }
    _skip_ws(&p)
    var result = _parse_value(&p)
    chọn result
        case Err(e) out Err(e)
        case Ok(val)
            _skip_ws(&p)
            if p.pos < p.len
                out Err(str_concat(str_new("unexpected trailing content at position "), format_int(p.pos, 10)))
            end
            out Ok(val)
    end
end

func _peek(p: JsonParser) -> u8
    if p.pos >= p.len out 0 end
    out str_byte_at(p.src, p.pos)
end

func _advance(p: &JsonParser) -> u8
    var ch = _peek(*p)
    p.pos = p.pos + 1
    out ch
end

func _skip_ws(p: &JsonParser)
    lặp_khi p.pos < p.len
        var ch = str_byte_at(p.src, p.pos)
        if ch == 0x20 or ch == 0x09 or ch == 0x0A or ch == 0x0D
            p.pos = p.pos + 1
        else
            thoát
        end
    end
end

func _expect(p: &JsonParser, ch: u8) -> Result<void, String>
    if p.pos >= p.len or str_byte_at(p.src, p.pos) != ch
        out Err(str_concat(str_new("expected '"), str_concat(str_from_bytes(&ch, 1), str_concat(str_new("' at "), format_int(p.pos, 10)))))
    end
    p.pos = p.pos + 1
    out Ok(void)
end

func _parse_value(p: &JsonParser) -> Result<JsonValue, String>
    _skip_ws(p)
    if p.pos >= p.len out Err(str_new("unexpected end of input")) end
    
    var ch = _peek(*p)
    
    chọn ch
        case 0x22 out _parse_string(p)          # "
        case 0x7B out _parse_object(p)          # {
        case 0x5B out _parse_array(p)           # [
        case 0x74 out _parse_true(p)            # t
        case 0x66 out _parse_false(p)           # f
        case 0x6E out _parse_null(p)            # n
        mặc_định
            if ch == 0x2D or is_digit(ch) # - or 0-9
                out _parse_number(p)
            end
            out Err(str_concat(str_new("unexpected character at "), format_int(p.pos, 10)))
    end
end

func _parse_null(p: &JsonParser) -> Result<JsonValue, String>
    if p.pos + 4 > p.len out Err(str_new("unexpected end")) end
    var s = str_slice_bytes(p.src, p.pos, p.pos + 4)
    if !str_eq(s, str_new("null")) out Err(str_new("expected 'null'")) end
    p.pos = p.pos + 4
    out Ok(json_null())
end

func _parse_true(p: &JsonParser) -> Result<JsonValue, String>
    if p.pos + 4 > p.len out Err(str_new("unexpected end")) end
    var s = str_slice_bytes(p.src, p.pos, p.pos + 4)
    if !str_eq(s, str_new("true")) out Err(str_new("expected 'true'")) end
    p.pos = p.pos + 4
    out Ok(json_bool(true))
end

func _parse_false(p: &JsonParser) -> Result<JsonValue, String>
    if p.pos + 5 > p.len out Err(str_new("unexpected end")) end
    var s = str_slice_bytes(p.src, p.pos, p.pos + 5)
    if !str_eq(s, str_new("false")) out Err(str_new("expected 'false'")) end
    p.pos = p.pos + 5
    out Ok(json_bool(false))
end

func _parse_number(p: &JsonParser) -> Result<JsonValue, String>
    var start = p.pos
    
    # Optional minus
    if _peek(*p) == 0x2D p.pos = p.pos + 1 end
    
    # Digits
    if p.pos >= p.len or !is_digit(str_byte_at(p.src, p.pos))
        out Err(str_new("expected digit"))
    end
    lặp_khi p.pos < p.len and is_digit(str_byte_at(p.src, p.pos))
        p.pos = p.pos + 1
    end
    
    # Fraction
    var is_float = false
    if p.pos < p.len and str_byte_at(p.src, p.pos) == 0x2E
        is_float = true
        p.pos = p.pos + 1
        lặp_khi p.pos < p.len and is_digit(str_byte_at(p.src, p.pos))
            p.pos = p.pos + 1
        end
    end
    
    # Exponent
    if p.pos < p.len
        var ec = str_byte_at(p.src, p.pos)
        if ec == 0x65 or ec == 0x45 # e E
            is_float = true
            p.pos = p.pos + 1
            if p.pos < p.len
                var sign = str_byte_at(p.src, p.pos)
                if sign == 0x2B or sign == 0x2D p.pos = p.pos + 1 end
            end
            lặp_khi p.pos < p.len and is_digit(str_byte_at(p.src, p.pos))
                p.pos = p.pos + 1
            end
        end
    end
    
    var num_str = str_slice_bytes(p.src, start, p.pos)
    var val = native_parse_f64(num_str.data, num_str.byte_len)
    out Ok(json_number(val))
end

func _parse_string(p: &JsonParser) -> Result<JsonValue, String>
    var str_result = _parse_string_raw(p)
    chọn str_result
        case Ok(s) out Ok(json_string(s))
        case Err(e) out Err(e)
    end
end

func _parse_string_raw(p: &JsonParser) -> Result<String, String>
    var r = _expect(p, 0x22)   # opening "
    if is_err(r) out Err(str_new("expected '\"'")) end
    
    var sb = sb_new()
    loop
        if p.pos >= p.len out Err(str_new("unterminated string")) end
        var ch = _advance(p)
        
        if ch == 0x22 thoát end   # closing "
        
        if ch == 0x5C # backslash
            if p.pos >= p.len out Err(str_new("unterminated escape")) end
            var esc = _advance(p)
            chọn esc
                case 0x22 sb_append_byte(&sb, 0x22)   # \"
                case 0x5C sb_append_byte(&sb, 0x5C)   # \\
                case 0x2F sb_append_byte(&sb, 0x2F)   # \/
                case 0x62 sb_append_byte(&sb, 0x08)   # \b
                case 0x66 sb_append_byte(&sb, 0x0C)   # \f
                case 0x6E sb_append_byte(&sb, 0x0A)   # \n
                case 0x72 sb_append_byte(&sb, 0x0D)   # \r
                case 0x74 sb_append_byte(&sb, 0x09)   # \t
                case 0x75 # \uXXXX
                    if p.pos + 4 > p.len out Err(str_new("truncated \\u escape")) end
                    var hex = str_slice_bytes(p.src, p.pos, p.pos + 4)
                    var cp = native_parse_hex(hex.data, 4)
                    p.pos = p.pos + 4
                    # Encode as UTF-8
                    _encode_codepoint(&sb, cp)
                mặc_định
                    out Err(str_concat(str_new("invalid escape: \\"), str_from_bytes(&esc, 1)))
            end
        else
            sb_append_byte(&sb, ch)
        end
    end
    out Ok(sb_build(sb))
end

func _encode_codepoint(sb: &StringBuilder, cp: u32)
    if cp <= 0x7F
        sb_append_byte(sb, cp)
    eif cp <= 0x7FF
        sb_append_byte(sb, 0xC0 | (cp >> 6))
        sb_append_byte(sb, 0x80 | (cp & 0x3F))
    eif cp <= 0xFFFF
        sb_append_byte(sb, 0xE0 | (cp >> 12))
        sb_append_byte(sb, 0x80 | ((cp >> 6) & 0x3F))
        sb_append_byte(sb, 0x80 | (cp & 0x3F))
    else
        sb_append_byte(sb, 0xF0 | (cp >> 18))
        sb_append_byte(sb, 0x80 | ((cp >> 12) & 0x3F))
        sb_append_byte(sb, 0x80 | ((cp >> 6) & 0x3F))
        sb_append_byte(sb, 0x80 | (cp & 0x3F))
    end
end

func _parse_array(p: &JsonParser) -> Result<JsonValue, String>
    var r = _expect(p, 0x5B)   # [
    if is_err(r) out Err(str_new("expected '['")) end
    
    var arr = json_array()
    _skip_ws(p)
    
    if _peek(*p) == 0x5D # empty array
        p.pos = p.pos + 1
        out Ok(arr)
    end
    
    loop
        var val_result = _parse_value(p)
        chọn val_result
            case Err(e) out Err(e)
            case Ok(val) json_array_push(&arr, val)
        end
        
        _skip_ws(p)
        var next = _peek(*p)
        if next == 0x5D # ]
            p.pos = p.pos + 1
            thoát
        eif next == 0x2C # ,
            p.pos = p.pos + 1
        else
            out Err(str_new("expected ',' or ']' in array"))
        end
    end
    
    out Ok(arr)
end

func _parse_object(p: &JsonParser) -> Result<JsonValue, String>
    var r = _expect(p, 0x7B)   # {
    if is_err(r) out Err(str_new("expected '{'")) end
    
    var obj = json_object()
    _skip_ws(p)
    
    if _peek(*p) == 0x7D # empty object
        p.pos = p.pos + 1
        out Ok(obj)
    end
    
    loop
        _skip_ws(p)
        # Parse key (must be string)
        var key_result = _parse_string_raw(p)
        var key: String
        chọn key_result
            case Err(e) out Err(e)
            case Ok(k) key = k
        end
        
        # Expect :
        _skip_ws(p)
        var colon = _expect(p, 0x3A)
        if is_err(colon) out Err(str_new("expected ':' in object")) end
        
        # Parse value
        var val_result = _parse_value(p)
        chọn val_result
            case Err(e) out Err(e)
            case Ok(val) json_object_set(&obj, key, val)
        end
        
        _skip_ws(p)
        var next = _peek(*p)
        if next == 0x7D # }
            p.pos = p.pos + 1
            thoát
        eif next == 0x2C
            p.pos = p.pos + 1
        else
            out Err(str_new("expected ',' or '}' in object"))
        end
    end
    
    out Ok(obj)
end
