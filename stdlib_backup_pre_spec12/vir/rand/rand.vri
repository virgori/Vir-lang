/*
 * vir/rand/rand.vri — Pseudo-Random Number Generator
 * ====================================================
 * Inspired by Python: random
 * Triển khai: xoshiro256** (fast, high quality, non-cryptographic)
 *
 * Dùng cho: testing, fuzzing, hash seed randomization.
 */

import "vir/core/types" use all
import "vir/time/time" use unix_timestamp_nanos

# ═══════════════════════════════════════════════════════
# RNG State — xoshiro256**
# ═══════════════════════════════════════════════════════

entity Rng
    s0: u64
    s1: u64
    s2: u64
    s3: u64
end

func _rotl(x: u64, k: u64) -> u64
    out (x << k) | (x >> (64 - k))
end

# ─── Constructor ──────────────────────────────────────

func rng_new(seed: u64) -> Rng
    # Dùng SplitMix64 để seed xoshiro256** state
    var r = Rng { s0 = 0, s1 = 0, s2 = 0, s3 = 0 }
    var z = seed
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z = z ^ (z >> 31)
    r.s0 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z = z ^ (z >> 31)
    r.s1 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z = z ^ (z >> 31)
    r.s2 = z
    z = z + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z = z ^ (z >> 31)
    r.s3 = z
    out r
end

func rng_from_time() -> Rng
    out rng_new(unix_timestamp_nanos())
end

# ─── Core: next u64 ──────────────────────────────────

func rng_next_u64(r: &Rng) -> u64
    var result = _rotl(r.s1 * 5, 7) * 9
    var t = r.s1 << 17
    
    r.s2 = r.s2 ^ r.s0
    r.s3 = r.s3 ^ r.s1
    r.s1 = r.s1 ^ r.s2
    r.s0 = r.s0 ^ r.s3
    r.s2 = r.s2 ^ t
    r.s3 = _rotl(r.s3, 45)
    
    out result
end

# ─── Derived ──────────────────────────────────────────

func rng_next_i64(r: &Rng) -> i64
    out rng_next_u64(r)
end

func rng_next_u32(r: &Rng) -> u32
    out (rng_next_u64(r) >> 32)
end

func rng_next_bool(r: &Rng) -> bool
    out (rng_next_u64(r) & 1) == 1
end

func rng_next_f64(r: &Rng) -> f64
    # [0.0, 1.0)
    var bits = rng_next_u64(r) >> 11   # 53-bit mantissa
    out native_u64_to_f64(bits) * 1.1102230246251565e-16   # 2^-53
end

func rng_range_i64(r: &Rng, lo: i64, hi: i64) -> i64
    # Returns value ngẫu nhiên in [lo, hi).
    if lo >= hi out lo end
    var range = hi - lo
    out lo + (rng_next_u64(r) % range)
end

func rng_range_usize(r: &Rng, lo: usize, hi: usize) -> usize
    if lo >= hi out lo end
    var range = hi - lo
    out lo + (rng_next_u64(r) % range)
end

func rng_range_f64(r: &Rng, lo: f64, hi: f64) -> f64
    # [lo, hi)
    out lo + rng_next_f64(r) * (hi - lo)
end

# ─── Utilities ────────────────────────────────────────

func rng_shuffle(r: &Rng, v: &Vec<T>)
    # Fisher-Yates shuffle.
    var n = vec_len(*v)
    if n <= 1 out end
    var i = n - 1
    lặp_khi i > 0
        var j = rng_range_usize(r, 0, i + 1)
        var tmp = vec_get(*v, i)
        vec_set(v, i, vec_get(*v, j))
        vec_set(v, j, tmp)
        i = i - 1
    end
end

func rng_choice(r: &Rng, v: Vec<T>) -> T
    var idx = rng_range_usize(r, 0, vec_len(v))
    out vec_get(v, idx)
end

func rng_fill_bytes(r: &Rng, buf: ptr, len: usize)
    var i: usize = 0
    lặp_khi i + 8 <= len
        var val = rng_next_u64(r)
        native_store_u64(buf, i / 8, val)
        i = i + 8
    end
    # Remaining bytes
    if i < len
        var val = rng_next_u64(r)
        lặp_khi i < len
            native_store_u8(buf, i, val & 0xFF)
            val = val >> 8
            i = i + 1
        end
    end
end

# ═══════════════════════════════════════════════════════
# Global RNG (thread-local khi có thread support)
# ═══════════════════════════════════════════════════════

var _global_rng: Rng = rng_from_time()

func random_u64() -> u64
    out rng_next_u64(&_global_rng)
end

func random_i64() -> i64
    out rng_next_i64(&_global_rng)
end

func random_f64() -> f64
    out rng_next_f64(&_global_rng)
end

func random_range(lo: i64, hi: i64) -> i64
    out rng_range_i64(&_global_rng, lo, hi)
end

func random_bool() -> bool
    out rng_next_bool(&_global_rng)
end

func seed_random(seed: u64)
    _global_rng = rng_new(seed)
end
