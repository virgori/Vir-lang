/*
 * vir/str/char.vri — Character Classification & Conversion
 * =========================================================
 * Inspired by C23: <ctype.h> isdigit, isalpha, isalnum, isspace, toupper, tolower
 * Mở rộng: hỗ trợ Unicode category cơ bản.
 *
 * Compiler uses internally: lexer cần phân loại character.
 */

import "vir/core/types" use all

# ═══════════════════════════════════════════════════════
# ASCII Character Classification
# ═══════════════════════════════════════════════════════

func is_digit(c: u32) -> bool
    # '0'..'9'
    out c >= 0x30 and c <= 0x39
end

func is_hex_digit(c: u32) -> bool
    out is_digit(c) or (c >= 0x41 and c <= 0x46) or (c >= 0x61 and c <= 0x66)
end

func is_oct_digit(c: u32) -> bool
    out c >= 0x30 and c <= 0x37
end

func is_bin_digit(c: u32) -> bool
    out c == 0x30 or c == 0x31
end

func is_alpha(c: u32) -> bool
    # 'A'..'Z' or 'a'..'z'
    out (c >= 0x41 and c <= 0x5A) or (c >= 0x61 and c <= 0x7A)
end

func is_alnum(c: u32) -> bool
    out is_alpha(c) or is_digit(c)
end

func is_space(c: u32) -> bool
    # space, tab, newline, carriage return, form feed, vertical tab
    out c == 0x20 or c == 0x09 or c == 0x0A or c == 0x0D or c == 0x0C or c == 0x0B
end

func is_upper(c: u32) -> bool
    out c >= 0x41 and c <= 0x5A
end

func is_lower(c: u32) -> bool
    out c >= 0x61 and c <= 0x7A
end

func is_ascii(c: u32) -> bool
    out c <= 0x7F
end

func is_printable(c: u32) -> bool
    out c >= 0x20 and c <= 0x7E
end

func is_control(c: u32) -> bool
    out c < 0x20 or c == 0x7F
end

func is_punctuation(c: u32) -> bool
    out is_printable(c) and not is_alnum(c) and not is_space(c)
end

func is_identifier_start(c: u32) -> bool
    # Ký tự hợp lệ đầu tên var: chữ cái or '_'
    out is_alpha(c) or c == 0x5F or is_unicode_letter(c)
end

func is_identifier_part(c: u32) -> bool
    # Ký tự hợp lệ in tên var: chữ, số, '_'
    out is_alnum(c) or c == 0x5F or is_unicode_letter(c) or is_unicode_digit(c)
end

# ═══════════════════════════════════════════════════════
# ASCII Character Conversion
# ═══════════════════════════════════════════════════════

func to_upper(c: u32) -> u32
    if is_lower(c) out c - 32 end
    out c
end

func to_lower(c: u32) -> u32
    if is_upper(c) out c + 32 end
    out c
end

func digit_value(c: u32) -> i32
    # '0' -> 0, '9' -> 9, 'a'/'A' -> 10, 'f'/'F' -> 15
    if c >= 0x30 and c <= 0x39 out c - 0x30 end
    if c >= 0x41 and c <= 0x46 out c - 0x41 + 10 end
    if c >= 0x61 and c <= 0x66 out c - 0x61 + 10 end
    out -1  # not phải digit
end

# ═══════════════════════════════════════════════════════
# Unicode (cơ bản — cho CJK and ngôn ngữ tự nhiên)
# ═══════════════════════════════════════════════════════

func is_unicode_letter(c: u32) -> bool
    # CJK Unified Ideographs
    if c >= 0x4E00 and c <= 0x9FFF out true end
    # Hiragana
    if c >= 0x3040 and c <= 0x309F out true end
    # Katakana
    if c >= 0x30A0 and c <= 0x30FF out true end
    # Hangul Syllables
    if c >= 0xAC00 and c <= 0xD7AF out true end
    # Vietnamese diacritics in Latin Extended
    if c >= 0x00C0 and c <= 0x024F out true end
    # Vietnamese Additional
    if c >= 0x1E00 and c <= 0x1EFF out true end
    out false
end

func is_unicode_digit(c: u32) -> bool
    # Only ASCII digits for now
    out is_digit(c)
end

func is_cjk(c: u32) -> bool
    out (c >= 0x4E00 and c <= 0x9FFF) or
           (c >= 0x3400 and c <= 0x4DBF) or
           (c >= 0x20000 and c <= 0x2A6DF) or
           (c >= 0x2A700 and c <= 0x2B73F)
end

func is_hangul(c: u32) -> bool
    out (c >= 0xAC00 and c <= 0xD7AF) or
           (c >= 0x1100 and c <= 0x11FF) or
           (c >= 0x3130 and c <= 0x318F)
end

func is_hiragana(c: u32) -> bool
    out c >= 0x3040 and c <= 0x309F
end

func is_katakana(c: u32) -> bool
    out c >= 0x30A0 and c <= 0x30FF
end
