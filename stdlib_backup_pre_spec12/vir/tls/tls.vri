/*
 * vir/tls/tls.vri — TLS / SSL Wrapper
 * ======================================
 * Inspired by Python: ssl
 *
 * Phase C — wraps native TLS (OpenSSL / LibreSSL / BoringSSL)
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/net/net" use TcpStream

# ═══════════════════════════════════════════════════════
# TLS Context & Configuration
# ═══════════════════════════════════════════════════════

enum TlsVersion
    TLS_1_2 = 0x0303
    TLS_1_3 = 0x0304
end

entity TlsConfig
    _raw:            ptr    # native SSL_CTX*
    min_version:     TlsVersion
    verify_peer:     bool
    ca_file:         Option<String>
    cert_file:       Option<String>
    key_file:        Option<String>
end

func ngoài native_tls_ctx_new() -> ptr
func ngoài native_tls_ctx_free(ctx: ptr)
func ngoài native_tls_ctx_set_min_version(ctx: ptr, ver: i32) -> i32
func ngoài native_tls_ctx_set_verify(ctx: ptr, verify: bool) -> i32
func ngoài native_tls_ctx_load_ca(ctx: ptr, path: ptr, path_len: usize) -> i32
func ngoài native_tls_ctx_load_cert(ctx: ptr, path: ptr, path_len: usize) -> i32
func ngoài native_tls_ctx_load_key(ctx: ptr, path: ptr, path_len: usize) -> i32

func tls_config_new() -> TlsConfig
    out TlsConfig {
        _raw = native_tls_ctx_new(),
        min_version = TlsVersion.TLS_1_2,
        verify_peer = true,
        ca_file = None,
        cert_file = None,
        key_file = None
    }
end

func tls_config_client() -> TlsConfig
    var cfg = tls_config_new()
    cfg.verify_peer = true
    out cfg
end

func tls_config_server(cert_path: String, key_path: String) -> Result<TlsConfig, String>
    var cfg = tls_config_new()
    cfg.cert_file = Some(cert_path)
    cfg.key_file = Some(key_path)
    
    var rc = native_tls_ctx_load_cert(cfg._raw, str_ptr(cert_path), str_byte_len(cert_path))
    if rc != 0 out Err(str_new("failed to load certificate")) end
    
    rc = native_tls_ctx_load_key(cfg._raw, str_ptr(key_path), str_byte_len(key_path))
    if rc != 0 out Err(str_new("failed to load private key")) end
    
    out Ok(cfg)
end

func tls_config_set_ca(cfg: &TlsConfig, ca_path: String) -> Result<void, String>
    var rc = native_tls_ctx_load_ca(cfg._raw, str_ptr(ca_path), str_byte_len(ca_path))
    if rc != 0 out Err(str_new("failed to load CA file")) end
    cfg.ca_file = Some(ca_path)
    out Ok(())
end

func tls_config_free(cfg: &TlsConfig)
    native_tls_ctx_free(cfg._raw)
end

# ═══════════════════════════════════════════════════════
# TLS Stream (wraps TcpStream)
# ═══════════════════════════════════════════════════════

entity TlsStream
    _ssl:   ptr     # native SSL*
    _tcp:   TcpStream
end

func ngoài native_tls_connect(ctx: ptr, fd: i32, hostname: ptr, hostname_len: usize) -> ptr
func ngoài native_tls_accept(ctx: ptr, fd: i32) -> ptr
func ngoài native_tls_read(ssl: ptr, buf: ptr, len: usize) -> i64
func ngoài native_tls_write(ssl: ptr, buf: ptr, len: usize) -> i64
func ngoài native_tls_shutdown(ssl: ptr) -> i32
func ngoài native_tls_free(ssl: ptr)
func ngoài native_tls_peer_cert_subject(ssl: ptr, buf: ptr, buf_len: usize) -> i32
func ngoài native_tls_get_alpn(ssl: ptr, buf: ptr, buf_len: usize) -> i32

# ─── Client ───────────────────────────────────────────

func tls_connect(cfg: &TlsConfig, tcp: TcpStream, hostname: String) -> Result<TlsStream, String>
    var ssl = native_tls_connect(cfg._raw, tcp.fd, str_ptr(hostname), str_byte_len(hostname))
    if ssl == ptr_null()
        out Err(str_new("TLS handshake failed"))
    end
    out Ok(TlsStream { _ssl = ssl, _tcp = tcp })
end

# ─── Server ───────────────────────────────────────────

func tls_accept(cfg: &TlsConfig, tcp: TcpStream) -> Result<TlsStream, String>
    var ssl = native_tls_accept(cfg._raw, tcp.fd)
    if ssl == ptr_null()
        out Err(str_new("TLS accept failed"))
    end
    out Ok(TlsStream { _ssl = ssl, _tcp = tcp })
end

# ─── Read / Write ─────────────────────────────────────

func tls_read(stream: &TlsStream, buf: &[u8], len: usize) -> Result<usize, String>
    var n = native_tls_read(stream._ssl, buf, len)
    if n < 0 out Err(str_new("TLS read error")) end
    out Ok(n)
end

func tls_write(stream: &TlsStream, data: &[u8], len: usize) -> Result<usize, String>
    var n = native_tls_write(stream._ssl, data, len)
    if n < 0 out Err(str_new("TLS write error")) end
    out Ok(n)
end

func tls_write_all(stream: &TlsStream, data: &[u8], len: usize) -> Result<void, String>
    var written: usize = 0
    lặp_khi written < len
        var n = native_tls_write(stream._ssl, &data[written], len - written)
        if n <= 0 out Err(str_new("TLS write error")) end
        written = written + n
    end
    out Ok(())
end

# ─── Shutdown / Info ──────────────────────────────────

func tls_shutdown(stream: &TlsStream)
    native_tls_shutdown(stream._ssl)
end

func tls_close(stream: &TlsStream)
    native_tls_shutdown(stream._ssl)
    native_tls_free(stream._ssl)
    native_socket_close(stream._tcp.fd)
end

func tls_peer_subject(stream: &TlsStream) -> Option<String>
    var buf: [u8; 512]
    var n = native_tls_peer_cert_subject(stream._ssl, &buf, 512)
    if n <= 0 out None end
    out Some(str_from_bytes(&buf, n))
end
