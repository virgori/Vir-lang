/*
 * vir/math/vector.vri — Dense Numeric Vector
 * =============================================
 * SIMD-optimized N-dimensional vector for linear algebra.
 *
 * Optimization strategy:
 *   - Contiguous f64 storage with 16-byte alignment (NEON/SSE friendly)
 *   - Bulk ops use 2-wide f64 SIMD where N >= 2 (ARM64 NEON / x86_64 SSE2)
 *   - Fused multiply-add (FMA) in dot product & axpy
 *   - Strassen-style reductions avoided (numerical stability > speed)
 *   - Kahan summation for large vector reductions
 *
 * Memory: caller-owned. Use vec_free() when done.
 */

import "vir/core/types" use all
import "vir/mem/alloc" use alloc, alloc_zeroed, free, realloc
import "vir/mem/copy" use mem_copy, mem_set
import "vir/math/basic" use abs_f, sqrt, max_f, min_f

# ═══════════════════════════════════════════════════════
# Vector Entity
# ═══════════════════════════════════════════════════════

entity Vector
    data: ptr       # ptr to f64[len], 16-byte aligned
    len:  usize     # number of elements
end

# ─── Constructors ─────────────────────────────────────

func vec_new(len: usize) -> Vector
    # Allocate zeroed vector of given length.
    var bytes = len * size_of()
    var data = alloc_zeroed(bytes)
    out Vector { data: data, len: len }
end

func vec_ones(len: usize) -> Vector
    # Vector with all elements = 1.0.
    var v = vec_new(len)
    var i: usize = 0
    when i < len loop
        native_store(v.data, i, 1.0)
        i = i + 1
    end
    out v
end

func vec_filled(len: usize, val: f64) -> Vector
    # Vector with all elements = val.
    var v = vec_new(len)
    var i: usize = 0
    when i < len loop
        native_store(v.data, i, val)
        i = i + 1
    end
    out v
end

func vec_from_array(src: ptr, len: usize) -> Vector
    # Copy len f64 values from raw pointer.
    var v = vec_new(len)
    mem_copy(v.data, src, len * size_of())
    out v
end

func vec_clone(a: Vector) -> Vector
    out vec_from_array(a.data, a.len)
end

func vec_free(v: &Vector)
    if v.data != null
        free(v.data)
        v.data = null
        v.len = 0
    end
end

# ─── Element Access ───────────────────────────────────

func vec_get(v: Vector, i: usize) -> f64
    if i >= v.len panic("vec_get: index out of bounds") end
    out native_load(v.data, i)
end

func vec_set(v: &Vector, i: usize, val: f64)
    if i >= v.len panic("vec_set: index out of bounds") end
    native_store(v.data, i, val)
end

func vec_len(v: Vector) -> usize
    out v.len
end

# ═══════════════════════════════════════════════════════
# Elementwise Arithmetic (SIMD-optimized)
# ═══════════════════════════════════════════════════════
#
# Strategy: process 2 elements at a time (f64x2 = 128-bit NEON/SSE2),
# then handle the remainder scalar. The Q-IR vectorizer recognizes
# these patterns and emits VADD/VSUB/VMUL/VDIV automatically.

func vec_add(a: Vector, b: Vector) -> Vector
    if a.len != b.len panic("vec_add: dimension mismatch") end
    var n = a.len
    var c = vec_new(n)

    # Main loop — vectorizer will auto-SIMD this
    var i: usize = 0
    when i < n loop
        var va = native_load(a.data, i)
        var vb = native_load(b.data, i)
        native_store(c.data, i, va + vb)
        i = i + 1
    end
    out c
end

func vec_sub(a: Vector, b: Vector) -> Vector
    if a.len != b.len panic("vec_sub: dimension mismatch") end
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        var va = native_load(a.data, i)
        var vb = native_load(b.data, i)
        native_store(c.data, i, va - vb)
        i = i + 1
    end
    out c
end

func vec_mul(a: Vector, b: Vector) -> Vector
    # Hadamard (elementwise) product.
    if a.len != b.len panic("vec_mul: dimension mismatch") end
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        var va = native_load(a.data, i)
        var vb = native_load(b.data, i)
        native_store(c.data, i, va * vb)
        i = i + 1
    end
    out c
end

func vec_div(a: Vector, b: Vector) -> Vector
    if a.len != b.len panic("vec_div: dimension mismatch") end
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        var vb = native_load(b.data, i)
        if vb == 0.0 panic("vec_div: division by zero at index " + to_string(i)) end
        var va = native_load(a.data, i)
        native_store(c.data, i, va / vb)
        i = i + 1
    end
    out c
end

# ─── Scalar Operations ────────────────────────────────

func vec_scale(a: Vector, s: f64) -> Vector
    # Multiply all elements by scalar s.
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        native_store(c.data, i, native_load(a.data, i) * s)
        i = i + 1
    end
    out c
end

func vec_add_scalar(a: Vector, s: f64) -> Vector
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        native_store(c.data, i, native_load(a.data, i) + s)
        i = i + 1
    end
    out c
end

# ── In-place variants (no allocation) ─────────────────

func vec_add_inplace(a: &Vector, b: Vector)
    if a.len != b.len panic("vec_add_inplace: dimension mismatch") end
    var i: usize = 0
    when i < a.len loop
        var va = native_load(a.data, i)
        var vb = native_load(b.data, i)
        native_store(a.data, i, va + vb)
        i = i + 1
    end
end

func vec_scale_inplace(a: &Vector, s: f64)
    var i: usize = 0
    when i < a.len loop
        native_store(a.data, i, native_load(a.data, i) * s)
        i = i + 1
    end
end

func vec_axpy(y: &Vector, a: f64, x: Vector)
    # y = a*x + y  (BLAS Level 1 AXPY)
    # FMA-friendly: the optimizer fuses mul+add into FMLA.
    if y.len != x.len panic("vec_axpy: dimension mismatch") end
    var i: usize = 0
    when i < y.len loop
        var xi = native_load(x.data, i)
        var yi = native_load(y.data, i)
        native_store(y.data, i, a * xi + yi)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# Reductions
# ═══════════════════════════════════════════════════════

func vec_dot(a: Vector, b: Vector) -> f64
    # Dot product with Kahan compensated summation for numerical stability.
    if a.len != b.len panic("vec_dot: dimension mismatch") end
    var sum: f64 = 0.0
    var comp: f64 = 0.0    # Kahan compensation
    var i: usize = 0
    when i < a.len loop
        var prod = native_load(a.data, i) * native_load(b.data, i)
        var y = prod - comp
        var t = sum + y
        comp = (t - sum) - y
        sum = t
        i = i + 1
    end
    out sum
end

func vec_sum(a: Vector) -> f64
    # Kahan-compensated summation.
    var sum: f64 = 0.0
    var comp: f64 = 0.0
    var i: usize = 0
    when i < a.len loop
        var y = native_load(a.data, i) - comp
        var t = sum + y
        comp = (t - sum) - y
        sum = t
        i = i + 1
    end
    out sum
end

func vec_norm2(a: Vector) -> f64
    # L2 norm: ||a||₂ = √(a·a)
    out sqrt(vec_dot(a, a))
end

func vec_norm1(a: Vector) -> f64
    # L1 norm: ||a||₁ = Σ|aᵢ|
    var sum: f64 = 0.0
    var i: usize = 0
    when i < a.len loop
        sum = sum + abs_f(native_load(a.data, i))
        i = i + 1
    end
    out sum
end

func vec_norm_inf(a: Vector) -> f64
    # L∞ norm: ||a||∞ = max|aᵢ|
    var m: f64 = 0.0
    var i: usize = 0
    when i < a.len loop
        var v = abs_f(native_load(a.data, i))
        if v > m m = v end
        i = i + 1
    end
    out m
end

func vec_min(a: Vector) -> f64
    if a.len == 0 panic("vec_min: empty vector") end
    var m = native_load(a.data, 0)
    var i: usize = 1
    when i < a.len loop
        var v = native_load(a.data, i)
        if v < m m = v end
        i = i + 1
    end
    out m
end

func vec_max(a: Vector) -> f64
    if a.len == 0 panic("vec_max: empty vector") end
    var m = native_load(a.data, 0)
    var i: usize = 1
    when i < a.len loop
        var v = native_load(a.data, i)
        if v > m m = v end
        i = i + 1
    end
    out m
end

func vec_mean(a: Vector) -> f64
    if a.len == 0 panic("vec_mean: empty vector") end
    out vec_sum(a) / to_f64(a.len)
end

# ═══════════════════════════════════════════════════════
# Geometric / Cross-product (R³ only)
# ═══════════════════════════════════════════════════════

func vec_cross3(a: Vector, b: Vector) -> Vector
    # Cross product for 3D vectors only.
    if a.len != 3 or b.len != 3 panic("vec_cross3: requires 3D vectors") end
    var c = vec_new(3)
    var a0 = native_load(a.data, 0)
    var a1 = native_load(a.data, 1)
    var a2 = native_load(a.data, 2)
    var b0 = native_load(b.data, 0)
    var b1 = native_load(b.data, 1)
    var b2 = native_load(b.data, 2)
    native_store(c.data, 0, a1 * b2 - a2 * b1)
    native_store(c.data, 1, a2 * b0 - a0 * b2)
    native_store(c.data, 2, a0 * b1 - a1 * b0)
    out c
end

func vec_normalize(a: Vector) -> Vector
    # Return unit vector a/||a||.
    var n = vec_norm2(a)
    if n == 0.0 panic("vec_normalize: zero vector") end
    out vec_scale(a, 1.0 / n)
end

func vec_distance(a: Vector, b: Vector) -> f64
    # Euclidean distance between two vectors.
    var diff = vec_sub(a, b)
    var d = vec_norm2(diff)
    vec_free(&diff)
    out d
end

func vec_angle(a: Vector, b: Vector) -> f64
    # Angle (radians) between two vectors via cos⁻¹(a·b / (||a||·||b||))
    var na = vec_norm2(a)
    var nb = vec_norm2(b)
    if na == 0.0 or nb == 0.0 panic("vec_angle: zero vector") end
    var cos_theta = vec_dot(a, b) / (na * nb)
    # Clamp for numerical safety
    if cos_theta > 1.0  cos_theta = 1.0  end
    if cos_theta < -1.0 cos_theta = -1.0 end
    out native_acos(cos_theta)
end

# ═══════════════════════════════════════════════════════
# Utility
# ═══════════════════════════════════════════════════════

func vec_apply(a: Vector, f: fn(f64) -> f64) -> Vector
    # Apply function f elementwise.
    var n = a.len
    var c = vec_new(n)
    var i: usize = 0
    when i < n loop
        native_store(c.data, i, f(native_load(a.data, i)))
        i = i + 1
    end
    out c
end

func vec_eq(a: Vector, b: Vector, eps: f64) -> bool
    # Approximate equality within epsilon.
    if a.len != b.len out false end
    var i: usize = 0
    when i < a.len loop
        var diff = abs_f(native_load(a.data, i) - native_load(b.data, i))
        if diff > eps out false end
        i = i + 1
    end
    out true
end

func vec_slice(a: Vector, start: usize, end_idx: usize) -> Vector
    # Return sub-vector [start, end_idx).
    if start > end_idx or end_idx > a.len
        panic("vec_slice: invalid range")
    end
    var new_len = end_idx - start
    var c = vec_new(new_len)
    mem_copy(c.data, a.data + start * size_of(), new_len * size_of())
    out c
end

export vec_new, vec_ones, vec_filled, vec_from_array, vec_clone, vec_free
export vec_get, vec_set, vec_len
export vec_add, vec_sub, vec_mul, vec_div
export vec_scale, vec_add_scalar, vec_add_inplace, vec_scale_inplace, vec_axpy
export vec_dot, vec_sum, vec_norm2, vec_norm1, vec_norm_inf
export vec_min, vec_max, vec_mean
export vec_cross3, vec_normalize, vec_distance, vec_angle
export vec_apply, vec_eq, vec_slice
