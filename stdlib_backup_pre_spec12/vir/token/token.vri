/*
 * vir/token/token.vri — Lexer / Tokenizer for Vir
 * ==================================================
 * Phase D — self-hosting compiler: tokenization
 *
 * Multilingual keyword support: Vietnamese, English aliases
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_eq, str_byte_at, str_byte_len, str_slice_bytes
import "vir/str/char" use is_digit, is_alpha, is_alnum, is_space
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get
import "vir/ast/ast" use Span, span_new

# ═══════════════════════════════════════════════════════
# Token Types
# ═══════════════════════════════════════════════════════

enum TokenKind
    # Literals
    IntLiteral      = 1
    FloatLiteral    = 2
    StringLiteral   = 3
    CharLiteral     = 4
    BoolLiteral     = 5
    
    # Identifier & Keywords
    Ident           = 10
    
    # Keywords (Vietnamese primary)
    KwHàm           = 20   # func / fn / func
    KwBiến          = 21   # var / let / var
    KwHằngSố        = 22   # hằng_số / const
    KwNếu           = 23   # if / if
    KwHoặcNếu       = 24   # eif / elif / else if
    KwNgượcLại      = 25   # else / else
    KwLặpKhi        = 26   # lặp_khi / while
    KwLặp           = 27   # loop / loop
    KwLặpCho        = 28   # lặp_cho / for
    KwTrảVề         = 29   # out / return
    KwThoát         = 30   # thoát / break
    KwTiếpTục       = 31   # tiếp_tục / continue
    KwBảnGhi        = 32   # entity / struct
    KwLiệtKê        = 33   # enum / enum
    KwNhập          = 34   # import / import
    KwDùng          = 35   # use / use
    KwDùngHết       = 36   # use all
    KwThì           = 37   # / then
    KwHết           = 38   # end / end
    KwChọn          = 39   # chọn / match
    KwTrườngHợp     = 40   # case / case
    KwMặcĐịnh       = 41   # mặc_định / default
    KwĐúng          = 42   # true / true
    KwSai           = 43   # false / false
    KwVà            = 44   # and / and
    KwHoặc          = 45   # or / or
    KwNgoài         = 46   # ngoài / extern
    KwNhư           = 47   # as / as
    KwTrong         = 48   # in / in
    
    # Operators
    Plus            = 60   # +
    Minus           = 61   # -
    Star            = 62   # *
    Slash           = 63   # /
    Percent         = 64   # %
    Ampersand       = 65   # &
    Pipe            = 66   # |
    Caret           = 67   # ^
    Tilde           = 68   # ~
    Bang            = 69   # !
    Eq              = 70   # =
    EqEq            = 71   # ==
    BangEq          = 72   # !=
    Lt              = 73   # <
    Le              = 74   # <=
    Gt              = 75   # >
    Ge              = 76   # >=
    Arrow           = 77   # ->  or ->
    FatArrow        = 78   # =>
    PlusEq          = 79   # +=
    MinusEq         = 80   # -=
    StarEq          = 81   # *=
    SlashEq         = 82   # /=
    Shl             = 83   # <<
    Shr             = 84   # >>
    DotDot          = 85   # ..
    
    # Delimiters
    LParen          = 90   # (
    RParen          = 91   # )
    LBracket        = 92   # [
    RBracket        = 93   # ]
    LBrace          = 94   # {
    RBrace          = 95   # }
    
    # Punctuation
    Comma           = 100  # ,
    Dot             = 101  # .
    Colon           = 102  # :
    Semicolon       = 103  # 
    Hash            = 104  # #
    At              = 105  # @
    
    # Special
    Newline         = 110
    EOF             = 111
    Error           = 112
end

entity Token
    kind:  TokenKind
    text:  String
    span:  Span
end

# ═══════════════════════════════════════════════════════
# Lexer
# ═══════════════════════════════════════════════════════

entity Lexer
    source:   String
    file:     String
    pos:      usize
    line:     u32
    col:      u32
    keywords: Map<String, TokenKind>
end

func lexer_new(source: String, file: String) -> Lexer
    var kw = _build_keyword_map()
    out Lexer {
        source = source, file = file,
        pos = 0, line = 1, col = 1,
        keywords = kw
    }
end

func _build_keyword_map() -> Map<String, TokenKind>
    var m = map_new()
    # Vietnamese keywords
    map_set(&m, str_new("func"), TokenKind.KwHàm)
    map_set(&m, str_new("var"), TokenKind.KwBiến)
    map_set(&m, str_new("hằng_số"), TokenKind.KwHằngSố)
    map_set(&m, str_new("if"), TokenKind.KwNếu)
    map_set(&m, str_new("eif"), TokenKind.KwHoặcNếu)
    map_set(&m, str_new("else"), TokenKind.KwNgượcLại)
    map_set(&m, str_new("lặp_khi"), TokenKind.KwLặpKhi)
    map_set(&m, str_new("loop"), TokenKind.KwLặp)
    map_set(&m, str_new("lặp_cho"), TokenKind.KwLặpCho)
    map_set(&m, str_new("out"), TokenKind.KwTrảVề)
    map_set(&m, str_new("out"), TokenKind.KwTrảVề)
    map_set(&m, str_new("thoát"), TokenKind.KwThoát)
    map_set(&m, str_new("tiếp_tục"), TokenKind.KwTiếpTục)
    map_set(&m, str_new("entity"), TokenKind.KwBảnGhi)
    map_set(&m, str_new("enum"), TokenKind.KwLiệtKê)
    map_set(&m, str_new("import"), TokenKind.KwNhập)
    map_set(&m, str_new("use"), TokenKind.KwDùng)
    map_set(&m, str_new(""), TokenKind.KwThì)
    map_set(&m, str_new("end"), TokenKind.KwHết)
    map_set(&m, str_new("chọn"), TokenKind.KwChọn)
    map_set(&m, str_new("case"), TokenKind.KwTrườngHợp)
    map_set(&m, str_new("mặc_định"), TokenKind.KwMặcĐịnh)
    map_set(&m, str_new("true"), TokenKind.KwĐúng)
    map_set(&m, str_new("false"), TokenKind.KwSai)
    map_set(&m, str_new("and"), TokenKind.KwVà)
    map_set(&m, str_new("or"), TokenKind.KwHoặc)
    map_set(&m, str_new("ngoài"), TokenKind.KwNgoài)
    map_set(&m, str_new("as"), TokenKind.KwNhư)
    map_set(&m, str_new("in"), TokenKind.KwTrong)
    
    # English aliases
    map_set(&m, str_new("fn"), TokenKind.KwHàm)
    map_set(&m, str_new("let"), TokenKind.KwBiến)
    map_set(&m, str_new("const"), TokenKind.KwHằngSố)
    map_set(&m, str_new("if"), TokenKind.KwNếu)
    map_set(&m, str_new("else"), TokenKind.KwNgượcLại)
    map_set(&m, str_new("while"), TokenKind.KwLặpKhi)
    map_set(&m, str_new("loop"), TokenKind.KwLặp)
    map_set(&m, str_new("for"), TokenKind.KwLặpCho)
    map_set(&m, str_new("return"), TokenKind.KwTrảVề)
    map_set(&m, str_new("break"), TokenKind.KwThoát)
    map_set(&m, str_new("continue"), TokenKind.KwTiếpTục)
    map_set(&m, str_new("struct"), TokenKind.KwBảnGhi)
    map_set(&m, str_new("enum"), TokenKind.KwLiệtKê)
    map_set(&m, str_new("import"), TokenKind.KwNhập)
    map_set(&m, str_new("match"), TokenKind.KwChọn)
    map_set(&m, str_new("true"), TokenKind.KwĐúng)
    map_set(&m, str_new("false"), TokenKind.KwSai)
    map_set(&m, str_new("extern"), TokenKind.KwNgoài)
    
    out m
end

# ─── Core Lexer Methods ──────────────────────────────

func lexer_tokenize(lex: &Lexer) -> Vec<Token>
    var tokens = vec_new()
    loop
        var tok = _next_token(lex)
        var is_eof = tok.kind == TokenKind.EOF
        vec_push(&tokens, tok)
        if is_eof thoát end
    end
    out tokens
end

func _next_token(lex: &Lexer) -> Token
    _skip_whitespace_and_comments(lex)
    
    var len = str_byte_len(lex.source)
    if lex.pos >= len
        out Token {
            kind = TokenKind.EOF,
            text = str_new(""),
            span = span_new(lex.file, lex.line, lex.col, lex.pos, lex.pos)
        }
    end
    
    var start = lex.pos
    var start_line = lex.line
    var start_col = lex.col
    var ch = str_byte_at(lex.source, lex.pos)
    
    # String literal
    if ch == 0x22 out _lex_string(lex, start, start_line, start_col) end
    
    # Number literal
    if is_digit(ch) out _lex_number(lex, start, start_line, start_col) end
    
    # Identifier / keyword (including UTF-8 multibyte)
    if is_alpha(ch) or ch == 0x5F or ch >= 0x80
        out _lex_ident(lex, start, start_line, start_col)
    end
    
    # Operators and delimiters
    out _lex_operator(lex, start, start_line, start_col)
end

func _skip_whitespace_and_comments(lex: &Lexer)
    var len = str_byte_len(lex.source)
    lặp_khi lex.pos < len
        var ch = str_byte_at(lex.source, lex.pos)
        if ch == 0x20 or ch == 0x09 or ch == 0x0D
            lex.pos = lex.pos + 1
            lex.col = lex.col + 1
        eif ch == 0x0A
            lex.pos = lex.pos + 1
            lex.line = lex.line + 1
            lex.col = 1
        eif ch == 0x23 # # comment
            lặp_khi lex.pos < len and str_byte_at(lex.source, lex.pos) != 0x0A
                lex.pos = lex.pos + 1
            end
        eif ch == 0x2F and lex.pos + 1 < len
            var next = str_byte_at(lex.source, lex.pos + 1)
            if next == 0x2F # // comment
                lặp_khi lex.pos < len and str_byte_at(lex.source, lex.pos) != 0x0A
                    lex.pos = lex.pos + 1
                end
            eif next == 0x2A # /* block comment */
                lex.pos = lex.pos + 2
                lặp_khi lex.pos + 1 < len
                    if str_byte_at(lex.source, lex.pos) == 0x2A and str_byte_at(lex.source, lex.pos + 1) == 0x2F
                        lex.pos = lex.pos + 2
                        thoát
                    end
                    if str_byte_at(lex.source, lex.pos) == 0x0A
                        lex.line = lex.line + 1
                        lex.col = 1
                    end
                    lex.pos = lex.pos + 1
                end
            else thoát end
        else thoát end
    end
end

func _lex_string(lex: &Lexer, start: usize, sl: u32, sc: u32) -> Token
    lex.pos = lex.pos + 1   # skip opening "
    var len = str_byte_len(lex.source)
    
    lặp_khi lex.pos < len
        var ch = str_byte_at(lex.source, lex.pos)
        if ch == 0x22 # closing "
            lex.pos = lex.pos + 1
            lex.col = lex.col + (lex.pos - start)
            out Token {
                kind = TokenKind.StringLiteral,
                text = str_slice_bytes(lex.source, start, lex.pos),
                span = span_new(lex.file, sl, sc, start, lex.pos)
            }
        end
        if ch == 0x5C lex.pos = lex.pos + 1 end   # skip escaped char
        lex.pos = lex.pos + 1
    end
    
    out Token {
        kind = TokenKind.Error,
        text = str_new("unterminated string"),
        span = span_new(lex.file, sl, sc, start, lex.pos)
    }
end

func _lex_number(lex: &Lexer, start: usize, sl: u32, sc: u32) -> Token
    var len = str_byte_len(lex.source)
    var is_float = false
    
    # Check hex: 0x
    if lex.pos + 1 < len and str_byte_at(lex.source, lex.pos) == 0x30
        var next = str_byte_at(lex.source, lex.pos + 1)
        if next == 0x78 or next == 0x58 # 0x / 0X
            lex.pos = lex.pos + 2
            lặp_khi lex.pos < len
                var ch = str_byte_at(lex.source, lex.pos)
                if !((ch >= 0x30 and ch <= 0x39) or (ch >= 0x61 and ch <= 0x66) or (ch >= 0x41 and ch <= 0x46)) thoát end
                lex.pos = lex.pos + 1
            end
            lex.col = lex.col + (lex.pos - start)
            out Token {
                kind = TokenKind.IntLiteral,
                text = str_slice_bytes(lex.source, start, lex.pos),
                span = span_new(lex.file, sl, sc, start, lex.pos)
            }
        end
    end
    
    lặp_khi lex.pos < len
        var ch = str_byte_at(lex.source, lex.pos)
        if ch == 0x2E and !is_float
            is_float = true
            lex.pos = lex.pos + 1
        eif is_digit(ch)
            lex.pos = lex.pos + 1
        eif ch == 0x65 or ch == 0x45 # e / E
            is_float = true
            lex.pos = lex.pos + 1
            if lex.pos < len and (str_byte_at(lex.source, lex.pos) == 0x2B or str_byte_at(lex.source, lex.pos) == 0x2D)
                lex.pos = lex.pos + 1
            end
        else thoát end
    end
    
    lex.col = lex.col + (lex.pos - start)
    out Token {
        kind = if is_float TokenKind.FloatLiteral else TokenKind.IntLiteral end,
        text = str_slice_bytes(lex.source, start, lex.pos),
        span = span_new(lex.file, sl, sc, start, lex.pos)
    }
end

func _lex_ident(lex: &Lexer, start: usize, sl: u32, sc: u32) -> Token
    var len = str_byte_len(lex.source)
    
    lặp_khi lex.pos < len
        var ch = str_byte_at(lex.source, lex.pos)
        if is_alnum(ch) or ch == 0x5F or ch >= 0x80
            lex.pos = lex.pos + 1
        else thoát end
    end
    
    var text = str_slice_bytes(lex.source, start, lex.pos)
    lex.col = lex.col + (lex.pos - start)
    
    # Check keyword
    var kw = map_get(lex.keywords, text)
    var kind = chọn kw
        case Some(k) k
        case None TokenKind.Ident
    end
    
    out Token {
        kind = kind,
        text = text,
        span = span_new(lex.file, sl, sc, start, lex.pos)
    }
end

func _lex_operator(lex: &Lexer, start: usize, sl: u32, sc: u32) -> Token
    var ch = str_byte_at(lex.source, lex.pos)
    var len = str_byte_len(lex.source)
    lex.pos = lex.pos + 1
    lex.col = lex.col + 1
    
    var kind: TokenKind
    
    chọn ch
        case 0x28 kind = TokenKind.LParen
        case 0x29 kind = TokenKind.RParen
        case 0x5B kind = TokenKind.LBracket
        case 0x5D kind = TokenKind.RBracket
        case 0x7B kind = TokenKind.LBrace
        case 0x7D kind = TokenKind.RBrace
        case 0x2C kind = TokenKind.Comma
        case 0x2E
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x2E
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.DotDot
            else kind = TokenKind.Dot end
        case 0x3A kind = TokenKind.Colon
        case 0x3B kind = TokenKind.Semicolon
        case 0x40 kind = TokenKind.At
        case 0x2B
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.PlusEq
            else kind = TokenKind.Plus end
        case 0x2D
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3E
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.Arrow
            eif lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.MinusEq
            else kind = TokenKind.Minus end
        case 0x2A
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.StarEq
            else kind = TokenKind.Star end
        case 0x2F
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.SlashEq
            else kind = TokenKind.Slash end
        case 0x25 kind = TokenKind.Percent
        case 0x26 kind = TokenKind.Ampersand
        case 0x7C kind = TokenKind.Pipe
        case 0x5E kind = TokenKind.Caret
        case 0x7E kind = TokenKind.Tilde
        case 0x21
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.BangEq
            else kind = TokenKind.Bang end
        case 0x3D
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.EqEq
            eif lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3E
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.FatArrow
            else kind = TokenKind.Eq end
        case 0x3C
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.Le
            eif lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3C
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.Shl
            else kind = TokenKind.Lt end
        case 0x3E
            if lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3D
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.Ge
            eif lex.pos < len and str_byte_at(lex.source, lex.pos) == 0x3E
                lex.pos = lex.pos + 1; lex.col = lex.col + 1
                kind = TokenKind.Shr
            else kind = TokenKind.Gt end
        mặc_định
            # Check for -> (UTF-8: E2 86 92)
            if ch == 0xE2 and lex.pos + 1 < len
                if str_byte_at(lex.source, lex.pos) == 0x86 and str_byte_at(lex.source, lex.pos + 1) == 0x92
                    lex.pos = lex.pos + 2
                    lex.col = lex.col + 1
                    kind = TokenKind.Arrow
                else kind = TokenKind.Error end
            else kind = TokenKind.Error end
    end
    
    out Token {
        kind = kind,
        text = str_slice_bytes(lex.source, start, lex.pos),
        span = span_new(lex.file, sl, sc, start, lex.pos)
    }
end
