/*
 * vir/test/test.vri — Test Framework
 * =====================================
 * Inspired by Python: unittest, pytest
 * 
 * Minimal test framework cho Vir stdlib and user code.
 * Chạy test cases, report pass/fail.
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat, str_eq
import "vir/io/stdio" use println, eprintln
import "vir/io/format" use format_int
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/time/time" use Instant, now, elapsed, duration_to_millis

# ═══════════════════════════════════════════════════════
# Test Case
# ═══════════════════════════════════════════════════════

enum TestResult
    Pass    = 0
    Fail    = 1
    Skip    = 2
    Error   = 3
end

entity TestCase
    name:    String
    func:    func() -> TestResult
    result:  TestResult
    message: String
    time_ms: f64
end

entity TestSuite
    name:  String
    tests: Vec<TestCase>
end

entity TestReport
    total:   usize
    passed:  usize
    failed:  usize
    skipped: usize
    errors:  usize
    time_ms: f64
end

# ═══════════════════════════════════════════════════════
# Test Suite Builder
# ═══════════════════════════════════════════════════════

func suite_new(name: String) -> TestSuite
    out TestSuite { name = name, tests = vec_new() }
end

func suite_add(s: &TestSuite, name: String, func: func() -> TestResult)
    vec_push(&s.tests, TestCase {
        name = name,
        func = func,
        result = TestResult.Pass,
        message = str_new(""),
        time_ms = 0.0
    })
end

# ═══════════════════════════════════════════════════════
# Test Runner
# ═══════════════════════════════════════════════════════

func suite_run(s: &TestSuite) -> TestReport
    var report = TestReport {
        total = 0, passed = 0, failed = 0,
        skipped = 0, errors = 0, time_ms = 0.0
    }
    
    println(str_concat(str_new("═══ Running: "), s.name))
    var suite_start = now()
    
    var i: usize = 0
    lặp_khi i < vec_len(s.tests)
        var tc = vec_get(s.tests, i)
        report.total = report.total + 1
        
        var start = now()
        var result = tc.func()
        var elapsed_ms = duration_to_millis(elapsed(start))
        
        tc.result = result
        tc.time_ms = elapsed_ms
        vec_set(&s.tests, i, tc)
        
        chọn result
            case TestResult.Pass
                report.passed = report.passed + 1
                println(str_concat(str_new("  ✓ "), tc.name))
            case TestResult.Fail
                report.failed = report.failed + 1
                eprintln(str_concat(str_new("  ✗ "), tc.name))
            case TestResult.Skip
                report.skipped = report.skipped + 1
                println(str_concat(str_new("  ○ "), str_concat(tc.name, str_new(" (skipped)"))))
            case TestResult.Error
                report.errors = report.errors + 1
                eprintln(str_concat(str_new("  ⚠ "), str_concat(tc.name, str_new(" (error)"))))
        end
        
        i = i + 1
    end
    
    report.time_ms = duration_to_millis(elapsed(suite_start))
    
    # Summary
    println(str_new("───"))
    println(str_concat(
        str_concat(format_int(report.passed, 10), str_new(" passed, ")),
        str_concat(
            str_concat(format_int(report.failed, 10), str_new(" failed, ")),
            str_concat(
                str_concat(format_int(report.skipped, 10), str_new(" skipped, ")),
                str_concat(format_int(report.errors, 10), str_new(" errors"))
            )
        )
    ))
    
    out report
end

func report_ok(r: TestReport) -> bool
    out r.failed == 0 and r.errors == 0
end

# ═══════════════════════════════════════════════════════
# Test Helpers — use in test functions
# ═══════════════════════════════════════════════════════

func pass() -> TestResult
    out TestResult.Pass
end

func fail() -> TestResult
    out TestResult.Fail
end

func skip() -> TestResult
    out TestResult.Skip
end

func expect_true(cond: bool) -> TestResult
    if cond out TestResult.Pass end
    out TestResult.Fail
end

func expect_false(cond: bool) -> TestResult
    if !cond out TestResult.Pass end
    out TestResult.Fail
end

func expect_eq_i64(a: i64, b: i64) -> TestResult
    if a == b out TestResult.Pass end
    eprintln(str_concat(
        str_new("    expected: "),
        str_concat(format_int(a, 10),
            str_concat(str_new(" == "), format_int(b, 10)))
    ))
    out TestResult.Fail
end

func expect_eq_str(a: String, b: String) -> TestResult
    if str_eq(a, b) out TestResult.Pass end
    eprintln(str_concat(
        str_new("    expected: \""),
        str_concat(a, str_concat(str_new("\" == \""), str_concat(b, str_new("\""))))
    ))
    out TestResult.Fail
end

func expect_ne_i64(a: i64, b: i64) -> TestResult
    if a != b out TestResult.Pass end
    out TestResult.Fail
end

# ═══════════════════════════════════════════════════════
# Multi-suite runner
# ═══════════════════════════════════════════════════════

func run_all_suites(suites: Vec<TestSuite>) -> TestReport
    var total = TestReport {
        total = 0, passed = 0, failed = 0,
        skipped = 0, errors = 0, time_ms = 0.0
    }
    
    println(str_new("╔══════════════════════════════════╗"))
    println(str_new("║     Vir Standard Library Tests    ║"))
    println(str_new("╚══════════════════════════════════╝"))
    println(str_new(""))
    
    var i: usize = 0
    lặp_khi i < vec_len(suites)
        var s = vec_get(suites, i)
        var r = suite_run(&s)
        total.total = total.total + r.total
        total.passed = total.passed + r.passed
        total.failed = total.failed + r.failed
        total.skipped = total.skipped + r.skipped
        total.errors = total.errors + r.errors
        total.time_ms = total.time_ms + r.time_ms
        println(str_new(""))
        i = i + 1
    end
    
    println(str_new("════════════════════════════════════"))
    if report_ok(total)
        println(str_concat(str_new("ALL PASS: "), str_concat(format_int(total.passed, 10), str_new(" tests"))))
    else
        eprintln(str_concat(str_new("FAILURES: "), format_int(total.failed + total.errors, 10)))
    end
    
    out total
end
