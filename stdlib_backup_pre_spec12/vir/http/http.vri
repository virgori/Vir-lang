/*
 * vir/http/http.vri — HTTP/1.1 Client & Server
 * ===============================================
 * Inspired by Python: http.client, http.server, urllib
 *
 * Phase C — minimal HTTP built on vir/net/net
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_concat, str_contains, str_find, str_slice_bytes, str_byte_len, str_eq
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_keys
import "vir/net/net" use TcpStream, tcp_connect, tcp_read, tcp_write_all, tcp_close, SocketAddr, socket_addr, dns_resolve

# ═══════════════════════════════════════════════════════
# HTTP Method & Status
# ═══════════════════════════════════════════════════════

enum Method
    GET     = 1
    POST    = 2
    PUT     = 3
    DELETE  = 4
    PATCH   = 5
    HEAD    = 6
    OPTIONS = 7
end

func method_to_string(m: Method) -> String
    chọn m
        case Method.GET     out str_new("GET")
        case Method.POST    out str_new("POST")
        case Method.PUT     out str_new("PUT")
        case Method.DELETE  out str_new("DELETE")
        case Method.PATCH   out str_new("PATCH")
        case Method.HEAD    out str_new("HEAD")
        case Method.OPTIONS out str_new("OPTIONS")
    end
end

entity StatusCode
    code:   u16
    reason: String
end

func status(code: u16, reason: String) -> StatusCode
    out StatusCode { code = code, reason = reason }
end

func status_ok() -> StatusCode out status(200, str_new("OK")) end
func status_not_found() -> StatusCode out status(404, str_new("Not Found")) end
func status_internal_error() -> StatusCode out status(500, str_new("Internal Server Error")) end

# Headers = Map<String, String>
func headers_new() -> Map<String, String>
    out map_new()
end

# ═══════════════════════════════════════════════════════
# HTTP Request
# ═══════════════════════════════════════════════════════

entity Request
    method:  Method
    url:     String
    headers: Map<String, String>
    body:    Option<String>
end

func request_new(method: Method, url: String) -> Request
    out Request {
        method = method,
        url = url,
        headers = headers_new(),
        body = None
    }
end

func request_header(req: &Request, key: String, value: String) -> &Request
    map_set(&req.headers, key, value)
    out req
end

func request_body(req: &Request, body: String) -> &Request
    req.body = Some(body)
    out req
end

# ═══════════════════════════════════════════════════════
# HTTP Response
# ═══════════════════════════════════════════════════════

entity Response
    status:  StatusCode
    headers: Map<String, String>
    body:    String
end

# ═══════════════════════════════════════════════════════
# URL Parsing (minimal)
# ═══════════════════════════════════════════════════════

entity Url
    scheme: String     # "http" | "https"
    host:   String
    port:   u16
    path:   String
end

func parse_url(raw: String) -> Result<Url, String>
    var scheme = str_new("http")
    var rest = raw
    var default_port: u16 = 80
    
    if str_starts_with(raw, str_new("https://"))
        scheme = str_new("https")
        rest = str_slice_bytes(raw, 8, str_byte_len(raw))
        default_port = 443
    eif str_starts_with(raw, str_new("http://"))
        rest = str_slice_bytes(raw, 7, str_byte_len(raw))
    end
    
    # Tìm path
    var slash_idx = str_find(rest, str_new("/"))
    var host_part: String
    var path: String
    chọn slash_idx
        case Some(idx)
            host_part = str_slice_bytes(rest, 0, idx)
            path = str_slice_bytes(rest, idx, str_byte_len(rest))
        case None
            host_part = rest
            path = str_new("/")
    end
    
    # Tìm port
    var port = default_port
    var colon_idx = str_find(host_part, str_new(":"))
    var host: String
    chọn colon_idx
        case Some(idx)
            host = str_slice_bytes(host_part, 0, idx)
            var port_str = str_slice_bytes(host_part, idx + 1, str_byte_len(host_part))
            port = str_to_u16(port_str)
        case None
            host = host_part
    end
    
    out Ok(Url { scheme = scheme, host = host, port = port, path = path })
end

# ═══════════════════════════════════════════════════════
# HTTP Client
# ═══════════════════════════════════════════════════════

func http_send(req: Request) -> Result<Response, String>
    # Parse URL
    var url_result = parse_url(req.url)
    var url: Url
    chọn url_result
        case Err(e) out Err(e)
        case Ok(u) url = u
    end
    
    # DNS resolve
    var addrs_result = dns_resolve(url.host)
    var addrs: Vec<IpAddr>
    chọn addrs_result
        case Err(e) out Err(e)
        case Ok(a) addrs = a
    end
    
    if vec_len(addrs) == 0
        out Err(str_new("no addresses found"))
    end
    
    # Connect
    var addr = socket_addr(vec_get(addrs, 0), url.port)
    var stream_result = tcp_connect(addr)
    var stream: TcpStream
    chọn stream_result
        case Err(e) out Err(e)
        case Ok(s) stream = s
    end
    
    # Build HTTP/1.1 request
    var sb = sb_new()
    sb_append(&sb, method_to_string(req.method))
    sb_append(&sb, str_new(" "))
    sb_append(&sb, url.path)
    sb_append(&sb, str_new(" HTTP/1.1\r\n"))
    sb_append(&sb, str_new("Host: "))
    sb_append(&sb, url.host)
    sb_append(&sb, str_new("\r\n"))
    
    # Default headers
    if !map_contains(&req.headers, str_new("Connection"))
        sb_append(&sb, str_new("Connection: close\r\n"))
    end
    if !map_contains(&req.headers, str_new("User-Agent"))
        sb_append(&sb, str_new("User-Agent: vir-http/0.1\r\n"))
    end
    
    # User headers
    var keys = map_keys(req.headers)
    var i: usize = 0
    lặp_khi i < vec_len(keys)
        var k = vec_get(keys, i)
        var v = map_get(req.headers, k)
        chọn v
            case Some(val)
                sb_append(&sb, k)
                sb_append(&sb, str_new(": "))
                sb_append(&sb, val)
                sb_append(&sb, str_new("\r\n"))
            case None {}
        end
        i = i + 1
    end
    
    # Body
    chọn req.body
        case Some(body)
            sb_append(&sb, str_new("Content-Length: "))
            sb_append(&sb, int_to_string(str_byte_len(body)))
            sb_append(&sb, str_new("\r\n\r\n"))
            sb_append(&sb, body)
        case None
            sb_append(&sb, str_new("\r\n"))
    end
    
    var raw_req = sb_build(sb)
    var send_result = tcp_write_all(&stream, str_ptr(raw_req), str_byte_len(raw_req))
    chọn send_result
        case Err(e)
            tcp_close(&stream)
            out Err(e)
        case Ok(_) {}
    end
    
    # Read response
    var resp_buf: [u8; 65536]
    var total: usize = 0
    loop
        var n_result = tcp_read(&stream, &resp_buf[total], 65536 - total)
        chọn n_result
            case Err(_) thoát
            case Ok(n)
                if n == 0 thoát end
                total = total + n
        end
    end
    tcp_close(&stream)
    
    var raw_resp = str_from_bytes(&resp_buf, total)
    out _parse_response(raw_resp)
end

func _parse_response(raw: String) -> Result<Response, String>
    # Find header/body separator
    var sep_idx = str_find(raw, str_new("\r\n\r\n"))
    var header_end: usize
    var body_start: usize
    chọn sep_idx
        case Some(idx)
            header_end = idx
            body_start = idx + 4
        case None
            out Err(str_new("malformed HTTP response"))
    end
    
    var header_part = str_slice_bytes(raw, 0, header_end)
    var body = str_slice_bytes(raw, body_start, str_byte_len(raw))
    
    # Parse status line: "HTTP/1.1 200 OK"
    var first_line_end = str_find(header_part, str_new("\r\n"))
    var status_line: String
    var headers_rest: String
    chọn first_line_end
        case Some(idx)
            status_line = str_slice_bytes(header_part, 0, idx)
            headers_rest = str_slice_bytes(header_part, idx + 2, str_byte_len(header_part))
        case None
            status_line = header_part
            headers_rest = str_new("")
    end
    
    # Extract status code (bytes 9-12)
    var code_str = str_slice_bytes(status_line, 9, 12)
    var code = str_to_u16(code_str)
    var reason = str_slice_bytes(status_line, 13, str_byte_len(status_line))
    
    # Parse headers
    var headers = headers_new()
    var lines = str_split(headers_rest, str_new("\r\n"))
    var i: usize = 0
    lặp_khi i < vec_len(lines)
        var line = vec_get(lines, i)
        var colon = str_find(line, str_new(": "))
        chọn colon
            case Some(idx)
                var key = str_slice_bytes(line, 0, idx)
                var val = str_slice_bytes(line, idx + 2, str_byte_len(line))
                map_set(&headers, key, val)
            case None {}
        end
        i = i + 1
    end
    
    out Ok(Response {
        status = StatusCode { code = code, reason = reason },
        headers = headers,
        body = body
    })
end

# ═══════════════════════════════════════════════════════
# Convenience: GET/POST
# ═══════════════════════════════════════════════════════

func http_get(url: String) -> Result<Response, String>
    out http_send(request_new(Method.GET, url))
end

func http_post(url: String, body: String, content_type: String) -> Result<Response, String>
    var req = request_new(Method.POST, url)
    request_header(&req, str_new("Content-Type"), content_type)
    request_body(&req, body)
    out http_send(req)
end
