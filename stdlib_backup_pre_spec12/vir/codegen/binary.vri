/*
 * vir/codegen/binary.vri — Binary Object Format Emitter
 * ======================================================
 * Step 3: Cut the umbilical cord — emit Mach-O/ELF objects directly
 *
 * This module constructs binary object files in memory,
 * bypassing the need for an external assembler (as) or linker (ld).
 *
 * Mach-O 64-bit format (macOS ARM64 & x86-64):
 *   Header -> Load Commands -> Segments -> Sections -> Relocations -> SymTab
 *
 * ELF 64-bit format (Linux):
 *   ELF Header -> Section Headers -> .text -> .data -> .symtab -> .strtab
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_concat, str_len
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get


# ═══════════════════════════════════════════════════════
# Target Format
# ═══════════════════════════════════════════════════════

enum ObjFormat
    MachO64  = 0
    ELF64    = 1
end

enum Arch
    ARM64    = 0
    X86_64   = 1
end


# ═══════════════════════════════════════════════════════
# Raw byte buffer
# ═══════════════════════════════════════════════════════

entity ByteBuffer
    data:   Vec<u8>
    pos:    i64
end

func buf_new() -> ByteBuffer
    out ByteBuffer { data: vec_new(), pos: 0 }
end

func buf_write_u8(buf: ByteBuffer, val: u8) -> ByteBuffer
    vec_push(buf.data, val)
    buf.pos = buf.pos + 1
    out buf
end

func buf_write_u16_le(buf: ByteBuffer, val: u16) -> ByteBuffer
    buf = buf_write_u8(buf, (val & 0xFF) as u8)
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) as u8)
    out buf
end

func buf_write_u32_le(buf: ByteBuffer, val: u32) -> ByteBuffer
    buf = buf_write_u8(buf, (val & 0xFF) as u8)
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) as u8)
    buf = buf_write_u8(buf, ((val >> 16) & 0xFF) as u8)
    buf = buf_write_u8(buf, ((val >> 24) & 0xFF) as u8)
    out buf
end

func buf_write_u64_le(buf: ByteBuffer, val: u64) -> ByteBuffer
    buf = buf_write_u32_le(buf, (val & 0xFFFFFFFF) as u32)
    buf = buf_write_u32_le(buf, ((val >> 32) & 0xFFFFFFFF) as u32)
    out buf
end

func buf_write_zeros(buf: ByteBuffer, count: i32) -> ByteBuffer
    var i = 0
    while i < count
        buf = buf_write_u8(buf, 0)
        i = i + 1
    end
    out buf
end

func buf_write_bytes(buf: ByteBuffer, bytes: Vec<u8>) -> ByteBuffer
    var i = 0
    while i < vec_len(bytes)
        buf = buf_write_u8(buf, vec_get(bytes, i))
        i = i + 1
    end
    out buf
end

func buf_write_string_padded(buf: ByteBuffer, s: String, pad_to: i32) -> ByteBuffer
    var slen = str_len(s)
    var i = 0
    while i < slen and i < pad_to
        buf = buf_write_u8(buf, str_byte_at(s, i))
        i = i + 1
    end
    # Pad with zeros
    while i < pad_to
        buf = buf_write_u8(buf, 0)
        i = i + 1
    end
    out buf
end

func buf_align(buf: ByteBuffer, alignment: i32) -> ByteBuffer
    while (buf.pos % alignment as i64) != 0
        buf = buf_write_u8(buf, 0)
    end
    out buf
end

func buf_size(buf: ByteBuffer) -> i64
    out buf.pos
end


# ═══════════════════════════════════════════════════════
# Symbol Table Entry
# ═══════════════════════════════════════════════════════

enum SymbolType
    Function   = 0
    Data       = 1
    External   = 2
end

entity Symbol
    name:       String
    sym_type:   SymbolType
    section:    i32        # section index (1-based)
    offset:     i64        # offset within section
    size:       i64
    is_global:  bool
end


# ═══════════════════════════════════════════════════════
# Relocation Entry
# ═══════════════════════════════════════════════════════

enum RelocType
    Branch26       = 0   # ARM64: B/BL (26-bit offset)
    Page21         = 1   # ARM64: ADRP (21-bit page)
    PageOff12      = 2   # ARM64: ADD/LDR (12-bit page offset)
    PLT32          = 3   # x86-64: PLT call
    PC32           = 4   # x86-64: RIP-relative
    GOTLoad        = 5   # GOT entry load
end

entity Relocation
    offset:     i64
    sym_idx:    i32
    reloc_type: RelocType
    addend:     i64
end


# ═══════════════════════════════════════════════════════
# Section
# ═══════════════════════════════════════════════════════

entity Section
    name:       String
    seg_name:   String       # Mach-O segment name
    data:       ByteBuffer
    alignment:  i32
    relocs:     Vec<Relocation>
end

func section_text() -> Section
    out Section {
        name: str_new("__text"),
        seg_name: str_new("__TEXT"),
        data: buf_new(),
        alignment: 4,
        relocs: vec_new()
    }
end

func section_data() -> Section
    out Section {
        name: str_new("__data"),
        seg_name: str_new("__DATA"),
        data: buf_new(),
        alignment: 8,
        relocs: vec_new()
    }
end

func section_const() -> Section
    out Section {
        name: str_new("__const"),
        seg_name: str_new("__TEXT"),
        data: buf_new(),
        alignment: 16,
        relocs: vec_new()
    }
end


# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64: u32     = 0xFEEDFACF
const MH_OBJECT: u32       = 1     # relocatable object file

# CPU types
const CPU_TYPE_ARM64: u32   = 0x0100000C   # CPU_TYPE_ARM | CPU_ARCH_ABI64
const CPU_TYPE_X86_64: u32  = 0x01000007   # CPU_TYPE_X86 | CPU_ARCH_ABI64
const CPU_SUBTYPE_ALL: u32  = 0

# Load command types
const LC_SEGMENT_64: u32    = 0x19
const LC_SYMTAB: u32        = 0x02
const LC_BUILD_VERSION: u32 = 0x32

# Section types
const S_REGULAR: u32        = 0x00
const S_ATTR_PURE_INSTRUCTIONS: u32 = 0x80000000
const S_ATTR_SOME_INSTRUCTIONS: u32 = 0x00000400


# ═══════════════════════════════════════════════════════
# Mach-O Object Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder
    arch:       Arch
    sections:   Vec<Section>
    symbols:    Vec<Symbol>
    strtab:     ByteBuffer
end

func macho_new(arch: Arch) -> MachOBuilder
    var builder = MachOBuilder {
        arch: arch,
        sections: vec_new(),
        symbols: vec_new(),
        strtab: buf_new()
    }
    # strtab starts with a null byte
    builder.strtab = buf_write_u8(builder.strtab, 0)
    out builder
end

func macho_add_section(builder: MachOBuilder, sec: Section) -> MachOBuilder
    vec_push(builder.sections, sec)
    out builder
end

func macho_add_symbol(builder: MachOBuilder, sym: Symbol) -> MachOBuilder
    vec_push(builder.symbols, sym)
    out builder
end

func macho_strtab_add(builder: MachOBuilder, name: String) -> (MachOBuilder, i32)
    var offset = buf_size(builder.strtab) as i32
    # Write string bytes + null terminator
    var i = 0
    while i < str_len(name)
        builder.strtab = buf_write_u8(builder.strtab, str_byte_at(name, i))
        i = i + 1
    end
    builder.strtab = buf_write_u8(builder.strtab, 0)
    out (builder, offset)
end


# ═══════════════════════════════════════════════════════
# Emit Mach-O Header
# ═══════════════════════════════════════════════════════

func macho_emit_header(buf: ByteBuffer, arch: Arch, ncmds: u32,
                       sizeofcmds: u32) -> ByteBuffer
    # Mach-O 64-bit header = 32 bytes
    buf = buf_write_u32_le(buf, MH_MAGIC_64)

    if arch == Arch::ARM64
        buf = buf_write_u32_le(buf, CPU_TYPE_ARM64)
    else
        buf = buf_write_u32_le(buf, CPU_TYPE_X86_64)
    end

    buf = buf_write_u32_le(buf, CPU_SUBTYPE_ALL)   # cpusubtype
    buf = buf_write_u32_le(buf, MH_OBJECT)         # filetype
    buf = buf_write_u32_le(buf, ncmds)             # ncmds
    buf = buf_write_u32_le(buf, sizeofcmds)        # sizeofcmds
    buf = buf_write_u32_le(buf, 0)                 # flags
    buf = buf_write_u32_le(buf, 0)                 # reserved (64-bit)
    out buf
end


# ═══════════════════════════════════════════════════════
# Emit LC_SEGMENT_64
# ═══════════════════════════════════════════════════════

func macho_emit_segment_cmd(buf: ByteBuffer, seg_name: String,
                            nsects: u32, sect_data_offset: i64,
                            sect_data_size: i64) -> ByteBuffer
    # LC_SEGMENT_64 = 72 bytes + 80 bytes per section
    var cmdsize = 72 + nsects * 80 as u32

    buf = buf_write_u32_le(buf, LC_SEGMENT_64)
    buf = buf_write_u32_le(buf, cmdsize)
    buf = buf_write_string_padded(buf, seg_name, 16)      # segname[16]
    buf = buf_write_u64_le(buf, 0)                        # vmaddr
    buf = buf_write_u64_le(buf, sect_data_size as u64)  # vmsize
    buf = buf_write_u64_le(buf, sect_data_offset as u64) # fileoff
    buf = buf_write_u64_le(buf, sect_data_size as u64)   # filesize
    buf = buf_write_u32_le(buf, 7)                        # maxprot (rwx)
    buf = buf_write_u32_le(buf, 7)                        # initprot (rwx)
    buf = buf_write_u32_le(buf, nsects)
    buf = buf_write_u32_le(buf, 0)                        # flags

    out buf
end


# ═══════════════════════════════════════════════════════
# Emit Section Header (within LC_SEGMENT_64)
# ═══════════════════════════════════════════════════════

func macho_emit_section_hdr(buf: ByteBuffer, sec: Section,
                            file_offset: i64, reloc_offset: i64) -> ByteBuffer
    # Section header = 80 bytes
    buf = buf_write_string_padded(buf, sec.name, 16)      # sectname[16]
    buf = buf_write_string_padded(buf, sec.seg_name, 16)  # segname[16]
    buf = buf_write_u64_le(buf, 0)                        # addr
    buf = buf_write_u64_le(buf, buf_size(sec.data) as u64)  # size
    buf = buf_write_u32_le(buf, file_offset as u32)        # offset
    buf = buf_write_u32_le(buf, sec.alignment as u32)      # align (2^n)
    buf = buf_write_u32_le(buf, reloc_offset as u32)       # reloff
    buf = buf_write_u32_le(buf, vec_len(sec.relocs) as u32) # nreloc
    buf = buf_write_u32_le(buf, S_REGULAR)                 # flags
    buf = buf_write_u32_le(buf, 0)                         # reserved1
    buf = buf_write_u32_le(buf, 0)                         # reserved2
    buf = buf_write_u32_le(buf, 0)                         # reserved3 (64-bit)

    out buf
end


# ═══════════════════════════════════════════════════════
# Emit LC_SYMTAB
# ═══════════════════════════════════════════════════════

func macho_emit_symtab_cmd(buf: ByteBuffer, symoff: u32, nsyms: u32,
                           stroff: u32, strsize: u32) -> ByteBuffer
    buf = buf_write_u32_le(buf, LC_SYMTAB)
    buf = buf_write_u32_le(buf, 24)        # cmdsize
    buf = buf_write_u32_le(buf, symoff)
    buf = buf_write_u32_le(buf, nsyms)
    buf = buf_write_u32_le(buf, stroff)
    buf = buf_write_u32_le(buf, strsize)
    out buf
end


# ═══════════════════════════════════════════════════════
# Build Complete Object File
# ═══════════════════════════════════════════════════════

func macho_build(builder: MachOBuilder) -> Result<ByteBuffer, String>
    var out = buf_new()

    var nsections = vec_len(builder.sections) as u32
    if nsections == 0
        out Err(str_new("No sections to emit"))
    end

    # Calculate layout
    var header_size = 32 as i64
    var segment_cmd_size = (72 + nsections * 80) as i64
    var symtab_cmd_size = 24 as i64
    var total_cmd_size = segment_cmd_size + symtab_cmd_size
    var data_offset = header_size + total_cmd_size

    # Calculate total section data size
    var total_data_size: i64 = 0
    var i = 0
    while i < nsections as i32
        total_data_size = total_data_size + buf_size(vec_get(builder.sections, i).data)
        i = i + 1
    end

    # Emit header (2 load commands: LC_SEGMENT_64, LC_SYMTAB)
    out = macho_emit_header(out, builder.arch, 2, total_cmd_size as u32)

    # Emit LC_SEGMENT_64 command
    out = macho_emit_segment_cmd(out, str_new(""), nsections,
                                  data_offset, total_data_size)

    # Emit section headers
    var sec_offset = data_offset
    i = 0
    while i < nsections as i32
        var sec = vec_get(builder.sections, i)
        out = macho_emit_section_hdr(out, sec, sec_offset, 0)
        sec_offset = sec_offset + buf_size(sec.data)
        i = i + 1
    end

    # Emit LC_SYMTAB command
    var symoff = (data_offset + total_data_size) as u32
    var nsyms = vec_len(builder.symbols) as u32
    var stroff = symoff + nsyms * 16   # nlist_64 = 16 bytes each
    var strsize = buf_size(builder.strtab) as u32
    out = macho_emit_symtab_cmd(out, symoff, nsyms, stroff, strsize)

    # Emit section data
    i = 0
    while i < nsections as i32
        var sec = vec_get(builder.sections, i)
        out = buf_write_bytes(out, sec.data.data)
        i = i + 1
    end

    # Emit symbol table (nlist_64 entries)
    i = 0
    while i < vec_len(builder.symbols)
        var sym = vec_get(builder.symbols, i)
        var (builder2, str_idx) = macho_strtab_add(builder, sym.name)
        builder = builder2

        out = buf_write_u32_le(out, str_idx as u32)     # n_strx
        if sym.is_global
            out = buf_write_u8(out, 0x0F)                       # n_type: N_EXT | N_SECT
        else
            out = buf_write_u8(out, 0x0E)                       # n_type: N_SECT
        end
        out = buf_write_u8(out, sym.section as u8)       # n_sect
        out = buf_write_u16_le(out, 0)                          # n_desc
        out = buf_write_u64_le(out, sym.offset as u64)   # n_value

        i = i + 1
    end

    # Emit string table
    out = buf_write_bytes(out, builder.strtab.data)

    out Ok(out)
end


# ═══════════════════════════════════════════════════════
# High-Level API
# ═══════════════════════════════════════════════════════

func emit_object_file(code: Vec<u8>, arch: Arch) -> Result<ByteBuffer, String>
    var builder = macho_new(arch)

    # Create __text section with the machine code
    var text = section_text()
    text.data = buf_new()
    text.data = buf_write_bytes(text.data, code)

    builder = macho_add_section(builder, text)

    out macho_build(builder)
end

func emit_kernel_object(kernel_name: String, code: Vec<u8>,
                        arch: Arch) -> Result<ByteBuffer, String>
    var builder = macho_new(arch)

    # Text section
    var text = section_text()
    text.data = buf_new()
    text.data = buf_write_bytes(text.data, code)
    builder = macho_add_section(builder, text)

    # Add kernel as global symbol
    builder = macho_add_symbol(builder, Symbol {
        name: format("_vir_{}", kernel_name),
        sym_type: SymbolType::Function,
        section: 1,
        offset: 0,
        size: vec_len(code) as i64,
        is_global: true
    })

    out macho_build(builder)
end
