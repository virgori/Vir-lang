/*
 * vir/doctest/doctest.vri — Doc-Test Runner
 * ===========================================
 * Phase D — extract and run code examples from doc-comments
 *
 * Inspired by: doctest (Python/Rust), ExUnit.DocTest (Elixir)
 *
 * Doc-comment format:
 *   ## Example:
 *   ```vir
 *   var x = 42
 *   assert_eq(x, 42)
 *   ```
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat, str_contains, str_starts_with, str_trim
import "vir/str/builder" use sb_new, sb_append, sb_push_byte, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/io/file" use file_read_string
import "vir/io/stdio" use println
import "vir/test/test" use TestResult

# ═══════════════════════════════════════════════════════
# DocTest item
# ═══════════════════════════════════════════════════════

entity DocTest
    source_file: String
    line_number: usize      # line in source where ``` started
    code:        String      # extracted code block
    expected:    Option<String>  # optional expected output
end

entity DocTestResult
    test:    DocTest
    passed:  bool
    message: Option<String>
end

entity DocTestSuite
    tests:   Vec<DocTest>
    results: Vec<DocTestResult>
end

# ═══════════════════════════════════════════════════════
# Extract doc-tests from source file
# ═══════════════════════════════════════════════════════

func extract_doctests(source_path: String) -> Vec<DocTest>
    var content = file_read_string(source_path)
    var tests = vec_new()
    
    var lines = _split_lines(content)
    var i: usize = 0
    var total = vec_len(lines)
    
    lặp_khi i < total
        var line = str_trim(vec_get(lines, i))
        
        # Look for ```vir inside doc-comments (## or ///)
        if _is_doc_code_start(line)
            var code_sb = sb_new()
            var start_line = i + 1
            i = i + 1
            
            lặp_khi i < total
                var cl = vec_get(lines, i)
                var trimmed = str_trim(cl)
                
                # End of code block?
                if str_starts_with(trimmed, str_new("```"))
                    i = i + 1
                    thoát
                end
                
                # Strip leading doc-comment markers
                var code_line = _strip_doc_prefix(cl)
                sb_append(&code_sb, code_line)
                sb_push_byte(&code_sb, 0x0A)  # \n
                i = i + 1
            end
            
            var code = sb_build(code_sb)
            if str_byte_len(str_trim(code)) > 0
                vec_push(&tests, DocTest {
                    source_file = source_path,
                    line_number = start_line,
                    code = code,
                    expected = None
                })
            end
        else
            i = i + 1
        end
    end
    
    out tests
end

# ═══════════════════════════════════════════════════════
# Run doc-tests
# ═══════════════════════════════════════════════════════

# Native function to eval a Vir code snippet
native func native_eval_vir(code: String) -> TestResult

func run_doctests(source_path: String) -> DocTestSuite
    var tests = extract_doctests(source_path)
    var results = vec_new()
    
    var i: usize = 0
    lặp_khi i < vec_len(tests)
        var test = vec_get(tests, i)
        var result = _run_one_doctest(test)
        vec_push(&results, result)
        i = i + 1
    end
    
    out DocTestSuite { tests = tests, results = results }
end

func _run_one_doctest(test: DocTest) -> DocTestResult
    var result = native_eval_vir(test.code)
    if result.passed
        out DocTestResult { test = test, passed = true, message = None }
    else
        out DocTestResult {
            test = test,
            passed = false,
            message = Some(result.message)
        }
    end
end

# ═══════════════════════════════════════════════════════
# Report
# ═══════════════════════════════════════════════════════

func doctest_report(suite: DocTestSuite) -> String
    var sb = sb_new()
    var passed: usize = 0
    var failed: usize = 0
    var total = vec_len(suite.results)
    
    var i: usize = 0
    lặp_khi i < total
        var r = vec_get(suite.results, i)
        if r.passed
            passed = passed + 1
        else
            failed = failed + 1
            sb_append(&sb, str_new("FAIL "))
            sb_append(&sb, r.test.source_file)
            sb_append(&sb, str_new(":"))
            sb_append(&sb, int_to_string(r.test.line_number))
            sb_append(&sb, str_new("\n"))
            chọn r.message
                case Some(msg)
                    sb_append(&sb, str_new("  -> "))
                    sb_append(&sb, msg)
                    sb_append(&sb, str_new("\n"))
                case None {}
            end
            sb_append(&sb, str_new("  Code:\n"))
            # Indent code block
            var code_lines = _split_lines(r.test.code)
            var j: usize = 0
            lặp_khi j < vec_len(code_lines)
                sb_append(&sb, str_new("    "))
                sb_append(&sb, vec_get(code_lines, j))
                sb_append(&sb, str_new("\n"))
                j = j + 1
            end
        end
        i = i + 1
    end
    
    sb_append(&sb, str_new("\nDocTests: "))
    sb_append(&sb, int_to_string(total))
    sb_append(&sb, str_new(" total, "))
    sb_append(&sb, int_to_string(passed))
    sb_append(&sb, str_new(" passed, "))
    sb_append(&sb, int_to_string(failed))
    sb_append(&sb, str_new(" failed\n"))
    
    out sb_build(sb)
end

func doctest_print_report(suite: DocTestSuite)
    println(doctest_report(suite))
end

# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _is_doc_code_start(line: String) -> bool
    # Matches:  ```vir  or  ## ```vir  or  /// ```vir
    if str_contains(line, str_new("```vir")) out true end
    out false
end

func _strip_doc_prefix(line: String) -> String
    var trimmed = str_trim_start(line)
    if str_starts_with(trimmed, str_new("/// "))
        out str_slice_from(trimmed, 4)
    end
    if str_starts_with(trimmed, str_new("///"))
        out str_slice_from(trimmed, 3)
    end
    if str_starts_with(trimmed, str_new("## "))
        out str_slice_from(trimmed, 3)
    end
    out line
end

func _split_lines(s: String) -> Vec<String>
    var lines = vec_new()
    var sb = sb_new()
    var i: usize = 0
    var len = str_byte_len(s)
    
    lặp_khi i < len
        var ch = str_byte_at(s, i)
        if ch == 0x0A
            vec_push(&lines, sb_build(sb))
            sb = sb_new()
        else
            sb_push_byte(&sb, ch)
        end
        i = i + 1
    end
    
    var last = sb_build(sb)
    if str_byte_len(last) > 0 vec_push(&lines, last) end
    
    out lines
end
