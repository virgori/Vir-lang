/*
 * vir/fs/fs.vri — Filesystem Operations
 * ========================================
 * Inspired by Python: os, shutil, pathlib
 * Inspired by C23: <stdio.h> remove/rename, <dirent.h>
 *
 * Thao tác trên filesystem: tạo/xóa directory, liệt kê, copy, rename...
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat
import "vir/collections/vec" use Vec, vec_new, vec_push
import "vir/path/path" use Path, path_join, path_to_string

# ═══════════════════════════════════════════════════════
# File Metadata
# ═══════════════════════════════════════════════════════

enum FileType
    Regular    = 1
    Directory  = 2
    Symlink    = 3
    Other      = 0
end

entity Metadata
    size:       u64        # bytes
    file_type:  FileType
    modified:   u64        # unix timestamp (seconds)
    accessed:   u64
    created:    u64
    readonly:   bool
end

entity DirEntry
    name:      String
    path:      Path
    file_type: FileType
end

# ═══════════════════════════════════════════════════════
# Query
# ═══════════════════════════════════════════════════════

func exists(path: Path) -> bool
    out native_path_exists(path_to_string(path).data, path_to_string(path).byte_len)
end

func is_file(path: Path) -> bool
    var meta = metadata(path)
    chọn meta
        case Ok(m) out m.file_type == FileType.Regular
        case Err(_) out false
    end
end

func is_dir(path: Path) -> bool
    var meta = metadata(path)
    chọn meta
        case Ok(m) out m.file_type == FileType.Directory
        case Err(_) out false
    end
end

func metadata(path: Path) -> Result<Metadata, String>
    var p = path_to_string(path)
    var size: u64 = 0
    var ftype: i32 = 0
    var mtime: u64 = 0
    var atime: u64 = 0
    var ctime: u64 = 0
    var ro: bool = false
    
    var rc = native_stat(p.data, p.byte_len, &size, &ftype, &mtime, &atime, &ctime, &ro)
    if rc != 0 out Err(str_new("stat failed")) end
    
    var ft: FileType
    chọn ftype
        case 1 ft = FileType.Regular
        case 2 ft = FileType.Directory
        case 3 ft = FileType.Symlink
        mặc_định ft = FileType.Other
    end
    
    out Ok(Metadata {
        size = size, file_type = ft,
        modified = mtime, accessed = atime, created = ctime,
        readonly = ro
    })
end

func file_size(path: Path) -> Result<u64, String>
    var meta = metadata(path)
    chọn meta
        case Ok(m) out Ok(m.size)
        case Err(e) out Err(e)
    end
end

# ═══════════════════════════════════════════════════════
# Directory Operations
# ═══════════════════════════════════════════════════════

func create_dir(path: Path) -> Result<void, String>
    var p = path_to_string(path)
    var rc = native_mkdir(p.data, p.byte_len, 0o755)
    if rc != 0 out Err(str_new("mkdir failed")) end
    out Ok(void)
end

func create_dir_all(path: Path) -> Result<void, String>
    # Tạo directory and tất cả directory cha (giống mkdir -p).
    var p = path_to_string(path)
    var rc = native_mkdir_p(p.data, p.byte_len, 0o755)
    if rc != 0 out Err(str_new("mkdir -p failed")) end
    out Ok(void)
end

func remove_dir(path: Path) -> Result<void, String>
    var p = path_to_string(path)
    var rc = native_rmdir(p.data, p.byte_len)
    if rc != 0 out Err(str_new("rmdir failed")) end
    out Ok(void)
end

func remove_dir_all(path: Path) -> Result<void, String>
    # Xóa directory đệ quy (giống rm -rf).
    var entries = read_dir(path)
    chọn entries
        case Err(e) out Err(e)
        case Ok(list)
            var i: usize = 0
            lặp_khi i < vec_len(list)
                var entry = vec_get(list, i)
                chọn entry.file_type
                    case FileType.Directory
                        var result = remove_dir_all(entry.path)
                        if is_err(result) out result end
                    mặc_định
                        var result = remove_file(entry.path)
                        if is_err(result) out result end
                end
                i = i + 1
            end
    end
    out remove_dir(path)
end

func read_dir(path: Path) -> Result<Vec<DirEntry>, String>
    var p = path_to_string(path)
    var entries = vec_new()
    
    var dir_handle = native_opendir(p.data, p.byte_len)
    if dir_handle == null out Err(str_new("opendir failed")) end
    
    loop
        var name_ptr: ptr = null
        var name_len: usize = 0
        var ftype: i32 = 0
        var rc = native_readdir(dir_handle, &name_ptr, &name_len, &ftype)
        if rc != 0 thoát end
        
        var name = str_from_bytes(name_ptr, name_len)
        # Bỏ qua . and ..
        if str_eq(name, str_new(".")) or str_eq(name, str_new(".."))
            tiếp_tục
        end
        
        var ft: FileType
        chọn ftype
            case 1 ft = FileType.Regular
            case 2 ft = FileType.Directory
            case 3 ft = FileType.Symlink
            mặc_định ft = FileType.Other
        end
        
        vec_push(&entries, DirEntry {
            name = name,
            path = path_join(path, name),
            file_type = ft
        })
    end
    
    native_closedir(dir_handle)
    out Ok(entries)
end

# ═══════════════════════════════════════════════════════
# File Operations
# ═══════════════════════════════════════════════════════

func remove_file(path: Path) -> Result<void, String>
    var p = path_to_string(path)
    var rc = native_unlink(p.data, p.byte_len)
    if rc != 0 out Err(str_new("unlink failed")) end
    out Ok(void)
end

func rename(from: Path, to: Path) -> Result<void, String>
    var sf = path_to_string(from)
    var st = path_to_string(to)
    var rc = native_rename(sf.data, sf.byte_len, st.data, st.byte_len)
    if rc != 0 out Err(str_new("rename failed")) end
    out Ok(void)
end

func copy_file(src: Path, dst: Path) -> Result<u64, String>
    # Copy file, out số bytes copied.
    var sp = path_to_string(src)
    var dp = path_to_string(dst)
    
    var sf = native_open(sp.data, sp.byte_len, 0)   # O_RDONLY
    if sf < 0 out Err(str_new("open src failed")) end
    
    var df = native_open(dp.data, dp.byte_len, 577)  # O_WRONLY|O_CREAT|O_TRUNC
    if df < 0
        native_close(sf)
        out Err(str_new("open dst failed"))
    end
    
    var buf = alloc(65536)
    var total: u64 = 0
    loop
        var n = native_read(sf, buf, 65536)
        if n <= 0 thoát end
        var w = native_write(df, buf, n)
        if w != n
            free(buf)
            native_close(sf)
            native_close(df)
            out Err(str_new("write failed"))
        end
        total = total + n
    end
    
    free(buf)
    native_close(sf)
    native_close(df)
    out Ok(total)
end

# ═══════════════════════════════════════════════════════
# Symlinks
# ═══════════════════════════════════════════════════════

func symlink(target: Path, link: Path) -> Result<void, String>
    var t = path_to_string(target)
    var l = path_to_string(link)
    var rc = native_symlink(t.data, t.byte_len, l.data, l.byte_len)
    if rc != 0 out Err(str_new("symlink failed")) end
    out Ok(void)
end

func read_link(path: Path) -> Result<Path, String>
    var p = path_to_string(path)
    var target_ptr: ptr = null
    var target_len: usize = 0
    var rc = native_readlink(p.data, p.byte_len, &target_ptr, &target_len)
    if rc != 0 out Err(str_new("readlink failed")) end
    out Ok(path_from(str_from_bytes(target_ptr, target_len)))
end

# ═══════════════════════════════════════════════════════
# Temp Files
# ═══════════════════════════════════════════════════════

func temp_file(prefix: String) -> Result<Path, String>
    # Tạo tempfile in temp_dir().
    var tmp = temp_dir()
    var name = str_concat(prefix, str_concat(str_new("_"), i64_to_str(unix_timestamp_nanos())))
    var p = path_join(path_from(tmp), name)
    out Ok(p)
end
