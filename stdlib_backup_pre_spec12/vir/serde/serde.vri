/*
 * vir/serde/serde.vri — Serialization / Deserialization Framework
 * ================================================================
 * Inspired by Rust: serde, Python: pickle, marshal
 *
 * Phase C — generic serialize/deserialize traits + binary format
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/mem/buffer" use Buffer, buf_new, buf_push_u8, buf_push_u16, buf_push_u32, buf_push_u64, buf_bytes, buf_len

# ═══════════════════════════════════════════════════════
# Serialize / Deserialize Tags
# ═══════════════════════════════════════════════════════

enum SerdeTag
    Null    = 0x00
    Bool    = 0x01
    I8      = 0x02
    I16     = 0x03
    I32     = 0x04
    I64     = 0x05
    U8      = 0x06
    U16     = 0x07
    U32     = 0x08
    U64     = 0x09
    F32     = 0x0A
    F64     = 0x0B
    Str     = 0x0C
    Bytes   = 0x0D
    Array   = 0x0E
    Map     = 0x0F
    Struct  = 0x10
end

# ═══════════════════════════════════════════════════════
# Serializer (writes to Buffer)
# ═══════════════════════════════════════════════════════

entity Serializer
    buf: Buffer
end

func ser_new() -> Serializer
    out Serializer { buf = buf_new() }
end

func ser_null(s: &Serializer)
    buf_push_u8(&s.buf, SerdeTag.Null)
end

func ser_bool(s: &Serializer, val: bool)
    buf_push_u8(&s.buf, SerdeTag.Bool)
    buf_push_u8(&s.buf, if val 1 else 0 end)
end

func ser_i64(s: &Serializer, val: i64)
    buf_push_u8(&s.buf, SerdeTag.I64)
    buf_push_u64(&s.buf, val)
end

func ser_u64(s: &Serializer, val: u64)
    buf_push_u8(&s.buf, SerdeTag.U64)
    buf_push_u64(&s.buf, val)
end

func ser_f64(s: &Serializer, val: f64)
    buf_push_u8(&s.buf, SerdeTag.F64)
    buf_push_u64(&s.buf, reinterpret_f64_to_u64(val))
end

func ser_str(s: &Serializer, val: String)
    buf_push_u8(&s.buf, SerdeTag.Str)
    var len = str_byte_len(val)
    buf_push_u32(&s.buf, len)
    var i: usize = 0
    lặp_khi i < len
        buf_push_u8(&s.buf, str_byte_at(val, i))
        i = i + 1
    end
end

func ser_bytes(s: &Serializer, data: &[u8], len: usize)
    buf_push_u8(&s.buf, SerdeTag.Bytes)
    buf_push_u32(&s.buf, len)
    var i: usize = 0
    lặp_khi i < len buf_push_u8(&s.buf, data[i]); i = i + 1 end
end

func ser_array_begin(s: &Serializer, count: usize)
    buf_push_u8(&s.buf, SerdeTag.Array)
    buf_push_u32(&s.buf, count)
end

func ser_map_begin(s: &Serializer, count: usize)
    buf_push_u8(&s.buf, SerdeTag.Map)
    buf_push_u32(&s.buf, count)
end

func ser_struct_begin(s: &Serializer, name: String, field_count: usize)
    buf_push_u8(&s.buf, SerdeTag.Struct)
    var nlen = str_byte_len(name)
    buf_push_u16(&s.buf, nlen)
    var i: usize = 0
    lặp_khi i < nlen buf_push_u8(&s.buf, str_byte_at(name, i)); i = i + 1 end
    buf_push_u16(&s.buf, field_count)
end

func ser_finish(s: Serializer) -> Vec<u8>
    out buf_bytes(s.buf)
end

# ═══════════════════════════════════════════════════════
# Deserializer (reads from byte slice)
# ═══════════════════════════════════════════════════════

entity Deserializer
    data: Vec<u8>
    pos:  usize
end

func de_new(data: Vec<u8>) -> Deserializer
    out Deserializer { data = data, pos = 0 }
end

func _de_read_u8(d: &Deserializer) -> u8
    var val = vec_get(d.data, d.pos)
    d.pos = d.pos + 1
    out val
end

func _de_read_u16(d: &Deserializer) -> u16
    var hi = _de_read_u8(d)
    var lo = _de_read_u8(d)
    out (hi << 8) | lo
end

func _de_read_u32(d: &Deserializer) -> u32
    var b0 = _de_read_u8(d); var b1 = _de_read_u8(d)
    var b2 = _de_read_u8(d); var b3 = _de_read_u8(d)
    out (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

func _de_read_u64(d: &Deserializer) -> u64
    var hi = _de_read_u32(d)
    var lo = _de_read_u32(d)
    out (hi << 32) | lo
end

func de_peek_tag(d: Deserializer) -> SerdeTag
    out vec_get(d.data, d.pos)
end

func de_null(d: &Deserializer) -> Result<void, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Null out Err(str_new("expected null")) end
    out Ok(())
end

func de_bool(d: &Deserializer) -> Result<bool, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Bool out Err(str_new("expected bool")) end
    out Ok(_de_read_u8(d) != 0)
end

func de_i64(d: &Deserializer) -> Result<i64, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.I64 out Err(str_new("expected i64")) end
    out Ok(_de_read_u64(d))
end

func de_u64(d: &Deserializer) -> Result<u64, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.U64 out Err(str_new("expected u64")) end
    out Ok(_de_read_u64(d))
end

func de_f64(d: &Deserializer) -> Result<f64, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.F64 out Err(str_new("expected f64")) end
    var bits = _de_read_u64(d)
    out Ok(reinterpret_u64_to_f64(bits))
end

func de_str(d: &Deserializer) -> Result<String, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Str out Err(str_new("expected string")) end
    var len = _de_read_u32(d)
    var sb = sb_new()
    var i: usize = 0
    lặp_khi i < len
        sb_push_byte(&sb, _de_read_u8(d))
        i = i + 1
    end
    out Ok(sb_build(sb))
end

func de_bytes(d: &Deserializer) -> Result<Vec<u8>, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Bytes out Err(str_new("expected bytes")) end
    var len = _de_read_u32(d)
    var out = vec_new()
    var i: usize = 0
    lặp_khi i < len vec_push(&out, _de_read_u8(d)); i = i + 1 end
    out Ok(out)
end

func de_array_len(d: &Deserializer) -> Result<usize, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Array out Err(str_new("expected array")) end
    out Ok(_de_read_u32(d))
end

func de_map_len(d: &Deserializer) -> Result<usize, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Map out Err(str_new("expected map")) end
    out Ok(_de_read_u32(d))
end

entity StructHeader
    name:        String
    field_count: usize
end

func de_struct_header(d: &Deserializer) -> Result<StructHeader, String>
    var tag = _de_read_u8(d)
    if tag != SerdeTag.Struct out Err(str_new("expected struct")) end
    var nlen = _de_read_u16(d)
    var sb = sb_new()
    var i: usize = 0
    lặp_khi i < nlen sb_push_byte(&sb, _de_read_u8(d)); i = i + 1 end
    var fc = _de_read_u16(d)
    out Ok(StructHeader { name = sb_build(sb), field_count = fc })
end
