/*
 * vir/path/path.vri — Path Abstraction
 * ======================================
 * Inspired by Python: pathlib.Path
 * Abstracthóa đường dẫn, tương thích cross-platform.
 *
 * Compiler uses internally: module resolver, import path lookup.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_eq, str_len, str_find, str_slice_bytes, str_ends_with, str_concat

const PATH_SEP : String = "/"   # POSIX — Windows cần "\\" 

entity Path
    raw: String       # Đường dẫn root
end

func path_new(s: String) -> Path
    out Path { raw: s }
end

func path_from(literal: string) -> Path
    out Path { raw: str_new(literal) }
end

func path_to_string(p: Path) -> String
    out p.raw
end

func path_join(base: Path, child: String) -> Path
    if str_is_empty(base.raw)
        out Path { raw: child }
    end
    if str_ends_with(base.raw, PATH_SEP)
        out Path { raw: str_concat(base.raw, child) }
    end
    out Path { raw: str_concat(str_concat(base.raw, PATH_SEP), child) }
end

func path_parent(p: Path) -> Option<Path>
    # Tìm dấu '/' cuối cùng
    var last_sep = str_rfind(p.raw, PATH_SEP)
    chọn last_sep
        case Some(pos)
            if pos == 0 out Some(path_new(PATH_SEP)) end
            out Some(path_new(str_slice_bytes(p.raw, 0, pos)))
        case None out None
    end
end

func path_filename(p: Path) -> Option<String>
    var last_sep = str_rfind(p.raw, PATH_SEP)
    chọn last_sep
        case Some(pos)
            var name = str_slice_bytes(p.raw, pos + 1, str_byte_len(p.raw))
            if str_is_empty(name) out None end
            out Some(name)
        case None out Some(p.raw)
    end
end

func path_stem(p: Path) -> Option<String>
    var fname = path_filename(p)
    if is_none(fname) out None end
    var name = unwrap(fname)
    var dot = str_rfind(name, str_new("."))
    chọn dot
        case Some(0) out Some(name)   # ".hidden" -> stem = ".hidden"
        case Some(pos) out Some(str_slice_bytes(name, 0, pos))
        case None out Some(name)
    end
end

func path_extension(p: Path) -> Option<String>
    var fname = path_filename(p)
    if is_none(fname) out None end
    var name = unwrap(fname)
    var dot = str_rfind(name, str_new("."))
    chọn dot
        case Some(0) out None          # ".hidden" -> no extension
        case Some(pos) out Some(str_slice_bytes(name, pos + 1, str_byte_len(name)))
        case None out None
    end
end

func path_is_absolute(p: Path) -> bool
    out str_starts_with(p.raw, PATH_SEP)
end

func path_is_relative(p: Path) -> bool
    out not path_is_absolute(p)
end

func path_with_extension(p: Path, ext: String) -> Path
    var stem_path = path_stem(p)
    var parent = path_parent(p)
    var base = if is_some(stem_path) unwrap(stem_path) else p.raw end
    if str_is_empty(ext)
        out path_new(base)
    end
    out path_new(str_concat(str_concat(base, str_new(".")), ext))
end

func path_exists(p: Path) -> bool
    out native_path_exists(p.raw.data, p.raw.byte_len)
end

func path_is_file(p: Path) -> bool
    out native_path_is_file(p.raw.data, p.raw.byte_len)
end

func path_is_dir(p: Path) -> bool
    out native_path_is_dir(p.raw.data, p.raw.byte_len)
end

# ═══════════════════════════════════════════════════════
# Helper (backward find)
# ═══════════════════════════════════════════════════════

func str_rfind(haystack: String, needle: String) -> Option<u64>
    # Tìm occurrence cuối cùng
    if str_byte_len(needle) > str_byte_len(haystack) out None end
    var i = str_byte_len(haystack) - str_byte_len(needle)
    while i >= 0
        if mem_cmp(haystack.data + i, needle.data, str_byte_len(needle)) == 0
            out Some(i)
        end
        if i == 0 out None end
        i = i - 1
    end
    out None
end
