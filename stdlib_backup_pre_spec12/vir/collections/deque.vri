/*
 * vir/collections/deque.vri — Double-Ended Queue (Ring Buffer)
 * ==============================================================
 * Inspired by Python: collections.deque
 * Triển khai dưới dạng ring buffer (circular array).
 *
 * Compiler use: BFS/DFS qua CFG, work queues.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/mem/alloc" use alloc, realloc, free
import "vir/mem/copy" use mem_copy

# ═══════════════════════════════════════════════════════
# Deque<T> — Ring Buffer
# ═══════════════════════════════════════════════════════

entity Deque<T>
    data:  ptr      # array T vòng
    head:  usize    # index đầu (front)
    len:   usize    # số element hiện tại
    cap:   usize    # capacity array (luôn là lũy thừa 2)
end

# ─── Helpers nội bộ ───────────────────────────────────

func _deque_mask(d: Deque<T>) -> usize
    # cap là lũy thừa 2 -> mask = cap - 1
    out d.cap - 1
end

func _deque_idx(d: Deque<T>, logical: usize) -> usize
    out (d.head + logical) & _deque_mask(d)
end

func _next_pow2(n: usize) -> usize
    var v = n
    if v == 0 out 1 end
    v = v - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    out v + 1
end

func _deque_grow(d: &Deque<T>)
    var new_cap = _next_pow2(d.cap * 2)
    if new_cap < 8 new_cap = 8 end
    var new_data = alloc(new_cap * size_of())
    
    # Copy dữ liệu vòng thành tuyến tính
    if d.len > 0
        var first_run = d.cap - d.head
        if first_run >= d.len
            # Vùng dữ liệu liên tục
            mem_copy(new_data, d.data + d.head * size_of(), d.len * size_of())
        else
            # Wrap: [head..cap) + [0..remaining)
            mem_copy(new_data, d.data + d.head * size_of(), first_run * size_of())
            mem_copy(new_data + first_run * size_of(), d.data, (d.len - first_run) * size_of())
        end
    end
    
    free(d.data)
    d.data = new_data
    d.head = 0
    d.cap = new_cap
end

# ─── Constructor ──────────────────────────────────────

func deque_new() -> Deque<T>
    out Deque<T> { data = null, head = 0, len = 0, cap = 0 }
end

func deque_with_cap(cap: usize) -> Deque<T>
    var real_cap = _next_pow2(cap)
    if real_cap < 8 real_cap = 8 end
    out Deque<T> {
        data = alloc(real_cap * size_of()),
        head = 0, len = 0, cap = real_cap
    }
end

# ─── Size ─────────────────────────────────────────────

func deque_len(d: Deque<T>) -> usize
    out d.len
end

func deque_is_empty(d: Deque<T>) -> bool
    out d.len == 0
end

# ─── Push / Pop ───────────────────────────────────────

func deque_push_back(d: &Deque<T>, val: T)
    if d.len == d.cap _deque_grow(d) end
    var idx = _deque_idx(*d, d.len)
    native_store(d.data, idx, val)
    d.len = d.len + 1
end

func deque_push_front(d: &Deque<T>, val: T)
    if d.len == d.cap _deque_grow(d) end
    d.head = (d.head - 1) & _deque_mask(*d)
    native_store(d.data, d.head, val)
    d.len = d.len + 1
end

func deque_pop_back(d: &Deque<T>) -> Option<T>
    if d.len == 0 out None end
    d.len = d.len - 1
    var idx = _deque_idx(*d, d.len)
    out Some(native_load(d.data, idx))
end

func deque_pop_front(d: &Deque<T>) -> Option<T>
    if d.len == 0 out None end
    var val = native_load(d.data, d.head)
    d.head = (d.head + 1) & _deque_mask(*d)
    d.len = d.len - 1
    out Some(val)
end

# ─── Access ───────────────────────────────────────────

func deque_front(d: Deque<T>) -> Option<T>
    if d.len == 0 out None end
    out Some(native_load(d.data, d.head))
end

func deque_back(d: Deque<T>) -> Option<T>
    if d.len == 0 out None end
    var idx = _deque_idx(d, d.len - 1)
    out Some(native_load(d.data, idx))
end

func deque_get(d: Deque<T>, idx: usize) -> Option<T>
    if idx >= d.len out None end
    var real = _deque_idx(d, idx)
    out Some(native_load(d.data, real))
end

# ─── Utility ──────────────────────────────────────────

func deque_clear(d: &Deque<T>)
    d.head = 0
    d.len = 0
end

func deque_free(d: &Deque<T>)
    if d.data != null free(d.data) end
    d.data = null
    d.head = 0
    d.len = 0
    d.cap = 0
end

func deque_to_vec(d: Deque<T>) -> Vec<T>
    var v = vec_with_cap(d.len)
    var i: usize = 0
    lặp_khi i < d.len
        var real = _deque_idx(d, i)
        vec_push(&v, native_load(d.data, real))
        i = i + 1
    end
    out v
end
