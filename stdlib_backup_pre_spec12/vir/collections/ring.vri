/*
 * vir/collections/ring.vri — Fixed-Size Ring Buffer
 * ===================================================
 * Ring buffer size cố định — hữu ích cho I/O buffering,
 * circular log, and producer-consumer patterns.
 *
 * Khác với Deque: không tự động mở rộng, overwrite khi full.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/mem/alloc" use alloc, free
import "vir/mem/copy" use mem_copy

# ═══════════════════════════════════════════════════════
# Ring<T> — Fixed-Size Circular Buffer
# ═══════════════════════════════════════════════════════

entity Ring<T>
    data:  ptr      # array T
    head:  usize    # vị trí đọc
    tail:  usize    # vị trí ghi
    len:   usize    # số element hiện tại
    cap:   usize    # size cố định
end

# ─── Constructor ──────────────────────────────────────

func ring_new(cap: usize) -> Ring<T>
    if cap == 0 cap = 16 end
    out Ring<T> {
        data = alloc(cap * size_of()),
        head = 0, tail = 0, len = 0, cap = cap
    }
end

# ─── Core Operations ─────────────────────────────────

func ring_push(r: &Ring<T>, val: T) -> Option<T>
    # Push vào cuối. Nếu full, ghi đè element cũ nhất
    # and out element bị ghi đè dưới dạng Some(...).
    var overwritten: Option<T> = None
    
    if r.len == r.cap
        # Đầy -> ghi đè head
        overwritten = Some(native_load(r.data, r.head))
        r.head = (r.head + 1) % r.cap
    else
        r.len = r.len + 1
    end
    
    native_store(r.data, r.tail, val)
    r.tail = (r.tail + 1) % r.cap
    out overwritten
end

func ring_pop(r: &Ring<T>) -> Option<T>
    # Pop từ đầu (FIFO).
    if r.len == 0 out None end
    var val = native_load(r.data, r.head)
    r.head = (r.head + 1) % r.cap
    r.len = r.len - 1
    out Some(val)
end

# ─── Access ───────────────────────────────────────────

func ring_front(r: Ring<T>) -> Option<T>
    if r.len == 0 out None end
    out Some(native_load(r.data, r.head))
end

func ring_back(r: Ring<T>) -> Option<T>
    if r.len == 0 out None end
    var idx = (r.tail + r.cap - 1) % r.cap
    out Some(native_load(r.data, idx))
end

func ring_get(r: Ring<T>, idx: usize) -> Option<T>
    if idx >= r.len out None end
    var real = (r.head + idx) % r.cap
    out Some(native_load(r.data, real))
end

# ─── Info ─────────────────────────────────────────────

func ring_len(r: Ring<T>) -> usize
    out r.len
end

func ring_cap(r: Ring<T>) -> usize
    out r.cap
end

func ring_is_empty(r: Ring<T>) -> bool
    out r.len == 0
end

func ring_is_full(r: Ring<T>) -> bool
    out r.len == r.cap
end

func ring_available(r: Ring<T>) -> usize
    out r.cap - r.len
end

# ─── Utility ──────────────────────────────────────────

func ring_clear(r: &Ring<T>)
    r.head = 0
    r.tail = 0
    r.len = 0
end

func ring_free(r: &Ring<T>)
    if r.data != null free(r.data) end
    r.data = null
    r.head = 0
    r.tail = 0
    r.len = 0
    r.cap = 0
end
