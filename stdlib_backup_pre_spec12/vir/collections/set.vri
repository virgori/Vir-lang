/*
 * vir/collections/set.vri — Hash Set
 * =====================================
 * Inspired by Python: set, frozenset
 * Triển khai: wrapper trên Map<K, void>
 *
 * Dùng cho: unique symbol tracking, keyword sets, visited nodes.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/collections/map" use Map, map_new, map_with_cap, map_insert, map_contains, map_remove, map_keys, map_len, map_is_empty, map_clear, map_free
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Set<T> — Hash Set
# ═══════════════════════════════════════════════════════

entity Set<T>
    inner: Map<T, bool>   # value luôn là true
end

func set_new(hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    out Set<T> { inner = map_new(hash_fn, eq_fn) }
end

func set_with_cap(cap: usize, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    out Set<T> { inner = map_with_cap(cap, hash_fn, eq_fn) }
end

# ─── Core Operations ─────────────────────────────────

func set_insert(s: &Set<T>, val: T) -> bool
    # Returns true if val chưa có (mới thêm).
    var old = map_insert(&s.inner, val, true)
    out is_none(old)
end

func set_remove(s: &Set<T>, val: T) -> bool
    var old = map_remove(&s.inner, val)
    out is_some(old)
end

func set_contains(s: Set<T>, val: T) -> bool
    out map_contains(s.inner, val)
end

# ─── Info ─────────────────────────────────────────────

func set_len(s: Set<T>) -> usize
    out map_len(s.inner)
end

func set_is_empty(s: Set<T>) -> bool
    out map_is_empty(s.inner)
end

# ─── Iteration ────────────────────────────────────────

func set_to_vec(s: Set<T>) -> Vec<T>
    out map_keys(s.inner)
end

# ─── Set Operations ───────────────────────────────────

func set_union(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A ∪ B
    var result = set_new(hash_fn, eq_fn)
    var va = set_to_vec(a)
    var i: usize = 0
    lặp_khi i < vec_len(va)
        set_insert(&result, vec_get(va, i))
        i = i + 1
    end
    var vb = set_to_vec(b)
    i = 0
    lặp_khi i < vec_len(vb)
        set_insert(&result, vec_get(vb, i))
        i = i + 1
    end
    out result
end

func set_intersection(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A ∩ B
    var result = set_new(hash_fn, eq_fn)
    var va = set_to_vec(a)
    var i: usize = 0
    lặp_khi i < vec_len(va)
        var elem = vec_get(va, i)
        if set_contains(b, elem)
            set_insert(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_difference(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A \ B
    var result = set_new(hash_fn, eq_fn)
    var va = set_to_vec(a)
    var i: usize = 0
    lặp_khi i < vec_len(va)
        var elem = vec_get(va, i)
        if !set_contains(b, elem)
            set_insert(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_symmetric_difference(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A △ B = (A \ B) ∪ (B \ A)
    var result = set_new(hash_fn, eq_fn)
    var va = set_to_vec(a)
    var i: usize = 0
    lặp_khi i < vec_len(va)
        var elem = vec_get(va, i)
        if !set_contains(b, elem)
            set_insert(&result, elem)
        end
        i = i + 1
    end
    var vb = set_to_vec(b)
    i = 0
    lặp_khi i < vec_len(vb)
        var elem = vec_get(vb, i)
        if !set_contains(a, elem)
            set_insert(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_is_subset(a: Set<T>, b: Set<T>) -> bool
    var va = set_to_vec(a)
    var i: usize = 0
    lặp_khi i < vec_len(va)
        if !set_contains(b, vec_get(va, i)) out false end
        i = i + 1
    end
    out true
end

func set_is_superset(a: Set<T>, b: Set<T>) -> bool
    out set_is_subset(b, a)
end

# ─── Utility ──────────────────────────────────────────

func set_clear(s: &Set<T>)
    map_clear(&s.inner)
end

func set_free(s: &Set<T>)
    map_free(&s.inner)
end
