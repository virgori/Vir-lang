/*
 * vir/collections/vec.vri — Dynamic Array (Vector)
 * ===================================================
 * Inspired by C: dynamic array pattern (malloc/realloc)
 * Inspired by Python: list, Rust Vec<T>
 *
 * ĐÂY LÀ MODULE QUAN TRỌNG NHẤT cho self-hosting:
 *   - Compiler cần Vec<Token> cho lexer output
 *   - Compiler cần Vec<Instruction> cho codegen
 *   - Compiler cần Vec<Symbol> cho symbol table
 *   - Compiler cần Vec<u8> cho binary output
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/mem/alloc" use alloc, realloc, free
import "vir/mem/copy" use mem_copy, mem_move, mem_set

# ═══════════════════════════════════════════════════════
# Vec<T> — Growable Array
# ═══════════════════════════════════════════════════════
#
# Bố cục memory:
#   [data: ptr] [len: usize] [cap: usize]
#   data trỏ tới khối memory liên tục chứa T*cap element
#   len = số element đang use, cap = số slot allocate
#
# Growth strategy: nhân đôi khi full (giống std::vector C++)
#
# Invariant: 0 <= len <= cap; cap > 0 khi data != null

entity Vec<T>
    data: ptr       # pointer tới array T
    len:  usize     # số element hiện tại
    cap:  usize     # capacity allocate
end

# ─── Constructor ──────────────────────────────────────

func vec_new() -> Vec<T>
    # Tạo vector empty, chưa allocate memory.
    out Vec<T> { data = null, len = 0, cap = 0 }
end

func vec_with_cap(cap: usize) -> Vec<T>
    # Tạo vector với capacity cho trước.
    var size = cap * size_of()
    var data = alloc(size)
    out Vec<T> { data = data, len = 0, cap = cap }
end

func vec_from_slice(src: ptr, count: usize) -> Vec<T>
    # Tạo vector từ array có sẵn.
    var v = vec_with_cap(count)
    mem_copy(v.data, src, count * size_of())
    v.len = count
    out v
end

func vec_filled(val: T, count: usize) -> Vec<T>
    # Tạo vector với count element giống nhau.
    var v = vec_with_cap(count)
    var i: usize = 0
    lặp_khi i < count
        native_store(v.data, i, val)
        i = i + 1
    end
    v.len = count
    out v
end

# ─── Capacity Management ─────────────────────────────

func vec_len(v: Vec<T>) -> usize
    out v.len
end

func vec_cap(v: Vec<T>) -> usize
    out v.cap
end

func vec_is_empty(v: Vec<T>) -> bool
    out v.len == 0
end

func vec_reserve(v: &Vec<T>, additional: usize)
    # Đảm bảo có đủ chỗ cho thêm additional element.
    var new_cap = v.len + additional
    if new_cap <= v.cap out end
    
    # Tăng gấp đôi if cần, nhưng ít nhất new_cap
    var target = v.cap * 2
    if target < new_cap target = new_cap end
    if target < 8 target = 8 end   # minimum 8 slots
    
    var new_size = target * size_of()
    if v.data == null
        v.data = alloc(new_size)
    else
        v.data = realloc(v.data, new_size)
    end
    v.cap = target
end

func vec_shrink_to_fit(v: &Vec<T>)
    # Thu gọn memory vừa đủ data.
    if v.len == v.cap out end
    if v.len == 0
        free(v.data)
        v.data = null
        v.cap = 0
        out
    end
    v.data = realloc(v.data, v.len * size_of())
    v.cap = v.len
end

# ─── Access ───────────────────────────────────────────

func vec_get(v: Vec<T>, idx: usize) -> T
    # Returns element tại vị trí idx. Panic if ngoài phạm vi.
    if idx >= v.len
        panic(str_new("vec_get: index out of bounds"))
    end
    out native_load(v.data, idx)
end

func vec_try_get(v: Vec<T>, idx: usize) -> Option<T>
    # An toàn — out None if ngoài phạm vi.
    if idx >= v.len out None end
    out Some(native_load(v.data, idx))
end

func vec_set(v: &Vec<T>, idx: usize, val: T)
    if idx >= v.len
        panic(str_new("vec_set: index out of bounds"))
    end
    native_store(v.data, idx, val)
end

func vec_first(v: Vec<T>) -> Option<T>
    if v.len == 0 out None end
    out Some(native_load(v.data, 0))
end

func vec_last(v: Vec<T>) -> Option<T>
    if v.len == 0 out None end
    out Some(native_load(v.data, v.len - 1))
end

# ─── Mutation ─────────────────────────────────────────

func vec_push(v: &Vec<T>, val: T)
    # Thêm element vào cuối. Tự mở rộng if cần.
    vec_reserve(v, 1)
    native_store(v.data, v.len, val)
    v.len = v.len + 1
end

func vec_pop(v: &Vec<T>) -> Option<T>
    # Lấy and xoá element cuối.
    if v.len == 0 out None end
    v.len = v.len - 1
    out Some(native_load(v.data, v.len))
end

func vec_insert(v: &Vec<T>, idx: usize, val: T)
    # Chèn element tại vị trí idx, đẩy element sau về phía phải.
    if idx > v.len
        panic(str_new("vec_insert: index out of bounds"))
    end
    vec_reserve(v, 1)
    # Dịch chuyển [idx..len) sang phải 1 slot
    if idx < v.len
        var src = v.data + idx * size_of()
        var dst = src + size_of()
        mem_move(dst, src, (v.len - idx) * size_of())
    end
    native_store(v.data, idx, val)
    v.len = v.len + 1
end

func vec_remove(v: &Vec<T>, idx: usize) -> T
    # Xoá element tại idx, kéo element sau sang trái.
    if idx >= v.len
        panic(str_new("vec_remove: index out of bounds"))
    end
    var val = native_load(v.data, idx)
    var remaining = v.len - idx - 1
    if remaining > 0
        var dst = v.data + idx * size_of()
        var src = dst + size_of()
        mem_move(dst, src, remaining * size_of())
    end
    v.len = v.len - 1
    out val
end

func vec_swap_remove(v: &Vec<T>, idx: usize) -> T
    # Xoá nhanh O(1) — swap với element cuối rồi pop.
    if idx >= v.len
        panic(str_new("vec_swap_remove: index out of bounds"))
    end
    var val = native_load(v.data, idx)
    v.len = v.len - 1
    if idx < v.len
        var last = native_load(v.data, v.len)
        native_store(v.data, idx, last)
    end
    out val
end

func vec_clear(v: &Vec<T>)
    v.len = 0
end

func vec_truncate(v: &Vec<T>, new_len: usize)
    if new_len < v.len
        v.len = new_len
    end
end

# ─── Extend & Append ─────────────────────────────────

func vec_extend(v: &Vec<T>, other: Vec<T>)
    # Nối toàn bộ element từ other vào cuối v.
    if other.len == 0 out end
    vec_reserve(v, other.len)
    mem_copy(
        v.data + v.len * size_of(),
        other.data,
        other.len * size_of()
    )
    v.len = v.len + other.len
end

func vec_extend_from_slice(v: &Vec<T>, src: ptr, count: usize)
    if count == 0 out end
    vec_reserve(v, count)
    mem_copy(
        v.data + v.len * size_of(),
        src,
        count * size_of()
    )
    v.len = v.len + count
end

# ─── Search ───────────────────────────────────────────

func vec_contains(v: Vec<T>, val: T) -> bool
    var i: usize = 0
    lặp_khi i < v.len
        if native_load(v.data, i) == val
            out true
        end
        i = i + 1
    end
    out false
end

func vec_find(v: Vec<T>, val: T) -> Option<usize>
    # Tìm index đầu tiên == val.
    var i: usize = 0
    lặp_khi i < v.len
        if native_load(v.data, i) == val
            out Some(i)
        end
        i = i + 1
    end
    out None
end

func vec_count(v: Vec<T>, val: T) -> usize
    var count: usize = 0
    var i: usize = 0
    lặp_khi i < v.len
        if native_load(v.data, i) == val
            count = count + 1
        end
        i = i + 1
    end
    out count
end

# ─── Transform ────────────────────────────────────────

func vec_reverse(v: &Vec<T>)
    if v.len <= 1 out end
    var lo: usize = 0
    var hi: usize = v.len - 1
    lặp_khi lo < hi
        var tmp = native_load(v.data, lo)
        native_store(v.data, lo, native_load(v.data, hi))
        native_store(v.data, hi, tmp)
        lo = lo + 1
        hi = hi - 1
    end
end

func vec_clone(v: Vec<T>) -> Vec<T>
    # Deep copy.
    if v.len == 0 out vec_new() end
    var nv = vec_with_cap(v.len)
    mem_copy(nv.data, v.data, v.len * size_of())
    nv.len = v.len
    out nv
end

func vec_slice(v: Vec<T>, start: usize, end: usize) -> Vec<T>
    # Returns bản sao của [start..end).
    if start > end or end > v.len
        panic(str_new("vec_slice: range out of bounds"))
    end
    var count = end - start
    var nv = vec_with_cap(count)
    mem_copy(nv.data, v.data + start * size_of(), count * size_of())
    nv.len = count
    out nv
end

# ─── Equality ─────────────────────────────────────────

func vec_eq(a: Vec<T>, b: Vec<T>) -> bool
    if a.len != b.len out false end
    var i: usize = 0
    lặp_khi i < a.len
        if native_load(a.data, i) != native_load(b.data, i)
            out false
        end
        i = i + 1
    end
    out true
end

# ─── Memory ───────────────────────────────────────────

func vec_free(v: &Vec<T>)
    if v.data != null
        free(v.data)
        v.data = null
    end
    v.len = 0
    v.cap = 0
end

func vec_as_ptr(v: Vec<T>) -> ptr
    out v.data
end

func vec_as_slice(v: Vec<T>) -> Slice
    out Slice { data = v.data, len = v.len * size_of() }
end

# ─── Iteration Helpers ────────────────────────────────

func vec_for_each(v: Vec<T>, f: func(T))
    var i: usize = 0
    lặp_khi i < v.len
        f(native_load(v.data, i))
        i = i + 1
    end
end

func vec_map(v: Vec<T>, f: func(T) -> U) -> Vec<U>
    var out = vec_with_cap(v.len)
    var i: usize = 0
    lặp_khi i < v.len
        vec_push(&out, f(native_load(v.data, i)))
        i = i + 1
    end
    out out
end

func vec_filter(v: Vec<T>, pred: func(T) -> bool) -> Vec<T>
    var out = vec_new()
    var i: usize = 0
    lặp_khi i < v.len
        var elem = native_load(v.data, i)
        if pred(elem)
            vec_push(&out, elem)
        end
        i = i + 1
    end
    out out
end

func vec_any(v: Vec<T>, pred: func(T) -> bool) -> bool
    var i: usize = 0
    lặp_khi i < v.len
        if pred(native_load(v.data, i)) out true end
        i = i + 1
    end
    out false
end

func vec_all(v: Vec<T>, pred: func(T) -> bool) -> bool
    var i: usize = 0
    lặp_khi i < v.len
        if !pred(native_load(v.data, i)) out false end
        i = i + 1
    end
    out true
end
