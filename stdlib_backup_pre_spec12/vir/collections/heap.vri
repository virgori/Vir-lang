/*
 * vir/collections/heap.vri — Binary Min-Heap / Priority Queue
 * =============================================================
 * Inspired by Python: heapq
 * Triển khai: binary heap trên Vec<T>
 *
 * Mặc định là min-heap. Để làm max-heap, use comparator đảo.
 * Compiler use: register allocation (priority spill), scheduling.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_pop, vec_get, vec_set, vec_len, vec_is_empty, vec_free

# ═══════════════════════════════════════════════════════
# Heap<T> — Binary Min-Heap
# ═══════════════════════════════════════════════════════

entity Heap<T>
    items: Vec<T>
    cmp:   func(T, T) -> i32   # < 0 if a < b, 0 if bằng, > 0 if a > b
end

# ─── Internal ─────────────────────────────────────────

func _parent(i: usize) -> usize
    out (i - 1) / 2
end

func _left(i: usize) -> usize
    out 2 * i + 1
end

func _right(i: usize) -> usize
    out 2 * i + 2
end

func _heap_swap(h: &Heap<T>, a: usize, b: usize)
    var va = vec_get(h.items, a)
    var vb = vec_get(h.items, b)
    vec_set(&h.items, a, vb)
    vec_set(&h.items, b, va)
end

func _sift_up(h: &Heap<T>, idx: usize)
    var i = idx
    lặp_khi i > 0
        var p = _parent(i)
        if h.cmp(vec_get(h.items, i), vec_get(h.items, p)) < 0
            _heap_swap(h, i, p)
            i = p
        else
            thoát
        end
    end
end

func _sift_down(h: &Heap<T>, idx: usize)
    var n = vec_len(h.items)
    var i = idx
    loop
        var smallest = i
        var l = _left(i)
        var r = _right(i)
        
        if l < n and h.cmp(vec_get(h.items, l), vec_get(h.items, smallest)) < 0
            smallest = l
        end
        if r < n and h.cmp(vec_get(h.items, r), vec_get(h.items, smallest)) < 0
            smallest = r
        end
        
        if smallest == i thoát end
        _heap_swap(h, i, smallest)
        i = smallest
    end
end

# ─── Constructor ──────────────────────────────────────

func heap_new(cmp: func(T, T) -> i32) -> Heap<T>
    out Heap<T> { items = vec_new(), cmp = cmp }
end

func heap_from_vec(v: Vec<T>, cmp: func(T, T) -> i32) -> Heap<T>
    # Xây heap từ vector O(n) — heapify.
    var h = Heap<T> { items = v, cmp = cmp }
    var n = vec_len(h.items)
    if n <= 1 out h end
    var i = n / 2
    loop
        _sift_down(&h, i)
        if i == 0 thoát end
        i = i - 1
    end
    out h
end

# ─── Operations ───────────────────────────────────────

func heap_push(h: &Heap<T>, val: T)
    vec_push(&h.items, val)
    _sift_up(h, vec_len(h.items) - 1)
end

func heap_pop(h: &Heap<T>) -> Option<T>
    var n = vec_len(h.items)
    if n == 0 out None end
    if n == 1 out vec_pop(&h.items) end
    
    # Swap root với element cuối, rồi sift down
    _heap_swap(h, 0, n - 1)
    var val = vec_pop(&h.items)
    _sift_down(h, 0)
    out val
end

func heap_peek(h: Heap<T>) -> Option<T>
    if vec_is_empty(h.items) out None end
    out Some(vec_get(h.items, 0))
end

func heap_len(h: Heap<T>) -> usize
    out vec_len(h.items)
end

func heap_is_empty(h: Heap<T>) -> bool
    out vec_is_empty(h.items)
end

func heap_clear(h: &Heap<T>)
    vec_clear(&h.items)
end

func heap_free(h: &Heap<T>)
    vec_free(&h.items)
end

# ─── Tiện ích ─────────────────────────────────────────

func cmp_i64_asc(a: i64, b: i64) -> i32
    if a < b out -1 end
    if a > b out 1 end
    out 0
end

func cmp_i64_desc(a: i64, b: i64) -> i32
    if a > b out -1 end
    if a < b out 1 end
    out 0
end
