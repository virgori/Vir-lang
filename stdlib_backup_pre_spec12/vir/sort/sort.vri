/*
 * vir/sort/sort.vri — Sorting Algorithms
 * ========================================
 * Inspired by Python: list.sort(), sorted(), bisect
 * Inspired by C: qsort
 *
 * Triển khai: Introsort (quicksort + heapsort fallback + insertion sort for small)
 * + binary search
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/collections/vec" use Vec, vec_get, vec_set, vec_len

# ═══════════════════════════════════════════════════════
# Sort API
# ═══════════════════════════════════════════════════════

func sort(v: &Vec<T>, cmp: func(T, T) -> i32)
    # In-place sort bằng introsort.
    var n = vec_len(*v)
    if n <= 1 out end
    var max_depth = _log2(n) * 2
    _introsort(v, 0, n - 1, max_depth, cmp)
end

func is_sorted(v: Vec<T>, cmp: func(T, T) -> i32) -> bool
    var n = vec_len(v)
    if n <= 1 out true end
    var i: usize = 0
    lặp_khi i < n - 1
        if cmp(vec_get(v, i), vec_get(v, i + 1)) > 0
            out false
        end
        i = i + 1
    end
    out true
end

# ═══════════════════════════════════════════════════════
# Binary Search
# ═══════════════════════════════════════════════════════

func binary_search(v: Vec<T>, target: T, cmp: func(T, T) -> i32) -> Option<usize>
    # Tìm index chính xác. Vec phải sorted.
    var n = vec_len(v)
    if n == 0 out None end
    
    var lo: usize = 0
    var hi: usize = n - 1
    
    lặp_khi lo <= hi
        var mid = lo + (hi - lo) / 2
        var c = cmp(vec_get(v, mid), target)
        if c == 0 out Some(mid)
        eif c < 0 lo = mid + 1
        else
            if mid == 0 thoát end
            hi = mid - 1
        end
    end
    out None
end

func bisect_left(v: Vec<T>, target: T, cmp: func(T, T) -> i32) -> usize
    # Tìm vị trí chèn bên trái (leftmost, Python bisect_left).
    var lo: usize = 0
    var hi: usize = vec_len(v)
    lặp_khi lo < hi
        var mid = lo + (hi - lo) / 2
        if cmp(vec_get(v, mid), target) < 0
            lo = mid + 1
        else
            hi = mid
        end
    end
    out lo
end

func bisect_right(v: Vec<T>, target: T, cmp: func(T, T) -> i32) -> usize
    # Python bisect_right.
    var lo: usize = 0
    var hi: usize = vec_len(v)
    lặp_khi lo < hi
        var mid = lo + (hi - lo) / 2
        if cmp(vec_get(v, mid), target) <= 0
            lo = mid + 1
        else
            hi = mid
        end
    end
    out lo
end

# ═══════════════════════════════════════════════════════
# Introsort Implementation
# ═══════════════════════════════════════════════════════

hằng_số INSERTION_THRESHOLD: usize = 16

func _introsort(v: &Vec<T>, lo: usize, hi: usize, depth: usize, cmp: func(T, T) -> i32)
    if hi - lo < INSERTION_THRESHOLD
        _insertion_sort(v, lo, hi, cmp)
        out
    end
    
    if depth == 0
        _heap_sort_range(v, lo, hi, cmp)
        out
    end
    
    var pivot = _partition(v, lo, hi, cmp)
    if pivot > lo
        _introsort(v, lo, pivot - 1, depth - 1, cmp)
    end
    if pivot < hi
        _introsort(v, pivot + 1, hi, depth - 1, cmp)
    end
end

func _insertion_sort(v: &Vec<T>, lo: usize, hi: usize, cmp: func(T, T) -> i32)
    var i = lo + 1
    lặp_khi i <= hi
        var key = vec_get(*v, i)
        var j = i
        lặp_khi j > lo
            var prev = vec_get(*v, j - 1)
            if cmp(prev, key) <= 0 thoát end
            vec_set(v, j, prev)
            j = j - 1
        end
        vec_set(v, j, key)
        i = i + 1
    end
end

func _partition(v: &Vec<T>, lo: usize, hi: usize, cmp: func(T, T) -> i32) -> usize
    # Median-of-three pivot selection
    var mid = lo + (hi - lo) / 2
    _sort_three(v, lo, mid, hi, cmp)
    var pivot = vec_get(*v, mid)
    
    # Swap pivot to hi-1
    _vec_swap(v, mid, hi - 1)
    
    var i = lo
    var j = hi - 1
    loop
        loop
            i = i + 1
            if cmp(vec_get(*v, i), pivot) >= 0 thoát end
        end
        loop
            j = j - 1
            if j <= i or cmp(vec_get(*v, j), pivot) <= 0 thoát end
        end
        if i >= j thoát end
        _vec_swap(v, i, j)
    end
    
    # Put pivot back
    _vec_swap(v, i, hi - 1)
    out i
end

func _heap_sort_range(v: &Vec<T>, lo: usize, hi: usize, cmp: func(T, T) -> i32)
    var n = hi - lo + 1
    # Build heap
    var i = n / 2
    loop
        _sift_down_range(v, lo, i, n, cmp)
        if i == 0 thoát end
        i = i - 1
    end
    # Extract
    var end = n - 1
    lặp_khi end > 0
        _vec_swap(v, lo, lo + end)
        _sift_down_range(v, lo, 0, end, cmp)
        end = end - 1
    end
end

func _sift_down_range(v: &Vec<T>, base: usize, idx: usize, n: usize, cmp: func(T, T) -> i32)
    var i = idx
    loop
        var largest = i
        var l = 2 * i + 1
        var r = 2 * i + 2
        if l < n and cmp(vec_get(*v, base + l), vec_get(*v, base + largest)) > 0
            largest = l
        end
        if r < n and cmp(vec_get(*v, base + r), vec_get(*v, base + largest)) > 0
            largest = r
        end
        if largest == i thoát end
        _vec_swap(v, base + i, base + largest)
        i = largest
    end
end

# ─── Helpers ──────────────────────────────────────────

func _vec_swap(v: &Vec<T>, a: usize, b: usize)
    var va = vec_get(*v, a)
    var vb = vec_get(*v, b)
    vec_set(v, a, vb)
    vec_set(v, b, va)
end

func _sort_three(v: &Vec<T>, a: usize, b: usize, c: usize, cmp: func(T, T) -> i32)
    if cmp(vec_get(*v, a), vec_get(*v, b)) > 0 _vec_swap(v, a, b) end
    if cmp(vec_get(*v, b), vec_get(*v, c)) > 0 _vec_swap(v, b, c) end
    if cmp(vec_get(*v, a), vec_get(*v, b)) > 0 _vec_swap(v, a, b) end
end

func _log2(n: usize) -> usize
    var log: usize = 0
    var v = n
    lặp_khi v > 1
        v = v >> 1
        log = log + 1
    end
    out log
end
