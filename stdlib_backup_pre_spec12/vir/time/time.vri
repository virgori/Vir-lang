/*
 * vir/time/time.vri — Time & Duration
 * =====================================
 * Inspired by C23: <time.h> clock_gettime, nanosleep
 * Inspired by Python: time, datetime
 *
 * Compiler uses internally: benchmark compile time, JIT timing.
 */

import "vir/core/types" use all
import "vir/str/string" use String
import "vir/str/builder" use StringBuilder, sb_new, sb_append_i64, sb_append_cstr, sb_build, sb_free

# ═══════════════════════════════════════════════════════
# Duration — khoảng thời gian (nanosecond-precision)
# ═══════════════════════════════════════════════════════

entity Duration
    secs: u64       # Số giây
    nanos: u32      # Phần dư nanoseconds (0..999_999_999)
end

func duration_zero() -> Duration
    out Duration { secs: 0, nanos: 0 }
end

func duration_from_secs(s: u64) -> Duration
    out Duration { secs: s, nanos: 0 }
end

func duration_from_millis(ms: u64) -> Duration
    out Duration { secs: ms / 1000, nanos: to_u32((ms % 1000) * 1_000_000) }
end

func duration_from_micros(us: u64) -> Duration
    out Duration { secs: us / 1_000_000, nanos: to_u32((us % 1_000_000) * 1000) }
end

func duration_from_nanos(ns: u64) -> Duration
    out Duration { secs: ns / 1_000_000_000, nanos: to_u32(ns % 1_000_000_000) }
end

func duration_to_secs(d: Duration) -> u64
    out d.secs
end

func duration_to_millis(d: Duration) -> u64
    out d.secs * 1000 + d.nanos / 1_000_000
end

func duration_to_micros(d: Duration) -> u64
    out d.secs * 1_000_000 + d.nanos / 1000
end

func duration_to_nanos(d: Duration) -> u64
    out d.secs * 1_000_000_000 + d.nanos
end

func duration_add(a: Duration, b: Duration) -> Duration
    var nanos = a.nanos + b.nanos
    var carry = nanos / 1_000_000_000
    out Duration { secs: a.secs + b.secs + carry, nanos: nanos % 1_000_000_000 }
end

func duration_sub(a: Duration, b: Duration) -> Duration
    var total_a = duration_to_nanos(a)
    var total_b = duration_to_nanos(b)
    if total_b > total_a out duration_zero() end
    out duration_from_nanos(total_a - total_b)
end

func duration_is_zero(d: Duration) -> bool
    out d.secs == 0 and d.nanos == 0
end

func duration_display(d: Duration) -> String
    var sb = sb_new()
    if d.secs > 0
        sb_append_i64(sb, d.secs)
        sb_append_cstr(sb, "s ")
    end
    var ms = d.nanos / 1_000_000
    var us = (d.nanos % 1_000_000) / 1000
    if ms > 0
        sb_append_i64(sb, ms)
        sb_append_cstr(sb, "ms")
    eif us > 0
        sb_append_i64(sb, us)
        sb_append_cstr(sb, "μs")
    else
        sb_append_i64(sb, d.nanos)
        sb_append_cstr(sb, "ns")
    end
    var result = sb_build(sb)
    sb_free(sb)
    out result
end

# ═══════════════════════════════════════════════════════
# Instant — mốc thời gian (monotonic clock)
# ═══════════════════════════════════════════════════════

entity Instant
    nanos: u64     # nanoseconds from monotonic clock
end

func now() -> Instant
    # Lấy mốc thời gian hiện tại từ monotonic clock.
    out Instant { nanos: native_clock_monotonic_ns() }
end

func elapsed(start: Instant) -> Duration
    # Thời gian trôi qua kể từ start.
    var current = now()
    if current.nanos < start.nanos
        out duration_zero()
    end
    out duration_from_nanos(current.nanos - start.nanos)
end

func since(start: Instant, end: Instant) -> Duration
    if end.nanos < start.nanos out duration_zero() end
    out duration_from_nanos(end.nanos - start.nanos)
end

# ═══════════════════════════════════════════════════════
# Wall Clock (real time, not monotonic)
# ═══════════════════════════════════════════════════════

func unix_timestamp_secs() -> u64
    # Seconds since Unix epoch (1970-01-01T00:00:00Z)
    out native_clock_realtime_secs()
end

func unix_timestamp_millis() -> u64
    out native_clock_realtime_ms()
end

# ═══════════════════════════════════════════════════════
# Sleep
# ═══════════════════════════════════════════════════════

func sleep(d: Duration)
    native_sleep_ns(duration_to_nanos(d))
end

func sleep_ms(ms: u64)
    sleep(duration_from_millis(ms))
end

func sleep_secs(s: u64)
    sleep(duration_from_secs(s))
end

# ═══════════════════════════════════════════════════════
# Timer helper (đo thời gian thực thi)
# ═══════════════════════════════════════════════════════

entity Timer
    start: Instant
    label: String
end

func timer_start(label: String) -> Timer
    out Timer { start: now(), label: label }
end

func timer_elapsed(t: Timer) -> Duration
    out elapsed(t.start)
end

func timer_stop(t: Timer) -> Duration
    var d = elapsed(t.start)
    # Optional: print timing
    # eprintln("[" + t.label + "] " + duration_display(d))
    out d
end
