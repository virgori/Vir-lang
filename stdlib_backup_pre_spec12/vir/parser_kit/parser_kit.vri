/*
 * vir/parser_kit/parser_kit.vri — Parser Combinator Kit
 * =======================================================
 * Phase D — self-hosting: parser for Vir language
 *
 * Recursive descent parser using token stream from vir.token
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_concat, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/token/token" use Token, TokenKind, Lexer, lexer_new, lexer_tokenize
import "vir/ast/ast" use *

# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser
    tokens: Vec<Token>
    pos:    usize
    errors: Vec<ParseError>
end

entity ParseError
    message: String
    span:    Span
end

func parser_new(source: String, file: String) -> Parser
    var lex = lexer_new(source, file)
    var tokens = lexer_tokenize(&lex)
    out Parser {
        tokens = tokens,
        pos = 0,
        errors = vec_new()
    }
end

# ─── Token navigation ────────────────────────────────

func _peek(p: &Parser) -> Token
    if p.pos >= vec_len(p.tokens)
        out Token { kind = TokenKind.EOF, text = str_new(""), span = span_new(str_new(""), 0, 0, 0, 0) }
    end
    out vec_get(p.tokens, p.pos)
end

func _peek_kind(p: &Parser) -> TokenKind
    out _peek(p).kind
end

func _advance(p: &Parser) -> Token
    var tok = _peek(p)
    if p.pos < vec_len(p.tokens)
        p.pos = p.pos + 1
    end
    out tok
end

func _expect(p: &Parser, kind: TokenKind) -> Result<Token, ParseError>
    var tok = _peek(p)
    if tok.kind != kind
        var err = ParseError {
            message = str_concat(str_new("expected "), token_kind_name(kind)),
            span = tok.span
        }
        vec_push(&p.errors, err)
        out Err(err)
    end
    out Ok(_advance(p))
end

func _check(p: &Parser, kind: TokenKind) -> bool
    out _peek_kind(p) == kind
end

func _match(p: &Parser, kind: TokenKind) -> bool
    if _peek_kind(p) == kind
        _advance(p)
        out true
    end
    out false
end

func token_kind_name(k: TokenKind) -> String
    chọn k
        case TokenKind.KwHàm out str_new("'func'")
        case TokenKind.KwBiến out str_new("'var'")
        case TokenKind.KwBảnGhi out str_new("'entity'")
        case TokenKind.KwLiệtKê out str_new("'enum'")
        case TokenKind.Ident out str_new("identifier")
        case TokenKind.EOF out str_new("end of file")
        mặc_định out str_new("token")
    end
end

# ═══════════════════════════════════════════════════════
# Parse: Program
# ═══════════════════════════════════════════════════════

func parse_program(p: &Parser) -> Result<Program, Vec<ParseError>>
    var prog = program_new()
    var items = vec_new()
    
    lặp_khi _peek_kind(p) != TokenKind.EOF
        var item_result = _parse_item(p)
        chọn item_result
            case Ok(item) vec_push(&items, item)
            case Err(e)
                # Error recovery: skip to next item boundary
                _recover_to_item_boundary(p)
        end
    end
    
    if vec_len(p.errors) > 0
        out Err(p.errors)
    end
    
    var mod_ = Module { name = str_new("main"), path = str_new(""), items = items }
    program_add_module(&prog, mod_)
    out Ok(prog)
end

func _recover_to_item_boundary(p: &Parser)
    loop
        var k = _peek_kind(p)
        if k == TokenKind.EOF thoát end
        if k == TokenKind.KwHàm or k == TokenKind.KwBảnGhi or k == TokenKind.KwLiệtKê
           or k == TokenKind.KwNhập or k == TokenKind.KwHằngSố thoát end
        _advance(p)
    end
end

# ═══════════════════════════════════════════════════════
# Parse: Items
# ═══════════════════════════════════════════════════════

func _parse_item(p: &Parser) -> Result<Item, ParseError>
    var k = _peek_kind(p)
    
    chọn k
        case TokenKind.KwHàm out _parse_fn_def(p)
        case TokenKind.KwBảnGhi out _parse_struct_def(p)
        case TokenKind.KwLiệtKê out _parse_enum_def(p)
        case TokenKind.KwNhập out _parse_import(p)
        case TokenKind.KwHằngSố out _parse_const_item(p)
        mặc_định
            var tok = _advance(p)
            var err = ParseError {
                message = str_concat(str_new("unexpected token: "), tok.text),
                span = tok.span
            }
            vec_push(&p.errors, err)
            out Err(err)
    end
end

func _parse_fn_def(p: &Parser) -> Result<Item, ParseError>
    var kw = _advance(p)   # func
    
    # Check for 'ngoài' (extern)
    if _check(p, TokenKind.KwNgoài)
        _advance(p)
        out _parse_extern_fn(p, kw.span)
    end
    
    var name_tok = _expect(p, TokenKind.Ident)
    var name: String
    var name_span: Span
    chọn name_tok
        case Err(e) out Err(e)
        case Ok(t) name = t.text; name_span = t.span
    end
    
    # Generics: <T, U>
    var generics = vec_new()
    if _match(p, TokenKind.Lt)
        loop
            var g_tok = _expect(p, TokenKind.Ident)
            chọn g_tok
                case Ok(t) vec_push(&generics, t.text)
                case Err(e) thoát
            end
            if !_match(p, TokenKind.Comma) thoát end
        end
        _expect(p, TokenKind.Gt)
    end
    
    # Params: (name: Type, ...)
    _expect(p, TokenKind.LParen)
    var params = _parse_params(p)
    _expect(p, TokenKind.RParen)
    
    # Return type: -> Type
    var return_ty: Option<TypeNode> = None
    if _match(p, TokenKind.Arrow)
        var ty = _parse_type(p)
        return_ty = Some(ty)
    end
    
    # Body
    var body = _parse_block(p)
    
    out Ok(Item.Function(FnDef {
        name = name, vis = Visibility.Public,
        params = params, return_ty = return_ty,
        generics = generics, body = body,
        span = span_merge(kw.span, name_span)
    }))
end

func _parse_extern_fn(p: &Parser, start_span: Span) -> Result<Item, ParseError>
    var name_tok = _expect(p, TokenKind.Ident)
    var name: String
    chọn name_tok
        case Err(e) out Err(e)
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.LParen)
    var params = _parse_params(p)
    _expect(p, TokenKind.RParen)
    
    var return_ty: Option<TypeNode> = None
    if _match(p, TokenKind.Arrow)
        return_ty = Some(_parse_type(p))
    end
    
    out Ok(Item.ExternFn(ExternFnDef {
        name = name, params = params,
        return_ty = return_ty, span = start_span
    }))
end

func _parse_struct_def(p: &Parser) -> Result<Item, ParseError>
    var kw = _advance(p)   # entity
    var name_tok = _expect(p, TokenKind.Ident)
    var name: String
    chọn name_tok
        case Err(e) out Err(e)
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.KwThì)    #
    var fields = vec_new()
    lặp_khi !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF)
        var fname = _expect(p, TokenKind.Ident)
        _expect(p, TokenKind.Colon)
        var ftype = _parse_type(p)
        chọn fname
            case Ok(ft)
                vec_push(&fields, FieldDef {
                    name = ft.text, type_ = ftype, span = ft.span
                })
            case Err(_) {}
        end
    end
    _expect(p, TokenKind.KwHết)    # end
    
    out Ok(Item.Struct(StructDef {
        name = name, vis = Visibility.Public,
        generics = vec_new(), fields = fields,
        span = kw.span
    }))
end

func _parse_enum_def(p: &Parser) -> Result<Item, ParseError>
    var kw = _advance(p)   # enum
    var name_tok = _expect(p, TokenKind.Ident)
    var name: String
    chọn name_tok
        case Err(e) out Err(e)
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.KwThì)
    
    var variants = vec_new()
    lặp_khi !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF)
        var vname = _expect(p, TokenKind.Ident)
        var var_fields = vec_new()
        var var_value: Option<i64> = None
        
        # Variant(T1, T2) or Variant = value
        if _match(p, TokenKind.LParen)
            loop
                vec_push(&var_fields, _parse_type(p))
                if !_match(p, TokenKind.Comma) thoát end
            end
            _expect(p, TokenKind.RParen)
        eif _match(p, TokenKind.Eq)
            var val_tok = _expect(p, TokenKind.IntLiteral)
            chọn val_tok
                case Ok(t) var_value = Some(str_to_i64(t.text))
                case Err(_) {}
            end
        end
        
        chọn vname
            case Ok(vt)
                vec_push(&variants, VariantDef {
                    name = vt.text, fields = var_fields,
                    value = var_value, span = vt.span
                })
            case Err(_) {}
        end
    end
    _expect(p, TokenKind.KwHết)
    
    out Ok(Item.Enum(EnumDef {
        name = name, vis = Visibility.Public,
        generics = vec_new(), variants = variants,
        span = kw.span
    }))
end

func _parse_import(p: &Parser) -> Result<Item, ParseError>
    var kw = _advance(p)   # import
    var path_tok = _expect(p, TokenKind.StringLiteral)
    var path_str: String
    chọn path_tok
        case Err(e) out Err(e)
        case Ok(t)
            # Strip quotes
            path_str = str_slice_bytes(t.text, 1, str_byte_len(t.text) - 1)
    end
    
    var path_parts = str_split(path_str, str_new("/"))
    var items = vec_new()
    var all = false
    
    if _match(p, TokenKind.KwDùng)
        if _check(p, TokenKind.KwHết) # use all
            _advance(p)
            all = true
        else
            loop
                var item_tok = _expect(p, TokenKind.Ident)
                chọn item_tok
                    case Ok(t) vec_push(&items, t.text)
                    case Err(_) thoát
                end
                if !_match(p, TokenKind.Comma) thoát end
            end
        end
    end
    
    out Ok(Item.Import(ImportDef {
        path = path_parts, items = items, all = all,
        alias = None, span = kw.span
    }))
end

func _parse_const_item(p: &Parser) -> Result<Item, ParseError>
    var kw = _advance(p)   # hằng_số
    var name_tok = _expect(p, TokenKind.Ident)
    var name: String
    chọn name_tok
        case Err(e) out Err(e)
        case Ok(t) name = t.text
    end
    
    var ty: TypeNode = TypeNode.Infer
    if _match(p, TokenKind.Colon) ty = _parse_type(p) end
    _expect(p, TokenKind.Eq)
    var expr = _parse_expr(p)
    
    out Ok(Item.Const(name, ty, expr, kw.span))
end

# ═══════════════════════════════════════════════════════
# Parse: Types, Params, Block, Expr (stubs)
# ═══════════════════════════════════════════════════════

func _parse_params(p: &Parser) -> Vec<Param>
    var params = vec_new()
    lặp_khi !_check(p, TokenKind.RParen) and !_check(p, TokenKind.EOF)
        var name_tok = _expect(p, TokenKind.Ident)
        _expect(p, TokenKind.Colon)
        var ty = _parse_type(p)
        chọn name_tok
            case Ok(t)
                vec_push(&params, Param {
                    name = t.text, type_ = ty,
                    default_ = None, span = t.span
                })
            case Err(_) {}
        end
        if !_match(p, TokenKind.Comma) thoát end
    end
    out params
end

func _parse_type(p: &Parser) -> TypeNode
    var tok = _advance(p)
    if tok.kind == TokenKind.Ampersand
        out TypeNode.Ref(_parse_type(p))
    end
    if tok.kind == TokenKind.Ident
        # Check for generic: Name<T>
        if _match(p, TokenKind.Lt)
            var args = vec_new()
            loop
                vec_push(&args, _parse_type(p))
                if !_match(p, TokenKind.Comma) thoát end
            end
            _expect(p, TokenKind.Gt)
            out TypeNode.Generic(tok.text, args)
        end
        out TypeNode.Named(tok.text)
    end
    out TypeNode.Infer
end

func _parse_block(p: &Parser) -> Vec<Stmt>
    # Simplified: parse statements until 'end'
    var stmts = vec_new()
    lặp_khi !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF)
        var stmt = _parse_stmt(p)
        vec_push(&stmts, stmt)
    end
    _match(p, TokenKind.KwHết)
    out stmts
end

func _parse_stmt(p: &Parser) -> Stmt
    var k = _peek_kind(p)
    chọn k
        case TokenKind.KwBiến out _parse_let_stmt(p)
        case TokenKind.KwTrảVề out _parse_return_stmt(p)
        case TokenKind.KwThoát
            var t = _advance(p); out Stmt.Break(t.span)
        case TokenKind.KwTiếpTục
            var t = _advance(p); out Stmt.Continue(t.span)
        mặc_định
            var expr = _parse_expr(p)
            out Stmt.ExprStmt(expr, _peek(p).span)
    end
end

func _parse_let_stmt(p: &Parser) -> Stmt
    var kw = _advance(p)   # var
    var name_tok = _advance(p)
    var ty: Option<TypeNode> = None
    if _match(p, TokenKind.Colon) ty = Some(_parse_type(p)) end
    var init: Option<Expr> = None
    if _match(p, TokenKind.Eq) init = Some(_parse_expr(p)) end
    out Stmt.Let(name_tok.text, ty, init, kw.span)
end

func _parse_return_stmt(p: &Parser) -> Stmt
    var kw = _advance(p)   # out
    if _check(p, TokenKind.KwHết) or _check(p, TokenKind.EOF)
        out Stmt.Return(None, kw.span)
    end
    out Stmt.Return(Some(_parse_expr(p)), kw.span)
end

func _parse_expr(p: &Parser) -> Expr
    # Simplified expression parser — Pratt parsing for full impl
    var tok = _advance(p)
    chọn tok.kind
        case TokenKind.IntLiteral
            out Expr.IntLit(str_to_i64(tok.text), tok.span)
        case TokenKind.FloatLiteral
            out Expr.FloatLit(str_to_f64(tok.text), tok.span)
        case TokenKind.StringLiteral
            out Expr.StrLit(tok.text, tok.span)
        case TokenKind.KwĐúng
            out Expr.BoolLit(true, tok.span)
        case TokenKind.KwSai
            out Expr.BoolLit(false, tok.span)
        case TokenKind.Ident
            # Check for function call
            if _check(p, TokenKind.LParen)
                _advance(p)
                var args = vec_new()
                lặp_khi !_check(p, TokenKind.RParen) and !_check(p, TokenKind.EOF)
                    vec_push(&args, _parse_expr(p))
                    _match(p, TokenKind.Comma)
                end
                _expect(p, TokenKind.RParen)
                out Expr.Call(Expr.Ident(tok.text, tok.span), args, tok.span)
            end
            out Expr.Ident(tok.text, tok.span)
        mặc_định
            out Expr.NullLit(tok.span)
    end
end
