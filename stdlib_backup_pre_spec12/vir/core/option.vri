/*
 * vir/core/option.vri — Option<T> = Some(T) | None
 * ==================================================
 * Thay thế cho NULL pointer. Mọi value có thể vắng mặt
 * phải được bọc in Option.
 *
 * Compiler uses internally: result lookup symbol table, find token, etc.
 */

import "vir/core/types" use all

# ═══════════════════════════════════════════════════════
# Option type — tagged union
# ═══════════════════════════════════════════════════════

enum Option
    Some(giá_trị)     # Có value
    None              # Không có value
end

# ═══════════════════════════════════════════════════════
# Kiểm tra trạng thái
# ═══════════════════════════════════════════════════════

func is_some(opt: Option) -> bool
    chọn opt
        case Some(_) out true
        case None out false
    end
end

func is_none(opt: Option) -> bool
    out not is_some(opt)
end

# ═══════════════════════════════════════════════════════
# Lấy value
# ═══════════════════════════════════════════════════════

func unwrap(opt: Option)
    # Lấy value internally Some. Panic if None.
    chọn opt
        case Some(v) out v
        case None panic("unwrap() called on None")
    end
end

func unwrap_or(opt: Option, mặc_định)
    # Lấy value internally Some, or out mặc_định if None.
    chọn opt
        case Some(v) out v
        case None out mặc_định
    end
end

func unwrap_or_else(opt: Option, f: func)
    # Lấy value internally Some, or gọi f() if None.
    chọn opt
        case Some(v) out v
        case None out f()
    end
end

func expect(opt: Option, msg: String)
    # Giống unwrap nhưng với thông báo lỗi tùy chỉnh.
    chọn opt
        case Some(v) out v
        case None panic(msg)
    end
end

# ═══════════════════════════════════════════════════════
# Biến đổi (Transformations)
# ═══════════════════════════════════════════════════════

func map(opt: Option, f: func) -> Option
    # Áp dụng f lên value internally if Some, giữ None.
    # Some(x).map(f) -> Some(f(x))
    # None.map(f) -> None
    chọn opt
        case Some(v) out Some(f(v))
        case None out None
    end
end

func flat_map(opt: Option, f: func) -> Option
    # f phải out Option. Flatten result.
    # Some(x).flat_map(f) -> f(x)
    # None.flat_map(f) -> None
    chọn opt
        case Some(v) out f(v)
        case None out None
    end
end

func filter(opt: Option, predicate: func) -> Option
    # Giữ Some if predicate(value) out true, ngược lại None.
    chọn opt
        case Some(v)
            if predicate(v)
                out Some(v)
            else
                out None
            end
        case None out None
    end
end

func or_else(opt: Option, alternative: Option) -> Option
    # Returns opt if Some, ngược lại out alternative.
    chọn opt
        case Some(_) out opt
        case None out alternative
    end
end

func zip(a: Option, b: Option) -> Option
    # Kết hợp hai Option thành Option<(a, b)>.
    # Cả hai phải Some result mới Some.
    if is_some(a) and is_some(b)
        out Some((unwrap(a), unwrap(b)))
    end
    out None
end

# ═══════════════════════════════════════════════════════
# Chuyển đổi
# ═══════════════════════════════════════════════════════

func option_to_result(opt: Option, err) -> Result
    # Some(v) -> Ok(v), None -> Err(err)
    chọn opt
        case Some(v) out Ok(v)
        case None out Err(err)
    end
end
