/*
 * vir/core/types.vri — Primitive types & limits
 * ===================================================
 * Inspired by C23: <stdint.h>, <stddef.h>, <limits.h>, <float.h>
 * Inspired by Python: builtins (int, float, bool, None)
 *
 * This is the foundation: all other modules depend on vir/core/types.
 * Compiler uses internally: i64 for registers, u8 for byte buffer, bool for flags.
 */

# ═══════════════════════════════════════════════════════
# Signed integer types
# ═══════════════════════════════════════════════════════

type i8     # 8-bit signed:  -128 .. 127
type i16    # 16-bit signed: -32768 .. 32767
type i32    # 32-bit signed: -2^31 .. 2^31 - 1
type i64    # 64-bit signed: -2^63 .. 2^63 - 1  (default for integers)

# ═══════════════════════════════════════════════════════
# Unsigned integer types
# ═══════════════════════════════════════════════════════

type u8     # 8-bit unsigned: 0 .. 255
type u16    # 16-bit unsigned: 0 .. 65535
type u32    # 32-bit unsigned: 0 .. 2^32 - 1
type u64    # 64-bit unsigned: 0 .. 2^64 - 1

# ═══════════════════════════════════════════════════════
# Floating point types (IEEE 754)
# ═══════════════════════════════════════════════════════

type f32    # 32-bit float (single precision)
type f64    # 64-bit float (double precision, default for floats)

# ═══════════════════════════════════════════════════════
# Other fundamental types
# ═══════════════════════════════════════════════════════

type bool   # true (true) / false (false)
type byte   # alias for u8 — use for binary data
type ptr    # raw pointer — address-as-integer (u64 internally)
type void   # void type — func returns nothing

# ═══════════════════════════════════════════════════════
# Size types (from C23 <stddef.h>)
# ═══════════════════════════════════════════════════════

type usize  # unsigned, pointer-sized (u64 on 64-bit)
type isize  # signed, pointer-sized (i64 on 64-bit)

# ═══════════════════════════════════════════════════════
# Giới hạn type (từ C23 <limits.h> + <float.h>)
# ═══════════════════════════════════════════════════════

const I8_MIN  : i8  = -128
const I8_MAX  : i8  = 127
const I16_MIN : i16 = -32768
const I16_MAX : i16 = 32767
const I32_MIN : i32 = -2147483648
const I32_MAX : i32 = 2147483647
const I64_MIN : i64 = -9223372036854775808
const I64_MAX : i64 = 9223372036854775807

const U8_MAX  : u8  = 255
const U16_MAX : u16 = 65535
const U32_MAX : u32 = 4294967295
const U64_MAX : u64 = 18446744073709551615

const F32_EPSILON : f32 = 1.1920929e-7
const F32_MIN     : f32 = 1.17549435e-38
const F32_MAX     : f32 = 3.40282347e+38

const F64_EPSILON : f64 = 2.2204460492503131e-16
const F64_MIN     : f64 = 2.2250738585072014e-308
const F64_MAX     : f64 = 1.7976931348623157e+308

# ═══════════════════════════════════════════════════════
# Hàm chuyển đổi type
# ═══════════════════════════════════════════════════════

func to_i8(x: i64) -> i8
    # Truncate to 8-bit signed, panic if overflow
    if x < I8_MIN or x > I8_MAX
        panic("overflow: i64 -> i8")
    end
    out x as i8
end

func to_i16(x: i64) -> i16
    if x < I16_MIN or x > I16_MAX
        panic("overflow: i64 -> i16")
    end
    out x as i16
end

func to_i32(x: i64) -> i32
    if x < I32_MIN or x > I32_MAX
        panic("overflow: i64 -> i32")
    end
    out x as i32
end

func to_u8(x: i64) -> u8
    if x < 0 or x > U8_MAX
        panic("overflow: i64 -> u8")
    end
    out x as u8
end

func to_u16(x: i64) -> u16
    if x < 0 or x > U16_MAX
        panic("overflow: i64 -> u16")
    end
    out x as u16
end

func to_u32(x: i64) -> u32
    if x < 0 or x > U32_MAX
        panic("overflow: i64 -> u32")
    end
    out x as u32
end

func to_u64(x: i64) -> u64
    if x < 0
        panic("overflow: i64 -> u64 (negative)")
    end
    out x as u64
end

func to_f32(x: f64) -> f32
    out x as f32
end

func to_f64(x: i64) -> f64
    out x as f64
end

func to_bool(x: i64) -> bool
    out x != 0
end

# ═══════════════════════════════════════════════════════
# Hàm parse từ string
# ═══════════════════════════════════════════════════════

func parse_int(s: String) -> Result<i64, ParseError>
    # Parse string thập phân -> i64
    # Hỗ trợ prefix: "0x" (hex), "0b" (binary), "0o" (octal)
    var result = 0
    var negative = false
    var pos = 0
    var base = 10

    if len(s) == 0
        out Err(ParseError { msg: "empty string" })
    end

    # Kiểm tra dấu âm
    if s[0] == '-'
        negative = true
        pos = 1
    end

    # Kiểm tra prefix
    if pos + 1 < len(s)
        if s[pos] == '0'
            chọn s[pos + 1]
                case 'x' base = 16; pos = pos + 2
                case 'b' base = 2;  pos = pos + 2
                case 'o' base = 8;  pos = pos + 2
            end
        end
    end

    # Parse digits
    while pos < len(s)
        var ch = s[pos]
        var digit = char_to_digit(ch, base)
        if is_err(digit)
            out Err(ParseError { msg: "invalid digit" })
        end
        result = result * base + unwrap(digit)
        pos = pos + 1
    end

    if negative result = -result end
    out Ok(result)
end

func parse_float(s: String) -> Result<f64, ParseError>
    # Parse string thập phân -> f64
    # Delegate to native implementation
    out native_parse_float(s)
end
