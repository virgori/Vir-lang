/*
 * vir/viron/svc.vri — Quản lý dịch vụ hệ thống
 * =================================================
 * Thay thế systemctl/launchctl/service.
 *
 * Syntax:
 *   svc list              Liệt kê dịch vụ
 *   svc status <name>     Trạng thái
 *   svc start <name>      Khởi động
 *   svc stop <name>       Dừng
 *   svc restart <name>    Khởi động lại
 *   svc enable <name>     Bật auto-start
 *   svc disable <name>    Tắt auto-start
 *   svc log <name>        Xem log
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/process/process" use Command, command_new, command_arg, command_output
import "vir/io/stdio" use println

enum SvcBackend
    Systemd   = 0
    Launchctl = 1
    Generic   = 2
end

enum SvcState
    Running  = 0
    Stopped  = 1
    Failed   = 2
    Unknown  = 3
end

entity ServiceInfo
    name:    String
    state:   SvcState
    enabled: bool
    pid:     i32
end

func svc_dispatch(args: Vec<String>) -> i32
    if vec_len(args) == 0
        out svc_list(vec_new())
    end
    
    var subcmd = vec_get(args, 0)
    var subargs = vec_new()
    var i: usize = 1
    lặp_khi i < vec_len(args)
        vec_push(&subargs, vec_get(args, i))
        i = i + 1
    end
    
    if str_eq(subcmd, str_new("list"))
        out svc_list(subargs)
    ngược_nếu str_eq(subcmd, str_new("status"))
        out svc_status(subargs)
    ngược_nếu str_eq(subcmd, str_new("start"))
        out svc_start(subargs)
    ngược_nếu str_eq(subcmd, str_new("stop"))
        out svc_stop(subargs)
    ngược_nếu str_eq(subcmd, str_new("restart"))
        out svc_restart(subargs)
    ngược_nếu str_eq(subcmd, str_new("enable"))
        out svc_enable(subargs)
    ngược_nếu str_eq(subcmd, str_new("disable"))
        out svc_disable(subargs)
    ngược_nếu str_eq(subcmd, str_new("log"))
        out svc_log(subargs)
    ngược
        out svc_status(args)    # Coi as status
    end
end

func svc_list(args: Vec<String>) -> i32
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("list-units"))
    command_arg(&cmd, str_new("--type=service"))
    command_arg(&cmd, str_new("--no-pager"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println("Dịch vụ hệ thống:")
            println(output.stdout)
            out 0
        end
        Err(_)
            println("Không xác định được hệ thống quản lý dịch vụ")
            out 1
        end
    end
end

func svc_status(args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: svc status <name>")
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("status"))
    command_arg(&cmd, name)
    command_arg(&cmd, str_new("--no-pager"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out output.exit_code
        end
        Err(_)
            println("Dịch vụ '" + name + "' not found")
            out 1
        end
    end
end

func svc_start(args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: svc start <name>")
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("start"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Dịch vụ '" + name + "' đã khởi động")
            ngược
                println("⛔ Error. Thử: maha svc start " + name)
            end
            out output.exit_code
        end
        Err(msg)
            println("Error: " + msg)
            out 1
        end
    end
end

func svc_stop(args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: svc stop <name>")
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("stop"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Dịch vụ '" + name + "' stopped")
            ngược
                println("⛔ Error.")
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func svc_restart(args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: svc restart <name>")
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("restart"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Dịch vụ '" + name + "' đã khởi động lại")
            ngược
                println("⛔ Error. Thử: maha svc restart " + name)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func svc_enable(args: Vec<String>) -> i32
    if vec_len(args) == 0
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("enable"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Dịch vụ '" + name + "' sẽ tự khởi động")
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func svc_disable(args: Vec<String>) -> i32
    if vec_len(args) == 0
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("systemctl"))
    command_arg(&cmd, str_new("disable"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Dịch vụ '" + name + "' tắt auto-start")
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func svc_log(args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: svc log <name>")
        out 1
    end
    var name = vec_get(args, 0)
    var cmd = command_new(str_new("journalctl"))
    command_arg(&cmd, str_new("-u"))
    command_arg(&cmd, name)
    command_arg(&cmd, str_new("-n"))
    command_arg(&cmd, str_new("50"))
    command_arg(&cmd, str_new("--no-pager"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println("Log của '" + name + "':")
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end
