/*
 * vir/viron/viron.vri — Viron CLI Framework
 * ============================================
 * Framework chính cho Viron — công cụ CLI quản lý hệ thống Vir OS.
 * Cung cấp command registry, dispatcher, and alias engine.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_lower
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_has
import "vir/io/stdio" use println, print_str
import "vir/cli/args" use ArgParser, arg_parser_new, arg_parse

# ═══════════════════════════════════════════════════════
# Command Handler Type
# ═══════════════════════════════════════════════════════

enum CmdCategory
    Auth       = 0    # maha, xác thực
    Network    = 1    # net
    Process    = 2    # proc  
    FileSystem = 3    # fs
    Service    = 4    # svc
    Package    = 5    # pkg
    User       = 6    # user, mahavir
    System     = 7    # sys
end

entity CommandMeta
    name:          String
    description:   String
    usage:         String
    category:      CmdCategory
    requires_maha: bool
end

entity CommandEntry
    meta:    CommandMeta
    handler: func(Vec<String>) -> i32
end

# ═══════════════════════════════════════════════════════
# Command Registry — Zero-Cost Alias
# ═══════════════════════════════════════════════════════

entity CommandRegistry
    commands:   Map<String, CommandEntry>   # name -> entry
    aliases:    Map<String, String>         # alias -> canonical
    categories: Map<i32, Vec<String>>       # category -> names
end

func registry_new() -> CommandRegistry
    out CommandRegistry {
        commands   = map_new(),
        aliases    = map_new(),
        categories = map_new<i32, Vec<String>>()
    }
end

func registry_register(reg: &CommandRegistry, entry: CommandEntry)
    # Đăng ký lệnh mới
    var name = entry.meta.name
    map_set(&reg.commands, name, entry)
    
    var cat_id: i32 = entry.meta.category as i32
    if !map_has<i32, Vec<String>>(reg.categories, cat_id)
        map_set<i32, Vec<String>>(&reg.categories, cat_id, vec_new())
    end
    
    var cat_list = map_get<i32, Vec<String>>(reg.categories, cat_id)
    vec_push(&cat_list, name)
end

func registry_alias(reg: &CommandRegistry, alias_name: String, canonical: String) -> Result<bool, String>
    # Tạo alias zero-cost — chỉ thêm key trỏ đến cùng entry
    if !map_has(reg.commands, canonical)
        out Err(str_new("Lệnh root chưa đăng ký: ") + canonical)
    end
    
    map_set(&reg.aliases, alias_name, canonical)
    
    # Copy entry vào alias key -> O(1) lookup
    var entry = map_get(reg.commands, canonical)
    map_set(&reg.commands, alias_name, entry)
    
    out Ok(true)
end

func registry_resolve(reg: &CommandRegistry, name: String) -> Result<CommandEntry, String>
    # Tra cứu lệnh O(1)
    if map_has(reg.commands, name)
        out Ok(map_get(reg.commands, name))
    end
    out Err(str_new("Lệnh not found: ") + name)
end

func registry_is_alias(reg: &CommandRegistry, name: String) -> bool
    out map_has(reg.aliases, name)
end

# ═══════════════════════════════════════════════════════
# CLI Dispatcher
# ═══════════════════════════════════════════════════════

func viron_dispatch(reg: &CommandRegistry, args: Vec<String>) -> i32
    if vec_len(args) == 0
        viron_help(reg)
        out 0
    end
    
    var cmd_name = vec_get(args, 0)
    
    # Meta commands
    if str_eq(cmd_name, "help") || str_eq(cmd_name, "--help")
        viron_help(reg)
        out 0
    end
    
    if str_eq(cmd_name, "version") || str_eq(cmd_name, "--version")
        println("Viron v1.0.0")
        out 0
    end
    
    if str_eq(cmd_name, "alias")
        viron_list_aliases(reg)
        out 0
    end
    
    # Resolve command
    var result = registry_resolve(reg, cmd_name)
    case result
        Ok(entry)
            # Lấy sub-args (bỏ command name)
            var sub_args = vec_new()
            var i: usize = 1
            lặp_khi i < vec_len(args)
                vec_push(&sub_args, vec_get(args, i))
                i = i + 1
            end
            
            out entry.handler(sub_args)
        end
        Err(msg)
            println("viron: " + msg)
            println("Dùng 'viron help' để xem list lệnh.")
            out 127
        end
    end
end

func viron_help(reg: &CommandRegistry)
    println("╔══════════════════════════════════════════╗")
    println("║           V I R O N  v1.0.0             ║")
    println("║   Hệ thống quản lý — Vir OS CLI Tool    ║")
    println("╚══════════════════════════════════════════╝")
    println("")
    println("Lệnh:")
    println("  maha     🔐 Quyền tối cao (thay sudo)")
    println("  net      🌐 Quản lý mạng (thay ifconfig)")
    println("  proc     ⚙️  Quản lý tiến trình")
    println("  fs       📁 Quản lý tệp")
    println("  svc      🔧 Quản lý dịch vụ")
    println("  pkg      📦 Quản lý gói")
    println("  user     👤 Quản lý người use")
    println("  sys      💻 Thông tin hệ thống")
    println("")
    println("User tối cao: mahavir | Quyền tối cao: maha")
end

func viron_list_aliases(reg: &CommandRegistry)
    println("Alias đã đăng ký:")
    # Iterate aliases map...
    println("  sudo     -> maha")
    println("  ifconfig -> net")
    println("  ip       -> net")
    println("  ps       -> proc")
    println("  ls       -> fs-list")
    println("  cp       -> fs-copy")
    println("  systemctl -> svc")
    println("  apt      -> pkg")  
    println("  whoami   -> user-whoami")
end
