/*
 * vir/viron/user.vri — Quản lý người use & input dạng
 * ======================================================
 * mahavir là người use tối cao (thay root, UID=0).
 *
 * Syntax:
 *   user whoami       -> Ai đang đăng import
 *   user list         -> Liệt kê người use
 *   user add <name>   -> Tạo user
 *   user del <name>   -> Xoá user
 *   user passwd       -> Đổi mật khẩu
 *   user groups       -> Nhóm
 *   user maha-add     -> Cấp quyền maha
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_has
import "vir/io/stdio" use println

# ═══════════════════════════════════════════════════════
# User Role — Vai trò người use
# ═══════════════════════════════════════════════════════

enum UserRole
    Guest       = 0   # Khách
    User        = 1   # Người use thường
    MahaMember  = 2   # Thành viên nhóm maha
    Admin       = 3   # Quản trị viên
    Mahavir     = 4   # Người use tối cao ✦
end

# ═══════════════════════════════════════════════════════
# VirUser — Đại diện người use
# ═══════════════════════════════════════════════════════

entity VirUser
    uid:      i32
    username: String
    role:     UserRole
    groups:   Vec<String>
    home_dir: String
    shell:    String
end

func user_is_mahavir(u: &VirUser) -> bool
    out u.uid == 0 || u.role == UserRole.Mahavir
end

func user_can_maha(u: &VirUser) -> bool
    if user_is_mahavir(u)
        out true
    end
    if u.role >= UserRole.MahaMember
        out true
    end
    # Kiểm tra nhóm maha
    var i: usize = 0
    lặp_khi i < vec_len(u.groups)
        if str_eq(vec_get(u.groups, i), str_new("maha"))
            out true
        end
        i = i + 1
    end
    out false
end

# ═══════════════════════════════════════════════════════
# VirGroup — Nhóm người use
# ═══════════════════════════════════════════════════════

entity VirGroup
    gid:     i32
    name:    String
    members: Vec<String>
end

# ═══════════════════════════════════════════════════════
# Identity Manager — Quản lý danh tính
# ═══════════════════════════════════════════════════════

entity IdentityManager
    users:    Map<String, VirUser>
    groups:   Map<String, VirGroup>
    uid_map:  Map<i32, String>
    next_uid: i32
    next_gid: i32
end

func identity_new() -> IdentityManager
    var mgr = IdentityManager {
        users    = map_new(),
        groups   = map_new(),
        uid_map  = map_new(),
        next_uid = 1000,
        next_gid = 1000
    }
    
    # Tạo mahavir — người use tối cao default
    var mahavir = VirUser {
        uid      = 0,
        username = str_new("mahavir"),
        role     = UserRole.Mahavir,
        groups   = vec_new(),
        home_dir = str_new("/home/mahavir"),
        shell    = str_new("/usr/bin/viron")
    }
    vec_push(&mahavir.groups, str_new("mahavir"))
    vec_push(&mahavir.groups, str_new("maha"))
    
    map_set(&mgr.users, str_new("mahavir"), mahavir)
    map_set(&mgr.uid_map, 0, str_new("mahavir"))
    
    # Tạo nhóm maha default
    var maha_group = VirGroup {
        gid     = 0,
        name    = str_new("maha"),
        members = vec_new()
    }
    vec_push(&maha_group.members, str_new("mahavir"))
    map_set(&mgr.groups, str_new("maha"), maha_group)
    
    out mgr
end

func identity_add_user(mgr: &IdentityManager, username: String,
                       role: UserRole) -> Result<VirUser, String>
    if map_has(mgr.users, username)
        out Err(str_new("Người use already exists: ") + username)
    end
    
    var uid = mgr.next_uid
    mgr.next_uid = mgr.next_uid + 1
    
    var user = VirUser {
        uid      = uid,
        username = username,
        role     = role,
        groups   = vec_new(),
        home_dir = str_new("/home/") + username,
        shell    = str_new("/usr/bin/viron")
    }
    
    map_set(&mgr.users, username, user)
    map_set(&mgr.uid_map, uid, username)
    
    out Ok(user)
end

func identity_remove_user(mgr: &IdentityManager, username: String) -> bool
    if str_eq(username, str_new("mahavir"))
        out false   # Không bao giờ xoá mahavir
    end
    
    if !map_has(mgr.users, username)
        out false
    end
    
    # Xoá user (in thực tế: map_remove)
    out true
end

func identity_get_user(mgr: &IdentityManager, username: String) -> Result<VirUser, String>
    if map_has(mgr.users, username)
        out Ok(map_get(mgr.users, username))
    end
    out Err(str_new("Không tìm thấy: ") + username)
end

func identity_add_to_group(mgr: &IdentityManager, username: String,
                           group_name: String) -> bool
    if !map_has(mgr.users, username)
        out false
    end
    if !map_has(mgr.groups, group_name)
        out false
    end
    
    var group = map_get(mgr.groups, group_name)
    vec_push(&group.members, username)
    
    var user = map_get(mgr.users, username)
    vec_push(&user.groups, group_name)
    
    out true
end

func identity_grant_maha(mgr: &IdentityManager, username: String) -> bool
    # Cấp quyền maha cho user
    var result = identity_add_to_group(mgr, username, str_new("maha"))
    if !result
        out false
    end
    
    # Nâng role
    if map_has(mgr.users, username)
        var user = map_get(mgr.users, username)
        user.role = UserRole.MahaMember
    end
    
    out true
end

# ═══════════════════════════════════════════════════════
# User Command Dispatcher
# ═══════════════════════════════════════════════════════

func user_dispatch(mgr: &IdentityManager, args: Vec<String>) -> i32
    if vec_len(args) == 0
        user_whoami(mgr)
        out 0
    end
    
    var subcmd = vec_get(args, 0)
    var subargs = vec_new()
    var i: usize = 1
    lặp_khi i < vec_len(args)
        vec_push(&subargs, vec_get(args, i))
        i = i + 1
    end
    
    if str_eq(subcmd, str_new("whoami"))
        user_whoami(mgr)
        out 0
    ngược_nếu str_eq(subcmd, str_new("list"))
        out user_list(mgr)
    ngược_nếu str_eq(subcmd, str_new("add"))
        out user_add(mgr, subargs)
    ngược_nếu str_eq(subcmd, str_new("del"))
        out user_del(mgr, subargs)
    ngược_nếu str_eq(subcmd, str_new("maha-add"))
        out user_maha_add(mgr, subargs)
    ngược
        println("Lệnh con invalid: " + subcmd)
        out 1
    end
end

func user_whoami(mgr: &IdentityManager)
    # Lấy user hiện tại
    println("mahavir")    # Placeholder
end

func user_list(mgr: &IdentityManager) -> i32
    println("Danh sách người use:")
    println("  UID  Username             Role")
    println("  ---  ---                  ---")
    println("    0  mahavir              MAHAVIR ✦")
    out 0
end

func user_add(mgr: &IdentityManager, args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: user add <username>")
        out 1
    end
    var username = vec_get(args, 0)
    var result = identity_add_user(mgr, username, UserRole.User)
    case result
        Ok(user)
            println("✓ Đã tạo: " + username + " (UID " + (user.uid >> String) + ")")
            out 0
        end
        Err(msg)
            println("⛔ " + msg)
            out 1
        end
    end
end

func user_del(mgr: &IdentityManager, args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: user del <username>")
        out 1
    end
    var username = vec_get(args, 0)
    if str_eq(username, str_new("mahavir"))
        println("⛔ Không thể xoá mahavir!")
        out 1
    end
    if identity_remove_user(mgr, username)
        println("✓ Đã xoá: " + username)
        out 0
    ngược
        println("Không tìm thấy: " + username)
        out 1
    end
end

func user_maha_add(mgr: &IdentityManager, args: Vec<String>) -> i32
    if vec_len(args) == 0
        println("Syntax: user maha-add <username>")
        out 1
    end
    var username = vec_get(args, 0)
    if identity_grant_maha(mgr, username)
        println("✓ Đã cấp quyền maha cho: " + username)
        out 0
    ngược
        println("⛔ Không tìm thấy user: " + username)
        out 1
    end
end
